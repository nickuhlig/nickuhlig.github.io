  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Warm the whole milk until lukewarm. Melt the unsalted butter. Finely chop the semisweet chocolate. Soften the unsalted butter. Beat the egg.",
      "secondary_message": "1 cup whole milk\n6 tbsp unsalted butter\n4 oz semisweet chocolate\n5 tbsp unsalted butter\n1 large egg"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together milk and yeast. Whisk in egg yolks, eggs, melted butter, and vanilla. In a large bowl, stir together flour, sugar, salt, and cardamom. Add liquid ingredients to dry and stir to completely combine. Loosely cover with a towel or plastic wrap and let rest at room temperature until doubled in size and surface is covered with large bubbles, 2 to 3 hours. Refrigerate for at least 3 hours, or preferably overnight (the dough's flavor improves significantly).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 375°F. Spray a 10-inch tube pan with non-stick cooking spray. In a small bowl, combine chocolate, cocoa, and cinnamon.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "On a well-floured surface, roll babka dough into a 12- by 16-inch rectangle. Spread softened butter evenly over dough. Sprinkle chocolate mixture evenly over buttered dough.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Starting with the long end, gently roll up babka into a cylinder shape. (If dough sticks while rolling into a cylinder, a bench scraper helps to release dough.) Pinch seam to seal. Place cylinder into prepared pan, seam down and slightly overlapping both ends of cylinder. Brush top with egg and let rest at room temperature about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake until babka is golden brown and set, and an instant read thermometer inserted into the center registers, 195° to 200°F (91° to 93°C). Cool in pan for 45 minutes. Gently run knife around inside edges to loosen babka and remove babka from pan. Cool completely on wire rack, about 2 hours. Serve.",
      "secondary_message": null
    }
  ],
