  "instructions": [
    {
      "id": 429883,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ pints grape tomatoes\n1 small bunch green onions (scallions)\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 429884,
      "primary_message": "Halve tomatoes crosswise. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 429885,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429886,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add to the bowl with the tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 429887,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes, green onions, and spices; cook, stirring occasionally, until veggies start to soften, 4-5 minutes. (Reserve bowl for the later use.)",
      "secondary_message": "3 tbsp virgin coconut oil\n1 ½ tbsp curry powder\n1 ½ tsp garam masala\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 429888,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 429889,
      "primary_message": "Place eggs and salt in the reserved bowl; whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt"
    },
    {
      "id": 429890,
      "primary_message": "When the veggies are softened, add half of the spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. (Reserve remaining spinach for serving.)",
      "secondary_message": null
    },
    {
      "id": 429891,
      "primary_message": "Reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 429892,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 4-5 minutes. Remove from oven.",
      "secondary_message": "2 ¼ cups shredded cheese, Italian blend"
    },
    {
      "id": 429893,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 429894,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Add reserved spinach to the plate, top with cashews, and drizzle with dressing. Enjoy!",
      "secondary_message": "⅓ cup French vinaigrette"
    }
  ],
