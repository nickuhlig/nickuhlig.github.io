  "instructions": [
    {
      "id": 295345,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 295346,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 295347,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 295348,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 baby bok choy\n1 small bunch green onions (scallions)\n3 red bell peppers\n3 (1 inch) pieces ginger root\n1 ½ limes"
    },
    {
      "id": 295349,
      "primary_message": "Trim bok choy and cut crosswise into 1-inch strips; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 295350,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 295351,
      "primary_message": "Trim, halve, seed, and thinly slice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 295352,
      "primary_message": "Peel and mince ginger and garlic; add to the bowl with the veggies.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 295353,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 295354,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 295355,
      "primary_message": "Add coconut milk, soy sauce, and chili-garlic sauce to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until sauce thickens slightly, 4-5 minutes.",
      "secondary_message": "1 ½ (13.5 fl oz) cans coconut milk\n⅓ cup soy sauce\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 295356,
      "primary_message": "Meanwhile, medium dice tofu.",
      "secondary_message": null
    },
    {
      "id": 295357,
      "primary_message": "Add noodles and tofu to the pot; gently toss to combine. Continue to cook until heated through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 295358,
      "primary_message": "Juice limes into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 295359,
      "primary_message": "To serve, divide creamy noodles, tofu, and veggies between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
