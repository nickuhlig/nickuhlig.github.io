  "instructions": [
    {
      "id": 295315,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 295316,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 295317,
      "primary_message": "Once the water in the pan is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "5 oz flat rice (pad thai) noodles"
    },
    {
      "id": 295318,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 baby bok choy\n½ small bunch green onions (scallions)\n1 red bell pepper\n1 (1 inch) piece ginger root\n½ lime"
    },
    {
      "id": 295319,
      "primary_message": "Trim bok choy and cut crosswise into 1-inch strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 295320,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 295321,
      "primary_message": "Trim, halve, seed, and thinly slice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 295322,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 295323,
      "primary_message": "While the skillet heats up, peel and mince ginger and garlic; add to the bowl with the veggies.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 295324,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 295325,
      "primary_message": "Add coconut milk, soy sauce, and chili-garlic sauce to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until sauce thickens slightly, 3-4 minutes.",
      "secondary_message": "½ (13.5 fl oz) can coconut milk\n2 tbsp soy sauce\n½ tsp chili-garlic sauce"
    },
    {
      "id": 295326,
      "primary_message": "Meanwhile, medium dice tofu.",
      "secondary_message": null
    },
    {
      "id": 295327,
      "primary_message": "Add noodles and tofu to the skillet; gently toss to combine. Continue to cook until heated through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 295328,
      "primary_message": "Juice lime into the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 295329,
      "primary_message": "To serve, divide creamy noodles, tofu, and veggies between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
