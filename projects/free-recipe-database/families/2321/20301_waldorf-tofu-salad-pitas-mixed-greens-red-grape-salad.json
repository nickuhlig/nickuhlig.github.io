  "instructions": [
    {
      "id": 339231,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 339232,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 lemons\n2 Granny Smith apples\n4 sticks celery\n1 lb red grapes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 339233,
      "primary_message": "Juice one lemon into a large bowl (reserve remaining lemon for the mixed green salad). Add mayo, Dijon, salt, and pepper; whisk to combine the creamy dressing.",
      "secondary_message": "¼ cup vegan mayonnaise\n2 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 339234,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 339235,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 339236,
      "primary_message": "Halve grapes and add half to the bowl. (Reserve remaining grapes for the mixed green salad.)",
      "secondary_message": null
    },
    {
      "id": 339237,
      "primary_message": "Roughly chop walnuts and add to the bowl. ",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 339238,
      "primary_message": "Crumble tofu with your fingers into the bowl; using a fork, mash to combine the tofu salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 339239,
      "primary_message": "Juice the remaining lemon into a medium bowl; add oil, additional Dijon, maple syrup, salt, and pepper. Whisk to combine the vinaigrette.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp Dijon mustard\n2 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 339240,
      "primary_message": "Add mixed greens and reserved grapes to the bowl with the vinaigrette; toss to combine the salad. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 339241,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with the tofu salad.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 339242,
      "primary_message": "To serve, divide pitas and mixed green salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
