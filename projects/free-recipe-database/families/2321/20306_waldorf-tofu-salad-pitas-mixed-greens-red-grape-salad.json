  "instructions": [
    {
      "id": 339300,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 339301,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n1 Granny Smith apple\n2 sticks celery\n0.23 kg red grapes\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 339302,
      "primary_message": "Juice half of the lemon into a medium bowl (reserve remaining lemon for the mixed green salad). Add yogurt, mayo, Dijon, salt, and pepper; whisk to combine the creamy dressing. ",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 339303,
      "primary_message": "Quarter, core, and small dice apple; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 339304,
      "primary_message": "Trim and small dice celery; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 339305,
      "primary_message": "Halve grapes and add half to the bowl. (Reserve remaining grapes for the mixed green salad.)",
      "secondary_message": null
    },
    {
      "id": 339306,
      "primary_message": "Roughly chop walnuts and add to the bowl. ",
      "secondary_message": "⅛ cup walnuts"
    },
    {
      "id": 339307,
      "primary_message": "Crumble tofu with your fingers into the bowl; using a fork, mash to combine the tofu salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 339308,
      "primary_message": "Juice the remaining lemon into another medium bowl; add oil, additional Dijon, honey, salt, and pepper. Whisk to combine the vinaigrette.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp honey\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 339309,
      "primary_message": "Add mixed greens and reserved grapes to the bowl with the vinaigrette; toss to combine the salad. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 339310,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with the tofu salad.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 339311,
      "primary_message": "To serve, divide pitas and mixed green salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
