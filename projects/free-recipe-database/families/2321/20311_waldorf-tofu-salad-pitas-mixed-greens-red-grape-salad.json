  "instructions": [
    {
      "id": 339360,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 339361,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 lemons\n3 Granny Smith apples\n6 sticks celery\n0.68 kg red grapes\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 339362,
      "primary_message": "Juice half of the lemons into a large bowl (reserve remaining lemons for the mixed green salad). Add mayo, Dijon, salt, and pepper; whisk to combine the creamy dressing.",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 339363,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 339364,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 339365,
      "primary_message": "Halve grapes and add half to the bowl. (Reserve remaining grapes for the mixed green salad.)",
      "secondary_message": null
    },
    {
      "id": 339366,
      "primary_message": "Roughly chop walnuts and add to the bowl. ",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 339367,
      "primary_message": "Crumble tofu with your fingers into the bowl; using a fork, mash to combine the tofu salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 339368,
      "primary_message": "Juice the remaining lemons into another large bowl; add oil, additional Dijon, maple syrup, salt, and pepper. Whisk to combine the vinaigrette.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n1 tbsp pure maple syrup\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 339369,
      "primary_message": "Add mixed greens and reserved grapes to the bowl with the vinaigrette; toss to combine the salad. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 339370,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with the tofu salad.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 339371,
      "primary_message": "To serve, divide pitas and mixed green salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
