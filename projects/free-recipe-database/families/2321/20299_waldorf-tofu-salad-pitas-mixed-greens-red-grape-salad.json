  "instructions": [
    {
      "id": 339207,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 339208,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 lemons\n3 Granny Smith apples\n6 sticks celery\n1 ½ lb red grapes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 339209,
      "primary_message": "Juice half of the lemons into a large bowl (reserve remaining lemons for the mixed green salad). Add yogurt, mayo, Dijon, salt, and pepper; whisk to combine the creamy dressing. ",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tbsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 339210,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 339211,
      "primary_message": "Trim and small dice celery; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 339212,
      "primary_message": "Halve grapes and add half to the bowl. (Reserve remaining grapes for the mixed green salad.)",
      "secondary_message": null
    },
    {
      "id": 339213,
      "primary_message": "Roughly chop walnuts and add to the bowl. ",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 339214,
      "primary_message": "Crumble tofu with your fingers into the bowl; using a fork, mash to combine the tofu salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 339215,
      "primary_message": "Juice the remaining lemons into another large bowl; add oil, additional Dijon, honey, salt, and pepper. Whisk to combine the vinaigrette.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n1 tbsp honey\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 339216,
      "primary_message": "Add mixed greens and reserved grapes to the bowl with the vinaigrette; toss to combine the salad. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 339217,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with the tofu salad.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 339218,
      "primary_message": "To serve, divide pitas and mixed green salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
