  "instructions": [
    {
      "id": 493503,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small pkg fresh basil\n1 (6 oz) pkg blueberries\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 493504,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 493505,
      "primary_message": "Crumble goat cheese into the bowl with the basil. Add salt and pepper, then mash with the back of a spoon until combined. ",
      "secondary_message": "1 (4 oz) log goat cheese\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 493506,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493507,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Spread each slice evenly with the goat cheese mixture, then top half of the slices with blueberries, pressing gently to adhere. Close sandwiches with remaining bread slices, pressing gently once more.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 493508,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 493509,
      "primary_message": "Remove the sandwiches to a plate and add more oil to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 493510,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place both in a medium bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 clove garlic\n2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n½ tsp Dijon mustard\n½ tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 493511,
      "primary_message": "Add spinach to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 493512,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
