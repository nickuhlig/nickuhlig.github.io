  "instructions": [
    {
      "id": 493523,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n3 (6 oz) pkgs blueberries\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 493524,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 493525,
      "primary_message": "Crumble goat cheese into the bowl with the basil. Add salt and pepper, then mash with the back of a spoon until combined. ",
      "secondary_message": "3 (4 oz) logs goat cheese\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 493526,
      "primary_message": "Place the bread slices on a flat surface. Spread each slice evenly with the goat cheese mixture, then top half of the slices with blueberries, pressing gently to adhere. Close sandwiches with remaining bread slices, pressing gently once more.",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 493527,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 493528,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 493529,
      "primary_message": "Remove the sandwiches to a plate and add more oil to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 493530,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place both in a large bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 shallot\n3 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 493531,
      "primary_message": "Add spinach to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 493532,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
