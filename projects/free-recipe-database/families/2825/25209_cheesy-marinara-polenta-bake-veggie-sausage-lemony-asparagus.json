  "instructions": [
    {
      "id": 422979,
      "primary_message": "Preheat oven to 220°C (425°F). Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 422980,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Divide slices and arrange on the bottom of two large baking dishes, overlapping slightly. Pour marinara sauce over top, then sprinkle with cheese. ",
      "secondary_message": "3 (510 g) tubes polenta, pre-cooked\n1 ½ (680 g) jars marinara sauce\n1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 422981,
      "primary_message": "Place baking dishes on the upper rack of the oven (it doesn't have to be fully heated) and bake until polenta is warmed through and cheese is bubbly, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422982,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus. Divide between two large baking sheet pans.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 422983,
      "primary_message": "Wash, dry, and juice lemons over top of asparagus; drizzle with oil and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ lemons\n2 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 422984,
      "primary_message": "Place baking sheets on the middle and lower racks. Roast until asparagus is starting to soften, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 422985,
      "primary_message": "When the asparagus is soft, remove from the oven and toss. Divide sausages between the baking sheets and drizzle with additional oil.",
      "secondary_message": "6 pre-cooked vegan sausage\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 422986,
      "primary_message": "Return baking sheets to the oven and continue to roast until asparagus is tender and sausages are warmed through, about 7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422987,
      "primary_message": "To serve, divide sausages, asparagus, and polenta bake between plates. Enjoy!",
      "secondary_message": null
    }
  ],
