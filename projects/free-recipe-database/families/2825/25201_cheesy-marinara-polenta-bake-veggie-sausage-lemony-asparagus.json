  "instructions": [
    {
      "id": 422910,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 422911,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Arrange slices in the bottom of a baking dish, overlapping slightly. Pour marinara sauce over top, then sprinkle with cheese. ",
      "secondary_message": "1 (18 oz) tube polenta, pre-cooked\n½ (24 oz) jar marinara sauce\n½ cup shredded cheese, Italian blend"
    },
    {
      "id": 422912,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until polenta is warmed through and cheese is bubbly, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422913,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus. Transfer to a baking sheet pan.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 422914,
      "primary_message": "Wash, dry, and juice lemon over top of asparagus; drizzle with oil and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "½ lemon\n2 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 422915,
      "primary_message": "Add baking sheet to the oven and roast until asparagus is starting to soften, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 422916,
      "primary_message": "When the asparagus is soft, remove from the oven and toss. Add sausages to the baking sheet and drizzle with additional oil.",
      "secondary_message": "2 pre-cooked vegan sausage\n1 tsp extra virgin olive oil"
    },
    {
      "id": 422917,
      "primary_message": "Return baking sheet to the oven and continue to roast until asparagus is tender and sausages are warmed through, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422918,
      "primary_message": "To serve, divide sausages, asparagus, and polenta bake between plates. Enjoy!",
      "secondary_message": null
    }
  ],
