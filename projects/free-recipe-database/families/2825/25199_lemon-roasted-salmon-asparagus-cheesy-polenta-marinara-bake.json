  "instructions": [
    {
      "id": 422894,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 422895,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Arrange slices in the bottom of a large baking dish, overlapping slightly. Pour marinara sauce over top, then sprinkle with cheese. ",
      "secondary_message": "2 (18 oz) tubes polenta, pre-cooked\n1 (24 oz) jar marinara sauce\n1 cup shredded cheese, Italian blend"
    },
    {
      "id": 422896,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until polenta is warmed through and cheese is bubbly, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422897,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus. Transfer to one half of a large baking sheet pan.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 422898,
      "primary_message": "Pat salmon dry with paper towels, then place skin-side down on the other half of the baking sheet.",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 422899,
      "primary_message": "Wash, dry, zest, and juice lemon over top of asparagus and salmon; drizzle with oil and season with spices. Toss the asparagus and spread out in an even layer.",
      "secondary_message": "1 lemon\n2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 422900,
      "primary_message": "Add baking sheet to the oven and roast until asparagus is tender and salmon is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422901,
      "primary_message": "To serve, divide salmon, asparagus, and polenta bake between plates. Enjoy!",
      "secondary_message": null
    }
  ],
