  "instructions": [
    {
      "id": 422937,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 422938,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Arrange slices in the bottom of a baking dish, overlapping slightly. Pour marinara sauce over top, then sprinkle with cheese. ",
      "secondary_message": "1 (510 g) tube polenta, pre-cooked\n½ (680 g) jar marinara sauce\n½ cup shredded cheese, Italian blend"
    },
    {
      "id": 422939,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until polenta is warmed through and cheese is bubbly, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422940,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus. Transfer to one half of a baking sheet pan.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 422941,
      "primary_message": "Pat salmon dry with paper towels, then place skin-side down on the other half of the baking sheet.",
      "secondary_message": "⅓ kg salmon fillet"
    },
    {
      "id": 422942,
      "primary_message": "Wash, dry, zest, and juice lemon over top of asparagus and salmon; drizzle with oil and season with spices. Toss the asparagus and spread out in an even layer.",
      "secondary_message": "½ lemon\n1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 422943,
      "primary_message": "Add baking sheet to the oven and roast until asparagus is tender and salmon is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 422944,
      "primary_message": "To serve, divide salmon, asparagus, and polenta bake between plates. Enjoy!",
      "secondary_message": null
    }
  ],
