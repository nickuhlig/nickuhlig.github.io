  "instructions": [
    {
      "id": 1,
      "primary_message": "Make the Sauce: Heat vegetable oil in a large saucepan over medium high heat. Add scallions and onion and sauté until soft, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add garlic and continue to sauté until tender, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add brown sugar, tomato paste, ketchup, mustard, water, apple juice, apple cider vinegar, Worcestershire sauce, ancho chile powder, and cumin to pot. Whisk until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add bourbon and whisk until combined. Cook, stirring occasionally, until reduced to a thick sauce, about 1 hour 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Make the Ribs: In a small bowl, whisk together cayenne, chili powder, cinnamon, mustard, cumin, cardamom, and salt.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Rub ribs all over with olive oil. Rub spice mixture over ribs to coat. Let rest in refrigerator, covered, overnight.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Preheat oven to 105°C (225°F). Wrap ribs in foil and cook for 1 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Preheat a gas or charcoal grill to 105°C (225°F) using indirect heat. To heat only one side on a charcoal grill, simply push the coals to one side. On a gas grill, turn off all the burners except one or two. Use an oven thermometer to make sure that heat stays constant throughout cooking.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Unwrap ribs and place on indirect heat side of the grill. Close the grill.",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Cook ribs on grill for 1 1/2 to 2 1/2 hours, until meat is tender. When picked up with tongs and lightly bounced against grill, the crust on the ribs should crack.",
      "secondary_message": null
    },
    {
      "id": 11,
      "primary_message": "Remove ribs to a platter and brush all over with sauce. Raise grill temperature to 205°C and place ribs on heat. Cook each until browned and caramelized, about 4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 12,
      "primary_message": "Slice meat into individual ribs. Serve with extra sauce on the side.",
      "secondary_message": null
    }
  ],
