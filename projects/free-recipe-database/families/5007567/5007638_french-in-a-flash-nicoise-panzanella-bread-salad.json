  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the day-old bread in 1-inch cubes. Juice the lemon. Halve and blanch the haricots verts until tender crisp. Halve the cherry tomatoes. Pit and halve the kalamata olives. Drain and roughly chop the anchovy fillets in olive oil. Roughly chop the baby arugula. Drain the albacore in olive oil.",
      "secondary_message": "6 cups day-old bread\n1 lemon\n198 g haricots verts\n45 cherry tomatoes\n30 kalamata olives\n12 anchovy fillets in olive oil\n1 cup baby arugula\n1 (142 g) can albacore in olive oil"
    },
    {
      "id": 1,
      "primary_message": "Preheat the oven to 350 degrees F. Spread the bread in a single layer on a baking sheet, and toast until just golden brown, about 10 minutes. Set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Prepare the vinaigrette by whisking together the lemon juice, lemon zest, olive oil, thyme, and salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, toss together the haricots verts, cherry tomatoes, olives, anchovies, arugula, basil, parsley, and the lemon-thyme vinaigrette. Then, add the tuna and bread croutons to the bowl, and gently toss until everything is combined. Let sit on the counter for at least 20 minutes before serving.",
      "secondary_message": null
    }
  ],
