  "instructions": [
    {
      "id": 340899,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 340900,
      "primary_message": "Meanwhile, wash, dry, and trim Brussels sprouts.",
      "secondary_message": "0.45 kg Brussels sprouts"
    },
    {
      "id": 340901,
      "primary_message": "Once the water in the pot is boiling, uncover, add salt and Brussels sprouts, and stir for a few seconds. Reduce heat to medium and cook until starting to soften, about 10 minutes.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 340902,
      "primary_message": "Wash and dry broccoli; separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 340903,
      "primary_message": "Once the Brussels sprouts start to soften, add broccoli and continue to cook until veggies are fork-tender, 5-6 minutes more. Drain veggies and transfer to a medium bowl; set aside. (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 340904,
      "primary_message": "While the veggies are cooking, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340905,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Transfer sausages to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp butter, unsalted\n4 pre-cooked vegan sausage"
    },
    {
      "id": 340906,
      "primary_message": "Meanwhile, coarsely grate cheese and set aside.",
      "secondary_message": "⅔ (227 g) block cheddar cheese"
    },
    {
      "id": 340907,
      "primary_message": "Return pot to medium heat. Once the pot is hot, add butter and swirl to coat the bottom; add flour and whisk until smooth. Cook, whisking frequently, until lightly golden, 1 minute.",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp all-purpose flour"
    },
    {
      "id": 340908,
      "primary_message": "Slowly pour milk into the pot, whisking constantly. Continue whisking until the sauce has thickened, 3-4 minutes.",
      "secondary_message": "591 ml whole milk"
    },
    {
      "id": 340909,
      "primary_message": "Add cheese and spices to the pot; whisk until cheese is melted and sauce is smooth.",
      "secondary_message": "1 tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 340910,
      "primary_message": "Return drained veggies to the pot with the sauce and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 340911,
      "primary_message": "To serve, divide sausages and cheesy veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
