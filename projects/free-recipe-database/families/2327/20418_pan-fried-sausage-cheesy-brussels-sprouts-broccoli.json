  "instructions": [
    {
      "id": 340873,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340874,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Transfer sausages to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp butter, unsalted\n6 pork sausages"
    },
    {
      "id": 340875,
      "primary_message": "While the sausages are cooking, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 340876,
      "primary_message": "Meanwhile, wash, dry, and trim Brussels sprouts.",
      "secondary_message": "0.68 kg Brussels sprouts"
    },
    {
      "id": 340877,
      "primary_message": "Once the water in the pot is boiling, uncover, add salt and Brussels sprouts, and stir for a few seconds. Reduce heat to medium and cook until starting to soften, about 10 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 340878,
      "primary_message": "Meanwhile, wash and dry broccoli; separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 340879,
      "primary_message": "Once the Brussels sprouts start to soften, add broccoli and continue to cook until veggies are fork-tender, 5-6 minutes more. Drain veggies and transfer to a medium bowl; set aside. (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 340880,
      "primary_message": "While the veggies are cooking, coarsely grate cheese and set aside.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 340881,
      "primary_message": "Return pot to medium heat. Once the pot is hot, add butter and swirl to coat the bottom; add flour and whisk until smooth. Cook, whisking frequently, until lightly golden, 1 minute.",
      "secondary_message": "3 tbsp butter, unsalted\n3 tbsp all-purpose flour"
    },
    {
      "id": 340882,
      "primary_message": "Slowly pour milk into the pot, whisking constantly. Continue whisking until the sauce has thickened, 4-5 minutes.",
      "secondary_message": "887 ml whole milk"
    },
    {
      "id": 340883,
      "primary_message": "Add cheese and spices to the pot; whisk until cheese is melted and sauce is smooth.",
      "secondary_message": "1 ½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 340884,
      "primary_message": "Return drained veggies to the pot with the sauce and stir to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 340885,
      "primary_message": "To serve, divide sausages and cheesy veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
