  "instructions": [
    {
      "id": 340886,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 340887,
      "primary_message": "Meanwhile, wash, dry, and trim Brussels sprouts.",
      "secondary_message": "0.23 kg Brussels sprouts"
    },
    {
      "id": 340888,
      "primary_message": "Once the water in the pan is boiling, uncover, add salt and Brussels sprouts, and stir for a few seconds. Reduce heat to medium and cook until starting to soften, about 10 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 340889,
      "primary_message": "Wash and dry broccoli; separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 340890,
      "primary_message": "Once the Brussels sprouts start to soften, add broccoli and continue to cook until veggies are fork-tender, 5-6 minutes more. Drain veggies and transfer to a medium bowl; set aside. (Reserve pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 340891,
      "primary_message": "While the veggies are cooking, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340892,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Transfer sausages to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tsp butter, unsalted\n2 pre-cooked vegan sausage"
    },
    {
      "id": 340893,
      "primary_message": "Meanwhile, coarsely grate cheese and set aside.",
      "secondary_message": "⅓ (227 g) block cheddar cheese"
    },
    {
      "id": 340894,
      "primary_message": "Return pan to medium heat. Once the pan is hot, add butter and swirl to coat the bottom; add flour and whisk until smooth. Cook, whisking frequently, until lightly golden, 1 minute.",
      "secondary_message": "1 tbsp butter, unsalted\n1 tbsp all-purpose flour"
    },
    {
      "id": 340895,
      "primary_message": "Slowly pour milk into the pan, whisking constantly. Continue whisking until the sauce has thickened, 3-4 minutes.",
      "secondary_message": "296 ml whole milk"
    },
    {
      "id": 340896,
      "primary_message": "Add cheese and spices to the pan; whisk until cheese is melted and sauce is smooth.",
      "secondary_message": "½ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 340897,
      "primary_message": "Return drained veggies to the pan with the sauce and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 340898,
      "primary_message": "To serve, divide sausages and cheesy veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
