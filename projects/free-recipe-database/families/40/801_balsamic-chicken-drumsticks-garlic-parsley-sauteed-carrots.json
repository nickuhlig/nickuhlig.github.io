  "instructions": [
    {
      "id": 7432,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": ""
    },
    {
      "id": 7433,
      "primary_message": "Peel and mince garlic and ginger. In a large bowl, prepare marinade by whisking together ½ of the garlic and ginger (save the rest for the carrots), vinegar, honey, coconut aminos, and pepper.",
      "secondary_message": "8 cloves garlic\n2 (1 inch) pieces ginger\n6 tbsp balsamic vinegar\n6 tbsp honey\n3 tbsp coconut aminos\n¼ tsp black pepper"
    },
    {
      "id": 7434,
      "primary_message": "Make a couple cuts in each of the drumsticks. Add to bowl with marinade and toss to coat. Transfer to a large baking dish, reserving marinade in bowl.",
      "secondary_message": "2 ½ lb chicken drumsticks"
    },
    {
      "id": 7435,
      "primary_message": "Place in the oven and bake for 10 minutes. Spoon reserved marinade on top of chicken and continue baking until cooked through, another 20-25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 7436,
      "primary_message": "Wash and peel carrots. Slice diagonally into ¼ in pieces.",
      "secondary_message": "12 medium carrots"
    },
    {
      "id": 7437,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 7438,
      "primary_message": "Coat bottom of skillet with oil. Add remaining garlic and ginger and cook until fragrant, 15-30 seconds. Add carrots and season with salt and pepper. Stirring frequently, cook until carrots are tender-crisp and slightly browned, 8-10 minutes. If skillet gets too dry, add a little water.",
      "secondary_message": "about 2 tbsp virgin coconut oil\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 7439,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Stir ½ (save the rest for garnishing) into the carrots.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 7441,
      "primary_message": "To serve, place carrots on a plate, add drumsticks on top, and garnish with remaining parsley. Enjoy!",
      "secondary_message": ""
    }
  ],
