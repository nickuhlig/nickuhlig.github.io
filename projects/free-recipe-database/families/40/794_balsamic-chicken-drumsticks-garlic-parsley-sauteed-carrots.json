  "instructions": [
    {
      "id": 7362,
      "primary_message": "Preheat oven to 260°C (500°F).",
      "secondary_message": ""
    },
    {
      "id": 7363,
      "primary_message": "Peel and mince garlic and ginger. In a medium bowl, prepare marinade by whisking together ½ of the garlic and ginger (save the rest for the carrots), vinegar, honey, soy sauce, and pepper.",
      "secondary_message": "4 cloves garlic\r\n1 (2 ½ cm) piece ginger\r\n3 tbsp balsamic vinegar\r\n3 tbsp honey\r\n1 ½ tbsp soy sauce\r\n⅛ tsp black pepper"
    },
    {
      "id": 7364,
      "primary_message": "Make a couple cuts in each of the drumsticks. Add to bowl with marinade and toss to coat. Transfer to a small baking dish, reserving marinade in bowl.",
      "secondary_message": "0.567 kg chicken drumsticks"
    },
    {
      "id": 7365,
      "primary_message": "Place in the oven and bake for 10 minutes. Spoon reserved marinade on top of chicken and continue baking until cooked through, another 20-25 minutes.",
      "secondary_message": ""
    },
    {
      "id": 7366,
      "primary_message": "Wash and peel carrots. Slice diagonally into ⅔ cm pieces.",
      "secondary_message": "6 medium carrots"
    },
    {
      "id": 7367,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 7368,
      "primary_message": "Coat bottom of skillet with oil. Add remaining garlic and ginger and cook until fragrant, 15-30 seconds. Add carrots and season with salt and pepper. Stirring frequently, cook until carrots are tender-crisp and slightly browned, 8-10 minutes. If skillet gets too dry, add a little water.",
      "secondary_message": "about 1 tbsp virgin coconut oil\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 7369,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Stir ½ (save the rest for garnishing) into the carrots.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 7371,
      "primary_message": "To serve, place carrots on a plate, add drumsticks on top, and garnish with remaining parsley. Enjoy!",
      "secondary_message": ""
    }
  ],
