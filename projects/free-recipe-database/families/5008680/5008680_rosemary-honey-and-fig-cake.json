  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Bring the eggs to room temperature. Bring the milk to room temperature. Trim the stems of the figs, then quarter them lengthwise.",
      "secondary_message": "6 tbsp (3 oz) unsalted butter\n2 large eggs\n1 cup milk\n12 figs"
    },
    {
      "id": 1,
      "primary_message": "For the Cake: Adjust oven rack to middle position and preheat oven to 350°F. Coat 9-inch round springform pan with cooking spray. In medium bowl, whisk together flour, baking powder, baking soda, and salt; set aside. Pulse sugar, rosemary, and orange zest in food processor until no zest strands remain and rosemary is coarsely chopped (see note).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large bowl, beat butter, oil, and rosemary-orange sugar on medium speed until light, about 3 minutes. Add eggs, one at a time, beating well after each addition. Add honey and beat just until incorporated.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Decrease mixer speed to low and add flour mixture in three batches, alternating with milk. Scrape sides and bottom of bowl with rubber spatula as needed. Increase speed to medium and beat mixture just until combined, 20 to 30 seconds. Add vanilla and beat once more, just to combine, about 10 seconds.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Scrape batter into prepared pan. Bake until cake tester inserted in cake comes out clean, 40 to 45 minutes, rotating cake halfway through baking. Transfer cake to cooling rack set inside baking sheet and cool in pan 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Release springform and invert cake onto cooling rack; remove bottom of springform. Invert cake once again and cool completely, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the Figs and Assembly: Melt butter in large skillet over medium heat and cook until beginning to brown, 3 to 5 minutes. Add figs and season with salt and pepper. Cook until figs soften, about 3 minutes. Stir in honey and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "With a serrated knife, slice about 1/8 inch off top of cake. Spoon figs and any released juices on top of cake. Serve.",
      "secondary_message": null
    }
  ],
