  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 190°C (375°F). Grease a 23 cm pie dish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together flour, baking soda, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat together butter, brown sugar, and sugar until light and fluffy.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add vanilla and eggs and beat until combined.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add flour mixture to wet ingredients and beat until just combined. Stir in chocolate chips.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Press dough evenly across prepared pie dish. Bake until golden, about 20 minutes.",
      "secondary_message": null
    }
  ],
