  "instructions": [
    {
      "id": 286747,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch fresh dill\n6 medium yellow potatoes\n3 Granny Smith apples\n6 sticks celery\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 286748,
      "primary_message": "Place eggs, bread crumbs, cornstarch, salt, and pepper in a large bowl; whisk to combine the egg mixture.",
      "secondary_message": "6 eggs\n¾ cup panko bread crumbs\n2 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 286749,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add dill to the bowl with the egg mixture (reserving a small handful for garnish). ",
      "secondary_message": null
    },
    {
      "id": 286750,
      "primary_message": "Peel potatoes; using a box grater, coarsely grate, and place in a colander. Using your hands, squeeze as much water from the potato as you can.",
      "secondary_message": null
    },
    {
      "id": 286751,
      "primary_message": "Add grated potato to the bowl with the egg mixture and use your hands to thoroughly combine the latke mixture.",
      "secondary_message": null
    },
    {
      "id": 286752,
      "primary_message": "Using a ⅓-cup measure, form the latke mixture into ½-inch thick patties; place on a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 286753,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 286754,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add patties and cook until golden brown and cooked through, 4-5 minutes per side. Remove latkes to a paper towel-lined plate, placing additional paper towels between layers to soak up excess oil.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 286755,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, and salt in another large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 ½ tsp honey\n½ tsp salt"
    },
    {
      "id": 286756,
      "primary_message": "Quarter, core, and thinly slice apples; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 286757,
      "primary_message": "Trim and slice celery crosswise into thin pieces; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 286758,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 286759,
      "primary_message": "Just before serving, add arugula to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 286760,
      "primary_message": "Divide latkes between plates and season with pepper; top with salmon, yogurt, and reserved dill. Serve with salad on the side and enjoy! ",
      "secondary_message": "3 pinch black pepper\n1 cup plain Greek yogurt"
    }
  ],
