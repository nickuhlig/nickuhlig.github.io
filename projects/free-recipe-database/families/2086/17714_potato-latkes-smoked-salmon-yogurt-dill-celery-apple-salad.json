  "instructions": [
    {
      "id": 286887,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small bunch fresh dill\n2 medium yellow potatoes\n1 Granny Smith apple\n2 sticks celery\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 286888,
      "primary_message": "Place eggs, bread crumbs, cornstarch, salt, and pepper in a medium bowl; whisk to combine the egg mixture.",
      "secondary_message": "2 eggs\n¼ cup panko bread crumbs\n2 tsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 286889,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add dill to the bowl with the egg mixture (reserving a small handful for garnish). ",
      "secondary_message": null
    },
    {
      "id": 286890,
      "primary_message": "Peel potatoes; using a box grater, coarsely grate, and place in a colander. Using your hands, squeeze as much water from the potato as you can.",
      "secondary_message": null
    },
    {
      "id": 286891,
      "primary_message": "Add grated potato to the bowl with the egg mixture and use your hands to thoroughly combine the latke mixture.",
      "secondary_message": null
    },
    {
      "id": 286892,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 286893,
      "primary_message": "While the skillet heats up, using a ⅓-cup measure, form the latke mixture into ½-inch thick patties; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 286894,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook until golden brown and cooked through, 4-5 minutes per side. Remove latkes to a clean, paper towel-lined plate to drain. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 286895,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, and salt in another medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp honey\n⅛ tsp salt"
    },
    {
      "id": 286896,
      "primary_message": "Quarter, core, and thinly slice apple; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 286897,
      "primary_message": "Trim and slice celery crosswise into thin pieces; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 286898,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "1 (113 g) pkg smoked salmon"
    },
    {
      "id": 286899,
      "primary_message": "Just before serving, add arugula to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 286900,
      "primary_message": "Divide latkes between plates and season with pepper; top with salmon, yogurt, and reserved dill. Serve with salad on the side and enjoy! ",
      "secondary_message": "1 pinch black pepper\n⅓ cup plain Greek yogurt"
    }
  ],
