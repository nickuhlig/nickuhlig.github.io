  "instructions": [
    {
      "id": 384931,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 green bell peppers\n1 ½ limes\n3 avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 384932,
      "primary_message": "Peel, halve, and small dice onions. Place in a large bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 384933,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 384934,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384935,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 384936,
      "primary_message": "When the veggie ground is done, add onion, bell pepper, and spices to the pot. Continue to cook, stirring occasionally, until veggies start to soften, 4-5 minutes more.",
      "secondary_message": "3 tbsp chili powder\n1 tbsp oregano, dried\n¾ tsp salt\n¾ tsp garlic powder\n½ tsp crushed red pepper"
    },
    {
      "id": 384937,
      "primary_message": "While the veggies are cooking, cut limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 384938,
      "primary_message": "When the veggies are soft, add water and nutritional yeast to the pot. Cook, stirring occasionally, until sauce is thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": "½ cup water\n⅓ cup nutritional yeast flakes"
    },
    {
      "id": 384939,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 384940,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with veggie ground, vegetables, and avocado. Serve with lime wedges and enjoy! ",
      "secondary_message": null
    }
  ],
