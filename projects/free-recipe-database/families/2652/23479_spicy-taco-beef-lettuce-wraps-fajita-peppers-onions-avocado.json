  "instructions": [
    {
      "id": 384941,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n1 green bell pepper\n½ lime\n1 avocado\n½ head butter (Boston) lettuce"
    },
    {
      "id": 384942,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384943,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Place in a medium bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 384944,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the beef and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅓ kg lean ground beef"
    },
    {
      "id": 384945,
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 384946,
      "primary_message": "When the beef is done, add onion, bell pepper, and spices to the skillet. Continue to cook, stirring occasionally, until veggies start to soften, 3-4 minutes more.",
      "secondary_message": "1 tbsp chili powder\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp garlic powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 384947,
      "primary_message": "While the veggies are cooking, cut lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 384948,
      "primary_message": "When the veggies are soft, add water to the skillet. Cook, stirring occasionally, until sauce is thickened, 1-2 minutes. Remove from heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 384949,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 384950,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with beef, veggies, and avocado. Serve with lime wedges and enjoy! ",
      "secondary_message": null
    }
  ],
