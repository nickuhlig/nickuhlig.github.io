  "instructions": [
    {
      "id": 384901,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 green bell peppers\n1 ½ limes\n3 avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 384902,
      "primary_message": "Peel, halve, and small dice onions. Place in a large bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 384903,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 384904,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384905,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the beef and cook, breaking it apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 ¼ lb lean ground beef"
    },
    {
      "id": 384906,
      "primary_message": "When the beef is done, add onion, bell pepper, and spices to the pot. Continue to cook, stirring occasionally, until veggies start to soften, 4-5 minutes more.",
      "secondary_message": "3 tbsp chili powder\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp garlic powder\n½ tsp crushed red pepper"
    },
    {
      "id": 384907,
      "primary_message": "While the veggies are cooking, cut limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 384908,
      "primary_message": "When the veggies are soft, add water to the pot. Cook, stirring occasionally, until sauce is thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 384909,
      "primary_message": "Meanwhile, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 384910,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with beef, veggies, and avocado. Serve with lime wedges and enjoy! ",
      "secondary_message": null
    }
  ],
