  "instructions": [
    {
      "id": 434784,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 434785,
      "primary_message": "Roughly chop walnuts and set aside. ",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 434786,
      "primary_message": "Peel bananas, break into chunks, and place in another medium bowl; crush with a fork or potato masher until smooth.",
      "secondary_message": "2 bananas"
    },
    {
      "id": 434787,
      "primary_message": "Add yogurt, honey, and cinnamon to the bowl with the banana; stir to combine and set aside. ",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp honey\n¼ tsp cinnamon, ground"
    },
    {
      "id": 434788,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk to beat the cream vigorously, until medium-soft peaks form, about 2 minutes. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 434789,
      "primary_message": "Transfer ⅔ of the whipped cream to the bowl with the banana mixture (reserve remaining whipped cream for serving). Using a silicone spatula, gently fold the two together until the mousse is almost combined. ",
      "secondary_message": null
    },
    {
      "id": 434790,
      "primary_message": "To serve, divide mousse between small bowls, cups, or jars; top with reserved whipped cream, walnuts, and a sprinkle of cinnamon. Enjoy!",
      "secondary_message": "1 pinch cinnamon, ground"
    }
  ],
