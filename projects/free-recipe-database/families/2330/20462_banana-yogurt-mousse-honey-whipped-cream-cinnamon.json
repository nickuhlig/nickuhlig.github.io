  "instructions": [
    {
      "id": 434811,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 434812,
      "primary_message": "Peel bananas, break into chunks, and place in another medium bowl; crush with a fork or potato masher until smooth.",
      "secondary_message": "4 bananas"
    },
    {
      "id": 434813,
      "primary_message": "Add yogurt, honey, and cinnamon to the bowl with the banana; stir to combine and set aside. ",
      "secondary_message": "1 ⅓ cups plain Greek yogurt\n¼ cup honey\n½ tsp cinnamon, ground"
    },
    {
      "id": 434814,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 434815,
      "primary_message": "Transfer ⅔ of the whipped cream to the bowl with the banana mixture (reserve remaining whipped cream for serving). Using a silicone spatula, gently fold the two together until the mousse is almost combined. ",
      "secondary_message": null
    },
    {
      "id": 434816,
      "primary_message": "To serve, divide mousse between small bowls, cups, or jars; top with reserved whipped cream and a sprinkle of cinnamon. Enjoy!",
      "secondary_message": "⅛ tsp cinnamon, ground"
    }
  ],
