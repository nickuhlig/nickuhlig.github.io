  "instructions": [
    {
      "id": 434778,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 434779,
      "primary_message": "Peel bananas, break into chunks, and place in a large bowl; crush with a fork or potato masher until smooth.",
      "secondary_message": "6 bananas"
    },
    {
      "id": 434780,
      "primary_message": "Add yogurt, honey, and cinnamon to the bowl with the banana; stir to combine and set aside. ",
      "secondary_message": "2 cups plain Greek yogurt\n⅓ cup honey\n¾ tsp cinnamon, ground"
    },
    {
      "id": 434781,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 434782,
      "primary_message": "Transfer ⅔ of the whipped cream to the bowl with the banana mixture (reserve remaining whipped cream for serving). Using a silicone spatula, gently fold the two together until the mousse is almost combined. ",
      "secondary_message": null
    },
    {
      "id": 434783,
      "primary_message": "To serve, divide mousse between small bowls, cups, or jars; top with reserved whipped cream and a sprinkle of cinnamon. Enjoy!",
      "secondary_message": "3 pinch cinnamon, ground"
    }
  ],
