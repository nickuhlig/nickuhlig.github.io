  "instructions": [
    {
      "id": 1,
      "primary_message": "Light one chimney full of charcoal. When all charcoal is lit and covered with gray ash, pour out and arrange coals on one side of charcoal grate. Set cooking grate in place, cover grill, and allow to preheat for 5 minutes. Alternatively, set half the burners on a gas grill to the highest heat setting, cover, and preheat for 10 minutes. Clean and oil grilling grate.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While grill preheats, combine garlic, ginger, soy sauce, butter, and lemon juice. Stir with a fork until well combined. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place corn directly over hot side of fire. If using a coal grill, keep uncovered. If using gas, cover grill when not turning corn. Cook corn, turning every minute or so, until it is well charred on all sides, about 10 minutes total.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer corn to a large bowl. Coat with sauce using a spoon or brush. Transfer to a serving platter. Sprinkle with scallions and serve immediately.",
      "secondary_message": null
    }
  ],
