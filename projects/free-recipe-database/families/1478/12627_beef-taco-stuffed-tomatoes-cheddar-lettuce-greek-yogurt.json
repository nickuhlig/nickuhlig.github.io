  "instructions": [
    {
      "id": 332648,
      "primary_message": "Peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 332649,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332650,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 332651,
      "primary_message": "Add onion and garlic to the skillet; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 332652,
      "primary_message": "Add ground beef and spices to the skillet; cook, breaking apart with a spoon, until crumbly and cooked through, 7-8 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef\n2 tbsp chili powder\n1 ½ tsp salt\n1 ½ tsp cumin, ground\n¾ tsp garlic powder\n¾ tsp onion powder"
    },
    {
      "id": 332653,
      "primary_message": "Meanwhile, wash and dry tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom; sprinkle with salt.",
      "secondary_message": "12 tomatoes\n¾ tsp salt"
    },
    {
      "id": 332654,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 332655,
      "primary_message": "Wash and dry lettuce. Stack leaves, one on top of the other, halve lengthwise, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": "1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 332656,
      "primary_message": "To serve, divide tomatoes between plates. Stuff with beef and top with cheese, lettuce, and yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
