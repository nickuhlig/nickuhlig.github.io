  "instructions": [
    {
      "id": 332747,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 332748,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332749,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 332750,
      "primary_message": "Add onion and garlic to the skillet; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 332751,
      "primary_message": "Add ground beef and spices to the skillet; cook, breaking apart with a spoon, until crumbly and cooked through, 6-7 minutes.",
      "secondary_message": "0.68 kg lean ground beef\n4 tsp chili powder\n1 tsp salt\n1 tsp cumin, ground\n½ tsp garlic powder\n½ tsp onion powder"
    },
    {
      "id": 332752,
      "primary_message": "Meanwhile, wash and dry tomatoes. Cut into wedges and season with salt; set aside.",
      "secondary_message": "6 tomatoes\n½ tsp salt"
    },
    {
      "id": 332753,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 332754,
      "primary_message": "Wash and dry lettuce. Stack leaves, one on top of the other, halve lengthwise, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 332755,
      "primary_message": "To serve, divide tomato wedges between plates, arranging them in a circle. Fill the center with beef, cheese, lettuce, and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
