  "instructions": [
    {
      "id": 332684,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332685,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 332686,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 332687,
      "primary_message": "Add onion and garlic to the skillet; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 332688,
      "primary_message": "Add veggie ground and spices to the skillet; cook, breaking it apart with a spoon, until browned and crumbly 5-6 minutes. Remove from heat.",
      "secondary_message": "8 oz veggie ground, plant based\n2 tsp chili powder\n½ tsp cumin, ground\n¼ tsp salt\n¼ tsp garlic powder\n¼ tsp onion powder"
    },
    {
      "id": 332689,
      "primary_message": "Meanwhile, wash and dry tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom; sprinkle with salt.",
      "secondary_message": "4 tomatoes\n¼ tsp salt"
    },
    {
      "id": 332690,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "⅓ (8 oz) block cheddar cheese"
    },
    {
      "id": 332691,
      "primary_message": "Wash and dry lettuce. Stack leaves, one on top of the other, halve lengthwise, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": "½ head butter (Boston) lettuce"
    },
    {
      "id": 332692,
      "primary_message": "To serve, divide tomatoes between plates. Stuff with veggie ground and top with cheese, lettuce, and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
