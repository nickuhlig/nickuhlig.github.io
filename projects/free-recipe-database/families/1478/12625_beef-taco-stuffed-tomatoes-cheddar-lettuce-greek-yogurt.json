  "instructions": [
    {
      "id": 332630,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 332631,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 332632,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 332633,
      "primary_message": "Add onion and garlic to the skillet; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 332634,
      "primary_message": "Add ground beef and spices to the skillet; cook, breaking apart with a spoon, until crumbly and cooked through, 6-8 minutes.",
      "secondary_message": "¾ lb lean ground beef\n2 tsp chili powder\n½ tsp salt\n½ tsp cumin, ground\n¼ tsp garlic powder\n¼ tsp onion powder"
    },
    {
      "id": 332635,
      "primary_message": "Meanwhile, wash and dry tomatoes. Slicing from the top down, cut tomatoes into wedges, being careful to not cut completely through to the bottom; sprinkle with salt.",
      "secondary_message": "4 tomatoes\n¼ tsp salt"
    },
    {
      "id": 332636,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 332637,
      "primary_message": "Wash and dry lettuce. Stack leaves, one on top of the other, halve lengthwise, then chop crosswise into thin (shred-like) strips.",
      "secondary_message": "½ head butter (Boston) lettuce"
    },
    {
      "id": 332638,
      "primary_message": "To serve, divide tomatoes between plates. Stuff with beef and top with cheese, lettuce, and yogurt. Enjoy!",
      "secondary_message": "⅛ cup plain Greek yogurt"
    }
  ],
