  "instructions": [
    {
      "id": 466703,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 466704,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 466705,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 fennel bulbs\n½ lemon\n½ bunch radish\n½ small bunch fresh dill\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 466706,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 466707,
      "primary_message": "Place fennel in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until slightly browned and tender, about 20 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 466708,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add oil, maple syrup, and spices, then whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 466709,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 466710,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 466711,
      "primary_message": "Roughly chop dates and pistachios. Add both to the bowl. ",
      "secondary_message": "⅓ cup medjool dates, pitted\n⅓ cup pistachios, unsalted"
    },
    {
      "id": 466712,
      "primary_message": "Transfer the cooked quinoa to another baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 466713,
      "primary_message": "Add cooled fennel and quinoa to the bowl, along with arugula, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 466714,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
