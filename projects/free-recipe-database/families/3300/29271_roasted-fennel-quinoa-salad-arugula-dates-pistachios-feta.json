  "instructions": [
    {
      "id": 466691,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 466692,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 466693,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 fennel bulbs\n1 ½ lemons\n1 ½ bunches radish\n1 small bunch fresh dill\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 466694,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Divide between two large baking sheet pans, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 466695,
      "primary_message": "Place fennel in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until slightly browned and tender, 20-25 minutes. Remove from oven and set aside to cool, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 466696,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, maple syrup, and spices, then whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 466697,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 466698,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 466699,
      "primary_message": "Roughly chop dates and pistachios. Add both to the bowl. ",
      "secondary_message": "1 cup medjool dates, pitted\n1 cup pistachios, unsalted"
    },
    {
      "id": 466700,
      "primary_message": "Transfer the cooked quinoa to a third large baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 466701,
      "primary_message": "Add cooled fennel and quinoa to the bowl, along with arugula and feta, then toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 466702,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
