  "instructions": [
    {
      "id": 412197,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 limes\n1 ½ jalapeño peppers\n1 small bunch cilantro\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "id": 412198,
      "primary_message": "Peel and mince ginger and garlic. Place both in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 412199,
      "primary_message": "Juice half of the limes into the bowl with the ginger and garlic (set aside remaining limes for later use). Add yogurt, honey, and spices, then whisk to combine the marinade.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 ½ tsp honey\n1 tbsp garam masala\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp cayenne pepper\n3 pinch black pepper"
    },
    {
      "id": 412200,
      "primary_message": "Pat cod dry with paper towels, then cut crosswise into 1-inch thick fingers. Add to the bowl with the marinade and stir to coat. Set aside.",
      "secondary_message": "1.02 kg cod fillet"
    },
    {
      "id": 412201,
      "primary_message": "Place vinegar, honey, and salt in a medium bowl. Stir to combine the pickling liquid.",
      "secondary_message": "½ cup rice vinegar\n2 ½ tsp honey\n1 ½ tsp salt"
    },
    {
      "id": 412202,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 412203,
      "primary_message": "Preheat oven to broil on high and position rack about 6 inches from the top. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional), then coat with a thin layer of oil. Set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 412204,
      "primary_message": "While the broiler is heating, juice reserved limes into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 412205,
      "primary_message": "Using a clean cutting board, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 412206,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 412207,
      "primary_message": "Peel, trim, and coarsely grate cucumbers. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add to the bowl along with additional yogurt, honey, and salt; stir to combine the raita and set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n2 tbsp honey\n¾ tsp salt"
    },
    {
      "id": 412208,
      "primary_message": "Transfer fish to the baking sheet and arrange in a single layer. Place baking sheet in the oven and broil, turning the fish pieces halfway through, until golden and flesh flakes with a fork, 5-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 412209,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 412210,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Halve lengthwise, then slice crosswise into thin pieces. Season with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 412211,
      "primary_message": "To serve, divide tortillas between plates; fill with raita, avocado, fish, and pickled onion. Enjoy!",
      "secondary_message": null
    }
  ],
