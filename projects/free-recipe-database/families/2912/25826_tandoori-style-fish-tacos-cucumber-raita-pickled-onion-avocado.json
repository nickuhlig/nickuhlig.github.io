  "instructions": [
    {
      "id": 412137,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 limes\n1 jalapeño pepper\n1 small bunch cilantro\n1 English cucumber\n1 avocado"
    },
    {
      "id": 412138,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 412139,
      "primary_message": "Juice one lime into the bowl with the ginger and garlic (set aside remaining lime for later use). Add yogurt, honey, and spices, then whisk to combine the marinade.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tsp honey\n2 tsp garam masala\n1 tsp turmeric, ground\n1 tsp salt\n½ tsp cayenne pepper\n⅛ tsp black pepper"
    },
    {
      "id": 412140,
      "primary_message": "Pat cod dry with paper towels, then cut crosswise into 1-inch thick fingers. Add to the bowl with the marinade and stir to coat. Set aside.",
      "secondary_message": "1 ½ lb cod fillet"
    },
    {
      "id": 412141,
      "primary_message": "Place vinegar, honey, and salt in a small bowl. Stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup rice vinegar\n1 ½ tsp honey\n1 tsp salt"
    },
    {
      "id": 412142,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 412143,
      "primary_message": "Preheat oven to broil on high and position rack about 6 inches from the top. Line a baking sheet pan with aluminum foil to make cleanup easier (optional), then coat with a thin layer of oil. Set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 412144,
      "primary_message": "While the broiler is heating, juice reserved lime into another small bowl.",
      "secondary_message": null
    },
    {
      "id": 412145,
      "primary_message": "Using a clean cutting board, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 412146,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 412147,
      "primary_message": "Peel, trim, and coarsely grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add to the bowl along with additional yogurt, honey, and salt; stir to combine the raita and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n4 tsp honey\n½ tsp salt"
    },
    {
      "id": 412148,
      "primary_message": "Transfer fish to the baking sheet and arrange in a single layer. Place baking sheet in the oven and broil, turning the fish pieces halfway through, until golden and flesh flakes with a fork, 5-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 412149,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 412150,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh. Halve lengthwise, then slice crosswise into thin pieces. Season with salt.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 412151,
      "primary_message": "To serve, divide tortillas between plates; fill with raita, avocado, fish, and pickled onion. Enjoy!",
      "secondary_message": null
    }
  ],
