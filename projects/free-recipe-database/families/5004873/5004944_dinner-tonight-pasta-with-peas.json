  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a large pot of water to a boil. Melt the butter in a large pan over medium heat. Toss in the onion and cook until slightly wilted.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Plunge the shells in the boiling water. Cook according to package instructions. With five minutes left, add the peas to the onions, and add a tablespoon of the cooking liquid.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When the pasta is done, toss with the butter and onions over medium high heat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Sprinkle in the chopped basil, shred some cheese, and season with salt and pepper.",
      "secondary_message": null
    }
