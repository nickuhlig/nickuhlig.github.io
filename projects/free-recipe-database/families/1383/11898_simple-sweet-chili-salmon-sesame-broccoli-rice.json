  "instructions": [
    {
      "id": 201097,
      "primary_message": "Preheat oven to 400°F. Line two baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 201098,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 201099,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 201100,
      "primary_message": "Meanwhile, place vinegar, sugar, water, chili-garlic sauce, and salt in a large pot. Whisking occasionally, bring to a boil over high heat.",
      "secondary_message": "⅓ cup rice vinegar\n⅓ cup brown sugar\n⅓ cup water\n1 ½ tsp chili-garlic sauce\n1 ½ tsp salt"
    },
    {
      "id": 201101,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "3 tbsp water\n2 tbsp cornstarch"
    },
    {
      "id": 201102,
      "primary_message": "Add cornstarch slurry to the pot in a steady stream while whisking quickly. Cook, whisking continuously, until the sweet chili sauce thickens, 30-60 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 201103,
      "primary_message": "Place salmon, skin-side down, on the baking sheets. Spoon the sweet chili sauce evenly over each filet.",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 201104,
      "primary_message": "Place salmon in the oven and bake until opaque and flaky, 12-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 201105,
      "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 201106,
      "primary_message": "Wipe pot clean with paper towels and place over medium heat.",
      "secondary_message": null
    },
    {
      "id": 201107,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup toasted sesame oil"
    },
    {
      "id": 201108,
      "primary_message": "Add broccoli and stir-fry until bright green and tender-crisp, 7-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 201109,
      "primary_message": "To serve, divide rice, salmon, and broccoli between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
