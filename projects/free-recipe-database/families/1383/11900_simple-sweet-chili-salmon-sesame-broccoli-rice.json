  "instructions": [
    {
      "id": 201123,
      "primary_message": "Preheat oven to 205°C (400°F). Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 201124,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 201125,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 201126,
      "primary_message": "Meanwhile, place vinegar, sugar, water, chili-garlic sauce, and salt in a large skillet. Whisking occasionally, bring to a boil over high heat.",
      "secondary_message": "¼ cup rice vinegar\n¼ cup brown sugar\n¼ cup water\n1 tsp chili-garlic sauce\n1 tsp salt"
    },
    {
      "id": 201127,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "2 tbsp water\n1 tbsp cornstarch"
    },
    {
      "id": 201128,
      "primary_message": "Add cornstarch slurry to the skillet in a steady stream while whisking quickly. Cook, whisking continuously, until the sweet chili sauce thickens, about 30 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 201129,
      "primary_message": "Place salmon, skin-side down, on the baking sheet. Spoon the sweet chili sauce evenly over each filet.",
      "secondary_message": "0.68 kg salmon fillet"
    },
    {
      "id": 201130,
      "primary_message": "Place salmon in the oven and bake until opaque and flaky, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 201131,
      "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 201132,
      "primary_message": "Wipe skillet clean with paper towels and place over medium heat.",
      "secondary_message": null
    },
    {
      "id": 201133,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup toasted sesame oil"
    },
    {
      "id": 201134,
      "primary_message": "Add broccoli and stir-fry until bright green and tender-crisp, 5-7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 201135,
      "primary_message": "To serve, divide rice, salmon, and broccoli between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
