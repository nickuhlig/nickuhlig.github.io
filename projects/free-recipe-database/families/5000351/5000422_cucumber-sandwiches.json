  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the unpeeled English cucumber into 1/8-inch-thick rounds.",
      "secondary_message": "¼ unpeeled English cucumber"
    },
    {
      "id": 1,
      "primary_message": "In a colander, toss cucumbers with salt and set over a bowl; let stand uncovered at room temperature for 20 minutes. Shake colander to drain off excess liquid and gently pat cucumbers dry with paper towels. In an empty bowl, toss dried cucumber slices with the lemon juice and dill (if using); set aside until ready to use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, use a serrated knife to trim crusts from bread slices to form roughly 2 1/2– by 2 1/2–inch bread squares.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spread butter or cream cheese evenly on 1 side of each bread slice. Top half of the buttered bread slices with the cucumber slices (about 6 cucumber slices per bread slice). Top with the remaining bread slices, buttered sides down. Press down gently on sandwiches to adhere fillings.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Using a sharp knife, cut each sandwich into triangles and arrange attractively on a serving platter. Serve immediately.",
      "secondary_message": null
    }
  ],
