  "instructions": [
    {
      "id": 96193,
      "primary_message": "Preheat oven to 205°C (400°F) and position a rack near the bottom of the oven. Grease 12 muffin cups with butter.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 96194,
      "primary_message": "Line each muffin cup with a slice of prosciutto, doing your best to cover the sides and bottom surface of the tin.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 96195,
      "primary_message": "Wash and dry the spinach (unless it came pre-washed). Lay the spinach leaves over the prosciutto.",
      "secondary_message": "⅜ (142 g) pkg baby spinach"
    },
    {
      "id": 96196,
      "primary_message": "Crack an egg into each muffin cup.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 96197,
      "primary_message": "Bake until the whites of the eggs are set but the yolk is still runny (or until desired doneness), about 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 96198,
      "primary_message": "Remove from the oven and let cool for 1 minute so the eggs set. Use a spatula to wedge each egg out of its cup.",
      "secondary_message": null
    },
    {
      "id": 96199,
      "primary_message": "Season with pepper and serve immediately; enjoy!",
      "secondary_message": "3 pinch black pepper"
    }
  ],
