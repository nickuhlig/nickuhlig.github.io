  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Pour 4 tablespoons melted butter into 9-inch cake pan and swirl to coat bottom. Evenly sprinkle brown sugar into bottom of pan. Arrange mango slices in one even layer over sugar.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large bowl, whisk remaining 6 tablespoons melted butter with sugar, salt, eggs, coconut milk, and vanilla. In small bowl, whisk flour, coconut, and baking powder until combined. Whisk into egg mixture until just combined. Spread into pan over fruit and smooth the top.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake until golden and a toothpick inserted into center comes out clean, 45 to 50 minutes. Let cake cool in pan 45 minutes. Run knife along inside edge of pan to loosen, then invert onto serving plate or cooling rack to finish cooling.",
      "secondary_message": null
    }
  ],
