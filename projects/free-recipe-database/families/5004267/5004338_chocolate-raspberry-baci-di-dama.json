  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "1 cup unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 175°C (350°F). Spread almonds on a baking sheet and toast until golden, about 12 minutes. Let cool. Place almonds in a food processor with 1 tablespoon sugar. Pulse until almonds are finely ground. Set aside. Oven can be turned off.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, instant espresso, cocoa powder, baking powder, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat together butter and confectioners' sugar until light and fluffy, about 3 minutes. Beat in rum and vanilla until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add flour mixture to bowl and beat until just incorporated. Beat in ground almonds. Cover dough in plastic wrap and let chill in refrigerator for one hour.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Preheat oven to 165°C (325°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Divide dough into 4 parts. Roll first section into a log that is 2 cm wide. Cut log into 1.5 cm pieces, similar to making gnocchi. Roll each piece into a ball. Continue with remaining dough.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Place remaining sugar in a shallow bowl. Gently roll each ball of dough in sugar to coat. Place balls on baking sheet.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Bake cookies until dry and cracked on top, about 15 minutes. Let cool.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Spread bottom side of 1/2 of cookies with a thin layer of raspberry jam. Top each with a remaining cookie to complete the sandwiches.",
      "secondary_message": null
    }
  ],
