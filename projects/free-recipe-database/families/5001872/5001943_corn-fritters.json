  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly chop the yellow onion.",
      "secondary_message": "¼ medium yellow onion"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together cornmeal, flour, cornstarch, and baking powder until well combined; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In the bowl of a food processor, place 1 1/2 cups (255 g) corn, onion, egg, and salt. Process until a coarse puree forms, about 30 seconds, stopping to scrape down sides of bowl as needed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer pureed corn mixture to the large bowl with cornstarch mixture along with remaining 1 1/2 cups (255 g) corn kernels, and fold until just combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Set a wire rack in a rimmed baking sheet and line with paper towels; set aside. Fill a large Dutch oven with 4 cm of oil and heat over medium-high until oil registers 175°C (350°F) with an instant-read thermometer. Working in batches of about 8 at a time, drop 1 1/2 tablespoon portions of corn batter gently into oil. Fry, stirring and flipping fritters often, until golden brown all over, 3 to 4 minutes. Using a slotted spoon or spider skimmer, transfer fritters to prepared baking sheet, and sprinkle with salt to taste. Serve immediately with maple syrup, cane syrup, or honey, if using.",
      "secondary_message": null
    }
  ],
