  "instructions": [
    {
      "id": 477794,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 477795,
      "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate. Season both sides with salt and pepper.",
      "secondary_message": "4 pork chops, boneless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 477796,
      "primary_message": "Once the pan is hot, coat with oil. Add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 477797,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 oranges\n1 lb Brussels sprouts\n1 small bunch green onions (scallions)\n2 avocados"
    },
    {
      "id": 477798,
      "primary_message": "Juice one orange into a medium bowl. Add fish sauce and oil, then stir to combine the dressing. (Reserve remaining oranges for the next step.)",
      "secondary_message": "2 tbsp fish sauce\n2 tsp extra virgin olive oil"
    },
    {
      "id": 477799,
      "primary_message": "Peel and halve remaining oranges, then slice crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 477800,
      "primary_message": "Trim Brussels sprouts, then using a mandoline slicer (optional), shave or very thinly slice the sprouts. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477801,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 477802,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with pumpkin seeds, and stir to combine the salad.",
      "secondary_message": "½ cup pumpkin seeds"
    },
    {
      "id": 477803,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 477804,
      "primary_message": "To serve, divide pork chops and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
