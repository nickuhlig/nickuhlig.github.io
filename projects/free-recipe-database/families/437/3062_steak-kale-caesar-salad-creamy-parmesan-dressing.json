  "instructions": [
    {
      "id": 30453,
      "primary_message": "Wash and dry the kale leaves and lemon.",
      "secondary_message": "1 bunch kale\n½ lemon"
    },
    {
      "id": 30454,
      "primary_message": "One kale leaf at a time, cut along the sides of the tough center ribs, then pull out and discard the ribs. When all the leaves are trimmed, chop them into 1-inch pieces and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 30466,
      "primary_message": "Cut the lemon in half; juice one half into a small bowl (that is big enough for making the dressing) and cut the other half into wedges for serving.",
      "secondary_message": ""
    },
    {
      "id": 30464,
      "primary_message": "Finely grate ¼ cup of Parmesan.",
      "secondary_message": "½ oz Parmesan cheese"
    },
    {
      "id": 30465,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 30467,
      "primary_message": "Add ½ of the grated Parmesan (save the rest for garnishing), the minced garlic, yogurt, Dijon, Worcestershire, salt, and pepper to the bowl with the lemon juice; whisk together until smooth.",
      "secondary_message": "¼ cup plain Greek yogurt\n½ tsp Dijon mustard\n1 tsp Worcestershire sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 30468,
      "primary_message": "Pour the dressing over the kale and toss to combine. If the kale is tough, massage it with your hands to soften it.",
      "secondary_message": null
    },
    {
      "id": 30460,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 30459,
      "primary_message": "While the skillet heats up, cut the bun or roll into ¾-inch cubes.",
      "secondary_message": "1 whole grain bun or roll"
    },
    {
      "id": 30461,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 30462,
      "primary_message": "Add the bread cubes to the skillet; sprinkle with salt and toss to coat in the oil, then arrange in a single layer. Toast the bread, tossing occasionally, until the bread cubes are golden brown, 4 to 5 minutes. Once done, transfer the croutons to a bowl and return the skillet to the stove.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 30463,
      "primary_message": "Wipe out the skillet with a paper towel and heat over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 30456,
      "primary_message": "While the skillet heats up, pat dry the steak with paper towels and season it generously with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 30457,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 30458,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak for 4 to 6 minutes for medium-rare, or until desired doneness. (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 30469,
      "primary_message": "Slice the steak against the grain into thin strips.",
      "secondary_message": null
    },
    {
      "id": 30470,
      "primary_message": "To serve, arrange a bed of the kale on a plate and top with the croutons, remaining Parmesan, and steak slices. Garnish with lemon wedges for squeezing over the top.",
      "secondary_message": null
    }
  ],
