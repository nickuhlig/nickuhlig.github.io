  "instructions": [
    {
      "id": 282057,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ bunch radish\n1 avocado\n½ lime\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 282058,
      "primary_message": "Place oil, vinegar, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n½ tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 282059,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 282060,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 282061,
      "primary_message": "While the pan heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate; season with spices on the top-side.",
      "secondary_message": "⅓ kg salmon fillet\n½ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 282062,
      "primary_message": "Once the pan is hot, coat with oil. Add salmon and cook until opaque and easily flakes with a fork, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 282063,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 282064,
      "primary_message": "Halve avocado and remove pit; scoop out the flesh into the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 282065,
      "primary_message": "Juice lime into the bowl, add salt, and mash the guacamole with a fork or potato masher until smooth.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 282066,
      "primary_message": "Roughly chop pumpkin seeds, add to the bowl with the guacamole, and stir to combine.",
      "secondary_message": "¼ cup pumpkin seeds"
    },
    {
      "id": 282067,
      "primary_message": "Right before serving, add arugula to the bowl with the dressing and radish; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 282068,
      "primary_message": "To serve, divide salmon and salad between plates; top salmon with guacamole and enjoy!",
      "secondary_message": null
    }
  ],
