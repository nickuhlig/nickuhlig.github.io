  "instructions": [
    {
      "id": 281973,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ bunches radish\n3 avocados\n1 ½ limes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 281974,
      "primary_message": "Place oil, vinegar, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 ½ tsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 281975,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 281976,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 281977,
      "primary_message": "While the pan heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate; season with spices on the top-side.",
      "secondary_message": "2 ¼ lb salmon fillet\n1 ½ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 281978,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add salmon and cook until opaque and easily flakes with a fork, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 281979,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 281980,
      "primary_message": "Halve avocados and remove pits; scoop out the flesh into the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 281981,
      "primary_message": "Juice limes into the bowl, add salt, and mash the guacamole with a fork or potato masher until smooth.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 281982,
      "primary_message": "Roughly chop walnuts, add to the bowl with the guacamole, and stir to combine.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 281983,
      "primary_message": "Right before serving, add arugula to the bowl with the dressing and radish; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 281984,
      "primary_message": "To serve, divide salmon and salad between plates; top salmon with guacamole and enjoy!",
      "secondary_message": null
    }
  ],
