  "instructions": [
    {
      "id": 405068,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 405069,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 405070,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 405071,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, carrots, and salt. Cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ (283 g) bags shredded carrots\n¾ tsp salt"
    },
    {
      "id": 405072,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice zucchini. Add to the pot and cook, stirring occasionally, until veggies are tender, 3-4 minutes more.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 405073,
      "primary_message": "While the veggies are cooking, using a strainer or colander, rinse the rice under cold, running water.",
      "secondary_message": "1 ½ cups jasmine rice"
    },
    {
      "id": 405074,
      "primary_message": "When the veggies are tender, add rice and broth to the pot, stir to combine, and bring to a boil over high heat.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 405075,
      "primary_message": "Once the liquid comes to a boil, cover the pot and reduce heat to low. Cook rice pilaf until liquid is fully absorbed, 15-18 minutes. Once done, remove from heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 405076,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 405077,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a large bowl, then sprinkle with cornstarch, Cajun seasoning, and salt; gently stir to coat.",
      "secondary_message": "1 tbsp cornstarch\n1 tbsp Cajun seasoning\n½ tsp salt"
    },
    {
      "id": 405078,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the tofu and cook, turning occasionally, until golden brown and crispy, 7-8 minutes; remove to a plate. ",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 405079,
      "primary_message": "To serve, divide rice pilaf and tofu between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
