  "instructions": [
    {
      "id": 404898,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 404899,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 404900,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion, carrots, and salt. Cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 ½ (10 oz) bags shredded carrots\n¾ tsp salt"
    },
    {
      "id": 404901,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice zucchini. Add to the pot and cook, stirring occasionally, until veggies are tender, 3-4 minutes more.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 404902,
      "primary_message": "While the veggies are cooking, using a strainer or colander, rinse the rice under cold, running water.",
      "secondary_message": "1 ½ cups jasmine rice"
    },
    {
      "id": 404903,
      "primary_message": "When the veggies are tender, add rice and broth to the pot, stir to combine, and bring to a boil over high heat. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 404904,
      "primary_message": "Once the liquid comes to a boil, cover the pot and reduce heat to low. Cook rice pilaf until liquid is fully absorbed, 15-18 minutes. Once done, remove from heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 404905,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 404906,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a plate; sprinkle with Cajun seasoning on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n1 tbsp Cajun seasoning"
    },
    {
      "id": 404907,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and cover with aluminum foil to keep warm.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 404908,
      "primary_message": "To serve, divide rice pilaf and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
