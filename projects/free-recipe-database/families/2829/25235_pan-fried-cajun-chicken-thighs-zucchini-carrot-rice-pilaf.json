  "instructions": [
    {
      "id": 404989,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 404990,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 404991,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add onion, carrots, and salt. Cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "4 tsp butter, unsalted\n1 (283 g) bag shredded carrots\n½ tsp salt"
    },
    {
      "id": 404992,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice zucchini. Add to the pan and cook, stirring occasionally, until veggies are tender, 3-4 minutes more.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 404993,
      "primary_message": "While the veggies are cooking, using a strainer or colander, rinse the rice under cold, running water.",
      "secondary_message": "1 cup jasmine rice"
    },
    {
      "id": 404994,
      "primary_message": "When the veggies are tender, add rice and broth to the pan, stir to combine, and bring to a boil over high heat. ",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 404995,
      "primary_message": "Once the liquid comes to a boil, cover the pan and reduce heat to low. Cook rice pilaf until liquid is fully absorbed, 15-18 minutes. Once done, remove from heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 404996,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 404997,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a plate; sprinkle with Cajun seasoning on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n2 tsp Cajun seasoning"
    },
    {
      "id": 404998,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and cover with aluminum foil to keep warm.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 404999,
      "primary_message": "To serve, divide rice pilaf and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
