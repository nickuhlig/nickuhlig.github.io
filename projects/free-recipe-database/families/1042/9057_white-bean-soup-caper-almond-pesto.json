  "instructions": [
    {
      "id": 141309,
      "primary_message": "This recipe will make about 8 cups. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 141310,
      "primary_message": "Drain and rinse the beans in a colander.",
      "secondary_message": "4 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 141311,
      "primary_message": "Peel and roughly chop the onion; peel and mince the garlic.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 141312,
      "primary_message": "In a blender, combine beans, onion, garlic, broth, almond milk, and spices. Blend on high until smooth.",
      "secondary_message": "473 ml chicken or vegetable broth\n473 ml almond milk, unsweetened\n1 tsp salt\n½ tsp black pepper\n½ tsp thyme\n½ tsp basil\n½ tsp oregano\n½ tsp parsley flakes"
    },
    {
      "id": 141313,
      "primary_message": "Pour soup into a large pot, cover and place over medium heat. Cook, stirring occasionally, until warmed through and fragrant, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 141314,
      "primary_message": "Meanwhile, wash and pick basil leaves off the stems; roll up crosswise, and mince. Place in a small bowl.",
      "secondary_message": "2 small pkgs fresh basil"
    },
    {
      "id": 141315,
      "primary_message": "Finely chop the almonds and capers; add both to the bowl with the basil.",
      "secondary_message": "¼ cup almonds, sliced\n2 tbsp capers"
    },
    {
      "id": 141316,
      "primary_message": "Add oil and spices to the bowl with the basil and capers. Stir to combine the pesto.",
      "secondary_message": "¼ cup extra virgin olive oil\n½ tsp garlic powder\n½ tsp oregano\n⅛ tsp black pepper"
    },
    {
      "id": 141317,
      "primary_message": "To serve, divide soup between bowls; drizzle with olive oil and top with pesto. Enjoy!",
      "secondary_message": null
    }
  ],
