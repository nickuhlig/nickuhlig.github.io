  "instructions": [
    {
      "id": 458222,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 458223,
      "primary_message": "Wash, dry, and quarter potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, about 10 minutes.",
      "secondary_message": "2 ¼ lb new potatoes\n1 ½ tsp salt"
    },
    {
      "id": 458224,
      "primary_message": "Meanwhile, peel, halve, and slice onions crosswise into thin half-moons. Peel and mince garlic.",
      "secondary_message": "3 medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 458225,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 458226,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion and garlic to the pot; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 458227,
      "primary_message": "Add veggie ground and spices to the pot. Cook, breaking it apart with a spoon, until browned and crumbly 5-6 minutes. Remove from heat.",
      "secondary_message": "24 oz veggie ground, plant based\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 458228,
      "primary_message": "While the veggie ground is cooking, coarsely grate mozzarella.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 458229,
      "primary_message": "When the potatoes are done, drain and add to the pot with the veggie ground and onions. Gently crush some of the potatoes using a fork or potato masher. Add broth to the pot and stir to combine. (Reserve pot used for the potatoes for later use.)",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 458230,
      "primary_message": "Transfer veggie ground mixture to a large baking dish. Sprinkle mozzarella over the veggie ground and potatoes.",
      "secondary_message": null
    },
    {
      "id": 458231,
      "primary_message": "Place baking dish in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 458232,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 458233,
      "primary_message": "Return the pot to medium heat.",
      "secondary_message": null
    },
    {
      "id": 458234,
      "primary_message": "Once the pot is hot, add additional butter and swirl to coat the bottom. Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, and remove from heat.",
      "secondary_message": "3 tbsp butter, unsalted\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 458235,
      "primary_message": "To serve, divide veggie ground-potato bake and spinach between plates. Enjoy!",
      "secondary_message": null
    }
  ],
