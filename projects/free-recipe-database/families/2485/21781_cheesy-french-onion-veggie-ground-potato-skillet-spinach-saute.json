  "instructions": [
    {
      "id": 458196,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 458197,
      "primary_message": "Wash, dry, and quarter potatoes; place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, about 10 minutes.",
      "secondary_message": "¾ lb new potatoes\n½ tsp salt"
    },
    {
      "id": 458198,
      "primary_message": "Meanwhile, preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 458199,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n1 clove garlic"
    },
    {
      "id": 458200,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion and garlic to the skillet; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 458201,
      "primary_message": "Add veggie ground and spices to the skillet. Cook, breaking it apart with a spoon, until browned and crumbly 4-5 minutes. Remove from heat.",
      "secondary_message": "8 oz veggie ground, plant based\n½ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 458202,
      "primary_message": "While the veggie ground is cooking, coarsely grate mozzarella.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 458203,
      "primary_message": "When the potatoes are done, drain and add to the skillet with the veggie ground and onions. Gently crush some of the potatoes using a fork or potato masher. Add broth to the skillet and stir to combine. (Reserve pan for later use.)",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 458204,
      "primary_message": "Sprinkle mozzarella over the veggie ground and potatoes. Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 458205,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 458206,
      "primary_message": "Return the saucepan to medium heat.",
      "secondary_message": null
    },
    {
      "id": 458207,
      "primary_message": "Once the pan is hot, add additional butter and swirl to coat the bottom. Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, and remove from heat.",
      "secondary_message": "1 tbsp butter, unsalted\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 458208,
      "primary_message": "To serve, divide veggie ground-potato skillet and spinach between plates. Enjoy!",
      "secondary_message": null
    }
  ],
