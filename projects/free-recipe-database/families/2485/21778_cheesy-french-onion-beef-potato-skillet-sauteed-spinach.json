  "instructions": [
    {
      "id": 458156,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 458157,
      "primary_message": "Wash, dry, and quarter potatoes; place in a medium saucepan, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, about 10 minutes.",
      "secondary_message": "¾ lb new potatoes\n½ tsp salt"
    },
    {
      "id": 458158,
      "primary_message": "Meanwhile, preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 458159,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n1 clove garlic"
    },
    {
      "id": 458160,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion and garlic to the skillet; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 458161,
      "primary_message": "Add beef and spices to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly 4-5 minutes. Remove from heat.",
      "secondary_message": "¾ lb lean ground beef\n½ tsp thyme, dried\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 458162,
      "primary_message": "While the beef is cooking, coarsely grate mozzarella.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 458163,
      "primary_message": "When the potatoes are done, drain and add to the skillet with the beef and onions. Gently crush some of the potatoes using a fork or potato masher. Add broth and Worcestershire to the skillet and stir to combine. (Reserve pan for later use.)",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n2 tsp Worcestershire sauce"
    },
    {
      "id": 458164,
      "primary_message": "Sprinkle mozzarella over the beef and potatoes. Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 458165,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 458166,
      "primary_message": "Return the saucepan to medium heat.",
      "secondary_message": null
    },
    {
      "id": 458167,
      "primary_message": "Once the pan is hot, add additional butter and swirl to coat the bottom. Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, and remove from heat.",
      "secondary_message": "2 tsp butter, unsalted\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 458168,
      "primary_message": "To serve, divide beef-potato skillet and spinach between plates. Enjoy!",
      "secondary_message": null
    }
  ],
