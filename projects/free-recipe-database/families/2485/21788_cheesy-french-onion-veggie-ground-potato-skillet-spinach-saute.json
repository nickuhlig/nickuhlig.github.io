  "instructions": [
    {
      "id": 458289,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 458290,
      "primary_message": "Wash, dry, and quarter potatoes; place in a large pot, along with salt, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until fork-tender, about 10 minutes.",
      "secondary_message": "0.68 kg new potatoes\n1 tsp salt"
    },
    {
      "id": 458291,
      "primary_message": "Meanwhile, peel, halve, and slice onions crosswise into thin half-moons. Peel and mince garlic.",
      "secondary_message": "2 medium yellow onions\n2 cloves garlic"
    },
    {
      "id": 458292,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 458293,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add onion and garlic to the skillet; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 458294,
      "primary_message": "Add veggie ground and spices to the skillet. Cook, breaking it apart with a spoon, until browned and crumbly 4-5 minutes. Remove from heat.",
      "secondary_message": "454 g veggie ground, plant based\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 458295,
      "primary_message": "While the veggie ground is cooking, coarsely grate mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 458296,
      "primary_message": "When the potatoes are done, drain and add to the skillet with the veggie ground and onions. Gently crush some of the potatoes using a fork or potato masher. Add broth to the skillet and stir to combine. (Reserve pot for later use.)",
      "secondary_message": "177 ml chicken or vegetable broth"
    },
    {
      "id": 458297,
      "primary_message": "Sprinkle mozzarella over the veggie ground and potatoes. Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 458298,
      "primary_message": "Meanwhile, wash and dry the spinach. (Skip this step if it came pre-washed.)",
      "secondary_message": "2 (142 g) pkgs baby spinach"
    },
    {
      "id": 458299,
      "primary_message": "Return the pot to medium heat.",
      "secondary_message": null
    },
    {
      "id": 458300,
      "primary_message": "Once the pot is hot, add additional butter and swirl to coat the bottom. Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Season with salt and pepper, stir to combine, and remove from heat.",
      "secondary_message": "2 tbsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 458301,
      "primary_message": "To serve, divide veggie ground-potato skillet and spinach between plates. Enjoy!",
      "secondary_message": null
    }
  ],
