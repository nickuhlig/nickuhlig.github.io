  "instructions": [
    {
      "id": 14060,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": ""
    },
    {
      "id": 14061,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Transfer to a baking sheet pan. Drizzle with olive oil and season with cumin, salt, and pepper.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n2 tsp cumin\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 14062,
      "primary_message": "Place in the oven and, stirring halfway through, roast until crispy, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 14063,
      "primary_message": "In a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "472 ml (2 cups) chicken or vegetable broth\n1 ⅓ cups whole wheat couscous"
    },
    {
      "id": 14064,
      "primary_message": "Wash and dry arugula. Transfer to a large bowl.",
      "secondary_message": "1 (142 g) pkg baby arugula"
    },
    {
      "id": 14065,
      "primary_message": "Medium dice apricots and add to bowl with arugula. Shell pistachios and add to bowl.",
      "secondary_message": "16 dried apricots\r\n½ cup pistachios, unsalted"
    },
    {
      "id": 14066,
      "primary_message": "Add feta to bowl.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 14067,
      "primary_message": "Grate 2 tsp of lemon zest. Peel and mince garlic. In a small bowl, prepare dressing by whisking together zest, garlic, lemon juice, olive oil, honey, cumin, salt, and pepper.",
      "secondary_message": "zest and juice of 1 lemon\r\n2 cloves garlic\r\n4 tbsp extra virgin olive oil\r\n2 tsp honey\r\n½ tsp cumin\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 14068,
      "primary_message": "Uncover couscous and fluff with a fork. Add couscous and chickpeas to bowl and toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 14069,
      "primary_message": "To serve, place salad on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
