  "instructions": [
    {
      "id": 371889,
      "primary_message": "Cut butter in small pieces, place in a small bowl, and set aside to soften.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 371890,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg fresh basil\n1 medium carrot\n1 (227 g) pkg sugar snap peas"
    },
    {
      "id": 371891,
      "primary_message": "Zest lemon into the bowl with the butter. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 371892,
      "primary_message": "Peel and mince garlic; add to the bowl with the butter.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 371893,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl. Mash the butter, garlic, and basil together with the back of a spoon until smooth. Set the compound butter aside.",
      "secondary_message": null
    },
    {
      "id": 371894,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 371895,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 371896,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest.",
      "secondary_message": "1 ½ tsp butter, unsalted"
    },
    {
      "id": 371897,
      "primary_message": "While the steak is cooking, peel, trim, and slice carrot into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 371898,
      "primary_message": "Peel and mince additional garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 371899,
      "primary_message": "Return the skillet to medium-high heat. Add more butter and swirl to coat the bottom. Add carrot, snap peas, salt, and pepper; stir-fry until veggies are fork-tender, about 4 minutes. Add garlic and cook until fragrant, about 30 seconds more. Remove from heat.",
      "secondary_message": "1 ½ tsp butter, unsalted\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 371900,
      "primary_message": "Thinly slice steak.",
      "secondary_message": null
    },
    {
      "id": 371901,
      "primary_message": "To serve, divide steak and veggies between plates. Top steak with compound butter and squeeze lemon over the veggies. Enjoy!",
      "secondary_message": null
    }
  ],
