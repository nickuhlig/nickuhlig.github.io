  "instructions": [
    {
      "id": 371794,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 371795,
      "primary_message": "Cut butter into small pieces, place in a small bowl, and set aside to soften.",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "id": 371796,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n1 ½ lemons\n1 small pkg fresh basil\n3 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 371797,
      "primary_message": "Slice potatoes crosswise into ¼-inch thick rounds. Transfer to the baking sheet, season with spices, and spread out in a single layer; dot potatoes with ⅓ of the butter. (Reserve remaining butter for later.)",
      "secondary_message": "¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 371798,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the potatoes are fork-tender and golden, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 371799,
      "primary_message": "Meanwhile, zest lemons into the bowl with the remaining butter. Cut lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 371800,
      "primary_message": "Peel and mince garlic; add to the bowl with the butter.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 371801,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl. Mash the butter, garlic, and basil together with the back of a spoon until smooth. Set the compound butter aside.",
      "secondary_message": null
    },
    {
      "id": 371802,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 371803,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 371804,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 371805,
      "primary_message": "Return the skillet to medium-high heat. Add more butter and swirl to coat the bottom. Add snap peas, salt, and pepper; stir-fry until the peas are fork-tender, 5-6 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 371806,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 371807,
      "primary_message": "To serve, divide roasted potatoes, steak, and snap peas between plates. Top steak with compound butter and squeeze lemon over the peas. Enjoy!",
      "secondary_message": null
    }
  ],
