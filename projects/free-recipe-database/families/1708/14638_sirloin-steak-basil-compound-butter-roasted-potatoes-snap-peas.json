  "instructions": [
    {
      "id": 371861,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 371862,
      "primary_message": "Cut butter into small pieces, place in a small bowl, and set aside to soften.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 371863,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg new potatoes\n1 lemon\n1 small pkg fresh basil\n2 (227 g) pkg sugar snap peas"
    },
    {
      "id": 371864,
      "primary_message": "Slice potatoes crosswise into ¼-inch thick rounds. Transfer to the baking sheet, season with spices, and spread out in a single layer; dot potatoes with ⅓ of the butter. (Reserve remaining butter for later.)",
      "secondary_message": "½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 371865,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the potatoes are fork-tender and golden, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 371866,
      "primary_message": "Meanwhile, zest lemon into the bowl with the remaining butter. Cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 371867,
      "primary_message": "Peel and mince garlic; add to the bowl with the butter.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 371868,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl. Mash the butter, garlic, and basil together with the back of a spoon until smooth. Set the compound butter aside.",
      "secondary_message": null
    },
    {
      "id": 371869,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 371870,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 371871,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 371872,
      "primary_message": "Return the skillet to medium-high heat. Add more butter and swirl to coat the bottom. Add snap peas, salt, and pepper; stir-fry until the peas are fork-tender, about 4 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 371873,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 371874,
      "primary_message": "To serve, divide roasted potatoes, steak, and snap peas between plates. Top steak with compound butter and squeeze lemon over the peas. Enjoy!",
      "secondary_message": null
    }
  ],
