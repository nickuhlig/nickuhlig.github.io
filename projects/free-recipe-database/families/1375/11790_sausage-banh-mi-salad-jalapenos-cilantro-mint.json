  "instructions": [
    {
      "id": 199392,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 199393,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ heads butter (Boston) lettuce\n3 medium carrots\n1 ½ bunches radish\n2 English cucumbers\n3 jalapeño peppers\n1 small pkg fresh mint\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 199394,
      "primary_message": "Place sausages on a large baking sheet pan and place in the oven (it doesn't have to be fully heated); bake until sausages are cooked through, 12-15 minutes.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 199395,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces and transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 199396,
      "primary_message": "Peel and thinly slice carrots into rounds; add to the bowl with the lettuce. ",
      "secondary_message": null
    },
    {
      "id": 199397,
      "primary_message": "Trim and thinly slice radishes; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 199398,
      "primary_message": "Trim and thinly slice cucumbers into rounds; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 199399,
      "primary_message": "Trim and thinly slice jalapeños into rounds; add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 199400,
      "primary_message": "Pick mint leaves off the stems; discard stems and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 199401,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and add to the bowl. Toss to combine the salad and set aside. ",
      "secondary_message": null
    },
    {
      "id": 199402,
      "primary_message": "When the sausages are done cooking, remove to a cutting board. Slice into ½-inch thick pieces, at an angle, and set aside.",
      "secondary_message": null
    },
    {
      "id": 199403,
      "primary_message": "Juice limes into a small bowl. Add mayo, honey, chili-garlic sauce, and fish sauce; whisk to combine the dressing. ",
      "secondary_message": "½ cup mayonnaise\n2 tbsp honey\n2 tbsp chili-garlic sauce\n1 tbsp fish sauce"
    },
    {
      "id": 199404,
      "primary_message": "To serve, divide salad and sausage between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
