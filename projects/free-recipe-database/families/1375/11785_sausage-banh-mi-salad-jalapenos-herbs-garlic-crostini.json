  "instructions": [
    {
      "id": 199324,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 199325,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ head butter (Boston) lettuce\n1 medium carrot\n½ bunch radish\n½ English cucumber\n1 jalapeño pepper\n½ small pkg fresh mint\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 199326,
      "primary_message": "Place sausages on a baking sheet pan and place in the oven (it doesn't have to be fully heated); bake until sausages are cooked through, 12-15 minutes.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 199327,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces and transfer to a salad bowl.",
      "secondary_message": null
    },
    {
      "id": 199328,
      "primary_message": "Peel and thinly slice carrot into rounds; add to the bowl with the lettuce. ",
      "secondary_message": null
    },
    {
      "id": 199329,
      "primary_message": "Trim and thinly slice radishes; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 199330,
      "primary_message": "Trim and thinly slice cucumber into rounds; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 199331,
      "primary_message": "Trim and thinly slice jalapeño into rounds; add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 199332,
      "primary_message": "Pick mint leaves off the stems. Shave cilantro leaves off the stems; discard stems and add leaves to the bowl. Toss to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 199333,
      "primary_message": "When the sausages are done cooking, remove to a cutting board. Slice into ½-inch thick pieces, at an angle, and set aside.",
      "secondary_message": null
    },
    {
      "id": 199334,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 199335,
      "primary_message": "Slice roll in half and place on the baking sheet, cut-side up. Drizzle with oil, then sprinkle with minced garlic. Place in the oven and toast until golden, 4-5 minutes. Remove from the oven and cut in half.",
      "secondary_message": "1 whole grain bun or roll\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 199336,
      "primary_message": "Meanwhile, juice the lime into a small bowl. Add mayo, honey, chili-garlic sauce, and fish sauce; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp honey\n2 tsp chili-garlic sauce\n1 tsp fish sauce"
    },
    {
      "id": 199337,
      "primary_message": "To serve, divide salad, sausage, and crostini between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
