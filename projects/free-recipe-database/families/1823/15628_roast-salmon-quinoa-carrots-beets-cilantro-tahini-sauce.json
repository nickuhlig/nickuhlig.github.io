  "instructions": [
    {
      "id": 257058,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 257059,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium beets\n1 small bunch green onions (scallions)\n1 ½ small bunches cilantro\n6 medium carrots"
    },
    {
      "id": 257060,
      "primary_message": "Peel, trim, and cut beets into ½-inch cubes. Transfer to a large baking sheet pan, drizzle with oil, and season with salt and pepper. Toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257061,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, stirring halfway through, until tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 257062,
      "primary_message": "Meanwhile, peel and mince garlic. Trim and cut green onions crosswise into ¼-inch pieces; transfer both to a medium saucepan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 257063,
      "primary_message": "Add water, quinoa, and salt to the saucepan, stir to combine, and bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "3 cup water\n1 ½ cups quinoa\n¾ tsp salt"
    },
    {
      "id": 257064,
      "primary_message": "While the quinoa is cooking, shave cilantro leaves off the stems; discard stems and mince the leaves. Transfer half to a blender (place remaining cilantro in a large bowl and set aside).",
      "secondary_message": null
    },
    {
      "id": 257065,
      "primary_message": "Peel additional garlic; add to the blender along with water, tahini, oil, vinegar, salt, and pepper. Blend on high until smooth, adding additional water, 1-2 tablespoons at a time, if needed, to reach a drizzling consistency. Set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup water\n¼ cup tahini\n¼ cup extra virgin olive oil\n3 tbsp white wine vinegar\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 257066,
      "primary_message": "Pat the salmon dry with paper towels and place on another baking sheet; coat both sides with oil and season the top side with salt and pepper.",
      "secondary_message": "1.02 kg salmon fillet\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257067,
      "primary_message": "Add baking sheet to the oven and bake salmon until flesh is opaque and cooked through, 12-15 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 257068,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate the carrots. Add to the bowl with the remaining cilantro.",
      "secondary_message": null
    },
    {
      "id": 257069,
      "primary_message": "When the quinoa is done, add to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 257070,
      "primary_message": "To serve, divide the quinoa mixture between plates; top with roasted beets, salmon, and cilantro-tahini sauce. Enjoy!",
      "secondary_message": null
    }
  ],
