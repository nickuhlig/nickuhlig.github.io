  "instructions": [
    {
      "primary_message": "Preheat the oven to 350 degrees. Coat an 8 x 4-inch loaf pan with nonstick cooking spray.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In a large bowl, whisk to combine the flour, baking powder, and salt.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In a separate bowl, whisk to combine the sugar, 2 containers of Fage® Creamy Dreamy Lemon Meringue Cultured Cream, lemon zest, butter, eggs and vanilla.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pour wet ingredients into the flour mixture and stir until just combined. Don’t over mix.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pour batter into the prepared pan and bake for 40-50 minutes, or until a toothpick inserted comes out clean. Remove from the oven and let cool in the pan for 10 minutes. \n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place powdered sugar, lemon juice, and 1 tbsp Fage® Creamy Dreamy lemon meringue cultured cream in a small bowl. Whisk to combine the glaze.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Turn out loaf onto a baking rack and cool completely. Once cool, drizzle glaze over the loaf. Let the glaze set for a few minutes before slicing. Serve.\n",
      "secondary_message": null
    }
  ],
