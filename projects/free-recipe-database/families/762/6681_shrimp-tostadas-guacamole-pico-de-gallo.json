  "instructions": [
    {
      "id": 280097,
      "primary_message": "Preheat oven to 400°F. ",
      "secondary_message": null
    },
    {
      "id": 280098,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water until there are no more ice chunks; set aside to drain. If using fresh shrimp, skip this step.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 280099,
      "primary_message": "Drizzle both sides of the tortillas with oil and sprinkle with salt; place on two baking sheets. Bake for 10-15 minutes, flipping halfway through, until the tortillas are crispy and lightly browned on both sides. ",
      "secondary_message": "18 small corn tortillas\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 280100,
      "primary_message": "In a medium bowl, combine the spices and oil. ",
      "secondary_message": "1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp oregano, dried\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n1 ½ tsp salt\n⅜ tsp black pepper\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 280101,
      "primary_message": "Toss shrimp in spice mixture and set aside.  ",
      "secondary_message": null
    },
    {
      "id": 280102,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 avocados\n1 ½ small bunches cilantro\n1 ½ limes\n1 ½ jalapeño peppers\n6 tomatoes"
    },
    {
      "id": 280103,
      "primary_message": "Peel and mince garlic; add to a medium bowl. Halve avocados and remove pit; scoop out the flesh into the bowl with garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 280104,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add half to the bowl with avocado and the other half to another medium bowl for the pico de gallo. ",
      "secondary_message": null
    },
    {
      "id": 280105,
      "primary_message": "Juice the the limes into the bowl with avocado; add salt and pepper and mash with a fork until smooth.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 280106,
      "primary_message": "Peel and small dice the shallots; small dice the tomatoes. Add both to the bowl with the cilantro for the pico de gallo.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 280107,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the pico de gallo. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) Season with salt and pepper and stir to combine. ",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 280108,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 280109,
      "primary_message": "Once the pan is hot add shrimp; cook until opaque, 1-2 minutes per side. (Cook in batches if necessary)",
      "secondary_message": null
    },
    {
      "id": 280110,
      "primary_message": "To serve, divide the tortillas between plates, top with guacamole, shrimp, and pico de gallo.  Enjoy!",
      "secondary_message": null
    }
  ],
