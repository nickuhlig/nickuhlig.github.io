  "instructions": [
    {
      "id": 632681,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 632682,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 632683,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil to keep warm. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 632684,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 leeks\n2 (142 g) pkgs baby spinach\n2 medium zucchini squash"
    },
    {
      "id": 632685,
      "primary_message": "Using a clean cutting board, trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 632686,
      "primary_message": "Roughly chop spinach. Add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 632687,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 632688,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat, add more butter, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until the veggies are softened, 4-5 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 632689,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 632690,
      "primary_message": "When the veggies are softened, add Parmesan and cream to the skillet, then stir to combine. Continue to cook, stirring occasionally, until the sauce thickens, 1-2 minutes more. Remove from heat.",
      "secondary_message": "177 ml heavy whipping cream"
    },
    {
      "id": 632691,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 632692,
      "primary_message": "To serve, divide cheesy veggie sauté between plates or bowls. Top with chicken and enjoy!",
      "secondary_message": null
    }
  ],
