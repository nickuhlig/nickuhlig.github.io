  "instructions": [
    {
      "id": 632717,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 632718,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 leeks\n2 (142 g) pkgs baby spinach\n2 medium zucchini squash"
    },
    {
      "id": 632719,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 632720,
      "primary_message": "Roughly chop spinach. Add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 632721,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 632722,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 632723,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise and place on a plate. Sprinkle with cornstarch, then season with spices on both sides.",
      "secondary_message": "2 tbsp cornstarch\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 632724,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add tofu and pan-fry until golden brown and warmed through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil to keep warm. (Reserve skillet for the next step.)",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 632725,
      "primary_message": "Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until the veggies are softened, 4-5 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 632726,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 632727,
      "primary_message": "When the veggies are softened, add Parmesan and cream to the skillet, then stir to combine. Continue to cook, stirring occasionally, until the sauce thickens, 1-2 minutes more. Remove from heat.",
      "secondary_message": "177 ml heavy whipping cream"
    },
    {
      "id": 632728,
      "primary_message": "To serve, divide cheesy veggie sauté between plates or bowls. Top with tofu and enjoy!",
      "secondary_message": null
    }
  ],
