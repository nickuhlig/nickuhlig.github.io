  "instructions": [
    {
      "id": 632693,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 632694,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 632695,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil to keep warm. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 632696,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 leeks\n3 (142 g) pkgs baby spinach\n3 medium zucchini squash"
    },
    {
      "id": 632697,
      "primary_message": "Using a clean cutting board, trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 632698,
      "primary_message": "Roughly chop spinach. Add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 632699,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 632700,
      "primary_message": "Return pot (with cooking juices) to medium-high heat, add more butter, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until the veggies are softened, 5-6 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 632701,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 632702,
      "primary_message": "When the veggies are softened, add Parmesan and cream to the pot, then stir to combine. Continue to cook, stirring occasionally, until the sauce thickens, 2-3 minutes more. Remove from heat.",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 632703,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 632704,
      "primary_message": "To serve, divide cheesy veggie sauté between plates or bowls. Top with chicken and enjoy!",
      "secondary_message": null
    }
  ],
