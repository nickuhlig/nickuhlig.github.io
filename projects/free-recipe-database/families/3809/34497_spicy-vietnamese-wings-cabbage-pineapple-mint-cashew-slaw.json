  "instructions": [
    {
      "id": 561007,
      "primary_message": "Preheat oven to 260°C (500°F). ",
      "secondary_message": null
    },
    {
      "id": 561008,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch and salt, then toss to coat. Drizzle with oil and toss once more to coat. Divide between two baking sheets pans and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n3 tbsp cornstarch\n1 ½ tsp salt\n3 tbsp neutral vegetable oil"
    },
    {
      "id": 561009,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 561010,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 limes\n3 red chili peppers\n1 ½ small pineapples\n1 ½ medium heads napa cabbage\n1 small pkg fresh mint"
    },
    {
      "id": 561011,
      "primary_message": "Peel and mince ginger. Peel, halve, and mince onion. Place both in a clean large bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 561012,
      "primary_message": "Juice half of the limes into the bowl with the ginger and onion (reserve remaining limes for later use).",
      "secondary_message": null
    },
    {
      "id": 561013,
      "primary_message": "Add soy sauce, sugar, fish sauce, vinegar, and salt to the bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup soy sauce\n3 tbsp brown sugar\n1 ½ tbsp fish sauce\n1 ½ tbsp rice vinegar\n½ tsp salt"
    },
    {
      "id": 561014,
      "primary_message": "Thinly slice chili peppers into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 561015,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and small dice the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 561016,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 561017,
      "primary_message": "Shave mint leaves off the stems; discard stems and roughly chop leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 561018,
      "primary_message": "Roughly chop cashews. Add to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 561019,
      "primary_message": "Juice reserved limes into a small saucepan. Add soy sauce, water, chili-garlic sauce, sugar, fish sauce, and cornstarch to the pan. Cook over medium heat, whisking frequently, until sauce is slightly thickened, 2-3 minutes. Transfer sauce to another large bowl and set aside.",
      "secondary_message": "¼ cup soy sauce\n3 tbsp water\n3 tbsp chili-garlic sauce\n3 tbsp brown sugar\n1 ½ tbsp fish sauce\n1 tbsp cornstarch"
    },
    {
      "id": 561020,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 561021,
      "primary_message": "To serve, divide wings and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
