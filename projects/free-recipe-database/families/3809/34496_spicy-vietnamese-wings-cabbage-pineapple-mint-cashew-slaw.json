  "instructions": [
    {
      "id": 560992,
      "primary_message": "Preheat oven to 260°C (500°F). ",
      "secondary_message": null
    },
    {
      "id": 560993,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch and salt, then toss to coat. Drizzle with oil and toss once more to coat. Transfer to a large baking sheet pan and spread out in an even layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed\n2 tbsp cornstarch\n1 tsp salt\n2 tbsp neutral vegetable oil"
    },
    {
      "id": 560994,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 560995,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 limes\n2 red chili peppers\n1 small pineapple\n1 medium head napa cabbage\n1 small pkg fresh mint"
    },
    {
      "id": 560996,
      "primary_message": "Peel and mince ginger and shallots. Place both in a clean medium bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 560997,
      "primary_message": "Juice one lime into the bowl with the ginger and shallot (reserve remaining lime for later use).",
      "secondary_message": null
    },
    {
      "id": 560998,
      "primary_message": "Add soy sauce, sugar, fish sauce, vinegar, and salt to the bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp brown sugar\n1 tbsp fish sauce\n1 tbsp rice vinegar\n¼ tsp salt"
    },
    {
      "id": 560999,
      "primary_message": "Thinly slice chili peppers into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 561000,
      "primary_message": "Cut off skin from pineapple; quarter, core, and small dice the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 561001,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 561002,
      "primary_message": "Shave mint leaves off the stems; discard stems and roughly chop leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 561003,
      "primary_message": "Roughly chop cashews. Add to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 561004,
      "primary_message": "Juice reserved lime into a small saucepan. Add soy sauce, water, chili-garlic sauce, sugar, fish sauce, and cornstarch to the pan. Cook over medium heat, whisking frequently, until sauce is slightly thickened, 2-3 minutes. Transfer sauce to another medium bowl and set aside.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp water\n2 tbsp chili-garlic sauce\n2 tbsp brown sugar\n1 tbsp fish sauce\n2 tsp cornstarch"
    },
    {
      "id": 561005,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 561006,
      "primary_message": "To serve, divide wings and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
