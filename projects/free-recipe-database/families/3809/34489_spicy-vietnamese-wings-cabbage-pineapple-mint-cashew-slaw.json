  "instructions": [
    {
      "id": 560887,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": null
    },
    {
      "id": 560888,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch and salt, then toss to coat. Drizzle with oil and toss once more to coat. Transfer to a baking sheet pan and spread out in an even layer.",
      "secondary_message": "1 lb chicken wings, split with tips removed\n1 tbsp cornstarch\n½ tsp salt\n1 tbsp neutral vegetable oil"
    },
    {
      "id": 560889,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 560890,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 lime\n1 red chili pepper\n½ small pineapple\n½ medium head napa cabbage\n½ small pkg fresh mint"
    },
    {
      "id": 560891,
      "primary_message": "Peel and mince ginger and shallot. Place both in a clean medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 560892,
      "primary_message": "Juice half of the lime into the bowl with the ginger and shallot (reserve remaining lime for later use).",
      "secondary_message": null
    },
    {
      "id": 560893,
      "primary_message": "Add soy sauce, sugar, fish sauce, vinegar, and salt to the bowl. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp soy sauce\n1 tbsp brown sugar\n1 ½ tsp fish sauce\n1 ½ tsp rice vinegar\n⅛ tsp salt"
    },
    {
      "id": 560894,
      "primary_message": "Thinly slice chili pepper into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 560895,
      "primary_message": "Cut off skin from pineapple; quarter, core, and small dice the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 560896,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 560897,
      "primary_message": "Shave mint leaves off the stems; discard stems and roughly chop leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 560898,
      "primary_message": "Roughly chop cashews. Add to the bowl and toss to combine the slaw. Set aside.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 560899,
      "primary_message": "Juice reserved lime into a small saucepan. Add soy sauce, water, chili-garlic sauce, sugar, fish sauce, and cornstarch to the pan. Cook over medium heat, whisking frequently, until sauce is slightly thickened, 2-3 minutes. Transfer sauce to another medium bowl and set aside.",
      "secondary_message": "1 ½ tbsp soy sauce\n1 tbsp water\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n1 ½ tsp fish sauce\n1 tsp cornstarch"
    },
    {
      "id": 560900,
      "primary_message": "When the wings are done, remove from the oven. Add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 560901,
      "primary_message": "To serve, divide wings and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
