  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large bowl, combine yogurt, salt, sugar, cumin, and chile powder, then whisk to combine. Cover and refrigerate until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Just before serving, quarter and core apple. Using the large holes of a box grater, grate the flesh of each apple quarter until only the skin remains. Discard skin.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer grated apple to yogurt mixture and stir well to combine. Season to taste with salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Top raita with cilantro, if using. Serve.",
      "secondary_message": null
    }
  ],
