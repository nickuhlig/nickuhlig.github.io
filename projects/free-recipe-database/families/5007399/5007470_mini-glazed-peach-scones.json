  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the peaches.",
      "secondary_message": "2 cups peaches, from about 3 medium peaches"
    },
    {
      "id": 1,
      "primary_message": "Arrange oven rack to middle and lower positions and preheat oven to 205°C (400°F). Line two baking sheets with parchment paper. Dice butter then place in a bowl and put in the freezer for 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, sugar, baking powder, and salt. Add butter to bowl and using a pastry cutter or finger tips, cut butter into flour until it's the size of peas (see note).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, whisk together eggs and heavy cream. Add to dry ingredients and stir just until combined. Turn dough out onto a well floured work surface. Pat down into a long, flat rectangle, about 12-by 13-cm.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Sprinkle peaches on top of dough, then fold dough in on itself. Continue to fold until peaches are evenly distributed throughout the dough. Pat dough down into a 12- by 13-cm rectangle.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cut dough in half lengthwise, and then in quarters vertically, creating 2 1/2- by 8-cm rectangles. Cut each of those rectangles in half diagonally, creating small triangles. Place triangular scones on baking sheet and bake until golden, about 15 minutes. Let cool.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "In a small bowl, combine confectioner's sugar and water and whisk until smooth. Drizzle each scone with glaze.",
      "secondary_message": null
    }
  ],
