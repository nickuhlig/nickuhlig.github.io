  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic cloves. Finely grate the Parmesan. Pick the basil leaves from the stems and chop them.",
      "secondary_message": "2 medium garlic cloves\n3 tbsp Parmesan\n3 tbsp fresh basil"
    },
    {
      "id": 1,
      "primary_message": "Carefully wash pumpkin seeds to remove all excess pulp. Transfer pumpkin seeds to a paper towel–lined rimmed baking sheet. Allow to rest at room temperature until completely dry, about 1 hour. To speed up the process, dry pumpkin seeds in a 90°C (200°F) oven, stirring occasionally, or use a hair dryer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to center position and preheat oven to 160°C (325°F). In a large bowl, toss dried pumpkin seeds with oil and season with salt and pepper. Transfer to a rimmed baking sheet. Roast, stirring occasionally, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While seeds are roasting, in a small sauté pan, combine butter, minced garlic, and red pepper and cook over medium-low heat, just until butter foams and garlic becomes fragrant. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove pumpkin seeds from oven and transfer back to large bowl. Add garlic butter to bowl and toss with pumpkin seeds to coat. Return pumpkin seeds to baking sheet, return sheet to oven, and continue roasting until seeds are pale golden brown, about another 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "When seeds have cooled, transfer to a serving bowl, toss with grated Parmesan and chopped herbs, and serve.",
      "secondary_message": null
    }
  ],
