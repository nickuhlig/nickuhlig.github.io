  "instructions": [
    {
      "id": 167154,
      "primary_message": "Peel and small dice onion. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 167155,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 167156,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until soft, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 167157,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (142 g) pkg baby spinach\n½ lime\n1 avocado\n½ jalapeño pepper\n½ small bunch cilantro\n1 tomato"
    },
    {
      "id": 167158,
      "primary_message": "Add ground turkey to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes. ",
      "secondary_message": "⅓ kg ground turkey"
    },
    {
      "id": 167159,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 167160,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 167161,
      "primary_message": "Add garlic and spices to the skillet; continue to cook, stirring often, until most of the liquid evaporates, about 5 minutes.",
      "secondary_message": "1 tsp cumin\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 167162,
      "primary_message": "Meanwhile, juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 167163,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out into the bowl with the lime juice. Add spices and mash with a potato masher or fork until smooth.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder\n⅛ tsp onion powder"
    },
    {
      "id": 167164,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Mince and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 167165,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl and stir to combine the guacamole.",
      "secondary_message": null
    },
    {
      "id": 167166,
      "primary_message": "Grate the cheese, sprinkle on top of the turkey mixture, and stir to melt; remove from heat.",
      "secondary_message": "⅛ (227 g) block mozzarella cheese"
    },
    {
      "id": 167167,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 167168,
      "primary_message": "Small dice the tomato. ",
      "secondary_message": null
    },
    {
      "id": 167169,
      "primary_message": "To serve, divide tortillas between plates and fill with the turkey mixture. Top with guacamole and tomatoes. Enjoy!",
      "secondary_message": null
    }
  ],
