  "instructions": [
    {
      "id": 167138,
      "primary_message": "Peel and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 167139,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 167140,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring often, until soft, about 6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 167141,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (5 oz) pkgs baby spinach\n1 ½ limes\n3 avocados\n1 ½ jalapeño peppers\n1 small bunch cilantro\n3 tomatoes"
    },
    {
      "id": 167142,
      "primary_message": "Add ground turkey to the pot; cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "2 ¼ lb ground turkey"
    },
    {
      "id": 167143,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 167144,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 167145,
      "primary_message": "Add garlic and spices to the pot; continue to cook, stirring often, until most of the liquid evaporates, 5-7 minutes.",
      "secondary_message": "1 tbsp cumin\n1 tbsp chili powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 167146,
      "primary_message": "Meanwhile, juice lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 167147,
      "primary_message": "Halve and pit avocados. Slice thinly while still in skin, then scoop out into the bowl with the lime juice. Add spices and mash with a potato masher or fork until smooth.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper\n½ tsp garlic powder\n½ tsp onion powder"
    },
    {
      "id": 167148,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Mince and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 167149,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl and stir to combine the guacamole.",
      "secondary_message": null
    },
    {
      "id": 167150,
      "primary_message": "Grate the cheese, sprinkle on top of the turkey mixture, and stir to melt; remove from heat.",
      "secondary_message": "⅜ (8 oz) block mozzarella cheese"
    },
    {
      "id": 167151,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 167152,
      "primary_message": "Small dice tomatoes. ",
      "secondary_message": null
    },
    {
      "id": 167153,
      "primary_message": "To serve, divide tortillas between plates and fill with the turkey mixture. Top with guacamole and tomatoes. Enjoy!",
      "secondary_message": null
    }
  ],
