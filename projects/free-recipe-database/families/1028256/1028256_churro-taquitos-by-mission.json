  "instructions": [
    {
      "primary_message": "Preheat the oven to 400 degrees F. Spray a rimmed baking sheet with the nonstick spray. Set aside. Combine the 1/2 cup sugar with the cinnamon in a shallow bowl and set aside.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spray a Mission® soft taco flour tortilla half with nonstick spray on both sides and roll into a loose cylinder with about one-half inch of space in the middle. Secure with toothpicks and place on the baking sheet. Repeat with the remaining tortilla halves.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Bake in the oven for 9 to 11 minutes until lightly golden on the top. (The bottom should be darker than the top.) Remove from the oven and lightly spray with nonstick spray. Let cool slightly and remove toothpicks before dredging pieces in the cinnamon sugar mixture. Let cool completely.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Using a hand or stand mixer, mix to combine the heavy cream, vanilla extract and remaining sugar until soft peaks form.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pipe whipped cream into the center of each tortilla piece. Drizzle with warmed honey. Serve with the remaining whipped cream for dipping.\n",
      "secondary_message": null
    }
  ],
