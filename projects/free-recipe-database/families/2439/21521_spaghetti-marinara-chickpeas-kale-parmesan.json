  "instructions": [
    {
      "id": 427256,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes, then drain and set aside.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 427257,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 427258,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 427259,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 427260,
      "primary_message": "Meanwhile, drain and rinse chickpeas.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 427261,
      "primary_message": "When the onion is soft, increase heat to medium-high. Add chickpeas to the skillet and cook, stirring occasionally, until warmed through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 427262,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until tender, 1-2 minutes more.",
      "secondary_message": "1 (283 g) bag kale, cut and ready to use"
    },
    {
      "id": 427263,
      "primary_message": "Add marinara to the skillet, stir to combine, and cook until warmed through, 1-2 minutes.",
      "secondary_message": "1 (680 g) jar marinara sauce"
    },
    {
      "id": 427264,
      "primary_message": "Add pasta to the skillet and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 427265,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with Parmesan. Enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
