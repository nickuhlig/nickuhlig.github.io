  "instructions": [
    {
      "id": 426946,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes, then drain and set aside.",
      "secondary_message": "½ tsp salt\n5 oz spaghetti pasta"
    },
    {
      "id": 426947,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 426948,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 426949,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 426950,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and medium dice.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 426951,
      "primary_message": "When the onion is soft, increase heat to medium-high. Add chicken to the skillet and sauté until just cooked through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 426952,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until tender, 1-2 minutes more.",
      "secondary_message": "½ (10 oz) bag kale, cut and ready to use"
    },
    {
      "id": 426953,
      "primary_message": "Add marinara to the skillet, stir to combine, and cook until warmed through, 1-2 minutes.",
      "secondary_message": "½ (24 oz) jar marinara sauce"
    },
    {
      "id": 426954,
      "primary_message": "Add pasta to the skillet and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 426955,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with Parmesan. Enjoy!",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    }
  ],
