  "instructions": [
    {
      "id": 426966,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes, then drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz spaghetti pasta"
    },
    {
      "id": 426967,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 426968,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 426969,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 426970,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and medium dice.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 426971,
      "primary_message": "When the onion is soft, increase heat to medium-high. Add chicken to the pot and sauté until just cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 426972,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until tender, 2-3 minutes more.",
      "secondary_message": "1 ½ (10 oz) bags kale, cut and ready to use"
    },
    {
      "id": 426973,
      "primary_message": "Add marinara to the pot, stir to combine, and cook until warmed through, 2-3 minutes.",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce"
    },
    {
      "id": 426974,
      "primary_message": "Add pasta to the pot with the sauce and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 426975,
      "primary_message": "To serve, divide pasta between plates or bowls and sprinkle with Parmesan. Enjoy!",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    }
  ],
