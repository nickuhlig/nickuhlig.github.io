  "instructions": [
    {
      "id": 467110,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 467111,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 467112,
      "primary_message": "Meanwhile, place soy sauce, vinegar, cornstarch, chili-garlic sauce, sugar, and onion powder in a small bowl. Whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "⅓ cup soy sauce\n⅓ cup rice vinegar\n3 tbsp cornstarch\n2 tbsp chili-garlic sauce\n2 tbsp brown sugar\n1 ½ tsp onion powder"
    },
    {
      "id": 467113,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 467114,
      "primary_message": "While the rice is cooking, medium dice tofu. Place in a large bowl, then sprinkle with cornstarch, salt, and pepper. Gently toss to coat. ",
      "secondary_message": "3 tbsp cornstarch\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 467115,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467116,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, turning occasionally, until golden and crispy, 6-8 minutes. Transfer to a plate. (Reserve both pot and bowl for later use.)",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 467117,
      "primary_message": "Meanwhile, wash, dry, trim, and cut bok choy crosswise into 1-inch strips. Place in the reserved bowl.",
      "secondary_message": "12 baby bok choy"
    },
    {
      "id": 467118,
      "primary_message": "Wash, dry, and cut off skin from each pineapple; quarter, core, and medium dice. Add to the bowl with the bok choy.",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 467119,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add bok choy and pineapple; stir-fry until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 467120,
      "primary_message": "Return tofu to the pot along with the stir-fry sauce. Continue to stir-fry until sauce thickens slightly, 3-4 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 467121,
      "primary_message": "Just before serving, fluff rice with a fork. Add coconut and stir to combine. ",
      "secondary_message": "⅓ cup shredded unsweetened coconut"
    },
    {
      "id": 467122,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
