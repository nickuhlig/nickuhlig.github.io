  "instructions": [
    {
      "id": 467054,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 467055,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 467056,
      "primary_message": "Meanwhile, place soy sauce, vinegar, cornstarch, chili-garlic sauce, sugar, and onion powder in a small bowl. Whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp rice vinegar\n1 tbsp cornstarch\n2 tsp chili-garlic sauce\n2 tsp brown sugar\n½ tsp onion powder"
    },
    {
      "id": 467057,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 467058,
      "primary_message": "While the rice is cooking, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467059,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a medium bowl, then sprinkle with cornstarch, salt, and pepper. Gently toss to coat. ",
      "secondary_message": "1 tbsp cornstarch\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 467060,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning occasionally, until golden and crispy, 6-8 minutes. Transfer to a plate. (Reserve both skillet and bowl for later use.)",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 467061,
      "primary_message": "Meanwhile, wash, dry, trim, and cut bok choy crosswise into 1-inch strips. Place in the reserved bowl.",
      "secondary_message": "4 baby bok choy"
    },
    {
      "id": 467062,
      "primary_message": "Wash, dry, and cut off skin from pineapple; quarter, core, and medium dice. Add to the bowl with the bok choy.",
      "secondary_message": "½ small pineapple"
    },
    {
      "id": 467063,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add bok choy and pineapple; stir-fry until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 467064,
      "primary_message": "Return tofu to the skillet along with the stir-fry sauce. Continue to stir-fry until sauce thickens slightly, 2-3 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 467065,
      "primary_message": "Just before serving, fluff rice with a fork. Add coconut and stir to combine. ",
      "secondary_message": "⅛ cup shredded unsweetened coconut"
    },
    {
      "id": 467066,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
