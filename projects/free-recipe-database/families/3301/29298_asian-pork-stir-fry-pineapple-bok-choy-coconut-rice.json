  "instructions": [
    {
      "id": 467027,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 467028,
      "primary_message": "Meanwhile, wash, dry, trim, and cut bok choy crosswise into 1-inch strips. Place in a large bowl.",
      "secondary_message": "12 baby bok choy"
    },
    {
      "id": 467029,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 467030,
      "primary_message": "While the rice is cooking, wash, dry, and cut off skin from each pineapple; quarter, core, and medium dice. Add to the bowl with the bok choy and set aside.",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 467031,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467032,
      "primary_message": "While the pot heats up, pat the pork dry with paper towels and cut into 1-inch cubes. Season with salt and pepper. ",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 467033,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pork and stir-fry until golden and almost cooked through, 5-6 minutes. Transfer to a plate. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 467034,
      "primary_message": "Meanwhile, place soy sauce, vinegar, cornstarch, chili-garlic sauce, sugar, and onion powder in a small bowl. Whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "⅓ cup soy sauce\n⅓ cup rice vinegar\n3 tbsp cornstarch\n2 tbsp chili-garlic sauce\n2 tbsp brown sugar\n1 ½ tsp onion powder"
    },
    {
      "id": 467035,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add bok choy and pineapple; stir-fry until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 467036,
      "primary_message": "Return pork to the pot along with the stir-fry sauce. Continue to stir-fry until pork is cooked through and sauce thickens slightly, 3-4 minutes more. Cover and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 467037,
      "primary_message": "Just before serving, fluff rice with a fork. Add coconut and stir to combine. ",
      "secondary_message": "⅓ cup shredded unsweetened coconut"
    },
    {
      "id": 467038,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
