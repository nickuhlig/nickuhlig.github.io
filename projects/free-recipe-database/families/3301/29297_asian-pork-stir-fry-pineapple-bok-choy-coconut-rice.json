  "instructions": [
    {
      "id": 467015,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 467016,
      "primary_message": "Meanwhile, wash, dry, trim, and cut bok choy crosswise into 1-inch strips. Place in a medium bowl.",
      "secondary_message": "8 baby bok choy"
    },
    {
      "id": 467017,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 467018,
      "primary_message": "While the rice is cooking, wash, dry, and cut off skin from pineapple; quarter, core, and medium dice. Add to the bowl with the bok choy and set aside.",
      "secondary_message": "1 small pineapple"
    },
    {
      "id": 467019,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467020,
      "primary_message": "While the skillet heats up, pat the pork dry with paper towels and cut into 1-inch cubes. Season with salt and pepper. ",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 467021,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and stir-fry until golden and almost cooked through, 4-5 minutes. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 467022,
      "primary_message": "Meanwhile, place soy sauce, vinegar, cornstarch, chili-garlic sauce, sugar, and onion powder in a small bowl. Whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "¼ cup soy sauce\n¼ cup rice vinegar\n2 tbsp cornstarch\n4 tsp chili-garlic sauce\n4 tsp brown sugar\n1 tsp onion powder"
    },
    {
      "id": 467023,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add bok choy and pineapple; stir-fry until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 467024,
      "primary_message": "Return pork to the skillet along with the stir-fry sauce. Continue to stir-fry until pork is cooked through and sauce thickens slightly, 2-3 minutes more. Cover and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 467025,
      "primary_message": "Just before serving, fluff rice with a fork. Add coconut and stir to combine. ",
      "secondary_message": "¼ cup shredded unsweetened coconut"
    },
    {
      "id": 467026,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
