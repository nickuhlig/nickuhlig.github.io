  "instructions": [
    {
      "id": 628153,
      "primary_message": "Preheat oven to 375°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 628154,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on another baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": null
    },
    {
      "id": 628155,
      "primary_message": "Place mayo and spices in a medium bowl, then stir to combine.",
      "secondary_message": "2 tbsp mayonnaise\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 628156,
      "primary_message": "Cut tofu crosswise into ¾-inch sticks. Add to the bowl with the mayo mixture and gently toss to coat.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 628157,
      "primary_message": "Add bread crumbs to the bowl with the tofu and turn to coat, pressing gently to adhere. Transfer tofu to the prepared baking sheet and arrange in a single layer.",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 628158,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and warmed through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 628159,
      "primary_message": "Meanwhile, place yogurt, mayo, and spices in a small bowl. Whisk to combine the za'atar yogurt and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n½ tsp cumin, ground\n½ tsp thyme, dried\n½ tsp sesame seeds\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 628160,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n½ small pkg fresh mint\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 628161,
      "primary_message": "Place oil, vinegar, honey, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 628162,
      "primary_message": "Trim and quarter cucumber lengthwise, then slice crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 628163,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 628164,
      "primary_message": "Roughly chop pistachios. Add to the bowl.",
      "secondary_message": "⅛ cup pistachios, unsalted"
    },
    {
      "id": 628165,
      "primary_message": "When the tofu is almost done, add arugula to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 628166,
      "primary_message": "Divide tofu and salad between plates. Serve with za'atar yogurt on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
