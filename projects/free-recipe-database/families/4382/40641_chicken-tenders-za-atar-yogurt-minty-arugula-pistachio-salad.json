  "instructions": [
    {
      "id": 628276,
      "primary_message": "Preheat oven to 190°C (375°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 628277,
      "primary_message": "Place mayo and spices in a medium bowl, then stir to combine.",
      "secondary_message": "2 tbsp mayonnaise\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 628278,
      "primary_message": "Pat chicken dry with paper towels, then slice crosswise into ¾-inch strips. Add to the bowl with the mayo mixture and toss to coat.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 628279,
      "primary_message": "Add bread crumbs to the bowl with the chicken and turn to coat, pressing gently to adhere. Transfer chicken to the baking sheet and arrange in a single layer.",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 628280,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 628281,
      "primary_message": "Meanwhile, place yogurt, mayo, and spices in a small bowl. Whisk to combine the za'atar yogurt and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n½ tsp cumin, ground\n½ tsp thyme, dried\n½ tsp sesame seeds\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 628282,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n½ small pkg fresh mint\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 628283,
      "primary_message": "Place oil, vinegar, honey, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n1 tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 628284,
      "primary_message": "Trim and quarter cucumber lengthwise, then slice crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 628285,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 628286,
      "primary_message": "Roughly chop pistachios. Add to the bowl.",
      "secondary_message": "⅛ cup pistachios, unsalted"
    },
    {
      "id": 628287,
      "primary_message": "When the chicken is almost done, add arugula to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 628288,
      "primary_message": "Divide chicken tenders and salad between plates. Serve with za'atar yogurt for dipping and enjoy!",
      "secondary_message": null
    }
  ],
