  "instructions": [
    {
      "id": 628343,
      "primary_message": "Preheat oven to 190°C (375°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 628344,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on another baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": null
    },
    {
      "id": 628345,
      "primary_message": "Place mayo and spices in a large bowl, then stir to combine.",
      "secondary_message": "⅓ cup mayonnaise\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 628346,
      "primary_message": "Cut tofu crosswise into ¾-inch sticks. Add to the bowl with the mayo mixture and gently toss to coat.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 628347,
      "primary_message": "Add bread crumbs to the bowl with the tofu and turn to coat, pressing gently to adhere. Divide tofu between the prepared baking sheets and arrange in a single layer.",
      "secondary_message": "1 ½ cup panko bread crumbs"
    },
    {
      "id": 628348,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until golden and warmed through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 628349,
      "primary_message": "Meanwhile, place yogurt, mayo, and spices in a small bowl. Whisk to combine the za'atar yogurt and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 ½ tsp cumin, ground\n1 ½ tsp thyme, dried\n1 ½ tsp sesame seeds\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 628350,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n1 small pkg fresh mint\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 628351,
      "primary_message": "Place oil, vinegar, honey, salt, and pepper in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 tbsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 628352,
      "primary_message": "Trim and quarter cucumbers lengthwise, then slice crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 628353,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 628354,
      "primary_message": "Roughly chop pistachios. Add to the bowl.",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 628355,
      "primary_message": "When the tofu is almost done, add arugula to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 628356,
      "primary_message": "Divide tofu and salad between plates. Serve with za'atar yogurt on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
