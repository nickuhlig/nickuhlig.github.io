  "instructions": [
    {
      "id": 187848,
      "primary_message": "Preheat the oven to 400°F and position the rack in the center and lower part of the oven. Line two large baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 187849,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lb new potatoes\n3 lemons"
    },
    {
      "id": 187850,
      "primary_message": "Halve the new potatoes and cut the cauliflower into florets. Toss in a large bowl with olive oil, salt, and pepper. Arrange in a single layer on the baking sheet pans and bake for 15 minutes.",
      "secondary_message": "1 tbsp salt\n1 tbsp black pepper\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 187851,
      "primary_message": "Season the chicken with salt and pepper on both sides, set aside.",
      "secondary_message": "1 ½ lb chicken thighs, boneless skinless\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 187852,
      "primary_message": "Grate all of the zest from the lemons and place in a medium bowl; juice the lemons into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 187853,
      "primary_message": "Peel and mince the garlic, add to the bowl with the lemon juice and zest. Add olive oil, mustard, honey, and oregano; whisk together.",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup honey\n1 tbsp oregano\n6 cloves garlic\n⅓ cup Dijon mustard"
    },
    {
      "id": 187854,
      "primary_message": "Quarter and thinly slice the red onion. Remove the sheet pan from the oven and add onions on top, dispersing evenly.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 187855,
      "primary_message": "Lay the chicken on top of the vegetables and drizzle evenly with the lemon sauce.",
      "secondary_message": null
    },
    {
      "id": 187856,
      "primary_message": "Return the sheet pan to the oven and bake until chicken is golden brown and cooked through, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 187857,
      "primary_message": "To serve, divide chicken and vegetables between plates and top with sauce from pans. Enjoy!",
      "secondary_message": null
    }
  ],
