  "instructions": [
    {
      "id": 554435,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 pear\n2 medium carrots\n2 sticks celery\n½ lime\n½ (454 g) pkg strawberries\n1 orange"
    },
    {
      "id": 554436,
      "primary_message": "Quarter, core, and small dice pear. Place in a medium bowl. (Reserve a small handful of pear for serving.)",
      "secondary_message": null
    },
    {
      "id": 554437,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Add both to the bowl with the pear.",
      "secondary_message": null
    },
    {
      "id": 554438,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 554439,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 554440,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add pear, veggies, and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 554441,
      "primary_message": "Meanwhile, juice lime into a clean medium bowl. Add honey and salt, then whisk to combine the dressing. Set aside.",
      "secondary_message": "1 tsp honey\n1 pinch salt"
    },
    {
      "id": 554442,
      "primary_message": "When the veggies have softened, add broth to the pan; stir to combine the soup and bring to a boil. Once boiling, reduce to a simmer; cook, stirring occasionally, until pear and veggies are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 554443,
      "primary_message": "While the soup is cooking, trim and quarter strawberries lengthwise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 554444,
      "primary_message": "Peel orange, separate into segments, and roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 554445,
      "primary_message": "Roughly chop walnuts and dates. Add both to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "⅓ cup walnuts\n⅛ cup medjool dates, pitted"
    },
    {
      "id": 554446,
      "primary_message": "Coarsely grate cheese. Set aside for serving.",
      "secondary_message": "⅓ (227 g) block cheddar cheese"
    },
    {
      "id": 554447,
      "primary_message": "When the pear and veggies are tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.) ",
      "secondary_message": null
    },
    {
      "id": 554448,
      "primary_message": "Divide soup between bowls, then top with cheese and reserved pear. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
