  "instructions": [
    {
      "id": 554365,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 pears\n4 medium carrots\n4 sticks celery\n1 lime\n1 (16 oz) pkg strawberries\n2 oranges"
    },
    {
      "id": 554366,
      "primary_message": "Quarter, core, and small dice pears. Place in a medium bowl. (Reserve a small handful of pear for serving.)",
      "secondary_message": null
    },
    {
      "id": 554367,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Add both to the bowl with the pear.",
      "secondary_message": null
    },
    {
      "id": 554368,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 554369,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 554370,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pear, veggies, and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n2 tsp smoked paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 554371,
      "primary_message": "Meanwhile, juice lime into a clean medium bowl. Add honey and salt, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tsp honey\n⅛ tsp salt"
    },
    {
      "id": 554372,
      "primary_message": "When the veggies have softened, add broth to the pot; stir to combine the soup and to a boil. Once boiling, reduce to a simmer; cook, stirring occasionally, until pear and veggies are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 554373,
      "primary_message": "While the soup is cooking, trim and quarter strawberries lengthwise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 554374,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 554375,
      "primary_message": "Roughly chop walnuts and dates. Add both to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "⅔ cup walnuts\n¼ cup medjool dates, pitted"
    },
    {
      "id": 554376,
      "primary_message": "Coarsely grate cheese. Set aside for serving.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 554377,
      "primary_message": "When the pear and veggies are tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.) ",
      "secondary_message": null
    },
    {
      "id": 554378,
      "primary_message": "Divide soup between bowls, then top with cheese and reserved pear. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
