  "instructions": [
    {
      "id": 554463,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 pears\n6 medium carrots\n6 sticks celery\n1 ½ limes\n1 ½ (454 g) pkgs strawberries\n3 oranges"
    },
    {
      "id": 554464,
      "primary_message": "Quarter, core, and small dice pears. Place in a medium bowl. (Reserve a small handful of pear for serving.)",
      "secondary_message": null
    },
    {
      "id": 554465,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Add both to the bowl with the pear.",
      "secondary_message": null
    },
    {
      "id": 554466,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 554467,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 554468,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pear, veggies, and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp neutral vegetable oil\n1 tbsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 554469,
      "primary_message": "Meanwhile, juice limes into a clean medium bowl. Add honey and salt, then whisk to combine the dressing. Set aside.",
      "secondary_message": "1 tbsp honey\n3 pinch salt"
    },
    {
      "id": 554470,
      "primary_message": "When the veggies have softened, add broth to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce to a simmer; cook, stirring occasionally, until pear and veggies are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "2129 ml chicken or vegetable broth"
    },
    {
      "id": 554471,
      "primary_message": "While the soup is cooking, trim and quarter strawberries lengthwise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 554472,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 554473,
      "primary_message": "Roughly chop walnuts and dates. Add both to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 cup walnuts\n⅓ cup medjool dates, pitted"
    },
    {
      "id": 554474,
      "primary_message": "Coarsely grate cheese. Set aside for serving.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 554475,
      "primary_message": "When the pear and veggies are tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.) ",
      "secondary_message": null
    },
    {
      "id": 554476,
      "primary_message": "Divide soup between bowls, then top with cheese and reserved pear. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
