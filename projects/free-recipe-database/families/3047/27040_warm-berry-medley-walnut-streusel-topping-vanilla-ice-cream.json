  "instructions": [
    {
      "id": 436209,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 436210,
      "primary_message": "Melt oil in a small saucepan set over medium heat. ",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 436211,
      "primary_message": "Meanwhile, roughly chop walnuts. Place in a small bowl along with flour, sugar, and salt. ",
      "secondary_message": "¼ cup walnuts\n⅓ cup all-purpose flour\n2 tbsp granulated sugar\n⅛ tsp salt"
    },
    {
      "id": 436212,
      "primary_message": "Once the oil is melted, drizzle into the bowl with the flour. Use a fork to stir and combine the streusel topping into rough, sandy clumps (it should be combined but not even). (Reserve saucepan for later use.)",
      "secondary_message": null
    },
    {
      "id": 436213,
      "primary_message": "Transfer streusel mixture to a baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until streusel is golden brown and crisp, 6-8 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 436214,
      "primary_message": "While the streusel is baking, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n1 (6 oz) pkg raspberries\n1 (6 oz) pkg blackberries"
    },
    {
      "id": 436215,
      "primary_message": "Return saucepan to medium heat. Juice lime into the pan, then add raspberries, blackberries, and additional sugar. Cook, stirring occasionally, until berries are juicy and starting to break down, 6-8 minutes. Remove from heat. ",
      "secondary_message": "1 ½ tbsp granulated sugar"
    },
    {
      "id": 436216,
      "primary_message": "To serve, divide berries and ice cream between bowls; top with walnut streusel. Enjoy!",
      "secondary_message": "12 fl oz (1 ½ cups) vanilla ice cream, vegan"
    }
  ],
