  "instructions": [
    {
      "id": 436177,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 436178,
      "primary_message": "Melt butter in a large pot set over medium heat. ",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 436179,
      "primary_message": "Meanwhile, roughly chop walnuts. Place in a medium bowl along with flour, sugar, and salt. ",
      "secondary_message": "¾ cup walnuts\n1 cup all-purpose flour\n⅓ cup granulated sugar\n½ tsp salt"
    },
    {
      "id": 436180,
      "primary_message": "Once the butter is melted, drizzle into the bowl with the flour. Use a fork to stir and combine the streusel topping into rough, sandy clumps (it should be combined but not even). (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 436181,
      "primary_message": "Transfer streusel mixture to a baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until streusel is golden brown and crisp, 6-8 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 436182,
      "primary_message": "While the streusel is baking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 (6 oz) pkgs raspberries\n3 (6 oz) pkgs blackberries"
    },
    {
      "id": 436183,
      "primary_message": "Return pot to medium heat. Juice limes into the pot, then add raspberries, blackberries, and additional sugar. Cook, stirring occasionally, until berries are juicy and starting to break down, 6-8 minutes. Remove from heat. ",
      "secondary_message": "¼ cup granulated sugar"
    },
    {
      "id": 436184,
      "primary_message": "To serve, divide berries and ice cream between bowls; top with walnut streusel. Enjoy!",
      "secondary_message": "36 fl oz (4 ½ cups) vanilla ice cream"
    }
  ],
