  "instructions": [
    {
      "id": 436249,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 436250,
      "primary_message": "Melt oil in a large pot set over medium heat. ",
      "secondary_message": "⅓ cup virgin coconut oil"
    },
    {
      "id": 436251,
      "primary_message": "Meanwhile, place flour, sugar, and salt in a medium bowl.",
      "secondary_message": "1 cup all-purpose flour\n⅓ cup granulated sugar\n½ tsp salt"
    },
    {
      "id": 436252,
      "primary_message": "Once the oil is melted, drizzle into the bowl with the flour. Use a fork to stir and combine the streusel topping into rough, sandy clumps (it should be combined but not even). (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 436253,
      "primary_message": "Transfer streusel mixture to a baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until streusel is golden brown and crisp, 6-8 minutes. Remove from oven and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 436254,
      "primary_message": "While the streusel is baking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 (6 oz) pkgs raspberries\n3 (6 oz) pkgs blackberries"
    },
    {
      "id": 436255,
      "primary_message": "Return pot to medium heat. Juice limes into the pot, then add raspberries, blackberries, and additional sugar. Cook, stirring occasionally, until berries are juicy and starting to break down, 6-8 minutes. Remove from heat. ",
      "secondary_message": "¼ cup granulated sugar"
    },
    {
      "id": 436256,
      "primary_message": "To serve, divide berries and ice cream between bowls; top with streusel. Enjoy!",
      "secondary_message": "36 fl oz (4 ½ cups) vanilla ice cream, vegan"
    }
  ],
