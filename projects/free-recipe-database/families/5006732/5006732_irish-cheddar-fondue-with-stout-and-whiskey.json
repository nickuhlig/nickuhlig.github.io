      "name": "butter",
      "quantity": "1 tbsp"
    },
    {
      "ingredient_id": 24,
      "name": "garlic, finely minced",
      "quantity": "2 medium cloves"
    },
    {
      "ingredient_id": 3136,
      "name": "Irish stout beer",
      "quantity": "12 oz"
    },
    {
      "ingredient_id": 2735,
      "name": "Irish whiskey",
      "quantity": "2 tbsp"
    },
