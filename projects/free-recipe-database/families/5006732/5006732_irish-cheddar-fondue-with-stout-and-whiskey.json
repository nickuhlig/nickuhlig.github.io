    {
      "ingredient_id": 43,
      "name": "shredded Irish cheddar cheese",
      "quantity": "4 cups"
    },
    {
      "ingredient_id": 264,
      "name": "cornstarch",
      "quantity": "1 ½ tbsp"
    },
    {
