  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Zest lime into a small bowl and set aside. Juice lime into a large ovenproof skillet, add cornstarch, and whisk to combine.\n\n",
      "secondary_message": "½ lime\n1 tbsp cornstarch"
    },
    {
      "primary_message": "Add frozen berries, pie filling, coconut, and sugar to the skillet with the lime juice mixture, then stir to combine. Set over medium-high heat and cook, stirring occasionally, until warmed through, about 3 minutes. Remove from heat. \n\n",
      "secondary_message": "4 cups frozen mixed berries\n1 (595 g) can cherry pie filling\n½ cup shredded unsweetened coconut\n¼ cup granulated sugar"
    },
    {
      "primary_message": "Meanwhile, add additional coconut to the bowl with the lime zest and stir to combine. \n\n",
      "secondary_message": "shredded unsweetened coconut"
    },
    {
      "primary_message": "Remove biscuits from the package and arrange on top of the fruit mixture. Brush biscuits with milk, then sprinkle with lime-coconut mixture. Place skillet in the oven (it doesn't have to be fully heated) and bake, uncovered, until the biscuits are golden and cooked through, 15-20 minutes. Remove from oven and set aside to cool slightly, about 10 minutes.\n\n",
      "secondary_message": "1 (453 g) tube biscuit dough\n1 tbsp whole milk"
    },
    {
      "primary_message": "To serve, divide cobbler between bowls and enjoy!",
      "secondary_message": null
    }
  ],
