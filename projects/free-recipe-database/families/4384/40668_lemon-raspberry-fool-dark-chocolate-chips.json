  "instructions": [
    {
      "id": 628717,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 628718,
      "primary_message": "Wash and dry raspberries. Set aside a few berries per person for serving, then place remaining berries in a blender.",
      "secondary_message": "1 (170 g) pkg raspberries"
    },
    {
      "id": 628719,
      "primary_message": "Wash, dry, zest, and juice lemon into the blender, then add sugar and vanilla. Blend on high speed for several minutes until smooth.",
      "secondary_message": "½ lemon\n3 tbsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 628720,
      "primary_message": "Pour raspberry purée into a strainer placed over another medium bowl. Using a silicone spatula, press purée through the strainer to remove seeds; discard seeds and set sauce aside.",
      "secondary_message": null
    },
    {
      "id": 628721,
      "primary_message": "Chop chocolate chips into small pieces. Set aside.",
      "secondary_message": "¼ cup dark chocolate chips"
    },
    {
      "id": 628722,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 628723,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 628724,
      "primary_message": "Add raspberry sauce and chocolate to the bowl with the whipped cream. Gently fold a few times so that there are streaks of sauce running through the fool.",
      "secondary_message": null
    },
    {
      "id": 628725,
      "primary_message": "Divide the fool between small bowls, cups, or jars; garnish each with reserved berries and enjoy!",
      "secondary_message": null
    }
  ],
