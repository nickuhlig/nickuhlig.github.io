  "instructions": [
    {
      "id": 505007,
      "primary_message": "Preheat oven to 425°F. Line two baking sheet pans with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 505008,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 eggplants\n6 tomatoes\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 505009,
      "primary_message": "Place bread crumbs and spices in a small bowl. Stir to combine and set aside.",
      "secondary_message": "1 ½ cup panko bread crumbs\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 505010,
      "primary_message": "Trim and slice eggplants crosswise into ½-inch thick rounds. Divide eggplant between the baking sheets, spreading the slices out in a single layer.",
      "secondary_message": null
    },
    {
      "id": 505011,
      "primary_message": "Spread half of the mayo over the top side of the eggplant rounds, then sprinkle with half of the bread crumbs (pressing gently to adhere). Carefully flip eggplant and repeat with remaining mayo and bread crumbs.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 505012,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until eggplant is tender and golden on both sides, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 505013,
      "primary_message": "Meanwhile, thinly slice mozzarella. Place on a large plate.",
      "secondary_message": "1 ½ (8 oz) pkgs fresh mozzarella cheese"
    },
    {
      "id": 505014,
      "primary_message": "Thinly slice tomatoes and add to the plate with the mozzarella. Set aside.",
      "secondary_message": null
    },
    {
      "id": 505015,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with mayo, vinegar, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp mayonnaise\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 505016,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl with the dressing and set aside.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 505017,
      "primary_message": "When the eggplant is done, top with mozzarella and tomato. Return to the oven and continue to bake until the cheese is melted, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 505018,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl along with mixed greens and pine nuts, then toss to combine the salad. (Reserve remaining basil for serving.)",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 505019,
      "primary_message": "To serve, divide eggplant stacks and salad between plates. Top eggplant with reserved basil and enjoy!",
      "secondary_message": null
    }
  ],
