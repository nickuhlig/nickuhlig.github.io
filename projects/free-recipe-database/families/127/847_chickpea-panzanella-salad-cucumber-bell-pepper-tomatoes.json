  "instructions": [
    {
      "id": 13363,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 13364,
      "primary_message": "Cut bread into cubes.",
      "secondary_message": "1 whole grain bun or roll"
    },
    {
      "id": 13365,
      "primary_message": "Coat bottom of skillet with oil. Add bread cubes, season with salt and pepper, and toss to coat. Stirring occasionally, cook until golden brown, 4-5 minutes.",
      "secondary_message": "about 2 tbsp extra virgin olive oil\r\n⅛ tsp salt\r\n1 pinch black pepper"
    },
    {
      "id": 13366,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "1 clove garlic\r\n3 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 13367,
      "primary_message": "Drain and rinse chickpeas; place on paper towels and pat dry. Add to bowl with dressing and toss to coat.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 13368,
      "primary_message": "Wash and dry cucumber, tomatoes, bell pepper, and basil. Slice the cucumber and tomatoes into half or quarter rounds. Seed and cut the pepper into small strips. Pick the basil leaves off the stems and thinly slice into ribbons. Peel and medium dice onion. Add to bowl.",
      "secondary_message": "½ English cucumber\n2 tomatoes\n1 yellow bell pepper\n½ small pkg fresh basil\n½ medium red onion"
    },
    {
      "id": 13369,
      "primary_message": "Add bread and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 13370,
      "primary_message": "To serve, place salad in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
