  "instructions": [
    {
      "id": 298349,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 298350,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 ½ small pkgs fresh basil\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 298351,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298352,
      "primary_message": "Peel and mince or press garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 298353,
      "primary_message": "Coat bottom of the pot with oil. Add ground beef and garlic. Break apart the beef with a spoon until crumbly. Stirring occasionally, cook until beef is browned, 4-6 minutes.",
      "secondary_message": "1 ½ tbsp virgin coconut oil\n2 ¼ lb lean ground beef"
    },
    {
      "id": 298354,
      "primary_message": "Add the tomato paste and cook until fragrant, 1-2 minutes. ",
      "secondary_message": "3 tbsp tomato paste"
    },
    {
      "id": 298355,
      "primary_message": "Add the tomatoes and broth. Increase the heat to high and bring to a rapid simmer.",
      "secondary_message": "1 ½ (14.5 oz) cans diced tomatoes\n12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 298356,
      "primary_message": "Shave leaves off the parsley stems; discard the stems and mince the leaves. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Put some of the fresh herbs aside to use as garnish. ",
      "secondary_message": null
    },
    {
      "id": 298357,
      "primary_message": "Add the parsley, basil, spinach, salt, and pepper to the pot. Continue to cook for another 4-5 minutes. ",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 298358,
      "primary_message": "Trim ends of the zucchini. Using a vegetable peeler, peel zucchini into thick noodle-like strips. ",
      "secondary_message": null
    },
    {
      "id": 298359,
      "primary_message": "Arrange half of the zucchini in a flat layer that covers the bottom of a baking dish. Pour half of the tomato mixture over top of the zucchini noodles. Then arrange a second layer of zucchini noodles, followed by a second layer of sauce. ",
      "secondary_message": null
    },
    {
      "id": 298360,
      "primary_message": "Thinly slice the mozzarella cheese. Finely grate the Parmesan cheese.  ",
      "secondary_message": "¾ (8 oz) block mozzarella cheese\n6 oz Parmesan cheese"
    },
    {
      "id": 298361,
      "primary_message": "Cover the top layer of sauce with the mozzarella slices and sprinkle with Parmesan, place in the oven for 10-12 minutes. Put the oven to broil for the last few minutes to brown the top if desired. ",
      "secondary_message": null
    },
    {
      "id": 298362,
      "primary_message": "Divide between plates, garnish with remaining fresh herbs, and enjoy!",
      "secondary_message": null
    }
  ],
