  "instructions": [
    {
      "id": 298447,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 298448,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium zucchini squash\n½ small pkg fresh basil\n½ small bunch Italian (flat-leaf) parsley\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 298449,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298450,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 298451,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground, garlic, salt, and pepper. Cook, breaking apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 298452,
      "primary_message": "Add tomato paste to the skillet and cook until fragrant, about 1 minute. ",
      "secondary_message": "1 tbsp tomato paste"
    },
    {
      "id": 298453,
      "primary_message": "Add tomatoes and broth, then bring the sauce to a boil over high heat.",
      "secondary_message": "½ (398 ml) can diced tomatoes\n118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 298454,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Set aside a small handful of both herbs for garnish.",
      "secondary_message": null
    },
    {
      "id": 298455,
      "primary_message": "Add spinach and remaining herbs to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until spinach is tender, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 298456,
      "primary_message": "While the sauce is cooking, trim and run a peeler along the zucchini to make long, noodle-like strips.",
      "secondary_message": null
    },
    {
      "id": 298457,
      "primary_message": "Transfer sauce from the skillet to a small bowl. Arrange half of the zucchini in a flat layer to cover the bottom of the skillet. Pour half of the tomato mixture over top of the zucchini noodles. Arrange a second layer of zucchini noodles, followed by a second layer of sauce. ",
      "secondary_message": null
    },
    {
      "id": 298458,
      "primary_message": "Thinly slice the mozzarella cheese. Finely grate the Parmesan.  ",
      "secondary_message": "¼ (227 g) block mozzarella cheese\n57 g Parmesan cheese"
    },
    {
      "id": 298459,
      "primary_message": "Cover the top layer of sauce with the mozzarella slices and sprinkle with Parmesan; place in the oven and bake until golden and warmed through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 298460,
      "primary_message": "To serve, divide lasagna between plates, garnish with remaining herbs, and enjoy!",
      "secondary_message": null
    }
  ],
