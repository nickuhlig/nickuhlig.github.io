  "instructions": [
    {
      "id": 298475,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 298476,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium zucchini squash\n1 ½ small pkgs fresh basil\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 298477,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298478,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 298479,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggie ground, garlic, salt, and pepper. Cook, breaking apart with a spoon, until crumbly and cooked through, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 298480,
      "primary_message": "Add tomato paste to the pot and cook until fragrant, about 1 minute. ",
      "secondary_message": "3 tbsp tomato paste"
    },
    {
      "id": 298481,
      "primary_message": "Add tomatoes and broth, then bring the sauce to a boil over high heat.",
      "secondary_message": "1 ½ (398 ml) cans diced tomatoes\n355 ml chicken or vegetable broth"
    },
    {
      "id": 298482,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Set aside a small handful of both herbs for garnish.",
      "secondary_message": null
    },
    {
      "id": 298483,
      "primary_message": "Add spinach and remaining herbs to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until spinach is tender, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 298484,
      "primary_message": "While the sauce is cooking, trim and run a peeler along the zucchini to make long, noodle-like strips.",
      "secondary_message": null
    },
    {
      "id": 298485,
      "primary_message": "Arrange half of the zucchini in a flat layer to cover the bottom of a large baking dish. Pour half of the tomato mixture over top of the zucchini noodles. Arrange a second layer of zucchini noodles, followed by a second layer of sauce. ",
      "secondary_message": null
    },
    {
      "id": 298486,
      "primary_message": "Thinly slice the mozzarella cheese. Finely grate the Parmesan.  ",
      "secondary_message": "¾ (227 g) block mozzarella cheese\n170 g Parmesan cheese"
    },
    {
      "id": 298487,
      "primary_message": "Cover the top layer of sauce with the mozzarella slices and sprinkle with Parmesan; place in the oven and bake until golden and warmed through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 298488,
      "primary_message": "To serve, divide lasagna between plates, garnish with remaining herbs, and enjoy!",
      "secondary_message": null
    }
  ],
