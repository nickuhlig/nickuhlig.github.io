  "instructions": [
    {
      "id": 68396,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "2 ¼ cups jasmine rice\n4 ½ cups water\n¾ tsp salt"
    },
    {
      "id": 68395,
      "primary_message": "Place the shrimp in a medium bowl.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 68394,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n3 (1 inch) pieces ginger root\n1 ½ small bunch green onions (scallions)\n1 ½ limes"
    },
    {
      "id": 68409,
      "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 12 to 15 minutes. Remove from the heat and let the rice stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68408,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 1-inch pieces. Transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 68407,
      "primary_message": "Peel and mince or grate the ginger; transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 68393,
      "primary_message": "Peel and mince the garlic; add to the ginger.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 68406,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 68405,
      "primary_message": "Trim off and discard the ends of the green onions; chop the onions into ¼-inch pieces. Transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 68404,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 68403,
      "primary_message": "Add the shrimp to the skillet; cook until opaque, 1 to 2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 68402,
      "primary_message": "Add more coconut oil to the skillet, followed by the garlic, ginger, and white parts of the green onions. Cook until fragrant, 15 to 30 seconds.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 68401,
      "primary_message": "Add the asparagus and cook, stirring frequently, until bright green and just tender, 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68400,
      "primary_message": "Return the shrimp to the skillet and add most of the remaining green onions (save some for garnishing); stir to combine.",
      "secondary_message": ""
    },
    {
      "id": 68399,
      "primary_message": "Add the cooked rice to the skillet; cook, stirring constantly, until any leftover moisture evaporates, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68398,
      "primary_message": "Add soy sauce, sesame oil, and squeeze the lime over top; stir to combine.",
      "secondary_message": "6 tbsp soy sauce\n3 tbsp toasted sesame oil"
    },
    {
      "id": 68397,
      "primary_message": "Divide the stir fry between plates or bowls and sprinkle with the remaining green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
