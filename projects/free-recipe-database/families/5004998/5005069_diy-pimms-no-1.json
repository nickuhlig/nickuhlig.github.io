  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash and slice the navel orange and place it in a sealable glass jar. Do not remove peel. Add bitter orange peel, then pour in gin and vermouth. Seal and shake jar, then steep at room temperature for a minimum of 24 hours and up to 72 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain orange out with a sieve and then filter through cheesecloth or a coffee filter into a glass bottle or jar. Store sealed at room temperature.",
      "secondary_message": null
    }
