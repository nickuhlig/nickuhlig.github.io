  "instructions": [
    {
      "id": 465461,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 465462,
      "primary_message": "Place oil and spices in a medium bowl. Stir to combine the spice oil. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp garlic powder\n⅛ tsp black pepper"
    },
    {
      "id": 465463,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into 1-inch pieces. Add to the bowl with the spice oil.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 465464,
      "primary_message": "Peel, halve, and large dice onion. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 465465,
      "primary_message": "Large dice tempeh, add to the bowl, and toss to coat. Thread tempeh and veggies onto the skewers, alternating ingredients; place on a plate. (If you don't have skewers, you can cook the tempeh and veggies directly on the grill pan.)",
      "secondary_message": "1 (227g ) pkg tempeh"
    },
    {
      "id": 465466,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465467,
      "primary_message": "Once the pan is hot, coat with oil. Add skewers to the pan and cook, turning occasionally, until veggies are lightly charred and tempeh is warmed through, about 6 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 465468,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 465469,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 465470,
      "primary_message": "Place flatbread on a baking sheet pan. Drizzle with oil, then sprinkle with garlic powder, salt, and Parmesan. Place baking sheet in the oven and broil until cheese melts, 2-3 minutes. Remove from oven and slice into wedges.",
      "secondary_message": "1 flatbread or naan\n1 tsp extra virgin olive oil\n¼ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 465471,
      "primary_message": "To serve, divide skewers and cheesy flatbread between plates. Enjoy!",
      "secondary_message": null
    }
  ],
