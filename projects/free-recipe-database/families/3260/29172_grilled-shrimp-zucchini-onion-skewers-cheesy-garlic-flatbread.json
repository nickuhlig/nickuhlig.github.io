  "instructions": [
    {
      "id": 465449,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 465450,
      "primary_message": "Place oil and spices in a large bowl. Stir to combine the spice oil. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 465451,
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into 1-inch pieces. Add to the bowl with the spice oil.",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 465452,
      "primary_message": "Peel, halve, and large dice onions. Add to the bowl.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 465453,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 465454,
      "primary_message": "Add shrimp to the bowl with the veggies and toss to coat. Thread shrimp and veggies onto the skewers, alternating ingredients; place on a plate. (If you don't have skewers, you can cook the shrimp and veggies directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 465455,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465456,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add skewers to the pan and cook, turning occasionally, until veggies are lightly charred and shrimp are cooked through, about 6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 465457,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 465458,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 465459,
      "primary_message": "Place flatbreads on a large baking sheet pan. Drizzle with oil, then sprinkle with garlic powder, salt, and Parmesan. Place baking sheet in the oven and broil until cheese melts, 2-3 minutes. Remove from oven and slice into wedges.",
      "secondary_message": "3 flatbreads or naan\n1 tbsp extra virgin olive oil\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 465460,
      "primary_message": "To serve, divide skewers and cheesy flatbread between plates. Enjoy!",
      "secondary_message": null
    }
  ],
