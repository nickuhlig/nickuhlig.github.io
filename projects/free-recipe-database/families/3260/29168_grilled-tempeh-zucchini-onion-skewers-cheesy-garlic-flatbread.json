  "instructions": [
    {
      "id": 465403,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 465404,
      "primary_message": "Place oil and spices in a large bowl. Stir to combine the spice oil. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n1 tsp salt\n½ tsp garlic powder\n¼ tsp black pepper"
    },
    {
      "id": 465405,
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into 1-inch pieces. Add to the bowl with the spice oil.",
      "secondary_message": "4 medium zucchini squash"
    },
    {
      "id": 465406,
      "primary_message": "Peel, halve, and large dice onion. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 465407,
      "primary_message": "Large dice tempeh, add to the bowl, and toss to coat. Thread tempeh and veggies onto the skewers, alternating ingredients; place on a plate. (If you don't have skewers, you can cook the tempeh and veggies directly on the grill pan.)",
      "secondary_message": "2 (8 oz) packages tempeh"
    },
    {
      "id": 465408,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465409,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add skewers to the pan and cook, turning occasionally, until veggies are lightly charred and tempeh is warmed through, about 6 minutes. Return to the plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 465410,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 465411,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 465412,
      "primary_message": "Place flatbreads on a baking sheet pan. Drizzle with oil, then sprinkle with garlic powder, salt, and Parmesan. Place baking sheet in the oven and broil until cheese melts, 2-3 minutes. Remove from oven and slice into wedges.",
      "secondary_message": "2 flatbreads or naan\n2 tsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 465413,
      "primary_message": "To serve, divide skewers and cheesy flatbread between plates. Enjoy!",
      "secondary_message": null
    }
  ],
