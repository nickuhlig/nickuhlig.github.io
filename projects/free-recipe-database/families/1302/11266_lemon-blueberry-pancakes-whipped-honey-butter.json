  "instructions": [
    {
      "id": 190645,
      "primary_message": "Cut butter into small pieces and place in a small bowl. Set aside to soften.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 190646,
      "primary_message": "Meanwhile, whisk together flour, sugar, baking powder, and salt in a medium bowl.",
      "secondary_message": "¾ cup all-purpose flour\n1 ½ tbsp brown sugar\n1 tsp baking powder\n¼ tsp salt"
    },
    {
      "id": 190647,
      "primary_message": "Place egg and milk in a small bowl and whisk to combine.",
      "secondary_message": "1 egg\n118 ml (½ cup) whole milk"
    },
    {
      "id": 190648,
      "primary_message": "Melt additional butter in a large skillet over low heat. Quickly whisk melted butter into the egg mixture to combine.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 190649,
      "primary_message": "Create a well in the center of the flour mixture. Add the egg mixture and whisk until just combined.",
      "secondary_message": null
    },
    {
      "id": 190650,
      "primary_message": "Wash and dry lemon. Zest and juice into the pancake batter; whisk until smooth, being careful not to over-mix the batter.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 190651,
      "primary_message": "Gently fold blueberries into the pancake batter.",
      "secondary_message": "½ (170 g) pkg blueberries"
    },
    {
      "id": 190652,
      "primary_message": "Return skillet to medium-high heat. Add more butter and swirl to coat the bottom. ",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 190653,
      "primary_message": "Working in batches, use a ¼-cup measure to pour the batter into the skillet. Cook for 1-2 minutes on each side, until golden and cooked through.",
      "secondary_message": null
    },
    {
      "id": 190654,
      "primary_message": "Meanwhile, add honey to the bowl with the softened butter; stir vigorously with a fork to combine and whip the honey butter.",
      "secondary_message": "2 tsp honey"
    },
    {
      "id": 190655,
      "primary_message": "To serve, divide pancakes between plates and top with honey butter. Enjoy!",
      "secondary_message": null
    }
  ],
