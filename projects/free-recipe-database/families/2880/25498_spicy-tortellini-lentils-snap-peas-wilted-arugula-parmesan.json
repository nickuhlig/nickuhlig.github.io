  "instructions": [
    {
      "id": 428059,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside. ",
      "secondary_message": "255 g cheese tortellini, fresh or frozen"
    },
    {
      "id": 428060,
      "primary_message": "Meanwhile, wash, dry, and halve snap peas.",
      "secondary_message": "½ (227 g) pkg sugar snap peas"
    },
    {
      "id": 428061,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428062,
      "primary_message": "While the skillet heats up, drain and rinse lentils.",
      "secondary_message": "1 (255 g) can lentils"
    },
    {
      "id": 428063,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add snap peas, lentils, and spices; cook, stirring occasionally, until the snap peas start to soften, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 428064,
      "primary_message": "Meanwhile, wash and dry the arugula (skip this step if it came pre-washed).",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 428065,
      "primary_message": "When the snap peas are soft, add arugula to the skillet in handfuls, waiting for the arugula to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 428066,
      "primary_message": "Add drained tortellini and Parmesan to the skillet. Continue to cook, stirring often, until the cheese is melted, 1-2 minutes more. Remove from heat. ",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    },
    {
      "id": 428067,
      "primary_message": "To serve, divide tortellini between plates or bowls; sprinkle with crushed red pepper. Enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
