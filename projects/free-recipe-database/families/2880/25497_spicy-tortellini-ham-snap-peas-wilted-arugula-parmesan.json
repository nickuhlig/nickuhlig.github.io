  "instructions": [
    {
      "id": 428049,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside. ",
      "secondary_message": "765 g cheese tortellini, fresh or frozen"
    },
    {
      "id": 428050,
      "primary_message": "Meanwhile, wash, dry, and halve snap peas. Place in a medium bowl.",
      "secondary_message": "1 ½ (227 g) pkgs sugar snap peas"
    },
    {
      "id": 428051,
      "primary_message": "Medium dice ham. Add to the bowl with the snap peas.",
      "secondary_message": "680 g ham steak, boneless"
    },
    {
      "id": 428052,
      "primary_message": "Peel and mince garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 428053,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 428054,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add snap peas, ham, garlic, and spices; cook, stirring occasionally, until the snap peas start to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 428055,
      "primary_message": "Meanwhile, wash and dry the arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 428056,
      "primary_message": "When the snap peas are soft, add arugula to the pot in handfuls, waiting for the arugula to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 428057,
      "primary_message": "Add drained tortellini and Parmesan to the pot. Continue to cook, stirring often, until the cheese is melted, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    },
    {
      "id": 428058,
      "primary_message": "To serve, divide tortellini between plates or bowls; sprinkle with crushed red pepper. Enjoy!",
      "secondary_message": "¾ tsp crushed red pepper"
    }
  ],
