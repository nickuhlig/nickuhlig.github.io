  "instructions": [
    {
      "id": 229196,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 229197,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 229198,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 229199,
      "primary_message": "Meanwhile, peel and medium dice onion. Peel and thinly slice garlic. Transfer both to a medium bowl.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 229200,
      "primary_message": "Wash, dry, seed, and medium dice bell pepper; add to the bowl with the onion and garlic.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 229201,
      "primary_message": "Drain artichokes and add to the bowl.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 229202,
      "primary_message": "Wash, dry, and juice lemon into the bowl. Add oil and spices, then toss to combine.",
      "secondary_message": "½ lemon\n2 tsp extra virgin olive oil\n1 tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229203,
      "primary_message": "Transfer veggies to a baking sheet pan and spread out in a single layer. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 229204,
      "primary_message": "Mince olives and place in the reserved bowl; add oil and stir to combine the olive mixture.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 229205,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheet. Spoon olive mixture over the chicken.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229206,
      "primary_message": "Place baking sheet in the oven and roast until chicken is cooked through and veggies are tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 229207,
      "primary_message": "To serve, divide rice, roasted veggies, and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
