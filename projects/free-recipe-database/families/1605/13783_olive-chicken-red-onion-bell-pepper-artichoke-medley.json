  "instructions": [
    {
      "id": 229166,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 229167,
      "primary_message": "Peel and medium dice onion. Peel and thinly slice garlic. Transfer both to a medium bowl.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 229168,
      "primary_message": "Wash, dry, seed, and medium dice bell peppers; add to the bowl with the onion and garlic.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 229169,
      "primary_message": "Drain artichokes and add to the bowl.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 229170,
      "primary_message": "Wash, dry, and juice lemon into the bowl. Add oil and spices, then toss to combine.",
      "secondary_message": "½ lemon\n1 tbsp extra virgin olive oil\n1 tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229171,
      "primary_message": "Transfer veggies to a baking sheet pan and spread out in a single layer. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 229172,
      "primary_message": "Mince olives and place in the reserved bowl; add oil and stir to combine the olive mixture.",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 229173,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheet. Spoon olive mixture over the chicken.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 229174,
      "primary_message": "Place baking sheet in the oven and roast until chicken is cooked through and veggies are tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 229175,
      "primary_message": "To serve, divide roasted veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
