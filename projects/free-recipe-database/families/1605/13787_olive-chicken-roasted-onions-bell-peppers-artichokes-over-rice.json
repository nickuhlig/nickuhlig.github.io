  "instructions": [
    {
      "id": 229208,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 229209,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 229210,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 229211,
      "primary_message": "Meanwhile, peel and medium dice onions. Peel and thinly slice garlic. Transfer both to a medium bowl.",
      "secondary_message": "2 medium red onions\n4 cloves garlic"
    },
    {
      "id": 229212,
      "primary_message": "Wash, dry, seed, and medium dice bell peppers; add to the bowl with the onions and garlic.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 229213,
      "primary_message": "Drain artichokes and add to the bowl.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 229214,
      "primary_message": "Wash, dry, and juice lemon into the bowl. Add oil and spices, then toss to combine.",
      "secondary_message": "1 lemon\n4 tsp extra virgin olive oil\n2 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229215,
      "primary_message": "Transfer veggies to a large baking sheet pan and spread out in a single layer. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 229216,
      "primary_message": "Mince olives and place in the reserved bowl; add oil and stir to combine the olive mixture.",
      "secondary_message": "½ cup Kalamata olives, pitted\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 229217,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheet. Spoon olive mixture over the chicken.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 229218,
      "primary_message": "Place baking sheet in the oven and roast until chicken is cooked through and veggies are tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 229219,
      "primary_message": "To serve, divide rice, roasted veggies, and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
