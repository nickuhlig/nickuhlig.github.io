  "instructions": [
    {
      "id": 229220,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 229221,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 229222,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 229223,
      "primary_message": "Meanwhile, peel and medium dice onions. Peel and thinly slice garlic. Transfer both to a large bowl.",
      "secondary_message": "3 medium red onions\n6 cloves garlic"
    },
    {
      "id": 229224,
      "primary_message": "Wash, dry, seed, and medium dice bell peppers; add to the bowl with the onions and garlic.",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 229225,
      "primary_message": "Drain artichokes and add to the bowl.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 229226,
      "primary_message": "Wash, dry, and juice lemons into the bowl. Add oil and spices, then toss to combine.",
      "secondary_message": "1 ½ lemons\n2 tbsp extra virgin olive oil\n1 tbsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229227,
      "primary_message": "Divide veggies between two baking sheet pans and spread out in a single layer. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 229228,
      "primary_message": "Mince olives and place in the reserved bowl; add oil and stir to combine the olive mixture.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 229229,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheets. Spoon olive mixture over the chicken.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229230,
      "primary_message": "Place baking sheets in the oven and roast until chicken is cooked through and veggies are tender, 22-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 229231,
      "primary_message": "To serve, divide rice, roasted veggies, and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
