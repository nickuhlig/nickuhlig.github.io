  "instructions": [
    {
      "id": 229252,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 229253,
      "primary_message": "Peel and medium dice onions. Peel and thinly slice garlic. Transfer both to a large bowl.",
      "secondary_message": "3 medium red onions\n6 cloves garlic"
    },
    {
      "id": 229254,
      "primary_message": "Wash, dry, and seed bell peppers; medium dice and add to the bowl with the onions and garlic.",
      "secondary_message": "6 red bell peppers"
    },
    {
      "id": 229255,
      "primary_message": "Drain artichokes and add to the bowl.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 229256,
      "primary_message": "Wash, dry, and juice lemons into the bowl. Add oil and spices, then toss to combine.",
      "secondary_message": "1 ½ lemons\n3 tbsp extra virgin olive oil\n1 tbsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229257,
      "primary_message": "Divide veggies between two baking sheet pans and spread out in a single layer. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 229258,
      "primary_message": "Mince olives and place in the reserved bowl; add oil and stir to combine the olive mixture.",
      "secondary_message": "1 cup Kalamata olives, pitted\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 229259,
      "primary_message": "Season both sides of the chicken with salt and pepper; nestle chicken in the veggies on the baking sheets. Spoon olive mixture over the chicken.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 229260,
      "primary_message": "Place baking sheets in the oven and roast until chicken is cooked through and veggies are tender, 22-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 229261,
      "primary_message": "To serve, divide roasted veggies and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
