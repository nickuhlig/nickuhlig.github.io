  "instructions": [
    {
      "id": 414688,
      "primary_message": "Cut tofu into ½-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 414689,
      "primary_message": "Place miso paste, vinegar, honey, and spices in a small bowl. Stir to combine the marinade.",
      "secondary_message": "⅓ cup miso paste, red\n3 tbsp rice vinegar\n3 tbsp honey\n1 ½ tsp crushed red pepper\n1 ½ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 414690,
      "primary_message": "Place tofu on a large plate, drizzle with marinade, and gently turn to coat. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 414691,
      "primary_message": "Wash, dry, and chop chives into small pieces. Place in a large bowl, along with the dressing, and stir to combine. Set aside. ",
      "secondary_message": "1 small pkg chives\n¾ cup honey mustard dressing"
    },
    {
      "id": 414692,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 414693,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook until golden, 2-3 minutes per side. Remove from heat. ",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 414694,
      "primary_message": "Meanwhile, wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; medium dice. Add to the bowl with the dressing, along with the broccoli slaw, and toss to combine. ",
      "secondary_message": "3 mangoes\n1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 414695,
      "primary_message": "To serve, divide tofu and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
