  "instructions": [
    {
      "id": 414635,
      "primary_message": "Cut tofu into ½-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 414636,
      "primary_message": "Place miso paste, vinegar, honey, and spices in a small bowl. Stir to combine the marinade.",
      "secondary_message": "¼ cup miso paste, red\n2 tbsp rice vinegar\n2 tbsp honey\n1 tsp crushed red pepper\n1 tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 414637,
      "primary_message": "Place tofu on a plate, drizzle with marinade, and gently turn to coat. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 414638,
      "primary_message": "Wash, dry, and chop chives into small pieces. Place in a medium bowl, along with the dressing, and stir to combine. Set aside. ",
      "secondary_message": "1 small pkg chives\n½ cup honey mustard dressing"
    },
    {
      "id": 414639,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 414640,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook until golden, 2-3 minutes per side. Remove from heat. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 414641,
      "primary_message": "Meanwhile, wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; medium dice. Add to the bowl with the dressing, along with the broccoli slaw, and toss to combine. ",
      "secondary_message": "2 mangoes\n1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 414642,
      "primary_message": "To serve, divide tofu and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
