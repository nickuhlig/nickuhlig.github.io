  "instructions": [
    {
      "id": 198891,
      "primary_message": "Peel and small dice onion. Place half in a medium bowl and set aside for the pico de gallo.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 198892,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 198893,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 198894,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add rice, onion, and spices; cook, stirring constantly, until onions are soft and rice is golden and toasted (you should hear a slight sizzle and pop from the rice), about 4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ⅓ cups basmati rice\n1 tsp chili powder\n½ tsp cumin"
    },
    {
      "id": 198895,
      "primary_message": "Add garlic, water, corn, tomato sauce, and salt to the pot and bring to a boil over high heat. Once the liquid comes to a boil, stir, cover, and reduce the heat to low. Cook the rice until liquid is fully absorbed, 18-20 minutes.",
      "secondary_message": "3 cup water\n1 cup frozen corn\n1 (213 ml) can tomato sauce\n1 tsp salt"
    },
    {
      "id": 198896,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 jalapeño pepper\n2 tomatoes\n1 small bunch cilantro\n1 avocado"
    },
    {
      "id": 198897,
      "primary_message": "Juice lime into the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 198898,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely mince and add to the bowl with the onion. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 198899,
      "primary_message": "Small dice tomatoes. Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl along with salt, and stir to combine the pico de gallo. Set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 198900,
      "primary_message": "Grate the cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 198901,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 198902,
      "primary_message": "Drain and rinse the beans in a colander. ",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 198903,
      "primary_message": "When the rice is done, add beans to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 198904,
      "primary_message": "To serve, divide rice and bean mixture between bowls or plates. Top with pico de gallo, cheese, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
