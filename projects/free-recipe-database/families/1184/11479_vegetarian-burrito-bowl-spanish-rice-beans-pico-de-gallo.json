  "instructions": [
    {
      "id": 198877,
      "primary_message": "Peel and small dice onion. Place half in a small bowl and set aside for the pico de gallo.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 198878,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 198879,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 198880,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add rice, onion, and spices; cook, stirring constantly, until onions are soft and rice is golden and toasted (you should hear a slight sizzle and pop from the rice), about 3 minutes.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n⅔ cup basmati rice\n½ tsp chili powder\n¼ tsp cumin"
    },
    {
      "id": 198881,
      "primary_message": "Add garlic, water, corn, tomato sauce, and salt to the saucepan and bring to a boil over high heat. Once the liquid comes to a boil, stir, cover, and reduce the heat to low. Cook the rice until liquid is fully absorbed, 18-20 minutes.",
      "secondary_message": "1 ½ cup water\n½ cup frozen corn\n½ (213 ml) can tomato sauce\n½ tsp salt"
    },
    {
      "id": 198882,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ jalapeño pepper\n1 tomato\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 198883,
      "primary_message": "Juice lime into the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 198884,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely mince and add to the bowl with the onion. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 198885,
      "primary_message": "Small dice tomato. Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl along with salt, and stir to combine the pico de gallo. Set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 198886,
      "primary_message": "Grate the cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 198887,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 198888,
      "primary_message": "Drain and rinse the beans in a colander. ",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 198889,
      "primary_message": "When the rice is done, add beans to the saucepan and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 198890,
      "primary_message": "To serve, divide rice and bean mixture between bowls or plates. Top with pico de gallo, cheese, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
