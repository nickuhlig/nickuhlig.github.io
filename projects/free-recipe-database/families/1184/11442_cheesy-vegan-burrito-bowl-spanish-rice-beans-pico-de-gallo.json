  "instructions": [
    {
      "id": 198947,
      "primary_message": "Peel and small dice onions. Place half in a medium bowl and set aside for the pico de gallo.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 198948,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 198949,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 198950,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add rice, onion, and spices; cook, stirring constantly, until onions are soft and rice is golden and toasted (you should hear a slight sizzle and pop from the rice), about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 cups basmati rice\n1 ½ tsp chili powder\n¾ tsp cumin"
    },
    {
      "id": 198951,
      "primary_message": "Add garlic, water, corn, tomato sauce, and salt to the pot and bring to a boil over high heat. Once the liquid comes to a boil, stir, cover, and reduce the heat to low. Cook the rice until liquid is fully absorbed, 18-20 minutes.",
      "secondary_message": "4 ½ cup water\n1 ½ cups frozen corn\n1 ½ (213 ml) cans tomato sauce\n1 ½ tsp salt"
    },
    {
      "id": 198952,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 ½ jalapeño peppers\n3 tomatoes\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 198953,
      "primary_message": "Juice limes into the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 198954,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely mince and add to the bowl with the onion. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 198955,
      "primary_message": "Small dice tomatoes. Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl along with salt, and stir to combine the pico de gallo. Set aside.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 198956,
      "primary_message": "In a small saucepan, combine almond milk, oil, nutritional yeast, arrowroot starch, Dijon, onion powder, and garlic powder; whisk until smooth. Place the saucepan over medium heat and cook, whisking constantly, until the sauce becomes thick and stretchy, 3-4 minutes. Remove from the heat.",
      "secondary_message": "177 ml almond milk, unsweetened\n2 tbsp extra virgin olive oil\n⅜ cup nutritional yeast flakes\n1 tbsp arrowroot starch/powder\n1 tbsp Dijon mustard\n3 pinch onion powder\n3 pinch garlic powder"
    },
    {
      "id": 198957,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 198958,
      "primary_message": "Drain and rinse the beans in a colander. ",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 198959,
      "primary_message": "When the rice is done, add beans to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 198960,
      "primary_message": "To serve, divide rice and bean mixture between bowls or plates. Top with pico de gallo, avocado, and cheesy sauce. Enjoy!",
      "secondary_message": null
    }
  ],
