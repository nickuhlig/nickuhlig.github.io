  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the Calmyrna figs.",
      "secondary_message": "2 cups Calmyrna figs"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 325°F. Butter and flour a 10-inch loaf pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, baking powder, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat eggs until loosened. Add sugar and beat (with an electric mixer if desired) until pale and foamy, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "With beaters running, add olive oil and beat until combined. Stir in fennel seeds. Beat in flour mixture until just combined. Fold in figs.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour batter into prepared loaf pan and bake until golden and a cake tester comes out clean, about 45 minutes.",
      "secondary_message": null
    }
  ],
