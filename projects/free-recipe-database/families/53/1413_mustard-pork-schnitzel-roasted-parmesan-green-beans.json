  "instructions": [
    {
      "id": 12367,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": ""
    },
    {
      "id": 12368,
      "primary_message": "Wash green beans and trim ends. Transfer to a sheet pan.",
      "secondary_message": "1 lb green beans"
    },
    {
      "id": 12369,
      "primary_message": "Peel and mince garlic. Sprinkle green beans with garlic, drizzle with oil, and season with salt and pepper; toss to coat.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 12370,
      "primary_message": "Spread out evenly and place in the oven. Roast until tender-crisp, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 12371,
      "primary_message": "In a medium bowl, mix together bread crumbs, thyme, salt, and pepper.",
      "secondary_message": "½ cup panko bread crumbs\n1 tsp thyme\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 12372,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 12373,
      "primary_message": "Holding a knife parallel to the cutting board, cut the pork chops in half horizontally to form thin cutlets. Rub with Dijon mustard on both sides, then place in the breadcrumb mixture and coat on both sides.",
      "secondary_message": "2 pork chops, boneless\n1 tbsp Dijon mustard"
    },
    {
      "id": 12374,
      "primary_message": "Coat bottom of skillet with oil. Add pork chops and cook until golden brown and cooked through, 3-4 minutes per side.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 12375,
      "primary_message": "Grate ⅛ cup Parmesan.",
      "secondary_message": "½ oz Parmesan cheese"
    },
    {
      "id": 12376,
      "primary_message": "Remove green beans from oven, sprinkle with Parmesan, and toss.",
      "secondary_message": ""
    },
    {
      "id": 12377,
      "primary_message": "To serve, place pork chops and green beans on a plate. Add a dollop of Dijon on the side for dipping if desired. Enjoy!",
      "secondary_message": ""
    }
  ],
