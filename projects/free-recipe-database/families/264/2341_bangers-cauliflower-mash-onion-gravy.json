  "instructions": [
    {
      "id": 22409,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 22410,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stem into smaller pieces. Transfer to a bowl.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 22411,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 22412,
      "primary_message": "Add sausages to skillet and cook until browned on all sides, 2-3 minutes. Reduce heat to medium, add water, and continue cooking until cooked (or heated) through, 6-8 minutes. Alternatively, cook according to package directions. Transfer to a plate.",
      "secondary_message": "4 pork sausages\r\n⅛ cup water"
    },
    {
      "id": 22413,
      "primary_message": "Add cauliflower to boiling water and cook until very tender, 6-7 minutes.",
      "secondary_message": ""
    },
    {
      "id": 22414,
      "primary_message": "Thinly slice onion into half rings.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 22415,
      "primary_message": "Once sausages have been transferred, add butter and onion to skillet. Cook, stirring frequently, until onion is softened and caramelized, about 10 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\r\n"
    },
    {
      "id": 22416,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 22419,
      "primary_message": "Drain cauliflower in a colander, then return to saucepan. Add water, garlic, butter, salt, and pepper. Blend using a hand/immersion blender or a potato masher. Cover and set aside.",
      "secondary_message": "⅛ cup water\r\n1 tbsp butter, unsalted\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 22420,
      "primary_message": "Sprinkle onions with cornstarch and mix until cornstarch is evenly incorporated with the onions.",
      "secondary_message": "1 tsp cornstarch\r\n"
    },
    {
      "id": 22421,
      "primary_message": "Pour in broth and cook until mixture is thickened, 4-5 minutes. Season with salt and pepper.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 22422,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and chop the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\r\n"
    },
    {
      "id": 22423,
      "primary_message": "Return sausages to skillet on top of the onion gravy and turn until heated through.",
      "secondary_message": ""
    },
    {
      "id": 22424,
      "primary_message": "To serve, place cauliflower purée in a shallow bowl. Add sausages and top with onion gravy. Garnish with parsley and enjoy!",
      "secondary_message": ""
    }
  ],
