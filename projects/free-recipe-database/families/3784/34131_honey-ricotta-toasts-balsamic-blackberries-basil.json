  "instructions": [
    {
      "id": 540999,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 541000,
      "primary_message": "Meanwhile, wash, dry, and roughly chop blackberries. Place in a medium bowl.",
      "secondary_message": "6 (6 oz) pkgs blackberries"
    },
    {
      "id": 541001,
      "primary_message": "Wash, dry, and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the blackberries, along with vinegar, and stir to combine the berry mix. Set aside.",
      "secondary_message": "1 small pkg fresh basil\n3 tbsp balsamic vinegar"
    },
    {
      "id": 541002,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 541003,
      "primary_message": "While the bread is toasting, place ricotta, honey, salt, and pepper in another medium bowl. Stir to combine.",
      "secondary_message": "1 ½ (15 oz) pkgs ricotta cheese\n2 tbsp honey\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 541004,
      "primary_message": "To serve, divide toast between plates and spread with ricotta. Top with berry mix and drizzle with additional honey. Enjoy!",
      "secondary_message": "2 tbsp honey"
    }
  ],
