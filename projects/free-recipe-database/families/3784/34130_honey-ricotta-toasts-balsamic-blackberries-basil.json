  "instructions": [
    {
      "id": 540993,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 540994,
      "primary_message": "Meanwhile, wash, dry, and roughly chop blackberries. Place in a medium bowl.",
      "secondary_message": "4 (6 oz) pkgs blackberries"
    },
    {
      "id": 540995,
      "primary_message": "Wash, dry, and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the blackberries, along with vinegar, and stir to combine the berry mix. Set aside.",
      "secondary_message": "1 small pkg fresh basil\n2 tbsp balsamic vinegar"
    },
    {
      "id": 540996,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 540997,
      "primary_message": "While the bread is toasting, place ricotta, honey, salt, and pepper in a small bowl. Stir to combine.",
      "secondary_message": "1 (15 oz) pkg ricotta cheese\n4 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 540998,
      "primary_message": "To serve, divide toast between plates and spread with ricotta. Top with berry mix and drizzle with additional honey. Enjoy!",
      "secondary_message": "4 tsp honey"
    }
  ],
