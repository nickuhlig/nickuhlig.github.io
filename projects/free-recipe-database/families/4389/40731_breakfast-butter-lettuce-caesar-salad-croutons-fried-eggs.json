  "instructions": [
    {
      "id": 629378,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 629379,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes. ",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 629380,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 4-5 minutes. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 629381,
      "primary_message": "Meanwhile, wash, dry, and juice lemon into a medium bowl.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 629382,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 629383,
      "primary_message": "Mince anchovy fillet. Add to the bowl along with mayo, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "1 anchovy fillet, packed in oil\n2 tbsp mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 629384,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 tsp extra virgin olive oil\n4 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 629385,
      "primary_message": "Meanwhile, wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing, along with croutons, and gently toss to combine the salad. Set aside.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 629386,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 629387,
      "primary_message": "To serve, divide salad between plates, then top with Parmesan and fried eggs. Enjoy!",
      "secondary_message": null
    }
  ],
