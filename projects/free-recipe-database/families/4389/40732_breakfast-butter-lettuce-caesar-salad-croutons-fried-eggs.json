  "instructions": [
    {
      "id": 629388,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 629389,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 629390,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 4-5 minutes. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 629391,
      "primary_message": "Meanwhile, wash, dry, and juice lemon into a large bowl.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 629392,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 629393,
      "primary_message": "Mince anchovy fillets. Add to the bowl along with mayo, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 anchovy fillets, packed in oil\n¼ cup mayonnaise\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 629394,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 629395,
      "primary_message": "Meanwhile, wash, dry, and chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing, along with croutons, and gently toss to combine the salad. Set aside.",
      "secondary_message": "2 heads butter (Boston) lettuce"
    },
    {
      "id": 629396,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 629397,
      "primary_message": "To serve, divide salad between plates, then top with Parmesan and fried eggs. Enjoy!",
      "secondary_message": null
    }
  ],
