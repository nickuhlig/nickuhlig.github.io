  "instructions": [
    {
      "id": 67997,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ small pineapple\n3 avocados\n1 ½ (5 oz) pkg baby spinach"
    },
    {
      "id": 67996,
      "primary_message": "Peel and small dice the onion; transfer to a small bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 67995,
      "primary_message": "Peel and mince the garlic; add to the bowl of onion.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 67994,
      "primary_message": "Cut off and discard the skin of the pineapple; halve or quarter the pineapple lengthwise and cut off and discard the core from the pieces. Cut the flesh into bite-sized pieces and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 67993,
      "primary_message": "Heat a medium saucepan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 67992,
      "primary_message": "Add the onion and ground beef to the saucepan; cook, breaking apart the meat into smaller pieces, until the beef is browned and the onion is tender, 3 to 5 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef"
    },
    {
      "id": 67991,
      "primary_message": "Season the beef with chili powder, cumin, salt, and pepper; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "3 tbsp chili powder\n1 ½ tsp cumin\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 67990,
      "primary_message": "Add almost all of the pineapple (save a few pieces for garnishing) and diced tomatoes to the saucepan; stir to combine.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 67989,
      "primary_message": "Increase the heat and bring the chili to a boil. Once boiling, reduce the heat to low, cover, and cook for 10 minutes.",
      "secondary_message": ""
    },
    {
      "id": 67988,
      "primary_message": "Halve and pit the avocados; scoop out the flesh and discard the skins. Medium dice the flesh and transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 67987,
      "primary_message": "Stir the spinach into the chili until it wilts.",
      "secondary_message": ""
    },
    {
      "id": 67986,
      "primary_message": "Divide the chili between bowls and garnish with the remaining pineapple and avocado chunks. Enjoy!",
      "secondary_message": ""
    }
  ],
