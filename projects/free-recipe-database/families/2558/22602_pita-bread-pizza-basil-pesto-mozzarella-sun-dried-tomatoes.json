  "instructions": [
    {
      "id": 375510,
      "primary_message": "Preheat the oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 375511,
      "primary_message": "Place pitas on a large baking sheet pan and spread with pesto.",
      "secondary_message": "3 whole grain pitas\n⅓ cup basil pesto"
    },
    {
      "id": 375512,
      "primary_message": "Coarsely grate cheese. Sprinkle over the pesto.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 375513,
      "primary_message": "Thinly slice sun-dried tomatoes. Arrange tomatoes over the cheese, then sprinkle with Italian seasoning.",
      "secondary_message": "6 sun-dried tomatoes, oil-packed\n3 pinch Italian seasoning"
    },
    {
      "id": 375514,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until pita bread is lightly crisp and cheese is melted, 5-7 minutes. Remove from oven and let cool slightly before cutting into wedges.",
      "secondary_message": null
    },
    {
      "id": 375515,
      "primary_message": "To serve, divide pizza wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
