  "instructions": [
    {
      "id": 1,
      "primary_message": "Arrange 14 g of cheese on one side of a nonstick skillet in a 5- by 5-cm rectangle. Turn heat to medium-low. When cheese begins to melt, place 1 tortilla on top of cheese so that roughly half the cheese is covered by the tortilla.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Let cheese cook until it turns an even golden brown color. Remove pan from heat and let stand until cheese cools and firms up slightly.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Carefully slide a thin spatula under cheese and remove tortilla from pan. Fill as desired (see notes) and serve immediately. Repeat with remaining cheese and tortillas.",
      "secondary_message": null
    }
  ],
