  "instructions": [
    {
      "id": 75266,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": ""
    },
    {
      "id": 75265,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 leeks"
    },
    {
      "id": 75264,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 75263,
      "primary_message": "Cut the bacon crosswise into 6-mm-thick strips.",
      "secondary_message": "9 slices bacon"
    },
    {
      "id": 75258,
      "primary_message": "When the water in the saucepan comes to a boil, uncover the pan and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Drain the pasta in a colander, reserving 1 ½ cup of the cooking water.",
      "secondary_message": "3 tbsp salt\n425 g (about 4 ½ cups) penne pasta"
    },
    {
      "id": 75262,
      "primary_message": "Add the bacon to the skillet; cook, stirring occasionally, until cooked through but not crispy, 2 to 4 minutes. Once done, transfer to a bowl, leaving the drippings in the skillet.",
      "secondary_message": ""
    },
    {
      "id": 75261,
      "primary_message": "While the bacon cooks, trim off and discard the ends of the leeks; thinly slice the leeks crosswise.",
      "secondary_message": ""
    },
    {
      "id": 75260,
      "primary_message": "Once the bacon has been transferred, add the leeks to the skillet and season with salt and pepper. Cook, stirring occasionally, until tender, 6 to 8 minutes.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 75257,
      "primary_message": "Finely grate 3 cups of Parmesan and transfer to a small bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 75256,
      "primary_message": "Add the pasta, bacon, goat cheese, ¾ of the Parmesan (save the rest for garnishing) and reserved cooking water to the skillet; cook, stirring constantly, until the mixture is smooth and thoroughly combined, 1 to 2 minutes.",
      "secondary_message": "1 ½ (113 g) log goat cheese"
    },
    {
      "id": 75259,
      "primary_message": "To serve, divide the pasta between bowls, sprinkle with the remaining Parmesan, and garnish with black pepper. Enjoy!",
      "secondary_message": "⅜ tsp black pepper"
    }
  ],
