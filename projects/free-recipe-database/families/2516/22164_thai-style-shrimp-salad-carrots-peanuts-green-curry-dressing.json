  "instructions": [
    {
      "id": 371403,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg fresh mint\n3 limes\n1 ½ English cucumbers\n3 avocados\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 371404,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 371405,
      "primary_message": "Place curry paste, oil, and salt in a large bowl; whisk to combine. Add shrimp and toss to coat.",
      "secondary_message": "3 tbsp Thai curry paste, green\n2 tbsp toasted sesame oil\n¾ tsp salt"
    },
    {
      "id": 371406,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 371407,
      "primary_message": "Once the skillet is hot, add shrimp and cook until opaque, about 2 minutes per side. Remove from heat and set aside to cool slightly. ",
      "secondary_message": null
    },
    {
      "id": 371408,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 371409,
      "primary_message": "Juice limes into the bowl with the mint. Add additional curry paste, oil, sugar, and salt; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp Thai curry paste, green\n2 tbsp toasted sesame oil\n2 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 371410,
      "primary_message": "Trim and slice cucumbers into thin rounds. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 371411,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 371412,
      "primary_message": "Roughly chop peanuts and add to the bowl. ",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 371413,
      "primary_message": "Add mixed greens and carrots to the bowl. Toss to combine the salad. ",
      "secondary_message": "1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 371414,
      "primary_message": "To serve, divide salad between plates or bowls and top with shrimp. Enjoy!",
      "secondary_message": null
    }
  ],
