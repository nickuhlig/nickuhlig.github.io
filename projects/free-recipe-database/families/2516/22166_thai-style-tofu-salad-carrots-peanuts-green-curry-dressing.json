  "instructions": [
    {
      "id": 371428,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 371429,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg fresh mint\n2 limes\n1 English cucumber\n2 avocados\n2 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 371430,
      "primary_message": "Place curry paste, oil, and salt in a large bowl; whisk to combine. ",
      "secondary_message": "2 tbsp Thai curry paste, green\n2 tbsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 371431,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 371432,
      "primary_message": "While the skillet heats up, medium dice tofu and add to the bowl with the curry paste. Gently toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 371433,
      "primary_message": "Once the skillet is hot, add tofu and pan-fry, turning occasionally, until browned and crispy, 6-8 minutes. Remove from heat and set aside to cool slightly. ",
      "secondary_message": null
    },
    {
      "id": 371434,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 371435,
      "primary_message": "Juice limes into the bowl with the mint. Add additional curry paste, oil, sugar, and salt; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp Thai curry paste, green\n4 tsp toasted sesame oil\n2 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 371436,
      "primary_message": "Trim and slice cucumber into thin rounds. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 371437,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 371438,
      "primary_message": "Roughly chop peanuts and add to the bowl. ",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 371439,
      "primary_message": "Add mixed greens and carrots to the bowl. Toss to combine the salad. ",
      "secondary_message": "1 (283 g) bag shredded carrots"
    },
    {
      "id": 371440,
      "primary_message": "To serve, divide salad between plates or bowls and top with tofu. Enjoy!",
      "secondary_message": null
    }
  ],
