  "instructions": [
    {
      "id": 371441,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 371442,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg fresh mint\n3 limes\n1 ½ English cucumbers\n3 avocados\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 371443,
      "primary_message": "Place curry paste, oil, and salt in a large bowl; whisk to combine. ",
      "secondary_message": "3 tbsp Thai curry paste, green\n3 tbsp toasted sesame oil\n¾ tsp salt"
    },
    {
      "id": 371444,
      "primary_message": "Medium dice tofu and add to the bowl with the curry paste. Gently toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 371445,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 371446,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add tofu and pan-fry, turning occasionally, until browned and crispy, 6-8 minutes. Transfer to a plate and set aside to cool slightly. ",
      "secondary_message": null
    },
    {
      "id": 371447,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and mince the leaves. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 371448,
      "primary_message": "Juice limes into the bowl with the mint. Add additional curry paste, oil, sugar, and salt; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp Thai curry paste, green\n2 tbsp toasted sesame oil\n1 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 371449,
      "primary_message": "Trim and slice cucumbers into thin rounds. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 371450,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 371451,
      "primary_message": "Roughly chop peanuts and add to the bowl. ",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 371452,
      "primary_message": "Add mixed greens and carrots to the bowl. Toss to combine the salad. ",
      "secondary_message": "1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 371453,
      "primary_message": "To serve, divide salad between plates or bowls and top with tofu. Enjoy!",
      "secondary_message": null
    }
  ],
