  "instructions": [
    {
      "primary_message": "Preheat the oven to 400°F. Spray a rimmed baking sheet with nonstick cooking spray. Place Waterfront Bistro® salmon fillets on the baking sheet. Set aside.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, whisk together the Dijon, honey, lemon zest/juice, salt and pepper. Pour over the salmon, being sure to coat all sides.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, mix to combine the pecans, panko, thyme, garlic powder and butter. Spread evenly over the salmon pieces.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 6-8 minutes until the salmon is cooked through. \n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, cook green beans according to package instructions. \n",
      "secondary_message": null
    },
    {
      "primary_message": "Serve salmon with green beans on the side.\n",
      "secondary_message": null
    }
  ],
