  "instructions": [
    {
      "id": 1,
      "primary_message": "Steep fish in wine and sprinkle salt on top. Let soak in marinade for 8 hours to 1 day, turning fish over once or twice.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Set up pot with steamer insert. Steam fish for 5 to 8 minutes until fish begins to flake. Remove fish from heat and allow to cool, 10 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cover wok with foil on the bottom, taking care that foil snugly fits in the wok. Mix leaves, rice, and sugar at the bottom of the wok. Place steaming rack in the middle of the wok, or use chopsticks to make a grid over tea leaves.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Carefully blot any residual moisture from fish. Place fish directly on rack or chopsticks. Place lid on wok and use overlap of foil to seal shut.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Turn on exhaust fan and open all windows in the house. Over high heat, toast tea and rice until smoky wisps begin to emerge from wok, 3 to 6 minutes. Toast for 5-7 minutes longer, then shut off heat and let fish sit in wok for 5 to 7 minutes longer. The smells will begin to turn smoky - turn off heat before you smell burning. Fish will be golden to dark brown, depending on time and type of tea. Serve room temperature or refrigerate and serve cold. Fish may be kept in refrigerator for about a week.",
      "secondary_message": null
    }
  ],
