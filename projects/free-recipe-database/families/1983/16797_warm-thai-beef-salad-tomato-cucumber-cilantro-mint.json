  "instructions": [
    {
      "id": 307460,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 limes\n1 English cucumber\n2 small pkgs grape tomatoes\n2 medium carrots\n1 small bunch cilantro\n1 small pkg fresh mint\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 307461,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 307462,
      "primary_message": "Juice limes into the bowl with the garlic. Add oil, fish sauce, coconut aminos, sugar, crushed red pepper, and black pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp toasted sesame oil\n4 tsp fish sauce\n2 tsp coconut aminos\n2 tsp brown sugar\n½ tsp crushed red pepper\n½ tsp black pepper"
    },
    {
      "id": 307463,
      "primary_message": "Peel, halve, and thinly slice shallots into half-moons. Add to the bowl with the dressing, toss to combine, and set aside. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 307464,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 307465,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 307466,
      "primary_message": "Once the pan is hot, coat with oil; add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest for 5 minutes. ",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 307467,
      "primary_message": "Meanwhile, trim and halve cucumber lengthwise, then thinly slice crosswise into half-moons; halve tomatoes. Add both to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 307468,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 307469,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 307470,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 307471,
      "primary_message": "Right before serving, thinly slice steak against the grain. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 307472,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
