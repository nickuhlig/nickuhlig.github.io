  "instructions": [
    {
      "id": 307233,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 limes\n1 ½ English cucumbers\n3 pints grape tomatoes\n3 medium carrots\n2 small bunches cilantro\n1 small pkg fresh mint\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 307234,
      "primary_message": "Peel and mince garlic; place in a large bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 307235,
      "primary_message": "Juice limes into the bowl with the garlic. Add oil, sugar, fish sauce, soy sauce, crushed red pepper, and black pepper; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp toasted sesame oil\n2 tbsp brown sugar\n2 tbsp fish sauce\n1 tbsp soy sauce\n¾ tsp crushed red pepper\n¾ tsp black pepper"
    },
    {
      "id": 307236,
      "primary_message": "Peel, halve, and thinly slice onion into half-moons. Add to the bowl with the dressing, toss to combine, and set aside. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 307237,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 307238,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 307239,
      "primary_message": "Once the pan is hot, coat with oil; working in batches if necessary, add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest for 5 minutes. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 307240,
      "primary_message": "Meanwhile, trim and halve cucumbers lengthwise, then thinly slice crosswise into half-moons; halve tomatoes. Add both to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 307241,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 307242,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 307243,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 307244,
      "primary_message": "Right before serving, thinly slice steak against the grain. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 307245,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
