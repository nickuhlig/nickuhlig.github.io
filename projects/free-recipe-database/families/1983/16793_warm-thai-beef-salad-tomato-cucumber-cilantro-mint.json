  "instructions": [
    {
      "id": 307408,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lime\n½ English cucumber\n1 small pkg grape tomatoes\n1 medium carrot\n½ small bunch cilantro\n½ small pkg fresh mint\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 307409,
      "primary_message": "Peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 307410,
      "primary_message": "Juice lime into the bowl with the garlic. Add oil, sugar, fish sauce, soy sauce, crushed red pepper, and black pepper; whisk to combine the dressing. ",
      "secondary_message": "1 tbsp toasted sesame oil\n2 tsp brown sugar\n2 tsp fish sauce\n1 tsp soy sauce\n¼ tsp crushed red pepper\n¼ tsp black pepper"
    },
    {
      "id": 307411,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons. Add to the bowl with the dressing, toss to combine, and set aside. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 307412,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 307413,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 307414,
      "primary_message": "Once the pan is hot, coat with oil; add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest for 5 minutes. ",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 307415,
      "primary_message": "Meanwhile, trim and halve cucumber lengthwise, then thinly slice crosswise into half-moons; halve tomatoes. Add both to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 307416,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 307417,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 307418,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 307419,
      "primary_message": "Right before serving, thinly slice steak against the grain. Add to the bowl with the dressing, along with mixed greens, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 307420,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
