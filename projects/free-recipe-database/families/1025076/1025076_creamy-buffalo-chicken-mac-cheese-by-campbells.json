  "instructions": [
    {
      "primary_message": "Cook and drain the pasta according to the package directions. While the pasta is cooking, heat the oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Stir the soup, milk, chicken, 1 1/2 cups cheese and the cooked pasta in a bowl. Spoon the mixture into an 11 x 7 x 2-inch baking dish.",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 10 minutes. Stir the pasta mixture. Sprinkle with the remaining 1/2-cup cheese and bake another 5 minutes or until the cheese is melted.  Sprinkle with the green onions before serving.",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: You can also drizzle with 1/4-cup blue cheese dressing before serving, if desired.",
      "secondary_message": null
    }
  ],
