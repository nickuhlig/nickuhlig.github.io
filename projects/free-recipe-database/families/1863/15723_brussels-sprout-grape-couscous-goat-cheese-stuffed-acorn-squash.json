  "instructions": [
    {
      "id": 291266,
      "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 291267,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 acorn squash\n1 lb Brussels sprouts\n1 lb red grapes\n1 lemon"
    },
    {
      "id": 291268,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange the squash halves cut-side down on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 291269,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 291270,
      "primary_message": "While the squash is cooking, place couscous in a large bowl.",
      "secondary_message": "1 cup whole wheat couscous"
    },
    {
      "id": 291271,
      "primary_message": "Pour broth into a large skillet, cover, and bring to a boil over high heat. Remove from heat, pour into the bowl with the couscous, and stir (reserve skillet for later use). Tightly cover the bowl with foil and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 291272,
      "primary_message": "Meanwhile, trim and halve Brussels sprouts; place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 291273,
      "primary_message": "Peel, halve, and thinly slice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 291274,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 291275,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and spices; cook, stirring often, until starting to soften, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp thyme, dried\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 291276,
      "primary_message": "Add Brussels sprouts and water to the skillet; cover with a lid and cook until the sprouts are fork-tender, 4-5 minutes.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 291277,
      "primary_message": "Meanwhile, halve grapes.",
      "secondary_message": null
    },
    {
      "id": 291278,
      "primary_message": "When the sprouts are ready, juice lemon into the skillet and add grapes. Continue to cook, uncovered, until most of the liquid has evaporated and grapes are soft, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 291279,
      "primary_message": "Add veggie-grape mixture and pumpkin seeds to the bowl with the couscous; stir to combine the stuffing.",
      "secondary_message": "¼ cup pumpkin seeds"
    },
    {
      "id": 291280,
      "primary_message": "To serve, divide squash halves between plates and fill with the veggie-couscous stuffing. Crumble goat cheese over top and enjoy!",
      "secondary_message": "2 (4 oz) logs goat cheese"
    }
  ],
