  "instructions": [
    {
      "id": 291281,
      "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 291282,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 acorn squash\n1 ½ lb Brussels sprouts\n1 ½ lb red grapes\n1 ½ lemons"
    },
    {
      "id": 291283,
      "primary_message": "Halve each acorn squash lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil and season with salt and pepper. Arrange the squash halves cut-side down on the baking sheet.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 291284,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 291285,
      "primary_message": "While the squash is cooking, place couscous in a large bowl.",
      "secondary_message": "1 ½ cups whole wheat couscous"
    },
    {
      "id": 291286,
      "primary_message": "Pour broth into a large pot, cover, and bring to a boil over high heat. Remove from heat, pour into the bowl with the couscous, and stir (reserve pot for later use). Tightly cover the bowl with foil and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 291287,
      "primary_message": "Meanwhile, trim and halve Brussels sprouts; place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 291288,
      "primary_message": "Peel, halve, and thinly slice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 291289,
      "primary_message": "Return the pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 291290,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and spices; cook, stirring often, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 291291,
      "primary_message": "Add Brussels sprouts and water to the pot; cover with a lid and cook until the sprouts are fork-tender, 5-6 minutes.",
      "secondary_message": "¾ cup water"
    },
    {
      "id": 291292,
      "primary_message": "Meanwhile, halve grapes.",
      "secondary_message": null
    },
    {
      "id": 291293,
      "primary_message": "When the sprouts are ready, juice lemons into the pot and add grapes. Continue to cook, uncovered, until most of the liquid has evaporated and grapes are soft, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 291294,
      "primary_message": "Add veggie-grape mixture and pumpkin seeds to the bowl with the couscous; stir to combine the stuffing.",
      "secondary_message": "⅓ cup pumpkin seeds"
    },
    {
      "id": 291295,
      "primary_message": "To serve, divide squash halves between plates and fill with the veggie-couscous stuffing. Crumble goat cheese over top and enjoy!",
      "secondary_message": "3 (4 oz) logs goat cheese"
    }
  ],
