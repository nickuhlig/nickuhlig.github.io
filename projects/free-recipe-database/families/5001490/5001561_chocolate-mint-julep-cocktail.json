  "instructions": [
    {
      "id": 1,
      "primary_message": "In a julep cup or large rocks glass, gently muddle mint leaves until lightly bruised, then swab the glass's sides with the mint's aromatic oils. Add crème de cacao and bourbon or rye and stir well. Half-fill glass with crushed ice and stir to combine. Fill glass completely with crushed ice and stir until outside of glass frosts. Add more crushed ice, heaping generously, then garnish with sprigs of fresh mint. Serve, adding a short straw if desired so that the fragrance of the mint bouquet will greet the drinker with each sip.",
      "secondary_message": null
    }
  ],
