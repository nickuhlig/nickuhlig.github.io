  "instructions": [
    {
      "id": 1,
      "primary_message": "Using a fork or paring knife, lightly prick each potato all over several times. Rub each potato with oil. Sprinkle evenly with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place potatoes in air fryer basket, spaced evenly apart. Place basket in air fryer and cook at 205°C until the potato skin is crispy and a paring knife inserted into the center of the potatoes meets little to no resistance, about 45 minutes. (Center of potatoes should register between 205 to 99°C [96 to 99°C] with an instant-read thermometer.)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer potatoes to a plate and let rest for 5 minutes. Slice each open lengthwise and scoop flesh into a mixing bowl. Add butter, season with salt and pepper, and roughly mash, just until butter is incorporated but potatoes are still chunky.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Scoop mashed potatoes back into skins. (You can refill each skin, making 2 potatoes, or use all the mashed potato to refill only one skin, making 1 overstuffed potato.) Using your hands, reshape each stuffed potato back into a classic baked potato shape.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add toppings of your choice. To melt cheese, add it first, then return potatoes to the air fryer set at 205°C (400°F) oven until cheese melts, about 30 seconds to 1 minute; alternatively, use a torch to melt cheese. Serve right away.",
      "secondary_message": null
    }
  ],
