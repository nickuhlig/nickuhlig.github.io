  "instructions": [
    {
      "id": 615226,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 615227,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap), cover, and bring to a boil over high heat. Once boiling, remove from heat and add rice noodles. Soak for 10 minutes (or prepare according to package instructions). Drain in a colander and rinse under cold water to cool; set aside.",
      "secondary_message": "5 oz flat rice (pad thai) noodles"
    },
    {
      "id": 615228,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 medium carrot\n½ English cucumber\n1 red bell pepper"
    },
    {
      "id": 615229,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place white and pale green parts in a small bowl. Place remaining (dark green) onion on a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 615230,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 615231,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the green onions.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 615232,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onions and garlic; cook, stirring frequently, until onion is golden and crisp, 2-3 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 615233,
      "primary_message": "Add crushed red pepper, sesame seeds, sugar, and salt to the skillet. Continue to cook, stirring frequently, until fragrant, about 1 minute. Transfer to the reserved bowl, along with soy sauce and vinegar, then stir to combine the chili crunch. Set aside. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp crushed red pepper\n1 tsp sesame seeds\n½ tsp brown sugar\n¼ tsp salt\n1 tsp soy sauce\n1 tsp rice vinegar"
    },
    {
      "id": 615234,
      "primary_message": "Medium dice tofu. Place in a medium bowl, then sprinkle with cornstarch, salt, and pepper. Gently toss to coat.",
      "secondary_message": "1 tbsp cornstarch\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 615235,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add tofu and cook, turning occasionally, until browned and crispy, 5-7 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 615236,
      "primary_message": "Meanwhile, peel and trim carrot; using a julienne (or regular) peeler, peel the carrot into noodle-like strips. Add to the plate with the reserved green onions.",
      "secondary_message": null
    },
    {
      "id": 615237,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 615238,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 615239,
      "primary_message": "To serve, divide noodles, tofu, and veggies between bowls. Top with reserved green onions and drizzle with chili crunch. Enjoy!",
      "secondary_message": null
    }
  ],
