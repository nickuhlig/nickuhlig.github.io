  "instructions": [
    {
      "id": 615254,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 615255,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat. Once boiling, remove from heat and add rice noodles. Soak for 10 minutes (or prepare according to package instructions). Drain in a colander and rinse under cold water to cool; set aside.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 615256,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches green onions (scallions)\n3 medium carrots\n1 ½ English cucumbers\n3 red bell peppers"
    },
    {
      "id": 615257,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place white and pale green parts in a small bowl. Place remaining (dark green) onion on a plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 615258,
      "primary_message": "Peel and mince garlic. Add to the bowl with the green onions.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 615259,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 615260,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onions and garlic; cook, stirring frequently, until onion is golden and crisp, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "⅓ cup neutral vegetable oil"
    },
    {
      "id": 615261,
      "primary_message": "Add crushed red pepper, sesame seeds, sugar, and salt to the skillet. Continue to cook, stirring frequently, until fragrant, about 2 minutes. Transfer to the reserved bowl, along with soy sauce and vinegar, then stir to combine the chili crunch. Set aside. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp crushed red pepper\n1 tbsp sesame seeds\n1 ½ tsp brown sugar\n¾ tsp salt\n1 tbsp soy sauce\n1 tbsp rice vinegar"
    },
    {
      "id": 615262,
      "primary_message": "Medium dice tofu. Place in a large bowl, then sprinkle with cornstarch, salt, and pepper. Gently toss to coat.",
      "secondary_message": "3 tbsp cornstarch\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 615263,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, turning occasionally, until browned and crispy, 5-7 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 615264,
      "primary_message": "Meanwhile, peel and trim carrots; using a julienne (or regular) peeler, peel the carrots into noodle-like strips. Add to the plate with the reserved green onions.",
      "secondary_message": null
    },
    {
      "id": 615265,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 615266,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 615267,
      "primary_message": "To serve, divide noodles, tofu, and veggies between bowls. Top with reserved green onions and drizzle with chili crunch. Enjoy!",
      "secondary_message": null
    }
  ],
