  "instructions": [
    {
      "id": 356578,
      "primary_message": "Preheat oven to 450°F. Coat a large baking dish with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 356579,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 ½ lb sweet potatoes\n2 medium carrots\n2 Granny Smith apples"
    },
    {
      "id": 356580,
      "primary_message": "Peel and mince garlic and ginger; transfer both to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 356581,
      "primary_message": "Trim and mince green onions; transfer half to the bowl with the garlic (set remaining green onions aside for the slaw).",
      "secondary_message": null
    },
    {
      "id": 356582,
      "primary_message": "Add ground turkey, soy sauce, chili-garlic sauce, sugar, salt, and pepper to the bowl. Mix with your hands until well combined.",
      "secondary_message": "1 ½ lb ground turkey\n2 tsp soy sauce\n2 tsp chili-garlic sauce\n2 tsp brown sugar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356583,
      "primary_message": "Using a scant ¼-cup measure, form the turkey mixture into meatballs and place in the baking dish. Place in the oven (it doesn't have to be fully heated) and bake until meatballs are cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 356584,
      "primary_message": "Meanwhile, peel and medium dice the sweet potatoes. Transfer to a large pot, cover with hot water (from the tap), and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356585,
      "primary_message": "Once the liquid in the pot is simmering, reduce heat to medium, cover, and cook until the potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 356586,
      "primary_message": "While the potatoes are cooking, place oil, vinegar, Dijon, salt, and pepper in a clean medium bowl; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 356587,
      "primary_message": "Trim, peel, and grate carrots; transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 356588,
      "primary_message": "Quarter, core, and coarsely grate apples; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 356589,
      "primary_message": "Add reserved green onions to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 356590,
      "primary_message": "When the potatoes are done, remove from heat, and drain in a colander. Return to the pot and add butter, maple syrup, salt, and pepper; mash with a potato masher until smooth.",
      "secondary_message": "2 tbsp butter, unsalted\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 356591,
      "primary_message": "To serve, divide sweet potato mash, meatballs, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
