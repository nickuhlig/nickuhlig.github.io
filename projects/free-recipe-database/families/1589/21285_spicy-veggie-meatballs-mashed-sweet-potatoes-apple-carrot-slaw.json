  "instructions": [
    {
      "id": 356632,
      "primary_message": "Preheat oven to 450°F. Coat a large baking dish with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 356633,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n2 ¼ lb sweet potatoes\n3 medium carrots\n3 Granny Smith apples"
    },
    {
      "id": 356634,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 356635,
      "primary_message": "Trim and mince green onions; add half to the bowl with the garlic (set remaining green onions aside for the slaw).",
      "secondary_message": null
    },
    {
      "id": 356636,
      "primary_message": "Add veggie ground, soy sauce, chili-garlic sauce, sugar, salt, and pepper to the bowl. Mix with your hands until well combined.",
      "secondary_message": "24 oz veggie ground, plant based\n1 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 356637,
      "primary_message": "Using a scant ¼-cup measure, form the veggie ground mixture into \"meatballs\" and arrange in the baking dish. Place in the oven (it doesn't have to be fully heated) and bake until meatballs are cooked through, about 18 minutes.",
      "secondary_message": null
    },
    {
      "id": 356638,
      "primary_message": "Meanwhile, peel and medium dice sweet potatoes. Place in a large pot, cover with hot water (from the tap), and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356639,
      "primary_message": "Once the liquid in the pot is simmering, reduce heat to medium, cover, and cook until the potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 356640,
      "primary_message": "While the potatoes are cooking, place oil, vinegar, Dijon, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 ½ tsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356641,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 356642,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl, along with reserved green onions, and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 356643,
      "primary_message": "When the potatoes are done, remove from heat and drain in a colander. Return to the pot and add oil, maple syrup, salt, and pepper. Mash with a potato masher until smooth.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356644,
      "primary_message": "To serve, divide sweet potato mash, meatballs, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
