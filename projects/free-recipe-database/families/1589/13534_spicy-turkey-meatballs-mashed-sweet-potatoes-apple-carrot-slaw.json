  "instructions": [
    {
      "id": 356564,
      "primary_message": "Preheat oven to 450°F. Coat a baking dish with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 356565,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)\n¾ lb sweet potato\n1 medium carrot\n1 Granny Smith apple"
    },
    {
      "id": 356566,
      "primary_message": "Peel and mince garlic and ginger; transfer both to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 356567,
      "primary_message": "Trim and mince green onions; transfer half to the bowl with the garlic (set remaining green onions aside for the slaw).",
      "secondary_message": null
    },
    {
      "id": 356568,
      "primary_message": "Add ground turkey, soy sauce, chili-garlic sauce, sugar, salt, and pepper to the bowl. Mix with your hands until well combined.",
      "secondary_message": "¾ lb ground turkey\n1 tsp soy sauce\n1 tsp chili-garlic sauce\n1 tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 356569,
      "primary_message": "Using a scant ¼-cup measure, form the turkey mixture into meatballs and place in the baking dish. Place in the oven (it doesn't have to be fully heated) and bake until meatballs are cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 356570,
      "primary_message": "Meanwhile, peel and medium dice the sweet potatoes. Transfer to a medium saucepan, cover with hot water (from the tap), and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356571,
      "primary_message": "Once the liquid in the saucepan is simmering, reduce heat to medium, cover, and cook until the potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 356572,
      "primary_message": "While the potatoes are cooking, place oil, vinegar, Dijon, salt, and pepper in a clean medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp apple cider vinegar\n½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 356573,
      "primary_message": "Trim, peel, and grate carrot; transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 356574,
      "primary_message": "Quarter, core, and coarsely grate apple; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 356575,
      "primary_message": "Add reserved green onions to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 356576,
      "primary_message": "When the potatoes are done, remove from heat, and drain in a colander. Return to the pan and add butter, maple syrup, salt, and pepper; mash with a potato masher until smooth.",
      "secondary_message": "1 tbsp butter, unsalted\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 356577,
      "primary_message": "To serve, divide sweet potato mash, meatballs, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
