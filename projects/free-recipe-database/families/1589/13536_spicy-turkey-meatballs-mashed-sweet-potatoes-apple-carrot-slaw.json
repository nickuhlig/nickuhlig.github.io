  "instructions": [
    {
      "id": 356592,
      "primary_message": "Preheat oven to 450°F. Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 356593,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n2 ¼ lb sweet potatoes\n3 medium carrots\n3 Granny Smith apples"
    },
    {
      "id": 356594,
      "primary_message": "Peel and mince garlic and ginger; transfer both to a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 356595,
      "primary_message": "Trim and mince green onions; transfer half to the bowl with the garlic (set remaining green onions aside for the slaw).",
      "secondary_message": null
    },
    {
      "id": 356596,
      "primary_message": "Add ground turkey, soy sauce, chili-garlic sauce, sugar, salt, and pepper to the bowl. Mix with your hands until well combined.",
      "secondary_message": "2 ¼ lb ground turkey\n1 tbsp soy sauce\n1 tbsp chili-garlic sauce\n1 tbsp brown sugar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 356597,
      "primary_message": "Using a scant ¼-cup measure, form the turkey mixture into meatballs and place on the baking sheet. Place in the oven (it doesn't have to be fully heated) and bake until meatballs are cooked through, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 356598,
      "primary_message": "Meanwhile, peel and medium dice the sweet potatoes. Transfer to a large pot, cover with hot water (from the tap), and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356599,
      "primary_message": "Once the liquid in the pot is simmering, reduce heat to medium, cover, and cook until the potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 356600,
      "primary_message": "While the potatoes are cooking, place oil, vinegar, Dijon, salt, and pepper in a clean large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 ½ tsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356601,
      "primary_message": "Trim, peel, and grate carrots; transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 356602,
      "primary_message": "Quarter, core, and coarsely grate apples; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 356603,
      "primary_message": "Add reserved green onions to the bowl and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 356604,
      "primary_message": "When the potatoes are done, remove from heat, and drain in a colander. Return to the pot and add butter, maple syrup, salt, and pepper; mash with a potato masher until smooth.",
      "secondary_message": "3 tbsp butter, unsalted\n1 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356605,
      "primary_message": "To serve, divide sweet potato mash, meatballs, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
