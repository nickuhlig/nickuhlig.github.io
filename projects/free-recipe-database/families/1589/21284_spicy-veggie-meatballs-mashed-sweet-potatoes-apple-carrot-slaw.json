  "instructions": [
    {
      "id": 356619,
      "primary_message": "Preheat oven to 450°F. Coat a baking dish with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 356620,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 ½ lb sweet potatoes\n2 medium carrots\n2 Granny Smith apples"
    },
    {
      "id": 356621,
      "primary_message": "Peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 356622,
      "primary_message": "Trim and mince green onions; add half to the bowl with the garlic (set remaining green onions aside for the slaw).",
      "secondary_message": null
    },
    {
      "id": 356623,
      "primary_message": "Add veggie ground, soy sauce, chili-garlic sauce, sugar, salt, and pepper to the bowl. Mix with your hands until well combined.",
      "secondary_message": "16 oz veggie ground, plant based\n2 tsp soy sauce\n2 tsp chili-garlic sauce\n2 tsp brown sugar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356624,
      "primary_message": "Using a scant ¼-cup measure, form the veggie ground mixture into \"meatballs\" and arrange in the baking dish. Place in the oven (it doesn't have to be fully heated) and bake until meatballs are cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 356625,
      "primary_message": "Meanwhile, peel and medium dice sweet potatoes. Place in a medium saucepan, cover with hot water (from the tap), and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356626,
      "primary_message": "Once the liquid in the pan is simmering, reduce heat to medium, cover, and cook until the potatoes are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 356627,
      "primary_message": "While the potatoes are cooking, place oil, vinegar, Dijon, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 356628,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 356629,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl, along with reserved green onions, and toss to combine the slaw.",
      "secondary_message": null
    },
    {
      "id": 356630,
      "primary_message": "When the potatoes are done, remove from heat and drain in a colander. Return to the pan and add oil, maple syrup, salt, and pepper. Mash with a potato masher until smooth.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 356631,
      "primary_message": "To serve, divide sweet potato mash, meatballs, and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
