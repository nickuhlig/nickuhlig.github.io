  "instructions": [
    {
      "id": 382038,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz penne pasta"
    },
    {
      "id": 382039,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382040,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 382041,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, broccoli, salt, and pepper; cook, stirring occasionally, until veggies start to soften, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 (18 oz) bag broccoli florets\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 382042,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans kidney beans"
    },
    {
      "id": 382043,
      "primary_message": "When the veggies are soft, add beans and Alfredo sauce to the skillet. Stir to combine and continue to cook until heated through, 1-2 minutes more. Cover and remove from heat.",
      "secondary_message": "1 (16 oz) jar Alfredo sauce"
    },
    {
      "id": 382044,
      "primary_message": "When the pasta is done, drain in a colander. Add to the skillet with the sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 382045,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
