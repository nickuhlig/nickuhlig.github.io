  "instructions": [
    {
      "id": 382118,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g penne pasta"
    },
    {
      "id": 382119,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 382120,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 382121,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, broccoli, salt, and pepper; cook, stirring occasionally, until veggies start to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ (510 g) bags broccoli florets\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 382122,
      "primary_message": "Meanwhile, medium dice ham.",
      "secondary_message": "680 g ham steak, boneless"
    },
    {
      "id": 382123,
      "primary_message": "When the veggies are soft, add ham and Alfredo sauce to the pot. Stir to combine and continue to cook until heated through, 2-3 minutes more. Cover and remove from heat.",
      "secondary_message": "1 ½ (454 g) jars Alfredo sauce"
    },
    {
      "id": 382124,
      "primary_message": "When the pasta is done, drain in a colander. Add to the pot with the sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 382125,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
