  "instructions": [
    {
      "id": 543189,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ small pkgs grape tomatoes\n1 small bunch cilantro\n1 ½ heads romaine lettuce\n1 small bunch green onions (scallions)\n1 ½ limes"
    },
    {
      "id": 543190,
      "primary_message": "Trim, seed, and roughly chop bell peppers. Roughly chop grape tomatoes. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 543191,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the bell peppers and tomatoes.",
      "secondary_message": null
    },
    {
      "id": 543192,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 543193,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 543194,
      "primary_message": "While the skillet heats up, drain and rinse beans in a colander.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 543195,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans and spices; cook, stirring occasionally, until beans are tender and warmed through, 7-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp chili powder\n1 ½ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 543196,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. ",
      "secondary_message": null
    },
    {
      "id": 543197,
      "primary_message": "When the beans are done, transfer to another large bowl and crush with a potato masher to create a semi-smooth mixture. (Wipe the skillet clean with paper towels and set aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 543198,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the crushed beans, along with half of the green onions and yogurt. Stir to combine the filling and set aside. (Reserve remaining green onions for serving.)",
      "secondary_message": "¾ (227 g) block cheddar cheese\n⅓ cup plain Greek yogurt"
    },
    {
      "id": 543199,
      "primary_message": "Return the skillet to medium-high heat. Working in batches, add tortillas and cook, flipping once, until softened, 2-3 minutes. Remove to a flat surface.",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 543200,
      "primary_message": "Meanwhile, preheat oven to broil on high. Coat a large baking sheet pan with a thin layer of oil. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 543201,
      "primary_message": "Divide the bean mixture between softened tortillas. Tightly roll tortillas to close, then arrange taquitos, seam-side down, on the baking sheet. Drizzle with oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 543202,
      "primary_message": "Place baking sheet in the oven and broil, using tongs to turn taquitos halfway through, until golden and crispy on the edges, 5-6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 543203,
      "primary_message": "Meanwhile, juice limes into a small bowl. Add yogurt and spices, then whisk to combine the dressing. Transfer half to the bowl with the lettuce and toss to combine the salad. (Reserve remaining dressing for serving.)",
      "secondary_message": "⅓ cup plain Greek yogurt\n¾ tsp chili powder\n¾ tsp garlic powder\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 543204,
      "primary_message": "To serve, divide taquitos and salad between plates. Drizzle taquitos with reserved dressing and sprinkle with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
