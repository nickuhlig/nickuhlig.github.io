  "instructions": [
    {
      "id": 438894,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 438895,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season both sides with salt and pepper.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 438896,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork chops and pan-fry until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 438897,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 438898,
      "primary_message": "Wash, dry, peel, and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Add to the bowl with the dressing.",
      "secondary_message": "2 medium carrots"
    },
    {
      "id": 438899,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl.",
      "secondary_message": "1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 438900,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with the blue cheese, and toss to combine the salad.",
      "secondary_message": "¼ cup pistachios, unsalted\n½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 438901,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 438902,
      "primary_message": "To serve, divide salad between plates or bowls. Top with pork and enjoy!",
      "secondary_message": null
    }
  ],
