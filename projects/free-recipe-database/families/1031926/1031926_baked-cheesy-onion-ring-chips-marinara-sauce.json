  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Line two baking sheet pans with parchment paper. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and slice onions crosswise into 1/8-inch thick slices. (Alternatively, use a mandoline.)\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Sprinkle cheese over the baking sheets, spreading it out in an even layer. Top with onion slices in a single layer, then drizzle with oil and season with spices. \n\n",
      "secondary_message": "2 cups mozzarella cheese, shredded\n3 tbsp extra virgin olive oil\n½ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheets in the preheated oven and bake until cheese is golden and onions are tender, about 30 minutes. Remove from oven and allow to cool slightly (keep the oven on).\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the onions are cool enough to handle, break or cut off the crispier chips using a knife (or scissors). Transfer to a cooling rack (they will firm up as they cool). Return any softer onion chips to the oven and continue to bake until crisp, 5-10 minutes more.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the onion chips are done, warm marinara sauce in a small saucepan or microwave.\n\n",
      "secondary_message": "1 cup marinara sauce"
    },
    {
      "primary_message": "Transfer onion chips to a platter and serve with warm marinara sauce for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
