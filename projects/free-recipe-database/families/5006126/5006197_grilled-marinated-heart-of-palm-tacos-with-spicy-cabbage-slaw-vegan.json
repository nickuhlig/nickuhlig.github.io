  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lime. Mince the garlic. Pick the thyme leaves from the stems and mince them.",
      "secondary_message": "½ lime\n1 medium clove garlic\n1 tsp fresh thyme"
    },
    {
      "id": 1,
      "primary_message": "Combine lime juice, garlic, thyme, and olive oil in a small bowl and stir with a fork. Season to taste with salt and pepper. Carefully dry drained hearts of palm with paper towels, transfer them to a plate, and pour marinade on top of them. Rub with hands to coat every surface. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using a paper towel, rub grill pan with oil. Preheat over high heat until smoking. Add hearts of palm and cook, turning occasionally, until tender and deep grill marks have appeared on all sides, about 12 minutes total. Alternatively grill hearts of palm on a charcoal or gas grill over medium-high heat.Transfer to a plate and keep warm.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Return grill pan to high heat. Stack 2 tortillas and dip them into a bowl of water. Add them to the grill pan and grill until charred on first side, about 1 minute. Carefully flip and cook until second side is charred, about 1 minute longer. Transfer to a clean dish towel and fold the towel over to keep warm. Repeat with remaining 10 tortillas, cooking them in stacks of two at a time.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Slice the hearts of palm and serve with warm tortillas, salsa verde, onions, cilantro, Spicy Cabbage Slaw, avocado, and lime wedges. Serve Spicy Vegan Refried Beans on the side, if desired.",
      "secondary_message": null
    }
  ],
