  "instructions": [
    {
      "id": 437499,
      "primary_message": "Place water and salt in a large pot, cover, and bring to a boil over high heat.",
      "secondary_message": "42 fl oz (5 ¼ cups) water\n3 pinch salt"
    },
    {
      "id": 437500,
      "primary_message": "Once boiling, stir in oats, honey, and nutmeg. Cover and let simmer on low until oats reach desired consistency, 3-5 minutes.",
      "secondary_message": "3 cup oats, quick cooking\n1 tbsp honey\n¾ tsp nutmeg, ground"
    },
    {
      "id": 437501,
      "primary_message": "Meanwhile, place yogurt and additional honey in a small bowl. Stir to combine and set aside.",
      "secondary_message": "2 cups plain Greek yogurt\n3 tbsp honey"
    },
    {
      "id": 437502,
      "primary_message": "Place cherries in a colander and rinse under hot water (from the tap) to thaw. Roughly chop.",
      "secondary_message": "3 cup frozen cherries"
    },
    {
      "id": 437503,
      "primary_message": "When the oatmeal is done, add cherries to the pot and stir to combine. Continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 437504,
      "primary_message": "To serve, divide oatmeal between bowls and top with honey yogurt. Enjoy!",
      "secondary_message": null
    }
  ],
