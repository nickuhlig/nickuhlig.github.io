  "instructions": [
    {
      "id": 1,
      "primary_message": "Place grapefruit and lemon zest in a sealable glass jar with the vodka. Seal and shake, then let the mixture steep overnight in a cool, dark place.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the rum, lavender, coriander, juniper, sage and gentian root. Seal and shake, then let this combined mixture steep for 10 to 12 days in a cool, dark place.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Strain through a cheesecloth-lined fine-mesh strainer. Then bottle by filtering through a coffee filter. Add simple syrup to the bottle. Seal and shake, then let rest for 1 day. Store at room temperature for up to a year.",
      "secondary_message": null
    }
  ],
