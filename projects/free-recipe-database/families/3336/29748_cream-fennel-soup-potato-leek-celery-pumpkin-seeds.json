  "instructions": [
    {
      "id": 474044,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 leeks\n6 fennel bulbs\n6 sticks celery\n3 medium red potatoes"
    },
    {
      "id": 474045,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 474046,
      "primary_message": "Trim off root end and dark green stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise and medium dice. Add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 474047,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 474048,
      "primary_message": "While the pot heats up, trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 474049,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 474050,
      "primary_message": "Meanwhile, peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "id": 474051,
      "primary_message": "When the veggies are soft, add potato and broth to the pot. Stir to combine and bring to a boil over high heat. Once the soup is boiling, reduce heat and simmer until potatoes are tender, 12-15 minutes.",
      "secondary_message": "2839 ml chicken or vegetable broth"
    },
    {
      "id": 474052,
      "primary_message": "When the potatoes are tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
      "secondary_message": null
    },
    {
      "id": 474053,
      "primary_message": "Add cream to the pot and continue to cook, stirring occasionally, until just warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "532 ml heavy whipping cream"
    },
    {
      "id": 474054,
      "primary_message": "To serve, divide soup between bowls. Top with pumpkin seeds and enjoy!",
      "secondary_message": "⅓ cup pumpkin seeds"
    }
  ],
