  "instructions": [
    {
      "id": 474022,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n2 fennel bulbs\n2 sticks celery\n1 medium red potato"
    },
    {
      "id": 474023,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 474024,
      "primary_message": "Trim off root end and dark green stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise and medium dice. Add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 474025,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 474026,
      "primary_message": "While the pan heats up, trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 474027,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 474028,
      "primary_message": "Meanwhile, peel and small dice potato.",
      "secondary_message": null
    },
    {
      "id": 474029,
      "primary_message": "When the veggies are soft, add potato and broth to the pan. Stir to combine and bring to a boil over high heat. Once the soup is boiling, reduce heat and simmer until potatoes are tender, 12-15 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 474030,
      "primary_message": "When the potatoes are tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": null
    },
    {
      "id": 474031,
      "primary_message": "Add cream to the pan and continue to cook, stirring occasionally, until just warmed through, 1 minute more. Remove from heat.",
      "secondary_message": "177 ml heavy whipping cream"
    },
    {
      "id": 474032,
      "primary_message": "To serve, divide soup between bowls. Top with pumpkin seeds and enjoy!",
      "secondary_message": "⅛ cup pumpkin seeds"
    }
  ],
