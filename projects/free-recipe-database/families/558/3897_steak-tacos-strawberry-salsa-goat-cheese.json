  "instructions": [
    {
      "id": 43288,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (454 g) pkg strawberries\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
    },
    {
      "id": 43289,
      "primary_message": "Trim off and discard the stem ends of the strawberries; small dice the strawberries and transfer to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43290,
      "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43291,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43292,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43293,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 43294,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 43295,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest.",
      "secondary_message": null
    },
    {
      "id": 43296,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and add to the salad bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 43297,
      "primary_message": "Juice one lime and add to the salad bowl; cut the other lime into wedges for serving and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 43298,
      "primary_message": "Season the salsa with salt and pepper; toss to combine.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43299,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "16 small corn tortillas"
    },
    {
      "id": 43300,
      "primary_message": "Thinly slice the steak against the grain into strips.",
      "secondary_message": null
    },
    {
      "id": 43301,
      "primary_message": "To serve, divide the steak slices between the tortillas, top with the salsa, and crumble the goat cheese overtop. Serve with lime wedges. Enjoy!",
      "secondary_message": "1 (113 g) log goat cheese"
    }
  ],
