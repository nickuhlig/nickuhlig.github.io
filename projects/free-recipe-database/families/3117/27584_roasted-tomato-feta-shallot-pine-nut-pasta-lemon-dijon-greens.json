  "instructions": [
    {
      "id": 443215,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 443216,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n2 pints grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 443217,
      "primary_message": "Peel, halve, and slice shallots crosswise into ¼-inch thick half-moons. Place in a baking dish.",
      "secondary_message": "4 shallots"
    },
    {
      "id": 443218,
      "primary_message": "Zest lemon into the dish with the shallots, then add tomatoes, feta, and pine nuts. Drizzle with oil and season with spices. Stir to combine and spread out in an even layer. (Reserve lemon for later use.)",
      "secondary_message": "2 (4 oz) pkgs crumbled feta cheese\n¼ cup pine nuts\n2 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 443219,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until tomatoes are bursting and shallots are soft, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 443220,
      "primary_message": "Meanwhile, juice reserved lemon into a medium bowl. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 443221,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander, return to the pot, and cover to keep warm.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 443222,
      "primary_message": "When the tomatoes and shallots are done, remove from oven. Add to the pot with the cooked pasta and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 443223,
      "primary_message": "Add mixed greens and alfalfa sprouts to the bowl with the dressing, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 443224,
      "primary_message": "To serve, divide pasta and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
