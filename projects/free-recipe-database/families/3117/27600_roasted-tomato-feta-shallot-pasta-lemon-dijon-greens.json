  "instructions": [
    {
      "id": 443375,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 443376,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 small pkgs grape tomatoes\n1 ½ (142 g) pkgs spring mix (mixed greens)\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 443377,
      "primary_message": "Peel, halve, and slice shallots crosswise into ¼-inch thick half-moons. Place in a large baking dish.",
      "secondary_message": "6 shallots"
    },
    {
      "id": 443378,
      "primary_message": "Zest lemons into the dish with the shallots, then add tomatoes and feta. Drizzle with oil and season with spices. Stir to combine and spread out in an even layer. (Reserve lemons for later use.)",
      "secondary_message": "3 (113 g) pkgs crumbled feta cheese\n3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 443379,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until tomatoes are bursting and shallots are soft, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 443380,
      "primary_message": "Meanwhile, juice reserved lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 443381,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander, return to the pot, and cover to keep warm.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 443382,
      "primary_message": "When the tomatoes and shallots are done, remove from oven. Add to the pot with the cooked pasta and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 443383,
      "primary_message": "Add mixed greens and alfalfa sprouts to the bowl with the dressing, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 443384,
      "primary_message": "To serve, divide pasta and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
