  "instructions": [
    {
      "id": 443325,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 443326,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lemon\n1 small pkg grape tomatoes\n½ (142 g) pkg spring mix (mixed greens)\n½ (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 443327,
      "primary_message": "Peel, halve, and slice shallots crosswise into ¼-inch thick half-moons. Place in a small baking dish.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 443328,
      "primary_message": "Zest lemon into the dish with the shallots, then add tomatoes, feta, and pine nuts. Drizzle with oil and season with spices. Stir to combine and spread out in an even layer. (Reserve lemon for later use.)",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n⅛ cup pine nuts\n1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 443329,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until tomatoes are bursting and shallots are soft, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 443330,
      "primary_message": "Meanwhile, juice reserved lemon into a medium bowl. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 443331,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain in a colander, return to the pan, and cover to keep warm.",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 443332,
      "primary_message": "When the tomatoes and shallots are done, remove from oven. Add to the pan with the cooked pasta and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 443333,
      "primary_message": "Add mixed greens and alfalfa sprouts to the bowl with the dressing, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 443334,
      "primary_message": "To serve, divide pasta and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
