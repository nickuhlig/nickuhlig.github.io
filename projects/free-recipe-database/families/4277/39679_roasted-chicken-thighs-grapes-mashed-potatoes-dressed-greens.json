  "instructions": [
    {
      "id": 615704,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 615705,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium yellow potatoes\n1 small pkg fresh rosemary\n1 lb red grapes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 615706,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 615707,
      "primary_message": "Meanwhile, preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 615708,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 615709,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook until golden, about 2 minutes per side (the chicken will not be cooked all the way through). Remove to a plate (reserve skillet with cooking juices for later use).",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 615710,
      "primary_message": "Meanwhile, peel, halve, and slice shallots lengthwise into thin strips. Place in a small bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 615711,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Add to the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 615712,
      "primary_message": "Place shallot, rosemary, and grapes in the reserved skillet and stir to combine. Add chicken, nestling it into the grapes. Place skillet in the oven and roast until chicken is cooked through and grapes are softened, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 615713,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a medium bowl along with oil, vinegar, Dijon, sugar, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n4 tsp balsamic vinegar\n1 tsp Dijon mustard\n1 tsp brown sugar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 615714,
      "primary_message": "When the potatoes are tender, drain in a colander and return to the pot; add milk, salt, and pepper. Using a potato masher, mash until smooth. Cover to keep warm and set aside.",
      "secondary_message": "4 fl oz (½ cup) whole milk\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 615715,
      "primary_message": "When the chicken is done, add mixed greens to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 615716,
      "primary_message": "To serve, divide mashed potatoes and greens between plates. Top potatoes with roasted chicken and grapes. Enjoy!",
      "secondary_message": null
    }
  ],
