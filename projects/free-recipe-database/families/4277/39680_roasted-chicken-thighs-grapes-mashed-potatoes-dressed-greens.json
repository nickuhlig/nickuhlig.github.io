  "instructions": [
    {
      "id": 615717,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 615718,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n1 small pkg fresh rosemary\n1 ½ lb red grapes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 615719,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 615720,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 615721,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 615722,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and cook until golden, about 2 minutes per side (the chicken will not be cooked all the way through). Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 615723,
      "primary_message": "Meanwhile, peel, halve, and slice shallots lengthwise into thin strips. Place in a small bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 615724,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Add to the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 615725,
      "primary_message": "Place shallot, rosemary, and grapes in a large baking dish. Add chicken, nestling it into the grapes. Place dish in the oven and roast until chicken is cooked through and grapes are softened, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 615726,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, Dijon, sugar, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp brown sugar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 615727,
      "primary_message": "When the potatoes are tender, drain in a colander and return to the pot; add milk, salt, and pepper. Using a potato masher, mash until smooth. Cover to keep warm and set aside.",
      "secondary_message": "6 fl oz (¾ cup) whole milk\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 615728,
      "primary_message": "When the chicken is done, add mixed greens to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 615729,
      "primary_message": "To serve, divide mashed potatoes and greens between plates. Top potatoes with roasted chicken and grapes. Enjoy!",
      "secondary_message": null
    }
  ],
