  "instructions": [
    {
      "id": 574864,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 574865,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 mango\n1 red bell pepper\n½ bunch Swiss chard"
    },
    {
      "id": 574866,
      "primary_message": "Peel and mince ginger, shallot, and garlic. Place all three in a medium bowl, along with oil and spices, then whisk to combine the sauce.",
      "secondary_message": "1 shallot\n1 clove garlic\n1 tbsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp cayenne pepper\n¼ tsp cinnamon, ground"
    },
    {
      "id": 574867,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; large dice the flesh. Add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 574868,
      "primary_message": "Trim, seed, and large dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 574869,
      "primary_message": "Pat pork chops dry with paper towels and cut into 1-inch cubes. Add to the bowl and stir to combine. Thread mango, bell pepper, and pork onto the skewers, alternating ingredients; place on a plate. (If you don't have skewers, you can cook directly on the grill pan.)",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 574870,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574871,
      "primary_message": "Once the pan is hot, add the skewers and grill, turning occasionally, until the pork is charred and cooked through, about 8 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 574872,
      "primary_message": "Meanwhile, using a clean cutting board, fold chard leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces, keeping them separate. Place leaves in a clean medium bowl and stems in a small bowl. Set the medium bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 574873,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574874,
      "primary_message": "While the skillet heats up, peel and mince additional garlic. Add to the bowl with the chard stems.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 574875,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, garlic, and spices; cook, stirring often, until stems are softened, 1-2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 574876,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for them to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until chard is tender, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 574877,
      "primary_message": "Add vinegar to the skillet, stir to combine, and remove from heat.",
      "secondary_message": "2 tsp apple cider vinegar"
    },
    {
      "id": 574878,
      "primary_message": "To serve, divide skewers and chard between plates. Enjoy!",
      "secondary_message": null
    }
  ],
