  "instructions": [
    {
      "id": 574894,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 574895,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 mangoes\n3 red bell peppers\n1 ½ bunches Swiss chard"
    },
    {
      "id": 574896,
      "primary_message": "Peel and mince ginger and garlic. Peel, halve, and mince onion. Place all three in a large bowl, along with oil and spices, then whisk to combine the sauce.",
      "secondary_message": "3 cloves garlic\n½ medium red onion\n3 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp cayenne pepper\n¾ tsp cinnamon, ground"
    },
    {
      "id": 574897,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; large dice the flesh. Add to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 574898,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 574899,
      "primary_message": "Pat pork chops dry with paper towels and cut into 1-inch cubes. Add to the bowl and stir to combine. Thread mango, bell pepper, and pork onto the skewers, alternating ingredients; place on a plate. (If you don't have skewers, you can cook directly on the grill pan.)",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 574900,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574901,
      "primary_message": "Once the pan is hot, working in batches, add the skewers and grill, turning occasionally, until the pork is charred and cooked through, about 8 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 574902,
      "primary_message": "Meanwhile, using a clean cutting board, fold chard leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces, keeping them separate. Place leaves in a clean large bowl and stems in a small bowl. Set the large bowl aside for later use.",
      "secondary_message": null
    },
    {
      "id": 574903,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574904,
      "primary_message": "While the skillet heats up, peel and mince additional garlic. Add to the bowl with the chard stems.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 574905,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, garlic, and spices; cook, stirring often, until stems are softened, about 2 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 574906,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for them to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until chard is tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 574907,
      "primary_message": "Add vinegar to the skillet, stir to combine, and remove from heat.",
      "secondary_message": "2 tbsp apple cider vinegar"
    },
    {
      "id": 574908,
      "primary_message": "To serve, divide skewers and chard between plates. Enjoy!",
      "secondary_message": null
    }
  ],
