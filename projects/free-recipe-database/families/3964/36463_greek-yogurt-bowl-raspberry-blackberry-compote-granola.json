  "instructions": [
    {
      "id": 572812,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ (170 g) pkg blackberries\n½ (170 g) pkg raspberries"
    },
    {
      "id": 572813,
      "primary_message": "Juice lemon into a small saucepan. Add blackberries, raspberries, and honey. ",
      "secondary_message": "2 tsp honey"
    },
    {
      "id": 572814,
      "primary_message": "Set the pan over medium-high heat and cook, stirring occasionally, until berries soften and release their juices, about 5 minutes. Remove from heat and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 572815,
      "primary_message": "Once cool, lightly crush berries with a potato masher or fork to create a semi-smooth compote. ",
      "secondary_message": null
    },
    {
      "id": 572816,
      "primary_message": "To serve, divide yogurt, compote, and granola between bowls. Enjoy!",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 cup granola"
    }
  ],
