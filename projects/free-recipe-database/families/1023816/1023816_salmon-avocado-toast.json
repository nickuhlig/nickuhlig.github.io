  "instructions": [
    {
      "primary_message": "Preheat the oven to 350 degrees F. Spray a rimmed baking sheet with nonstick cooking spray.",
      "secondary_message": null
    },
    {
      "primary_message": "Place salmon on a rimmed baking sheet and drizzle with olive oil. Sprinkle with 1 teaspoon Kinder's® lemon butter garlic seasoning. Bake for 12-15 minutes or until the salmon flakes easily with a fork. Remove from the oven and let cool. Remove salmon in small bite sized pieces from the skin. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "In a bowl stir to combine mashed avocado, red onion, jalapeño and remaining Kinder's® seasoning.",
      "secondary_message": null
    },
    {
      "primary_message": "Spread avocado mash on toast. Top with arugula, cucumber and salmon. Garnish with a drizzle of lemon juice and a sprinkle of Kinder's® seasoning and cayenne pepper, if desired. Serve.",
      "secondary_message": null
    }
  ],
