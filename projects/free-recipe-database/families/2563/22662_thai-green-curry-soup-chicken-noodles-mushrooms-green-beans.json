  "instructions": [
    {
      "id": 376177,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 376178,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, curry paste, and salt. Cook, stirring occasionally, until mushrooms start to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n3 (227g ) pkg sliced white mushrooms\n⅓ cup Thai curry paste, green\n¾ tsp salt"
    },
    {
      "id": 376179,
      "primary_message": "Add broth to the pot. Stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "2839 ml chicken or vegetable broth"
    },
    {
      "id": 376180,
      "primary_message": "While the soup comes to a boil, place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces.",
      "secondary_message": "1 ½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 376181,
      "primary_message": "Once the soup is boiling, uncover, then add chicken and rice noodles; stir to combine. Reduce heat to medium and simmer, stirring occasionally, until noodles are almost soft, 8-10 minutes.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 376182,
      "primary_message": "Meanwhile, wash and dry green beans. Using a clean cutting board, trim and cut green beans crosswise into 1-inch pieces.",
      "secondary_message": "0.68 kg green beans"
    },
    {
      "id": 376183,
      "primary_message": "When the noodles are almost soft, add green beans. Continue to cook until noodles and beans are tender, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 376184,
      "primary_message": "Wash, dry, and juice limes into the soup. Stir to combine and remove from heat.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 376185,
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
