  "instructions": [
    {
      "id": 376168,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 376169,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, curry paste, and salt. Cook, stirring occasionally, until mushrooms start to soften, 1-2 minutes.",
      "secondary_message": "4 tsp virgin coconut oil\n2 (227g ) pkg sliced white mushrooms\n¼ cup Thai curry paste, green\n½ tsp salt"
    },
    {
      "id": 376170,
      "primary_message": "Add broth to the pot. Stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "1893 ml chicken or vegetable broth"
    },
    {
      "id": 376171,
      "primary_message": "While the soup comes to a boil, place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces.",
      "secondary_message": "1 (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 376172,
      "primary_message": "Once the soup is boiling, uncover, then add chicken and rice noodles; stir to combine. Reduce heat to medium and simmer, stirring occasionally, until noodles are almost soft, about 8 minutes.",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 376173,
      "primary_message": "Meanwhile, wash and dry green beans. Using a clean cutting board, trim and cut green beans crosswise into 1-inch pieces.",
      "secondary_message": "0.45 kg green beans"
    },
    {
      "id": 376174,
      "primary_message": "When the noodles are almost soft, add green beans. Continue to cook until noodles and beans are tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 376175,
      "primary_message": "Wash, dry, and juice lime into the soup. Stir to combine and remove from heat.",
      "secondary_message": "1 lime"
    },
    {
      "id": 376176,
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
