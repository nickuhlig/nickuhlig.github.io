  "instructions": [
    {
      "id": 376149,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 376150,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 376151,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, curry paste, and salt. Cook, stirring occasionally, until mushrooms start to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n3 (8 oz) pkg sliced white mushrooms\n⅓ cup Thai curry paste, green\n¾ tsp salt"
    },
    {
      "id": 376152,
      "primary_message": "Add broth to the pot. Stir to combine, cover, and bring to a boil over high heat.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth"
    },
    {
      "id": 376153,
      "primary_message": "Meanwhile, medium dice tofu.",
      "secondary_message": null
    },
    {
      "id": 376154,
      "primary_message": "Once the soup is boiling, uncover, add tofu and rice noodles, then stir to combine. Reduce heat to medium and simmer, stirring occasionally, until noodles are almost soft, 8-10 minutes.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 376155,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green beans crosswise into 1-inch pieces.",
      "secondary_message": "1 ½ lb green beans"
    },
    {
      "id": 376156,
      "primary_message": "When the noodles are almost soft, add green beans. Continue to cook until noodles and beans are tender, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 376157,
      "primary_message": "Wash, dry, and juice limes into the soup. Stir to combine and remove from heat.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 376158,
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
