  "instructions": [
    {
      "id": 242793,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 242794,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n0.68 kg Brussels sprouts\n3 Gala apples"
    },
    {
      "id": 242795,
      "primary_message": "Trim ends and peel each squash; halve lengthwise, scrape out seeds, and cut the flesh into 1-inch cubes. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 242796,
      "primary_message": "Trim Brussels sprouts and halve lengthwise; add to the baking sheets with the squash.",
      "secondary_message": null
    },
    {
      "id": 242797,
      "primary_message": "Quarter and core apples, then slice each quarter into wedges; add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 242798,
      "primary_message": "Peel, trim, and quarter shallots lengthwise. Add to the baking sheets, keeping the quarters intact.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 242799,
      "primary_message": "Drizzle maple syrup and oil over the apple and veggies. Season with salt and pepper, toss to combine, then spread out in an even layer.",
      "secondary_message": "3 tbsp pure maple syrup\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 242800,
      "primary_message": "To hasselback the sausages, thinly slice each sausage crosswise, stopping ½-inch before the bottom (be careful not to slice all the way through).",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 242801,
      "primary_message": "Place sausages, cut-side up, on the baking sheets, nestling them into the apple and veggies.",
      "secondary_message": null
    },
    {
      "id": 242802,
      "primary_message": "Place baking sheets in the oven and bake until apple and veggies are tender and sausages are cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 242803,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous and salt, and stir to combine; cover and let stand for 10 minutes. Fluff with a fork.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous\n½ tsp salt"
    },
    {
      "id": 242804,
      "primary_message": "To serve, divide apples, veggies, sausages, and couscous between plates. Enjoy!",
      "secondary_message": null
    }
  ],
