  "instructions": [
    {
      "id": 242817,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 242818,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n0.45 kg Brussels sprouts\n1 Gala apple"
    },
    {
      "id": 242819,
      "primary_message": "Trim ends and peel squash; halve lengthwise, scrape out seeds, and cut the flesh into 1-inch cubes. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 242820,
      "primary_message": "Trim Brussels sprouts and halve lengthwise; add to the baking sheet with the squash.",
      "secondary_message": null
    },
    {
      "id": 242821,
      "primary_message": "Quarter and core apple, then slice each quarter into wedges; add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 242822,
      "primary_message": "Peel, trim, and quarter shallots lengthwise. Add to the baking sheet, keeping the quarters intact.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 242823,
      "primary_message": "Drizzle oil and maple syrup over the apple and veggies. Season with salt and pepper, toss to combine, then spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tbsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 242824,
      "primary_message": "To hasselback the sausages, thinly slice each sausage crosswise, stopping ½-inch before the bottom (be careful not to slice all the way through).",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 242825,
      "primary_message": "Place sausages, cut-side up, on the baking sheet, nestling them into the apple and veggies.",
      "secondary_message": null
    },
    {
      "id": 242826,
      "primary_message": "Place baking sheet in the oven and bake until apple and veggies are tender and sausages are cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 242827,
      "primary_message": "Transfer sausages to a clean cutting board and cut in half crosswise.",
      "secondary_message": null
    },
    {
      "id": 242828,
      "primary_message": "To serve, divide apples, veggies, and sausages between plates. Enjoy!",
      "secondary_message": null
    }
  ],
