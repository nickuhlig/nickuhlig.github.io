  "instructions": [
    {
      "id": 242697,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 242698,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small butternut squash\n½ lb Brussels sprouts\n1 Gala apple"
    },
    {
      "id": 242699,
      "primary_message": "Trim ends and peel squash; halve lengthwise, scrape out seeds, and cut the flesh into 1-inch cubes. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 242700,
      "primary_message": "Trim Brussels sprouts and halve lengthwise; add to the baking sheet with the squash.",
      "secondary_message": null
    },
    {
      "id": 242701,
      "primary_message": "Quarter and core apple, then slice each quarter into wedges; add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 242702,
      "primary_message": "Peel, trim, and quarter shallot lengthwise. Add to the baking sheet, keeping the quarters intact.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 242703,
      "primary_message": "Drizzle maple syrup and oil over the apple and veggies. Season with salt and pepper, toss to combine, then spread out in an even layer.",
      "secondary_message": "1 tbsp pure maple syrup\n2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 242704,
      "primary_message": "To hasselback the sausages, thinly slice each sausage crosswise, stopping ½-inch before the bottom (be careful not to slice all the way through).",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 242705,
      "primary_message": "Place sausages, cut-side up, on the baking sheet, nestling them into the apple and veggies.",
      "secondary_message": null
    },
    {
      "id": 242706,
      "primary_message": "Place baking sheet in the oven and bake until apple and veggies are tender and sausages are cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 242707,
      "primary_message": "Meanwhile, in a small saucepan, bring broth to a boil. Remove from heat, add couscous and salt, and stir to combine; cover and let stand for 10 minutes. Fluff with a fork.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ cup whole wheat couscous\n⅛ tsp salt"
    },
    {
      "id": 242708,
      "primary_message": "To serve, divide apples, veggies, sausages, and couscous between plates. Enjoy!",
      "secondary_message": null
    }
  ],
