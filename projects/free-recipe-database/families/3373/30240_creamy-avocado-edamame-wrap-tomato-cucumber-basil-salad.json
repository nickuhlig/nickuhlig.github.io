  "instructions": [
    {
      "id": 481557,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 small pkg fresh basil\n1 ½ avocados\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 481558,
      "primary_message": "Place edamame in a colander and rinse with hot water (from the tap) to thaw. Set aside to drain.",
      "secondary_message": "4 ½ cups edamame"
    },
    {
      "id": 481559,
      "primary_message": "Meanwhile, zest and juice limes. Divide between two large bowls (set one bowl aside for the edamame salad).",
      "secondary_message": null
    },
    {
      "id": 481560,
      "primary_message": "Add oil, maple syrup, salt, and pepper to the remaining bowl with the lime. Whisk to combine the salad dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 481561,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 481562,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 481563,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 481564,
      "primary_message": "Add mayo and spices to the reserved bowl with the lime. Whisk to combine the creamy dressing.",
      "secondary_message": "½ cup mayonnaise\n1 ½ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 481565,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl with the creamy dressing, along with the edamame, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 481566,
      "primary_message": "Place tortillas on a flat surface, divide edamame salad between them, then top with sprouts. Roll tightly to close and cut in half. ",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 481567,
      "primary_message": "To serve, divide wraps and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
