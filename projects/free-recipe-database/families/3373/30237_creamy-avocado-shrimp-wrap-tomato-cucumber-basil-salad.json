  "instructions": [
    {
      "id": 481521,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 small pkg fresh basil\n1 ½ avocados\n1 ½ (3 oz) pkgs alfalfa sprouts"
    },
    {
      "id": 481522,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 481523,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 481524,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add shrimp, salt, and pepper; cook, stirring occasionally, until shrimp are just opaque, 2-3 minutes. Remove to a large plate and set aside to cool.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 481525,
      "primary_message": "Meanwhile, zest and juice limes, then divide between two large bowls. Set one bowl aside for the shrimp salad.",
      "secondary_message": null
    },
    {
      "id": 481526,
      "primary_message": "Add oil, maple syrup, salt, and pepper to the remaining bowl with the lime. Whisk to combine the salad dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 481527,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 481528,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 481529,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 481530,
      "primary_message": "Add mayo and spices to the reserved bowl with the lime. Whisk to combine the creamy dressing.",
      "secondary_message": "½ cup mayonnaise\n1 ½ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 481531,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl with the creamy dressing.",
      "secondary_message": null
    },
    {
      "id": 481532,
      "primary_message": "Roughly chop cooled shrimp, add to the bowl, and stir to combine the shrimp salad.",
      "secondary_message": null
    },
    {
      "id": 481533,
      "primary_message": "Place tortillas on a flat surface, divide shrimp salad between them, then top with sprouts. Roll tightly to close and cut in half. ",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 481534,
      "primary_message": "To serve, divide wraps and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
