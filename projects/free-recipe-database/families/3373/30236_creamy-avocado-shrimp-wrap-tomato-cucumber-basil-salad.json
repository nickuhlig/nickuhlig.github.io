  "instructions": [
    {
      "id": 481507,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 pint grape tomatoes\n1 English cucumber\n1 small pkg fresh basil\n1 avocado\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 481508,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 481509,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 481510,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook, stirring occasionally, until shrimp are just opaque, 2-3 minutes. Remove to a plate and set aside to cool.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 481511,
      "primary_message": "Meanwhile, zest and juice lime, then divide between two medium bowls. Set one bowl aside for the shrimp salad.",
      "secondary_message": null
    },
    {
      "id": 481512,
      "primary_message": "Add oil, maple syrup, salt, and pepper to the remaining bowl with the lime. Whisk to combine the salad dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 481513,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 481514,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 481515,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 481516,
      "primary_message": "Add mayo and spices to the reserved bowl with the lime. Whisk to combine the creamy dressing.",
      "secondary_message": "⅓ cup mayonnaise\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 481517,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the bowl with the creamy dressing.",
      "secondary_message": null
    },
    {
      "id": 481518,
      "primary_message": "Roughly chop cooled shrimp, add to the bowl, and stir to combine the shrimp salad.",
      "secondary_message": null
    },
    {
      "id": 481519,
      "primary_message": "Place tortillas on a flat surface, divide shrimp salad between them, then top with sprouts. Roll tightly to close and cut in half. ",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 481520,
      "primary_message": "To serve, divide wraps and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
