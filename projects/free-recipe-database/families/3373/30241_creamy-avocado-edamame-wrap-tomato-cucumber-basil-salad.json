  "instructions": [
    {
      "id": 481568,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ pint grape tomatoes\n½ English cucumber\n½ small pkg fresh basil\n½ avocado\n½ (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 481569,
      "primary_message": "Place edamame in a colander and rinse with hot water (from the tap) to thaw. Set aside to drain.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 481570,
      "primary_message": "Meanwhile, zest and juice lime. Divide between two medium bowls (set one bowl aside for the edamame salad).",
      "secondary_message": null
    },
    {
      "id": 481571,
      "primary_message": "Add oil, maple syrup, salt, and pepper to the remaining bowl with the lime. Whisk to combine the salad dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 481572,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 481573,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 481574,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 481575,
      "primary_message": "Add mayo and spices to the reserved bowl with the lime. Whisk to combine the creamy dressing.",
      "secondary_message": "3 tbsp vegan mayonnaise\n½ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 481576,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the bowl with the creamy dressing, along with the edamame, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 481577,
      "primary_message": "Place tortillas on a flat surface, divide edamame salad between them, then top with sprouts. Roll tightly to close and cut in half. ",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 481578,
      "primary_message": "To serve, divide wraps and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
