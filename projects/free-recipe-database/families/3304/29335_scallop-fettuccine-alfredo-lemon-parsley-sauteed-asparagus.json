  "instructions": [
    {
      "id": 467477,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside.",
      "secondary_message": "½ tsp salt\n142 g fettuccine pasta"
    },
    {
      "id": 467478,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n½ small bunch Italian (flat-leaf) parsley\n½ lemon"
    },
    {
      "id": 467479,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467480,
      "primary_message": "While the skillet heats up, snap (or cut) off woody ends of asparagus.",
      "secondary_message": null
    },
    {
      "id": 467481,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, salt, and pepper; cook, turning occasionally, until bright green and tender-crisp, 3-4 minutes. Transfer to a plate and cover with aluminum foil to keep warm. (Reserve skillet for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 467482,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a small bowl, setting aside a small handful for serving.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 467483,
      "primary_message": "Return skillet to medium heat. Add Parmesan, cream, salt, and pepper; cook, stirring occasionally, until cheese melts and sauce is combined, 1-2 minutes.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 467484,
      "primary_message": "While the sauce is cooking, pat the scallops dry with paper towels and place on another plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg sea scallops\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 467485,
      "primary_message": "Add scallops to the skillet with the sauce and gently stir to coat. Cook, stirring occasionally, until scallops are opaque, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 467486,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 467487,
      "primary_message": "Juice lemon into the skillet with the sauce. Add drained pasta and parsley. Reduce heat to low and continue to cook, tossing occasionally, until sauce thickens, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 467488,
      "primary_message": "To serve, divide scallop fettuccine and asparagus between plates. Top pasta with reserved Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
