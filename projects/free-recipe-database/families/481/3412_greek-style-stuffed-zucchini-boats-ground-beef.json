  "instructions": [
    {
      "id": 35760,
      "primary_message": "Preheat the oven to 450°F and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 35759,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 tomato"
    },
    {
      "id": 35761,
      "primary_message": "Halve the zucchini lengthwise, then scrape out and discard the soft flesh from the middle of each half.",
      "secondary_message": ""
    },
    {
      "id": 36809,
      "primary_message": "Place the zucchini halves cut-side-up on a baking sheet; rub with olive oil and season with salt and pepper.",
      "secondary_message": "½ tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 35769,
      "primary_message": "Place the zucchini halves in the oven and bake while you prepare the filling, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 35771,
      "primary_message": "Cut the tomato into ¼-inch cubes and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 35764,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 35763,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; cut into ¼-inch cubes.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 35765,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 35766,
      "primary_message": "Add the onion to the skillet; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 35762,
      "primary_message": "While the onion cooks, trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 35767,
      "primary_message": "Add the garlic and oregano to the skillet; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": "½ tsp oregano"
    },
    {
      "id": 35768,
      "primary_message": "Add the ground beef to the skillet and increase the heat to high; season with salt and pepper. Cook the beef, breaking apart with a spoon, until browned and crumbly, 3 to 5 minutes.",
      "secondary_message": "¾ lb lean ground beef\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 36808,
      "primary_message": "While the beef cooks, halve the olives.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n"
    },
    {
      "id": 36810,
      "primary_message": "Remove the baking sheet from the oven, change the setting to broil, and place the rack about 6 inches from the top heat source.",
      "secondary_message": null
    },
    {
      "id": 35772,
      "primary_message": "Add the tomatoes and olives to the skillet and cook the mixture for an additional 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 35773,
      "primary_message": "Divide the beef filling between the zucchini halves, then sprinkle with feta overtop.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 35774,
      "primary_message": "Return the zucchini to the oven and broil until the cheese melts and is lightly browned, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 35770,
      "primary_message": "To serve, place the zucchini boats on a plate. Enjoy!",
      "secondary_message": null
    }
  ],
