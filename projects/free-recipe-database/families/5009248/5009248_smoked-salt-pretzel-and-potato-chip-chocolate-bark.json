  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the bittersweet chocolate.",
      "secondary_message": "1 lb bittersweet chocolate, divided"
    },
    {
      "id": 1,
      "primary_message": "Line baking sheet with parchment paper. Place chocolate in large heatproof bowl. Using microwave or setting the bowl over a pan of barely simmering water, heat 2/3 of the chocolate, stirring until melted and smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove bowl from heat and stir in remaining chocolate to melt. (If it won't melt, return bowl to heat briefly). Stir in half the potato chips and half the pretzels.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spread onto pan into a 10- by 12-inch rectangle, about 1/4-inch thick. Press remaining chips and pretzels onto chocolate and sprinkle lightly with salt. Chill until set, about 1 hour. Break into pieces and serve.",
      "secondary_message": null
    }
  ],
