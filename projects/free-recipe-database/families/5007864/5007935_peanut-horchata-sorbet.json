  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Lightly toast the slivered raw almonds. Keep the peanut butter cold until you use it.",
      "secondary_message": "1 cup slivered raw almonds\n1 cup peanut butter"
    },
    {
      "id": 1,
      "primary_message": "In a blender or food processor, grind rice, almonds, and cinnamon to a coarse powder. Add to a medium bowl with coffee and 2 1/2 cups water. Stir until all ingredients are covered in water, then cover and refrigerate for 8 to 12 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer contents of bowl to blender and blend until mixture looks white and creamy. Pour into a large bowl through a fine-meshed strainer lined with cheese cloth. Stir in 1 1/2 cups water. Rinse out blender.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In rinsed blender, combine peanut butter, sugar, and two cups rice-almond milk. Blend until smooth and add salt to taste. Churn in ice cream machine according to manufacturer's instructions. Transfer to freezer to set for a couple hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Dilute remaining rice-almond milk with water and add brown sugar and salt as desired to serve as horchata. Let sorbet soften on counter for 10 to 15 minutes before serving.",
      "secondary_message": null
    }
  ],
