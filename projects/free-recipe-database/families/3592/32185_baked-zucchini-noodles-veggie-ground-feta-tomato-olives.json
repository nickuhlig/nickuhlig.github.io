  "instructions": [
    {
      "id": 523071,
      "primary_message": "Preheat oven to 400°F. Line a baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 523072,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n½ pint grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 523073,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of the zucchini to make ribbons. Transfer to the baking sheet, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 523074,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until zucchini is tender, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 523075,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 523076,
      "primary_message": "While the skillet heats up, halve grape tomatoes. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 523077,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 523078,
      "primary_message": "Meanwhile, roughly chop olives. Add to the bowl with the tomatoes.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 523079,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 523080,
      "primary_message": "When the veggie ground is done, add tomatoes, olives, basil, tomato sauce, feta, and pine nuts to the skillet. Stir to combine the sauce and bring to a simmer. Once simmering, remove from heat.",
      "secondary_message": "1 (8 oz) can tomato sauce\n½ (4 oz) pkg crumbled feta cheese\n¼ cup pine nuts"
    },
    {
      "id": 523081,
      "primary_message": "To serve, divide zucchini noodles between plates or bowls. Top with sauce and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
