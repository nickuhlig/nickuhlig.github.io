  "instructions": [
    {
      "id": 523016,
      "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 523017,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n1 pint grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 523018,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of the zucchini to make ribbons. Transfer to the baking sheet, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 523019,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until zucchini is tender, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 523020,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 523021,
      "primary_message": "While the skillet heats up, halve grape tomatoes. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 523022,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb ground turkey\n1 tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 523023,
      "primary_message": "Meanwhile, roughly chop olives. Add to the bowl with the tomatoes.",
      "secondary_message": "⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 523024,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 523025,
      "primary_message": "When the turkey is done, add tomatoes, olives, basil, tomato sauce, feta, and pine nuts to the skillet. Stir to combine the sauce and bring to a simmer. Once simmering, remove from heat.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n1 (4 oz) pkg crumbled feta cheese\n½ cup pine nuts"
    },
    {
      "id": 523026,
      "primary_message": "To serve, divide zucchini noodles between plates or bowls. Top with sauce and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
