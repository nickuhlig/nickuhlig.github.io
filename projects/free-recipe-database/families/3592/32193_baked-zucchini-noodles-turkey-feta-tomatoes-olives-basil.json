  "instructions": [
    {
      "id": 523159,
      "primary_message": "Preheat oven to 205°C (400°F). Line two baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 523160,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n1 ½ small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 523161,
      "primary_message": "Trim zucchini, then run a vegetable peeler along the length of the zucchini to make ribbons. Divide between the baking sheets, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 523162,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until zucchini is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 523163,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 523164,
      "primary_message": "While the pot heats up, halve grape tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 523165,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg ground turkey\n1 ½ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 523166,
      "primary_message": "Meanwhile, roughly chop olives. Add to the bowl with the tomatoes.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 523167,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 523168,
      "primary_message": "When the turkey is done, add tomatoes, olives, basil, tomato sauce, feta, and pine nuts to the pot. Stir to combine the sauce and bring to a simmer. Once simmering, remove from heat.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ (113 g) pkgs crumbled feta cheese\n¾ cup pine nuts"
    },
    {
      "id": 523169,
      "primary_message": "To serve, divide zucchini noodles between plates or bowls. Top with sauce and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
