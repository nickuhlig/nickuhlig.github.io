  "instructions": [
    {
      "id": 371952,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 371953,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed\n1 tbsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 371954,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until wings are cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 371955,
      "primary_message": "About 5 minutes before the wings are done, wash, dry, trim, and thinly slice celery. Place in a clean medium bowl.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 371956,
      "primary_message": "Wash and dry the mixed greens (skip if they came pre-washed). Add to the bowl with the celery along with carrots and dressing. Toss to combine the salad.",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)\n½ (283 g) bag shredded carrots\n2 tbsp blue cheese dressing"
    },
    {
      "id": 371957,
      "primary_message": "Place hot sauce and oil in another medium bowl. Whisk to combine the sauce.",
      "secondary_message": "3 tbsp hot sauce\n2 tsp extra virgin olive oil"
    },
    {
      "id": 371958,
      "primary_message": "When the wings are done, remove from the oven and add to the bowl with the sauce. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 371959,
      "primary_message": "To serve, divide hot wings and salad between plates. Serve with additional dressing on the side for dipping. Enjoy!",
      "secondary_message": "¼ cup blue cheese dressing"
    }
  ],
