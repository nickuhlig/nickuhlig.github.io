  "instructions": [
    {
      "id": 371968,
      "primary_message": "Preheat oven to 260°C (500°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 371969,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed\n3 tbsp cornstarch\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 371970,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, turning once, until wings are cooked through, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 371971,
      "primary_message": "About 10 minutes before the wings are done, wash, dry, trim, and thinly slice celery. Place in a clean large bowl.",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 371972,
      "primary_message": "Wash and dry the mixed greens (skip if they came pre-washed). Add to the bowl with the celery along with carrots and dressing. Toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkg spring mix (mixed greens)\n1 ½ (283 g) bags shredded carrots\n⅓ cup blue cheese dressing"
    },
    {
      "id": 371973,
      "primary_message": "Place hot sauce and oil in another large bowl. Whisk to combine the sauce.",
      "secondary_message": "½ cup hot sauce\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 371974,
      "primary_message": "When the wings are done, remove from the oven and add to the bowl with the sauce. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 371975,
      "primary_message": "To serve, divide hot wings and salad between plates. Serve with additional dressing on the side for dipping. Enjoy!",
      "secondary_message": "¾ cup blue cheese dressing"
    }
  ],
