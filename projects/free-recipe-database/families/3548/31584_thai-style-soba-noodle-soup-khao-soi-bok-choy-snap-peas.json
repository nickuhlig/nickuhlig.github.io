  "instructions": [
    {
      "id": 509601,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro\n12 baby bok choy\n1 ½ (227 g) pkgs sugar snap peas\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 509602,
      "primary_message": "Peel and roughly chop ginger. Peel garlic. Place both in a blender. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 509603,
      "primary_message": "Shave cilantro leaves off the stems. Add cilantro stems and half of the leaves to the blender. (Reserve remaining leaves for later use.)",
      "secondary_message": null
    },
    {
      "id": 509604,
      "primary_message": "Add coconut milk, chili-garlic sauce, and spices to the blender. Blend on high until mixture is smooth, scraping down the sides of the blender with a spatula as needed.",
      "secondary_message": "1 ½ (398 ml) cans coconut milk\n1 tbsp chili-garlic sauce\n1 ½ tbsp curry powder\n1 tbsp coriander, ground\n1 ½ tsp turmeric, ground\n¾ tsp salt"
    },
    {
      "id": 509605,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 509606,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add coconut mixture and cook, stirring occasionally, until slightly thickened, about 5 minutes. ",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 509607,
      "primary_message": "Meanwhile, trim and roughly chop bok choy. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 509608,
      "primary_message": "Halve snap peas. Add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 509609,
      "primary_message": "Halve grape tomatoes. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 509610,
      "primary_message": "Once the coconut mixture has thickened, add broth, soy sauce, and sugar to the pot. Whisk to combine and bring to a boil.",
      "secondary_message": "2129 ml chicken or vegetable broth\n3 tbsp soy sauce\n2 tbsp brown sugar"
    },
    {
      "id": 509611,
      "primary_message": "Once the broth is boiling, add veggies to the pot. Cook, stirring occasionally, until just softened, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 509612,
      "primary_message": "Add soba noodles to the pot and cook until tender, about 5 minutes (or cook according to package instructions). Remove from heat.",
      "secondary_message": "425 g soba (buckwheat) noodles"
    },
    {
      "id": 509613,
      "primary_message": "Meanwhile, roughly chop reserved cilantro. ",
      "secondary_message": null
    },
    {
      "id": 509614,
      "primary_message": "To serve, divide broth, veggies, and noodles between bowls; sprinkle with reserved cilantro and sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
