  "instructions": [
    {
      "id": 509545,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro\n8 baby bok choy\n1 (227 g) pkg sugar snap peas\n1 small pkg grape tomatoes"
    },
    {
      "id": 509546,
      "primary_message": "Peel and roughly chop ginger. Peel garlic. Place both in a blender. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 509547,
      "primary_message": "Shave cilantro leaves off the stems. Add cilantro stems and half of the leaves to the blender. (Reserve remaining leaves for later use.)",
      "secondary_message": null
    },
    {
      "id": 509548,
      "primary_message": "Add coconut milk, chili-garlic sauce, and spices to the blender. Blend on high until mixture is smooth, scraping down the sides of the blender with a spatula as needed.",
      "secondary_message": "1 (398 ml) can coconut milk\n2 tsp chili-garlic sauce\n1 tbsp curry powder\n2 tsp coriander, ground\n1 tsp turmeric, ground\n½ tsp salt"
    },
    {
      "id": 509549,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 509550,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add coconut mixture and cook, stirring occasionally, until slightly thickened, 4-5 minutes. ",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 509551,
      "primary_message": "Meanwhile, trim and roughly chop bok choy. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 509552,
      "primary_message": "Halve snap peas. Add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 509553,
      "primary_message": "Halve grape tomatoes. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 509554,
      "primary_message": "Once the coconut mixture has thickened, add broth, sugar, soy sauce, and fish sauce to the pot. Whisk to combine and bring to a boil.",
      "secondary_message": "1420 ml chicken or vegetable broth\n4 tsp brown sugar\n4 tsp soy sauce\n2 tsp fish sauce"
    },
    {
      "id": 509555,
      "primary_message": "Once the broth is boiling, add veggies to the pot. Cook, stirring occasionally, until just softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 509556,
      "primary_message": "Add soba noodles to the pot and cook until tender, about 5 minutes (or cook according to package instructions). Remove from heat.",
      "secondary_message": "283 g soba (buckwheat) noodles"
    },
    {
      "id": 509557,
      "primary_message": "Meanwhile, roughly chop reserved cilantro. ",
      "secondary_message": null
    },
    {
      "id": 509558,
      "primary_message": "To serve, divide broth, veggies, and noodles between bowls; sprinkle with reserved cilantro and sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
