  "instructions": [
    {
      "id": 66668,
      "primary_message": "Preheat the oven to 425°F and position rack in the centre. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 66667,
      "primary_message": "Whisk the eggs in a small bowl.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 66666,
      "primary_message": "In a medium bowl, mix together the almond meal, shredded coconut, garlic powder, paprika, salt, and pepper.",
      "secondary_message": "1 ½ cup almond meal/flour\n¾ cup shredded unsweetened coconut\n1 ½ tsp garlic powder\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 66665,
      "primary_message": "Cut the chicken into strips.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 66664,
      "primary_message": "Dip the chicken strips into the egg, then transfer to the dry mixture and turn to coat. Shake off excess and place on the baking sheet. Drizzle with olive oil.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 66663,
      "primary_message": "Place in the oven and bake until the crust is golden brown and the chicken is cooked through, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 66662,
      "primary_message": "Halve and pit the avocados; cut the flesh into cubes while still in the skin and scoop out with a spoon into a small bowl.",
      "secondary_message": "3 avocados"
    },
    {
      "id": 66661,
      "primary_message": "Peel and mince the garlic. Add the garlic, lime juice, salt, and pepper to the avocado. Mash with a fork until very smooth.",
      "secondary_message": "3 cloves garlic\njuice of 3 limes\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 66660,
      "primary_message": "Wash the mixed greens and tomatoes.",
      "secondary_message": "1 ½ (5 oz) pkg spring mix (mixed greens)\n3 pints grape tomatoes"
    },
    {
      "id": 66659,
      "primary_message": "To serve, place chicken strips on a plate and arrange greens and tomatoes on the side. Drizzle the greens with a little olive oil. Serve with avocado dip and enjoy!",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    }
  ],
