  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together cornmeal, white rice flour, granulated sugar, baking powder, salt, baking soda, chipotle powder (if using), and xanthan gum.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in a Dutch oven over high heat to 350°F and adjust flame to maintain temperature. Line a rimmed baking sheet with paper towels.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, whisk together onion, garlic, milk, and egg. Pour wet ingredients into dry ingredients and stir together until smooth but some lumps remain. Drop batter, about 1 scant tablespoon at a time, into hot oil until you have a dozen hush puppies. Fry until deep golden brown, about 3 minutes, turning occasionally. Remove hush puppies from the oil with a skimmer. Transfer to prepared baking sheet. Repeat with remaining batter. Serve warm.",
      "secondary_message": null
    }
  ],
