  "instructions": [
    {
      "id": 50740,
      "primary_message": "Fill a medium saucepan about halfway with water; cover and bring to a boil over high heat.",
      "secondary_message": ""
    },
    {
      "id": 50741,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 small pkg fresh basil"
    },
    {
      "id": 50742,
      "primary_message": "Trim the ends and peel the carrots; discard the trimmings and small dice the carrots. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 50743,
      "primary_message": "Trim and discard the ends of the celery; small dice the celery and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 50744,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 50745,
      "primary_message": "Peel and small dice the onion; add to the bowl with the other vegetables.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 50746,
      "primary_message": "Add olive oil to the pan and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 50747,
      "primary_message": "Add the carrots, celery, and onion to the pan and season with salt and pepper; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": "½ tsp salt\n¼ black pepper"
    },
    {
      "id": 50748,
      "primary_message": "Peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 50749,
      "primary_message": "Once the water in the saucepan is boiling, season with salt and add the pasta; stir for the few seconds. Cook until desired firmness, 9 to 10 minutes. Once done, drain the pasta.",
      "secondary_message": "2 tbsp salt\n10 oz (1 quarter coin = 2 oz) fettuccine pasta"
    },
    {
      "id": 50750,
      "primary_message": "Add the garlic to the pan and stir until fragrant, 15 to 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 50751,
      "primary_message": "Add the diced tomatoes, tomato sauce, water, and lentils; season with salt and pepper. Cover and cook until the lentils have softened, 15 to 18 minutes.",
      "secondary_message": "2 (14.5 oz) can diced tomatoes\n2 (8 oz) can tomato sauce\n1 cup water\n1 cup French green lentils\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 50752,
      "primary_message": "While the sauce cooks, pick the basil leaves off the stems; discard the stems and stack the leaves and thinly slice crosswise. Stir about half into the sauce (save the rest for garnishing).",
      "secondary_message": ""
    },
    {
      "id": 50754,
      "primary_message": "Divide the fettuccine noodles between bowls, top with the lentil bolognese sauce, and garnish with remaining basil. Enjoy!",
      "secondary_message": ""
    }
  ],
