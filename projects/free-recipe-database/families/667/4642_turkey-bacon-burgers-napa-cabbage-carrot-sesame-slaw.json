  "instructions": [
    {
      "id": 110977,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium red onion\n2 tomatoes\n1 head butter (Boston) lettuce\n1 medium head napa cabbage\n2 medium carrots"
    },
    {
      "id": 110978,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 110979,
      "primary_message": "Peel and thinly slice onion into half rings. Once the skillet is hot, add coconut oil and swirl to coat the bottom. Add onion and, stirring frequently, cook until softened, 4-5 minutes. Once done, transfer onions to a bowl and return skillet to medium heat.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 110980,
      "primary_message": "Finely chop bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 110981,
      "primary_message": "In a medium bowl, combine turkey, bacon, paprika, garlic powder, ground cumin, and black pepper. Mix well and form into 8 patties.",
      "secondary_message": "0.45 kg ground turkey\n1 tbsp paprika\n2 tsp garlic powder\n2 tsp cumin\n½ tsp black pepper"
    },
    {
      "id": 110982,
      "primary_message": "Place the patties in the skillet; cook until they are cooked through and browned, 3 to 5 minutes per side. Once done, transfer patties to a plate.",
      "secondary_message": null
    },
    {
      "id": 110983,
      "primary_message": "In a salad bowl, whisk together soya sauce, apple cider vinegar, honey, sesame oil, and sesame seeds.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp apple cider vinegar\n2 tsp honey\n2 tsp toasted sesame oil\n2 tbsp sesame seeds"
    },
    {
      "id": 110984,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 110985,
      "primary_message": "Trim the ends and peel the carrot; discard the trimmings and coarsely grate the carrots. Add to the salad bowl and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 110986,
      "primary_message": "Separate the lettuce head into leaves. Slice the tomato crosswise into ¼-inch-thick rounds.",
      "secondary_message": null
    },
    {
      "id": 110987,
      "primary_message": "To serve, place each patty on a lettuce leaf and top with a slice of tomato and grilled onions, arrange salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
