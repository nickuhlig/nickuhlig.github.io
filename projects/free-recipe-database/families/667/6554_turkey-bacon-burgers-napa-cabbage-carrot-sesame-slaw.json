  "instructions": [
    {
      "id": 110988,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium red onions\n3 tomatoes\n1 ½ heads butter (Boston) lettuce\n1 ½ medium heads napa cabbage\n3 medium carrots"
    },
    {
      "id": 110989,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 110990,
      "primary_message": "Peel and thinly slice onion into half rings. Once the skillet is hot, add coconut oil and swirl to coat the bottom. Add onion and, stirring frequently, cook until softened, 4-5 minutes. Once done, transfer onions to a bowl and return skillet to medium heat.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 110991,
      "primary_message": "Finely chop bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 110992,
      "primary_message": "In a medium bowl, combine turkey, bacon, paprika, garlic powder, ground cumin, and black pepper. Mix well and form into 12 patties.",
      "secondary_message": "0.68 kg ground turkey\n1 ½ tbsp paprika\n1 tbsp garlic powder\n1 tbsp cumin\n¾ tsp black pepper"
    },
    {
      "id": 110993,
      "primary_message": "Place four patties in the skillet; cook until they are cooked through and browned, 3 to 5 minutes per side. Once done, transfer patties to a plate and repeat with the remain patties.",
      "secondary_message": null
    },
    {
      "id": 110994,
      "primary_message": "In a large salad bowl, whisk together soya sauce, apple cider vinegar, honey, sesame oil, and sesame seeds.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp apple cider vinegar\n1 tbsp honey\n1 tbsp toasted sesame oil\n3 tbsp sesame seeds"
    },
    {
      "id": 110995,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 110996,
      "primary_message": "Trim the ends and peel the carrot; discard the trimmings and coarsely grate the carrots. Add to the salad bowl and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 110997,
      "primary_message": "Separate the lettuce head into leaves. Slice the tomato crosswise into ¼-inch-thick rounds.",
      "secondary_message": null
    },
    {
      "id": 110998,
      "primary_message": "To serve, place each patty on a lettuce leaf and top with a slice of tomato and grilled onions, arrange salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
