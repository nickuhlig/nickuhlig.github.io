  "instructions": [
    {
      "id": 141643,
      "primary_message": "Boil water in a kettle. (If you do not have a kettle, boil water in a saucepan, starting with hot tap water.)",
      "secondary_message": "½ cup water"
    },
    {
      "id": 141644,
      "primary_message": "In a small bowl, pour boiling water over cashews and set aside to soak.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 141645,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "198 g penne pasta\n½ tsp salt"
    },
    {
      "id": 141646,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small pkg grape tomatoes\n1 small pkg fresh basil\n½ lemon\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 141647,
      "primary_message": "Halve the tomatoes and set aside in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 141648,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and slice into ribbons. Add to the bowl with the tomatoes, setting some aside to use as garnish.",
      "secondary_message": null
    },
    {
      "id": 141649,
      "primary_message": "Thinly slice the sun-dried tomatoes and add to the bowl.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 141650,
      "primary_message": "Juice the lemon into a blender. Peel and mince garlic; add to the blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 141651,
      "primary_message": "Add additional sun-dried tomatoes, oil, salt, and pepper to the blender.",
      "secondary_message": "6 sun-dried tomatoes, oil-packed\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 141652,
      "primary_message": "Add cashews, and the water you soaked them in, to the blender. Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 141653,
      "primary_message": "Place spinach in a large colander in the sink. When the pasta is cooked, carefully empty into the colander over the spinach to drain and to wilt the spinach. Return the pasta and spinach to the pan and stir in the cashew-cream, dried and fresh tomatoes, and basil.",
      "secondary_message": null
    },
    {
      "id": 141654,
      "primary_message": "To serve, divide pasta between plates, garnish with reserved basil, and enjoy!",
      "secondary_message": null
    }
  ],
