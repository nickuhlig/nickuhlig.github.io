  "instructions": [
    {
      "id": 235827,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 235828,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 acorn squash\n9 baby bok choy\n3 (2 ½ cm) pieces ginger root\n1 ½ limes"
    },
    {
      "id": 235829,
      "primary_message": "Halve each acorn squash lengthwise, trim off the ends, then scoop out the seeds. Cut into ½-inch thick wedges and divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 235830,
      "primary_message": "Trim the bok choy ends and cut in half lengthwise; add to the baking sheets with the squash. Drizzle with oil and season with salt and pepper. Toss to coat, then spread the veggies out in a single layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 235831,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, flipping veggies halfway through, until fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235832,
      "primary_message": "Meanwhile, pat the halibut dry with paper towels and place, skin-side down, on a plate; season the top-side with salt and pepper. Set aside.",
      "secondary_message": "1.02 kg halibut fillet\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 235833,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 235834,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 235835,
      "primary_message": "While the pot heats up, peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 235836,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, onion, and chili-garlic sauce; cook, stirring frequently, until starting to soften, about 2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp chili-garlic sauce"
    },
    {
      "id": 235837,
      "primary_message": "Add broth, coconut milk, sugar, and fish sauce to the pot. Bring to a boil over high heat, then reduce heat to a simmer.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk\n1 tbsp brown sugar\n1 tbsp fish sauce"
    },
    {
      "id": 235838,
      "primary_message": "Place halibut fillets, skin-side down, in the broth. Spoon some of the broth over the tops of the fillets, then cover the pot; poach the fish until opaque and cooked through, about 5 minutes, depending on the thickness of each fillet. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 235839,
      "primary_message": "While the fish is cooking, cut limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 235840,
      "primary_message": "Divide roasted veggies, halibut, and coconut broth between bowls. Serve with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
