  "instructions": [
    {
      "id": 235813,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 235814,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 acorn squash\n6 baby bok choy\n2 (2 ½ cm) pieces ginger root\n1 lime"
    },
    {
      "id": 235815,
      "primary_message": "Halve acorn squash lengthwise, trim off the ends, then scoop out the seeds. Cut into ½-inch thick wedges and place on a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 235816,
      "primary_message": "Trim the bok choy ends and cut in half lengthwise; add to the baking sheet with the squash. Drizzle with oil and season with salt and pepper. Toss to coat, then spread the veggies out in a single layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 235817,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping veggies halfway through, until fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235818,
      "primary_message": "Meanwhile, pat the halibut dry with paper towels and place, skin-side down, on a plate; season the top-side with salt and pepper. Set aside.",
      "secondary_message": "0.68 kg halibut fillet\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 235819,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 235820,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 235821,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 235822,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, onion, and chili-garlic sauce; cook, stirring frequently, until starting to soften, 1-2 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 235823,
      "primary_message": "Add broth, coconut milk, sugar, and fish sauce to the skillet. Bring to a boil over high heat, then reduce heat to a simmer.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can coconut milk\n2 tsp brown sugar\n2 tsp fish sauce"
    },
    {
      "id": 235824,
      "primary_message": "Place halibut fillets, skin-side down, in the broth. Spoon some of the broth over the tops of the fillets, then cover the skillet; poach the fish until opaque and cooked through, about 5 minutes, depending on the thickness of each fillet. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 235825,
      "primary_message": "While the fish is cooking, cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 235826,
      "primary_message": "Divide roasted veggies, halibut, and coconut broth between bowls. Serve with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
