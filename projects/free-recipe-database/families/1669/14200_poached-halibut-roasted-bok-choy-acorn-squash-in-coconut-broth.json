  "instructions": [
    {
      "id": 235799,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 235800,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ acorn squash\n3 baby bok choy\n1 (2 ½ cm) piece ginger root\n½ lime"
    },
    {
      "id": 235801,
      "primary_message": "Halve acorn squash lengthwise, trim off the ends, then scoop out the seeds. Cut into ½-inch thick wedges and place on a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 235802,
      "primary_message": "Trim the bok choy ends and cut in half lengthwise; add to the baking sheet with the squash. Drizzle with oil and season with salt and pepper. Toss to coat, then spread the veggies out in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 235803,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping veggies halfway through, until fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235804,
      "primary_message": "Meanwhile, pat the halibut dry with paper towels and place, skin-side down, on a plate; season the top-side with salt and pepper. Set aside.",
      "secondary_message": "⅓ kg halibut fillet\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 235805,
      "primary_message": "Peel and mince ginger and garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 235806,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 235807,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice shallot into half-moons.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 235808,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ginger, garlic, shallot, and chili-garlic sauce; cook, stirring frequently, until starting to soften, 1-2 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 235809,
      "primary_message": "Add broth, coconut milk, sugar, and fish sauce to the skillet. Bring to a boil over high heat, then reduce heat to a simmer.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ (398 ml) can coconut milk\n1 tsp brown sugar\n1 tsp fish sauce"
    },
    {
      "id": 235810,
      "primary_message": "Place halibut fillets, skin-side down, in the broth. Spoon some of the broth over the tops of the fillets, then cover the skillet; poach the fish until opaque and cooked through, about 5 minutes, depending on the thickness of each fillet. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 235811,
      "primary_message": "While the fish is cooking, cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 235812,
      "primary_message": "Divide roasted veggies, halibut, and coconut broth between bowls. Serve with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
