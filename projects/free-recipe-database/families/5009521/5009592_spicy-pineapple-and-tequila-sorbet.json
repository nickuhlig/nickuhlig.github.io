  "instructions": [
    {
      "id": 1,
      "primary_message": "If pineapple is not perfectly ripe, toss with salt in a glass baking dish. Bake in an oven heated to 230°C (450°F) for 1 to 2 minutes, or until pineapple is sweet and aromatic. Do not overbake or pineapple will develop cooked flavors.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer pineapple chunks to blender and add just enough water (about 1/4 cup) to let blender purée until very smooth. Total volume of juice should be 4 cups. Add sugar and Aleppo pepper, then blend until sugar dissolves. If blender is small you may have to blend in batches.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour puréed pineapple into an airtight container. Stir in tequila and lime juice to taste, adding more salt if required. Cover and chill in refrigerator for 2 to 4 hours, or until very cold.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Churn in ice cream machine according to manufacturer's instructions. Return to airtight container and chill in freezer for 2 to 3 hours before serving.",
      "secondary_message": null
    }
  ],
