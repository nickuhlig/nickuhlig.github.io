  "instructions": [
    {
      "id": 194277,
      "primary_message": "Preheat oven to 205°C (400°F) and position a rack near the bottom of the oven. Grease 18 muffin cups with butter.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 194278,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 ½ small pkgs fresh basil"
    },
    {
      "id": 194279,
      "primary_message": "Quarter the grape tomatoes and add to the muffin tins.",
      "secondary_message": null
    },
    {
      "id": 194280,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the muffin tins.",
      "secondary_message": null
    },
    {
      "id": 194281,
      "primary_message": "Crack the eggs into a large bowl and season with salt and pepper; whisk together and pour on top of the tomatoes and basil.",
      "secondary_message": "15 eggs\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 194282,
      "primary_message": "Top eggs with feta. ",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 194283,
      "primary_message": "Bake for 18-20 minutes, until eggs are set in the center. Remove from the oven and let cool for 1 minute. Use a spatula to wedge each egg out of its cup.",
      "secondary_message": null
    },
    {
      "id": 194284,
      "primary_message": "Serve warm or cool for breakfast on the go. Enjoy! ",
      "secondary_message": null
    }
  ],
