  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the unsalted butter and let it cool. Crumble the blue cheese. Finely chop the celery.",
      "secondary_message": "4 tbsp (2 oz) unsalted butter\n57 g blue cheese\n2 stalks celery"
    },
    {
      "id": 1,
      "primary_message": "Stir milk and salt into bread crumbs in a medium bowl to moisten. Add chicken, 1/4 cup hot sauce, and butter, and mix gently with fingers until just combined (don't overmix). Chill until slightly firm, about 30 minutes. Shape into four patties that are just wider than the buns.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir blue cheese into mayonnaise; chill until ready to serve. Heat 1 teaspoon vegetable oil in skillet (see note) over medium heat until shimmering. Add patties and cook until cooked through (68°C or 68°C), about 3 to 4 minutes per side, basting the second side with the remaining hot sauce as they cook. Transfer to a plate and wipe out skillet with paper towel.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Return skillet to heat and toast the flat sides of the buns in the empty pan. Serve the burgers with the blue cheese mayo, sprinkle with the chopped celery, and lettuce and tomato if desired.",
      "secondary_message": null
    }
  ],
