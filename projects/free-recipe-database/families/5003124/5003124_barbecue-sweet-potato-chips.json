  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Very thinly slice the sweet potato on a mandoline.",
      "secondary_message": "⅓ lb sweet potato"
    },
    {
      "id": 1,
      "primary_message": "Combine the spices in a small bowl and set aside. Pour one inch of oil into a large dutch oven or heavy pot over moderately high heat. Heat the oil until it reaches 375°F on a deep-fry thermometer. Adjust flame to maintain temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Working in batches, place the sweet potatoes in the hot oil, occasionally flipping and moving the slices with a slotted spoon or a wire mesh spder. Fry the potatoes until the edges curl and the potatoes become golden brown and crisp, 3 to 4 minutes total. Transfer the fried potatoes to a baking sheet lined with paper towels and immediately sprinkle with some of the spice mix.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When all of the chips are fried, transfer them to a large bowl or serving platter and sprinkle on any remaining spice mix. Serve immediately.",
      "secondary_message": null
    }
  ],
