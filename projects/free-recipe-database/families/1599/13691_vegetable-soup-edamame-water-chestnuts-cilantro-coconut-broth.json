  "instructions": [
    {
      "id": 227834,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 medium carrots\n2 medium yellow potatoes\n1 red bell pepper\n1 small bunch cilantro"
    },
    {
      "id": 227835,
      "primary_message": "Peel and mince the ginger and garlic; transfer both to a medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 227836,
      "primary_message": "Peel and medium dice the carrots and potatoes; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 227837,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227838,
      "primary_message": "While the pot heats up, peel and small dice the onion; add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 227839,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper to the pot; cook, stirring often, until they begin to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 227840,
      "primary_message": "While the veggies cook, seed and slice bell pepper into thin, bite-sized strips.",
      "secondary_message": null
    },
    {
      "id": 227841,
      "primary_message": "Add the bell pepper, broth, coconut milk, soy sauce, and sugar to the pot; stir to combine and bring to a boil.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n4 tsp soy sauce\n1 tsp brown sugar"
    },
    {
      "id": 227842,
      "primary_message": "Meanwhile, drain and rinse the water chestnuts in a colander.",
      "secondary_message": "10 oz water chestnuts"
    },
    {
      "id": 227843,
      "primary_message": "Once the soup comes to a boil, add water chestnuts, edamame, and corn. Return to a boil, then reduce heat to low and simmer until edamame is heated through and veggies are tender, 5 minutes more.",
      "secondary_message": "1 ½ cups edamame\n1 cup frozen corn"
    },
    {
      "id": 227844,
      "primary_message": "Shave cilantro leaves off the stems; discard stems. Add cilantro to the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 227845,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
