  "instructions": [
    {
      "id": 227894,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 medium carrot\n1 medium yellow potato\n½ red bell pepper\n½ small bunch cilantro"
    },
    {
      "id": 227895,
      "primary_message": "Peel and mince the ginger and garlic; transfer both to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 227896,
      "primary_message": "Peel and medium dice carrot and potato; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 227897,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227898,
      "primary_message": "While the pan heats up, peel and small dice shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 227899,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper to the pan; cook, stirring often, until they begin to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 227900,
      "primary_message": "While the veggies cook, seed and slice bell pepper into thin, bite-sized strips.",
      "secondary_message": null
    },
    {
      "id": 227901,
      "primary_message": "Add the bell pepper, broth, coconut milk, soy sauce, and sugar to the pan; stir to combine and bring to a boil.",
      "secondary_message": "473 ml chicken or vegetable broth\n½ (398 ml) can coconut milk\n2 tsp soy sauce\n½ tsp brown sugar"
    },
    {
      "id": 227902,
      "primary_message": "Meanwhile, drain and rinse the water chestnuts in a colander.",
      "secondary_message": "142 g water chestnuts"
    },
    {
      "id": 227903,
      "primary_message": "Once the soup comes to a boil, add water chestnuts, edamame, and corn. Return to a boil, then reduce heat to low and simmer until edamame is heated through and veggies are tender, 5 minutes more.",
      "secondary_message": "¾ cup edamame, shelled\n½ cup frozen corn"
    },
    {
      "id": 227904,
      "primary_message": "Shave cilantro leaves off the stems; discard stems. Add cilantro to the pan, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 227905,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
