  "instructions": [
    {
      "id": 227918,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 medium carrots\n3 medium yellow potatoes\n1 ½ red bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 227919,
      "primary_message": "Peel and mince the ginger and garlic; transfer both to a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 227920,
      "primary_message": "Peel and medium dice the carrots and potatoes; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 227921,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227922,
      "primary_message": "While the pot heats up, peel and small dice the onion; add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 227923,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper to the pot; cook, stirring often, until they begin to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 227924,
      "primary_message": "While the veggies cook, seed and slice bell peppers into thin, bite-sized strips.",
      "secondary_message": null
    },
    {
      "id": 227925,
      "primary_message": "Add the bell pepper, broth, coconut milk, soy sauce, and sugar to the pot; stir to combine and bring to a boil.",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk\n2 tbsp soy sauce\n1 ½ tsp brown sugar"
    },
    {
      "id": 227926,
      "primary_message": "Meanwhile, drain and rinse the water chestnuts in a colander.",
      "secondary_message": "425 g water chestnuts"
    },
    {
      "id": 227927,
      "primary_message": "Once the soup comes to a boil, add water chestnuts, edamame, and corn. Return to a boil, then reduce heat to low and simmer until edamame is heated through and veggies are tender, 5-7 minutes more.",
      "secondary_message": "2 ¼ cups edamame\n1 ½ cups frozen corn"
    },
    {
      "id": 227928,
      "primary_message": "Shave cilantro leaves off the stems; discard stems. Add cilantro to the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 227929,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
