  "instructions": [
    {
      "id": 194356,
      "primary_message": "Preheat the oven to 425°F and position rack in the center. ",
      "secondary_message": null
    },
    {
      "id": 194357,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "2 cups basmati rice\n4 cup water\n1 tsp salt"
    },
    {
      "id": 194358,
      "primary_message": "Once the liquid for the rice comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 194359,
      "primary_message": "Cut chicken into bite-sized pieces. Add to a medium bowl and sprinkle with cornstarch and salt; toss to coat. Add chicken to one half of a large baking sheet, then place in the oven and bake for 10 minutes.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¼ cup cornstarch\n1 tsp salt"
    },
    {
      "id": 194360,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 194361,
      "primary_message": "Wash broccoli. Separate into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 194362,
      "primary_message": "Remove the chicken from the oven and toss; add broccoli to the other half of the baking sheet. Drizzle broccoli with sesame oil and season with salt and pepper. Return tray to the oven until chicken and broccoli are cooked, about 10 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 194363,
      "primary_message": "Meanwhile, add honey, chili-garlic sauce, vinegar, and sesame oil to the bowl with the garlic; whisk until well combined. ",
      "secondary_message": "2 tbsp honey\n2 tbsp chili-garlic sauce\n1 tsp rice vinegar\n1 tsp toasted sesame oil"
    },
    {
      "id": 194364,
      "primary_message": "Wash the green onions, trim off and discard the ends; cut the onions crosswise into ¼-inch pieces.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 194365,
      "primary_message": "When the chicken is done add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 194366,
      "primary_message": "To serve, divide rice, chicken, and broccoli between bowls. Top with green onions and sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
