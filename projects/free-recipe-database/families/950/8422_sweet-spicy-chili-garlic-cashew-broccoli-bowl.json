  "instructions": [
    {
      "id": 194378,
      "primary_message": "Preheat the oven to 425°F and position rack in the center. ",
      "secondary_message": null
    },
    {
      "id": 194379,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 194380,
      "primary_message": "Wash broccoli. Separate into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 194381,
      "primary_message": "Once the liquid for the rice comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 194382,
      "primary_message": "Add broccoli to a baking sheet. Drizzle with sesame oil and season with salt and pepper. Bake until tender-crisp, about 10 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 194383,
      "primary_message": "Meanwhile, peel and mince garlic; add to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 194384,
      "primary_message": "Add maple syrup, chili-garlic sauce, vinegar, and sesame oil to the bowl with the garlic; whisk until well combined. ",
      "secondary_message": "1 tbsp pure maple syrup\n1 tbsp chili-garlic sauce\n½ tsp rice vinegar\n½ tsp toasted sesame oil"
    },
    {
      "id": 194385,
      "primary_message": "Wash and trim off the ends of the green onions; cut the onions crosswise into ¼-inch pieces.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 194386,
      "primary_message": "When the broccoli is done, add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 194387,
      "primary_message": "To serve, divide rice and broccoli between bowls. Top with cashews and sesame seeds and enjoy!",
      "secondary_message": "1 cup cashews, roasted unsalted\n1 tsp sesame seeds"
    }
  ],
