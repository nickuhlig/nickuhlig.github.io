  "instructions": [
    {
      "id": 467375,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 467376,
      "primary_message": "Meanwhile, peel, halve, and slice onion crosswise into thin half-moons. Place in a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 467377,
      "primary_message": "Once the water in the pan is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "1 (454 g) pkg potato gnocchi\n½ tsp salt"
    },
    {
      "id": 467378,
      "primary_message": "While the gnocchi are cooking, wash, dry, trim, and seed bell pepper; medium dice. Add bell pepper and mushrooms to the bowl with the onion.",
      "secondary_message": "½ red bell pepper\n1 (227g ) pkg sliced white mushrooms"
    },
    {
      "id": 467379,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467380,
      "primary_message": "While the skillet heats up, slice sausages into ½-inch-thick rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 467381,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, sausage, salt, and pepper; cook, stirring occasionally, until veggies soften and sausage is warmed through, 4-5 minutes. (Or cook sausage according to package instructions.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 467382,
      "primary_message": "Meanwhile, drain sauerkraut in a colander to remove excess liquid.",
      "secondary_message": "⅔ cup sauerkraut"
    },
    {
      "id": 467383,
      "primary_message": "When the veggies and sausage are done, add cooked gnocchi and sauerkraut to the skillet; stir to combine. Continue to cook, stirring occasionally, until gnocchi are warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 467384,
      "primary_message": "To serve, divide gnocchi, sausage, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
