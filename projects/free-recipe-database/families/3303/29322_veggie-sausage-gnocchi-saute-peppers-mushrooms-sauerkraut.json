  "instructions": [
    {
      "id": 467335,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 467336,
      "primary_message": "Meanwhile, peel, halve, and slice onions crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 467337,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "3 (16 oz) pkgs potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 467338,
      "primary_message": "While the gnocchi are cooking, wash, dry, trim, and seed bell peppers; medium dice. Add bell pepper and mushrooms to the bowl with the onion.",
      "secondary_message": "1 ½ red bell peppers\n3 (8 oz) pkgs sliced white mushrooms"
    },
    {
      "id": 467339,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467340,
      "primary_message": "While the pot heats up, slice sausages into ½-inch-thick rounds.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 467341,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, sausage, salt, and pepper; cook, stirring occasionally, until veggies soften and sausage is warmed through, 5-6 minutes. (Or cook sausage according to package instructions.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 467342,
      "primary_message": "Meanwhile, drain sauerkraut in a colander to remove excess liquid.",
      "secondary_message": "2 cups sauerkraut"
    },
    {
      "id": 467343,
      "primary_message": "When the veggies and sausage are done, add cooked gnocchi and sauerkraut to the pot; stir to combine. Continue to cook, stirring occasionally, until gnocchi are warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 467344,
      "primary_message": "To serve, divide gnocchi, sausage, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
