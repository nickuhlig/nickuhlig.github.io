    {
      "ingredient_id": 1610,
      "name": "silken tofu, about 4 ounces",
      "quantity": "¼ to ⅓ large block"
    },
    {
      "ingredient_id": 422,
      "name": "light miso, sweet, preferably Saikyo miso",
      "quantity": "2 tsp"
    },
    {
