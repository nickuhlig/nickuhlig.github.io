  "instructions": [
    {
      "id": 577998,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 577999,
      "primary_message": "Split muffins and arrange, cut-side down, on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes. Remove from oven. ",
      "secondary_message": "2 English muffins"
    },
    {
      "id": 578000,
      "primary_message": "Meanwhile, place tomato sauce and spices in a small bowl. Stir to combine.",
      "secondary_message": "½ (213 ml) can tomato sauce\n¼ tsp Italian seasoning\n1 pinch onion powder\n1 pinch garlic powder\n1 pinch salt"
    },
    {
      "id": 578001,
      "primary_message": "Drain olives.",
      "secondary_message": "½ (108 g) can sliced black olives"
    },
    {
      "id": 578002,
      "primary_message": "Spread toasted muffins with tomato sauce, then top with cheese and olives.",
      "secondary_message": "⅓ cup shredded cheese, Italian blend"
    },
    {
      "id": 578003,
      "primary_message": "Return baking sheet to the oven and broil until pizzas are warmed through and cheese is melted, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 578004,
      "primary_message": "To serve, divide pizzas between plates and enjoy! ",
      "secondary_message": null
    }
  ],
