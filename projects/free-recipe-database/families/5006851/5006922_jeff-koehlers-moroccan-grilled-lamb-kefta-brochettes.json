  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the parsley leaves from the stems and chop them. Pick the cilantro leaves from the stems and chop them. Grate the red onion.",
      "secondary_message": "¼ cup loosely packed parsley\n½ cup loosely packed cilantro\n1 medium red onion"
    },
    {
      "id": 1,
      "primary_message": "If using wooden skewers, soak them in a shallow dish of water while preparing the meat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In the meantime, in a medium bowl, combine ground meat and remaining ingredients except the onion and olive oil. Incoporate most of the grated onion, taking care to not make the mixture too wet; it should remain somewhat sticky, like the texture of sausage. If the meat is relatively lean, add some olive oil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Take a palmful of meat and press it around the middle of a skewer, then roll it lightly on a cutting board or between your palms to form an even \"sausage\" around the skewer about 15 cm long. Repeat with remaining skewers and meat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over entire surface of coal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Grill the skewers, turning once, until firm to the touch and cooked through. Serve hot.",
      "secondary_message": null
    }
  ],
