  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and cut the sweet potatoes into 1/2-inch chunks.",
      "secondary_message": "1.4 kg sweet potatoes"
    },
    {
      "id": 1,
      "primary_message": "Place sweet potatoes in a large saucepan and cover with cold water. Heat water to 70°C as registered on an instant-read thermometer. Cover and set aside for 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven racks to upper-middle and lower-middle positions and preheat oven to 200°C (400°F). Drain sweet potatoes and transfer to a large bowl. Toss with oil and season to taste with salt and pepper. Spread sweet potatoes on 2 rimmed baking sheets and roast until bottom sides are browned, about 30 minutes. Carefully flip potatoes with a thin spatula and roast until second side is browned and potatoes are tender, about 20 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, in a small container, sprinkle gelatin over chicken stock and let bloom for 5 minutes. Microwave until gelatin is dissolved, stopping and stirring as needed to help it dissolve, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a small saucepan, melt butter over medium-high heat until foamy. Continue to cook, swirling pan, until milk solids in butter turn a deep hazelnut brown, 1 to 2 minutes. Remove from heat and add rosemary (don't be alarmed; butter will foam and fizzle when rosemary is added), swirling to coat.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add chicken stock to butter, return to medium heat, and bring to a simmer. Cook, swirling, until stock reduces slightly and sauce becomes rich and silky, about 3 minutes. Remove from heat, discard rosemary, and add lemon juice. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "In a mixing bowl, toss potatoes with butter sauce and serve. Potatoes can be made in advance, tossed with sauce, and set aside until ready to serve; rewarm in the oven before serving.",
      "secondary_message": null
    }
  ],
