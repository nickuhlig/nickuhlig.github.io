  "instructions": [
    {
      "id": 166962,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ avocado\n1 tomato"
    },
    {
      "id": 166963,
      "primary_message": "Halve the avocado and remove pit; cut the flesh into chunks while still in the skin and scoop into a medium bowl. Mash slightly using a fork. ",
      "secondary_message": null
    },
    {
      "id": 166964,
      "primary_message": "Peel and mince the shallot and small dice the tomato. Add both to the bowl with the avocado along with the spices; mix to combine.",
      "secondary_message": "½ shallot\n1 tsp chili powder\n½ tsp cumin\n¼ tsp salt"
    },
    {
      "id": 166965,
      "primary_message": "Grate cheese into a medium bowl.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 166966,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 166967,
      "primary_message": "Break the eggs into the bowl with the cheese; add salt and pepper and whisk to combine.",
      "secondary_message": "4 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 166968,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add egg mixture to the skillet.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 166969,
      "primary_message": "Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 166970,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "4 small corn tortillas"
    },
    {
      "id": 166971,
      "primary_message": "To serve, divide the scrambled eggs between the tortillas and top with the guacamole. Enjoy!",
      "secondary_message": null
    }
  ],
