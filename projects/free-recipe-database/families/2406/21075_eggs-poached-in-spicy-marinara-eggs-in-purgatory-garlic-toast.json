  "instructions": [
    {
      "id": 425500,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 425501,
      "primary_message": "Wash, dry, trim, and seed bell peppers; medium dice.",
      "secondary_message": "3 yellow bell peppers"
    },
    {
      "id": 425502,
      "primary_message": "Peel and mince garlic. Place half in a small bowl and set aside for the garlic toast.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 425503,
      "primary_message": "Preheat two large skillets over medium heat.",
      "secondary_message": null
    },
    {
      "id": 425504,
      "primary_message": "Once the skillets are hot, divide oil between them and swirl to coat the bottoms. Divide bell pepper, remaining garlic, and crushed red pepper between the skillets. Cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp crushed red pepper"
    },
    {
      "id": 425505,
      "primary_message": "When the pepper is soft, increase heat to medium-high and divide marinara between the skillets. Stir to combine and bring to a simmer.",
      "secondary_message": "3 (680 g) jars marinara sauce"
    },
    {
      "id": 425506,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; roughly chop.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 425507,
      "primary_message": "Once the sauce is simmering, add basil to the skillets and stir to combine. Using a stirring spoon, make a well for each egg in the marinara; crack an egg into each well. Cover and cook until the egg whites are firm but yolks are still soft, about 5 minutes. Remove from heat.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 425508,
      "primary_message": "While the eggs are cooking, add oil and spices to the bowl with the remaining garlic. Stir to combine the garlic oil.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n¼ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 425509,
      "primary_message": "Split rolls in half and divide between two baking sheet pans; drizzle with the garlic oil.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 425510,
      "primary_message": "Working in batches, place baking sheets in the oven and broil until rolls are toasted, 1-2 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425511,
      "primary_message": "Divide eggs and sauce between plates or bowls and sprinkle with Parmesan. Serve with garlic toast on the side. Enjoy!",
      "secondary_message": "1 cup Parmesan cheese, shredded"
    }
  ],
