  "instructions": [
    {
      "id": 425476,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 425477,
      "primary_message": "Wash, dry, trim, and seed bell pepper; medium dice.",
      "secondary_message": "1 yellow bell pepper"
    },
    {
      "id": 425478,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 425479,
      "primary_message": "While the skillet heats up, peel and mince garlic. Place half in a small bowl and set aside for the garlic toast.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 425480,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, remaining garlic, and crushed red pepper. Cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 425481,
      "primary_message": "When the pepper is soft, increase heat to medium-high and add marinara to the skillet. Stir to combine and bring to a simmer.",
      "secondary_message": "1 (680 g) jar marinara sauce"
    },
    {
      "id": 425482,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; roughly chop.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 425483,
      "primary_message": "Once the sauce is simmering, add basil and stir to combine. Using a stirring spoon, make a well for each egg in the marinara; crack an egg into each well. Cover and cook until the egg whites are firm but yolks are still soft, about 5 minutes. Remove from heat.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 425484,
      "primary_message": "While the eggs are cooking, add oil and spices to the bowl with the remaining garlic. Stir to combine the garlic oil.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 425485,
      "primary_message": "Split rolls in half and arrange on a baking sheet pan; drizzle with the garlic oil.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 425486,
      "primary_message": "Place baking sheet in the oven and broil until rolls are toasted, 1-2 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425487,
      "primary_message": "Divide eggs and sauce between plates or bowls and sprinkle with Parmesan. Serve with garlic toast on the side. Enjoy!",
      "secondary_message": "⅓ cup Parmesan cheese, shredded"
    }
  ],
