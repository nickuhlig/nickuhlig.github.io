  "instructions": [
    {
      "id": 359995,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 359996,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 359997,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)\n2 sticks celery"
    },
    {
      "id": 359998,
      "primary_message": "Once the water is boiling, add noodles and cook according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water; set aside.",
      "secondary_message": "5 oz soba (buckwheat) noodles"
    },
    {
      "id": 359999,
      "primary_message": "While the noodles are cooking, peel and mince ginger. Place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 360000,
      "primary_message": "Trim and thinly slice green onions crosswise; add to the bowl with the ginger. ",
      "secondary_message": null
    },
    {
      "id": 360001,
      "primary_message": "Trim and thinly slice celery crosswise; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 360002,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 360003,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, garlic powder, and salt; cook, stirring occasionally, until veggies have softened, 3-4 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n½ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 360004,
      "primary_message": "Meanwhile, medium dice the tofu. ",
      "secondary_message": null
    },
    {
      "id": 360005,
      "primary_message": "Add tofu, broccoli, hoisin sauce, and water to the skillet; stir to combine and cover with a lid. Continue to cook, stirring occasionally, until broccoli is tender and tofu is warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "½ (18 oz) bag broccoli florets\n¼ cup hoisin sauce\n¼ cup water"
    },
    {
      "id": 360006,
      "primary_message": "To serve, divide noodles, stir-fry, and sauce between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
