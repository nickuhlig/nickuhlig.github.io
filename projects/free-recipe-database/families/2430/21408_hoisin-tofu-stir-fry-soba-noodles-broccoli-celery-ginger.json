  "instructions": [
    {
      "id": 360019,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 360020,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 360021,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n6 sticks celery"
    },
    {
      "id": 360022,
      "primary_message": "Once the water is boiling, add noodles and cook according to package directions, about 5 minutes. Once done, drain and rinse thoroughly under cold water; set aside.",
      "secondary_message": "15 oz soba (buckwheat) noodles"
    },
    {
      "id": 360023,
      "primary_message": "While the noodles are cooking, peel and mince ginger. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 360024,
      "primary_message": "Trim and thinly slice green onions crosswise; add to the bowl with the ginger. ",
      "secondary_message": null
    },
    {
      "id": 360025,
      "primary_message": "Trim and thinly slice celery crosswise; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 360026,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 360027,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, garlic powder, and salt; cook, stirring occasionally, until veggies have softened, 3-4 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 ½ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 360028,
      "primary_message": "Meanwhile, medium dice the tofu. ",
      "secondary_message": null
    },
    {
      "id": 360029,
      "primary_message": "Add tofu, broccoli, hoisin sauce, and water to the skillet; stir to combine and cover with a lid. Continue to cook, stirring occasionally, until broccoli is tender and tofu is warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 ½ (18 oz) bags broccoli florets\n¾ cup hoisin sauce\n¾ cup water"
    },
    {
      "id": 360030,
      "primary_message": "To serve, divide noodles, stir-fry, and sauce between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
