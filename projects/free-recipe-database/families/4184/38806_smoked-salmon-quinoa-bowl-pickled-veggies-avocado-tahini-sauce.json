  "instructions": [
    {
      "id": 604463,
      "primary_message": "In a medium saucepan, combine broth and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup quinoa"
    },
    {
      "id": 604464,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n1 bunch radish\n1 lemon\n2 (2 ½ cm) pieces ginger root\n2 avocados"
    },
    {
      "id": 604465,
      "primary_message": "Place vinegar, honey, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "¼ cup red wine vinegar\n4 tsp honey\n1 tsp salt"
    },
    {
      "id": 604466,
      "primary_message": "Trim and slice cucumber and radishes crosswise into thin rounds. Add both to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 604467,
      "primary_message": "Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 604468,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the lemon juice along with oil, tahini, soy sauce, and pepper. Whisk to combine the sauce and set aside.",
      "secondary_message": "2 cloves garlic\n¼ cup extra virgin olive oil\n3 tbsp tahini\n2 tbsp soy sauce\n⅛ tsp black pepper"
    },
    {
      "id": 604469,
      "primary_message": "Right before serving, halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 604470,
      "primary_message": "To serve, divide quinoa, pickled veggies, avocado, and smoked salmon between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": "2 (113 g) pkgs smoked salmon"
    }
  ],
