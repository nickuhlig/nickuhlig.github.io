  "instructions": [
    {
      "id": 604407,
      "primary_message": "In a small saucepan, combine broth and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ cup quinoa"
    },
    {
      "id": 604408,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n½ bunch radish\n½ lemon\n1 (1 inch) piece ginger root\n1 avocado"
    },
    {
      "id": 604409,
      "primary_message": "Place vinegar, honey, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "2 tbsp red wine vinegar\n2 tsp honey\n½ tsp salt"
    },
    {
      "id": 604410,
      "primary_message": "Trim and slice cucumber and radishes crosswise into thin rounds. Add both to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 604411,
      "primary_message": "Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 604412,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the lemon juice along with oil, tahini, soy sauce, and pepper. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 clove garlic\n2 tbsp extra virgin olive oil\n1 ½ tbsp tahini\n1 tbsp soy sauce\n1 pinch black pepper"
    },
    {
      "id": 604413,
      "primary_message": "Right before serving, halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 604414,
      "primary_message": "To serve, divide quinoa, pickled veggies, avocado, and smoked salmon between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    }
  ],
