  "instructions": [
    {
      "id": 512387,
      "primary_message": "Preheat oven to 245°C (475°F).",
      "secondary_message": null
    },
    {
      "id": 512388,
      "primary_message": "Divide flatbreads between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 5-6 minutes. Remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 512389,
      "primary_message": "Meanwhile, place cottage cheese in a strainer and press gently with the back of a spoon to remove excess liquid. Set aside to drain further.",
      "secondary_message": "3 cups cottage cheese"
    },
    {
      "id": 512390,
      "primary_message": "When the flatbreads are done, spread the drained cottage cheese over top, creating a large well in the center of each. Crack an egg into each well.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 512391,
      "primary_message": "Return baking sheets to the oven and bake until eggs are just set, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 512392,
      "primary_message": "Meanwhile, chop or tear smoked salmon into bite-sized pieces. Place on a plate.",
      "secondary_message": "3 (113 g) pkgs smoked salmon"
    },
    {
      "id": 512393,
      "primary_message": "Peel and mince shallots. Add to the plate with the salmon, along with capers, and set aside for serving.",
      "secondary_message": "2 shallots\n4 ½ tbsp capers"
    },
    {
      "id": 512394,
      "primary_message": "About 5 minutes before the flatbreads are done, place oil, vinegar, Dijon, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp apple cider vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 512395,
      "primary_message": "Wash, dry, trim, and slice radishes crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": "1 ½ bunches radish"
    },
    {
      "id": 512396,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and radish, then toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 512397,
      "primary_message": "When the flatbreads are done, top with smoked salmon, minced shallot, and capers, then cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 512398,
      "primary_message": "To serve, divide flatbreads and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
