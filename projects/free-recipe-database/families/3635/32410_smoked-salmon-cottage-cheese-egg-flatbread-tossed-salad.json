  "instructions": [
    {
      "id": 512327,
      "primary_message": "Preheat oven to 475°F.",
      "secondary_message": null
    },
    {
      "id": 512328,
      "primary_message": "Arrange flatbreads on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 512329,
      "primary_message": "Meanwhile, place cottage cheese in a strainer and press gently with the back of a spoon to remove excess liquid. Set aside to drain further.",
      "secondary_message": "1 cup cottage cheese"
    },
    {
      "id": 512330,
      "primary_message": "When the flatbreads are done, spread the drained cottage cheese over top, creating a large well in the center of each. Crack an egg into each well.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 512331,
      "primary_message": "Return baking sheet to the oven and bake until eggs are just set, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 512332,
      "primary_message": "Meanwhile, chop or tear smoked salmon into bite-sized pieces. Place on a plate.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 512333,
      "primary_message": "Peel and mince shallot. Add to the plate with the salmon, along with capers, and set aside for serving.",
      "secondary_message": "½ shallot\n1 ½ tbsp capers"
    },
    {
      "id": 512334,
      "primary_message": "About 5 minutes before the flatbreads are done, place oil, vinegar, Dijon, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp apple cider vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 512335,
      "primary_message": "Wash, dry, trim, and slice radishes crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": "½ bunch radish"
    },
    {
      "id": 512336,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl with the dressing and radish, then toss to combine the salad.",
      "secondary_message": "½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 512337,
      "primary_message": "When the flatbreads are done, top with smoked salmon, minced shallot, and capers, then cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 512338,
      "primary_message": "To serve, divide flatbreads and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
