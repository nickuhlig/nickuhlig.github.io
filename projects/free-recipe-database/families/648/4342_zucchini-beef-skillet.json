  "instructions": [
    {
      "id": 49045,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n½ small bunch cilantro"
    },
    {
      "id": 49048,
      "primary_message": "Trim off and discard the ends of the zucchini; halve the zucchini lengthwise, then cut the halves crosswise into ¼-inch-thick half-rounds at an angle. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 49046,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion into ¼-inch pieces. Add to the bowl with the zucchini.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 49047,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the zucchini and onion.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 49050,
      "primary_message": "Add coconut oil to a nonstick skillet and preheat over medium-high heat.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 49051,
      "primary_message": "Add the ground beef to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer to a bowl, leaving some of the juices in the skillet.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 49052,
      "primary_message": "Once the beef has been transferred, add the zucchini, onion, and garlic to the skillet. Cook, stirring frequently, until the vegetables are tender and lightly browned, 4 to 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 49049,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 49053,
      "primary_message": "Add chili powder, cumin, salt, and pepper to the skillet; stir to combine.",
      "secondary_message": "1 tsp chili powder\n½ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 49054,
      "primary_message": "Return the ground beef to the skillet and add in about ¾ of the cilantro (save the rest for garnishing); stir to combine.",
      "secondary_message": null
    },
    {
      "id": 49055,
      "primary_message": "Divide the meal between plates and garnish with the remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
