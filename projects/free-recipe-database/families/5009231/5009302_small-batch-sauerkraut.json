  "ingredients": [
    {
      "ingredient_id": 2715,
      "name": "cabbage",
      "quantity": "1 small"
    },
    {
      "ingredient_id": 88,
      "name": "sea salt",
      "quantity": "1 tbsp"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "Remove core from cabbage. Cut in half and finely shred.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place cut cabbage in large bowl and sprinkle salt on top.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using your hands, knead the salt into the cabbage, squeezing firmly to help release liquid from the cabbage. You can also use a potato masher to pound the cabbage until it begins to break down.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When the volume of cabbage appears to have reduced by half, add the caraways seeds and work them in.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pack the salted cabbage into the quart jar in layers, firmly pressing it down each time before adding more (the entire 0.91 kg of cabbage should fit into a quart jar).",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Press cabbage down firmly in the jar, so that liquid bubbles up over the surface of the jar.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Loosely cap the jar and place it in a cool, dark spot.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Check every other day, removing any bloom and pressing cabbage down if it has floated above the liquid (be warned, it will be a bit stinky. That’s normal).",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "After two weeks, taste the sauerkraut. If you like the flavor, place the jar in the refrigerator. If you want something a bit stronger, let it continue to ferment until it pleases you.",
      "secondary_message": null
    }
  ],
