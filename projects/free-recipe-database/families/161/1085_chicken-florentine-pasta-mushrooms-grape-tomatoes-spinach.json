  "instructions": [
    {
      "id": 8437,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain once cooked.",
      "secondary_message": "1 tbsp salt\n6 oz (1 quarter coin = 2 oz) linguine pasta"
    },
    {
      "id": 8438,
      "primary_message": "Wash and dry spinach. Wash tomatoes and mushrooms. Halve the tomatoes. Quarter the mushrooms. Peel and mince garlic.",
      "secondary_message": "½ (5 oz) pkg baby spinach\r\n1 pint grape tomatoes\r\n¼ lb white mushrooms\r\n2 cloves garlic"
    },
    {
      "id": 8439,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 8440,
      "primary_message": "Cut chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "½ lb chicken breasts, boneless skinless\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 8441,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until browned and cooked through, 1-2 minutes per side. Transfer to a plate and set aside.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 8442,
      "primary_message": "Return skillet to stove, reduce heat to medium, and add more oil (if needed). Add garlic and cook until fragrant, 15-30 seconds. Add mushrooms and season with salt and pepper. Cook until tender, 3-4 minutes.",
      "secondary_message": "about 1 tbsp virgin coconut oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 8443,
      "primary_message": "Grate or shave ⅛ cup of Parmesan.",
      "secondary_message": "½ oz Parmesan cheese"
    },
    {
      "id": 8444,
      "primary_message": "Add broth and cook until reduced by about ½. Remove pan from heat.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 8445,
      "primary_message": "Return chicken to skillet and add tomatoes, spinach, and pasta. Toss until ingredients are mixed and spinach is wilted.",
      "secondary_message": ""
    },
    {
      "id": 8446,
      "primary_message": "To serve, place pasta on a plate or in a bowl and sprinkle with Parmesan. Enjoy!",
      "secondary_message": ""
    }
  ],
