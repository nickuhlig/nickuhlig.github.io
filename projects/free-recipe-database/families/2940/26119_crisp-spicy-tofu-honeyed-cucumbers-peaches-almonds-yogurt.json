  "instructions": [
    {
      "id": 415506,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 415507,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 415508,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 415509,
      "primary_message": "While the skillet heats up, roughly chop almonds.",
      "secondary_message": "¼ cup almonds"
    },
    {
      "id": 415510,
      "primary_message": "Once the skillet is hot, add the almonds; cook, stirring constantly, until lightly browned, 2-3 minutes. Transfer to a medium bowl and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 415511,
      "primary_message": "Meanwhile, place oil and spices in another medium bowl. Stir to combine the spice oil.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp paprika\n½ tsp cumin, ground\n½ tsp coriander, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 415512,
      "primary_message": "Medium dice tofu, add to the bowl with the spice oil, and gently stir to coat. Wipe the baking sheet dry with paper towels, then coat with a thin layer of oil; set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 415513,
      "primary_message": "Sprinkle bread crumbs over the tofu and stir once more to coat. Return tofu to the baking sheet and spread out in a single layer. (Wipe bowl clean with paper towels and reserve for later use.)",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 415514,
      "primary_message": "Place baking sheet in the oven and bake until tofu is golden brown and crispy, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 415515,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ small bunch Italian (flat-leaf) parsley\n1 English cucumber\n2 peaches"
    },
    {
      "id": 415516,
      "primary_message": "Zest and juice half of the lemon into the reserved bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415517,
      "primary_message": "Pick parsley leaves off the stems; discard stems. Mince half of the leaves and add to the bowl with the lemon. Roughly chop remaining leaves and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415518,
      "primary_message": "Add yogurt and salt to the bowl, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¼ tsp salt"
    },
    {
      "id": 415519,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl with the almonds.",
      "secondary_message": null
    },
    {
      "id": 415520,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl. Season the salad with salt, then stir to combine.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 415521,
      "primary_message": "Divide tofu and lemony yogurt between plates. Top yogurt with the salad and reserved parsley, then drizzle with honey. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "2 tsp honey"
    }
  ],
