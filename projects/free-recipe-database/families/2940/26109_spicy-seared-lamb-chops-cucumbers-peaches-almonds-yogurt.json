  "instructions": [
    {
      "id": 415354,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 415355,
      "primary_message": "While the skillet heats up, roughly chop almonds.",
      "secondary_message": "¾ cup almonds"
    },
    {
      "id": 415356,
      "primary_message": "Once the skillet is hot, add the almonds; cook, stirring constantly, until lightly browned, 3-4 minutes. Transfer to a large bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 415357,
      "primary_message": "Place spices in a medium bowl. Stir to combine the spice rub.",
      "secondary_message": "1 ½ tsp salt\n1 ½ tsp paprika\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp cayenne pepper"
    },
    {
      "id": 415358,
      "primary_message": "Pat the lamb chops dry with paper towels and place on a plate; season with the spice rub on both sides. (Reserve bowl for later use.)",
      "secondary_message": "12 lamb loin chops"
    },
    {
      "id": 415359,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415360,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add chops and sear, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 415361,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch Italian (flat-leaf) parsley\n3 English cucumbers\n6 peaches"
    },
    {
      "id": 415362,
      "primary_message": "Zest and juice half of the lemons into the reserved bowl. Cut remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415363,
      "primary_message": "Meanwhile, pick parsley leaves off the stems; discard stems. Mince half of the leaves and add to the bowl with the lemon. Roughly chop remaining leaves and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415364,
      "primary_message": "Add yogurt and salt to the bowl, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 415365,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl with the almonds.",
      "secondary_message": null
    },
    {
      "id": 415366,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and add to the bowl. Season the salad with salt, then stir to combine.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 415367,
      "primary_message": "Divide chops and lemony yogurt between plates. Top yogurt with the salad and reserved parsley, then drizzle with honey. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "2 tbsp honey"
    }
  ],
