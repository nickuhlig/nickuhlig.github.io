  "instructions": [
    {
      "id": 415400,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 415401,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 415402,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 415403,
      "primary_message": "While the skillet heats up, roughly chop almonds.",
      "secondary_message": "¾ cup almonds"
    },
    {
      "id": 415404,
      "primary_message": "Once the skillet is hot, add the almonds; cook, stirring constantly, until lightly browned, 3-4 minutes. Transfer to a large bowl and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 415405,
      "primary_message": "Meanwhile, place oil and spices in another large bowl. Stir to combine the spice oil.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt\n1 ½ tsp paprika\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp cayenne pepper"
    },
    {
      "id": 415406,
      "primary_message": "Medium dice tofu, add to the bowl with the spice oil, and gently stir to coat. Wipe the baking sheet dry with paper towels, then coat with a thin layer of oil; set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 415407,
      "primary_message": "Sprinkle bread crumbs over the tofu and stir once more to coat. Return tofu to the baking sheet and spread out in a single layer. (Wipe bowl clean with paper towels and reserve for later use.)",
      "secondary_message": "1 ½ cup panko bread crumbs"
    },
    {
      "id": 415408,
      "primary_message": "Place baking sheet in the oven and bake until tofu is golden brown and crispy, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 415409,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch Italian (flat-leaf) parsley\n3 English cucumbers\n6 peaches"
    },
    {
      "id": 415410,
      "primary_message": "Zest and juice half of the lemons into the reserved bowl. Cut remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415411,
      "primary_message": "Pick parsley leaves off the stems; discard stems. Mince half of the leaves and add to the bowl with the lemon. Roughly chop remaining leaves and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415412,
      "primary_message": "Add yogurt and salt to the bowl, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 415413,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl with the almonds.",
      "secondary_message": null
    },
    {
      "id": 415414,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl. Season the salad with salt, then stir to combine.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 415415,
      "primary_message": "Divide tofu and lemony yogurt between plates. Top yogurt with the salad and reserved parsley, then drizzle with honey. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "2 tbsp honey"
    }
  ],
