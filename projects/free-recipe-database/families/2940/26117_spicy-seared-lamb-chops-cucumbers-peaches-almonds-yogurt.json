  "instructions": [
    {
      "id": 415478,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 415479,
      "primary_message": "While the skillet heats up, roughly chop almonds.",
      "secondary_message": "½ cup almonds"
    },
    {
      "id": 415480,
      "primary_message": "Once the skillet is hot, add the almonds; cook, stirring constantly, until lightly browned, 2-3 minutes. Transfer to a medium bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 415481,
      "primary_message": "Place spices in a small bowl. Stir to combine the spice rub.",
      "secondary_message": "1 tsp salt\n1 tsp paprika\n1 tsp cumin, ground\n1 tsp coriander, ground\n½ tsp cayenne pepper"
    },
    {
      "id": 415482,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415483,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with the spice rub on both sides. (Reserve bowl for later use.)",
      "secondary_message": "8 lamb loin chops"
    },
    {
      "id": 415484,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and sear, flipping once, until cooked through, 5-6 minutes. Remove to a clean plate, loosely cover with aluminum foil, and set aside to rest. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 415485,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 small bunch Italian (flat-leaf) parsley\n2 English cucumbers\n4 peaches"
    },
    {
      "id": 415486,
      "primary_message": "Zest and juice one lemon into the reserved bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415487,
      "primary_message": "Meanwhile, pick parsley leaves off the stems; discard stems. Mince half of the leaves and add to the bowl with the lemon. Roughly chop remaining leaves and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 415488,
      "primary_message": "Add yogurt and salt to the bowl, then whisk to combine the lemony yogurt. Set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 415489,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl with the almonds.",
      "secondary_message": null
    },
    {
      "id": 415490,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and add to the bowl. Season the salad with salt, then stir to combine.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 415491,
      "primary_message": "Divide chops and lemony yogurt between plates. Top yogurt with the salad and reserved parsley, then drizzle with honey. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": "4 tsp honey"
    }
  ],
