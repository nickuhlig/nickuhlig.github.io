  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 375°F. Arrange sweet potatoes in a single layer in a 9- by 13-inch baking dish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small saucepan, combine butter, maple syrup, and miso and cook over medium heat, stirring, until butter is melted and sauce is smooth. Stir in vinegar and ginger and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour miso butter over sweet potatoes and toss to coat. Season with salt and pepper. (Be careful with the salt, as the miso will already be salty.)",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake potatoes, stirring occasionally, until tender when pierced with a knife, about 40 minutes. Serve immediately. (To brown the potatoes more deeply, set them under the broiler for 2 to 3 minutes; watch them closely to make sure they do not burn.)",
      "secondary_message": null
    }
  ],
