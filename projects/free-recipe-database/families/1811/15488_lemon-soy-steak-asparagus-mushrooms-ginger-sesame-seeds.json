  "instructions": [
    {
      "id": 255124,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 255125,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 small bunch asparagus\n2 caps portobello mushrooms\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 255126,
      "primary_message": "Zest and juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 255127,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice, along with coconut aminos, oil, and spices. Whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n1 tbsp coconut aminos\n1 tbsp toasted sesame oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 255128,
      "primary_message": "Add steak to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "⅓ kg striploin (New York strip) steak"
    },
    {
      "id": 255129,
      "primary_message": "Snap or cut off the woody ends of the asparagus; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 255130,
      "primary_message": "Slice mushrooms into ¼-inch thick pieces and add to the baking sheet with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 255131,
      "primary_message": "Peel and mince ginger and additional garlic; sprinkle over the veggies.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 255132,
      "primary_message": "Drizzle veggies with oil and coconut aminos; sprinkle with sesame seeds, salt, and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp coconut aminos\n1 tbsp sesame seeds\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 255133,
      "primary_message": "Place baking sheet in the oven and roast, tossing once, until veggies are fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 255134,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 255135,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the steak and marinade; pan-fry until steak reaches desired doneness, 2-5 minutes per side. Transfer to a plate and let rest 5 minutes.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 255136,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 255137,
      "primary_message": "To serve, divide veggies and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
