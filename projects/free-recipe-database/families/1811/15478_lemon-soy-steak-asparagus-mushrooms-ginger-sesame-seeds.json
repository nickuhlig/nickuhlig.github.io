  "instructions": [
    {
      "id": 254984,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 254985,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 small bunches asparagus\n6 caps portobello mushrooms\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 254986,
      "primary_message": "Zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 254987,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice, along with soy sauce, oil, and spices. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp soy sauce\n3 tbsp toasted sesame oil\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 254988,
      "primary_message": "Add steak to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 254989,
      "primary_message": "Snap or cut off the woody ends of the asparagus; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 254990,
      "primary_message": "Slice mushrooms into ¼-inch thick pieces and add to the baking sheets with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 254991,
      "primary_message": "Peel and mince ginger and additional garlic; sprinkle over the veggies.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 254992,
      "primary_message": "Drizzle veggies with oil and soy sauce; sprinkle with sesame seeds, salt, and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp soy sauce\n3 tbsp sesame seeds\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 254993,
      "primary_message": "Place baking sheets in the oven and roast, tossing once, until veggies are fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 254994,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 254995,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the steak and marinade; pan-fry until steak reaches desired doneness, 2-5 minutes per side. Transfer to a plate and let rest 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 254996,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 254997,
      "primary_message": "To serve, divide veggies and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
