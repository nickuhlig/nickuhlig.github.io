  "instructions": [
    {
      "id": 254970,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 254971,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 small bunches asparagus\n4 caps portobello mushrooms\n2 (1 inch) pieces ginger root"
    },
    {
      "id": 254972,
      "primary_message": "Zest and juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 254973,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice, along with soy sauce, oil, and spices. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n2 tbsp soy sauce\n2 tbsp toasted sesame oil\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 254974,
      "primary_message": "Add steak to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak"
    },
    {
      "id": 254975,
      "primary_message": "Snap or cut off the woody ends of the asparagus; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 254976,
      "primary_message": "Slice mushrooms into ¼-inch thick pieces and add to the baking sheet with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 254977,
      "primary_message": "Peel and mince ginger and additional garlic; sprinkle over the veggies.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 254978,
      "primary_message": "Drizzle veggies with oil and soy sauce; sprinkle with sesame seeds, salt, and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "4 tsp toasted sesame oil\n4 tsp soy sauce\n2 tbsp sesame seeds\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 254979,
      "primary_message": "Place baking sheet in the oven and roast, tossing once, until veggies are fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 254980,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 254981,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the steak and marinade; pan-fry until steak reaches desired doneness, 2-5 minutes per side. Transfer to a plate and let rest 5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 254982,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 254983,
      "primary_message": "To serve, divide veggies and steak between plates. Enjoy!",
      "secondary_message": null
    }
  ],
