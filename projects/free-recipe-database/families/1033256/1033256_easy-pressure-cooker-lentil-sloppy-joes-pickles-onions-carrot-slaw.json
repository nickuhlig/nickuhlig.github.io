  "instructions": [
    {
      "primary_message": "Set a 6-quart electric pressure cooker to sauté on HIGH.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pressure cooker heats up, peel and halve onion. Small dice half of the onion, then slice the other half crosswise into thin half-moons. (Set the half-moons aside for serving.)",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the pressure cooker insert is hot, add oil and swirl to coat the bottom. Add diced onion and garlic; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp minced garlic"
    },
    {
      "primary_message": "Meanwhile, rinse lentils in a colander or strainer.",
      "secondary_message": "1 cup green lentils, dried"
    },
    {
      "primary_message": "When the onion is soft, add lentils, broth, tomato sauce, soy sauce, sugar, and spices to the pressure cooker, then stir to combine. Lock lid and set to pressure cook on HIGH for 15 minutes. Once done, drape a clean towel over the vent, then manually release pressure.",
      "secondary_message": "2 cups vegetable broth\n½ (8 fl oz) can tomato sauce\n1 tbsp soy sauce\n1 tbsp brown sugar\n½ tsp chili powder\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "While the lentils are cooking, place oil, vinegar, Dijon, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n2 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Add carrots to the bowl with the dressing and stir to combine the slaw. Place bowl in the fridge until ready to serve.",
      "secondary_message": "1 ½ (10 oz) bag shredded carrots"
    },
    {
      "primary_message": "When the lentils are done, split and toast buns if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "Place bottom half of each bun on a plate. Top with saucy lentils, sliced onion, and pickles, then close with the top half of each bun. Serve with slaw on the side and enjoy!",
      "secondary_message": "½ cup bread and butter pickle chips"
    }
  ],
