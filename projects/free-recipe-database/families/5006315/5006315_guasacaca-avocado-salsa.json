  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Seed and roughly dice the ripe Haas avocados. Quarter the onion. Stem, seed, and roughly chop the green bell pepper. Pick the cilantro leaves from the stems and roughly chop them. Pick the parsley leaves from the stems and roughly chop them. Juice the lime.",
      "secondary_message": "2 ripe Haas avocados\n1 small onion\n1 small green bell pepper\n½ cup packed fresh cilantro leaves\n¼ cup packed fresh parsley leaves\n½ lime"
    },
    {
      "id": 1,
      "primary_message": "Place avocados, onion, bell pepper, jalapeño (if using), garlic, cilantro, parsley, vinegar, and lime juice in the workbowl of a food processor fitted with a steel blade. Pulse until everything is finely chopped, stopping to scrape down sides of bowl as needed.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "With the motor running, drizzle in olive oil through feed tube. Process until sauce is completely smooth.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Season sauce with salt and pepper to taste. Transfer to bowl and serve immediately.",
      "secondary_message": null
    }
  ],
