  "instructions": [
    {
      "id": 325581,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 small pkg grape tomatoes\n1 green bell pepper\n1 small bunch cilantro\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 325582,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans pinto beans"
    },
    {
      "id": 325583,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 325584,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 325585,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add beans, onion, garlic, corn, and spices. Cook, stirring occasionally, until corn is golden, 6-8 minutes; remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ⅓ cups frozen corn\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 325586,
      "primary_message": "Meanwhile, juice lime into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 325587,
      "primary_message": "Peel and mince additional garlic; add to the bowl with the lime juice along with yogurt, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n¼ cup plain Greek yogurt\n2 tsp pure maple syrup\n2 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 325588,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 325589,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 325590,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set aside. (Reserve remaining cilantro for the next step.)",
      "secondary_message": null
    },
    {
      "id": 325591,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide bean and corn filling between them, arranging on one half of each tortilla. Crumble goat cheese over filling and sprinkle with remaining cilantro; fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "4 large flour tortillas\n2 (113 g) logs goat cheese"
    },
    {
      "id": 325592,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 325593,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 325594,
      "primary_message": "Right before serving, cut or tear lettuce into bite-sized pieces; add to the bowl with the dressing and veggies. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 325595,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
