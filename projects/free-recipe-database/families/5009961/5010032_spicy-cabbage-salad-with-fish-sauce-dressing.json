  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the garlic. Seed and dice the fresh red bird’s eye chile peppers. Juice the lime. Julienne the carrot. Halve the cherry tomatoes. Halve, core, and thinly slice the Granny Smith apple. Coarsely chop the roasted peanuts.",
      "secondary_message": "4 medium cloves garlic\n2 fresh red bird’s eye chile peppers\n1 lime\n1 small carrot\n237 ml cherry tomatoes\n1 Granny Smith apple\n1 cup roasted peanuts"
    },
    {
      "id": 1,
      "primary_message": "Combine garlic and chile one a work surface and sprinkle 1/4 teaspoon salt on top. Using the side and back of your knife, carefully smash the garlic and chile together to create a paste (see here under \"knife-puréeing\" for visuals and an explanation of the technique).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer garlic-chile purée to a large mixing bowl and stir in lime juice, fish sauce, and brown sugar. Mix well, taste, and add more sugar if needed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add cabbage and toss to coat. Let stand 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Mix in carrot, tomatoes, and apple. Transfer to a serving bowl or plate, top with peanuts and serve.",
      "secondary_message": null
    }
  ],
