  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop and puree the mango. Juice the limes. Grate the zest from the lime.",
      "secondary_message": "4 cups mango\n4 limes\n1 tbsp lime zest"
    },
    {
      "id": 1,
      "primary_message": "Whisk the sugar and pectin a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine the mango, lime juice, lime zest, and calcium water in a large heavy-bottomed pot and bring to a boil. Add the honey and butter and return to a simmer. Add the sugar pectin mixture and return the fruit mixture to a boil, stirring constantly. Boil hard for one minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove the pot from the heat and skim any foam from the surface of the jam with a cold metal spoon. Ladle the jam into hot sterilized jars and process them in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
