  "instructions": [
    {
      "id": 414562,
      "primary_message": "In a large pot, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated; add salt. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n2 ¼ cups polenta (cornmeal)\n¾ tsp salt"
    },
    {
      "id": 414563,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl. ",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 414564,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the kale along with corn.",
      "secondary_message": "3 cloves garlic\n3 cups frozen corn"
    },
    {
      "id": 414565,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 414566,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add kale, corn, and garlic to the pot in handfuls, waiting for kale to wilt before adding the next handful. Cook, stirring often, until the kale is tender and corn is warmed through, 2-3 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 414567,
      "primary_message": "Wash, dry, and juice lemons into the pot. Season with salt, then stir to combine. Remove from heat, cover to keep warm, and set aside.",
      "secondary_message": "1 ½ lemons\n½ tsp salt"
    },
    {
      "id": 414568,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 414569,
      "primary_message": "When the polenta is done, add Parmesan, oil, and pepper to the pot; stir to combine. If the polenta is too firm, add hot water, a few tablespoons at a time, until you reach a desired consistency. Remove from heat and cover to keep warm.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp black pepper"
    },
    {
      "id": 414570,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 414571,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n6 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 414572,
      "primary_message": "To serve, divide polenta between plates or bowls; top with kale-corn sauté and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
