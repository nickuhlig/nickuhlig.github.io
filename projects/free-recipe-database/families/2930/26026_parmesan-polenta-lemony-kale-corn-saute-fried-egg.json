  "instructions": [
    {
      "id": 414573,
      "primary_message": "In a small saucepan, bring broth to a boil. Reduce heat to low and gradually add polenta in a thin steady stream, while whisking, until the polenta is incorporated; add salt. Cover and cook, stirring occasionally, until polenta is soft and the texture is creamy, 15-25 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n¾ cup polenta (cornmeal)\n¼ tsp salt"
    },
    {
      "id": 414574,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a medium bowl. ",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 414575,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 414576,
      "primary_message": "While the skillet heats up, peel and thinly slice garlic. Add to the bowl with the kale along with corn.",
      "secondary_message": "1 clove garlic\n1 cup frozen corn"
    },
    {
      "id": 414577,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add kale, corn, and garlic to the skillet in handfuls, waiting for kale to wilt before adding the next handful. Cook, stirring often, until the kale is tender and corn is warmed through, 1-2 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 414578,
      "primary_message": "Wash, dry, and juice lemon into the skillet. Season with salt, then stir to combine. Return veggies to the bowl, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "½ lemon\n⅛ tsp salt"
    },
    {
      "id": 414579,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 414580,
      "primary_message": "When the polenta is done, add Parmesan, oil, and pepper to the pan; stir to combine. If the polenta is too firm, add hot water, 1 tablespoon at a time, until you reach a desired consistency. Remove from heat and cover to keep warm.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp black pepper"
    },
    {
      "id": 414581,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 414582,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n2 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 414583,
      "primary_message": "To serve, divide polenta between plates or bowls; top with kale-corn sauté and eggs. Enjoy!",
      "secondary_message": null
    }
  ],
