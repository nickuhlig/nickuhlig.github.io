  "instructions": [
    {
      "id": 330321,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n2 (2 ½ cm) pieces ginger root\n1 lime"
    },
    {
      "id": 330322,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 330323,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 330324,
      "primary_message": "Add the ground beef to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 4 to 6 minutes. Season with salt and pepper. Once done, transfer to a medium bowl, leaving juices in the skillet.",
      "secondary_message": "0.91 kg lean ground beef\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 330325,
      "primary_message": "Peel, halve, and thinly slice onion.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 330326,
      "primary_message": "Peel and mince or press the garlic. Peel and mince or grate the ginger. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 330327,
      "primary_message": "Return the skillet to the stove over medium heat and add oil. Once oil is melted, add onion, garlic, and ginger. Cook, stirring occasionally, until fragrant, about 2 minutes. ",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 330328,
      "primary_message": "Meanwhile, trim off and discard the root end of the cabbage; halve the cabbage lengthwise then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 330329,
      "primary_message": "Add the cabbage to the skillet. Cook, stirring frequently, until the cabbage is softened, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 330330,
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 330331,
      "primary_message": "Return the beef to the skillet with the cabbage and season with soy sauce, sesame oil, lime juice, and chili-garlic sauce. ",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp toasted sesame oil\n2 tsp chili-garlic sauce"
    },
    {
      "id": 330332,
      "primary_message": "To serve, divide the beef mixture between bowls and enjoy! ",
      "secondary_message": null
    }
  ],
