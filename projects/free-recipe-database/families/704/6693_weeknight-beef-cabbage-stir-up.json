  "instructions": [
    {
      "id": 330189,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n3 (1 inch) pieces ginger root\n1 ½ limes"
    },
    {
      "id": 330190,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 330191,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 330192,
      "primary_message": "Add the ground beef to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 4 to 6 minutes. Season with salt and pepper. Once done, transfer to a large bowl and cover with foil, leaving juices in the skillet. Cook in batches is necessary. ",
      "secondary_message": "3 lb lean ground beef\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 330193,
      "primary_message": "Peel, halve, and thinly slice onion.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 330194,
      "primary_message": "Peel and mince or press the garlic. Peel and mince or grate the ginger. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 330195,
      "primary_message": "Return the skillet to the stove over medium heat and add oil. Once oil is melted, add onion, garlic, and ginger. Cook, stirring occasionally, until fragrant, about 2 minutes. ",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 330196,
      "primary_message": "Meanwhile, trim off and discard the root end of the cabbage; halve the cabbage lengthwise then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 330197,
      "primary_message": "Add the cabbage to the skillet. Cook, stirring frequently, until the cabbage is softened, 2 to 3 minutes. Cook in batches if necessary. ",
      "secondary_message": null
    },
    {
      "id": 330198,
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 330199,
      "primary_message": "Season with cabbage with soy sauce, sesame oil, lime juice, and chili-garlic sauce. Add the cabbage mixture to the beef and stir until well combined. ",
      "secondary_message": "3 tbsp soy sauce\n1 ½ tbsp toasted sesame oil\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 330200,
      "primary_message": "To serve, divide the beef mixture between bowls and enjoy! ",
      "secondary_message": null
    }
  ],
