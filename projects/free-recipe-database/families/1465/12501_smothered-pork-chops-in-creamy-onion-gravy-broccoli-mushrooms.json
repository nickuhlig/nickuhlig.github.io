  "instructions": [
    {
      "id": 210148,
      "primary_message": "In a large bowl, stir together flour and spices; remove 3 tablespoons seasoned flour and set aside for later use.",
      "secondary_message": "¾ cup all-purpose flour\n¾ tsp garlic powder\n¾ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 210149,
      "primary_message": "Pat pork chops dry with paper towels, add to the bowl with the flour, and toss to coat.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 210150,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 210151,
      "primary_message": "Working in batches if necessary, add chops to the skillet; cook until golden brown, about 2 minutes per side. Once golden, transfer to a plate and loosely cover with aluminum foil (the pork will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 210152,
      "primary_message": "Meanwhile, peel and thinly slice onions into half rings.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 210153,
      "primary_message": "Return skillet to medium heat. Once hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 210154,
      "primary_message": "Add onions, salt, and pepper to the skillet. Cook, stirring occasionally, until onions are soft and slightly caramelized, about 15 minutes.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 210155,
      "primary_message": "Meanwhile, wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces; transfer to another large bowl.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 210156,
      "primary_message": "Wash and dry mushrooms, then thinly slice. Peel and mince garlic. Add both to the bowl with the broccoli.",
      "secondary_message": "1 ½ lb cremini mushrooms\n3 cloves garlic"
    },
    {
      "id": 210157,
      "primary_message": "Add reserved flour to the skillet and stir to coat onions. Cook, stirring frequently, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 210158,
      "primary_message": "Add broth and cream to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until sauce begins to thicken, about 5 minutes.",
      "secondary_message": "18 fl oz (2 ¼ cups) chicken or vegetable broth\n6 fl oz (¾ cup) heavy cream"
    },
    {
      "id": 210159,
      "primary_message": "Return pork chops to the skillet and turn to coat in sauce. Cover and simmer until chops are cooked through, 8 minutes more.",
      "secondary_message": null
    },
    {
      "id": 210160,
      "primary_message": "Meanwhile, heat a large pot over medium-high heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 210161,
      "primary_message": "Add veggies, salt, and pepper to the pot; stir-fry until broccoli is bright green and tender-crisp, 5-6 minutes.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 210162,
      "primary_message": "To serve, divide pork chops, sauce, and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
