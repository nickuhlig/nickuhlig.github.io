  "instructions": [
    {
      "id": 34200,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n½ English cucumber\n½ head romaine lettuce"
    },
    {
      "id": 34201,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 34202,
      "primary_message": "In a medium bowl, combine and mix together the ground beef, Dijon, salt, and pepper. Form the mixture into 2 patties and place on a plate.",
      "secondary_message": "¾ lb lean ground beef\n1 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 34203,
      "primary_message": "Once the grill pan or skillet is hot, coat the bottom with coconut oil.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 34204,
      "primary_message": "Place the beef patties on the grill pan or skillet and cook until desired doneness, 4 to 6 minutes per side. Once done, transfer the patties to a plate.",
      "secondary_message": null
    },
    {
      "id": 34205,
      "primary_message": "While the patties cook, rip off a couple lettuce leaves for the burgers and place on a plate. Then, trim off and discard the root end of the remaining lettuce and remove any blemished leaves; halve the head lengthwise, then chop crosswise into 1-inch pieces. Transfer the chopped lettuce to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 34206,
      "primary_message": "Slice one of the tomatoes crosswise into ¼-inch-thick rounds for the burgers and add to the plate with the lettuce leaves. Halve the other tomato lengthwise and cut out and discard the stem end; large dice the tomato and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 34207,
      "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into ¼-inch-thick pieces on an angle and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 34208,
      "primary_message": "In a small bowl, combine and whisk together olive oil, red wine vinegar, Dijon, salt, and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp red wine vinegar\n¼ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 34209,
      "primary_message": "Pour the dressing over the salad and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 34210,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 34211,
      "primary_message": "To serve, assemble the burger and add any desired condiments. Serve with the salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
