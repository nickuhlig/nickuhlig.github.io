  "instructions": [
    {
      "id": 251810,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 251811,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 green bell peppers\n3 red chili peppers\n1 ½ small bunches cilantro\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 251812,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 251813,
      "primary_message": "Place baking sheet in the oven and broil until peppers are tender and charred, 6-7 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 251814,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251815,
      "primary_message": "While the skillet heats up, quarter chili peppers lengthwise; seed and remove ribs with a spoon. Finely dice. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 251816,
      "primary_message": "Once the skillet is hot, add the ground beef and chili pepper; cook, breaking the meat apart with a spoon, until the beef is browned and cooked through, 4-5 minutes.",
      "secondary_message": "1.02 kg lean ground beef"
    },
    {
      "id": 251817,
      "primary_message": "While the beef is cooking, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in a large bowl and set aside (reserve remaining cilantro for the next step).",
      "secondary_message": null
    },
    {
      "id": 251818,
      "primary_message": "Add reserved cilantro and spices to the skillet with the beef; stir to combine and remove from the heat.",
      "secondary_message": "1 tbsp chili powder\n1 ½ tsp paprika\n1 ½ tsp cumin, ground\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 251819,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 251820,
      "primary_message": "Divide beef mixture between pepper halves and top with cheese. Return baking sheet to the oven and broil until cheese is melted and bubbly, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 251821,
      "primary_message": "Meanwhile, add oil, vinegar, and spices to the bowl with the cilantro; stir to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 251822,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 251823,
      "primary_message": "To serve, divide stuffed peppers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
