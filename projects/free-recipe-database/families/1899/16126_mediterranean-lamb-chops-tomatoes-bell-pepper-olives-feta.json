  "instructions": [
    {
      "id": 264507,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 264508,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n6 tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 264509,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 264510,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season both sides with spices.",
      "secondary_message": "12 lamb loin chops\n1 ½ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264511,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add lamb chops and pan-fry until browned, flipping once, 4-6 minutes (the chops will not be cooked all the way through).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 264512,
      "primary_message": "While the lamb is cooking, peel, halve, and slice onions lengthwise into thin wedges.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 264513,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips.",
      "secondary_message": null
    },
    {
      "id": 264514,
      "primary_message": "When the lamb is browned, transfer chops to a large baking sheet pan, arranging them in a single layer; add the onion and bell pepper, nestling them around the chops.",
      "secondary_message": null
    },
    {
      "id": 264515,
      "primary_message": "Place baking sheet in the oven and roast until the veggies are fork-tender and chops are cooked through, 8-10 minutes more. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 264516,
      "primary_message": "Meanwhile, halve and slice tomatoes into 1-inch thick wedges; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 264517,
      "primary_message": "Halve olives and add to the bowl with the tomatoes.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 264518,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 264519,
      "primary_message": "When the chops are done, transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 264520,
      "primary_message": "Add tomatoes, olives, and parsley to the baking sheet and toss to combine. Return baking sheet to the oven and roast until tomatoes are warmed through, about 6 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 264521,
      "primary_message": "To serve, divide the veggies and lamb chops between plates. Top veggies with feta and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
