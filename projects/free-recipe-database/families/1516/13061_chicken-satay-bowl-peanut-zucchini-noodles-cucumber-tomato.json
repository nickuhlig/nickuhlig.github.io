  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "toasted sesame oil"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n2 limes\n4 medium zucchini squash\n1 English cucumber\n2 tomatoes"
    },
    {
      "primary_message": "Peel and mince garlic and ginger. Place both in a medium bowl. ",
      "secondary_message": "4 cloves garlic\n2 (1 inch) pieces ginger root"
    },
    {
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "primary_message": "Juice limes into the bowl. Add peanut butter, soy sauce, vinegar, and chili-garlic sauce; whisk to combine the sauce. ",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp rice vinegar\n4 tsp chili-garlic sauce"
    },
    {
      "primary_message": "Pat the chicken thighs dry with paper towels, cut into bite-sized pieces, and place on the baking sheet. Spoon half of the sauce over the chicken, toss to coat, and spread out in an even layer. (Reserve remaining sauce for later.)",
      "secondary_message": "907 g chicken thighs, boneless skinless"
    },
    {
      "primary_message": "Place chicken in the oven and bake until golden brown and cooked through, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, trim zucchini ends and use a julienne (or regular) peeler to make noodles. ",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini and remaining sauce; cook, stirring constantly, until just tender, 2-3 minutes. Remove from heat.",
      "secondary_message": "toasted sesame oil"
    },
    {
      "primary_message": "Trim and large dice cucumber. Large dice tomatoes; set both aside on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "primary_message": "To serve, divide zucchini noodles between bowls; top with chicken, veggies, peanuts, and reserved cilantro. Enjoy! ",
      "secondary_message": null
    }
  ],
