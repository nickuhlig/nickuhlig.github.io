  "instructions": [
    {
      "id": 219044,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 219045,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n1 lime\n2 medium zucchini squash\n½ English cucumber\n1 tomato"
    },
    {
      "id": 219046,
      "primary_message": "Peel and mince garlic and ginger. Place both in a small bowl. ",
      "secondary_message": "2 cloves garlic\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 219047,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "id": 219048,
      "primary_message": "Juice lime into the bowl. Add peanut butter, soy sauce, vinegar, and chili-garlic sauce; whisk to combine the sauce. ",
      "secondary_message": "2 tbsp natural peanut butter\n2 tbsp soy sauce\n1 tbsp rice vinegar\n2 tsp chili-garlic sauce"
    },
    {
      "id": 219049,
      "primary_message": "Pat the chicken thighs dry with paper towels, cut into bite-sized pieces, and place on the baking sheet. Spoon half of the sauce over the chicken, toss to coat, and spread out in an even layer. (Reserve remaining sauce for later.)",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 219050,
      "primary_message": "Place chicken in the oven and bake until golden brown and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 219051,
      "primary_message": "Meanwhile, trim zucchini ends and use a julienne (or regular) peeler to make noodles. ",
      "secondary_message": null
    },
    {
      "id": 219052,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219053,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini and remaining sauce; cook, stirring constantly, until just tender, 2-3 minutes. Remove from heat.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 219054,
      "primary_message": "Trim and large dice cucumber. Large dice tomato; set both aside on a plate.",
      "secondary_message": null
    },
    {
      "id": 219055,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 219056,
      "primary_message": "To serve, divide zucchini noodles between bowls; top with chicken, veggies, peanuts, and reserved cilantro. Enjoy! ",
      "secondary_message": null
    }
  ],
