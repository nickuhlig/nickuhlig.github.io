  "instructions": [
    {
      "id": 219070,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 219071,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n3 limes\n6 medium zucchini squash\n1 ½ English cucumbers\n3 tomatoes"
    },
    {
      "id": 219072,
      "primary_message": "Peel and mince garlic and ginger. Place both in a large bowl. ",
      "secondary_message": "6 cloves garlic\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 219073,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "id": 219074,
      "primary_message": "Juice limes into the bowl. Add peanut butter, soy sauce, vinegar, and chili-garlic sauce; whisk to combine the sauce. ",
      "secondary_message": "⅓ cup natural peanut butter\n⅓ cup soy sauce\n3 tbsp rice vinegar\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 219075,
      "primary_message": "Pat the chicken thighs dry with paper towels, cut into bite-sized pieces, and place on the baking sheet. Spoon half of the sauce over the chicken, toss to coat, and spread out in an even layer. (Reserve remaining sauce for later.)",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 219076,
      "primary_message": "Place chicken in the oven and bake until golden brown and cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 219077,
      "primary_message": "Meanwhile, trim zucchini ends and use a julienne (or regular) peeler to make noodles. Place in another large bowl. ",
      "secondary_message": null
    },
    {
      "id": 219078,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219079,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini and remaining sauce; cook, stirring constantly, until just tender, 3-4 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 219080,
      "primary_message": "Trim and large dice cucumbers. Large dice tomatoes; set both aside on a large plate.",
      "secondary_message": null
    },
    {
      "id": 219081,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 219082,
      "primary_message": "To serve, divide zucchini noodles between bowls; top with chicken, veggies, peanuts, and reserved cilantro. Enjoy! ",
      "secondary_message": null
    }
  ],
