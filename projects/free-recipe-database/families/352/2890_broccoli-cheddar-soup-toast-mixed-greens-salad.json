  "instructions": [
    {
      "id": 27893,
      "primary_message": "Peel and small dice the onion; transfer to a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 27894,
      "primary_message": "Wash the broccoli; cut the head into bite-sized florets and small dice the stems. Add the diced stems to the onion and transfer the florets to a separate bowl.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 27892,
      "primary_message": "Melt butter in a medium saucepan over medium heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 27895,
      "primary_message": "Add the diced onion, broccoli stems, and thyme to the saucepan. Cook, stirring occasionally, until the onion and broccoli is softened, 3 to 4 minutes.",
      "secondary_message": "¼ tsp thyme"
    },
    {
      "id": 27900,
      "primary_message": "While the onion cooks, coarsely grate 1 cup of the cheddar; transfer to a small bowl.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 27903,
      "primary_message": "Cut the bun in half and toast (if desired).",
      "secondary_message": "1 whole grain bun or roll"
    },
    {
      "id": 27896,
      "primary_message": "Sprinkle flour over the onion and stir to combine.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 27897,
      "primary_message": "Gradually add the broth and milk while whisking constantly to avoid lumps.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n8 fl oz (1 cup) whole milk"
    },
    {
      "id": 27898,
      "primary_message": "Stir in the broccoli and season with salt and pepper.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 27899,
      "primary_message": "Bring to a boil, then reduce heat to a simmer and cook until the broccoli is tender, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 27904,
      "primary_message": "While the soup cooks, wash and dry the greens (skip this step if the greens came pre-washed); transfer to a salad bowl.",
      "secondary_message": "½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 27905,
      "primary_message": "Drizzle the greens with olive oil and balsamic vinegar; toss to coat and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp balsamic vinegar"
    },
    {
      "id": 27901,
      "primary_message": "Add half of the grated cheddar (save the rest for garnishing) to the saucepan and stir until it is completely melted, 1 to 2 minutes. .",
      "secondary_message": ""
    },
    {
      "id": 27902,
      "primary_message": "Divide the soup between two bowls (or one bowl and one lunch container) and sprinkle with the remaining cheddar. Serve with the salad and toasted bun on the side. Enjoy!",
      "secondary_message": null
    }
  ],
