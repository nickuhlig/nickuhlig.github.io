  "instructions": [
    {
      "id": 28073,
      "primary_message": "Peel and small dice the onion; transfer to a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 28074,
      "primary_message": "Wash the broccoli; cut the heads into bite-sized florets and small dice the stems. Add the diced stems to the onion and transfer the florets to a separate bowl.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 28075,
      "primary_message": "Melt butter in a medium saucepan over medium heat.",
      "secondary_message": "4 tbsp butter, unsalted"
    },
    {
      "id": 28076,
      "primary_message": "Add the diced onion, broccoli stems, and thyme to the saucepan. Cook, stirring occasionally, until the onion and broccoli is softened, 3 to 4 minutes.",
      "secondary_message": "½ tsp thyme"
    },
    {
      "id": 28077,
      "primary_message": "While the onion cooks, coarsely grate 2 cups of the cheddar; transfer to a medium bowl.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 28078,
      "primary_message": "Cut the buns in half and toast (if desired).",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 28079,
      "primary_message": "Sprinkle flour over the onion and stir to combine.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 28080,
      "primary_message": "Gradually add the broth and milk while whisking constantly to avoid lumps.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n16 fl oz (2 cups) whole milk"
    },
    {
      "id": 28081,
      "primary_message": "Stir in the broccoli and season with salt and pepper.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 28082,
      "primary_message": "Bring to a boil, then reduce heat to a simmer and cook until the broccoli is tender, 6 to 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 28083,
      "primary_message": "While the soup cooks, wash and dry the greens (skip this step if the greens came pre-washed); transfer to a salad bowl.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 28084,
      "primary_message": "Drizzle the greens with olive oil and balsamic vinegar; toss to coat and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp balsamic vinegar"
    },
    {
      "id": 28085,
      "primary_message": "Add half of the grated cheddar (save the rest for garnishing) to the saucepan and stir until it is completely melted, 1 to 2 minutes. .",
      "secondary_message": ""
    },
    {
      "id": 28086,
      "primary_message": "Divide the soup between four bowls (or two bowls and two lunch containers) and sprinkle with the remaining cheddar. Serve with the salad and toasted bun on the side. Enjoy!",
      "secondary_message": null
    }
  ],
