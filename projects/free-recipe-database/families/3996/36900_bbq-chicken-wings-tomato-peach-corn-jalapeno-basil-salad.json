  "instructions": [
    {
      "id": 578897,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": null
    },
    {
      "id": 578898,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Drizzle with oil and toss once more to coat. Divide between two baking sheet pans and spread out in an even layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n3 tbsp cornstarch\n1 ½ tsp salt\n1 ½ tsp black pepper\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 578899,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 578900,
      "primary_message": "Meanwhile, place ketchup, vinegar, Worcestershire, Dijon, and spices in a clean large bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "⅓ cup ketchup\n2 tbsp apple cider vinegar\n1 ½ tsp Worcestershire sauce\n1 ½ tsp Dijon mustard\n¾ tsp chili powder\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 578901,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 ½ limes\n6 peaches\n3 pints grape tomatoes\n1 ½ jalapeño peppers\n3 small pkgs fresh basil"
    },
    {
      "id": 578902,
      "primary_message": "Peel and mince shallots and garlic. Place both in another large bowl.",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 578903,
      "primary_message": "Juice limes into the bowl with the shallot and garlic. Add oil, vinegar, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n2 tbsp honey\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 578904,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 578905,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578906,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 578907,
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578908,
      "primary_message": "Place corn in a colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 578909,
      "primary_message": "When the wings are done, add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 578910,
      "primary_message": "To serve, divide chicken wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
