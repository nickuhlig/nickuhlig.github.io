  "instructions": [
    {
      "id": 578883,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": null
    },
    {
      "id": 578884,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat. Drizzle with oil and toss once more to coat. Transfer to a large baking sheet pan and spread out in an even layer.",
      "secondary_message": "2 lb chicken wings, split with tips removed\n2 tbsp cornstarch\n1 tsp salt\n1 tsp black pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 578885,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 578886,
      "primary_message": "Meanwhile, place ketchup, vinegar, Worcestershire, Dijon, and spices in a clean medium bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup ketchup\n4 tsp apple cider vinegar\n1 tsp Worcestershire sauce\n1 tsp Dijon mustard\n½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 578887,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 lime\n4 peaches\n2 pints grape tomatoes\n1 jalapeño pepper\n2 small pkgs fresh basil"
    },
    {
      "id": 578888,
      "primary_message": "Peel and mince shallot and garlic. Place both in another medium bowl.",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 578889,
      "primary_message": "Juice lime into the bowl with the shallot and garlic. Add oil, vinegar, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n4 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 578890,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 578891,
      "primary_message": "Halve grape tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578892,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 578893,
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578894,
      "primary_message": "Place corn in a colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 578895,
      "primary_message": "When the wings are done, add to the bowl with the sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 578896,
      "primary_message": "To serve, divide chicken wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
