  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the lamb loin into 2 steaks. Keep the butter cold until you use it.",
      "secondary_message": "0.34 kg lamb loin\n1 tbsp butter"
    },
    {
      "id": 1,
      "primary_message": "Crust the lamb with salt and half the pink peppercorns.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat a sauté pan over medium to medium-high heat. Add the oil, and then sear the lamb, cooking only about 4 to 5 minutes per side, for medium rare to medium.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove the lamb to a plate to rest. Pour off any extra fat from the pan.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Take the pan off the heat, and add the Cognac (stand back!).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Return to the heat, scrape up the brown bits of meat, and simmer to reduce by half.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Add the cream and the rest of the ground pink peppercorns. Add any juices that meat has released on the plate, and simmer to thicken. At the last second, add the cold butter, swirling the pan to gloss the sauce.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Cut thick slices of the lamb loin, and serve the sauce around it.",
      "secondary_message": null
    }
  ],
