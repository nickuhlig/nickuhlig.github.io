  "instructions": [
    {
      "primary_message": "Cut butter into small pieces. Place in a small saucepan and melt over medium heat. Remove from heat.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Add sugar and cinnamon to the pan with the melted butter, then stir to combine. Set aside.\n\n",
      "secondary_message": "1 ½ tbsp brown sugar\n1 tsp cinnamon, ground"
    },
    {
      "primary_message": "Wash and dry apples.",
      "secondary_message": null
    },
    {
      "primary_message": "Cut a ½-inch thick slice off the top of each apple to remove the stem and expose the flesh. Using an apple corer, paring knife, or melon baller, remove the core, being careful not to cut all the way through the bottom. (This should leave a 3/4-inch wide \"well\" down the center of each apple.)",
      "secondary_message": null
    },
    {
      "primary_message": "Using a paring knife, carefully cut down and around the \"well\" in a concentric circle. The circle should be cut midway between the \"well\" and the skin of the apple.",
      "secondary_message": null
    },
    {
      "primary_message": "Place each apple, top-side down, on a cutting board. Using a paring knife,  slice the petals by making 8 cuts down and around each apple, making sure not to cut through the bottom of the \"well.\" (This should reveal a flower-like shape when the apple is turned right-side up.)",
      "secondary_message": null
    },
    {
      "primary_message": "Working one at a time, place apples in a medium bowl and drizzle with cinnamon-sugar butter. Using a spoon, pour the mixture in-between the layers of each apple.",
      "secondary_message": null
    },
    {
      "primary_message": "Place 2 soft caramel squares in each \"well, \" then transfer prepared apples to air fryer basket. (Work in batches, if necessary, to accommodate the size of your air fryer basket.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Insert basket into air fryer and set temperature to 350°F. Cook until apples are tender and caramel is melted, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "⅓ cup pecan halves"
    },
    {
      "primary_message": "Divide blooming apples between plates and sprinkle with pecans. Serve with whipped topping and enjoy!",
      "secondary_message": "1 cup whipped topping"
    }
  ],
