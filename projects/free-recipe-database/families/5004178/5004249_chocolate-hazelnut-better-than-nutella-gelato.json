  "instructions": [
    {
      "id": 1,
      "primary_message": "In a food processor, grind hazelnuts until they form a paste, about 5 minutes. Hazelnuts will first grind into tiny crumbs, then clump into an oily ball, then break down into an oily paste. When they do, oil with processor running and keep running until a smooth paste is formed.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add cocoa, sugar, and salt to food processor and pulse until ingredients just begin to combine, about 5 short pulses. Turn on processor and let run until very well combined, about 30 seconds. Add half and half to food processor and blend until half and half is well incorporated into hazelnut paste. Taste for seasoning and add salt if necessary.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour mixture through a fine mesh strainer into an airtight container and chill in refrigerator until cold, about 3 hours. Churn in ice cream maker according to manufacturer's instructions. Serve immediately as soft serve or let harden in freezer for at least 4 hours to serve as gelato. For longer chilling times, let ice cream soften on counter for 10 minutes or so before serving.",
      "secondary_message": null
    }
  ],
