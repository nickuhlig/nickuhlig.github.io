  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat gas grill to medium-high heat. In a small bowl, combine sugar, espresso, black pepper, salt, and chili powder. Rub steak all over with vegetable oil. Press spice mixture onto both sides of steak.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cook on first side until well seared, about 8 minutes. Flip and cook until second side is seared and center of steak registers 57°C on an instant-read thermometer, about 6 minutes longer. Transfer to cutting board, tent with foil, and allow meat to rest 10 minutes. Slice thinly against the grain, and serve.",
      "secondary_message": null
    }
  ],
