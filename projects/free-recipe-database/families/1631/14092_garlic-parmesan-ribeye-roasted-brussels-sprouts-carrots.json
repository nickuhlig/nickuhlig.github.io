  "instructions": [
    {
      "id": 237539,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 237540,
      "primary_message": "Peel and mince garlic; transfer to a small bowl along with oil, salt, and pepper. Mash together with the back of a spoon and stir to combine the garlic oil.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 237541,
      "primary_message": "Cut steak into portions and spread garlic oil on both sides; set aside on a plate to marinate.",
      "secondary_message": "¾ lb ribeye steak"
    },
    {
      "id": 237542,
      "primary_message": "Meanwhile, wash and dry Brussels sprouts. Using a clean cutting board, trim ends and halve the sprouts; transfer to a baking sheet pan.",
      "secondary_message": "½ lb Brussels sprouts"
    },
    {
      "id": 237543,
      "primary_message": "Wash, dry, peel, trim, and cut carrot crosswise into ½-inch rounds; add to the baking sheet with the Brussels sprouts.",
      "secondary_message": "1 medium carrot"
    },
    {
      "id": 237544,
      "primary_message": "Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 237545,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway through, until veggies are fork-tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 237546,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237547,
      "primary_message": "Once the grill pan is hot, add steaks and cook until desired doneness, 2-5 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 237548,
      "primary_message": "While the steaks cook, finely grate Parmesan.",
      "secondary_message": "¾ oz Parmesan cheese"
    },
    {
      "id": 237549,
      "primary_message": "When the steaks are done, transfer to a clean plate and top with the Parmesan. Loosely cover with aluminum foil and let rest, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 237550,
      "primary_message": "To serve, divide roasted veggies and steaks between plates. Enjoy!",
      "secondary_message": null
    }
  ],
