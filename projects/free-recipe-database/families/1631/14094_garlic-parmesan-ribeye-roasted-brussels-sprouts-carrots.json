  "instructions": [
    {
      "id": 237563,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 237564,
      "primary_message": "Peel and mince garlic; transfer to a small bowl along with oil, salt, and pepper. Mash together with the back of a spoon and stir to combine the garlic oil.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 237565,
      "primary_message": "Cut steak into portions and spread garlic oil on both sides; set aside on a plate to marinate.",
      "secondary_message": "2 ¼ lb ribeye steak"
    },
    {
      "id": 237566,
      "primary_message": "Meanwhile, wash and dry Brussels sprouts. Using a clean cutting board, trim ends and halve the sprouts; divide between two baking sheet pans.",
      "secondary_message": "1 ½ lb Brussels sprouts"
    },
    {
      "id": 237567,
      "primary_message": "Wash, dry, peel, trim, and cut carrots crosswise into ½-inch rounds; add to the baking sheets with the Brussels sprouts.",
      "secondary_message": "3 medium carrots"
    },
    {
      "id": 237568,
      "primary_message": "Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp basil, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 237569,
      "primary_message": "Place baking sheets in the oven and roast, tossing halfway through, until veggies are fork-tender, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 237570,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237571,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add steaks and cook until desired doneness, 2-5 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 237572,
      "primary_message": "While the steaks cook, finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 237573,
      "primary_message": "When the steaks are done, transfer to a clean plate and top with the Parmesan. Loosely cover with aluminum foil and let rest, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 237574,
      "primary_message": "To serve, divide roasted veggies and steaks between plates. Enjoy!",
      "secondary_message": null
    }
  ],
