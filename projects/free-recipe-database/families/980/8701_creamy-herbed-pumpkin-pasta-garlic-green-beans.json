  "instructions": [
    {
      "id": 133682,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n142 g rotini pasta"
    },
    {
      "id": 133683,
      "primary_message": "Peel and mince the garlic. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 133684,
      "primary_message": "Wash the green beans and trim ends. ",
      "secondary_message": "0.45 kg green beans"
    },
    {
      "id": 133685,
      "primary_message": "Add water to a large skillet and bring to a boil, covered, over high heat.",
      "secondary_message": "¼ cup water"
    },
    {
      "id": 133686,
      "primary_message": "Once the water is boiling, uncover and stir in the beans, oil, butter, and half the garlic. Simmer until beans are tender and water has evaporated, 4-5 minutes. Season with salt, then remove from heat and set aside. ",
      "secondary_message": "1 tsp extra virgin olive oil\n2 tsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 133687,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 133688,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 133689,
      "primary_message": "Add remaining garlic to the saucepan and cook for 1 minute, then add the tomato paste and cook for an additional 30 seconds, stirring frequently.",
      "secondary_message": "1 tbsp tomato paste"
    },
    {
      "id": 133690,
      "primary_message": "Add the pumpkin, milk, and spices to the saucepan. Whisk to combine and let simmer for 2-3 minutes. ",
      "secondary_message": "½ (398 ml) can pure pumpkin purée\n237 ml whole milk\n¾ tsp onion powder\n½ tsp garlic powder\n¾ tsp basil\n¼ tsp salt"
    },
    {
      "id": 133691,
      "primary_message": "Grate the parmesan. ",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 133692,
      "primary_message": "Add the parmesan cheese (reserving a small amount for garnish) and red pepper flakes to the saucepan; stir to combine. Remove from the heat and set aside.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 133693,
      "primary_message": "Once the pasta is done, drain and return to the large pot. Pour the sauce into the pot with the pasta and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 133694,
      "primary_message": "To serve, divide the pasta and green beans between plates. Top pasta with remaining Parmesan and enjoy! ",
      "secondary_message": null
    }
  ],
