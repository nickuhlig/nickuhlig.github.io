  "instructions": [
    {
      "id": 228734,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n½ small bunch cilantro\n1 jalapeño pepper\n½ lime\n1 avocado"
    },
    {
      "id": 228735,
      "primary_message": "Small dice tomatoes and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 228736,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 228737,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 228738,
      "primary_message": "Juice lime into the bowl.",
      "secondary_message": null
    },
    {
      "id": 228739,
      "primary_message": "Halve and pit the avocado; scoop out with a spoon and small dice. Add to the bowl along with spices and gently stir to combine the salsa. Set aside.",
      "secondary_message": "¼ tsp chili powder\n¼ tsp salt\n⅛ tsp cumin, ground"
    },
    {
      "id": 228740,
      "primary_message": "Place corn in a colander and rinse under hot water (from the tap) to thaw. Set aside to drain.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 228741,
      "primary_message": "Place corn meal, flour, nutritional yeast, almond meal, baking powder, and salt in another medium bowl; whisk to combine.",
      "secondary_message": "¾ cup polenta (cornmeal)\n½ cup all-purpose flour\n⅛ cup nutritional yeast flakes\n2 tbsp almond meal/flour\n1 ½ tsp baking powder\n1 pinch salt"
    },
    {
      "id": 228742,
      "primary_message": "Whisk milk and maple syrup in a small bowl.",
      "secondary_message": "237 ml whole milk\n2 tsp pure maple syrup"
    },
    {
      "id": 228743,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 228744,
      "primary_message": "While the skillet heats up, create a well in the center of the flour mixture. Add the milk mixture and corn; whisk until just combined.",
      "secondary_message": null
    },
    {
      "id": 228745,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, use a ⅓-cup measure to pour the batter into the skillet. Cook for 1-2 minutes on each side, until golden and cooked through.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 228746,
      "primary_message": "To serve, divide pancakes and salsa between plates. Enjoy!",
      "secondary_message": null
    }
  ],
