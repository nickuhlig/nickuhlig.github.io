  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat grill to moderate heat. Place baguette halves on grill, cut side down, and grill until lightly toasted. Transfer to cutting board and let cool. Cut into 4-cm cubes and reserve.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Rub chicken with 1 tablespoon oil and season with salt and pepper. Grill both sides until just cooked through (71°C/71°C). Transfer to cutting board and let rest 10 minutes. Cut into 4-cm cubes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place tomatoes, cucumbers, onion, olives, basil, bread, and chicken in a large bowl. Whisk remaining 9 tablespoons oil, red wine vinegar, balsamic vinegar, 1 teaspoon salt, and 1/4 teaspoon pepper in a medium bowl until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour over salad and toss thoroughly to moisten. Let salad sit 15 minutes. Season to taste and serve.",
      "secondary_message": null
    }
  ],
