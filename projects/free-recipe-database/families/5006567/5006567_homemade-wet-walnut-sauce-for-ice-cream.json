  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine the corn syrup, maple syrup, water, sugar, and ground and fresh ginger in a nonreactive saucepan. Bring to a simmer over medium heat, stirring once or twice. Allow to cook for 2 to 3 minutes and remove from heat. Let the mixture cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain the mixture through a fine-mesh strainer pressing on the ginger to extract as much liquid as possible. Discard the ginger. Add the lemon juice to the sauce. Stir in the walnuts.",
      "secondary_message": null
    }
  ],
