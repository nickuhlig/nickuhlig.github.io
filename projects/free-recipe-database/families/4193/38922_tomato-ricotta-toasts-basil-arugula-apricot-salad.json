  "instructions": [
    {
      "id": 605799,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 605800,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lemon\n2 apricots\n2 tomatoes\n½ small pkg fresh basil\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 605801,
      "primary_message": "Juice lemon into a medium bowl. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 605802,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices and add to the bowl with the dressing. Set aside.",
      "secondary_message": null
    },
    {
      "id": 605803,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Place on a plate, season with spices, and set aside. ",
      "secondary_message": "¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 605804,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 605805,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 605806,
      "primary_message": "Spread toasted bread with ricotta, then top with tomatoes and basil. ",
      "secondary_message": "½ (425 g) pkg ricotta cheese"
    },
    {
      "id": 605807,
      "primary_message": "Add arugula to the bowl with the dressing and apricots, then toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 605808,
      "primary_message": "To serve, divide toasts and salad between plates. Drizzle toasts with oil and enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
