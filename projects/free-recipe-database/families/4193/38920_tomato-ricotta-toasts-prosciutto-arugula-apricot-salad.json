  "instructions": [
    {
      "id": 605775,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 605776,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add prosciutto and cook until crispy, about 1 minute per side. Remove to a plate and set aside.",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 605777,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 605778,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n4 apricots\n4 tomatoes\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 605779,
      "primary_message": "Juice lemon into a medium bowl. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 605780,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices and add to the bowl with the dressing. Set aside.",
      "secondary_message": null
    },
    {
      "id": 605781,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Place on a plate, season with spices, and set aside. ",
      "secondary_message": "½ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 605782,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices sourdough bread"
    },
    {
      "id": 605783,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 605784,
      "primary_message": "Spread toasted bread with ricotta, then top with tomatoes, basil, and crispy prosciutto.",
      "secondary_message": "1 (425 g) pkg ricotta cheese"
    },
    {
      "id": 605785,
      "primary_message": "Add arugula to the bowl with the dressing and apricots, then toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 605786,
      "primary_message": "To serve, divide toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
