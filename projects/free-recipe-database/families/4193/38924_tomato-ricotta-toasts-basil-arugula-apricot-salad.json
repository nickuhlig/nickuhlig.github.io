  "instructions": [
    {
      "id": 605819,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 605820,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n6 apricots\n6 tomatoes\n1 ½ small pkgs fresh basil\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 605821,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 605822,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices and add to the bowl with the dressing. Set aside.",
      "secondary_message": null
    },
    {
      "id": 605823,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Place on a large plate, season with spices, and set aside. ",
      "secondary_message": "¾ tsp oregano, dried\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 605824,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 605825,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 605826,
      "primary_message": "Spread toasted bread with ricotta, then top with tomatoes and basil. ",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese"
    },
    {
      "id": 605827,
      "primary_message": "Add arugula to the bowl with the dressing and apricots, then toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 605828,
      "primary_message": "To serve, divide toasts and salad between plates. Drizzle toasts with oil and enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil"
    }
  ],
