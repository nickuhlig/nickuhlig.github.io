  "instructions": [
    {
      "id": 340302,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 340303,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n2 medium zucchini squash\n1 small pkg fresh thyme\n0.45 kg cremini mushrooms"
    },
    {
      "id": 340304,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 340305,
      "primary_message": "Trim and small dice zucchini; add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 340306,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 340307,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 340308,
      "primary_message": "While the pan heats up, place rice in a strainer or colander and rinse under cold, running water.",
      "secondary_message": "1 cup jasmine rice"
    },
    {
      "id": 340309,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom; add veggies and rice. Cook, stirring constantly, until the veggies start to soften, 3-4 minutes. Stir in broth and salt, then bring to a boil over high heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n473 ml chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 340310,
      "primary_message": "Once the liquid in the saucepan comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook until the liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 340311,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340312,
      "primary_message": "While the skillet heats up, sprinkle both side of the tofu with cornstarch, salt, and pepper.",
      "secondary_message": "4 tsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 340313,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning every few minutes, until browned and crispy, 5-7 minutes. Return to the baking sheet and loosely cover with aluminum foil. (Reserve skillet for later use).",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 340314,
      "primary_message": "Meanwhile, thinly slice mushrooms. Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 340315,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Add mushrooms and garlic; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 340316,
      "primary_message": "Add soy sauce to the skillet and continue to cook until the liquid has evaporated, 1-2 minutes more; remove from heat.",
      "secondary_message": "4 tsp soy sauce"
    },
    {
      "id": 340317,
      "primary_message": "To serve, divide rice between plates or bowls; top with tofu and mushrooms. Enjoy!",
      "secondary_message": null
    }
  ],
