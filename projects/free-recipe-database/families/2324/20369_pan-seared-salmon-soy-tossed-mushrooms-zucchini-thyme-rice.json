  "instructions": [
    {
      "id": 340271,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 leeks\n3 medium zucchini squash\n1 small pkg fresh thyme\n0.68 kg cremini mushrooms"
    },
    {
      "id": 340272,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 340273,
      "primary_message": "Trim and small dice zucchini; add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 340274,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 340275,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 340276,
      "primary_message": "While the pot heats up, place rice in a strainer or colander and rinse under cold, running water.",
      "secondary_message": "1 ½ cups jasmine rice"
    },
    {
      "id": 340277,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies and rice. Cook, stirring constantly, until the veggies start to soften, 3-4 minutes. Stir in broth and salt, then bring to a boil over high heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n710 ml chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 340278,
      "primary_message": "Once the liquid in the pot comes to a boil, stir the mixture, cover the pot, and reduce heat to low. Cook until the liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 340279,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340280,
      "primary_message": "While the skillet heats up, pat salmon dry with paper towels and place skin-side down on a plate; season the top side with salt and pepper.",
      "secondary_message": "1.02 kg salmon fillet\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 340281,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate and loosely cover with foil. (Reserve skillet for later use).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 340282,
      "primary_message": "Meanwhile, thinly slice mushrooms. Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 340283,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Add mushrooms and garlic; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 340284,
      "primary_message": "Add soy sauce to the skillet and continue to cook until the liquid has evaporated, 2-3 minutes more; remove from heat.",
      "secondary_message": "2 tbsp soy sauce"
    },
    {
      "id": 340285,
      "primary_message": "To serve, divide rice between plates or bowls; top with salmon and mushrooms. Enjoy!",
      "secondary_message": null
    }
  ],
