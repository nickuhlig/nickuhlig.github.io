  "instructions": [
    {
      "id": 340132,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 340133,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 leeks\n3 medium zucchini squash\n1 small pkg fresh thyme\n1 ½ lb cremini mushrooms"
    },
    {
      "id": 340134,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 340135,
      "primary_message": "Trim and small dice zucchini; add to the bowl with the leek.",
      "secondary_message": null
    },
    {
      "id": 340136,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 340137,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 340138,
      "primary_message": "While the pot heats up, place rice in a strainer or colander and rinse under cold, running water.",
      "secondary_message": "1 ½ cups jasmine rice"
    },
    {
      "id": 340139,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies and rice. Cook, stirring constantly, until the veggies start to soften, 3-4 minutes. Stir in broth and salt, then bring to a boil over high heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 fl oz (3 cups) chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 340140,
      "primary_message": "Once the liquid in the pot comes to a boil, stir the mixture, cover the pot, and reduce heat to low. Cook until the liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 340141,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 340142,
      "primary_message": "While the skillet heats up, sprinkle both side of the tofu with cornstarch, salt, and pepper.",
      "secondary_message": "2 tbsp cornstarch\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 340143,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and pan-fry, turning every few minutes, until browned and crispy, 5-7 minutes. Return to the baking sheet and loosely cover with aluminum foil. (Reserve skillet for later use).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 340144,
      "primary_message": "Meanwhile, thinly slice mushrooms. Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 340145,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Add mushrooms and garlic; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 340146,
      "primary_message": "Add soy sauce to the skillet and continue to cook until the liquid has evaporated, 2-3 minutes more; remove from heat.",
      "secondary_message": "2 tbsp soy sauce"
    },
    {
      "id": 340147,
      "primary_message": "To serve, divide rice between plates or bowls; top with tofu and mushrooms. Enjoy!",
      "secondary_message": null
    }
  ],
