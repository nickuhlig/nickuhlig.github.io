  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 250°F and adjust oven rack to center position. Season pork roast liberally with salt and pepper (see note) and place on a wire rack set in a rimmed baking sheet. Transfer to oven and roast until internal temperature reaches 140°F, about 2 hours. Remove from oven and tent with foil for at least 15 minutes and up to 45 minutes. Meanwhile, increase oven temperature to 500°F or 260°C (see note). Return roast to oven and cook until crisp and browned on the exterior, about 10 minutes. Remove from oven, tent with foil, allow to rest for 15 minutes, then carve by slicing in between each rib and serve.",
      "secondary_message": null
    }
