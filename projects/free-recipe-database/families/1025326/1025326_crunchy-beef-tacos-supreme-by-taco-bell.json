  "instructions": [
    {
      "primary_message": "Heat a large skillet over medium-high heat. Add the ground beef (or turkey/chicken) and cook, breaking it up with a spoon, until fully browned and cooked through, about 6-8 minutes. Drain excess fat if needed.",
      "secondary_message": null
    },
    {
      "primary_message": "Sprinkle the Taco Bell® original seasoning mix over the cooked meat.",
      "secondary_message": null
    },
    {
      "primary_message": "Pour in 2/3 cup of water and stir to combine. Bring to a simmer and let it cook for 3-5 minutes, or until the mixture thickens and the flavors meld together.",
      "secondary_message": null
    },
    {
      "primary_message": "While the meat mixture simmers, warm your taco shells according to the package instructions (usually in the oven).",
      "secondary_message": null
    },
    {
      "primary_message": "Spoon the seasoned meat into each taco shell and add your favorite toppings. Suggestions include shredded lettuce, diced tomatoes, shredded cheese, sour cream, and your favorite Taco Bell® hot sauce.",
      "secondary_message": null
    },
    {
      "primary_message": "Enjoy your Taco Bell® inspired tacos immediately with your favorite side dishes like Mexican rice or refried beans! This recipe is quick, flavorful, and perfect for a taco night!",
      "secondary_message": null
    }
  ],
