  "instructions": [
    {
      "id": 345691,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 345692,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (170 g) pkg blackberries\n0.91 kg Brussels sprouts\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 345693,
      "primary_message": "Combine blackberries, water, vinegar, and sugar in a small saucepan. Bring to a simmer over medium heat, mashing berries occasionally with a spoon, until liquid begins to thicken and berries break down, 6-9 minutes.",
      "secondary_message": "¼ cup water\n2 tbsp white wine vinegar\n4 tsp brown sugar"
    },
    {
      "id": 345694,
      "primary_message": "Meanwhile, pat chicken drumsticks dry with a paper towel and place on a baking sheet pan; season with salt and pepper.",
      "secondary_message": "0.68 kg chicken drumsticks\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 345695,
      "primary_message": "Add butter and mustard to the saucepan; stir to combine until butter has melted. Transfer half the glaze to a small bowl and set aside. ",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp Dijon mustard"
    },
    {
      "id": 345696,
      "primary_message": "Coat all sides of the drumsticks with the remaining glaze. Place in the oven and roast, flipping once, until the chicken is cooked through, 30-35 minutes.",
      "secondary_message": null
    },
    {
      "id": 345697,
      "primary_message": "Trim and halve Brussels sprouts, then transfer to a second sheet pan.",
      "secondary_message": null
    },
    {
      "id": 345698,
      "primary_message": "Drizzle sprouts with oil, and season with salt and pepper. Toss to combine and spread out in a single layer. Place in the oven and roast until the sprouts are tender, 15-17 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 345699,
      "primary_message": "Meanwhile, rinse and wipe out the small saucepan with a clean towel. Return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345700,
      "primary_message": "Add broth and bring to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork. ",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 345701,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 345702,
      "primary_message": "Add half of the parsley to the pan with the couscous and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 345703,
      "primary_message": "To serve, divide couscous, Brussels sprouts, and chicken between plates. Pour reserved glaze over the chicken. Garnish with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
