  "instructions": [
    {
      "id": 345678,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 345679,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (170 g) pkg blackberries\n0.45 kg Brussels sprouts\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 345680,
      "primary_message": "Combine blackberries, water, vinegar, and sugar in a small saucepan. Bring to a simmer over medium heat, mashing berries occasionally with a spoon, until liquid begins to thicken and berries break down, 5-8 minutes.",
      "secondary_message": "2 tbsp water\n1 tbsp white wine vinegar\n2 tsp brown sugar"
    },
    {
      "id": 345681,
      "primary_message": "Meanwhile, pat chicken drumsticks dry with a paper towel and place on a large baking sheet pan; season with salt and pepper.",
      "secondary_message": "⅓ kg chicken drumsticks\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 345682,
      "primary_message": "Add butter and mustard to the saucepan; stir to combine until butter has melted. Transfer half the glaze to a small bowl and set aside. ",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp Dijon mustard"
    },
    {
      "id": 345683,
      "primary_message": "Coat all sides of the drumsticks with the remaining glaze. Place in the oven and roast, flipping once, until the chicken is cooked through, 30-35 minutes.",
      "secondary_message": null
    },
    {
      "id": 345684,
      "primary_message": "Trim and halve Brussels sprouts; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 345685,
      "primary_message": "Add oil, salt, and pepper to the bowl with the sprouts. Toss to combine and spread out in a single layer on the sheet pan with the chicken. Return to oven and roast until the sprouts are tender and chicken is cooked through, 15 minutes more.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 345686,
      "primary_message": "Meanwhile, rinse and wipe out the small saucepan with a clean towel. Return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345687,
      "primary_message": "Add broth and bring to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork. ",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 345688,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 345689,
      "primary_message": "Add half of the parsley to the pan with the couscous and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 345690,
      "primary_message": "To serve, divide couscous, Brussels sprouts, and chicken between plates. Pour reserved glaze over the chicken. Garnish with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
