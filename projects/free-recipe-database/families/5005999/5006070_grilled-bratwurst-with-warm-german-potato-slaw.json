  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the bacon. Stem, seed, and slice the red bell pepper. Slice the yellow onion. Slice the mini red potatoes. Slice the red cabbage. Split the thick sausage rolls.",
      "secondary_message": "6 strips bacon\n1 red bell pepper\n1 small yellow onion\n2 ½ medium mini red potatoes\n½ small head red cabbage\n5 thick sausage rolls"
    },
    {
      "id": 1,
      "primary_message": "Heat one half of the grill, either by arranging the coals on one side of the charcoal grate or by setting half of the burners to high. Cover and preheat for 10 minutes. Clean and oil the grates.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the bacon to a 25-cm square disposable aluminum pan. Place over direct heat and cook, tossing occasionally, until nearly cooked through but not quite crisp. Add bell pepper, onion, and potatoes, and stir to coat. Cook until the onions are soft and translucent, about 4 minutes. Pour in water and beef base and bring to a gentle boil. Add red wine vinegar and red cabbage. Top with bratwurst. The bratwursts should be slightly submerged in the liquid; if not, add more water. Return to a boil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Slide the tray to the cool side of the grill. Cover the grill and cook with all vents open, turning bratwursts halfway through, until bratwursts reach an internal temperature of 140 to 63°C, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Use tongs to transfer the bratwursts from the tray to the hot side of the grill, placing them directly on the grate. Grill, turning once, until browned, about 2 minutes. Toss and season the potato slaw with salt and pepper, to taste. Return the brats to the tray and toast the buns, if desired.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Serve the bratwurst in the buns, with the potato slaw piled on. Top with parsley and mustard.",
      "secondary_message": null
    }
  ],
