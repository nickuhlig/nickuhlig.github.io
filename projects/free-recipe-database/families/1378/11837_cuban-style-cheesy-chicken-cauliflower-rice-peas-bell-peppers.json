  "instructions": [
    {
      "id": 199913,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 199914,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels; season with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 199915,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 199916,
      "primary_message": "Working in batches if necessary, add chicken to the skillet and cook, flipping once, until starting to brown, about 4 minutes (the chicken will not be cooked all the way through). Remove skillet from the heat and transfer chicken to a plate.",
      "secondary_message": null
    },
    {
      "id": 199917,
      "primary_message": "Meanwhile, wash and dry the cauliflower.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 199918,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 199919,
      "primary_message": "Peel and mince garlic and onion; add to the bowl with the cauliflower.",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 199920,
      "primary_message": "Wash, dry, seed, and small dice bell peppers. Add to the bowl. ",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 199921,
      "primary_message": "Return the skillet to medium-high heat; add the veggies, broth, tomato paste, and spices. Stir to combine and bring to a simmer. ",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp tomato paste\n2 tsp cumin\n1 tsp turmeric\n1 tsp oregano\n½ tsp salt"
    },
    {
      "id": 199922,
      "primary_message": "Once simmering, reduce heat to medium-low. Return chicken to the skillet, cover, and cook until cauliflower is tender and chicken is cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 199923,
      "primary_message": "Meanwhile, grate cheese. ",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 199924,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw them slightly and remove any ice crystals.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 199925,
      "primary_message": "Remove skillet from the heat. Sprinkle cheese and peas over the top, and let stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 199926,
      "primary_message": "To serve, divide chicken and cauliflower rice between plates and enjoy! ",
      "secondary_message": null
    }
  ],
