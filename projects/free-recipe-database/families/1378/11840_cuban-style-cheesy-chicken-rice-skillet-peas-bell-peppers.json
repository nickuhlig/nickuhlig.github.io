  "instructions": [
    {
      "id": 199954,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 199955,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels; season with salt and pepper on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 199956,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 199957,
      "primary_message": "Working in batches if necessary, add chicken to the skillet and cook, flipping once, until starting to brown, about 4 minutes (the chicken will not be cooked all the way through). Remove skillet from the heat and transfer chicken to a plate.",
      "secondary_message": null
    },
    {
      "id": 199958,
      "primary_message": "Meanwhile, peel and mince garlic and onion. ",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 199959,
      "primary_message": "Wash, dry, seed, and small dice bell peppers.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 199960,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "1 cup basmati rice"
    },
    {
      "id": 199961,
      "primary_message": "Return the skillet to medium-high heat; add the veggies, rice, broth, tomato paste, and spices. Stir to combine and bring to a simmer. ",
      "secondary_message": "473 ml chicken or vegetable broth\n2 tbsp tomato paste\n2 tsp cumin\n1 tsp turmeric\n1 tsp oregano\n½ tsp salt"
    },
    {
      "id": 199962,
      "primary_message": "Once simmering, reduce heat to medium-low. Return chicken to the skillet, cover, and cook until rice is tender and chicken is cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 199963,
      "primary_message": "Meanwhile, grate cheese. ",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 199964,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw them slightly and remove any ice crystals.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 199965,
      "primary_message": "Remove skillet from the heat. Sprinkle cheese and peas over the top, and let stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 199966,
      "primary_message": "To serve, divide chicken and rice between plates and enjoy! ",
      "secondary_message": null
    }
  ],
