  "instructions": [
    {
      "id": 199980,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 199981,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels; season with salt and pepper on both sides.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 199982,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 199983,
      "primary_message": "Add chicken to the skillet and cook, flipping once, until starting to brown, about 4 minutes (the chicken will not be cooked all the way through). Remove skillet from the heat and transfer chicken to a plate.",
      "secondary_message": null
    },
    {
      "id": 199984,
      "primary_message": "Meanwhile, peel and mince garlic and onion. ",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 199985,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "id": 199986,
      "primary_message": "Return the skillet to medium-high heat; add garlic, onion, rice, broth, and spices. Stir to combine and bring to a simmer. ",
      "secondary_message": "237 ml chicken or vegetable broth\n1 tsp cumin\n¾ tsp turmeric\n½ tsp oregano\n¼ tsp salt"
    },
    {
      "id": 199987,
      "primary_message": "Once simmering, reduce heat to medium-low. Return chicken to the skillet, cover, and cook until rice is tender and chicken is cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 199988,
      "primary_message": "Meanwhile, grate cheese. ",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 199989,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw them slightly and remove any ice crystals.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 199990,
      "primary_message": "Remove skillet from the heat. Sprinkle cheese and peas over the top, and let stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 199991,
      "primary_message": "To serve, divide chicken and rice between plates and enjoy! ",
      "secondary_message": null
    }
  ],
