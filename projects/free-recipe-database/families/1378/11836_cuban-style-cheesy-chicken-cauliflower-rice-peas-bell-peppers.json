  "instructions": [
    {
      "id": 199900,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 199901,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels; season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 199902,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet and cook, flipping once, until starting to brown, about 4 minutes (the chicken will not be cooked all the way through). Remove skillet from the heat and transfer chicken to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 199903,
      "primary_message": "Meanwhile, wash and dry the cauliflower.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 199904,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 199905,
      "primary_message": "Peel and mince garlic and onion; add to the bowl with the cauliflower.",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 199906,
      "primary_message": "Wash, dry, seed, and small dice bell pepper. Add to the bowl. ",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 199907,
      "primary_message": "Return the skillet to medium-high heat; add the veggies, broth, tomato paste, and spices. Stir to combine and bring to a simmer. ",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n1 tbsp tomato paste\n1 tsp cumin\n½ tsp turmeric\n½ tsp oregano\n¼ tsp salt"
    },
    {
      "id": 199908,
      "primary_message": "Once simmering, reduce heat to medium-low. Return chicken to the skillet, cover, and cook until cauliflower is tender and chicken is cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 199909,
      "primary_message": "Meanwhile, grate cheese. ",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 199910,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw them slightly and remove any ice crystals.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 199911,
      "primary_message": "Remove skillet from the heat. Sprinkle cheese and peas over the top, and let stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 199912,
      "primary_message": "To serve, divide chicken and cauliflower rice between plates and enjoy! ",
      "secondary_message": null
    }
  ],
