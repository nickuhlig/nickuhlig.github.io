  "instructions": [
    {
      "id": 200004,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 200005,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels; season with salt and pepper on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 200006,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 200007,
      "primary_message": "Working in batches if necessary, add chicken to the skillet and cook, flipping once, until starting to brown, about 4 minutes (the chicken will not be cooked all the way through). Remove skillet from the heat and transfer chicken to a plate.",
      "secondary_message": null
    },
    {
      "id": 200008,
      "primary_message": "Meanwhile, peel and mince garlic and onions. ",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 200009,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water. Set aside to drain.",
      "secondary_message": "1 ½ cups basmati rice"
    },
    {
      "id": 200010,
      "primary_message": "Return the skillet to medium-high heat; add garlic, onion, rice, broth, and spices. Stir to combine and bring to a simmer. ",
      "secondary_message": "710 ml chicken or vegetable broth\n1 tbsp cumin\n1 ½ tsp turmeric\n1 ½ tsp oregano\n¾ tsp salt"
    },
    {
      "id": 200011,
      "primary_message": "Once simmering, reduce heat to medium-low. Return chicken to the skillet (overlapping the chicken thighs slightly, if necessary), cover, and cook until rice is tender and chicken is cooked through, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 200012,
      "primary_message": "Meanwhile, grate cheese. ",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 200013,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw them slightly and remove any ice crystals.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 200014,
      "primary_message": "Remove skillet from the heat. Sprinkle cheese and peas over the top, and let stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 200015,
      "primary_message": "To serve, divide chicken and rice between plates and enjoy! ",
      "secondary_message": null
    }
  ],
