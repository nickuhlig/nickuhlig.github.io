  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "1 medium beet\n1 Gala apple\n½ small bunch fresh dill"
    },
    {
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for the next step.)",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "extra virgin olive oil\n2 pork sausages"
    },
    {
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl along with vinegar, oil, Dijon, salt, and pepper. Stir to combine the dressing.",
      "secondary_message": "½ shallot\n2 tbsp red wine vinegar\nextra virgin olive oil\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Peel, trim, and coarsely grate beet. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter, core, and coarsely grate apple. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Add toasted almonds, broccoli slaw, and raisins to the bowl. Stir to combine the slaw.",
      "secondary_message": "½ (340 g) pkg broccoli slaw\n⅛ cup raisins"
    },
    {
      "primary_message": "Slice the sausages into bite-sized rounds.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide the sausage and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
