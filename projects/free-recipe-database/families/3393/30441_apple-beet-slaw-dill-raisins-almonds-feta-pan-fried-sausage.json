  "instructions": [
    {
      "id": 484259,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 484260,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "3 medium beets\n3 Gala apples\n1 small bunch fresh dill"
    },
    {
      "id": 484261,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for the next step.)",
      "secondary_message": "¾ cup almonds, sliced"
    },
    {
      "id": 484262,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pork sausages"
    },
    {
      "id": 484263,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl along with vinegar, oil, Dijon, salt, and pepper. Stir to combine the dressing.",
      "secondary_message": "1 shallot\n⅓ cup red wine vinegar\n¼ cup extra virgin olive oil\n2 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 484264,
      "primary_message": "Peel, trim, and coarsely grate beets. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 484265,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484266,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484267,
      "primary_message": "Add toasted almonds, broccoli slaw, feta, and raisins to the bowl. Stir to combine the slaw.",
      "secondary_message": "1 ½ (12 oz) pkgs broccoli slaw\n1 ½ (4 oz) pkgs crumbled feta cheese\n⅓ cup raisins"
    },
    {
      "id": 484268,
      "primary_message": "Slice the sausages into bite-sized rounds.",
      "secondary_message": null
    },
    {
      "id": 484269,
      "primary_message": "To serve, divide the sausage and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
