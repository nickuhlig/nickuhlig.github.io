  "instructions": [
    {
      "id": 484314,
      "primary_message": "Peel and mince shallot. Place in a large bowl along with vinegar, oil, Dijon, maple syrup, salt, and pepper. Stir to combine the dressing and set aside.",
      "secondary_message": "1 shallot\n¼ cup red wine vinegar\n3 tbsp extra virgin olive oil\n4 tsp Dijon mustard\n1 tbsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 484315,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 484316,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "2 medium beets\n2 Gala apples\n1 small bunch fresh dill"
    },
    {
      "id": 484317,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring frequently, until lightly toasted, 2-3 minutes. Transfer to a small bowl. (Reserve skillet for the next step.)",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 484318,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n4 pre-cooked vegan sausage"
    },
    {
      "id": 484319,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate beets. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 484320,
      "primary_message": "Quarter, core, and coarsely grate apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484321,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 484322,
      "primary_message": "Add toasted almonds, broccoli slaw, and raisins to the bowl. Toss to combine the slaw.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw\n¼ cup raisins"
    },
    {
      "id": 484323,
      "primary_message": "Slice the sausages into bite-sized rounds.",
      "secondary_message": null
    },
    {
      "id": 484324,
      "primary_message": "To serve, divide the sausage and slaw between plates. Enjoy!",
      "secondary_message": null
    }
  ],
