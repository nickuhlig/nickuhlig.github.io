  "instructions": [
    {
      "id": 370662,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": null
    },
    {
      "id": 370663,
      "primary_message": "Pat chicken dry with paper towels and place in a medium bowl.",
      "secondary_message": "1 ¼ lb chicken drumsticks"
    },
    {
      "id": 370664,
      "primary_message": "Wash, dry, trim, and slice zucchini crosswise into ½-inch thick rounds. Add to the bowl with the chicken along with the cauliflower.",
      "secondary_message": "2 medium zucchini squash\n1 (10 oz) bag cauliflower florets"
    },
    {
      "id": 370665,
      "primary_message": "Drizzle chicken and veggies with oil, then sprinkle with Cajun seasoning and salt. Toss to coat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tbsp Cajun seasoning\n¼ tsp salt"
    },
    {
      "id": 370666,
      "primary_message": "Transfer chicken and veggies to a baking sheet pan, then spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 370667,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until veggies are tender and chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370668,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
