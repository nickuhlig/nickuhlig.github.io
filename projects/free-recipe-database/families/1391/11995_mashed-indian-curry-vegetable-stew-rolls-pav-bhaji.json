  "instructions": [
    {
      "id": 232151,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium red potatoes\n1 medium carrot\n½ green bell pepper\n1 (1 inch) piece ginger root\n2 tomatoes\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 232152,
      "primary_message": "Peel and small dice potatoes and carrot. Seed and small dice bell pepper. Transfer veggies to a large pot.",
      "secondary_message": null
    },
    {
      "id": 232153,
      "primary_message": "Add broth, sugar, and salt to the pot; stir to combine, then scrape down the edges of the pot so that veggies are submerged. Cover and bring to a boil over high heat; reduce heat to medium and simmer until potatoes and carrots are fork-tender, 12-15 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n½ tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 232154,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 232155,
      "primary_message": "While the skillet heats up, peel and small dice onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 232156,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion (reserving a small handful for garnish) and cook, stirring occasionally, until it begins to soften, about 5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 232157,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add both to the skillet with the onion. Continue to cook, stirring often, until soft and fragrant, about 3 minutes.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 232158,
      "primary_message": "Small dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 232159,
      "primary_message": "Add tomatoes, additional broth, peas, tomato paste, and spices to the skillet. Continue to cook, stirring often, until sauce thickens and peas are heated through, about 2 minutes. Remove from heat.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n½ cup frozen peas\n2 tbsp tomato paste\n2 tsp curry powder\n2 tsp chili powder\n½ tsp salt\n¼ tsp cinnamon, ground\n1 pinch cayenne pepper"
    },
    {
      "id": 232160,
      "primary_message": "Once the potatoes and carrots in the pot are tender, remove from heat. Use a potato masher to gently crush the veggies, forming a textured mash. Transfer the tomato sauce to the pot and mash once more to combine.",
      "secondary_message": null
    },
    {
      "id": 232161,
      "primary_message": "Return veggie mash to the stove over medium-high heat. Continue to cook, stirring often, until slightly thickened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 232162,
      "primary_message": "Meanwhile, cut lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 232163,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the vegetable mash (reserving a small handful for garnish) and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 232164,
      "primary_message": "Toast rolls if desired, and spread with oil.",
      "secondary_message": "2 whole grain buns or rolls\n4 tsp virgin coconut oil"
    },
    {
      "id": 232165,
      "primary_message": "Divide veggie mash between plates. Serve with onion, cilantro, lime wedges, and rolls. Enjoy!",
      "secondary_message": null
    }
  ],
