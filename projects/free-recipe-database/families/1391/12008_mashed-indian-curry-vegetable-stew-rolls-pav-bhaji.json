  "instructions": [
    {
      "id": 232346,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium red potatoes\n2 medium carrots\n1 green bell pepper\n2 (2 ½ cm) pieces ginger root\n4 tomatoes\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 232347,
      "primary_message": "Peel and small dice potatoes and carrots. Seed and small dice bell pepper. Transfer veggies to a large pot.",
      "secondary_message": null
    },
    {
      "id": 232348,
      "primary_message": "Add broth, sugar, and salt to the pot; stir to combine, then scrape down the edges of the pot so that veggies are submerged. Cover and bring to a boil over high heat; reduce heat to medium and simmer until potatoes and carrots are fork-tender, about 15 minutes.",
      "secondary_message": "828 ml chicken or vegetable broth\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 232349,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 232350,
      "primary_message": "While the skillet heats up, peel and small dice onion.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 232351,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion (reserving a handful for garnish) and cook, stirring occasionally, until it begins to soften, about 5 minutes.",
      "secondary_message": "¼ cup virgin coconut oil"
    },
    {
      "id": 232352,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add both to the skillet with the onion. Continue to cook, stirring often, until soft and fragrant, about 3 minutes.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 232353,
      "primary_message": "Small dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 232354,
      "primary_message": "Add tomatoes, additional broth, peas, tomato paste, and spices to the skillet. Continue to cook, stirring often, until sauce thickens and peas are heated through, about 2 minutes. Remove from heat.",
      "secondary_message": "237 ml chicken or vegetable broth\n1 cup frozen peas\n4 tbsp tomato paste\n4 tsp curry powder\n4 tsp chili powder\n1 tsp salt\n½ tsp cinnamon, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 232355,
      "primary_message": "Once the potatoes and carrots in the pot are tender, remove from heat. Use a potato masher to gently crush the veggies, forming a textured mash. Transfer the tomato sauce to the pot and mash once more to combine.",
      "secondary_message": null
    },
    {
      "id": 232356,
      "primary_message": "Return veggie mash to the stove over medium-high heat. Continue to cook, stirring often, until slightly thickened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 232357,
      "primary_message": "Meanwhile, cut lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 232358,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the vegetable mash (reserving a handful for garnish) and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 232359,
      "primary_message": "Toast rolls if desired, and spread with oil.",
      "secondary_message": "4 whole grain buns or rolls\n2 tbsp virgin coconut oil"
    },
    {
      "id": 232360,
      "primary_message": "Divide veggie mash between plates. Serve with onion, cilantro, lime wedges, and rolls. Enjoy!",
      "secondary_message": null
    }
  ],
