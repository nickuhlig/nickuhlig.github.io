  "instructions": [
    {
      "id": 232361,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium red potatoes\n3 medium carrots\n2 green bell peppers\n3 (2 ½ cm) pieces ginger root\n6 tomatoes\n1 ½ limes\n2 small bunches cilantro"
    },
    {
      "id": 232362,
      "primary_message": "Peel and small dice potatoes and carrots. Seed and small dice bell peppers. Transfer veggies to a large pot.",
      "secondary_message": null
    },
    {
      "id": 232363,
      "primary_message": "Add broth, sugar, and salt to the pot; stir to combine, then scrape down the edges of the pot so that veggies are submerged. Cover and bring to a boil over high heat; reduce heat to medium and simmer until potatoes and carrots are fork-tender, 15-17 minutes.",
      "secondary_message": "1183 ml chicken or vegetable broth\n1 ½ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 232364,
      "primary_message": "Meanwhile, preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 232365,
      "primary_message": "While the pot heats up, peel and small dice onions.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 232366,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the onion (reserving a handful for garnish) and cook, stirring occasionally, until it begins to soften, 5-7 minutes.",
      "secondary_message": "⅓ cup virgin coconut oil"
    },
    {
      "id": 232367,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add both to the pot with the onion. Continue to cook, stirring often, until soft and fragrant, about 3 minutes.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 232368,
      "primary_message": "Small dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 232369,
      "primary_message": "Add tomatoes, additional broth, peas, tomato paste, and spices to the pot with the onion. Continue to cook, stirring often, until sauce thickens and peas are heated through, about 3 minutes. Remove from heat.",
      "secondary_message": "355 ml chicken or vegetable broth\n1 ½ cups frozen peas\n6 tbsp tomato paste\n2 tbsp curry powder\n2 tbsp chili powder\n1 ½ tsp salt\n¾ tsp cinnamon, ground\n3 pinch cayenne pepper"
    },
    {
      "id": 232370,
      "primary_message": "Once the potatoes and carrots are tender, remove from heat. Use a potato masher to gently crush the veggies, forming a textured mash. Transfer the tomato sauce to the pot with the potatoes and mash once more to combine.",
      "secondary_message": null
    },
    {
      "id": 232371,
      "primary_message": "Return veggie mash to the stove over medium-high heat. Continue to cook, stirring often, until slightly thickened, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 232372,
      "primary_message": "Meanwhile, cut limes into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 232373,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the vegetable mash (reserving a handful for garnish) and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 232374,
      "primary_message": "Toast rolls if desired, and spread with oil.",
      "secondary_message": "6 whole grain buns or rolls\n3 tbsp virgin coconut oil"
    },
    {
      "id": 232375,
      "primary_message": "Divide veggie mash between plates. Serve with onion, cilantro, lime wedges, and rolls. Enjoy!",
      "secondary_message": null
    }
  ],
