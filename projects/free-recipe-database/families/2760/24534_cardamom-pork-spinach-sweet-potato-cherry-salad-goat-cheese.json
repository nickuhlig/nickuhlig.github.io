  "instructions": [
    {
      "id": 396640,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 396641,
      "primary_message": "Wash, dry, peel, and medium dice sweet potatoes. Place on a large baking sheet pan along with cherries, oil, and spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "0.68 kg sweet potato\n3 cup frozen cherries\n2 tbsp extra virgin olive oil\n1 ½ tsp cardamom, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 396642,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cherries are soft and sweet potatoes are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 396643,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 396644,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with spices on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp cinnamon, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 396645,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 396646,
      "primary_message": "While the chops are cooking, peel and mince shallots. Place in a large bowl along with additional oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n¼ tsp black pepper\n3 pinch cardamom, ground"
    },
    {
      "id": 396647,
      "primary_message": "When the sweet potatoes and cherries are done, remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 396648,
      "primary_message": "Meanwhile, thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 396649,
      "primary_message": "Wash and dry the spinach. (Skip this step if it came pre-washed.) Add to the bowl with the dressing along with the cooled sweet potatoes and cherries. Toss to combine the salad.",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 396650,
      "primary_message": "To serve, divide salad between plates or bowls, then top with pork. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
