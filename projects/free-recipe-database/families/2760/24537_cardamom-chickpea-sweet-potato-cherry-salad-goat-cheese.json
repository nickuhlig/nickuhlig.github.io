  "instructions": [
    {
      "id": 396669,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 396670,
      "primary_message": "Drain and rinse chickpeas. Divide between two large baking sheet pans and pat dry with paper towels.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 396671,
      "primary_message": "Wash, dry, peel, and medium dice sweet potatoes. Add to the baking sheets with the chickpeas along with cherries, oil, and spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "0.68 kg sweet potato\n3 cup frozen cherries\n¼ cup extra virgin olive oil\n1 ½ tsp cardamom, ground\n¾ tsp cinnamon, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 396672,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until cherries are soft and sweet potatoes are fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 396673,
      "primary_message": "Meanwhile, peel and mince shallots. Place in a large bowl along with additional oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper\n3 pinch cardamom, ground"
    },
    {
      "id": 396674,
      "primary_message": "When the chickpeas, sweet potatoes, and cherries are done, remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 396675,
      "primary_message": "While the chickpeas are cooling, crumble goat cheese into a small bowl and set aside.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 396676,
      "primary_message": "Wash and dry the spinach. (Skip this step if it came pre-washed.) Add to the bowl with the dressing along with the cooled chickpeas, sweet potatoes, and cherries. Toss to combine the salad.",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 396677,
      "primary_message": "To serve, divide salad between plates or bowls, then top with goat cheese. Enjoy!",
      "secondary_message": null
    }
  ],
