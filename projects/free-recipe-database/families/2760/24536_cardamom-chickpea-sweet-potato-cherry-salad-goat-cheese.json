  "instructions": [
    {
      "id": 396660,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 396661,
      "primary_message": "Drain and rinse chickpeas. Transfer to a large baking sheet pan and pat dry with paper towels.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 396662,
      "primary_message": "Wash, dry, peel, and medium dice sweet potatoes. Add to the baking sheet with the chickpeas along with cherries, oil, and spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "0.45 kg sweet potato\n2 cup frozen cherries\n3 tbsp extra virgin olive oil\n1 tsp cardamom, ground\n½ tsp cinnamon, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 396663,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until cherries are soft and sweet potatoes are fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 396664,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl along with additional oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cardamom, ground"
    },
    {
      "id": 396665,
      "primary_message": "When the chickpeas, sweet potatoes, and cherries are done, remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 396666,
      "primary_message": "While the chickpeas are cooling, crumble goat cheese into a small bowl and set aside.",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 396667,
      "primary_message": "Wash and dry the spinach. (Skip this step if it came pre-washed.) Add to the bowl with the dressing along with the cooled chickpeas, sweet potatoes, and cherries. Toss to combine the salad.",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 396668,
      "primary_message": "To serve, divide salad between plates or bowls, then top with goat cheese. Enjoy!",
      "secondary_message": null
    }
  ],
