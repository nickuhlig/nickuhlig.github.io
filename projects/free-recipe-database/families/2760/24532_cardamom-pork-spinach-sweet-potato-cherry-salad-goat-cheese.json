  "instructions": [
    {
      "id": 396618,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 396619,
      "primary_message": "Wash, dry, peel, and medium dice sweet potato. Place in a large baking dish along with cherries, oil, and spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "0.23 kg sweet potato\n1 cup frozen cherries\n2 tsp extra virgin olive oil\n½ tsp cardamom, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 396620,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cherries are soft and sweet potatoes are fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 396621,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 396622,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate. Season with spices on both sides.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp cinnamon, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 396623,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 396624,
      "primary_message": "While the chops are cooking, peel and mince shallot. Place in a medium bowl along with additional oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ shallot\n1 tbsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch cardamom, ground"
    },
    {
      "id": 396625,
      "primary_message": "When the sweet potatoes and cherries are done, remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 396626,
      "primary_message": "Meanwhile, thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 396627,
      "primary_message": "Wash and dry the spinach. (Skip this step if it came pre-washed.) Add to the bowl with the dressing along with the cooled sweet potatoes and cherries. Toss to combine the salad.",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 396628,
      "primary_message": "To serve, divide salad between plates or bowls, then top with pork. Crumble goat cheese over top and enjoy!",
      "secondary_message": "½ (113 g) log goat cheese"
    }
  ],
