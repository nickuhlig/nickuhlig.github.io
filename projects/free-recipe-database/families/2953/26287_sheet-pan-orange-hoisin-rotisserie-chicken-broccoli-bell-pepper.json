  "instructions": [
    {
      "id": 469169,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 469170,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Transfer to a baking sheet pan along with broccoli. Drizzle with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "2 yellow bell peppers\n½ (18 oz) bag broccoli florets\n4 tsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 469171,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies soften, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 469172,
      "primary_message": "Meanwhile, wash, dry, and juice orange into a medium bowl. Add hoisin sauce and stir to combine.",
      "secondary_message": "1 orange\n⅓ cup hoisin sauce"
    },
    {
      "id": 469173,
      "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Add chicken to the bowl with the sauce and stir to coat.",
      "secondary_message": "½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 469174,
      "primary_message": "When the veggies are soft, remove from the oven. Add chicken and sauce to the baking sheet; stir to combine with the veggies, then spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 469175,
      "primary_message": "Return the baking sheet to the oven and continue to bake until veggies are tender and chicken is warmed through, 5-6 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 469176,
      "primary_message": "To serve, divide chicken-veggie bake between plates or bowls and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
