  "instructions": [
    {
      "id": 469211,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 469212,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 469213,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Divide between two large baking sheets along with broccoli. Drizzle with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "6 yellow bell peppers\n1 ½ (18 oz) bags broccoli florets\n¼ cup toasted sesame oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 469214,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast until starting to soften, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 469215,
      "primary_message": "Meanwhile, wash, dry, and juice oranges into a large bowl. Add hoisin sauce and additional oil, then stir to combine.",
      "secondary_message": "3 oranges\n1 cup hoisin sauce\n3 tbsp toasted sesame oil"
    },
    {
      "id": 469216,
      "primary_message": "Medium dice tofu. Add to the bowl with the sauce and stir to coat.",
      "secondary_message": null
    },
    {
      "id": 469217,
      "primary_message": "When the veggies have started to soften, remove from the oven. Add tofu and sauce to the baking sheets; stir to combine with the veggies, then spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 469218,
      "primary_message": "Return the baking sheets to the oven and continue to bake until veggies are tender and tofu is warmed through, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 469219,
      "primary_message": "To serve, divide tofu-veggie bake between plates or bowls and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
