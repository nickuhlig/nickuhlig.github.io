  "instructions": [
    {
      "id": 213427,
      "primary_message": "Place water in a large pot. Add sugar, gently stir to combine, and place over medium-high heat. Cook, without stirring, until sugar begins to turn light golden in places, 7-9 minutes.",
      "secondary_message": "3 fl oz (⅜ cup) water\n1 ½ cup granulated sugar"
    },
    {
      "id": 213428,
      "primary_message": "Meanwhile, place cream, butter, and salt in a small saucepan; place over medium heat. Cook just until butter is melted and cream is heated through (do not boil), 2-3 minutes. Remove from heat.",
      "secondary_message": "6 fl oz (¾ cup) heavy cream\n3 tbsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 213429,
      "primary_message": "When the sugar begins to turn golden, gently swirl the saucepan in a circular motion to distribute the caramelization. Return to the heat and continue to cook, swirling occasionally, until the entire mixture is bright amber in color, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 213430,
      "primary_message": "Slowly add the warm cream mixture, a few tablespoons at a time, to the saucepan with the caramelized sugar, whisking after each addition (be careful, the sugar mixture will bubble vigorously). Once all of the cream is added, continue to whisk until smooth; set aside.",
      "secondary_message": null
    },
    {
      "id": 213431,
      "primary_message": "Wash, dry, quarter, and core apples; slice each quarter into wedges.",
      "secondary_message": "6 Granny Smith apples"
    },
    {
      "id": 213432,
      "primary_message": "To serve, divide apple wedges between plates and drizzle with warm caramel sauce. Enjoy!",
      "secondary_message": null
    }
  ],
