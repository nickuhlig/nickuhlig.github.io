  "instructions": [
    {
      "id": 203275,
      "primary_message": "Wash, dry, and peel mangos; slice flesh away from the pits, starting with the flat sides. Small dice one mango and transfer to a small bowl or container. Cover with plastic wrap or a lid and refrigerate until ready to serve.",
      "secondary_message": "2 mangoes"
    },
    {
      "id": 203276,
      "primary_message": "Roughly chop remaining mango and transfer to a blender.",
      "secondary_message": null
    },
    {
      "id": 203277,
      "primary_message": "Wash, dry, and juice lime into the blender.",
      "secondary_message": "1 lime"
    },
    {
      "id": 203278,
      "primary_message": "Add milk, sugar, maple syrup, vanilla, cinnamon, and cardamom to the blender. Blend on high speed for several minutes until smooth.",
      "secondary_message": "16 fl oz (2 cups) whole milk\n⅓ cup granulated sugar\n¼ cup pure maple syrup\n1 tsp vanilla extract\n⅛ tsp cinnamon\n⅛ tsp cardamom, ground"
    },
    {
      "id": 203279,
      "primary_message": "Pour the mango mixture into a medium bowl, add chia seeds, and whisk to combine. Let the mixture rest, whisking occasionally, until chia seeds start to swell, about 15 minutes.",
      "secondary_message": "⅓ cup chia seeds"
    },
    {
      "id": 203280,
      "primary_message": "When the chia seeds are slightly swollen, whisk the pudding once more to separate any seeds that are clumped together. Cover the bowl with plastic wrap or a lid and refrigerate until set, about 2 hours (or overnight).",
      "secondary_message": null
    },
    {
      "id": 203281,
      "primary_message": "Right before serving, roughly chop pistachios.",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 203282,
      "primary_message": "To serve, divide chia seed pudding between small bowls or cups; top with the reserved diced mango and pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
