  "instructions": [
    {
      "id": 103926,
      "primary_message": "Preheat oven to 425°F and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 103927,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb green beans\n1 pint grape tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 103928,
      "primary_message": "Peel and mince shallot; place in a medium bowl along with the oil, vinegar, Dijon, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n2 tsp Dijon mustard\n¼ tsp black pepper"
    },
    {
      "id": 103929,
      "primary_message": "Trim ends of green beans and arrange them in a single layer on a parchment-lined baking sheet pan. Add tomatoes and drizzle with half the dressing. Reserve the remaining dressing for later.",
      "secondary_message": null
    },
    {
      "id": 103930,
      "primary_message": "Place baking sheet in the oven and roast 10 minutes, until tomatoes and beans begin to soften.",
      "secondary_message": null
    },
    {
      "id": 103931,
      "primary_message": "Pat the tilapia dry with paper towels and place on a plate; season with pepper on both sides.",
      "secondary_message": "¾ lb tilapia fillet\n¼ tsp black pepper"
    },
    {
      "id": 103932,
      "primary_message": "Roughly chop the olives.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 103933,
      "primary_message": "Remove the vegetables from the oven and toss. Lay the fish on top of the vegetables and return to the oven; bake for 10 minutes, or until tilapia is cooked through.",
      "secondary_message": null
    },
    {
      "id": 103934,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 103935,
      "primary_message": "Change oven setting to broil and cook another 4 minutes, until the fish is slightly golden.",
      "secondary_message": null
    },
    {
      "id": 103936,
      "primary_message": "To serve, divide the fish and veggies between plates and top with olives, parsley, feta, and remaining dressing. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
