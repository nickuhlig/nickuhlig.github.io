  "instructions": [
    {
      "id": 103981,
      "primary_message": "Preheat oven to 220°C (425°F) and position rack in the upper third and middle of the oven.",
      "secondary_message": null
    },
    {
      "id": 103982,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg green beans\n3 small pkgs grape tomatoes\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 103983,
      "primary_message": "Peel and mince shallots; place in a medium bowl along with the oil, vinegar, Dijon, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 shallots\n⅓ cup extra virgin olive oil\n3 tbsp white wine vinegar\n2 tbsp Dijon mustard\n¾ tsp black pepper"
    },
    {
      "id": 103984,
      "primary_message": "Trim ends of green beans and arrange them in a single layer on two parchment-lined baking sheet pans. Add tomatoes and drizzle with half the dressing. Reserve the remaining dressing for later.",
      "secondary_message": null
    },
    {
      "id": 103985,
      "primary_message": "Place baking sheets in the oven and roast 10 minutes, until tomatoes and beans begin to soften.",
      "secondary_message": null
    },
    {
      "id": 103986,
      "primary_message": "Pat the tilapia dry with paper towels and place on a plate; season with pepper on both sides.",
      "secondary_message": "1.02 kg tilapia fillet\n¾ tsp black pepper"
    },
    {
      "id": 103987,
      "primary_message": "Roughly chop the olives.",
      "secondary_message": "1 ½ cups Kalamata olives, pitted"
    },
    {
      "id": 103988,
      "primary_message": "Remove the vegetables from the oven and toss. Lay the fish on top of the vegetables and return to the oven; bake for 10 minutes, or until tilapia is cooked through.",
      "secondary_message": null
    },
    {
      "id": 103989,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 103990,
      "primary_message": "Change oven setting to broil and cook the top sheet pan for another 4 minutes, until the fish is slightly golden; repeat with the second sheet pan.",
      "secondary_message": null
    },
    {
      "id": 103991,
      "primary_message": "To serve, divide the fish and veggies between plates and top with olives, parsley, feta, and remaining dressing. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
