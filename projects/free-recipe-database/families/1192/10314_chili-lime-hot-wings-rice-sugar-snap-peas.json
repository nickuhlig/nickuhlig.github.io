  "instructions": [
    {
      "id": 338054,
      "primary_message": "Preheat oven to 245°C (475°F). Line two baking sheets with foil.",
      "secondary_message": null
    },
    {
      "id": 338055,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 338056,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 338057,
      "primary_message": "Meanwhile, pat chicken wings dry with paper towels. ",
      "secondary_message": "1.36 kg chicken wings, split with tips removed"
    },
    {
      "id": 338058,
      "primary_message": "Combine baking powder, salt, and pepper in a large bowl. Add chicken wings and toss to coat.",
      "secondary_message": "1 tbsp baking powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 338059,
      "primary_message": "Divide wings between baking sheets and spread out in a single layer. Place in the oven and bake, turning halfway through, until crispy, 22-24 minutes.",
      "secondary_message": null
    },
    {
      "id": 338060,
      "primary_message": "Wash and dry the limes. Juice half of the limes into a large skillet; slice remaining limes into wedges and set aside.",
      "secondary_message": "3 limes"
    },
    {
      "id": 338061,
      "primary_message": "Add chili-garlic sauce, soy sauce, butter, and honey to the skillet with the lime juice. Bring to a boil over high heat and cook until slightly thickened, 2 minutes.",
      "secondary_message": "3 tbsp chili-garlic sauce\n3 tbsp soy sauce\n3 tbsp butter, unsalted\n3 tbsp honey"
    },
    {
      "id": 338062,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth. Add to the skillet in a steady stream while stirring quickly. Cook, stirring often, until sauce thickens, 2 minutes. Transfer sauce to a clean large bowl and set aside.",
      "secondary_message": "⅓ cup water\n2 tbsp cornstarch"
    },
    {
      "id": 338063,
      "primary_message": "Return skillet to the stove over medium-high heat; once hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 338064,
      "primary_message": "Wash and dry snap peas. Add to the skillet along with salt and pepper. Cook, stirring occasionally, until tender-crisp, 5-6 minutes.",
      "secondary_message": "3 (227 g) pkg sugar snap peas\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 338065,
      "primary_message": "Remove chicken wings from the oven and transfer to the bowl with the chili-lime sauce; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 338066,
      "primary_message": "To serve, divide rice, wings, and snap peas between plates. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
