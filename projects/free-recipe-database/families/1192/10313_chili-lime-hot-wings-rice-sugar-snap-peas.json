  "instructions": [
    {
      "id": 338041,
      "primary_message": "Preheat oven to 245°C (475°F). Line a large baking sheet with foil.",
      "secondary_message": null
    },
    {
      "id": 338042,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 338043,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 338044,
      "primary_message": "Meanwhile, pat chicken wings dry with paper towels. ",
      "secondary_message": "0.91 kg chicken wings, split with tips removed"
    },
    {
      "id": 338045,
      "primary_message": "Combine baking powder, salt, and pepper in a medium bowl. Add chicken wings and toss to coat.",
      "secondary_message": "2 tsp baking powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 338046,
      "primary_message": "Transfer wings to the baking sheet and spread out in a single layer. Place in the oven and bake, turning halfway through, until crispy, 20-22 minutes.",
      "secondary_message": null
    },
    {
      "id": 338047,
      "primary_message": "Wash and dry the limes. Juice one lime into a medium skillet; slice remaining lime into wedges and set aside.",
      "secondary_message": "2 limes"
    },
    {
      "id": 338048,
      "primary_message": "Add chili-garlic sauce, soy sauce, butter, and honey to the skillet with the lime juice. Bring to a boil over high heat and cook until slightly thickened, 1-2 minutes.",
      "secondary_message": "2 tbsp chili-garlic sauce\n2 tbsp soy sauce\n2 tbsp butter, unsalted\n2 tbsp honey"
    },
    {
      "id": 338049,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth. Add to the skillet in a steady stream while stirring quickly. Cook, stirring often, until sauce thickens, 1-2 minutes. Transfer sauce to a clean large bowl and set aside.",
      "secondary_message": "¼ cup water\n4 tsp cornstarch"
    },
    {
      "id": 338050,
      "primary_message": "Return skillet to the stove over medium-high heat; once hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 338051,
      "primary_message": "Wash and dry snap peas. Add to the skillet along with salt and pepper. Cook, stirring occasionally, until tender-crisp, 4-5 minutes.",
      "secondary_message": "2 (227 g) pkg sugar snap peas\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 338052,
      "primary_message": "Remove chicken wings from the oven and transfer to the bowl with the chili-lime sauce; toss to coat.",
      "secondary_message": null
    },
    {
      "id": 338053,
      "primary_message": "To serve, divide rice, wings, and snap peas between plates. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
