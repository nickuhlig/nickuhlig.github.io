  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Bring the eggs to room temperature. Bring the milk to room temperature. Melt the unsalted butter.",
      "secondary_message": "5 tbsp unsalted butter\n2 large eggs\n1 cup milk\n5 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "For the cake: Adjust oven rack to middle position and preheat oven to 175°C (350°F). Grease bundt pan with 1 tablespoon butter.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In medium bowl, whisk together flour, baking powder, baking soda, salt, and nutmeg; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In large bowl, beat remaining 4 tablespoons, oil, sugar, and brown sugar on medium speed until light and fluffy, about 3 minutes. Add eggs, one at a time, beating well after each addition",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Decrease mixer speed to low and add flour mixture in three batches, alternating with milk. Scrape sides and bottom of bowl with rubber spatula as needed. Increase speed to medium and beat mixture just until combined, 20 to 30 seconds. Add vanilla and beat once more, just to combine, about 10 seconds.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Scrape batter into prepared pan. Bake 30 to 35 minutes, rotating cake halfway through baking, until cake tester inserted in cake comes out clean. Transfer cake to cooling rack set inside baking sheet and cool in pan 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the cinnamon sugar coating: Combine sugar, cinnamon, nutmeg, and salt in small bowl. While the cake is still in the pan, brush the top with some of the melted butter. Once the 10 minutes have elapsed, invert cake onto cooling rack and brush cake all over with melted butter. Sprinkle with cinnamon sugar, using fingers to rub it onto the sides.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Cool cake completely, 1 to 2 hours.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "For the coffee glaze: Bring milk to simmer in small saucepan over medium-low heat (or microwave for 20 to 30 seconds in medium bowl). Whisk in espresso powder, confectioners’ sugar, salt, and vanilla. Drizzle over cooled cake and serve.",
      "secondary_message": null
    }
  ],
