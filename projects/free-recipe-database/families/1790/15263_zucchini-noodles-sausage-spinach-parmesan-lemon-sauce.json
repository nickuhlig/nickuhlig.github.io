  "instructions": [
    {
      "id": 251642,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 251643,
      "primary_message": "Arrange sausages on the baking sheet and place in the oven (it doesn't have to be fully heated); roast, flipping once, until sausages are golden and cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 251644,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n6 medium zucchini squash\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 251645,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 251646,
      "primary_message": "Finely grate Parmesan and add to the plate with the parsley (keeping them separate); set aside.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 251647,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a large bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 251648,
      "primary_message": "Peel and mince garlic; place in a large pot.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 251649,
      "primary_message": "Juice lemons into the pot with the garlic.",
      "secondary_message": null
    },
    {
      "id": 251650,
      "primary_message": "Mince pine nuts and add to the pot along with broth, oil, and spices; set over medium-high heat and bring to a simmer.",
      "secondary_message": "½ cup pine nuts\n355 ml chicken or vegetable broth\n2 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 251651,
      "primary_message": "Once the liquid in the pot comes to a simmer, add zucchini noodles and cook, stirring often, until just tender, about 4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 251652,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 251653,
      "primary_message": "Add parsley and half of the Parmesan (reserve remaining cheese for serving) to the pot; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 251654,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 251655,
      "primary_message": "To serve, divide saucy zucchini noodles and sausage between bowls; top with remaining Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
