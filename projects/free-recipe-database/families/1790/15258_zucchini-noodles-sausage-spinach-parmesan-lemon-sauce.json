  "instructions": [
    {
      "id": 251572,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 251573,
      "primary_message": "Arrange sausages on the baking sheet and place in the oven (it doesn't have to be fully heated); roast, flipping once, until sausages are golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 251574,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n2 medium zucchini squash\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 251575,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 251576,
      "primary_message": "Finely grate Parmesan and add to the plate with the parsley (keeping them separate); set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 251577,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a medium bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 251578,
      "primary_message": "Peel and mince garlic; place in a skillet.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 251579,
      "primary_message": "Juice lemon into the skillet with the garlic.",
      "secondary_message": null
    },
    {
      "id": 251580,
      "primary_message": "Mince pine nuts and add to the skillet along with broth, oil, and spices; set over medium-high heat and bring to a simmer.",
      "secondary_message": "⅛ cup pine nuts\n4 fl oz (½ cup) chicken or vegetable broth\n2 tsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 251581,
      "primary_message": "Once the liquid in the skillet comes to a simmer, add zucchini noodles and cook, stirring often, until just tender, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 251582,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 251583,
      "primary_message": "Add parsley and half of the Parmesan (reserve remaining cheese for serving) to the skillet; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 251584,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 251585,
      "primary_message": "To serve, divide saucy zucchini noodles and sausage between bowls; top with remaining Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
