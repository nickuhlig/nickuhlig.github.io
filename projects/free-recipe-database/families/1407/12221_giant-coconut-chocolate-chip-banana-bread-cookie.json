  "instructions": [
    {
      "id": 205533,
      "primary_message": "Preheat oven to 350°F. Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 205534,
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl.",
      "secondary_message": "1 banana"
    },
    {
      "id": 205535,
      "primary_message": "Add sugar, oil, and vanilla to the bowl with the banana. Crush with a fork or potato masher until smooth.",
      "secondary_message": "⅓ cup brown sugar\n2 tbsp virgin coconut oil\n1 tsp vanilla extract"
    },
    {
      "id": 205536,
      "primary_message": "Add coconut and chocolate chips to the bowl; stir to combine.",
      "secondary_message": "⅔ cup shredded unsweetened coconut\n½ cup dark chocolate chips"
    },
    {
      "id": 205537,
      "primary_message": "Place flour, cornstarch, baking powder, baking soda, and salt in a small bowl; stir to combine.",
      "secondary_message": "½ cup all-purpose flour\n½ tsp cornstarch\n¼ tsp baking powder\n¼ tsp baking soda\n⅛ tsp salt"
    },
    {
      "id": 205538,
      "primary_message": "Add flour mixture to the bowl with the banana and stir to combine the cookie batter.",
      "secondary_message": null
    },
    {
      "id": 205539,
      "primary_message": "Use a ⅓ cup measure to scoop the batter onto the baking sheet. Using a silicone spatula or the back of a spoon, spread each cookie into a 3-inch circle. Place in the oven and bake until golden around the edges, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 205540,
      "primary_message": "Allow cookies to cool slightly and enjoy!",
      "secondary_message": null
    }
  ],
