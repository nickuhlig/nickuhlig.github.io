  "instructions": [
    {
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "primary_message": "Using a 3 ½-inch star cookie cutter, cut bread into star shapes. Divide between two baking sheet pans, arranging stars in a single layer. \n\n",
      "secondary_message": "1 ½ (624 g) loaf white bread"
    },
    {
      "primary_message": "Working in batches, place baking sheets in the oven and toast, flipping halfway through, until stars are lightly golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place mayo, mustard, and honey in a small bowl. Whisk to combine and set aside. ",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp yellow mustard\n1 tbsp honey"
    },
    {
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Place on a plate.",
      "secondary_message": "1 avocado"
    },
    {
      "primary_message": "Wash and dry alfalfa sprouts. Add to the plate with the avocado and set aside.",
      "secondary_message": "½ (85 g) pkg alfalfa sprouts"
    },
    {
      "primary_message": "Arrange half of the stars on a flat surface and spread with honey-mustard mayo. (Reserve remaining stars for the next step.)",
      "secondary_message": null
    },
    {
      "primary_message": "Fold turkey slices into quarters and layer on top of the mayo. Top with an avocado slice and a small handful of sprouts. Close sandwiches with remaining stars and secure with a toothpick.",
      "secondary_message": "1 (227 g) pkg oven roasted turkey breast, sliced"
    },
    {
      "primary_message": "Arrange sandwiches on a platter and enjoy!",
      "secondary_message": null
    }
  ],
