  "instructions": [
    {
      "id": 11519,
      "primary_message": "Preheat a grill pan or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11520,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "1 lb boneless skinless chicken breasts\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 11521,
      "primary_message": "Coat grill/skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 11522,
      "primary_message": "Wash, seed, and cut bell peppers into short strips.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 11523,
      "primary_message": "Return grill/skillet to stove. Add peppers and cook until tender-crisp, 3-4 minutes. Transfer to plate with chicken.",
      "secondary_message": ""
    },
    {
      "id": 11524,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare the spread by mashing together garlic, goat cheese, vinegar, and oregano.",
      "secondary_message": "2 cloves garlic\r\n1 (4 oz) log goat cheese\r\n1 tsp balsamic vinegar\r\n1 tsp oregano"
    },
    {
      "id": 11525,
      "primary_message": "Slice buns/rolls in half.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 11526,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 11527,
      "primary_message": "Spread ⅛ of the goat cheese mixture onto each of the 8 bun/roll halves. Top bottom halves with a few arugula leaves, chicken, and ½ of the bell peppers (save the rest for the salad). Close with top halves.",
      "secondary_message": ""
    },
    {
      "id": 11528,
      "primary_message": "Place sandwiches on grill/skillet and carefully flatten using a panini press or something heavy. Cook until browned and crispy on the bottom, 1-2 minutes. Carefully flip and continue cooking until browned on the other side, another 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11529,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together oil, vinegar, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n1 tbsp balsamic vinegar\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 11530,
      "primary_message": "Wash and dry arugula and tomatoes. Cut the tomatoes into thin wedges. Add arugula, tomatoes, and remaining bell pepper to bowl with dressing. Toss salad.",
      "secondary_message": "1 (5 oz) pkg baby arugula\r\n2 tomatoes"
    },
    {
      "id": 11531,
      "primary_message": "To serve, cut panini in half and place on a plate with salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
