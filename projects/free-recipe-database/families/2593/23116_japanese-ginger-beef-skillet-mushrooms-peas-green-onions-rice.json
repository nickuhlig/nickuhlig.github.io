  "instructions": [
    {
      "id": 381100,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 381101,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 381102,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n½ lb cremini mushrooms\n1 medium carrot\n½ small bunch green onions (scallions)"
    },
    {
      "id": 381103,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small bowl along with broth, soy sauce, cornstarch, fish sauce, and sugar. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 clove garlic\n4 fl oz (½ cup) chicken or vegetable broth\n2 tbsp soy sauce\n1 tbsp cornstarch\n2 tsp fish sauce\n1 ½ tsp brown sugar"
    },
    {
      "id": 381104,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 381105,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381106,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and salt; cook, stirring occasionally, until golden brown, 3-4 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt"
    },
    {
      "id": 381107,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrot.",
      "secondary_message": null
    },
    {
      "id": 381108,
      "primary_message": "When the mushrooms are done, add carrot, beef, additional salt, and pepper to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "¾ lb lean ground beef\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 381109,
      "primary_message": "While the beef is cooking, place peas in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 381110,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 381111,
      "primary_message": "When the beef is done, add the sauce, peas, and half of the green onions to the skillet (reserve remaining green onions for serving). Continue to cook, stirring occasionally, until sauce has thickened, about 1 minute. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 381112,
      "primary_message": "To serve, divide rice and beef skillet between plates or bowls; top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
