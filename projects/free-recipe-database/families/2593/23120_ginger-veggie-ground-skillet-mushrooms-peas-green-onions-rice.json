  "instructions": [
    {
      "id": 381152,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 381153,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 381154,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 lb cremini mushrooms\n2 medium carrots\n1 small bunch green onions (scallions)"
    },
    {
      "id": 381155,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small bowl along with broth, soy sauce, cornstarch, and sugar. Whisk to combine the sauce and set aside.",
      "secondary_message": "2 cloves garlic\n8 fl oz (1 cup) chicken or vegetable broth\n¼ cup soy sauce\n2 tbsp cornstarch\n1 tbsp brown sugar"
    },
    {
      "id": 381156,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 381157,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381158,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and salt; cook, stirring occasionally, until golden brown, 3-4 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 381159,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrots.",
      "secondary_message": null
    },
    {
      "id": 381160,
      "primary_message": "When the mushrooms are done, add additional oil, carrot, veggie ground, salt, and pepper to the skillet. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n16 oz veggie ground, plant based\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 381161,
      "primary_message": "While the veggie ground is cooking, place peas in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 381162,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 381163,
      "primary_message": "When the veggie ground is done, add the sauce, peas, and half of the green onions to the skillet (reserve remaining green onions for serving). Continue to cook, stirring occasionally, until sauce has thickened, about 1 minute. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 381164,
      "primary_message": "To serve, divide rice and veggie ground skillet between plates or bowls; top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
