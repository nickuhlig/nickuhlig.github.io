  "instructions": [
    {
      "id": 381126,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 381127,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 381128,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ lb cremini mushrooms\n3 medium carrots\n1 small bunch green onions (scallions)"
    },
    {
      "id": 381129,
      "primary_message": "Peel and mince ginger and garlic. Place both in a small bowl along with broth, soy sauce, cornstarch, fish sauce, and sugar. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 cloves garlic\n12 fl oz (1 ½ cups) chicken or vegetable broth\n⅓ cup soy sauce\n3 tbsp cornstarch\n2 tbsp fish sauce\n1 ½ tbsp brown sugar"
    },
    {
      "id": 381130,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 381131,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381132,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and salt; cook, stirring occasionally, until golden brown, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt"
    },
    {
      "id": 381133,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrots.",
      "secondary_message": null
    },
    {
      "id": 381134,
      "primary_message": "When the mushrooms are done, add carrot, beef, additional salt, and pepper to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 ¼ lb lean ground beef\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 381135,
      "primary_message": "While the beef is cooking, place peas in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 381136,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 381137,
      "primary_message": "When the beef is done, add the sauce, peas, and half of the green onions to the skillet (reserve remaining green onions for serving). Continue to cook, stirring occasionally, until sauce has thickened, about 2 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 381138,
      "primary_message": "To serve, divide rice and beef skillet between plates or bowls; top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
