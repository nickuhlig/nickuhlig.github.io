  "instructions": [
    {
      "id": 508611,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 508612,
      "primary_message": "In a medium saucepan, combine water, quinoa, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "2 cup water\n1 cup quinoa\n½ tsp salt"
    },
    {
      "id": 508613,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 508614,
      "primary_message": "While the skillet heats up, place cashews, oil, and spices in a small bowl; stir to coat.",
      "secondary_message": "½ cup cashews, roasted unsalted\n2 tsp extra virgin olive oil\n1 tsp chili powder\n¼ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 508615,
      "primary_message": "Once the skillet is hot, add the cashews and cook, stirring constantly, until golden brown, 3-4 minutes. Return cashews to the bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 508616,
      "primary_message": "Medium dice tofu and place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then toss to coat.",
      "secondary_message": "2 tbsp cornstarch\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 508617,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes. Remove to a plate and loosely cover with aluminum foil. Wipe the bowl clean with paper towels and reserve for later use.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 508618,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 (2 ½ cm) pieces ginger root\n2 medium carrots\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 medium head napa cabbage\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 508619,
      "primary_message": "Juice lime into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 508620,
      "primary_message": "Peel and mince ginger. Add to the bowl with the lime juice along with oil, soy sauce, maple syrup, and chili-garlic sauce; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp soy sauce\n2 tsp pure maple syrup\n1 tsp chili-garlic sauce"
    },
    {
      "id": 508621,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 508622,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 508623,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 508624,
      "primary_message": "Trim off and discard the root end of the cabbage, halve lengthwise, then thinly slice crosswise. Add to the bowl along with quinoa, spicy cashews, and spinach, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 508625,
      "primary_message": "To serve, divide salad between plates or bowls; top with tofu and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
