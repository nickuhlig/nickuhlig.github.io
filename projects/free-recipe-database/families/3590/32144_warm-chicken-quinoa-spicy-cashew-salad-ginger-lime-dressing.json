  "instructions": [
    {
      "id": 508384,
      "primary_message": "In a medium saucepan, combine water, quinoa, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "2 cup water\n1 cup quinoa\n½ tsp salt"
    },
    {
      "id": 508385,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 508386,
      "primary_message": "While the skillet heats up, place cashews, oil, and spices in a small bowl; stir to coat.",
      "secondary_message": "½ cup cashews, roasted unsalted\n2 tsp extra virgin olive oil\n1 tsp chili powder\n¼ tsp cayenne pepper\n¼ tsp salt"
    },
    {
      "id": 508387,
      "primary_message": "Once the skillet is hot, add the cashews and cook, stirring constantly, until golden brown, 3-4 minutes. Return cashews to the bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": null
    },
    {
      "id": 508388,
      "primary_message": "Pat chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 508389,
      "primary_message": "Return the skillet to medium-high heat, add oil, and swirl to coat the bottom. Add chicken and cook, flipping once, until cooked through and golden, 8-10 minutes. Remove to a plate and loosely cover with aluminum foil. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 508390,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 (1 inch) pieces ginger root\n2 medium carrots\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 medium head napa cabbage\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 508391,
      "primary_message": "Juice lime into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 508392,
      "primary_message": "Using a clean cutting board, peel and mince ginger. Add to the bowl with the lime juice along with oil, soy sauce, maple syrup, and chili garlic sauce; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp soy sauce\n2 tsp pure maple syrup\n1 tsp chili-garlic sauce"
    },
    {
      "id": 508393,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 508394,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 508395,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 508396,
      "primary_message": "Trim off and discard the root end of the cabbage, halve lengthwise, then thinly slice crosswise. Add to the bowl along with quinoa, spicy cashews, and spinach, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 508397,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 508398,
      "primary_message": "To serve, divide salad between plates or bowls; top with chicken and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
