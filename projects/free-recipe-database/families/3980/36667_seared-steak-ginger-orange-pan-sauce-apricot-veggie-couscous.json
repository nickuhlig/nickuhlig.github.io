  "instructions": [
    {
      "id": 575677,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n2 sticks celery\n1 orange\n1 (2 ½ cm) piece ginger root\n1 tomato"
    },
    {
      "id": 575678,
      "primary_message": "Peel, trim, and small dice carrot. Trim and small dice celery. Place both in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 575679,
      "primary_message": "Small dice apricots. Add to the bowl with the carrot and celery.",
      "secondary_message": "4 dried apricots"
    },
    {
      "id": 575680,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 575681,
      "primary_message": "While the pan heats up, peel and mince shallot and garlic. Add both to the bowl.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 575682,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, apricot, and spices; cook, stirring occasionally, until veggies are tender, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 575683,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 575684,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and cut into portions. Season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 575685,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 575686,
      "primary_message": "When the veggies are tender, add broth to the pan and bring to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 575687,
      "primary_message": "Meanwhile, zest and juice orange into the reserved bowl. Add Dijon and sugar, then stir to combine. Set aside.",
      "secondary_message": "1 tsp Dijon mustard\n½ tsp brown sugar"
    },
    {
      "id": 575688,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 575689,
      "primary_message": "When the steak is done, return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add ginger, garlic, salt, and pepper; cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 575690,
      "primary_message": "Add orange mixture to the skillet and continue to cook, stirring frequently, until sauce is reduced slightly, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 575691,
      "primary_message": "Small dice tomato. Add to the pan with the couscous and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 575692,
      "primary_message": "To serve, divide couscous and steak between plates. Top steak with ginger-orange pan sauce and enjoy!",
      "secondary_message": null
    }
  ],
