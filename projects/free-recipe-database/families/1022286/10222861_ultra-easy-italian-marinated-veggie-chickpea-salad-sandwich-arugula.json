  "instructions": [
    {
      "primary_message": "Drain and rinse chickpeas. Place in a medium bowl along with mayo, salt, and pepper. Using a fork or potato masher, roughly mash chickpea salad until semi-smooth and combined.",
      "secondary_message": "1 (254 g) can garbanzo beans (chickpeas)\n¼ cup mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Drain and roughly chop pickled veggies. Add to the bowl with the mashed chickpeas and stir to combine.",
      "secondary_message": "⅔ cup giardiniera (mixed Italian pickled vegetables)"
    },
    {
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Toast buns if desired.",
      "secondary_message": "¼ (142 g) pkg baby arugula"
    },
    {
      "primary_message": "Divide chickpea salad between the bottom half of each bun. Top with arugula, then close with the top half of each bun.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide sandwiches between plates. Enjoy!",
