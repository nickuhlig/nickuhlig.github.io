  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 220°C (425°F). Bring a large pot of salted water to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, heat olive oil in a large saucepan over high heat until shimmering. Add onion and green pepper and cook, stirring often, until soft, about 2 minutes. Add garlic, chili powder, red pepper flakes, cumin, and oregano. Stir continuously until very fragrant, 30 seconds to 1 minute. Add beef and cook until no longer pink, stirring frequently with a wooden spoon to break up the meat, about 7 minutes. Add tomatoes and juice and the hot sauce, stir well, and bring to a boil. Reduce heat to maintain a steady simmer and cook until thickened, about 30 minutes. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cook pasta in the boiling water according to the directions on the packaging. Drain in a colander and then stir into the chili mac. Cover and keep warm.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Slice the rolls in half horizontally. Place rolls, cut-side up, on a large baking sheet covered with aluminum foil. Sprinkle cut sides with grated cheese. Place rolls in the oven and cook until cheese melts and rolls are toasted, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spoon the chili mac onto the bottom rolls and crown with the top piece. Serve.",
      "secondary_message": null
    }
  ],
