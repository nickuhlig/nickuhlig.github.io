  "instructions": [
    {
      "id": 160682,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 160683,
      "primary_message": "Peel and mince onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 160684,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring often, until softened, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 160685,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 160686,
      "primary_message": "Add garlic, seeds, salt, and pepper to the skillet with the onion. Continue to cook, stirring often, until the onion and garlic become golden, 2-3 minutes. Transfer to a small bowl to keep the garlic from overcooking. ",
      "secondary_message": "2 tbsp sesame seeds\n1 tbsp poppy seeds\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 160687,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 bunch radish\n1 English cucumber\n1 ½ tomatoes"
    },
    {
      "id": 160688,
      "primary_message": "Trim off and discard tops and root ends of radishes. Thinly slice and transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 160689,
      "primary_message": "Trim off and discard ends of the cucumber; slice crosswise into ¼-inch pieces at an angle. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 160690,
      "primary_message": "Slice tomatoes into rounds and add to the plate. Season veggies with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 160691,
      "primary_message": "Halve and toast rolls.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 160692,
      "primary_message": "Combine goat cheese and yogurt in a medium bowl and mash with a fork until smooth and creamy. ",
      "secondary_message": "3 (4 oz) logs goat cheese\n1 ½ cups plain Greek yogurt"
    },
    {
      "id": 160693,
      "primary_message": "Spread goat cheese mixture over toasted rolls. Layer with smoked salmon, cucumber, tomato, radish, and capers. ",
      "secondary_message": "3 (4 oz) pkgs smoked salmon\n3 tbsp capers"
    },
    {
      "id": 160694,
      "primary_message": "To serve, divide between plates and top with \"Everything\" spice. Enjoy!",
      "secondary_message": null
    }
  ],
