  "instructions": [
    {
      "id": 160656,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 160657,
      "primary_message": "Peel and mince shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 160658,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom. Add the shallot and cook, stirring often, until softened, about 2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 160659,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 160660,
      "primary_message": "Add garlic, seeds, salt, and pepper to the skillet with the shallot. Continue to cook, stirring often, until the shallot and garlic become golden, 2-3 minutes. Transfer to a small bowl to keep the garlic from overcooking. ",
      "secondary_message": "2 tsp sesame seeds\n1 tsp poppy seeds\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 160661,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ bunch radish\n½ English cucumber\n½ tomato"
    },
    {
      "id": 160662,
      "primary_message": "Trim off and discard tops and root ends of radishes. Thinly slice and transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 160663,
      "primary_message": "Trim off and discard ends of the cucumber; slice crosswise into ¼-inch pieces at an angle. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 160664,
      "primary_message": "Slice tomato into rounds and add to the plate. Season veggies with salt and pepper.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 160665,
      "primary_message": "Halve and toast rolls.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 160666,
      "primary_message": "Combine goat cheese and yogurt in a small bowl and mash with a fork until smooth and creamy. ",
      "secondary_message": "1 (4 oz) log goat cheese\n½ cup plain Greek yogurt"
    },
    {
      "id": 160667,
      "primary_message": "Spread goat cheese mixture over toasted rolls. Layer with smoked salmon, cucumber, tomato, radish, and capers. ",
      "secondary_message": "1 (4 oz) pkg smoked salmon\n1 tbsp capers"
    },
    {
      "id": 160668,
      "primary_message": "To serve, divide between plates and top with \"Everything\" spice. Enjoy!",
      "secondary_message": null
    }
  ],
