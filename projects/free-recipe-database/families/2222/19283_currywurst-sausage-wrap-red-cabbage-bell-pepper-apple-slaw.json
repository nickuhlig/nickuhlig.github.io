  "instructions": [
    {
      "id": 317125,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 317126,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small head red cabbage\n1 Granny Smith apple\n1 yellow bell pepper"
    },
    {
      "id": 317127,
      "primary_message": "Once the pan is hot, coat with oil; add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 pork sausages"
    },
    {
      "id": 317128,
      "primary_message": "While the sausages are cooking, place ketchup, water, Worcestershire, vinegar, and spices in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "2 tbsp ketchup\n1 tbsp water\n1 tsp Worcestershire sauce\n1 tsp apple cider vinegar\n1 tsp curry powder\n½ tsp garlic powder\n¼ tsp paprika\n¼ tsp salt\n1 pinch cayenne pepper"
    },
    {
      "id": 317129,
      "primary_message": "Juice lemon into a medium bowl; add yogurt, mayo, and spices. Whisk to combine the dressing. ",
      "secondary_message": "⅛ cup plain Greek yogurt\n2 tsp mayonnaise\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 317130,
      "primary_message": "Quarter cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 317131,
      "primary_message": "Quarter, core, and small dice apple; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 317132,
      "primary_message": "Trim, halve, seed, and slice bell pepper into thin strips; add to the bowl and toss to combine the slaw. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 317133,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 317134,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 317135,
      "primary_message": "Place tortillas on a flat surface and top each with a small portion of slaw; arrange sausage slices on top and drizzle with sauce. Roll tightly to close. (Reserve remaining slaw for serving.)",
      "secondary_message": null
    },
    {
      "id": 317136,
      "primary_message": "Cut wraps in half and divide between plates; serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
