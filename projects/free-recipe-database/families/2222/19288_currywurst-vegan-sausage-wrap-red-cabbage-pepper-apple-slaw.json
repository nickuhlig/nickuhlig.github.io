  "instructions": [
    {
      "id": 317185,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 317186,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ small heads red cabbage\n3 Granny Smith apples\n3 yellow bell peppers"
    },
    {
      "id": 317187,
      "primary_message": "Once the pan is hot, coat with oil; add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook according to package instructions). Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 317188,
      "primary_message": "While the sausages are cooking, place ketchup, water, soy sauce, vinegar, and spices in a small bowl. Whisk to combine the sauce and set aside. ",
      "secondary_message": "⅓ cup ketchup\n3 tbsp water\n1 tbsp soy sauce\n1 tbsp apple cider vinegar\n1 tbsp curry powder\n1 ½ tsp garlic powder\n¾ tsp paprika\n½ tsp salt\n3 pinch cayenne pepper"
    },
    {
      "id": 317189,
      "primary_message": "Juice lemons into a large bowl; add mayo, water, and spices. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup vegan mayonnaise\n3 tbsp water\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317190,
      "primary_message": "Quarter each cabbage lengthwise, then cut out and discard the core; slice crosswise into thin (shred-like) strips and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 317191,
      "primary_message": "Quarter, core, and small dice apples; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 317192,
      "primary_message": "Trim, halve, seed, and slice bell peppers into thin strips; add to the bowl and toss to combine the slaw. Set aside. ",
      "secondary_message": null
    },
    {
      "id": 317193,
      "primary_message": "When the sausages are done, transfer to a cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 317194,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 317195,
      "primary_message": "Place tortillas on a flat surface and top each with a small portion of slaw; arrange sausage slices on top and drizzle with sauce. Roll tightly to close. (Reserve remaining slaw for serving.)",
      "secondary_message": null
    },
    {
      "id": 317196,
      "primary_message": "Cut wraps in half and divide between plates; serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
