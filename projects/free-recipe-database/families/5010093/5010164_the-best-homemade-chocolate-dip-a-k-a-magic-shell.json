    {
      "ingredient_id": 1729,
      "name": "dark chocolate, 66% to 72%, finely chopped",
      "quantity": "250 g"
    },
    {
      "ingredient_id": 1848,
      "name": "refined coconut oil",
      "quantity": "200 g"
    },
