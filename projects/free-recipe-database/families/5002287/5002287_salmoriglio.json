  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Finely mince the fresh oregano leaves. Finely mince the fresh parsley leaves.",
      "secondary_message": "2 cloves garlic\n¾ cup fresh oregano leaves\n¾ cup fresh parsley leaves"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk lemon zest, juice, 3/4 teaspoon salt, and 1/2 teaspoon pepper together.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a microwave-safe liquid measuring cup, combine oil and garlic and microwave on high until fragrant and warm to the touch, 25 to 30 seconds. Let mixture cool completely, at least 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Slowly drizzle cooled oil mixture into lemon juice while whisking vigorously. Whisk until oil is fully incorporated and the mixture is evenly cloudy yellow.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Stir in oregano and parsley. Season with salt and pepper to taste.",
      "secondary_message": null
    }
