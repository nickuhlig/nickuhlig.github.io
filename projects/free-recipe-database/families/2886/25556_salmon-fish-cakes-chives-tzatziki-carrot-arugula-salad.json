  "instructions": [
    {
      "id": 409618,
      "primary_message": "Wash, dry, and chop chives into small pieces. Place in a medium bowl.",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 409619,
      "primary_message": "Drain salmon, add to the bowl with the chives, and flake with a fork.",
      "secondary_message": "4 (213 g) cans wild pink salmon, traditional style"
    },
    {
      "id": 409620,
      "primary_message": "Add eggs, flour, and spices to the bowl; stir until well combined.",
      "secondary_message": "2 eggs\n⅓ cup all-purpose flour\n1 tsp paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 409621,
      "primary_message": "Using a ¼-cup measure, form the salmon mixture into ½-inch thick patties; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 409622,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 409623,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fish cakes and cook until golden brown and crispy, 3-4 minutes per side. Transfer to a paper towel-lined plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 409624,
      "primary_message": "While the fish cakes are cooking, wash and dry arugula (skip if it came pre-washed).",
      "secondary_message": "1 (142 g) pkg baby arugula"
    },
    {
      "id": 409625,
      "primary_message": "To serve, divide fish cakes between plates, then top with tzatziki. Add arugula to the plate, top with carrots, and drizzle with vinaigrette. Enjoy! ",
      "secondary_message": "1 cup tzatziki sauce\n1 (283 g) bag shredded carrots\n¼ cup French vinaigrette"
    }
  ],
