  "instructions": [
    {
      "id": 343582,
      "primary_message": "Preheat the oven to 260°C (500°F) and place the rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 343583,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium spaghetti squash\n1 (142 g) pkg baby spinach\n1 small bunch asparagus"
    },
    {
      "id": 343584,
      "primary_message": "Trim squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 343585,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 343586,
      "primary_message": "Meanwhile, roughly chop spinach, place in a medium bowl, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 343587,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 343588,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 343589,
      "primary_message": "While the pan heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 343590,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add asparagus and garlic. Cook, stirring occasionally, until fork-tender, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 343591,
      "primary_message": "Meanwhile, cut cream cheese into small pieces; drain and thinly slice artichokes.",
      "secondary_message": "½ (227 g) block cream cheese\n1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 343592,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 343593,
      "primary_message": "When the asparagus is done, add cream cheese, artichokes, Parmesan, milk, and water to the pan. Stir until the cheese is melted and sauce is heated through, 1-2 minutes.",
      "secondary_message": "59 ml (¼ cup) whole milk\n2 tbsp water"
    },
    {
      "id": 343594,
      "primary_message": "Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove sauce from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 343595,
      "primary_message": "Remove squash from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 343596,
      "primary_message": "To serve, divide squash and sauce between plates. Sprinkle with crushed red pepper and enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
