  "instructions": [
    {
      "id": 343612,
      "primary_message": "Preheat the oven to 260°C (500°F) and place the racks in the upper and center positions. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 343613,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium spaghetti squash\n3 (142 g) pkg baby spinach\n3 small bunches asparagus"
    },
    {
      "id": 343614,
      "primary_message": "Trim each squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheets.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 343615,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 343616,
      "primary_message": "Meanwhile, roughly chop spinach, place in a large bowl, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 343617,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 343618,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 343619,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 343620,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add asparagus and garlic. Cook, stirring occasionally, until fork-tender, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 343621,
      "primary_message": "Meanwhile, cut cream cheese into small pieces; drain and thinly slice artichokes.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese\n3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 343622,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 343623,
      "primary_message": "When the asparagus is done, add cream cheese, artichokes, Parmesan, milk, and water to the pot. Stir until the cheese is melted and sauce is heated through, about 2 minutes.",
      "secondary_message": "177 ml whole milk\n⅓ cup water"
    },
    {
      "id": 343624,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove sauce from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 343625,
      "primary_message": "Remove squash from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 343626,
      "primary_message": "To serve, divide squash and sauce between plates. Sprinkle with crushed red pepper and enjoy!",
      "secondary_message": "3 pinch crushed red pepper"
    }
  ],
