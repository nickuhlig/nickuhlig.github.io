  "instructions": [
    {
      "id": 336280,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 336281,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 yellow bell peppers\n3 medium zucchini squash"
    },
    {
      "id": 336282,
      "primary_message": "Peel, trim, and cut carrots crosswise into thin rounds; divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 336283,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the carrot.",
      "secondary_message": null
    },
    {
      "id": 336284,
      "primary_message": "Trim and slice zucchini crosswise into thin rounds; add to the baking sheets. Drizzle veggies with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 336285,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 336286,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 336287,
      "primary_message": "While the couscous is cooking, place tomato sauce, Dijon, vinegar, soy sauce, sugar, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "1 ½ (213 ml) cans tomato sauce\n3 tbsp Dijon mustard\n2 tbsp apple cider vinegar\n2 tbsp soy sauce\n2 tbsp brown sugar\n1 ½ tsp salt\n1 ½ tsp onion powder\n¾ tsp chili powder"
    },
    {
      "id": 336288,
      "primary_message": "Slice the sausages into thin rounds.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 336289,
      "primary_message": "When the veggies are done, add sausage to the baking sheets; drizzle with BBQ sauce, toss to combine, and spread out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 336290,
      "primary_message": "Return baking sheets to the oven and continue to roast until veggies and sausage are caramelized, 5-6 minutes more (or cook sausages according to package instructions). Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 336291,
      "primary_message": "To serve, divide sausage, veggies, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
