  "instructions": [
    {
      "id": 336168,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 336169,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 yellow bell peppers\n3 medium zucchini squash"
    },
    {
      "id": 336170,
      "primary_message": "Peel, trim, and cut carrots crosswise into thin rounds; divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 336171,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the carrot.",
      "secondary_message": null
    },
    {
      "id": 336172,
      "primary_message": "Trim and slice zucchini crosswise into thin rounds; add to the baking sheets. Drizzle veggies with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 336173,
      "primary_message": "Add sausages to the baking sheets, nestling them into the veggies.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 336174,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender and sausages are cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 336175,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 336176,
      "primary_message": "While the couscous is cooking, place tomato sauce, Dijon, vinegar, Worcestershire, sugar, and spices in a small bowl; whisk to combine the BBQ sauce.",
      "secondary_message": "1 ½ (8 oz) cans tomato sauce\n3 tbsp Dijon mustard\n2 tbsp apple cider vinegar\n2 tbsp Worcestershire sauce\n2 tbsp brown sugar\n1 ½ tsp salt\n1 ½ tsp onion powder\n¾ tsp chili powder"
    },
    {
      "id": 336177,
      "primary_message": "When the sausages and veggies are done, transfer sausages to a cutting board and slice crosswise into thin rounds. ",
      "secondary_message": null
    },
    {
      "id": 336178,
      "primary_message": "Return sausages to the baking sheets with the veggies; drizzle with BBQ sauce, toss to combine, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 336179,
      "primary_message": "Return baking sheets to the oven and continue to roast until veggies and sauce are caramelized, 5-6 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 336180,
      "primary_message": "To serve, divide sausage, veggies, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
