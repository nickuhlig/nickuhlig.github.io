  "instructions": [
    {
      "id": 573677,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 limes\n1 small bunch cilantro\n3 avocados\n3 tomatoes"
    },
    {
      "id": 573678,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "⅓ cup apple cider vinegar\n1 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 573679,
      "primary_message": "Peel, halve, and small dice onions. Add half to the bowl with the pickling liquid. Place remaining onion in another medium bowl and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 573680,
      "primary_message": "Trim and small dice cucumbers. Add to the medium bowl with the pickling liquid, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 573681,
      "primary_message": "Place veggie ground and spices in a large bowl. Mix with your hands until well combined.",
      "secondary_message": "24 oz veggie ground, plant based\n1 tbsp chili powder\n¾ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 573682,
      "primary_message": "Arrange tortillas on a flat surface, then divide the veggie ground mixture between them (about 2 tablespoons per tortilla). Using a knife (or your hands), spread the veggie ground mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 573683,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 573684,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, veggie ground-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the veggie ground is cooked through, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 573685,
      "primary_message": "Flip tacos, veggie ground-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos.",
      "secondary_message": null
    },
    {
      "id": 573686,
      "primary_message": "Meanwhile, juice half of the limes into the large bowl with the onion (cut remaining limes into wedges and set aside for serving).",
      "secondary_message": null
    },
    {
      "id": 573687,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 573688,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Add to the bowl along with salt and pepper. Mash with a fork or potato masher until guacamole is smooth.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 573689,
      "primary_message": "Small dice tomatoes. Add to the bowl with the guacamole and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 573690,
      "primary_message": "Divide tacos between plates; fill with guacamole and a small amount of salad. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
