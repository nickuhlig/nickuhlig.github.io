  "instructions": [
    {
      "id": 573621,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 limes\n1 small bunch cilantro\n2 avocados\n2 tomatoes"
    },
    {
      "id": 573622,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "¼ cup apple cider vinegar\n2 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 573623,
      "primary_message": "Peel, halve, and small dice onion. Add half to the bowl with the pickling liquid. Place remaining onion in another medium bowl and set aside.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 573624,
      "primary_message": "Trim and small dice cucumber. Add to the bowl with the pickling liquid, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 573625,
      "primary_message": "Place turkey and spices in a third medium bowl. Mix with your hands until well combined.",
      "secondary_message": "1 ½ lb ground turkey\n2 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 573626,
      "primary_message": "Arrange tortillas on a flat surface, then divide the turkey mixture between them (about 3 tablespoons per tortilla). Using a knife (or your hands), spread the turkey mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 573627,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 573628,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the turkey is cooked through, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 573629,
      "primary_message": "Flip tacos, turkey-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos.",
      "secondary_message": null
    },
    {
      "id": 573630,
      "primary_message": "Meanwhile, juice one lime into the medium bowl with the onion (cut remaining lime into wedges and set aside for serving).",
      "secondary_message": null
    },
    {
      "id": 573631,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 573632,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Add to the bowl along with salt and pepper. Mash with a fork or potato masher until guacamole is smooth.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 573633,
      "primary_message": "Small dice tomatoes. Add to the bowl with the guacamole and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 573634,
      "primary_message": "Divide tacos between plates; fill with guacamole and a small amount of salad. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
