  "instructions": [
    {
      "id": 573649,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 lime\n½ small bunch cilantro\n1 avocado\n1 tomato"
    },
    {
      "id": 573650,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "2 tbsp apple cider vinegar\n1 tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 573651,
      "primary_message": "Peel, halve, and small dice onion. Add half to the bowl with the pickling liquid. Place remaining onion in a medium bowl and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 573652,
      "primary_message": "Trim and small dice cucumber. Add to the small bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 573653,
      "primary_message": "Place veggie ground and spices in another medium bowl. Mix with your hands until well combined.",
      "secondary_message": "8 oz veggie ground, plant based\n1 tsp chili powder\n¼ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 573654,
      "primary_message": "Arrange tortillas on a flat surface, then divide the veggie ground mixture between them (about 2 tablespoons per tortilla). Using a knife (or your hands), spread the veggie ground mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 573655,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 573656,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, veggie ground-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the veggie ground is cooked through, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 573657,
      "primary_message": "Flip tacos, veggie ground-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos.",
      "secondary_message": null
    },
    {
      "id": 573658,
      "primary_message": "Meanwhile, juice half of the lime into the medium bowl with the onion (cut remaining lime into wedges and set aside for serving).",
      "secondary_message": null
    },
    {
      "id": 573659,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 573660,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh. Add to the bowl along with salt and pepper. Mash with a fork or potato masher until guacamole is smooth.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 573661,
      "primary_message": "Small dice tomato. Add to the bowl with the guacamole and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 573662,
      "primary_message": "Divide tacos between plates; fill with guacamole and a small amount of salad. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
