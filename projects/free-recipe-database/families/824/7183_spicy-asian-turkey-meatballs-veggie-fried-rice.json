  "instructions": [
    {
      "id": 296506,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 296507,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 296508,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 crown broccoli\n2 medium carrots\n1 (227 g) pkg sugar snap peas"
    },
    {
      "id": 296509,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 296510,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 296511,
      "primary_message": "In a large bowl combine the minced garlic, ground turkey, eggs, bread crumbs, soy sauce, chili-garlic sauce, onion powder, and salt. ",
      "secondary_message": "0.68 kg ground turkey\n2 eggs\n⅔ cup panko bread crumbs\n1 tbsp soy sauce\n1 tsp chili-garlic sauce\n½ tsp onion powder\n¼ tsp salt"
    },
    {
      "id": 296512,
      "primary_message": "Coat a glass baking dish with a thin layer of olive oil. Using a tablespoon measure, form the turkey mixture into rounded meatballs and place in the glass dish. Place the dish in the oven and bake for 18 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 296513,
      "primary_message": "Peel and grate the ginger. ",
      "secondary_message": null
    },
    {
      "id": 296514,
      "primary_message": "Place a medium saucepan over medium heat. Add ginger, soy sauce, vinegar, cornstarch, sugar, sesame oil, chili-garlic sauce, and water.  Whisk until well combined. Continue to cook, whisking occasionally, until sauce becomes thick enough to coat a spoon, 3-4 minutes. Once done, remove from heat and set aside. ",
      "secondary_message": "¼ cup soy sauce\n1 tbsp rice vinegar\n2 tsp cornstarch\n1 tbsp brown sugar\n1 tbsp toasted sesame oil\n1 tsp chili-garlic sauce\n2 tbsp water"
    },
    {
      "id": 296515,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 296516,
      "primary_message": "Trim the ends and peel the carrots; discard the trimmings and coarsely grate or julienne.",
      "secondary_message": null
    },
    {
      "id": 296517,
      "primary_message": "Heat sesame oil in a large skillet over medium heat. Add the broccoli, carrots and snap peas. Stir fry until soft, 4-5 minutes. Add the cooked rice to the skillet and toss to combine. ",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 296518,
      "primary_message": "Push ingredients to the sides of the skillet and crack eggs into the middle. Let sit for a few seconds and then scramble. Add the soy sauce and stir to combine everything together. ",
      "secondary_message": "4 eggs\n2 tsp soy sauce"
    },
    {
      "id": 296519,
      "primary_message": "When the meatballs are done baking, remove from the oven and toss with the sauce in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 296520,
      "primary_message": "Divide the rice and veggies between bowls and top with the meatballs with sauce. Sprinkle with sesame seeds. Enjoy! ",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
