  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the sharp cheddar cheese into 1/2-inch cubes. Drain the canned diced tomatoes. Thinly slice the scallions. Pick the cilantro leaves from the stems and finely chop them.",
      "secondary_message": "0.23 kg sharp cheddar cheese\n1 cup canned diced tomatoes\n4 scallions\n2 tbsp cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Place chile directly over flame of a gas burner (no pan), or on a rimmed baking sheet under the broiler. Cook, turning occasionally until completely blackened, about 4 minutes on the burner or 8 minutes under the broiler. Place roasted chile in a bowl and cover with a plate. Let rest for 5 minutes. Peel under cool running water and discard stem and seeds. Chop finely and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Toss cheeses with cornstarch in a large bowl until evenly coated.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil in a medium saucepan over medium-high heat until shimmering. Add ground chuck and cook, stirring occasionally until no longer pink, about 5 minutes. Add cumin and pepper flakes and cook, stirring constantly until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add tomatoes, poblano, and milk and stir to combine. Bring mixture to a boil, reduce heat to low, and add cheese. Cook, stirring constantly with a wooden spoon until cheese is completely melted and sauce is smooth. Stir in Frank's, scallions, and cilantro. Serve immediately with crackers, vegetables, and tortilla chips.",
      "secondary_message": null
    }
  ],
