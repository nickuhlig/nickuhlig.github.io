  "instructions": [
    {
      "id": 429715,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 429716,
      "primary_message": "Wash, dry, and cut off skin from each pineapple; quarter, core, and small dice. Divide pineapple between one medium bowl and one large bowl. (Set the large bowl aside for the salad.)",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 429717,
      "primary_message": "Small dice ham. Add to the medium bowl with the pineapple, stir to combine the pizza toppings, and set aside. ",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 429718,
      "primary_message": "Place tomato sauce and spices in another medium bowl. Stir to combine.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 tbsp Italian seasoning\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 429719,
      "primary_message": "Divide pitas between two baking sheet pans; evenly spread with tomato sauce, then top with cheese, pineapple, and ham. ",
      "secondary_message": "6 whole grain pitas\n2 ¼ cups shredded cheese, Italian blend"
    },
    {
      "id": 429720,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until pizzas are warmed through and cheese is melted, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 429721,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). Add to the large bowl with the pineapple, along with the vinaigrette, and toss to combine the salad. ",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach\n⅓ cup Italian salad dressing"
    },
    {
      "id": 429722,
      "primary_message": "Cut pizzas into wedges.",
      "secondary_message": null
    },
    {
      "id": 429723,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
