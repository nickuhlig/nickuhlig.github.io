  "instructions": [
    {
      "id": 429733,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 429734,
      "primary_message": "Wash, dry, and cut off skin from pineapple; quarter, core, and small dice. Divide pineapple between two medium bowls. (Set one bowl aside for the salad.)",
      "secondary_message": "1 small pineapple"
    },
    {
      "id": 429735,
      "primary_message": "Small dice ham. Add to the remaining bowl with the pineapple, stir to combine the pizza toppings, and set aside. ",
      "secondary_message": "454 g ham steak, boneless"
    },
    {
      "id": 429736,
      "primary_message": "Place tomato sauce and spices in a small bowl. Stir to combine.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n2 tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 429737,
      "primary_message": "Arrange pitas on a large baking sheet pan; evenly spread with tomato sauce, then top with cheese, pineapple, and ham. ",
      "secondary_message": "4 whole grain pitas\n1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 429738,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until pizzas are warmed through and cheese is melted, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 429739,
      "primary_message": "Meanwhile, wash and dry spinach (skip this step if it came pre-washed). Add to the medium bowl with the pineapple, along with the vinaigrette, and toss to combine the salad. ",
      "secondary_message": "1 (142 g) pkg baby spinach\n¼ cup Italian salad dressing"
    },
    {
      "id": 429740,
      "primary_message": "Cut pizzas into wedges.",
      "secondary_message": null
    },
    {
      "id": 429741,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
