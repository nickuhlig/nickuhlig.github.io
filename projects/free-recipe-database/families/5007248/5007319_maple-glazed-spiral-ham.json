  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to lower position and preheat oven to 120°C (250°F). Place ham in an oven bag or wrap tightly with foil and place on a rack set in a rimmed baking sheet. Transfer to oven and cook until ham reaches 49°C (120°F) in the center, about 2 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, combine maple syrup, molasses, mustard, and cinnamon in a small saucepan. Bring to a boil over high heat, reduce to a simmer, and cook, stirring occasionally, until thick and syrupy, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When ham has reached 50°C (120°F), remove from oven and unwrap. Paint with 1/3 of sauce, increase oven temperature to 200°C (400°F), and bake 5 minutes. Paint with 1/3 more glaze and bake until crisp and shiny, 10 minutes longer. Remove from oven and paint with remaining glaze. Tent with foil and allow to rest 15 minutes before slicing and serving.",
      "secondary_message": null
    }
  ],
