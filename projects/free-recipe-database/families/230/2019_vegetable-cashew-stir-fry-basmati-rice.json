  "instructions": [
    {
      "id": 18981,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n⅛ tsp salt\n8 fl oz (1 cup) water"
    },
    {
      "id": 18982,
      "primary_message": "Wash broccoli, bell pepper, and sugar snap peas.",
      "secondary_message": "1 crown broccoli\r\n1 red bell pepper\r\n1 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 40271,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 18983,
      "primary_message": "Separate broccoli into bite-sized florets, cut stem into smaller pieces, and transfer to a large bowl. Seed, medium dice, and add bell pepper to bowl. Halve peas and add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 18984,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 18985,
      "primary_message": "Peel and mince garlic. Peel and mince or grate ginger.",
      "secondary_message": "1 clove garlic\r\n1 (1 inch) piece ginger root"
    },
    {
      "id": 18986,
      "primary_message": "In a small bowl, prepare sauce by whisking together soy sauce and cornstarch.",
      "secondary_message": "2 tbsp soy sauce\r\n1 tsp cornstarch"
    },
    {
      "id": 18987,
      "primary_message": "Coat bottom of skillet with oil. Add garlic, ginger, and crushed red pepper. Cook until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n⅛ tsp crushed red pepper"
    },
    {
      "id": 18988,
      "primary_message": "Add all the vegetables from the bowl to skillet. Stir fry until tender-crisp, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 18989,
      "primary_message": "Add sauce and cashews to skillet. Stir fry until vegetables and cashews are well coated with sauce, 1-2 minutes.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 40270,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 18990,
      "primary_message": "Place rice in a bowl and top with stir fry. Enjoy!",
      "secondary_message": ""
    }
  ],
