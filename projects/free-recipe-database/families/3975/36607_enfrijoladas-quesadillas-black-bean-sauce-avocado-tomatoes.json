  "instructions": [
    {
      "id": 574543,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 jalapeño pepper\n2 tomatoes\n½ avocado"
    },
    {
      "id": 574544,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and place in a small bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 574545,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574546,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the jalapeño.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 574547,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add jalapeño, onion, garlic, and spices; cook, stirring occasionally, until softened, 1-2 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp cumin, ground\n¼ tsp coriander, ground"
    },
    {
      "id": 574548,
      "primary_message": "Add beans with their liquid (do not drain) to the pan along with broth. Stir to combine and bring to a boil over high heat. Once boiling, reduce heat and simmer, stirring occasionally, until beans are tender and sauce is thickened slightly, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 (398 ml) can black beans\n118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 574549,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 574550,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface. Top with cheese and fold in half to close.",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 574551,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574552,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 3-4 minutes. Remove to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 574553,
      "primary_message": "Meanwhile, small dice tomatoes. Place on another plate.",
      "secondary_message": null
    },
    {
      "id": 574554,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the tomato and set aside.",
      "secondary_message": null
    },
    {
      "id": 574555,
      "primary_message": "When the beans are tender, using a potato masher, mash until sauce is smooth and combined.",
      "secondary_message": null
    },
    {
      "id": 574556,
      "primary_message": "To serve, divide quesadillas between plates. Top with black bean sauce, tomato, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
