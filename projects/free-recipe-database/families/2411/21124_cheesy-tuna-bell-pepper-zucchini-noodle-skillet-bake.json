  "instructions": [
    {
      "id": 460205,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 460206,
      "primary_message": "Wash, dry, and trim zucchini; run a peeler along the zucchini to make long, noodle-like strips. Place in a medium bowl.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 460207,
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice and add to the bowl with the zucchini.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "id": 460208,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 460209,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 460210,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and spices to the skillet. Cook, stirring occasionally, until veggies start to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 460211,
      "primary_message": "Meanwhile, drain tuna, place in the reserved bowl, and flake with a fork. Set aside.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 460212,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 460213,
      "primary_message": "When the veggies are done, add tuna, Parmesan, and cream to the skillet. Stir to combine and continue to cook until heated through, 1-2 minutes more.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 460214,
      "primary_message": "Meanwhile, coarsely grate mozzarella and sprinkle over the skillet.",
      "secondary_message": "⅓ (227 g) block mozzarella cheese"
    },
    {
      "id": 460215,
      "primary_message": "Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 460216,
      "primary_message": "To serve, divide skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
