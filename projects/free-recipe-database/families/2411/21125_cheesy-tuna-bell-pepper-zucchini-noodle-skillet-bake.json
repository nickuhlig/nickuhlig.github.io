  "instructions": [
    {
      "id": 460217,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 460218,
      "primary_message": "Wash, dry, and trim zucchini; run a peeler along the zucchini to make long, noodle-like strips. Place in a large bowl.",
      "secondary_message": "4 medium zucchini squash"
    },
    {
      "id": 460219,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice and add to the bowl with the zucchini.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 460220,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 460221,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 460222,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and spices to the skillet. Cook, stirring occasionally, until veggies start to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 460223,
      "primary_message": "Meanwhile, drain tuna, place in the reserved bowl, and flake with a fork. Set aside.",
      "secondary_message": "4 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 460224,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 460225,
      "primary_message": "When the veggies are done, add tuna, Parmesan, and cream to the skillet. Stir to combine and continue to cook until liquid is slightly reduced, 2-3 minutes more.",
      "secondary_message": "177 ml heavy whipping cream"
    },
    {
      "id": 460226,
      "primary_message": "Meanwhile, coarsely grate mozzarella and sprinkle over the skillet.",
      "secondary_message": "⅔ (227 g) block mozzarella cheese"
    },
    {
      "id": 460227,
      "primary_message": "Place skillet in the oven and bake until the mozzarella is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 460228,
      "primary_message": "To serve, divide skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
