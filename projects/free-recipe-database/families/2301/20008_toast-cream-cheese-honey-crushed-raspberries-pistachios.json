  "instructions": [
    {
      "id": 333723,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 333724,
      "primary_message": "Wash and dry raspberries; place in a medium bowl along with honey, cardamom, and cinnamon. Using a fork or potato masher, gently crush the raspberries until they reach a chunky, jam-like consistency. Set aside.",
      "secondary_message": "3 (170 g) pkg raspberries\n2 tbsp honey\n3 pinch cardamom, ground\n3 pinch cinnamon, ground"
    },
    {
      "id": 333725,
      "primary_message": "Divide bread between two baking sheet pans. Working in batches, place each baking sheet in the oven and broil, flipping halfway through, until toasted, 2-3 minutes. Remove from oven.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 333726,
      "primary_message": "Meanwhile, roughly chop pistachios.",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 333727,
      "primary_message": "Spread cream cheese over the toast, then top with crushed raspberries and pistachios.",
      "secondary_message": "1 (227 g) block cream cheese"
    },
    {
      "id": 333728,
      "primary_message": "To serve, divide toasts between plates and enjoy!",
      "secondary_message": null
    }
  ],
