  "instructions": [
    {
      "id": 333701,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 333702,
      "primary_message": "Wash and dry raspberries; place in a medium bowl along with honey, cardamom, and cinnamon. Using a fork or potato masher, gently crush the raspberries until they reach a chunky, jam-like consistency. Set aside.",
      "secondary_message": "2 (6 oz) pkgs raspberries\n4 tsp honey\n⅛ tsp cardamom, ground\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 333703,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, 2-3 minutes. Remove from oven.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 333704,
      "primary_message": "Spread cream cheese over the toast, then top with crushed raspberries.",
      "secondary_message": "⅔ (8 oz) block cream cheese"
    },
    {
      "id": 333705,
      "primary_message": "To serve, divide toasts between plates and enjoy!",
      "secondary_message": null
    }
  ],
