  "instructions": [
    {
      "id": 89095,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "¾ cup quinoa\n354 ml (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 89096,
      "primary_message": "Cut off skin from pineapple, core, and cut into bite-sized pieces. Transfer to a large mixing bowl.",
      "secondary_message": "½ small pineapple"
    },
    {
      "id": 89097,
      "primary_message": "Wash mango, kiwifruit, bell pepper, and jalapeño. Peel the mango, slice flesh away from pit, and medium dice. Peel and medium dice the kiwifruit. Seed and medium dice bell pepper. Seed and mince jalapeño. Peel and small dice onion. Add ingredients to bowl with pineapple.",
      "secondary_message": "1 mango\n1 kiwifruit\n1 red bell pepper\n1 jalapeño pepper\n½ medium red onion"
    },
    {
      "id": 89098,
      "primary_message": "Peel and mince garlic. In a small mixing bowl, prepare dressing by whisking together garlic, lime juice, oil, maple syrup, salt, and pepper.",
      "secondary_message": "1 clove garlic\n1 lime\n2 tbsp extra virgin olive oil\n1 tsp maple syrup\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 89137,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 89099,
      "primary_message": "Uncover quinoa, fluff with a fork, and add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 89100,
      "primary_message": "Pour dressing over top salad and toss.",
      "secondary_message": ""
    },
    {
      "id": 89101,
      "primary_message": "To serve, divide salad between bowls and top with green onions. Enjoy!",
      "secondary_message": ""
    }
  ],
