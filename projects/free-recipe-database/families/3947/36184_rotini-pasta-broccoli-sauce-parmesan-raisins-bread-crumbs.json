  "instructions": [
    {
      "id": 630803,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. ",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 630804,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 630805,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ cup panko bread crumbs\n1 pinch salt"
    },
    {
      "id": 630806,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 630807,
      "primary_message": "Once the water is boiling, add broccoli to the pan and cook, stirring occasionally, until very tender, 6-7 minutes. Use a slotted spoon to transfer broccoli to a medium bowl and set aside. (Reserve boiling water in pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 630808,
      "primary_message": "Meanwhile, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 630809,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat; add more oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and starting to brown, 6-8 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 630810,
      "primary_message": "While the onion is cooking, peel and mince garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 630811,
      "primary_message": "When the onion is starting to brown, add cooked broccoli, garlic, water, anchovy fillet, crushed red pepper, and salt to the skillet. Cook, stirring occasionally, until broccoli is soft enough to break apart with a spoon, about 10 minutes.",
      "secondary_message": "¾ cup water\n1 anchovy fillet, packed in oil\n½ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 630812,
      "primary_message": "Meanwhile, return pan with hot water to high heat and bring back to a boil. Once boiling, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ¼-cup pasta water before draining.)",
      "secondary_message": "5 oz rotini pasta"
    },
    {
      "id": 630813,
      "primary_message": "While the pasta is cooking, finely grate Parmesan. Set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 630814,
      "primary_message": "When the broccoli is very soft, remove 1-cup, then using a potato masher, mash remaining broccoli until a semi-smooth sauce forms.",
      "secondary_message": null
    },
    {
      "id": 630815,
      "primary_message": "Wash, dry, and juice lemon into the skillet. Add drained pasta, reserved pasta water, Parmesan, reserved broccoli, and raisins; continue to cook, stirring frequently, until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "1 lemon\n¼ cup raisins"
    },
    {
      "id": 630816,
      "primary_message": "To serve, divide pasta between plates or bowls. Drizzle with oil, top with crispy bread crumbs, and enjoy!",
      "secondary_message": "1 tsp extra virgin olive oil"
    }
  ],
