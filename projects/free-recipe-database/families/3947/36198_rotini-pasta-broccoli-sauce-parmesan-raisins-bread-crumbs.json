  "instructions": [
    {
      "id": 630999,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. ",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 631000,
      "primary_message": "Meanwhile, preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 631001,
      "primary_message": "Once the second pot is hot, add oil and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ cup panko bread crumbs\n3 pinch salt"
    },
    {
      "id": 631002,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": "6 crowns broccoli"
    },
    {
      "id": 631003,
      "primary_message": "Once the water is boiling, add broccoli to the pot and cook, stirring occasionally, until very tender, 6-7 minutes. Use a slotted spoon to transfer broccoli to a large bowl and set aside. (Reserve boiling water in pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 631004,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. ",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 631005,
      "primary_message": "Wipe the reserved pot clean with paper towels, then return to medium-high heat; add more oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and starting to brown, 8-10 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 631006,
      "primary_message": "While the onion is cooking, peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 631007,
      "primary_message": "When the onion is starting to brown, add cooked broccoli, garlic, water, anchovy fillets, crushed red pepper, and salt to the pot. Cook, stirring occasionally, until broccoli is soft enough to break apart with a spoon, 10-15 minutes.",
      "secondary_message": "1 ½ cup water\n3 anchovy fillets, packed in oil\n1 ½ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 631008,
      "primary_message": "Meanwhile, return pot with hot water to high heat and bring back to a boil. Once boiling, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ½-cup pasta water before draining.)",
      "secondary_message": "425 g rotini pasta"
    },
    {
      "id": 631009,
      "primary_message": "While the pasta is cooking, finely grate Parmesan. Set aside.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 631010,
      "primary_message": "When the broccoli is very soft, remove 3-cups, then using a potato masher, mash remaining broccoli until a semi-smooth sauce forms.",
      "secondary_message": null
    },
    {
      "id": 631011,
      "primary_message": "Wash, dry, and juice lemons into the pot with the sauce. Add drained pasta, reserved pasta water, Parmesan, reserved broccoli, and raisins; continue to cook, stirring frequently, until heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "3 lemons\n¾ cup raisins"
    },
    {
      "id": 631012,
      "primary_message": "To serve, divide pasta between plates or bowls. Drizzle with oil, top with crispy bread crumbs, and enjoy!",
      "secondary_message": "1 tbsp extra virgin olive oil"
    }
  ],
