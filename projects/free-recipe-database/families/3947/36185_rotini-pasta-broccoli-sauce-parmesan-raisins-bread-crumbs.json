  "instructions": [
    {
      "id": 630817,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. ",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 630818,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 630819,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n½ cup panko bread crumbs\n⅛ tsp salt"
    },
    {
      "id": 630820,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": "4 crowns broccoli"
    },
    {
      "id": 630821,
      "primary_message": "Once the water is boiling, add broccoli to the pot and cook, stirring occasionally, until very tender, 6-7 minutes. Use a slotted spoon to transfer broccoli to a medium bowl and set aside. (Reserve boiling water in pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 630822,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. ",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 630823,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat; add more oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until soft and starting to brown, 6-8 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 630824,
      "primary_message": "While the onion is cooking, peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 630825,
      "primary_message": "When the onion is starting to brown, add cooked broccoli, garlic, water, anchovy fillets, crushed red pepper, and salt to the skillet. Cook, stirring occasionally, until broccoli is soft enough to break apart with a spoon, about 10 minutes.",
      "secondary_message": "1 cup water\n2 anchovy fillets, packed in oil\n1 tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 630826,
      "primary_message": "Meanwhile, return pot with hot water to high heat and bring back to a boil. Once boiling, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ½-cup pasta water before draining.)",
      "secondary_message": "10 oz rotini pasta"
    },
    {
      "id": 630827,
      "primary_message": "While the pasta is cooking, finely grate Parmesan. Set aside.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 630828,
      "primary_message": "When the broccoli is very soft, remove 2-cups, then using a potato masher, mash remaining broccoli until a semi-smooth sauce forms.",
      "secondary_message": null
    },
    {
      "id": 630829,
      "primary_message": "Wash, dry, and juice lemons into the skillet. Add drained pasta, reserved pasta water, Parmesan, remaining broccoli, and raisins; continue to cook, stirring frequently, until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "2 lemons\n½ cup raisins"
    },
    {
      "id": 630830,
      "primary_message": "To serve, divide pasta between plates or bowls. Drizzle with oil, top with crispy bread crumbs, and enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
