  "instructions": [
    {
      "id": 1,
      "primary_message": "Set air fryer to 190°C (375°F) and preheat for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pat salmon dry with paper towels, rub all over with oil, and sprinkle with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Lightly spray the preheated air fryer basket with vegetable oil spray. Place salmon in prepared basket, skin side up. Place basket in air fryer and cook until the skin is crispy and golden at edges, and the center is still translucent when checked with tip of paring knife and the thickest portion of the fillet registers 43°C for rare, 49°C for medium-rare, or 54°C for medium, 7 to 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Carefully transfer salmon fillets to a paper towel–lined plate and let rest for 5 minutes. Serve.",
      "secondary_message": null
    }
  ],
