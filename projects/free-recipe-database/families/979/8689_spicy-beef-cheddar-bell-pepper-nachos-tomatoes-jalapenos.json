  "instructions": [
    {
      "id": 300177,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n1 jalapeño pepper\n½ small bunch cilantro\n½ tomato\n½ lime"
    },
    {
      "id": 300178,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300179,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 300180,
      "primary_message": "Once the skillet is hot, add ground beef and spices. Cook, breaking the meat apart with a spoon, until the beef is browned and no longer pink, 3-4 minutes. Stir in the garlic, then remove skillet from the heat. ",
      "secondary_message": "¾ lb lean ground beef\n2 tsp cumin, ground\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 300181,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Slice each quarter crosswise into 3 or 4 pieces to make the \"chips.\"",
      "secondary_message": null
    },
    {
      "id": 300182,
      "primary_message": "Line a baking sheet with aluminum foil. Place bell pepper pieces, skin-side down, in a single layer on the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 300183,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 300184,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 300185,
      "primary_message": "Thinly slice the jalapeño into rounds. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 300186,
      "primary_message": "Top the bell pepper slices with an even layer of ground beef, cheese, and jalapeños. ",
      "secondary_message": null
    },
    {
      "id": 300187,
      "primary_message": "Place the baking sheet in the oven; cook until cheese is melted and bubbly, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 300188,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 300189,
      "primary_message": "Small dice the tomato. Cut the lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 300190,
      "primary_message": "To serve, divide the nachos between plates. Garnish with cilantro, tomatoes, and lime wedges. Enjoy!",
      "secondary_message": null
    }
  ],
