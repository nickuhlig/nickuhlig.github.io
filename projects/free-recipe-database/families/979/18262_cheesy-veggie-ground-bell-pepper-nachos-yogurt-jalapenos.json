  "instructions": [
    {
      "id": 300247,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 yellow bell peppers\n3 jalapeño peppers\n1 small bunch cilantro\n1 ½ avocados\n3 tomatoes\n1 ½ limes"
    },
    {
      "id": 300248,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 300249,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 300250,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Stir in the garlic, then remove skillet from the heat. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ tbsp cumin, ground\n1 ½ tbsp chili powder\n¾ tsp salt"
    },
    {
      "id": 300251,
      "primary_message": "Cut the bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Slice each quarter crosswise into 3 or 4 pieces to make the \"chips.\"",
      "secondary_message": null
    },
    {
      "id": 300252,
      "primary_message": "Line two baking sheet pans with aluminum foil. Divide bell pepper pieces between the baking sheets, skin-side down, in a single layer. ",
      "secondary_message": null
    },
    {
      "id": 300253,
      "primary_message": "Preheat oven to broil on high; position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 300254,
      "primary_message": "Grate the cheese. ",
      "secondary_message": "1 ½ (8 oz) blocks cheddar cheese"
    },
    {
      "id": 300255,
      "primary_message": "Thinly slice the jalapeños into rounds. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 300256,
      "primary_message": "Top the bell pepper slices with an even layer of veggie ground, cheese, and jalapeños. ",
      "secondary_message": null
    },
    {
      "id": 300257,
      "primary_message": "Working in batches, place each baking sheet in the oven; cook until cheese is melted and bubbly, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 300258,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 300259,
      "primary_message": "Halve and pit avocados; slice thinly while still in skin, then scoop out with a spoon. Small dice the tomatoes. Cut the limes into wedges. ",
      "secondary_message": null
    },
    {
      "id": 300260,
      "primary_message": "To serve, divide the \"nachos\" between plates. Top with yogurt, tomatoes, avocado, cilantro, and lime wedges. Enjoy!",
      "secondary_message": "1 ½ cups plain Greek yogurt"
    }
  ],
