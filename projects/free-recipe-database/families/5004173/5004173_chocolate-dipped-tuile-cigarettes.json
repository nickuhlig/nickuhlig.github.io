  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the unsalted butter. Melt the bittersweet chocolate.",
      "secondary_message": "6 tbsp (3 oz) unsalted butter\n3 oz bittersweet chocolate"
    },
    {
      "id": 1,
      "primary_message": "In medium bowl, whisk sugar, flour, and salt to combine. Stir in butter, vanilla, and whites until smooth. Chill until thickened, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 375°F. Line baking sheet with a silpat-style non-stick baking sheet liner (see note). Spread 2 or 3 scant tablespoon sized portions of batter into a 4- by 6-inch oval. The batter should be spread evenly and should be practically transparent.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake until the edges are golden brown and the center is a faint golden color (not pale). Remove pan from the oven. Use an offset spatula to immediately remove one tuile from the pan and place on a work surface bottom side down.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Immediately roll up tuile into as tight a cylinder as possible, from the short end, with your fingers and palm, taking care not to burn yourself. Hold for a second to set, then set aside to cool. Repeat with the remaining tuiles. If the tuiles cool and become too brittle to roll, return briefly to oven to soften. Repeat with remaining batter.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Dip an end of each tuile in chocolate, dip in sprinkles, and set on a parchment paper lined tray. Refrigerate to set chocolate.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Repeat steps 2-5 with remaining batter. Serve at room temperature.",
      "secondary_message": null
    }
  ],
