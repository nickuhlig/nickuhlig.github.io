  "instructions": [
    {
      "id": 423390,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 423391,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 caps portobello mushrooms\n1 small pkg grape tomatoes\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 423392,
      "primary_message": "Remove mushroom stems, cut caps into ¼-inch thick slices, and transfer to a large baking sheet pan. Drizzle with vinaigrette, season with salt and pepper, then toss to coat; spread out in an even layer.",
      "secondary_message": "2 tbsp balsamic vinaigrette\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 423393,
      "primary_message": "Place mushrooms in the oven (it doesn't have to be fully heated) and bake until golden brown and tender, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423394,
      "primary_message": "Meanwhile, arrange flatbreads on another large baking sheet. Add to the oven and bake, flipping halfway through, until slightly crispy, 6-8 minutes. Remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 423395,
      "primary_message": "When the mushrooms are done, assemble the flatbreads. Spread a thin layer of pesto over each flatbread, then top with cheese, mushrooms, and Italian seasoning.",
      "secondary_message": "⅔ cup sun-dried tomato pesto\n1 cup shredded cheese, Italian blend\n½ tsp Italian seasoning"
    },
    {
      "id": 423396,
      "primary_message": "Return flatbreads to the oven and bake until warmed through and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423397,
      "primary_message": "Meanwhile, halve tomatoes. Place in a large bowl along with spinach and vinaigrette; toss to combine the salad.",
      "secondary_message": "2 tbsp balsamic vinaigrette"
    },
    {
      "id": 423398,
      "primary_message": "Slice flatbreads and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
