  "instructions": [
    {
      "id": 1,
      "primary_message": "Fill a medium saucepan with 2.5-cm of water and bring to a simmer over medium heat. Reduce heat to low.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place egg yolks in a medium bowl and whisk until they lighten in color, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place bowl with eggs over saucepan with simmering water and whisk constantly until thickened and doubled volume, about 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove bowl from from saucepan with water and whisk in butter 1 tablespoon at a time. Whisk in lemon juice, salt, and cayenne. Use immediately or keep warm, covered, over double broiler over very low heat for up to 30 minutes.",
      "secondary_message": null
    }
  ],
