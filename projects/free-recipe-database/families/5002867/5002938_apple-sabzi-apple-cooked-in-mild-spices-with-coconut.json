  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in a medium saucepan over medium-high heat until shimmering. Add the black mustard seeds and the split black gram. Stir until they pop, about 1 minute. Add the curry leaves and step aside as they splutter. Stir until fragrant, about 10 seconds. Add the onions and cook, stirring frequently, until softened but not browned about 4 minutes. Add the coconut, green chills, chill powder, turmeric and coriander. Stir to coat the coconut with the spices and oil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the apples, salt and water. Stir to combine. Cover with lid and allow to cook until the apple is tender, about 15 minutes. Serve as a side to an indian vegetarian meal.",
      "secondary_message": null
    }
  ],
