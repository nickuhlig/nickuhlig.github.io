  "instructions": [
    {
      "id": 45594,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 Gala apple\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 45596,
      "primary_message": "Quarter the apple lengthwise, then cut out the core and stem from each section; cut each quarter lengthwise into thin wedges. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 45595,
      "primary_message": "Coarsely grate 1 cup of cheddar and transfer to a bowl.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 45597,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 45599,
      "primary_message": "Place the 4 bread slices on a flat surface and divide the mustard among them. Evenly top 2 of the slices with ½ of the apple (save the rest for the salad) and the grated cheddar; season with salt and pepper. Cover the sandwiches with the remaining bread slices, mustard-side-down.",
      "secondary_message": "4 slices whole grain bread\n1 tbsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 45598,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "½ tbsp butter, unsalted"
    },
    {
      "id": 45600,
      "primary_message": "Place the sandwiches in the skillet and cook until the bottom is golden brown, 2 to 4 minutes. Then, remove the sandwiches to a plate and add more butter to the skillet; return the sandwiches to the skillet, browned-side-up, and cook until golden brown on the other side and the cheese is melted, 2 to 4 minutes. Once done, transfer to a cutting board.",
      "secondary_message": "½ tbsp butter, unsalted"
    },
    {
      "id": 45606,
      "primary_message": "While the sandwiches toast, roughly chop the pecans.",
      "secondary_message": "⅛ cup pecans, dry roasted"
    },
    {
      "id": 45601,
      "primary_message": "Transfer the arugula, remaining apple slices, and pecans to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45602,
      "primary_message": "In a small bowl, combine and whisk together extra virgin olive oil, apple cider vinegar, honey, salt, and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tbsp apple cider vinegar\n½ tsp honey\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 45605,
      "primary_message": "Pour the dressing over the salad and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 45603,
      "primary_message": "Cut the sandwiches in half on the diagonal.",
      "secondary_message": ""
    },
    {
      "id": 45604,
      "primary_message": "To serve, divide the salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
