  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 lemon\n1 small bunch Italian (flat-leaf) parsley\n907 g Brussels sprouts"
    },
    {
      "primary_message": "Peel and mince garlic; place in a large bowl. ",
      "secondary_message": "2 clove garlic"
    },
    {
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and thinly slice Brussels sprouts. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Finely grate Parmesan; add to the bowl along with cranberries and pumpkin seeds. Stir to combine the salad. ",
      "secondary_message": "57 g Parmesan cheese\n½ cup dried cranberries\n⅓ cup pumpkin seeds"
    }
  ],
