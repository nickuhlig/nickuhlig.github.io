  "instructions": [
    {
      "id": 68668,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium head napa cabbage\n6 medium carrots\n3 limes\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 68680,
      "primary_message": "Juice the limes into a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 68679,
      "primary_message": "Peel and mince the ginger; transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 68678,
      "primary_message": "Add half of the lime juice (save the rest for the salad), soy sauce, and olive oil to the ginger; whisk together.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 68667,
      "primary_message": "Place the salmon, skin-side-up, in the sauce. Set the bowl aside.",
      "secondary_message": "2 ¼ lb salmon fillets"
    },
    {
      "id": 68677,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 68676,
      "primary_message": "Once the skillet is warm, measure out the sesame seeds and add to the skillet. Cook, stirring frequently, until they are golden brown, 2 to 3 minutes. Once done, transfer to a small bowl.",
      "secondary_message": "3 tbsp sesame seeds"
    },
    {
      "id": 68675,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 68674,
      "primary_message": "Place the salmon, skin-side down, in the skillet; cook for 3 to 4 minutes on one side, then flip and pour in the remaining sauce. Continue to cook until the flesh is opaque, another 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68673,
      "primary_message": "Combine the remaining lime juice, olive oil, sesame oil, soy sauce, and honey in a large bowl; whisk together.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp toasted sesame oil\n3 tbsp soy sauce\n3 tsp honey"
    },
    {
      "id": 68672,
      "primary_message": "Quarter the cabbage lengthwise, then cut out and discard the core; thinly slice crosswise and add to the large bowl.",
      "secondary_message": ""
    },
    {
      "id": 68671,
      "primary_message": "Trim the ends and peel the carrots; discard the trimmings and coarsely grate the carrots. Add to the cabbage.",
      "secondary_message": ""
    },
    {
      "id": 68670,
      "primary_message": "Toss the salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 68669,
      "primary_message": "To serve, arrange the salad on a plate and place the salmon on top. Enjoy!",
      "secondary_message": ""
    }
  ],
