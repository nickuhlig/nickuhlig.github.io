  "instructions": [
    {
      "id": 328757,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 328758,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n2 medium carrots\n½ lemon"
    },
    {
      "id": 328759,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 328760,
      "primary_message": "Peel, trim, and thinly slice carrots; add to the baking sheet with the broccoli. Drizzle veggies with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 328761,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, 12-15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 328762,
      "primary_message": "Meanwhile, drain tuna, place in a medium bowl, and flake with a fork.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 328763,
      "primary_message": "Zest lemon into the bowl with the tuna. Add egg, almond flour, sesame seeds, mayo, and spices; stir well to combine. (Reserve lemon for later use.)",
      "secondary_message": "1 egg\n2 tbsp almond meal/flour\n1 ½ tbsp sesame seeds\n1 tbsp mayonnaise\n1 tsp garam masala\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 328764,
      "primary_message": "Using a ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 328765,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 328766,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 328767,
      "primary_message": "Meanwhile, juice the reserved lemon into a small bowl; add mayo and spices. Stir to combine the aioli.",
      "secondary_message": "⅓ cup mayonnaise\n½ tsp coriander, ground\n¼ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 328768,
      "primary_message": "To serve, divide veggies, tuna fritters, and aioli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
