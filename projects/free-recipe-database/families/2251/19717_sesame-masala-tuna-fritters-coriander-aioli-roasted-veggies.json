  "instructions": [
    {
      "id": 328781,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 328782,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n6 medium carrots\n1 ½ lemons"
    },
    {
      "id": 328783,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 328784,
      "primary_message": "Peel, trim, and thinly slice carrots; add to the baking sheets with the broccoli. Drizzle veggies with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 328785,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are fork-tender, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 328786,
      "primary_message": "Meanwhile, drain tuna, place in a large bowl, and flake with a fork.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 328787,
      "primary_message": "Zest lemons into the bowl with the tuna. Add eggs, almond flour, sesame seeds, mayo, and spices; stir well to combine. (Reserve lemons for later use.)",
      "secondary_message": "3 eggs\n⅓ cup almond meal/flour\n¼ cup sesame seeds\n3 tbsp mayonnaise\n1 tbsp garam masala\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 328788,
      "primary_message": "Using a ¼-cup measure, form the tuna mixture into ½-inch thick fritters and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 328789,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 328790,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 328791,
      "primary_message": "Meanwhile, juice the reserved lemons into a small bowl; add mayo and spices. Stir to combine the aioli.",
      "secondary_message": "1 cup mayonnaise\n1 ½ tsp coriander, ground\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 328792,
      "primary_message": "To serve, divide veggies, tuna fritters, and aioli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
