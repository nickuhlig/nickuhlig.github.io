  "instructions": [
    {
      "id": 370482,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 370483,
      "primary_message": "Place hoisin sauce, water, soy sauce, and oil in a baking dish; stir to combine the sauce.",
      "secondary_message": "¼ cup hoisin sauce\n1 tbsp water\n2 tsp soy sauce\n2 tsp toasted sesame oil"
    },
    {
      "id": 370484,
      "primary_message": "Pat chicken dry with paper towels, add to the dish with the sauce, and turn to coat. ",
      "secondary_message": "1 ¼ lb chicken drumsticks"
    },
    {
      "id": 370485,
      "primary_message": "Place dish in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370486,
      "primary_message": "When the chicken is almost done, place dressing, additional oil, and sesame seeds in a medium bowl. Stir to combine the dressing.",
      "secondary_message": "3 tbsp Italian salad dressing\n1 tsp toasted sesame oil\n1 tsp sesame seeds"
    },
    {
      "id": 370487,
      "primary_message": "Wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing, along with carrots, and toss to combine the salad.",
      "secondary_message": "1 heart romaine hearts\n½ (10 oz) bag shredded carrots"
    },
    {
      "id": 370488,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
