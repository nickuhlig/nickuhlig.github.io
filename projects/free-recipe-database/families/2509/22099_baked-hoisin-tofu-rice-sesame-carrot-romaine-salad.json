  "instructions": [
    {
      "id": 370554,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 370555,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 370556,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 370557,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 370558,
      "primary_message": "Meanwhile, place hoisin sauce, soy sauce, and oil in a baking dish. Stir to combine the sauce.",
      "secondary_message": "⅓ cup hoisin sauce\n1 tbsp soy sauce\n2 tsp toasted sesame oil"
    },
    {
      "id": 370559,
      "primary_message": "Medium dice tofu and add to the dish with the sauce; stir to coat.",
      "secondary_message": null
    },
    {
      "id": 370560,
      "primary_message": "Place dish in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tofu is golden and warmed through, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 370561,
      "primary_message": "When the tofu is almost done, place dressing, additional oil, and sesame seeds in a medium bowl. Stir to combine the dressing.",
      "secondary_message": "3 tbsp Italian salad dressing\n1 tsp toasted sesame oil\n1 tsp sesame seeds"
    },
    {
      "id": 370562,
      "primary_message": "Wash, dry, and halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing, along with carrots, and toss to combine the salad.",
      "secondary_message": "1 heart romaine hearts\n½ (283 g) bag shredded carrots"
    },
    {
      "id": 370563,
      "primary_message": "To serve, divide rice, tofu, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
