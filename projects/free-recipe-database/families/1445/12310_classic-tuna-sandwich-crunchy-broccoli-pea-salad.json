  "instructions": [
    {
      "id": 206719,
      "primary_message": "Place peas in colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "¾ cup frozen peas"
    },
    {
      "id": 206720,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, sugar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 ½ tsp apple cider vinegar\n1 ½ tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper\n3 pinch garlic powder"
    },
    {
      "id": 206721,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets. Thinly slice stems and florets, then transfer broccoli and peas to the bowl with the dressing.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 206722,
      "primary_message": "Wash, dry, trim, and small dice celery. Peel and mince shallot.",
      "secondary_message": "1 stick celery\n½ shallot"
    },
    {
      "id": 206723,
      "primary_message": "Add half the celery and shallot to the bowl and stir to combine the broccoli salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 206724,
      "primary_message": "Transfer remaining celery and shallot to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 206725,
      "primary_message": "Drain tuna, add to the small bowl, and flake with a fork.",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 206726,
      "primary_message": "Drain and mince capers. Add to the bowl along with yogurt, mayo, and spices; stir to combine the tuna salad.",
      "secondary_message": "½ tbsp capers\n⅛ cup plain Greek yogurt\n2 tbsp mayonnaise\n¼ tsp dill\n⅛ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 206727,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 206728,
      "primary_message": "Place bread slices on a flat surface. Divide tuna salad between half of the slices; cover with remaining slices and cut sandwiches in half.",
      "secondary_message": null
    },
    {
      "id": 206729,
      "primary_message": "To serve, divide broccoli salad and sandwiches between plates and enjoy!",
      "secondary_message": null
    }
  ],
