  "instructions": [
    {
      "id": 206741,
      "primary_message": "Place peas in colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "2 ¼ cups frozen peas"
    },
    {
      "id": 206742,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, sugar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "⅔ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 ½ tbsp apple cider vinegar\n1 ½ tbsp brown sugar\n¾ tsp salt\n¾ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 206743,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets. Thinly slice stems and florets, then transfer broccoli and peas to the bowl with the dressing.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 206744,
      "primary_message": "Wash, dry, trim, and small dice celery. Peel and mince shallots.",
      "secondary_message": "3 sticks celery\n2 shallots"
    },
    {
      "id": 206745,
      "primary_message": "Add half the celery and shallots to the bowl and stir to combine the broccoli salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 206746,
      "primary_message": "Transfer remaining celery and shallots to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 206747,
      "primary_message": "Drain tuna, add to the medium bowl, and flake with a fork.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 206748,
      "primary_message": "Drain and mince capers. Add to the bowl along with yogurt, mayo, and spices; stir to combine the tuna salad.",
      "secondary_message": "1 ½ tbsp capers\n⅓ cup plain Greek yogurt\n⅓ cup mayonnaise\n¾ tsp dill\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 206749,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 206750,
      "primary_message": "Place bread slices on a flat surface. Divide tuna salad between half of the slices; cover with remaining slices and cut sandwiches in half.",
      "secondary_message": null
    },
    {
      "id": 206751,
      "primary_message": "To serve, divide broccoli salad and sandwiches between plates and enjoy!",
      "secondary_message": null
    }
  ],
