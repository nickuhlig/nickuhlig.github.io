  "instructions": [
    {
      "id": 206664,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 sticks celery\n4 yellow bell peppers"
    },
    {
      "id": 206665,
      "primary_message": "Place peas in colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 206666,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, sugar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n¼ cup avocado oil mayonnaise\n1 tbsp apple cider vinegar\n1 tbsp brown sugar\n½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 206667,
      "primary_message": "Separate broccoli into bite-sized florets. Thinly slice stems and florets, then transfer broccoli and peas to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 206668,
      "primary_message": "Peel and mince shallots. Add half the shallots to the bowl and stir to combine the broccoli salad. Set aside.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 206669,
      "primary_message": "Transfer remaining shallots to another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 206670,
      "primary_message": "Drain tuna, add to the bowl with the shallot, and flake with a fork.",
      "secondary_message": "4 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 206671,
      "primary_message": "Drain and mince capers. Add to the bowl along with yogurt, mayo, and spices. ",
      "secondary_message": "2 tbsp capers\n½ cup plain Greek yogurt\n½ cup avocado oil mayonnaise\n1 tsp dill\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 206672,
      "primary_message": "Trim and small dice celery. Add to the bowl and stir to combine the tuna salad.",
      "secondary_message": null
    },
    {
      "id": 206673,
      "primary_message": "Cut bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Place peppers, skin-side down, on a flat surface and fill with tuna salad.",
      "secondary_message": null
    },
    {
      "id": 206674,
      "primary_message": "To serve, divide broccoli salad and stuffed peppers between plates and enjoy!",
      "secondary_message": null
    }
  ],
