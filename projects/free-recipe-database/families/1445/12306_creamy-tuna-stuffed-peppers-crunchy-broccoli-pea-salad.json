  "instructions": [
    {
      "id": 206675,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 sticks celery\n6 yellow bell peppers"
    },
    {
      "id": 206676,
      "primary_message": "Place peas in colander and run under cold water to thaw; set aside to drain.",
      "secondary_message": "2 ¼ cups frozen peas"
    },
    {
      "id": 206677,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, sugar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup avocado oil mayonnaise\n1 ½ tbsp apple cider vinegar\n1 ½ tbsp brown sugar\n¾ tsp salt\n¾ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 206678,
      "primary_message": "Separate broccoli into bite-sized florets. Thinly slice stems and florets, then transfer broccoli and peas to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 206679,
      "primary_message": "Peel and mince onion. Add half the onion to the bowl and stir to combine the broccoli salad. Set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 206680,
      "primary_message": "Transfer remaining onion to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 206681,
      "primary_message": "Drain tuna, add to the bowl with the onion, and flake with a fork.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 206682,
      "primary_message": "Drain and mince capers. Add to the bowl along with yogurt, mayo, and spices. ",
      "secondary_message": "3 tbsp capers\n¾ cup plain Greek yogurt\n¾ cup avocado oil mayonnaise\n1 ½ tsp dill\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 206683,
      "primary_message": "Trim and small dice celery. Add to the bowl and stir to combine the tuna salad.",
      "secondary_message": null
    },
    {
      "id": 206684,
      "primary_message": "Cut bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Place peppers, skin-side down, on a flat surface and fill with tuna salad.",
      "secondary_message": null
    },
    {
      "id": 206685,
      "primary_message": "To serve, divide broccoli salad and stuffed peppers between plates and enjoy!",
      "secondary_message": null
    }
  ],
