  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring water to boil in a large pot and salt liberally. Add beans and boil until just tender (about 5 minutes). Drain beans and thoroughly rinse well under cold water.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Melt butter over medium-low heat heat in a large, straight-sided skillet, stir in shallots and salt liberally. Cook until shallots are very soft and aromatic, about 5 minutes, then add beans. Stir to coat beans with butter and cook for 1 minute, then add parmesan, and stir until parmesan melts.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from heat and stir in dill. Add salt to taste and lemon juice if desired. Serve immediately.",
      "secondary_message": null
    }
  ],
