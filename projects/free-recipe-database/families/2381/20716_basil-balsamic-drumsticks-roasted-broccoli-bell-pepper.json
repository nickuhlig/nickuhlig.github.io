  "instructions": [
    {
      "id": 347406,
      "primary_message": "Preheat oven to 260°C (500°F).",
      "secondary_message": null
    },
    {
      "id": 347407,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 crown broccoli\n1 yellow bell pepper"
    },
    {
      "id": 347408,
      "primary_message": "Peel and mince garlic; place in a baking dish.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 347409,
      "primary_message": "Juice lemon into the baking dish with the garlic. Add vinegar, oil, and spices; whisk to combine the marinade.",
      "secondary_message": "2 tbsp balsamic vinegar\n2 tsp extra virgin olive oil\n1 tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347410,
      "primary_message": "Pat chicken dry with paper towels. Add to the baking dish with the marinade and turn to coat.",
      "secondary_message": "0.57 kg chicken drumsticks"
    },
    {
      "id": 347411,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and roast, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 347412,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 347413,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into ½-inch thick strips; add to the baking sheet with the broccoli. Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 347414,
      "primary_message": "Add veggies to the oven and roast, tossing halfway through, until lightly charred and fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 347415,
      "primary_message": "To serve, divide drumsticks and veggies between plates; drizzle with sauce from the baking dish and enjoy!",
      "secondary_message": null
    }
  ],
