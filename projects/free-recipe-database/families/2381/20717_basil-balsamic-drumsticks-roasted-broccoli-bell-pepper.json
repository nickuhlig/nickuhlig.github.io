  "instructions": [
    {
      "id": 347416,
      "primary_message": "Preheat oven to 260°C (500°F).",
      "secondary_message": null
    },
    {
      "id": 347417,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 crowns broccoli\n2 yellow bell peppers"
    },
    {
      "id": 347418,
      "primary_message": "Peel and mince garlic; place in a large baking dish.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 347419,
      "primary_message": "Juice lemon into the baking dish with the garlic. Add vinegar, oil, and spices; whisk to combine the marinade.",
      "secondary_message": "¼ cup balsamic vinegar\n4 tsp extra virgin olive oil\n2 tsp basil, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347420,
      "primary_message": "Pat chicken dry with paper towels. Add to the baking dish with the marinade and turn to coat.",
      "secondary_message": "1 ⅛ kg chicken drumsticks"
    },
    {
      "id": 347421,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and roast, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 347422,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 347423,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into ½-inch thick strips; add to the baking sheet with the broccoli. Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347424,
      "primary_message": "Add veggies to the oven and roast, tossing halfway through, until lightly charred and fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 347425,
      "primary_message": "To serve, divide drumsticks and veggies between plates; drizzle with sauce from the baking dish and enjoy!",
      "secondary_message": null
    }
  ],
