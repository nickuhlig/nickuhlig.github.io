  "instructions": [
    {
      "id": 347332,
      "primary_message": "Preheat oven to 500°F. Arrange racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 347333,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 crowns broccoli\n3 yellow bell peppers\n1 ½ lb sweet potatoes"
    },
    {
      "id": 347334,
      "primary_message": "Peel and mince garlic; place in a large baking dish.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 347335,
      "primary_message": "Juice lemons into the baking dish with the garlic; add vinegar, oil, and spices. Whisk to combine the marinade.",
      "secondary_message": "⅓ cup balsamic vinegar\n2 tbsp extra virgin olive oil\n1 tbsp basil, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 347336,
      "primary_message": "Pat chicken dry with paper towels. Add to the baking dish with the marinade and turn to coat.",
      "secondary_message": "3 ¾ lb chicken drumsticks"
    },
    {
      "id": 347337,
      "primary_message": "Place chicken on the upper rack of the oven (it doesn't have to be fully heated) and roast, turning once, until cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 347338,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces; divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 347339,
      "primary_message": "Peel, trim, and small dice sweet potatoes; add to the baking sheets with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 347340,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into ½-inch thick strips; add to the baking sheets. Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 347341,
      "primary_message": "Place veggies on the lower racks of the oven and roast, tossing halfway through, until lightly charred and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 347342,
      "primary_message": "To serve, divide drumsticks and veggies between plates; drizzle with sauce from the baking dish and enjoy!",
      "secondary_message": null
    }
  ],
