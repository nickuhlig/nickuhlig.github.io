  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Apple Pie Spice Mix: In a small bowl, whisk to combine cinnamon, nutmeg, ginger, allspice, and cardamom; set aside (see notes).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Spiced Apples: Heat a 25-cm skillet over medium heat. Add apple pieces, brown sugar, 2 teaspoons prepared apple spice mix, and salt and cook, stirring frequently until apples are tender, about 10 minutes; set aside and let cool slightly, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Oats: In a blender, add milk, maple syrup, vanilla, 1/2 teaspoon apple pie spice mix, salt, and 1/2 cup of the cooked apple mixture and blend until apples are completely broken down. (Alternatively, you can transfer ingredients to a large bowl and blend using an immersion blender, or even mash for a more rustic texture.)",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a large bowl, stir blended milk mixture with oats and chia seeds until well combined. Let sit until thickened slightly, 10 minutes. After 10 minutes, stir the oat mixture to recombine and fill six 227 g mason jars or other serving containers halfway with oat mixture. Add 2 tablespoons of cooked spiced apples on top of oats, then fill the rest of each jar with the remaining oat mixture.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cover and refrigerate until oats have softened and thickened, at least 8 hours or up to 3 days. Top with the remaining cooked spiced apples before serving.",
      "secondary_message": null
    }
  ],
