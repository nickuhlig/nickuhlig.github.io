  "instructions": [
    {
      "id": 497335,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 497336,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n1 ½ small pineapples\n1 ½ English cucumbers"
    },
    {
      "id": 497337,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove from heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 497338,
      "primary_message": "While the rice is cooking, zest and juice limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 497339,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime, along with vinegar, chili-garlic sauce, and salt. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp apple cider vinegar\n¾ tsp chili-garlic sauce\n¾ tsp salt"
    },
    {
      "id": 497340,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl with the dressing. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 497341,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 497342,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 497343,
      "primary_message": "Cut the chicken into ¼-inch thick slices and place in another large bowl. Add cornstarch and pepper, then toss to coat.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 ½ tbsp cornstarch\n¾ tsp black pepper"
    },
    {
      "id": 497344,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497345,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and cook, flipping once, until cooked through and crispy on both sides, 5-6 minutes. Transfer to a plate.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 497346,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop peanuts. ",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 497347,
      "primary_message": "Return chicken to the skillet. Add chili-garlic sauce and stir to coat, 15-30 seconds. Remove from heat, add fish sauce, and stir once more to combine.",
      "secondary_message": "2 tbsp chili-garlic sauce\n2 tbsp fish sauce"
    },
    {
      "id": 497348,
      "primary_message": "To serve, divide rice between bowls, then top with the chicken and salad. Sprinkle with peanuts and enjoy!",
      "secondary_message": null
    }
  ],
