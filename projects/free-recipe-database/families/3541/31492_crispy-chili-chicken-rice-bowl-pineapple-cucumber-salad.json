  "instructions": [
    {
      "id": 497307,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat. ",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 497308,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ small bunch cilantro\n½ small pineapple\n½ English cucumber"
    },
    {
      "id": 497309,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove from heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 497310,
      "primary_message": "While the rice is cooking, zest and juice lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 497311,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime, along with vinegar, chili-garlic sauce, and salt. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp apple cider vinegar\n¼ tsp chili-garlic sauce\n¼ tsp salt"
    },
    {
      "id": 497312,
      "primary_message": "Peel and small dice shallot. Add to the bowl with the dressing. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 497313,
      "primary_message": "Cut off skin from pineapple; quarter, core, and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 497314,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 497315,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497316,
      "primary_message": "While the skillet heats up, cut the chicken into ¼-inch thick slices and place in another medium bowl. Add cornstarch and pepper, then toss to coat.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n1 ½ tsp cornstarch\n¼ tsp black pepper"
    },
    {
      "id": 497317,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, flipping once, until cooked through and crispy on both sides, 5-6 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 497318,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop peanuts. ",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 497319,
      "primary_message": "When the chicken is done, add chili-garlic sauce to the skillet and stir to coat, 15-30 seconds. Remove from heat, add fish sauce, and stir once more to combine.",
      "secondary_message": "2 tsp chili-garlic sauce\n2 tsp fish sauce"
    },
    {
      "id": 497320,
      "primary_message": "To serve, divide rice between bowls, then top with the chicken and salad. Sprinkle with peanuts and enjoy!",
      "secondary_message": null
    }
  ],
