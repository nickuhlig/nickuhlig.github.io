  "instructions": [
    {
      "id": 58226,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": ""
    },
    {
      "id": 58227,
      "primary_message": "In a small saucepan, combine quinoa and broth. Bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 58228,
      "primary_message": "Peel squash, scrape out and discard the seeds, and medium dice the flesh. Transfer to a sheet pan.",
      "secondary_message": "3 small butternut squash"
    },
    {
      "id": 58229,
      "primary_message": "Drizzle squash with oil and season with salt and pepper. Toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 58230,
      "primary_message": "Place in the oven and roast until squash is tender, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 58232,
      "primary_message": "Wash and dry arugula. Transfer to a large bowl.",
      "secondary_message": "1 ½ (5 oz) pkg baby arugula"
    },
    {
      "id": 58233,
      "primary_message": "Peel and thinly slice onion into half rings. Add to bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 58231,
      "primary_message": "Add almonds and cranberries to bowl.",
      "secondary_message": "⅜ cup almonds\n⅜ cup dried cranberries"
    },
    {
      "id": 58234,
      "primary_message": "In a small bowl, prepare dressing by whisking together lemon juice, oil, vinegar, salt, and pepper.",
      "secondary_message": "1 ½ lemon\n9 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 58224,
      "primary_message": "Cut remaining lemons into wedges.",
      "secondary_message": "1 ½ lemon"
    },
    {
      "id": 58225,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "1 ½ (4 oz) log goat cheese"
    },
    {
      "id": 58235,
      "primary_message": "Uncover quinoa and fluff with a fork. Add quinoa and squash to salad and toss.",
      "secondary_message": ""
    },
    {
      "id": 58223,
      "primary_message": "To serve, place salad on a plate, sprinkle with goat cheese, and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
