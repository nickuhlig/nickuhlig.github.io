  "instructions": [
    {
      "primary_message": "FOR THE PUMPKIN SPICE BASE: Place water and sugar in a small saucepan. Heat over medium, stirring occasionally, until sugar is dissolved, 2-3 minutes. Remove from heat.",
      "secondary_message": "½ cup brown sugar"
    },
    {
      "primary_message": "Add pumpkin, vanilla, pumpkin spice mix, and salt to the saucepan, then whisk to combine the pumpkin spice base. Strain into a jar or resealable container to remove solids (if desired), then cover with a lid and refrigerate until ready to use. (NOTE: this recipe makes about 1 cup pumpkin spice base which can be stored in the fridge for up to one week.)",
      "secondary_message": "½ cup pure pumpkin purée\n2 tbsp vanilla extract\n1 tbsp pumpkin spice mix\n¼ tsp salt"
    },
    {
      "primary_message": "FOR THE LATTE: Place milk, water, 2 tablespoons of the pumpkin spice base, and instant coffee crystals in a small saucepan. Heat over medium-high, whisking often, until desired drinking temperature, 4-5 minutes. Remove from heat. (Adjust the amount of pumpkin spice base as desired.) ",
      "secondary_message": "1 cup whole milk\n2 tsp instant coffee crystals"
    },
    {
      "primary_message": "To serve, pour latte into a mug. Top with whipped topping and a sprinkle of pumpkin spice. Enjoy!",
      "secondary_message": "⅓ cup whipped topping\npumpkin spice mix"
    }
  ],
