  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the Spanish onions into large chunks. Core, seed, and roughly chop the red bell pepper. Core and cut the ripe plum tomatoes into chunks. Wash and roughly chop the cilantro. Peel the garlic. Stem the ajices dulces.",
      "secondary_message": "2 medium Spanish onions\n1 large red bell pepper\n4 medium ripe plum tomatoes\n1 large bunch cilantro\n18 medium cloves garlic\n8 ajices dulces"
    },
    {
      "id": 1,
      "primary_message": "Place onions and cubanelle peppers in workbowl of a food processor fitted with a steel blade. Pulse until coarsely chopped.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "With the motor running, add the remaining ingredients one at a time through the feed tube and process until smooth. Season to taste with salt. Transfer to container and store in refrigerator for up to three days, or freeze.",
      "secondary_message": null
    }
  ],
