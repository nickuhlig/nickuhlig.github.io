  "instructions": [
    {
      "id": 1,
      "primary_message": "Place onions and cubanelle peppers in workbowl of a food processor fitted with a steel blade. Pulse until coarsely chopped.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "With the motor running, add the remaining ingredients one at a time through the feed tube and process until smooth. Season to taste with salt. Transfer to container and store in refrigerator for up to three days, or freeze.",
      "secondary_message": null
    }
  ],
