  "instructions": [
    {
      "id": 292425,
      "primary_message": "Preheat oven to 245°C (475°F). Line two baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 292426,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 medium carrots\n1 ½ English cucumbers\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 292427,
      "primary_message": "Zest lemons into a large bowl, then add oil, Dijon, salt, and pepper; whisk to combine the marinade. (Set lemons aside for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 292428,
      "primary_message": "Pat chicken wings dry with paper towels and add to the bowl with the marinade; toss to coat. Divide between the baking sheets and spread out in a single layer.",
      "secondary_message": "1.36 kg chicken wings, split with tips removed"
    },
    {
      "id": 292429,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 292430,
      "primary_message": "Meanwhile, medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 292431,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 292432,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 292433,
      "primary_message": "While the bacon is cooking, juice reserved lemons into a clean large bowl; add Dijon, salt, and pepper.",
      "secondary_message": "1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 292434,
      "primary_message": "When the bacon is done, add drippings from the skillet to the bowl with the lemon juice and Dijon; whisk to combine the dressing.",
      "secondary_message": null
    },
    {
      "id": 292435,
      "primary_message": "Using a clean cutting board, peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 292436,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 292437,
      "primary_message": "Right before serving, add crispy bacon, spinach, and blue cheese to the bowl with the dressing and veggies; toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 292438,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
