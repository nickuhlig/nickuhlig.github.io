  "instructions": [
    {
      "id": 292397,
      "primary_message": "Preheat oven to 245°C (475°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 292398,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 medium carrot\n½ English cucumber\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 292399,
      "primary_message": "Zest lemon into a medium bowl, then add oil, Dijon, salt, and pepper; whisk to combine the marinade. (Set lemon aside for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 292400,
      "primary_message": "Pat chicken wings dry with paper towels and add to the bowl with the marinade; toss to coat and spread out on the baking sheet in an even layer.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed"
    },
    {
      "id": 292401,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 292402,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 292403,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 292404,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 292405,
      "primary_message": "While the bacon is cooking, juice reserved lemon into a clean medium bowl; add Dijon, salt, and pepper.",
      "secondary_message": "1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 292406,
      "primary_message": "When the bacon is done, add drippings from the skillet to the bowl with the lemon juice and Dijon; whisk to combine the dressing.",
      "secondary_message": null
    },
    {
      "id": 292407,
      "primary_message": "Using a clean cutting board, peel, trim, and coarsely grate carrot; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 292408,
      "primary_message": "Trim and medium dice cucumber; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 292409,
      "primary_message": "Right before serving, add crispy bacon, spinach, and blue cheese to the bowl with the dressing and veggies; toss to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 292410,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
