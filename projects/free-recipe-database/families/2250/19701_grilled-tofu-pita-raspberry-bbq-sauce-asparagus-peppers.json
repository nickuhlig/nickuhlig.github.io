  "instructions": [
    {
      "id": 445147,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 445148,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 orange\n2 (6 oz) pkgs raspberries\n2 red bell peppers\n2 small bunches asparagus"
    },
    {
      "id": 445149,
      "primary_message": "Juice orange into a blender. ",
      "secondary_message": null
    },
    {
      "id": 445150,
      "primary_message": "Peel garlic; add to the blender with the orange juice along with raspberries, ketchup, sugar, soy sauce, and spices. Blend on high until BBQ sauce is very smooth, about 1 minute; set aside.",
      "secondary_message": "2 cloves garlic\n¼ cup ketchup\n4 tsp brown sugar\n1 tsp soy sauce\n½ tsp cumin, ground\n¼ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 445151,
      "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; place on a plate. Sprinkle with cornstarch, salt, and pepper on both sides.",
      "secondary_message": "2 tbsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445152,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445153,
      "primary_message": "Once the grill pan is hot, coat with oil; add tofu and grill, flipping once, until charred and warmed through, 5-7 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 445154,
      "primary_message": "Meanwhile, trim, halve, seed, and slice bell peppers crosswise into 1-inch wide strips; place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 445155,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 445156,
      "primary_message": "Peel, halve, and slice onion lengthwise into ½-inch thick wedges; add to the bowl. Drizzle veggies with oil, season with salt and pepper, then gently toss to coat. ",
      "secondary_message": "1 medium red onion\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 445157,
      "primary_message": "Once the tofu is done, working in batches if necessary, add veggies to the pan; grill, flipping once, until tender, 2-3 minutes per side. Return to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 445158,
      "primary_message": "To assemble, cut pitas in half and carefully open the pockets; spread each pocket with 1 tablespoon of the BBQ sauce. Stuff with tofu and drizzle with another 1 tablespoon of the sauce. (Reserve remaining sauce for serving.)",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 445159,
      "primary_message": "Divide pitas and grilled veggies between plates; serve with remaining sauce on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
