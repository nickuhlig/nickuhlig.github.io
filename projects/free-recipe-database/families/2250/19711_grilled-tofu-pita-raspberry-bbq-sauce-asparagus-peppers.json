  "instructions": [
    {
      "id": 445277,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 445278,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ oranges\n3 (170 g) pkgs raspberries\n3 red bell peppers\n3 small bunches asparagus"
    },
    {
      "id": 445279,
      "primary_message": "Juice oranges into a blender. ",
      "secondary_message": null
    },
    {
      "id": 445280,
      "primary_message": "Peel garlic; add to the blender with the orange juice along with raspberries, ketchup, sugar, soy sauce, and spices. Blend on high until BBQ sauce is very smooth, 1-2 minutes; set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup ketchup\n2 tbsp brown sugar\n1 ½ tsp soy sauce\n¾ tsp cumin, ground\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445281,
      "primary_message": "Cut the tofu planks in half, then cut each half into 2 triangles; place on a plate. Sprinkle with cornstarch, salt, and pepper on both sides.",
      "secondary_message": "3 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 445282,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445283,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add tofu and grill, flipping once, until charred and warmed through, 5-7 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 445284,
      "primary_message": "Meanwhile, trim, halve, seed, and slice bell peppers crosswise into 1-inch wide strips; place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 445285,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 445286,
      "primary_message": "Peel, halve, and slice onions lengthwise into ½-inch thick wedges; add to the bowl. Drizzle veggies with oil, season with salt and pepper, then gently toss to coat. ",
      "secondary_message": "1 ½ medium red onions\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445287,
      "primary_message": "Once the tofu is done, working in batches if necessary, add veggies to the pan; grill, flipping once, until tender, 2-3 minutes per side. Return to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 445288,
      "primary_message": "To assemble, cut pitas in half and carefully open the pockets; spread each pocket with 1 tablespoon of the BBQ sauce. Stuff with tofu and drizzle with another 1 tablespoon of the sauce. (Reserve remaining sauce for serving.)",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 445289,
      "primary_message": "Divide pitas and grilled veggies between plates; serve with remaining sauce on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
