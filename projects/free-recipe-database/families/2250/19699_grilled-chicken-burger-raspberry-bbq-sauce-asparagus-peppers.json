  "instructions": [
    {
      "id": 445121,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ oranges\n3 (6 oz) pkgs raspberries\n3 red bell peppers\n3 small bunches asparagus"
    },
    {
      "id": 445122,
      "primary_message": "Juice oranges into a blender.",
      "secondary_message": null
    },
    {
      "id": 445123,
      "primary_message": "Peel garlic; add to the blender with the orange juice along with raspberries, ketchup, sugar, Worcestershire, and spices. Blend on high until BBQ sauce is very smooth,1-2 minutes; set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup ketchup\n2 tbsp brown sugar\n1 ½ tsp Worcestershire sauce\n¾ tsp cumin, ground\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445124,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445125,
      "primary_message": "While the grill pan heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides. ",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 445126,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 445127,
      "primary_message": "Meanwhile, using a clean cutting board, trim, halve, seed, and slice bell peppers crosswise into 1-inch wide strips; place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 445128,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 445129,
      "primary_message": "Peel, halve, and slice onions lengthwise into ½-inch thick wedges; add to the bowl. Drizzle veggies with oil, season with salt and pepper, then gently toss to coat.",
      "secondary_message": "1 ½ medium red onions\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445130,
      "primary_message": "Once the chicken is done, working in batches if necessary, add veggies to the pan; grill, flipping once, until tender, 2-3 minutes per side. Return to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445131,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 445132,
      "primary_message": "To assemble the burgers, spread 1 tablespoon of BBQ sauce over the bottom half of each bun; top with chicken and another 1 tablespoon of the sauce. Close with the top half of each bun. (Reserve remaining sauce for serving.)",
      "secondary_message": null
    },
    {
      "id": 445133,
      "primary_message": "Divide burgers and grilled veggies between plates; serve with remaining sauce on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
