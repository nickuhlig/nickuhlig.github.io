  "instructions": [
    {
      "id": 385980,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n2 cup water\n½ tsp salt"
    },
    {
      "id": 385981,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 tomatoes\n3 small bunches Italian (flat-leaf) parsley\n1 small pkg fresh mint"
    },
    {
      "id": 385982,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 385983,
      "primary_message": "Peel and mince shallots. Add to the bowl with the lemon juice along with oil and spices. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n¼ cup extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp cumin, ground\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 385984,
      "primary_message": "Small dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 385985,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 385986,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 385987,
      "primary_message": "When the quinoa is done, transfer to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes. Once cool, add to the bowl with the other ingredients and stir to combine the tabbouleh.",
      "secondary_message": null
    },
    {
      "id": 385988,
      "primary_message": "To serve, divide tabbouleh between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
