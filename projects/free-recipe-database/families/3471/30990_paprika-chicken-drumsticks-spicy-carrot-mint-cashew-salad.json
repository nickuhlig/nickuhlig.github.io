  "instructions": [
    {
      "id": 500437,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 500438,
      "primary_message": "Pat chicken dry with paper towels and place in a large bowl. Drizzle with oil, season with spices, and toss to coat. Transfer chicken to the baking sheet, spreading it out in an even layer.",
      "secondary_message": "3 ¾ lb chicken drumsticks\n1 tbsp extra virgin olive oil\n1 tbsp smoked paprika\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp turmeric, ground"
    },
    {
      "id": 500439,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is golden and cooked through, about 30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 500440,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n9 medium carrots\n3 jalapeño peppers\n1 small pkg fresh mint"
    },
    {
      "id": 500441,
      "primary_message": "Peel and mince garlic. Place in a clean large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 500442,
      "primary_message": "Juice lemons into the bowl with the garlic. Add oil, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 500443,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 500444,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 500445,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 500446,
      "primary_message": "Roughly chop cashews. Add to the bowl and stir to combine the salad.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 500447,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
