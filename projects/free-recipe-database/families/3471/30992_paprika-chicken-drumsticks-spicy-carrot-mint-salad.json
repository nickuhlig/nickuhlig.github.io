  "instructions": [
    {
      "id": 500458,
      "primary_message": "Preheat oven to 450°F. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 500459,
      "primary_message": "Pat chicken dry with paper towels and place in a medium bowl. Drizzle with oil, season with spices, and toss to coat. Transfer chicken to the baking sheet, spreading it out in an even layer.",
      "secondary_message": "2 ½ lb chicken drumsticks\n2 tsp extra virgin olive oil\n2 tsp smoked paprika\n1 tsp thyme, dried\n1 tsp salt\n½ tsp turmeric, ground"
    },
    {
      "id": 500460,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is golden and cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 500461,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n6 medium carrots\n2 jalapeño peppers\n1 small pkg fresh mint"
    },
    {
      "id": 500462,
      "primary_message": "Peel and mince garlic. Place in a clean medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 500463,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 500464,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 500465,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 500466,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 500467,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
