  "instructions": [
    {
      "id": 500511,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 500512,
      "primary_message": "Pat chicken dry with paper towels and place in a medium bowl. Drizzle with oil, season with spices, and toss to coat. Transfer chicken to the baking sheet, spreading it out in an even layer.",
      "secondary_message": "0.57 kg chicken drumsticks\n1 tsp extra virgin olive oil\n1 tsp smoked paprika\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp turmeric, ground"
    },
    {
      "id": 500513,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until chicken is golden and cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 500514,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n3 medium carrots\n1 jalapeño pepper\n½ small pkg fresh mint"
    },
    {
      "id": 500515,
      "primary_message": "Peel and mince garlic. Place in a clean medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 500516,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n¼ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 500517,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 500518,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Slice crosswise into thin half-moons and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 500519,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 500520,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
