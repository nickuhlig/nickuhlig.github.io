  "instructions": [
    {
      "id": 432461,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 432462,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n1 ½ pints grape tomatoes\n1 ½ lemons"
    },
    {
      "id": 432463,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 432464,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 432465,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 432466,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432467,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, basil, and salt; cook, stirring occasionally, until starting to soften, 5-6 minutes. Remove from heat. (Reserve bowl for next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp basil, dried\n¾ tsp salt"
    },
    {
      "id": 432468,
      "primary_message": "Meanwhile, drain and rinse chickpeas; place in the reserved bowl.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 432469,
      "primary_message": "Juice lemons into the bowl with the chickpeas, then add tahini, oil, and spices. Using a fork or potato masher, roughly mash chickpeas until semi-smooth and set aside.",
      "secondary_message": "⅓ cup tahini\n3 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 432470,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 432471,
      "primary_message": "Halve olives lengthwise.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 432472,
      "primary_message": "Divide pitas between two baking sheet pans; evenly top with chickpea spread, then cheese, veggies, and olives.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 432473,
      "primary_message": "Place baking sheets in the oven and bake until pizzas are warmed through and cheese is melted, about 8 minutes. Remove from oven and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 432474,
      "primary_message": "To serve, divide pizzas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
