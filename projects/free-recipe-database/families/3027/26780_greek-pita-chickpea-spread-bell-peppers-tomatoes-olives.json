  "instructions": [
    {
      "id": 432569,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 432570,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 yellow bell peppers\n1 small pkg grape tomatoes\n1 lemon"
    },
    {
      "id": 432571,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 432572,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 432573,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432574,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 432575,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, basil, and salt; cook, stirring occasionally, until starting to soften, 4-5 minutes. Remove from heat. (Reserve bowl for next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp basil, dried\n½ tsp salt"
    },
    {
      "id": 432576,
      "primary_message": "Meanwhile, drain and rinse chickpeas; place in the reserved bowl.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 432577,
      "primary_message": "Juice lemon into the bowl with the chickpeas, then add nutritional yeast, tahini, oil, and spices. Using a fork or potato masher, roughly mash chickpeas until semi-smooth and set aside.",
      "secondary_message": "¼ cup nutritional yeast flakes\n¼ cup tahini\n2 tbsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 432578,
      "primary_message": "Halve olives lengthwise.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 432579,
      "primary_message": "Arrange pitas on a large baking sheet pan; evenly top with chickpea spread, then veggies and olives.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 432580,
      "primary_message": "Place baking sheet in the oven and bake until pitas are warmed through, 6-8 minutes. Remove from oven and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 432581,
      "primary_message": "To serve, divide pita wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
