  "instructions": [
    {
      "id": 432582,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 432583,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n1 ½ small pkgs grape tomatoes\n1 ½ lemons"
    },
    {
      "id": 432584,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 432585,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 432586,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 432587,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 432588,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, basil, and salt; cook, stirring occasionally, until starting to soften, 5-6 minutes. Remove from heat. (Reserve bowl for next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp basil, dried\n¾ tsp salt"
    },
    {
      "id": 432589,
      "primary_message": "Meanwhile, drain and rinse chickpeas; place in the reserved bowl.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 432590,
      "primary_message": "Juice lemons into the bowl with the chickpeas, then add nutritional yeast, tahini, oil, and spices. Using a fork or potato masher, roughly mash chickpeas until semi-smooth and set aside.",
      "secondary_message": "⅓ cup nutritional yeast flakes\n⅓ cup tahini\n3 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 432591,
      "primary_message": "Halve olives lengthwise.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 432592,
      "primary_message": "Divide pitas between two baking sheet pans; evenly top with chickpea spread, then veggies and olives.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 432593,
      "primary_message": "Place baking sheets in the oven and bake until pitas are warmed through, about 8 minutes. Remove from oven and cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 432594,
      "primary_message": "To serve, divide pita wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
