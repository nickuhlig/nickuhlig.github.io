  "instructions": [
    {
      "id": 335794,
      "primary_message": "This recipe will make about 12 cups; work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 335795,
      "primary_message": "Wash, dry, and cut off skin from each pineapple; quarter, core, and roughly chop the flesh. Place in a blender.",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 335796,
      "primary_message": "Wash and dry kale, then fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces and add to the blender.",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 335797,
      "primary_message": "Add 12 ice cubes, milk, edamame, yogurt, and maple syrup to the blender.",
      "secondary_message": "710 ml whole milk\n1 ½ cups edamame\n1 ½ cups plain Greek yogurt\n2 tbsp pure maple syrup"
    },
    {
      "id": 335798,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 335799,
      "primary_message": "Pour the smoothie into glasses and enjoy!",
      "secondary_message": null
    }
