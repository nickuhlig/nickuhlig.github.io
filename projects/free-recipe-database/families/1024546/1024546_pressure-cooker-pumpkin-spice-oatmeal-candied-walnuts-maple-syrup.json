  "instructions": [
    {
      "primary_message": "Place water, milk, maple syrup, pumpkin spice mix, vanilla, and salt in a 6-quart electric pressure cooker insert. Whisk to combine.",
      "secondary_message": "1 cup whole milk\npure maple syrup\n2 tsp pumpkin spice mix\n1 tsp vanilla extract\n¼ tsp salt"
    },
    {
      "primary_message": "Add oats to the insert and stir to combine. Lock lid in place and set valve to the pressure cooking setting. ",
      "secondary_message": "1 cup oats, steel-cut"
    },
    {
      "primary_message": "Set to pressure cook on HIGH for 4 minutes, then allow the pressure to release naturally for 15 minutes. Carefully release any remaining pressure and remove the lid.",
      "secondary_message": null
    },
    {
      "primary_message": "Add pumpkin to the insert and stir well to combine the oatmeal.",
      "secondary_message": "½ (15 oz) can pure pumpkin purée"
    },
    {
      "primary_message": "Roughly chop candied walnuts. ",
      "secondary_message": "⅔ cup candied walnuts"
    },
    {
      "primary_message": "To serve, divide pumpkin oatmeal between bowls; top with walnuts and additional maple syrup. Enjoy!",
      "secondary_message": "¼ cup pure maple syrup"
    }
  ],
