  "instructions": [
    {
      "id": 139405,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 139406,
      "primary_message": "Peel and mince garlic; set aside in a small bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 139407,
      "primary_message": "Peel and small dice the shallot and add to a large bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 139408,
      "primary_message": "Add ⅓ of the minced garlic, ground turkey, egg, almond flour, salt, and pepper to the bowl with the shallot and mix with your hands until well combined.",
      "secondary_message": "⅓ kg ground turkey\n1 egg\n¼ cup almond meal/flour\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 139409,
      "primary_message": "Coat a baking dish with a thin layer of olive oil. Using a tablespoon measure, form the turkey mixture into rounded meatballs and place in the dish. Place in the oven and bake until cooked through, about 18 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 139410,
      "primary_message": "Meanwhile, wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl. ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 139411,
      "primary_message": "Wash and dry lemon, then zest into the bowl with the parsley; add oil and ⅓ of the garlic and stir to combine the dressing. Save the lemon to juice later.",
      "secondary_message": "½ lemon\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 139412,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. ",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 139413,
      "primary_message": "Preheat a skillet over medium-high heat. Add butter and swirl to coat the bottom. Add the remaining ⅓ of the garlic and cook for 1 minute. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 139414,
      "primary_message": "Juice the lemon into the skillet; add kale and spices. Cook, stirring frequently, for 1-2 minutes.",
      "secondary_message": "⅛ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 139415,
      "primary_message": "Add broth, cover with a lid, and cook until tender, about 5 minutes. Top kale with meatballs, then remove from heat.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 139416,
      "primary_message": "To serve, divide kale and meatballs between dishes and top with parsley dressing. Enjoy! ",
      "secondary_message": null
    }
  ],
