  "instructions": [
    {
      "id": 139429,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 139430,
      "primary_message": "Peel and mince garlic; set aside in a small bowl. ",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 139431,
      "primary_message": "Peel and small dice the onion and add to a large bowl. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 139432,
      "primary_message": "Add ⅓ of the minced garlic, ground turkey, eggs, almond flour, salt, and pepper to the bowl with the onion and mix with your hands until well combined.",
      "secondary_message": "1.02 kg ground turkey\n3 eggs\n¾ cup almond meal/flour\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 139433,
      "primary_message": "Coat two baking dishes with a thin layer of olive oil. Using a tablespoon measure, form the turkey mixture into rounded meatballs and place in the dishes. Place in the oven and bake until cooked through, about 18 minutes ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 139434,
      "primary_message": "Meanwhile, wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Transfer to a small bowl. ",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 139435,
      "primary_message": "Wash and dry lemons, then zest into the bowl with the parsley; add oil and ⅓ of the garlic and stir to combine the dressing. Save the lemons to juice later.",
      "secondary_message": "1 ½ lemons\n⅓ cup extra virgin olive oil"
    },
    {
      "id": 139436,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 139437,
      "primary_message": "Preheat a large skillet over medium-high heat. Add butter and swirl to coat the bottom. Add the remaining ⅓ of the garlic and cook for 1 minute. ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 139438,
      "primary_message": "Juice lemons into the skillet; add kale and spices. Cook, stirring frequently, for 1-2 minutes. Cook in batches if necessary.",
      "secondary_message": "¼ tsp crushed red pepper\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 139439,
      "primary_message": "Add broth, cover with a lid, and cook until tender, about 5 minutes. Top kale with meatballs, then remove from heat.",
      "secondary_message": "355 ml chicken or vegetable broth"
    },
    {
      "id": 139440,
      "primary_message": "To serve, divide kale and meatballs between dishes and top with parsley dressing. Enjoy! ",
      "secondary_message": null
    }
  ],
