  "instructions": [
    {
      "id": 631179,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 631180,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n2 Gala apples\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 631181,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring often, until lightly toasted and fragrant, 3-4 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for the next step.)",
      "secondary_message": "½ cup almonds"
    },
    {
      "id": 631182,
      "primary_message": "Return skillet to medium-high heat, add oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 pre-cooked vegan sausage"
    },
    {
      "id": 631183,
      "primary_message": "Meanwhile, zest and juice lemon into a large bowl. Add oil, vinegar, Dijon, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n2 tsp honey\n2 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 631184,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 631185,
      "primary_message": "Finely grate Parmesan. Add to the bowl.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 631186,
      "primary_message": "Add mixed greens and toasted almonds to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 631187,
      "primary_message": "Slice sausages crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 631188,
      "primary_message": "To serve, divide salad between plates or bowls, then top with sausage. Enjoy!",
      "secondary_message": null
    }
  ],
