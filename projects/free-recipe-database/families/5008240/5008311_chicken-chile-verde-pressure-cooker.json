  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Discard the husks from the tomatillos, then quarter them. Roughly chop the white onion. Roughly chop the Serrano peppers, then discard the stems. Peel the garlic. Toast and grind the whole cumin seeds.",
      "secondary_message": "10 tomatillos\n2 ½ medium white onion\n2 Serrano peppers\n6 medium cloves garlic\n1 tbsp whole cumin seeds"
    },
    {
      "id": 1,
      "primary_message": "Combine chicken, poblano peppers, tomatillos, onion, Anaheim peppers, Serrano peppers, garlic, cumin, and a big pinch of salt in a pressure cooker. Heat over high heat until gently sizzling, then seal pressure cooker, bring to high pressure, and cook for 15 minutes. Release pressure.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using tongs, transfer chicken pieces to a bowl and set aside. Add cilantro and fish sauce to remaining contents of pressure cooker. Blend with an immersion blender or in a countertop blender and season to taste with salt. Return chicken to sauce, discarding skin and bones and shredding if desired.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to a serving platter, garnish with chopped cilantro, and serve immediately with tortillas and lime wedges.",
      "secondary_message": null
    }
  ],
