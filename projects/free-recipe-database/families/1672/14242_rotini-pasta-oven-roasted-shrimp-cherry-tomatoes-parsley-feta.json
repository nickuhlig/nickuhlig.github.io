  "instructions": [
    {
      "id": 236454,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 236455,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 236456,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 236457,
      "primary_message": "Transfer shrimp to a baking sheet pan, spreading them out in an even layer; season with spices.",
      "secondary_message": "1 tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 236458,
      "primary_message": "Peel and thinly slice garlic. Peel, halve, and thinly slice onion. Add both to the baking sheet with the shrimp.",
      "secondary_message": "4 cloves garlic\n½ medium red onion"
    },
    {
      "id": 236459,
      "primary_message": "Wash and dry tomatoes; cut in half crosswise and add to the baking sheet.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 236460,
      "primary_message": "Add oil and capers to the baking sheet, toss to combine, then spread everything out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp capers"
    },
    {
      "id": 236461,
      "primary_message": "Sprinkle feta over the top of the shrimp and tomato mixture.",
      "secondary_message": "2 (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 236462,
      "primary_message": "Place baking sheet in the oven and roast until tomatoes are soft and shrimp are cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 236463,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 236464,
      "primary_message": "When the pasta is done, drain in a colander. Return pasta to the pot, cover, and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 236465,
      "primary_message": "When the shrimp and tomato mixture is done, carefully transfer to the pot with the pasta; add parsley and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 236466,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
