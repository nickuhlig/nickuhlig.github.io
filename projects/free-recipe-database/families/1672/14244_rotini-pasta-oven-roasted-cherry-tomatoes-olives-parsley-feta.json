  "instructions": [
    {
      "id": 236480,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 236481,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 236482,
      "primary_message": "Peel and thinly slice garlic. Peel, halve, and thinly slice shallot. Transfer both to a baking dish.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 236483,
      "primary_message": "Wash and dry tomatoes; cut in half crosswise and add to the baking dish with the garlic and shallot.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 236484,
      "primary_message": "Thinly slice olives and add to the baking dish.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 236485,
      "primary_message": "Add oil, capers, and spices to the baking dish; toss to combine, then spread everything out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp capers\n½ tsp oregano, dried\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 236486,
      "primary_message": "Sprinkle feta over the top of the tomato mixture.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 236487,
      "primary_message": "Place baking dish in the oven and roast until tomatoes are soft and juicy, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 236488,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 236489,
      "primary_message": "When the pasta is done, drain in a colander. Return pasta to the saucepan, cover, and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 236490,
      "primary_message": "When the tomato mixture is done, carefully transfer to the pan with the pasta; add parsley and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 236491,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
