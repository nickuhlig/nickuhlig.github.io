  "instructions": [
    {
      "id": 236492,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 236493,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 236494,
      "primary_message": "Peel and thinly slice garlic. Peel, halve, and thinly slice onion. Transfer both to a large baking dish.",
      "secondary_message": "4 cloves garlic\n½ medium red onion"
    },
    {
      "id": 236495,
      "primary_message": "Wash and dry tomatoes; cut in half crosswise and add to the baking dish with the garlic and onion.",
      "secondary_message": "2 pints grape tomatoes"
    },
    {
      "id": 236496,
      "primary_message": "Thinly slice olives and add to the baking dish.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 236497,
      "primary_message": "Add oil, capers, and spices to the baking dish; toss to combine, then spread everything out in an even layer.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp capers\n1 tsp oregano, dried\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 236498,
      "primary_message": "Sprinkle feta over the top of the tomato mixture.",
      "secondary_message": "2 (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 236499,
      "primary_message": "Place baking dish in the oven and roast until tomatoes are soft and juicy, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 236500,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 236501,
      "primary_message": "When the pasta is done, drain in a colander. Return pasta to the pot, cover, and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 236502,
      "primary_message": "When the tomato mixture is done, carefully transfer to the pot with the pasta; add parsley and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 236503,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
