  "instructions": [
    {
      "id": 236654,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 236655,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 236656,
      "primary_message": "Peel and thinly slice garlic. Peel, halve, and thinly slice onion. Transfer both to a baking sheet pan.",
      "secondary_message": "6 cloves garlic\n1 medium red onion"
    },
    {
      "id": 236657,
      "primary_message": "Wash and dry tomatoes; cut in half crosswise and add to the baking sheet with the garlic and onion.",
      "secondary_message": "3 small pkgs grape tomatoes"
    },
    {
      "id": 236658,
      "primary_message": "Thinly slice olives and add to the baking sheet.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 236659,
      "primary_message": "Add oil, capers, and spices to the baking sheet; toss to combine, then spread everything out in an even layer.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp capers\n1 ½ tsp oregano, dried\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 236660,
      "primary_message": "Sprinkle feta over the top of the tomato mixture.",
      "secondary_message": "3 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 236661,
      "primary_message": "Place baking sheet in the oven and roast until tomatoes are soft and juicy, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 236662,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 236663,
      "primary_message": "When the pasta is done, drain in a colander. Return pasta to the pot, cover, and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 236664,
      "primary_message": "When the tomato mixture is done, carefully transfer to the pot with the pasta; add parsley and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 236665,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
