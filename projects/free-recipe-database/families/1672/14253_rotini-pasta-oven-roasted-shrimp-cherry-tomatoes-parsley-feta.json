  "instructions": [
    {
      "id": 236591,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 236592,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 236593,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 236594,
      "primary_message": "Transfer shrimp to a large baking dish, spreading them out in an even layer; season with spices.",
      "secondary_message": "½ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 236595,
      "primary_message": "Peel and thinly slice garlic. Peel, halve, and thinly slice shallot. Add both to the baking dish with the shrimp.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 236596,
      "primary_message": "Wash and dry tomatoes; cut in half crosswise and add to the baking dish.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 236597,
      "primary_message": "Add oil and capers to the baking dish, toss to combine, then spread everything out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp capers"
    },
    {
      "id": 236598,
      "primary_message": "Sprinkle feta over the top of the shrimp and tomato mixture.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 236599,
      "primary_message": "Place baking dish in the oven and roast until tomatoes are soft and shrimp are cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 236600,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 236601,
      "primary_message": "When the pasta is done, drain in a colander. Return pasta to the saucepan, cover, and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 236602,
      "primary_message": "When the shrimp and tomato mixture is done, carefully transfer to the pan with the pasta; add parsley and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 236603,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
