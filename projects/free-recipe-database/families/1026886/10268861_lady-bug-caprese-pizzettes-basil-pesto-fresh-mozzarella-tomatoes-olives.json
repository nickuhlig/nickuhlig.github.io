  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and slice tomatoes crosswise into thin rounds. Cut rounds in half and transfer to a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Drain both kinds of olives. Halve the whole olives lengthwise, then add both kinds to the plate with the tomatoes. Set aside.",
      "secondary_message": "¼ cup large black olives,  pitted\n1 (108 g) can sliced black olives"
    },
    {
      "primary_message": "Split English muffins in half and arrange on a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "primary_message": "Spread each muffin half with 1 tbsp pesto, then top with a mozzarella slice. Arrange tomatoes on top of the cheese, overlapping at the \"head\" of your \"ladybug\" so that there is a 1-inch triangular opening at the bottom, creating \"wings.\"",
      "secondary_message": "¾ cup basil pesto\n1 (340 g) pkg fresh mozzarella cheese"
    },
    {
      "primary_message": "Place an olive half on each muffin, cut-side down, where the tomatoes overlap, creating the ladybug \"head.\" Arrange sliced olives on the wings to create \"spots.\"",
      "secondary_message": null
    },
    {
      "primary_message": "Place baking sheet in the preheated oven and bake until cheese is melted, about 10 minutes. Remove from oven and set aside to cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange ladybug pizzettes on a serving platter and enjoy!",
      "secondary_message": null
    }
  ],
