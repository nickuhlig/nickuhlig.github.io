  "instructions": [
    {
      "id": 199705,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "½ small bunch fresh dill\n1 medium carrot\n1 tomato\n½ (142 g) pkg spring mix (mixed greens)\n½ (454 g) pkg strawberries"
    },
    {
      "id": 199706,
      "primary_message": "Drain and rinse the chickpeas; transfer to a medium bowl.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 199707,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 199708,
      "primary_message": "Add mayo, Dijon, vinegar, and spices to the bowl.",
      "secondary_message": "3 tbsp mayonnaise\n1 tsp Dijon mustard\n1 tsp apple cider vinegar\n⅛ tsp onion powder\n⅛ tsp paprika\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 199709,
      "primary_message": "Use a fork or potato masher to crush the chickpeas, making a semi-smooth spread. Set aside.",
      "secondary_message": null
    },
    {
      "id": 199710,
      "primary_message": "Peel, trim, and julienne or coarsely grate the carrot.",
      "secondary_message": null
    },
    {
      "id": 199711,
      "primary_message": "Slice the tomato.",
      "secondary_message": null
    },
    {
      "id": 199712,
      "primary_message": "Place bread slices on a flat surface. Spread half of the slices with a thick layer of chickpea salad and top carrots, tomato, and spring mix. Cover sandwiches with remaining bread slices.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 199713,
      "primary_message": "Slice strawberries in half.",
      "secondary_message": null
    },
    {
      "id": 199714,
      "primary_message": "To serve, divide sandwiches and strawberries between plates and enjoy!",
      "secondary_message": null
    }
  ],
