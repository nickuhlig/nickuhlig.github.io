  "instructions": [
    {
      "id": 450932,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n3 medium carrots\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 450933,
      "primary_message": "Thinly slice mushrooms. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 450934,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 450935,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 450936,
      "primary_message": "While the pot heats up, trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 450937,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until soft, 5-6 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 450938,
      "primary_message": "Meanwhile, use your hands to break the pasta into 2-inch pieces.",
      "secondary_message": "170 g fettuccine pasta"
    },
    {
      "id": 450939,
      "primary_message": "When the veggies are soft, add flour to the pot. Cook, stirring frequently, for 1 minute.",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 450940,
      "primary_message": "Add pasta, broth, milk, Worcestershire, salt, and pepper to the pot; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until noodles are almost tender and soup has thickened, 10-12 minutes.",
      "secondary_message": "1774 ml chicken or vegetable broth\n355 ml whole milk\n1 tbsp Worcestershire sauce\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 450941,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and set remaining parsley aside for serving.",
      "secondary_message": null
    },
    {
      "id": 450942,
      "primary_message": "Pat the steak dry with paper towels and place on a cutting board. Slice in half lengthwise, then cut crosswise (against the grain) into thin strips.",
      "secondary_message": "1.02 kg flank steaks"
    },
    {
      "id": 450943,
      "primary_message": "When the noodles are almost tender, add beef slices to the soup. Continue to cook, stirring occasionally, until beef and noodles are cooked through, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 450944,
      "primary_message": "To serve, divide soup between bowls and top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
