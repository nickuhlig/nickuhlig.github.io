  "instructions": [
    {
      "id": 450828,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb cremini mushrooms\n1 medium carrot\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 450829,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 450830,
      "primary_message": "Peel, trim, and slice carrot crosswise into thin rounds. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 450831,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 450832,
      "primary_message": "While the pan heats up, trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 450833,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until soft, 4-5 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 450834,
      "primary_message": "Meanwhile, use your hands to break the pasta into 2-inch pieces.",
      "secondary_message": "2 oz fettuccine pasta"
    },
    {
      "id": 450835,
      "primary_message": "When the veggies are soft, add flour to the pan. Cook, stirring frequently, for 1 minute.",
      "secondary_message": "2 tsp all-purpose flour"
    },
    {
      "id": 450836,
      "primary_message": "Add pasta, broth, milk, Worcestershire, salt, and pepper to the pan; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until noodles are almost tender and soup has thickened, 10-12 minutes.",
      "secondary_message": "20 fl oz (2 ½ cups) chicken or vegetable broth\n4 fl oz (½ cup) whole milk\n1 tsp Worcestershire sauce\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 450837,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and set remaining parsley aside for serving.",
      "secondary_message": null
    },
    {
      "id": 450838,
      "primary_message": "Pat the steak dry with paper towels and place on a cutting board. Slice in half lengthwise, then cut crosswise (against the grain) into thin strips.",
      "secondary_message": "¾ lb flank steak"
    },
    {
      "id": 450839,
      "primary_message": "When the noodles are almost tender, add beef slices to the soup. Continue to cook, stirring occasionally, until beef and noodles are cooked through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 450840,
      "primary_message": "To serve, divide soup between bowls and top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
