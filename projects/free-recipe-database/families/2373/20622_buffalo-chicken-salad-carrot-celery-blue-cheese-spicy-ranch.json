  "instructions": [
    {
      "id": 346228,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n3 sticks celery\n1 ½ avocados\n3 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 346229,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 346230,
      "primary_message": "Add dressing, hot sauce, salt, and pepper to the bowl with the parsley; stir to combine.",
      "secondary_message": "1 cup ranch dressing\n3 tbsp hot sauce\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 346231,
      "primary_message": "Trim and thinly slice celery crosswise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 346232,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 346233,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces and add to the bowl.",
      "secondary_message": "1 ½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 346234,
      "primary_message": "Add mixed greens and shredded carrots to the bowl; toss to combine the salad.",
      "secondary_message": "1 ½ g shredded carrots"
    },
    {
      "id": 346235,
      "primary_message": "To serve, divide salad between plates or bowls and sprinkle with blue cheese. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    }
  ],
