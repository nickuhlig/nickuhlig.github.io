  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Toast or steam the hot dog buns. Dice the avocado. Dice the white onion. Dice the tomato. Dice the pickled jalapeño peppers. Crush the potato chips.",
      "secondary_message": "8 hot dog buns\n1 avocado\n1 small white onion\n1 large tomato\n3 to 4 pickled jalapeño peppers\n1 small bag potato chips"
    },
    {
      "id": 1,
      "primary_message": "Wrap each hot dog with bacon in a spiral pattern, securing ends of bacon with toothpicks. In a deep fryer, wok, or Dutch oven, heat peanut oil to 350°F. Add hot dogs and cook until bacon is crisp, about 4 minutes. Transfer to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine avocado, onion, tomato, jalapeño, and lime juice in a medium bowl. Season to taste with salt and toss gently to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Top hot dogs with mayonnaise, avocado mixture, crushed chips, and cilantro. Serve immediately.",
      "secondary_message": null
    }
  ],
