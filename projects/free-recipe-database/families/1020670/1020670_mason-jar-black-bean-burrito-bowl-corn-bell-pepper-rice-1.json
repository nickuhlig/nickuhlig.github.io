  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from heat and spread it out on a baking sheet pan to cool, about 15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and juice lime. Divide between two (quart-sized) jars.",
      "secondary_message": "1 lime"
    },
    {
      "primary_message": "Divide guacamole, salsa, chili powder, and salt between the jars with the lime juice.",
      "secondary_message": "⅔ cup guacamole\n⅔ cup salsa\n1 tsp chili powder\n½ tsp salt"
    },
    {
      "primary_message": "Place corn in a colander and rinse under hot water (from the tap) to defrost. Add to the jars.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "primary_message": "Drain and rinse beans in the colander. Add to the jars.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell pepper; medium dice. Add to the jars.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "primary_message": "When the rice is cool, add to the jars, packing lightly if necessary.",
      "secondary_message": null
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge until needed. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, empty jar into a bowl (making sure to scrape out all of the guacamole and salsa!), then stir to combine. Enjoy!",
      "secondary_message": null
    }
  ],
