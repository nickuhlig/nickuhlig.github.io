  "instructions": [
    {
      "id": 372825,
      "primary_message": "Wash and dry mixed greens and raspberries. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 (142 g) pkg spring mix (mixed greens)\n1 (170 g) pkg raspberries"
    },
    {
      "id": 372826,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin cutlets. Season chicken with salt and pepper on both sides.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 372827,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 372828,
      "primary_message": "Once the pan is hot, coat the bottom with oil. Add chicken to the pan and grill, turning once, until cooked through, 3-4 minutes per side.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 372829,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 372830,
      "primary_message": "Using a clean cutting board, roughly chop pecans and add to the bowl with the dressing.",
      "secondary_message": "¼ cup pecan halves"
    },
    {
      "id": 372831,
      "primary_message": "Remove chicken to a cutting board and cut into strips.",
      "secondary_message": null
    },
    {
      "id": 372832,
      "primary_message": "Add chicken, mixed greens, and raspberries to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 372833,
      "primary_message": "To serve, divide salad between plates or bowls, crumble goat cheese over top, and enjoy!",
      "secondary_message": "1 (113 g) log goat cheese"
    }
  ],
