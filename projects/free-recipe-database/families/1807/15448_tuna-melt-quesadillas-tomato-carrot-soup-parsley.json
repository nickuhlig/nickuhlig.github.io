  "instructions": [
    {
      "id": 254256,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 254257,
      "primary_message": "Peel and mince garlic; peel and small dice onions. Place both in a medium bowl.",
      "secondary_message": "6 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 254258,
      "primary_message": "Peel and coarsely grate carrots. Add to the bowl with the garlic and onion.",
      "secondary_message": null
    },
    {
      "id": 254259,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 254260,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add garlic, onion, carrot, and spices to the pot; cook, stirring often, until veggies begin to soften, 4-5 minutes. (Reserve bowl for next step.)",
      "secondary_message": "3 tbsp butter, unsalted\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 254261,
      "primary_message": "Meanwhile, mince capers. Place in the reserved bowl along with mayo, vinegar, cumin, and pepper; stir to combine.",
      "secondary_message": "1 ½ tbsp capers\n⅓ cup mayonnaise\n¾ tsp red wine vinegar\n¾ tsp cumin, ground\n½ tsp black pepper"
    },
    {
      "id": 254262,
      "primary_message": "Add tomatoes, broth, and sugar to the pot; stir to combine and bring to a boil. Once boiling, reduce heat to medium-low, cover, and let simmer until veggies are completely soft, about 8 minutes. Remove from heat.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n36 fl oz (4 ½ cups) chicken or vegetable broth\n1 ½ tsp brown sugar"
    },
    {
      "id": 254263,
      "primary_message": "While the soup is cooking, drain tuna; flake into bite-sized pieces and add to the bowl with the mayo mixture (do not mash).",
      "secondary_message": "3 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 254264,
      "primary_message": "Trim, and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 254265,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for the soup).",
      "secondary_message": null
    },
    {
      "id": 254266,
      "primary_message": "Grate cheese and add to the bowl; gently stir to combine the tuna filling.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 254267,
      "primary_message": "Place tortillas on a flat surface and divide the tuna filling between them. Move the filling onto one half of each tortilla; fold in half to close.",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 254268,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 254269,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, add quesadillas and cook, flipping once, until cheese is melted and tortillas are golden, 1½-2 minutes per side. Remove to a plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 254270,
      "primary_message": "Meanwhile, using a hand (or regular) blender, purée the soup until smooth. Alternatively, use a potato masher to crush the tomatoes (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 254271,
      "primary_message": "Divide soup between bowls and sprinkle with reserved parsley. Serve with quesadillas on the side and enjoy!",
      "secondary_message": null
    }
  ],
