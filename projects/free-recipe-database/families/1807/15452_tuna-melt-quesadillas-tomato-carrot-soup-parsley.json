  "instructions": [
    {
      "id": 254320,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 254321,
      "primary_message": "Peel and mince garlic; peel and small dice onion. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic\n½ medium yellow onion"
    },
    {
      "id": 254322,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 254323,
      "primary_message": "While the pan heats up, peel, and coarsely grate carrots. Add to the bowl with the garlic and onion.",
      "secondary_message": null
    },
    {
      "id": 254324,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add garlic, onion, carrot, and spices to the pan; cook, stirring often, until veggies begin to soften, 3-4 minutes. (Reserve bowl for next step.)",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 254325,
      "primary_message": "Meanwhile, mince capers. Place in the reserved bowl along with mayo, vinegar, cumin, and pepper; stir to combine.",
      "secondary_message": "½ tbsp capers\n2 tbsp mayonnaise\n¼ tsp red wine vinegar\n¼ tsp cumin, ground\n⅛ tsp black pepper"
    },
    {
      "id": 254326,
      "primary_message": "Add tomatoes, broth, and sugar to the pan; stir to combine and bring to a boil. Once boiling, reduce heat to medium-low, cover, and let simmer until veggies are completely soft, 6-8 minutes. Remove from heat.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n355 ml chicken or vegetable broth\n½ tsp brown sugar"
    },
    {
      "id": 254327,
      "primary_message": "While the soup is cooking, drain tuna; flake into bite-sized pieces and add to the bowl with the mayo mixture (do not mash).",
      "secondary_message": "1 (170 g) can chunk light tuna in water"
    },
    {
      "id": 254328,
      "primary_message": "Trim, and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 254329,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl (reserving the rest for the soup).",
      "secondary_message": null
    },
    {
      "id": 254330,
      "primary_message": "Grate cheese and add to the bowl; gently stir to combine the tuna filling.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 254331,
      "primary_message": "Place tortillas on a flat surface and divide the tuna filling between them. Move the filling onto one half of each tortilla; fold in half to close.",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 254332,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 254333,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add quesadillas and cook, flipping once, until cheese is melted and tortillas are golden, 1½-2 minutes per side. Remove to a plate.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 254334,
      "primary_message": "Meanwhile, using a hand (or regular) blender, purée the soup until smooth. Alternatively, use a potato masher to crush the tomatoes (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 254335,
      "primary_message": "Divide soup between bowls and sprinkle with reserved parsley. Serve with quesadillas on the side and enjoy!",
      "secondary_message": null
    }
  ],
