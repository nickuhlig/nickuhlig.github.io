  "instructions": [
    {
      "id": 381823,
      "primary_message": "Wash, dry, peel, and trim carrots; small dice. ",
      "secondary_message": "4 medium carrots"
    },
    {
      "id": 381824,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381825,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the carrot and chicken; cook, breaking the meat apart with a spoon, until just browned, 3-4 minutes. ",
      "secondary_message": "2 tbsp virgin coconut oil\n1 lb ground chicken"
    },
    {
      "id": 381826,
      "primary_message": "Add cornstarch and spices to the pot. Continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "2 tbsp cornstarch\n4 tsp curry powder\n2 tsp garam masala\n1 tsp salt"
    },
    {
      "id": 381827,
      "primary_message": "Add broth and cream to the pot; stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until stew has thickened and chicken is cooked through, 3-4 minutes. ",
      "secondary_message": "40 fl oz (5 cups) chicken or vegetable broth\n8 fl oz (1 cup) heavy whipping cream"
    },
    {
      "id": 381828,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems. Discard stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 381829,
      "primary_message": "When the chicken is done, add cilantro, cauliflower, and spinach to the pot. Stir to combine and return to a simmer over high heat.",
      "secondary_message": "2 (12 oz) bags frozen, riced cauliflower\n1 (16oz) bag frozen chopped spinach"
    },
    {
      "id": 381830,
      "primary_message": "Once simmering, reduce heat to low and continue to cook until veggies are warmed through, 3-4 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 381831,
      "primary_message": "To serve, divide stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
