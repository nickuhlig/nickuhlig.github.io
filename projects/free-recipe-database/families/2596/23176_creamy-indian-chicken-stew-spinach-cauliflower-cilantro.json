  "instructions": [
    {
      "id": 381868,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381869,
      "primary_message": "While the pan heats up, wash, dry, peel, and trim carrots; small dice. ",
      "secondary_message": "2 medium carrots"
    },
    {
      "id": 381870,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add the carrot and chicken; cook, breaking the meat apart with a spoon, until just browned, 3-4 minutes. ",
      "secondary_message": "1 tbsp virgin coconut oil\n0.23 kg ground chicken"
    },
    {
      "id": 381871,
      "primary_message": "Add cornstarch and spices to the pan. Continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "1 tbsp cornstarch\n2 tsp curry powder\n1 tsp garam masala\n½ tsp salt"
    },
    {
      "id": 381872,
      "primary_message": "Add broth and cream to the pan; stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until stew has thickened and chicken is cooked through, 3-4 minutes. ",
      "secondary_message": "591 ml chicken or vegetable broth\n118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 381873,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems. Discard stems and mince the leaves.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 381874,
      "primary_message": "When the chicken is done, add cilantro, cauliflower, and spinach to the pan. Stir to combine and return to a simmer over high heat.",
      "secondary_message": "1 (340 g) bag frozen, riced cauliflower\n½ (454 g) bag frozen chopped spinach"
    },
    {
      "id": 381875,
      "primary_message": "Once simmering, reduce heat to low and continue to cook until veggies are warmed through, 3-4 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 381876,
      "primary_message": "To serve, divide stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
