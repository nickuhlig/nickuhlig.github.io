  "instructions": [
    {
      "id": 381859,
      "primary_message": "Wash, dry, peel, and trim carrots; small dice. ",
      "secondary_message": "6 medium carrots"
    },
    {
      "id": 381860,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381861,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the carrot and veggie ground; cook, breaking the veggie ground apart with a spoon, until just browned, 4-5 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 381862,
      "primary_message": "Add cornstarch and spices to the pot. Continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "3 tbsp cornstarch\n2 tbsp curry powder\n1 tbsp garam masala\n1 ½ tsp salt"
    },
    {
      "id": 381863,
      "primary_message": "Add broth and cream to the pot; stir to combine and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until stew has thickened and veggie ground is cooked through, 4-5 minutes. ",
      "secondary_message": "60 fl oz (7 ½ cups) chicken or vegetable broth\n12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 381864,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems. Discard stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 381865,
      "primary_message": "When the veggie ground is done, add cilantro, cauliflower, and spinach to the pot. Stir to combine and return to a simmer over high heat.",
      "secondary_message": "3 (12 oz) bags frozen, riced cauliflower\n1 ½ (16oz) bags frozen chopped spinach"
    },
    {
      "id": 381866,
      "primary_message": "Once simmering, reduce heat to low and continue to cook until vegetables are warmed through, 4-5 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 381867,
      "primary_message": "To serve, divide stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
