  "instructions": [
    {
      "id": 381886,
      "primary_message": "Wash, dry, peel, and trim carrots; small dice. ",
      "secondary_message": "6 medium carrots"
    },
    {
      "id": 381887,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 381888,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the carrot and chicken; cook, breaking the meat apart with a spoon, until just browned, 4-5 minutes. ",
      "secondary_message": "3 tbsp virgin coconut oil\n0.68 kg ground chicken"
    },
    {
      "id": 381889,
      "primary_message": "Add cornstarch and spices to the pot. Continue to cook, stirring frequently, until fragrant, about 1 minute. ",
      "secondary_message": "3 tbsp cornstarch\n2 tbsp curry powder\n1 tbsp garam masala\n1 ½ tsp salt"
    },
    {
      "id": 381890,
      "primary_message": "Add broth and cream to the pot; stir to combine and bring to a boil. Once boiling, reduce heat to medium and simmer, stirring occasionally, until stew has thickened and chicken is cooked through, 4-5 minutes. ",
      "secondary_message": "1774 ml chicken or vegetable broth\n355 ml heavy whipping cream"
    },
    {
      "id": 381891,
      "primary_message": "Meanwhile, wash, dry, and shave cilantro leaves off the stems. Discard stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 381892,
      "primary_message": "When the chicken is done, add cilantro, cauliflower, and spinach to the pot. Stir to combine and return to a simmer over high heat.",
      "secondary_message": "3 (340 g) bags frozen, riced cauliflower\n1 ½ (454 g) bags frozen chopped spinach"
    },
    {
      "id": 381893,
      "primary_message": "Once simmering, reduce heat to low and continue to cook until veggies are warmed through, 4-5 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 381894,
      "primary_message": "To serve, divide stew between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
