  "instructions": [
    {
      "id": 390077,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 390078,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 390079,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a medium bowl. Stir to combine the pickling liquid. ",
      "secondary_message": "3 tbsp rice vinegar\n2 tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 390080,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n½ English cucumber\n½ bunch radish\n½ lime\n½ small pkg fresh mint\n½ small bunch cilantro\n½ small bunch green onions (scallions)"
    },
    {
      "id": 390081,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 390082,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 390083,
      "primary_message": "Trim and halve radishes lengthwise, then cut crosswise into thin half-moons. Add to the bowl, stir to coat, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 390084,
      "primary_message": "Zest and juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 390085,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Add half of the herbs to the bowl with the lime juice. (Reserve remaining herbs for serving.)",
      "secondary_message": null
    },
    {
      "id": 390086,
      "primary_message": "Add soy sauce, mayo, and chili-garlic sauce to the bowl. Stir to combine the lime-herb sauce and set aside. ",
      "secondary_message": "2 tbsp soy sauce\n1 ½ tbsp mayonnaise\n2 tsp chili-garlic sauce"
    },
    {
      "id": 390087,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 390088,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 390089,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 390090,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onion and garlic; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 390091,
      "primary_message": "Add veggie ground, salt, and pepper to the skillet. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. Once the veggie ground is done, add the lime-herb sauce and stir to combine. Remove from heat.",
      "secondary_message": "8 oz veggie ground, plant based\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 390092,
      "primary_message": "To serve, divide the veggie ground, rice, and pickled veggies between bowls. Top with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
