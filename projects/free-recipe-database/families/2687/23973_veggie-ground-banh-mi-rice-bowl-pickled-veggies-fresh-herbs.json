  "instructions": [
    {
      "id": 390349,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 390350,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 390351,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a large bowl. Stir to combine the pickling liquid. ",
      "secondary_message": "½ cup rice vinegar\n2 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 390352,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n1 ½ English cucumbers\n1 ½ bunches radish\n1 ½ limes\n1 small pkg fresh mint\n2 small bunches cilantro\n1 small bunch green onions (scallions)"
    },
    {
      "id": 390353,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 390354,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 390355,
      "primary_message": "Trim and halve radishes lengthwise, then cut crosswise into thin half-moons. Add to the bowl, stir to coat, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 390356,
      "primary_message": "Zest and juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 390357,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Add half of the herbs to the bowl with the lime juice. (Reserve remaining herbs for serving.)",
      "secondary_message": null
    },
    {
      "id": 390358,
      "primary_message": "Add soy sauce, mayo, and chili-garlic sauce to the bowl. Stir to combine the lime-herb sauce and set aside. ",
      "secondary_message": "⅓ cup soy sauce\n¼ cup mayonnaise\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 390359,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 390360,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 390361,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 390362,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onion and garlic; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 390363,
      "primary_message": "Add veggie ground, salt, and pepper to the skillet. Cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. Once the veggie ground is done, add the lime-herb sauce and stir to combine. Remove from heat.",
      "secondary_message": "680 g veggie ground, plant based\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 390364,
      "primary_message": "To serve, divide the veggie ground, rice, and pickled veggies between bowls. Top with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
