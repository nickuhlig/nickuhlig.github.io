  "instructions": [
    {
      "id": 390045,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 390046,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 390047,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a medium bowl. Stir to combine the pickling liquid. ",
      "secondary_message": "⅓ cup rice vinegar\n4 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 390048,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n1 English cucumber\n1 bunch radish\n1 lime\n1 small pkg fresh mint\n1 small bunch cilantro\n1 small bunch green onions (scallions)"
    },
    {
      "id": 390049,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 390050,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 390051,
      "primary_message": "Trim and halve radishes lengthwise, then cut crosswise into thin half-moons. Add to the bowl, stir to coat, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 390052,
      "primary_message": "Zest and juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 390053,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Add half of the herbs to the bowl with the lime juice. (Reserve remaining herbs for serving.)",
      "secondary_message": null
    },
    {
      "id": 390054,
      "primary_message": "Add fish sauce, mayo, and chili-garlic sauce to the bowl. Stir to combine the lime-herb sauce and set aside. ",
      "secondary_message": "¼ cup fish sauce\n3 tbsp mayonnaise\n4 tsp chili-garlic sauce"
    },
    {
      "id": 390055,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 390056,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 390057,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 390058,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onion and garlic; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 390059,
      "primary_message": "Add turkey, salt, and pepper to the skillet. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Once the turkey is done, add the lime-herb sauce and stir to combine. Remove from heat.",
      "secondary_message": "1 ½ lb ground turkey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 390060,
      "primary_message": "To serve, divide the turkey, rice, and pickled veggies between bowls. Top with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
