  "instructions": [
    {
      "id": 399597,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 399598,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 399599,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; halve crosswise, then slice into thin strips. Place in a large bowl along with the butternut squash and edamame.",
      "secondary_message": "2 red bell peppers\n2 yellow bell peppers\n4 cup frozen butternut squash, pieces\n3 cups edamame"
    },
    {
      "id": 399600,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 399601,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the bell pepper, squash, and edamame.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 399602,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add edamame and veggies, then cover with a lid; cook, stirring occasionally, until just tender, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 399603,
      "primary_message": "Add stir-fry sauce to the skillet. Continue to cook, stirring occasionally, until sauce is warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "½ cup stir-fry sauce"
    },
    {
      "id": 399604,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
