  "instructions": [
    {
      "id": 399580,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 399581,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 399582,
      "primary_message": "Meanwhile, place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a large bowl, and set aside.",
      "secondary_message": "1 ½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 399583,
      "primary_message": "Wash and dry bell peppers. Using a clean cutting board, trim, seed, and halve crosswise; slice each half into thin strips. Place in another large bowl along with the butternut squash.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers\n6 cup frozen butternut squash, pieces"
    },
    {
      "id": 399584,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 399585,
      "primary_message": "While the pot heats up, peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the bell pepper and squash.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 399586,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, cover with a lid, and cook, stirring occasionally, until just tender, 5-6 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 399587,
      "primary_message": "When the veggies are done, add chicken and stir-fry sauce to the pot. Continue to cook, stirring occasionally, until chicken and sauce are warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "¾ cup stir-fry sauce"
    },
    {
      "id": 399588,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
