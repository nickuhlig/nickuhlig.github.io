  "instructions": [
    {
      "id": 1,
      "primary_message": "Over medium heat, melt two tablespoons of the butter in a saucepan. Toss in the onion and cook until soft but not browned.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Toss in the remaining butter and then add the mushrooms. Cook for 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour in the chicken stock, add the parsley, and bring to a boil. When bubbling, reduce to a simmer and cook for an hour.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour soup into a blender (you might need to do this in stages), and process until smooth. Return to the saucepan and bring to a simmer. Pour in the sherry, and season with salt and pepper.",
      "secondary_message": null
    }
  ],
