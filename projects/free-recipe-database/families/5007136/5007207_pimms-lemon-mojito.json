  "instructions": [
    {
      "id": 1,
      "primary_message": "Place lemon half, and sugar into cocktail shaker. Muddle to release lemon juice and oil. Add mint leaves and muddle gently, do not grind. Add Pimm's and fill shaker with ice.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Shake until well chilled, about 15 seconds. Pour into Collins glass unstrained. Top with club soda and garnish with mint.",
      "secondary_message": null
    }
