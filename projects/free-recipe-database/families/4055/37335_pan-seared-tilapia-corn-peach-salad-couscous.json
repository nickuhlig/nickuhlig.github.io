  "instructions": [
    {
      "id": 584989,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 584990,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n6 peaches\n1 small bunch cilantro"
    },
    {
      "id": 584991,
      "primary_message": "Place oil, vinegar, honey, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tbsp honey\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 584992,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584993,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584994,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584995,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 584996,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to thaw. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 584997,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584998,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "1.02 kg tilapia fillet\n1 ½ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 584999,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working batches if necessary, add the tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes. Transfer to a clean plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 585000,
      "primary_message": "Divide tilapia and couscous between plates; top tilapia with a small portion of salad. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
