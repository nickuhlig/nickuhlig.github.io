  "instructions": [
    {
      "id": 584952,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 584953,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 584954,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n6 peaches\n1 small bunch cilantro"
    },
    {
      "id": 584955,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tbsp pure maple syrup\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 584956,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584957,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584958,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584959,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 584960,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to thaw. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 584961,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584962,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise. Place on a plate, then sprinkle with cornstarch and spices on both sides.",
      "secondary_message": "3 tbsp cornstarch\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 584963,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the tofu and cook until golden, 2-3 minutes per side. Return to the plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 584964,
      "primary_message": "Divide tofu and couscous between plates; top tofu with a small portion of salad. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
