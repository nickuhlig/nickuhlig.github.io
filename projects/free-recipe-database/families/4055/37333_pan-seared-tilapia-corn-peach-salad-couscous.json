  "instructions": [
    {
      "id": 584965,
      "primary_message": "In a small saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 584966,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small pkg grape tomatoes\n2 peaches\n½ small bunch cilantro"
    },
    {
      "id": 584967,
      "primary_message": "Place oil, vinegar, honey, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 584968,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584969,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584970,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584971,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 584972,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to thaw. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 584973,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584974,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "⅓ kg tilapia fillet\n½ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 584975,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 584976,
      "primary_message": "Divide tilapia and couscous between plates; top tilapia with a small portion of salad. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
