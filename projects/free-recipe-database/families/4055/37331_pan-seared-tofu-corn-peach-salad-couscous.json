  "instructions": [
    {
      "id": 584939,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 584940,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 584941,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n4 peaches\n1 small bunch cilantro"
    },
    {
      "id": 584942,
      "primary_message": "Place oil, vinegar, maple syrup, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n4 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 584943,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 584944,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584945,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 584946,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 584947,
      "primary_message": "Place corn in the colander and rinse under hot water (from the tap) to thaw. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 584948,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 584949,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise. Place on a plate, then sprinkle with cornstarch and spices on both sides.",
      "secondary_message": "2 tbsp cornstarch\n1 tsp smoked paprika\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 584950,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu and cook until golden, 2-3 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 584951,
      "primary_message": "Divide tofu and couscous between plates; top tofu with a small portion of salad. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
