  "instructions": [
    {
      "id": 152747,
      "primary_message": "If using wooden skewers, place 12 skewers in a shallow dish of water to soak until you are ready to use them. ",
      "secondary_message": null
    },
    {
      "id": 152748,
      "primary_message": "Peel and mince the garlic; transfer to a large bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 152749,
      "primary_message": "Peel the onions. Thinly slice half of the onions and add to the bowl with the garlic. Mince remaining onions and place in a separate, large bowl. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 152750,
      "primary_message": "Add vinegar and salt to the bowl with the thinly sliced onions and garlic; stir to combine, then set aside to marinate.",
      "secondary_message": "⅓ cup red wine vinegar\n¾ tsp salt"
    },
    {
      "id": 152751,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ English cucumbers\n6 tomatoes"
    },
    {
      "id": 152752,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add half of the parsley to the bowl with the marinating onions. ",
      "secondary_message": null
    },
    {
      "id": 152753,
      "primary_message": "Add remaining parsley, ground beef, and spices to the bowl with the minced onion; mix with your hands until well combined.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp salt\n1 ½ tsp cumin\n¾ tsp cinnamon\n½ tsp cayenne pepper\n½ tsp black pepper"
    },
    {
      "id": 152754,
      "primary_message": "Using a ¼ cup measure, form the beef mixture into 24 short, sausage-like shapes, approximately 3-inches long; thread 2 onto each skewer. (Alternatively, you can cook directly on the grill/skillet without using skewers.) ",
      "secondary_message": null
    },
    {
      "id": 152755,
      "primary_message": "Place kabobs closely together on a large baking sheet pan. Drizzle oil over the kabobs, then rotate the kabobs to coat in a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 152756,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152757,
      "primary_message": "Meanwhile, combine yogurt, paprika, and salt in a medium bowl and whisk to combine; set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 ½ tsp paprika\n½ tsp salt"
    },
    {
      "id": 152758,
      "primary_message": "Coat the grill or skillet with oil. Cooking in batches if necessary, place kabobs on the grill, rotating every 2½-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a plate and loosely cover with foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 152759,
      "primary_message": "Peel and medium dice the cucumbers; medium dice the tomatoes. Add both to the bowl with the marinated onions. ",
      "secondary_message": null
    },
    {
      "id": 152760,
      "primary_message": "Add oil, salt, and pepper to the bowl with the tomato and cucumber; stir to combine the salad. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 152761,
      "primary_message": "To serve, divide salad and kabobs between plates. Enjoy with paprika yogurt on the side! ",
      "secondary_message": null
    }
  ],
