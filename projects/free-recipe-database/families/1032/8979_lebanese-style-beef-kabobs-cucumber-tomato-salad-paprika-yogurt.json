  "instructions": [
    {
      "id": 152732,
      "primary_message": "If using wooden skewers, place 8 skewers in a shallow dish of water to soak until you are ready to use them. ",
      "secondary_message": null
    },
    {
      "id": 152733,
      "primary_message": "Peel and mince the garlic; transfer to a large bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 152734,
      "primary_message": "Peel the onion. Thinly slice half of the onion and add to the bowl with the garlic. Mince remaining onion and place in a separate, large bowl. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 152735,
      "primary_message": "Add vinegar and salt to the bowl with the thinly sliced onion and garlic; stir to combine, then set aside to marinate.",
      "secondary_message": "¼ cup red wine vinegar\n½ tsp salt"
    },
    {
      "id": 152736,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 English cucumber\n4 tomatoes"
    },
    {
      "id": 152737,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add half of the parsley to the bowl with the marinating onions. ",
      "secondary_message": null
    },
    {
      "id": 152738,
      "primary_message": "Add remaining parsley, ground beef, and spices to the bowl with the minced onion; mix with your hands until well combined.",
      "secondary_message": "0.68 kg lean ground beef\n1 tsp salt\n1 tsp cumin\n½ tsp cinnamon\n¼ tsp cayenne pepper\n¼ tsp black pepper"
    },
    {
      "id": 152739,
      "primary_message": "Using a ¼ cup measure, form the beef mixture into 16 short, sausage-like shapes, approximately 3-inches long; thread 2 onto each skewer. (Alternatively, you can cook directly on the grill/skillet without using skewers.) ",
      "secondary_message": null
    },
    {
      "id": 152740,
      "primary_message": "Place kabobs closely together on a baking sheet pan. Drizzle oil over the kabobs, then rotate the kabobs to coat in a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 152741,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152742,
      "primary_message": "Meanwhile, combine yogurt, paprika, and salt in a small bowl and whisk to combine; set aside. ",
      "secondary_message": "1 cup plain Greek yogurt\n1 tsp paprika\n¼ tsp salt"
    },
    {
      "id": 152743,
      "primary_message": "Coat the grill or skillet with oil. Cooking in batches if necessary, place kabobs on the grill, rotating every 2½-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a plate and loosely cover with foil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 152744,
      "primary_message": "Peel and medium dice the cucumber; medium dice the tomatoes. Add both to the bowl with the marinated onions. ",
      "secondary_message": null
    },
    {
      "id": 152745,
      "primary_message": "Add oil, salt, and pepper to the bowl with the tomato and cucumber; stir to combine the salad. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 152746,
      "primary_message": "To serve, divide salad and kabobs between plates. Enjoy with paprika yogurt on the side! ",
      "secondary_message": null
    }
  ],
