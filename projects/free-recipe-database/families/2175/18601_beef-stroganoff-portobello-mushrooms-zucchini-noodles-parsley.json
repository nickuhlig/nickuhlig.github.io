  "instructions": [
    {
      "id": 304783,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "6 medium zucchini squash\n6 caps portobello mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 304784,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a large bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 304785,
      "primary_message": "Peel, halve, and thinly slice shallots; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 304786,
      "primary_message": "Cut mushrooms in half, then slice crosswise into ¼-inch thick pieces; add to the bowl with the shallot and garlic. Set aside.",
      "secondary_message": null
    },
    {
      "id": 304787,
      "primary_message": "Pat steak dry with paper towels, then slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 304788,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304789,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add steak strips and cook, stirring occasionally, until just cooked through, 3-4 minutes. Using tongs, transfer steak to a plate and cover with foil. (Reserve pot with cooking juices for the next step.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 304790,
      "primary_message": "Return the pot to medium heat, add more butter, and swirl to coat the bottom. Add shallot, garlic, and mushrooms to the pot; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 304791,
      "primary_message": "Meanwhile, using a clean cutting board, cut cream cheese into small pieces. ",
      "secondary_message": "¾ (8 oz) block cream cheese"
    },
    {
      "id": 304792,
      "primary_message": "Once the veggies are soft, add cream cheese, broth, Dijon, and spices to the pot; stir to combine and bring the sauce to a simmer over medium-high heat. Once simmering, reduce heat to low and continue to cook, stirring occasionally, until sauce thickens, 5-6 minutes. ",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n2 tbsp Dijon mustard\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 304793,
      "primary_message": "While the sauce simmers, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 304794,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add zucchini and water. Cook, stirring frequently, until just tender, 3-4 minutes. Remove from heat.",
      "secondary_message": "1 tbsp butter, unsalted\n¾ cup water"
    },
    {
      "id": 304795,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 304796,
      "primary_message": "When the sauce is done, return steak (and any accumulated juices) to the pot; add parsley and stir to combine the beef stroganoff. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 304797,
      "primary_message": "To serve, divide zucchini noodles and beef stroganoff between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
