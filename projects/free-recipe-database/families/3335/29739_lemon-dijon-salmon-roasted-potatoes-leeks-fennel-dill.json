  "instructions": [
    {
      "id": 473941,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 473942,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 fennel bulbs\n6 leeks\n0.68 kg new potatoes\n3 lemons\n1 small bunch fresh dill"
    },
    {
      "id": 473943,
      "primary_message": "Trim off root end and dark green stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into ½-inch thick wedges. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 473944,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half crosswise, then slice each half lengthwise; rinse under running water, separating the layers to remove any dirt and grit. Add to the bowl with the fennel.",
      "secondary_message": null
    },
    {
      "id": 473945,
      "primary_message": "Quarter potatoes. Add to the bowl along with oil, salt, and pepper, then stir to combine. Divide veggies between two large baking sheet pans and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 473946,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the veggies are tender and golden, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 473947,
      "primary_message": "Meanwhile, zest and juice lemons into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 473948,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the lemon along with oil, Dijon, salt, and pepper. Stir to combine the dressing and set aside. (Reserve remaining dill for serving.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 473949,
      "primary_message": "When the veggies have about 10 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 473950,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate. Season with salt on the top-side.",
      "secondary_message": "1.02 kg salmon fillet\n½ tsp salt"
    },
    {
      "id": 473951,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook until skin is crispy and flesh is opaque, 3-4 minutes per side. Remove to a clean plate and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 473952,
      "primary_message": "To serve, divide salmon and veggies between plates. Drizzle with dressing and top with reserved dill. Enjoy!",
      "secondary_message": null
    }
  ],
