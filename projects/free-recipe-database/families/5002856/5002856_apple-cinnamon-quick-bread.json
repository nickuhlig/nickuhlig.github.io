  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the core from the chopped Granny Smith apples.",
      "secondary_message": "1 ½ cups chopped Granny Smith apples, with peel, seeds"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Butter an 5- by 10-inch loaf pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, baking soda, baking powder, cinnamon, ginger, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat eggs for 30 seconds with a fork. Add vanilla, 1/2 cup sugar, and brown sugar to the bowl. Stir until well combined. Whisk in vegetable oil.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add flour mixture to wet ingredients in two additions, mixing until just combined. Stir apples into batter until evenly distributed.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour batter into prepared loaf pan and sprinkle with remaining one tablespoon sugar. Bake bread until golden and a cake tester comes out clean, about 40 minutes.",
      "secondary_message": null
    }
  ],
