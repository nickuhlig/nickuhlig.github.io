  "instructions": [
    {
      "id": 1,
      "primary_message": "Place coconut in wok over medium heat and dry-fry until golden brown. Cool slightly before grinding finely in mortar and pestle, or in food processor.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Snip chiles into 2.5-cm lengths. Soak in hot water until softened. Discard half the seeds and place the chiles in electric blender jug with shallots, garlic, ginger, galangal, turmeric and lemongrass. If you want a hotter rendang, add bird chiles. Add 1/2 cup water and grind to a paste- but not too finely.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place spice paste, beef, coconut milk, and water in a roomy wok. Bring to a boil and simmer on medium heat, stirring now and then until mixture is well reduced and thick and oil surfaces—at least 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add ground toasted coconut, turmeric leaf (if using), makrut lime leaf, salt, sugar, and asam keping (if using). Cook another 5-10 minutes, taste, and adjust seasonings if necessary. Take pan off heat. Serve with rice.",
      "secondary_message": null
    }
  ],
