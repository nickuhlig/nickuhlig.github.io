  "instructions": [
    {
      "id": 446439,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 446440,
      "primary_message": "Place flour, baking powder, and spices in a small bowl; stir to combine.",
      "secondary_message": "2 tbsp all-purpose flour\n1 tsp baking powder\n½ tsp garlic powder\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 446441,
      "primary_message": "Pat chicken dry with paper towels and place in a medium bowl. Drizzle with oil and turn to coat.",
      "secondary_message": "0.57 kg chicken drumsticks\n1 tbsp neutral vegetable oil"
    },
    {
      "id": 446442,
      "primary_message": "Add spice mixture to the bowl with the chicken, toss, then press to adhere coating. Transfer chicken to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 446443,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until coating is crispy and chicken is cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 446444,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a clean medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 tbsp white wine vinegar\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 446445,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the dressing; set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 446446,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n½ English cucumber\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 446447,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 446448,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 446449,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 446450,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
