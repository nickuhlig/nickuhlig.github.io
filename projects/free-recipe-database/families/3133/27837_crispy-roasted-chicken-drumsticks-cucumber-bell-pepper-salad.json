  "instructions": [
    {
      "id": 446463,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 446464,
      "primary_message": "Place flour, baking powder, and spices in a small bowl; stir to combine.",
      "secondary_message": "⅓ cup all-purpose flour\n1 tbsp baking powder\n1 ½ tsp garlic powder\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 446465,
      "primary_message": "Pat chicken dry with paper towels and place in a large bowl. Drizzle with oil and turn to coat.",
      "secondary_message": "1.7 kg chicken drumsticks\n3 tbsp neutral vegetable oil"
    },
    {
      "id": 446466,
      "primary_message": "Add spice mixture to the bowl with the chicken, toss, then press to adhere coating. Transfer chicken to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 446467,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway through, until coating is crispy and chicken is cooked through, about 30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 446468,
      "primary_message": "Meanwhile, place oil, vinegar, honey, salt, and pepper in a clean large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp neutral vegetable oil\n3 tbsp white wine vinegar\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 446469,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the dressing; set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 446470,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n1 ½ English cucumbers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 446471,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 446472,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 446473,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 446474,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
