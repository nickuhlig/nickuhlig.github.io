  "instructions": [
    {
      "id": 450291,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n½ head butter (Boston) lettuce\n1 tomato"
    },
    {
      "id": 450292,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450293,
      "primary_message": "While the skillet heats up, trim, seed, and small dice bell pepper.",
      "secondary_message": null
    },
    {
      "id": 450294,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n¼ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 450295,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 450296,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide veggie ground and bell pepper between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 450297,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat.",
      "secondary_message": null
    },
    {
      "id": 450298,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place assembled quesadillas in the skillet and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 450299,
      "primary_message": "Meanwhile, chop lettuce crosswise into thin (shred-like) strips. Transfer to another plate.",
      "secondary_message": null
    },
    {
      "id": 450300,
      "primary_message": "Small dice tomato. Add to plate with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 450301,
      "primary_message": "To serve, cut each quesadilla into wedges and divide between plates; top with lettuce and tomatoes. Enjoy!",
      "secondary_message": null
    }
  ],
