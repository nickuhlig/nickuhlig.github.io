  "instructions": [
    {
      "id": 450346,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n1 ½ heads butter (Boston) lettuce\n3 tomatoes"
    },
    {
      "id": 450347,
      "primary_message": "Trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 450348,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450349,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, pork, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n0.68 kg ground pork sausage\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 450350,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 450351,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide pork and bell pepper between them, arranging on one half of each tortilla. Top with cheese and fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 450352,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 450353,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 450354,
      "primary_message": "Meanwhile, chop lettuce crosswise into thin (shred-like) strips. Transfer to another plate.",
      "secondary_message": null
    },
    {
      "id": 450355,
      "primary_message": "Small dice tomatoes. Add to plate with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 450356,
      "primary_message": "To serve, cut each quesadilla into wedges and divide between plates; top with lettuce and tomatoes. Enjoy!",
      "secondary_message": null
    }
  ],
