  "instructions": [
    {
      "id": 346512,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 346513,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 medium zucchini squash\n1 ½ oranges\n1 small pkg fresh mint\n1 ½ avocados"
    },
    {
      "id": 346514,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then halve crosswise; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 346515,
      "primary_message": "Trim zucchini and quarter lengthwise, then halve crosswise; add to the bowl with the carrot. ",
      "secondary_message": null
    },
    {
      "id": 346516,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346517,
      "primary_message": "While the pan heats up, drizzle veggies with oil, season with spices, and toss to coat. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 346518,
      "primary_message": "Once the pan is hot, working in batches if necessary, add the veggies and grill, turning occasionally, until lightly charred and fork-tender, 6-8 minutes. Transfer to a plate and let cool, 5 minutes. (Reserve bowl for the next step.) ",
      "secondary_message": null
    },
    {
      "id": 346519,
      "primary_message": "Meanwhile, zest and juice oranges into the reserved bowl; add oil, Dijon, honey, and spices. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 ½ tsp honey\n1 ½ tsp cumin, ground\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 346520,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 346521,
      "primary_message": "Roughly chop pistachios and add to the bowl; set aside. ",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 346522,
      "primary_message": "Just before serving, halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl, along with the grilled veggies, and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 346523,
      "primary_message": "To serve, divide couscous and grilled veggie salad between plates or bowls; top with ricotta and drizzle with remaining dressing from the bowl. Enjoy! ",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese"
    }
  ],
