  "instructions": [
    {
      "id": 346500,
      "primary_message": "In a medium saucepan, bring broth to a boil. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 346501,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 medium zucchini squash\n1 orange\n1 small pkg fresh mint\n1 avocado"
    },
    {
      "id": 346502,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then halve crosswise; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 346503,
      "primary_message": "Trim zucchini and quarter lengthwise, then halve crosswise; add to the bowl with the carrot. ",
      "secondary_message": null
    },
    {
      "id": 346504,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346505,
      "primary_message": "While the pan heats up, drizzle veggies with oil, season with spices, and toss to coat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 346506,
      "primary_message": "Once the pan is hot, add the veggies and grill, turning occasionally, until lightly charred and fork-tender, 6-8 minutes. Transfer to a plate and let cool, 5 minutes. (Reserve bowl for the next step.) ",
      "secondary_message": null
    },
    {
      "id": 346507,
      "primary_message": "Meanwhile, zest and juice orange into the reserved bowl; add oil, Dijon, honey, and spices. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp honey\n1 tsp cumin, ground\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 346508,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 346509,
      "primary_message": "Roughly chop pistachios and add to the bowl; set aside. ",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 346510,
      "primary_message": "Just before serving, halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl, along with the grilled veggies, and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 346511,
      "primary_message": "To serve, divide couscous and grilled veggie salad between plates or bowls; top with ricotta and drizzle with remaining dressing from the bowl. Enjoy! ",
      "secondary_message": "1 (15 oz) pkg ricotta cheese"
    }
  ],
