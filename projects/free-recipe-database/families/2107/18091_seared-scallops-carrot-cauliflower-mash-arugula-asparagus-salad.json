  "instructions": [
    {
      "id": 293593,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n6 medium carrots\n3 small bunches asparagus\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 293594,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem; separate into bite-sized florets, and cut the thick stems into smaller pieces. Transfer to a large pot.",
      "secondary_message": null
    },
    {
      "id": 293595,
      "primary_message": "Trim, peel, and medium dice carrots; add to the pot with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 293596,
      "primary_message": "Cover the cauliflower and carrots with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until veggies are soft, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 293597,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 ½ tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 293598,
      "primary_message": "Snap or cut off the woody ends of the asparagus, then cut spears into ¼-inch thick pieces. Add to the bowl with the dressing, toss to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 293599,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 293600,
      "primary_message": "While the skillet heats up, pat scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg sea scallops\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 293601,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add scallops to the skillet in a single layer and cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a clean plate and loosely cover with foil. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 293602,
      "primary_message": "When the veggies are done, drain in a colander and return to the pot. Add cream, salt, and pepper; using a potato masher, mash until semi-smooth.",
      "secondary_message": "355 ml heavy whipping cream\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 293603,
      "primary_message": "Add arugula and almonds to the bowl with the dressing and asparagus; toss to combine the salad. ",
      "secondary_message": "⅓ cup almonds, sliced"
    },
    {
      "id": 293604,
      "primary_message": "To serve, divide carrot-cauliflower mash, scallops, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
