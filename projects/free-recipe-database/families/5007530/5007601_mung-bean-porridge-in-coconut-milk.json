  "instructions": [
    {
      "id": 1,
      "primary_message": "Rinse the mung beans in a few changes of cold water, picking through them to remove any stones or grit. Place the beans in a saucepan along with the water, cinnamon stick, and ginger. Bring to a boil, then reduce to a simmer and cook for 40 minutes, until the beans have cracked open a bit but are not mushy.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the sugar, salt, and vanilla extract. Continue to simmer until the sugar is dissolved, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in the coconut milk. Cook until the coconut milk is just heated through, about 2 minutes. Take care not to simmer for too long, or else the milk will thicken too much. Remove the ginger and cinnamon stick from the pot. Ladle the porridge into bowls and serve warm.",
      "secondary_message": null
    }
  ],
