  "instructions": [
    {
      "id": 458461,
      "primary_message": "Peel, halve, and small dice onions. ",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 458462,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 458463,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until onion is soft, 7-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 458464,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 458465,
      "primary_message": "Peel and thinly slice garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 458466,
      "primary_message": "When the onions are soft, add garlic and crushed red pepper to the pot. Cook, stirring occasionally, until fragrant, 1-2 minutes.",
      "secondary_message": "¾ tsp crushed red pepper"
    },
    {
      "id": 458467,
      "primary_message": "Add beans, tomatoes, and broth to the pot. Bring the soup to a boil over medium-high heat. Once boiling, reduce heat to medium and simmer until slightly thickened, 5-7 minutes. ",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n60 fl oz (7 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 458468,
      "primary_message": "Meanwhile, wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. ",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 458469,
      "primary_message": "When the soup is slightly thickened, add orzo. Continue to cook, stirring occasionally, until pasta is almost tender, 5-6 minutes more.",
      "secondary_message": "9 oz orzo pasta"
    },
    {
      "id": 458470,
      "primary_message": "When the orzo is almost done, add kale to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Cook, stirring occasionally, until the kale and orzo are tender, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 458471,
      "primary_message": "To serve, divide soup between bowls and drizzle with oil. Enjoy!",
      "secondary_message": "3 tbsp extra virgin olive oil"
    }
  ],
