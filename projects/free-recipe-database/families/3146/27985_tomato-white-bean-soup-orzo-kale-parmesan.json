  "instructions": [
    {
      "id": 458472,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 458473,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 458474,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until onion is soft, 5-7 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 458475,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 458476,
      "primary_message": "Peel and thinly slice garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 458477,
      "primary_message": "When the onions are soft, add garlic and crushed red pepper to the pan. Cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 458478,
      "primary_message": "Add beans, tomatoes, and broth to the pan. Bring the soup to a boil over medium-high heat. Once boiling, reduce heat to medium and simmer until slightly thickened, about 5 minutes. ",
      "secondary_message": "1 (398 ml) can diced tomatoes\n591 ml chicken or vegetable broth"
    },
    {
      "id": 458479,
      "primary_message": "Meanwhile, wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Place in a medium bowl and set aside. ",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 458480,
      "primary_message": "When the soup is slightly thickened, add orzo. Continue to cook, stirring occasionally, until pasta is almost tender, 5-6 minutes more.",
      "secondary_message": "85 g orzo pasta"
    },
    {
      "id": 458481,
      "primary_message": "While the soup is cooking, finely grate Parmesan.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 458482,
      "primary_message": "When the orzo is almost done, add kale to the pan in handfuls, waiting for it to wilt slightly before adding the next handful. Cook, stirring occasionally, until the kale and orzo are tender, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 458483,
      "primary_message": "Add vinegar and half of the Parmesan to the soup, then stir to combine. (Reserve remaining Parmesan for serving.)",
      "secondary_message": "1 tsp balsamic vinegar"
    },
    {
      "id": 458484,
      "primary_message": "To serve, divide soup between bowls. Top with reserved Parmesan and drizzle with oil. Enjoy!",
      "secondary_message": "1 tbsp extra virgin olive oil"
    }
  ],
