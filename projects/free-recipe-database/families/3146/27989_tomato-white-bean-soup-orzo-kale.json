  "instructions": [
    {
      "id": 458522,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 458523,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. ",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 458524,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until onion is soft, 5-7 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 458525,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 458526,
      "primary_message": "Peel and thinly slice garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 458527,
      "primary_message": "When the onions are soft, add garlic and crushed red pepper to the pot. Cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "½ tsp crushed red pepper"
    },
    {
      "id": 458528,
      "primary_message": "Add beans, tomatoes, and broth to the pot. Bring the soup to a boil over medium-high heat. Once boiling, reduce heat to medium and simmer until slightly thickened, about 5 minutes. ",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n1183 ml chicken or vegetable broth"
    },
    {
      "id": 458529,
      "primary_message": "Meanwhile, wash, dry, and fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. ",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 458530,
      "primary_message": "When the soup is slightly thickened, add orzo. Continue to cook, stirring occasionally, until pasta is almost tender, 5-6 minutes more.",
      "secondary_message": "170 g orzo pasta"
    },
    {
      "id": 458531,
      "primary_message": "When the orzo is almost done, add kale to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Cook, stirring occasionally, until the kale and orzo are tender, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 458532,
      "primary_message": "To serve, divide soup between bowls and drizzle with oil. Enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil"
    }
  ],
