  "instructions": [
    {
      "id": 384215,
      "primary_message": "Fill a large pot with water, cover, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "id": 384216,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb green beans\n½ pint grape tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 384217,
      "primary_message": "Trim and discard the ends of the green beans, then cut into 2-inch pieces; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 384218,
      "primary_message": "Once the water in the pot is boiling, uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, 8-10 minutes. Add green beans to the pot and cook 2-3 minutes more. Drain and rinse under cold water; set aside to cool. ",
      "secondary_message": "5 oz penne pasta\n1 tsp salt"
    },
    {
      "id": 384219,
      "primary_message": "Meanwhile, preheat a cast iron skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384220,
      "primary_message": "Pat the salmon fillets dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb salmon fillet\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 384221,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place salmon, skin-side down, in the pan; cook until opaque and cooked through, 3-5 minutes per side. Once done, transfer to a plate to cool. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 384222,
      "primary_message": "Combine oil, vinegar, Dijon, salt, and pepper in a salad bowl; whisk to combine. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp Dijon mustard\n⅛ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 384223,
      "primary_message": "Peel and mince garlic. Roughly chop capers and olives. Transfer everything to the salad bowl; stir to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 tbsp capers\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 384224,
      "primary_message": "Halve the grape tomatoes crosswise. Peel and thinly slice onion into half rings; add both to the bowl with the dressing. ",
      "secondary_message": "¼ medium red onion"
    },
    {
      "id": 384225,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves; add to the bowl (reserving a small handful for garnish). ",
      "secondary_message": null
    },
    {
      "id": 384226,
      "primary_message": "Remove skin from the salmon, then using a fork or your hands, flake into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 384227,
      "primary_message": "Add salmon, pasta, and green beans to the bowl; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 384228,
      "primary_message": "To serve, divide pasta salad between dishes and garnish with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
