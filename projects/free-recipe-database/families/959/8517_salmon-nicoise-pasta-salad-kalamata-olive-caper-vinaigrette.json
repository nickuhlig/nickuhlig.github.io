  "instructions": [
    {
      "id": 384393,
      "primary_message": "Fill a large pot with water, cover, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "id": 384394,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg green beans\n1 ½ small pkgs grape tomatoes\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 384395,
      "primary_message": "Trim and discard the ends of the green beans, then cut into 2-inch pieces; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 384396,
      "primary_message": "Once the water in the pot is boiling, uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, 8-10 minutes. Add green beans to the pot and cook 2-3 minutes more. Drain and rinse under cold water; set aside to cool. ",
      "secondary_message": "425 g penne pasta\n1 tbsp salt"
    },
    {
      "id": 384397,
      "primary_message": "Meanwhile, preheat a large cast iron skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384398,
      "primary_message": "Pat the salmon fillets dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg salmon fillet\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 384399,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, place salmon, skin-side down, in the pan; cook until opaque and cooked through, 3-5 minutes per side. Once done, transfer to a plate to cool. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 384400,
      "primary_message": "Combine oil, vinegar, Dijon, salt, and pepper in a salad bowl; whisk to combine. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅓ cup red wine vinegar\n1 ½ tsp Dijon mustard\n½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 384401,
      "primary_message": "Peel and mince garlic. Roughly chop capers and olives. Transfer everything to the salad bowl; stir to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp capers\n¾ cup Kalamata olives, pitted"
    },
    {
      "id": 384402,
      "primary_message": "Halve the grape tomatoes crosswise. Peel and thinly slice onion into half rings; add both to the bowl with the dressing. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 384403,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves; add to the bowl (reserving a handful for garnish). ",
      "secondary_message": null
    },
    {
      "id": 384404,
      "primary_message": "Remove skin from the salmon, then using a fork or your hands, flake into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 384405,
      "primary_message": "Add salmon, pasta, and green beans to the bowl; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 384406,
      "primary_message": "To serve, divide pasta salad between dishes and garnish with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
