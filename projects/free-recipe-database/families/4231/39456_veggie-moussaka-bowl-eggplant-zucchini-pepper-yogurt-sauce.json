  "instructions": [
    {
      "id": 612901,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 612902,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 medium zucchini squash\n1 red bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 612903,
      "primary_message": "Trim and halve eggplant lengthwise, then cut crosswise into ½-inch thick half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 612904,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ½-inch thick half-moons. Add to the bowl with the eggplant.",
      "secondary_message": null
    },
    {
      "id": 612905,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl, along with mayo and spices, then stir to combine. Transfer veggies to a baking sheet pan and spread out in an even layer.",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 612906,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 612907,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 612908,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 612909,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 612910,
      "primary_message": "Add water and tomato paste to the skillet, then stir to combine. Continue to cook, stirring frequently, until sauce is slightly thickened, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "⅓ cup water\n2 tbsp tomato paste"
    },
    {
      "id": 612911,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, salt, and pepper in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 612912,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 612913,
      "primary_message": "When the veggies are done, remove from the oven. Add parsley to the baking sheet and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 612914,
      "primary_message": "To serve, divide eggplant, zucchini, peppers, and sautéed veggie ground between bowls. Drizzle with yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
