  "instructions": [
    {
      "id": 612789,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 612790,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n2 medium zucchini squash\n2 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 612791,
      "primary_message": "Trim and halve eggplants lengthwise, then cut crosswise into ½-inch thick half-moons. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 612792,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ½-inch thick half-moons. Add to the bowl with the eggplant.",
      "secondary_message": null
    },
    {
      "id": 612793,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl, along with mayo and spices, then stir to combine. Transfer veggies to a large baking sheet pan and spread out in an even layer.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 612794,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are fork-tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 612795,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 612796,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 612797,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, beef, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ lb lean ground beef\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper\n¼ tsp cinnamon, ground"
    },
    {
      "id": 612798,
      "primary_message": "Add water and tomato paste to the skillet, then stir to combine. Continue to cook, stirring frequently, until sauce is slightly thickened, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "⅔ cup water\n4 tbsp tomato paste"
    },
    {
      "id": 612799,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, salt, and pepper in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 612800,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 612801,
      "primary_message": "When the veggies are done, remove from the oven. Add parsley to the baking sheet and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 612802,
      "primary_message": "To serve, divide roasted veggies and beef between bowls. Drizzle with yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
