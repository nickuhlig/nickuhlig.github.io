  "instructions": [
    {
      "id": 612803,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 612804,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 medium zucchini squash\n3 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 612805,
      "primary_message": "Trim and halve eggplants lengthwise, then cut crosswise into ½-inch thick half-moons. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 612806,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ½-inch thick half-moons. Add to the bowl with the eggplant.",
      "secondary_message": null
    },
    {
      "id": 612807,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl, along with mayo and spices, then stir to combine. Divide veggies between two large baking sheet pans and spread out in an even layer.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tsp oregano, dried\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 612808,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until veggies are fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 612809,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 612810,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 612811,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, beef, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 ¼ lb lean ground beef\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¼ tsp cinnamon, ground"
    },
    {
      "id": 612812,
      "primary_message": "Add water and tomato paste to the pot, then stir to combine. Continue to cook, stirring frequently, until sauce is slightly thickened, 3-4 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "1 cup water\n6 tbsp tomato paste"
    },
    {
      "id": 612813,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, salt, and pepper in a small bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tbsp red wine vinegar\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 612814,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 612815,
      "primary_message": "When the veggies are done, remove from the oven. Add parsley to the baking sheets and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 612816,
      "primary_message": "To serve, divide roasted veggies and beef between bowls. Drizzle with yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
