  "instructions": [
    {
      "id": 630107,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 630108,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels. Holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half crosswise into ¼-inch thick pieces. Place in a medium bowl, along with cornstarch, paprika, and pepper, then gently turn to coat.",
      "secondary_message": "1 (250 g) pkg halloumi cheese\n1 tbsp cornstarch\n1 tsp smoked paprika\n½ tsp black pepper"
    },
    {
      "id": 630109,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the halloumi and cook, turning halfway through, until golden brown on both sides, 4-5 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve bowl and skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 630110,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium zucchini squash\n1 (142 g) pkg baby spinach\n½ lemon"
    },
    {
      "id": 630111,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 630112,
      "primary_message": "Peel and mince garlic. Add to the bowl with the zucchini.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 630113,
      "primary_message": "Return the skillet to medium heat, add more oil, and swirl to coat the bottom. Add zucchini, garlic, and spices; cook, stirring occasionally, until zucchini is just tender, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 630114,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 630115,
      "primary_message": "Juice lemon into the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 630116,
      "primary_message": "To serve, divide zucchini-spinach sauté between plates or bowls. Top with crispy halloumi and enjoy!",
      "secondary_message": null
    }
  ],
