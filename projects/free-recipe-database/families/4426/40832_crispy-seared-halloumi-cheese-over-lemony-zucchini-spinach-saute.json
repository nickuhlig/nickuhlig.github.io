  "instructions": [
    {
      "id": 630157,
      "primary_message": "Pat halloumi dry with paper towels. Holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half crosswise into ¼-inch thick pieces. Place in a large bowl, along with arrowroot starch, paprika, and pepper, then gently turn to coat.",
      "secondary_message": "3 (250 g) pkgs halloumi cheese\n3 tbsp arrowroot starch/powder\n1 tbsp smoked paprika\n1 ½ tsp black pepper"
    },
    {
      "id": 630158,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 630159,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the halloumi and cook, turning halfway through, until golden brown on both sides, 4-5 minutes. Transfer to a plate and loosely cover with aluminum foil. (Reserve bowl and pot for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 630160,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 medium zucchini squash\n3 (142 g) pkgs baby spinach\n1 ½ lemons"
    },
    {
      "id": 630161,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 630162,
      "primary_message": "Peel and mince garlic. Add to the bowl with the zucchini.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 630163,
      "primary_message": "Return the pot to medium heat, add more oil, and swirl to coat the bottom. Add zucchini, garlic, and spices; cook, stirring occasionally, until zucchini is just tender, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 630164,
      "primary_message": "Add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 630165,
      "primary_message": "Juice lemons into the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 630166,
      "primary_message": "To serve, divide zucchini-spinach sauté between plates or bowls. Top with crispy halloumi and enjoy!",
      "secondary_message": null
    }
  ],
