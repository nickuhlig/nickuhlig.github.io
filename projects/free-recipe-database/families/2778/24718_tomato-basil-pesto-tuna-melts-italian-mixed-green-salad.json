  "instructions": [
    {
      "id": 423642,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 423643,
      "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 423644,
      "primary_message": "Drain and mince capers. Add to the bowl with the tuna along with pesto, mayo, salt, and pepper. Stir to combine the tuna salad and set aside.",
      "secondary_message": "½ tbsp capers\n¼ cup basil pesto\n2 tbsp mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 423645,
      "primary_message": "Arrange bread slices on a baking sheet pan. Place in the oven and broil, flipping once, until lightly toasted, 1-2 minutes per side. Remove from oven.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 423646,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 tomatoes\n½ English cucumber\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 423647,
      "primary_message": "Slice tomatoes into thin rounds. Season with salt and pepper.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 423648,
      "primary_message": "Divide tuna salad between toast slices and spread out in an even layer; top with tomato slices and sprinkle with cheese.",
      "secondary_message": "½ cup shredded cheese, Italian blend"
    },
    {
      "id": 423649,
      "primary_message": "Return toasts the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423650,
      "primary_message": "Meanwhile, trim and halve cucumber lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 423651,
      "primary_message": "To serve, divide tuna melts and mixed greens between plates; top greens with cucumber and drizzle with dressing. Enjoy!",
      "secondary_message": "2 tbsp Italian salad dressing"
    }
  ],
