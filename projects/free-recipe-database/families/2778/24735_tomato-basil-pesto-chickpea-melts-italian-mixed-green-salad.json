  "instructions": [
    {
      "id": 423812,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 423813,
      "primary_message": "Drain and rinse chickpeas. Place in a medium bowl and mash with a fork or potato masher until chickpeas are crushed but still have some texture.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 423814,
      "primary_message": "Drain and mince capers. Add to the bowl with the chickpeas along with pesto, mayo, salt, and pepper. Stir to combine the chickpea salad and set aside.",
      "secondary_message": "3 tbsp capers\n¾ cup basil pesto\n3 tbsp mayonnaise\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 423815,
      "primary_message": "Divide bread slices between two baking sheet pans. Working in batches, place in the oven and broil, flipping once, until lightly toasted, 1-2 minutes per side. Remove from oven.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 423816,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 tomatoes\n1 ½ English cucumbers\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 423817,
      "primary_message": "Slice tomatoes into thin rounds. Season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 423818,
      "primary_message": "Divide chickpea salad between toast slices and spread out in an even layer; top with tomato slices and sprinkle with cheese.",
      "secondary_message": "1 cup shredded cheese, Italian blend"
    },
    {
      "id": 423819,
      "primary_message": "Working in batches, return toasts to the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423820,
      "primary_message": "Meanwhile, trim and halve cucumbers lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 423821,
      "primary_message": "To serve, divide chickpea melts and mixed greens between plates; top greens with cucumber and drizzle with dressing. Enjoy!",
      "secondary_message": "⅓ cup Italian salad dressing"
    }
  ],
