  "instructions": [
    {
      "id": 338653,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ (142 g) pkg baby spinach\n3 medium carrots\n3 sticks celery\n6 medium zucchini squash\n1 small pkg fresh basil"
    },
    {
      "id": 338654,
      "primary_message": "Finely chop half of the spinach and place in a large bowl. (Reserve remaining spinach for the sauce.) ",
      "secondary_message": null
    },
    {
      "id": 338655,
      "primary_message": "Finely grate Parmesan and add to the bowl with the chopped spinach. ",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 338656,
      "primary_message": "Add turkey and spices to the bowl; mix with your hands until well combined. Using a ¼-cup measure, form turkey mixture into rounded meatballs and place on a plate. ",
      "secondary_message": "1.02 kg ground turkey\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp Italian seasoning"
    },
    {
      "id": 338657,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 338658,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs to the pot and cook, turning occasionally, until browned on all sides and cooked through, 6-8 minutes. Once done, transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 338659,
      "primary_message": "While the meatballs are cooking, peel and mince onions and garlic. Place both in a medium bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 338660,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery; add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 338661,
      "primary_message": "Return the pot to medium heat. Add more oil and swirl to coat the bottom; add the veggies and cook, stirring occasionally, until softened, 5-6 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 338662,
      "primary_message": "Add tomato sauce, water, and spices to the pot with the veggies and stir to combine. Cook, stirring occasionally, until sauce is slightly thickened, about 7 minutes. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n¾ cup water\n¾ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 338663,
      "primary_message": "While the sauce cooks, trim zucchini ends and use a julienne (or regular) peeler to make noodles.",
      "secondary_message": null
    },
    {
      "id": 338664,
      "primary_message": "Preheat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 338665,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add zucchini and water; cook, stirring constantly, until just tender, 3-4 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅓ cup water"
    },
    {
      "id": 338666,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half of the basil to the sauce and stir to combine (set remaining basil aside for garnish).",
      "secondary_message": null
    },
    {
      "id": 338667,
      "primary_message": "When the sauce is ready, add reserved spinach in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 338668,
      "primary_message": "Return meatballs to the pot with the sauce, stir gently to combine, and simmer until warmed though, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 338669,
      "primary_message": "To serve, divide zucchini noodles, sauce, and meatballs between bowls. Top with remaining basil and pine nuts. Enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
