  "instructions": [
    {
      "id": 338376,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ (5 oz) pkg baby spinach\n1 medium carrot\n1 stick celery\n2 medium zucchini squash\n½ small pkg fresh basil"
    },
    {
      "id": 338377,
      "primary_message": "Finely chop half of the spinach and place in a medium bowl. (Reserve remaining spinach for the sauce.) ",
      "secondary_message": null
    },
    {
      "id": 338378,
      "primary_message": "Finely grate Parmesan and add to the bowl with the chopped spinach. ",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 338379,
      "primary_message": "Add turkey and spices to the bowl; mix with your hands until well combined. Using a ¼-cup measure, form turkey mixture into rounded meatballs and place on a plate. ",
      "secondary_message": "¾ lb ground turkey\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp Italian seasoning"
    },
    {
      "id": 338380,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 338381,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs to the skillet and cook, turning occasionally, until browned on all sides and cooked through, 6-8 minutes. Once done, transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 338382,
      "primary_message": "While the meatballs are cooking, peel and mince onion and garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 338383,
      "primary_message": "Peel, trim, and small dice carrot. Trim and small dice celery; add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 338384,
      "primary_message": "Return the skillet to medium heat. Add more oil and swirl to coat the bottom; add the veggies and cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 338385,
      "primary_message": "Add tomato sauce, water, and spices to the skillet with the veggies and stir to combine. Cook, stirring occasionally, until sauce is slightly thickened, about 5 minutes. ",
      "secondary_message": "1 (8 oz) can tomato sauce\n¼ cup water\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 338386,
      "primary_message": "While the sauce cooks, trim zucchini ends and use a julienne (or regular) peeler to make noodles.",
      "secondary_message": null
    },
    {
      "id": 338387,
      "primary_message": "Preheat another skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 338388,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini and water; cook, stirring constantly, until just tender, 2-3 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tbsp water"
    },
    {
      "id": 338389,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half of the basil to the sauce and stir to combine (set remaining basil aside for garnish).",
      "secondary_message": null
    },
    {
      "id": 338390,
      "primary_message": "When the sauce is ready, add reserved spinach in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 338391,
      "primary_message": "Return meatballs to the skillet with the sauce, stir gently to combine, and simmer until warmed though, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 338392,
      "primary_message": "To serve, divide zucchini noodles, sauce, and meatballs between bowls. Top with remaining basil and pine nuts. Enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
