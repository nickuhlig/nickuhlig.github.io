  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine beans, chiles, and cilantro in a small bowl. Spoon mixture into jalapeño halves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine flour and 1 tablespoon salt in a medium bowl. Add 1 cup water and whisk to combine. Mixture should have consistency of thick pancake batter. Place bread crumbs in a second bowl. Working one at a time, coat jalapeños in flour mixture. Allow excess to drip off then transfer to bread crumbs. Coat evenly in bread crumbs and transfer to a large plate. Repeat with remaining jalapeños.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil to 350°F. Fry jalapeños 9 at a time, agitating occasionally, until golden brown and crisp, about 5 minutes total. Transfer to a paper towel-lined baking sheet and season with salt (jalapeños can be held in a 200°F oven while frying second batch). Serve immediately with salsa.",
      "secondary_message": null
    }
  ],
