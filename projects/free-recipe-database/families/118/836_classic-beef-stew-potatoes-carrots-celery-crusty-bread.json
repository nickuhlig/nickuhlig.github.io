  "instructions": [
    {
      "id": 9334,
      "primary_message": "In a medium bowl, combine flour, salt, and pepper.",
      "secondary_message": "¼ cup all-purpose flour\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 9335,
      "primary_message": "Cube steak, add to bowl, and toss to coat.",
      "secondary_message": "0.34 kg striploin (New York strip) steak"
    },
    {
      "id": 9336,
      "primary_message": "Wash and dry potatoes, carrots, celery, and green onions. Peel and medium dice potatoes and carrots. Trim ends and medium dice celery. Trim root ends and chop onions. Peel and mince garlic.",
      "secondary_message": "2 medium yellow potatoes\r\n2 medium carrots\r\n1 stick celery\r\n½ small bunch green onions (scallions)\r\n2 cloves garlic"
    },
    {
      "id": 9337,
      "primary_message": "Heat a small saucepan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 9338,
      "primary_message": "Coat bottom of saucepan with oil. Add beef and cook until browned on all sides, 3-4 minutes total.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 9339,
      "primary_message": "Add potatoes, carrots, celery, onions, and garlic. Stir and cook for 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 9340,
      "primary_message": "Add broth, water, Worcestershire, salt, and pepper; bring to a boil. Reduce heat to a simmer and cook until vegetables are tender, 10-15 minutes.",
      "secondary_message": "236 ml (1 cup) chicken or vegetable broth\n¾ cup water\n1 tbsp Worcestershire sauce\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 9341,
      "primary_message": "Toast bread.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 9342,
      "primary_message": "To serve, place stew in a bowl and have with crusty bread. Enjoy!",
      "secondary_message": ""
    }
  ],
