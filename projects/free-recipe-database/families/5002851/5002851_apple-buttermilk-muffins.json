  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Grease muffin cups.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk together flour, salt, cinnamon, nutmeg, baking powder, and baking soda. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat together sugar and butter until light and fluffy, about 3 minutes. Beat in egg. Beat in vanilla.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add 1/2 flour mixture to batter and beat until just combined. Beat in 1/2 cup buttermilk, followed by remaining flour. Beat in final 1/2 cup buttermilk.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Gently fold in apples. Pour batter into muffin cups, filling them 2/3 full.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake muffins until a cake tester comes out clean, about 25 minutes. Let cool for 5 minutes in pan then remove to a wire rack.",
      "secondary_message": null
    }
  ],
