  "instructions": [
    {
      "id": 445368,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 445369,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 caps portobello mushrooms\n3 sticks celery\n1 Granny Smith apple"
    },
    {
      "id": 445370,
      "primary_message": "Remove stems from portobello mushrooms and carefully scrape out the gills. Transfer to a baking sheet pan, rub with oil, then season with salt and pepper on both sides; arrange cap-side up.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 445371,
      "primary_message": "Place mushrooms in the oven and broil until starting to soften, about 6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 445372,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445373,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n¼ tsp thyme, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 445374,
      "primary_message": "While the veggie ground is cooking, place additional oil, vinegar, Dijon, salt, and pepper in a medium bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 445375,
      "primary_message": "Using tongs, carefully flip the mushrooms, cap-side down. Fill with the veggie ground mixture and top with blue cheese.",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese"
    },
    {
      "id": 445376,
      "primary_message": "Return baking sheet to the oven and continue to broil until the mushrooms are soft and cheese is melted, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 445377,
      "primary_message": "Meanwhile, trim and thinly slice celery crosswise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 445378,
      "primary_message": "Quarter, core, and thinly slice apple. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445379,
      "primary_message": "Roughly chop pecans, add to the bowl, and stir to combine the salad.",
      "secondary_message": "⅛ cup pecan halves"
    },
    {
      "id": 445380,
      "primary_message": "To serve, divide stuffed mushrooms and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
