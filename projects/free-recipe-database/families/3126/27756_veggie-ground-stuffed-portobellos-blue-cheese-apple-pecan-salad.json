  "instructions": [
    {
      "id": 445472,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 caps portobello mushrooms\n9 sticks celery\n3 Granny Smith apples"
    },
    {
      "id": 445473,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 445474,
      "primary_message": "Remove stems from portobello mushrooms and carefully scrape out the gills. Transfer to a large baking sheet pan, rub with oil, then season with salt and pepper on both sides; arrange cap-side up.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445475,
      "primary_message": "Place mushrooms in the oven and broil until starting to soften, 6-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 445476,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445477,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n¾ tsp thyme, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 445478,
      "primary_message": "While the veggie ground is cooking, place additional oil, vinegar, Dijon, salt, and pepper in a large bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445479,
      "primary_message": "Using tongs, carefully flip the mushrooms, cap-side down. Fill with the veggie ground mixture and top with blue cheese.",
      "secondary_message": "3 (113 g) pkgs crumbled blue cheese"
    },
    {
      "id": 445480,
      "primary_message": "Return baking sheet to the oven and continue to broil until the mushrooms are soft and cheese is melted, 5-6 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 445481,
      "primary_message": "Meanwhile, trim and thinly slice celery crosswise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 445482,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445483,
      "primary_message": "Roughly chop pecans, add to the bowl, and stir to combine the salad.",
      "secondary_message": "⅓ cup pecan halves"
    },
    {
      "id": 445484,
      "primary_message": "To serve, divide stuffed mushrooms and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
