  "instructions": [
    {
      "id": 340746,
      "primary_message": "Wash, dry, peel, and slice mango flesh away from the pit, starting with the flat sides; roughly chop and place in a blender. ",
      "secondary_message": "1 mango"
    },
    {
      "id": 340747,
      "primary_message": "Wash, dry, and juice lime into the blender. ",
      "secondary_message": "1 lime"
    },
    {
      "id": 340748,
      "primary_message": "Add almond milk, sugar, vanilla, and spices to the blender; blend on high for several minutes until smooth. ",
      "secondary_message": "237 ml almond milk, unsweetened\n⅓ cup granulated sugar\n½ tsp vanilla extract\n⅛ tsp cardamom, ground\n⅛ tsp cinnamon, ground\n⅛ tsp salt"
    },
    {
      "id": 340749,
      "primary_message": "Transfer mango purée to a small baking dish. Cover with plastic wrap and place in the freezer. Let chill until completely frozen, about 8 hours (or overnight).",
      "secondary_message": null
    },
    {
      "id": 340750,
      "primary_message": "Once the purée is completely frozen, remove from the freezer. Using a fork, scrape the ice from end to end, to form shards. Re-cover with plastic wrap and return to the freezer until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 340751,
      "primary_message": "Just before serving, roughly chop pistachios. ",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 340752,
      "primary_message": "To serve, divide granita between bowls and top with pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
