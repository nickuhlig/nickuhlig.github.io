  "instructions": [
    {
      "id": 47698,
      "primary_message": "Preheat the oven to 350°F and place the rack in the center position. Line a sheet pan with parchment paper (optional).",
      "secondary_message": null
    },
    {
      "id": 47699,
      "primary_message": "Wash and dry the kale. Cut out and discard the stems; tear the leaves into large pieces and transfer to a large bowl.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 47700,
      "primary_message": "Drizzle the kale with olive oil and season with salt and pepper; toss with your hands until thoroughly coated with the oil. Transfer the kale to the sheet pan and arrange in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 47701,
      "primary_message": "Place the kale in the oven and bake until it is crisp and lightly browned around the edges, 15 to 20 minutes. Once done, remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 47702,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 47703,
      "primary_message": "While the skillet heats up, in a medium bowl, combine and mix together the ground beef, salt, and pepper. Form the mixture into 4 equal-sized patties and place on a plate.",
      "secondary_message": "1 ½ lb lean ground beef\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 47704,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 47705,
      "primary_message": "Carefully place the burger patties in the skillet and cook until desired doneness, 2 to 5 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 47706,
      "primary_message": "Trim off and discard the ends of the onions and remove the outer layer; halve the onions lengthwise, then thinly slice crosswise into half-rounds.",
      "secondary_message": "2 medium yellow onions"
    },
    {
      "id": 47707,
      "primary_message": "Once the burger patties have been transferred, add the onion to the skillet; cook, stirring frequently, until golden brown and softened, 4 to 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 47708,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 47709,
      "primary_message": "In a small bowl, combine and mix together the garlic, mayonnaise, and paprika.",
      "secondary_message": "4 tbsp mayonnaise\n1 tsp paprika"
    },
    {
      "id": 47710,
      "primary_message": "Halve the buns. Toast in a toaster if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 47711,
      "primary_message": "Top the bun bottoms with the mayo spread, cooked patties, and caramelized onions. Complete with the bun tops.",
      "secondary_message": null
    },
    {
      "id": 47712,
      "primary_message": "To serve, divide the burgers and kale crisps between dishes. Enjoy!",
      "secondary_message": null
    }
  ],
