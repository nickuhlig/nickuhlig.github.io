  "instructions": [
    {
      "id": 47713,
      "primary_message": "Preheat the oven to 177°C (350°F) and place the rack in the center position. Line a sheet pan with parchment paper (optional).",
      "secondary_message": null
    },
    {
      "id": 47714,
      "primary_message": "Wash and dry the kale. Cut out and discard the stems; tear the leaves into large pieces and transfer to a medium bowl.",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 47715,
      "primary_message": "Drizzle the kale with olive oil and season with salt and pepper; toss with your hands until thoroughly coated with the oil. Transfer the kale to the sheet pan and arrange in a single layer.",
      "secondary_message": "½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 47716,
      "primary_message": "Place the kale in the oven and bake until it is crisp and lightly browned around the edges, 15 to 20 minutes. Once done, remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 47717,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 47718,
      "primary_message": "While the skillet heats up, in a medium bowl, combine and mix together the ground beef, salt, and pepper. Form the mixture into 2 equal-sized patties and place on a plate.",
      "secondary_message": "0.34 kg lean ground beef\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 47719,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 47720,
      "primary_message": "Carefully place the burger patties in the skillet and cook until desired doneness, 2 to 5 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 47721,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; halve the onion lengthwise, then thinly slice crosswise into half-rounds.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 47722,
      "primary_message": "Once the burger patties have been transferred, add the onion to the skillet; cook, stirring frequently, until golden brown and softened, 4 to 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 47723,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 47724,
      "primary_message": "In a small bowl, combine and mix together the garlic, mayonnaise, and paprika.",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp paprika"
    },
    {
      "id": 47725,
      "primary_message": "Halve the buns. Toast in a toaster if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 47726,
      "primary_message": "Top the bun bottoms with the mayo spread, cooked patties, and caramelized onions. Complete with the bun tops.",
      "secondary_message": null
    },
    {
      "id": 47727,
      "primary_message": "To serve, divide the burgers and kale crisps between dishes. Enjoy!",
      "secondary_message": null
    }
  ],
