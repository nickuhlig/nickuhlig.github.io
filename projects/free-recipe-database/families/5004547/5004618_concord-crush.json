  "instructions": [
    {
      "id": 1,
      "primary_message": "Pull grapes from their stems. Set aside 4 whole grapes. Place rest of grapes in blender with 7 g lime juice (to prevent browning). Blend to completely purée the grapes. Strain the purée through a fine-mesh strainer, pushing it through with the back of a ladle.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fill a cocktail shaker with ice. Add vodka, grape puree, lime juice, simple syrup, lime wedges, and whole grapes. Shake vigorously and pour contents of shaker into an old-fashioned glass without straining.",
      "secondary_message": null
    }
  ],
