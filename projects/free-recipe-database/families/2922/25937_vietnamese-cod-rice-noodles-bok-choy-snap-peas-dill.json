  "instructions": [
    {
      "id": 434883,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 434884,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 baby bok choy\n1 (8 oz) pkg sugar snap peas\n2 limes\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 small bunch fresh dill"
    },
    {
      "id": 434885,
      "primary_message": "Trim and cut bok choy crosswise into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 434886,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 434887,
      "primary_message": "While the skillet heats up, cut snap peas crosswise into ½-inch pieces. Add to the bowl with the bok choy. ",
      "secondary_message": null
    },
    {
      "id": 434888,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bok choy, snap peas, salt, and pepper; cook, stirring occasionally, until tender, about 5 minutes. Return veggies to the bowl and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 434889,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 434890,
      "primary_message": "Juice limes into the bowl with the garlic. Add water, fish sauce, sugar, and chili-garlic sauce; whisk to combine the \"nuoc cham\" dressing and set aside.",
      "secondary_message": "⅔ cup water\n¼ cup fish sauce\n3 tbsp brown sugar\n1 tsp chili-garlic sauce"
    },
    {
      "id": 434891,
      "primary_message": "Peel and mince ginger and additional garlic. Place both in another medium bowl along with oil, fish sauce, and spices. Stir to combine the spice oil.",
      "secondary_message": "2 cloves garlic\n3 tbsp extra virgin olive oil\n4 tsp fish sauce\n1 tsp turmeric, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 434892,
      "primary_message": "Pat cod dry with paper towels. Cut into 2-inch pieces, add to the bowl with the spice oil, and stir to coat.",
      "secondary_message": "1 ½ lb cod fillet"
    },
    {
      "id": 434893,
      "primary_message": "Return the skillet to medium-high heat. Add fish and spice oil; cook, turning occasionally, until golden brown and just cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 434894,
      "primary_message": "Meanwhile, using a clean cutting board, trim and cut green onions crosswise into 1-inch pieces. ",
      "secondary_message": null
    },
    {
      "id": 434895,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 434896,
      "primary_message": "When the fish is done, add green onions and dill to the skillet. Continue to cook, stirring frequently, until the dill is wilted and green onions have softened, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 434897,
      "primary_message": "To serve, divide rice noodles, veggies, and fish between plates or bowls; drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
