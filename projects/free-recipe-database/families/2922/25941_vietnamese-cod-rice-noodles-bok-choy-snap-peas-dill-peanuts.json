  "instructions": [
    {
      "id": 434943,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 434944,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "9 baby bok choy\n1 ½ (227 g) pkgs sugar snap peas\n3 limes\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n2 small bunches fresh dill"
    },
    {
      "id": 434945,
      "primary_message": "Trim and cut bok choy crosswise into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 434946,
      "primary_message": "Cut snap peas crosswise into ½-inch pieces. Add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 434947,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 434948,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bok choy, snap peas, salt, and pepper; cook, stirring occasionally, until tender, about 6 minutes. Return veggies to the bowl and loosely cover with aluminum foil. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 434949,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 434950,
      "primary_message": "Juice limes into the bowl with the garlic. Add water, fish sauce, sugar, and chili-garlic sauce; whisk to combine the \"nuoc cham\" dressing and set aside.",
      "secondary_message": "1 cup water\n⅓ cup fish sauce\n¼ cup brown sugar\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 434951,
      "primary_message": "Peel and mince ginger and additional garlic. Place both in a medium bowl along with oil, fish sauce, and spices. Stir to combine the spice oil.",
      "secondary_message": "3 cloves garlic\n¼ cup extra virgin olive oil\n2 tbsp fish sauce\n1 ½ tsp turmeric, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 434952,
      "primary_message": "Pat cod dry with paper towels. Cut into 2-inch pieces, add to the bowl with the spice oil, and stir to coat.",
      "secondary_message": "1.02 kg cod fillet"
    },
    {
      "id": 434953,
      "primary_message": "Return the pot to medium-high heat. Add fish and spice oil; cook, turning occasionally, until golden brown and just cooked through, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 434954,
      "primary_message": "Meanwhile, using a clean cutting board, trim and cut green onions crosswise into 1-inch pieces. ",
      "secondary_message": null
    },
    {
      "id": 434955,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 434956,
      "primary_message": "When the fish is done, add green onions and dill to the pot. Continue to cook, stirring frequently, until the dill is wilted and green onions have softened, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 434957,
      "primary_message": "To serve, divide rice noodles, veggies, and fish between plates or bowls; drizzle with dressing and sprinkle with peanuts. Enjoy!",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    }
  ],
