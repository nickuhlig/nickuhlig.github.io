  "instructions": [
    {
      "id": 462134,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462135,
      "primary_message": "While the skillet heats up, thinly slice tempeh. Place in a medium bowl, drizzle with soy sauce, and stir to coat.",
      "secondary_message": "2 (8 oz) packages tempeh\n4 tsp soy sauce"
    },
    {
      "id": 462136,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add tempeh and cook, stirring occasionally, until browned and warmed through, 2-3 minutes. Remove to a plate and reserve skillet for later use. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 462137,
      "primary_message": "Meanwhile, divide dressing between the reserved medium bowl and a small bowl. Set medium bowl aside for the salad.",
      "secondary_message": "½ cup ranch dressing"
    },
    {
      "id": 462138,
      "primary_message": "Add ketchup, Dijon, soy sauce, and smoked paprika to the small bowl with the ranch. Stir to combine the Russian dressing and set aside.",
      "secondary_message": "2 tbsp ketchup\n4 tsp Dijon mustard\n2 tsp soy sauce\n1 tsp smoked paprika"
    },
    {
      "id": 462139,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 462140,
      "primary_message": "Drain sauerkraut in a colander to remove excess liquid.",
      "secondary_message": "1 cup sauerkraut"
    },
    {
      "id": 462141,
      "primary_message": "Place the bread slices on a flat surface. Evenly spread with Russian dressing; layer half of the slices with cheese, warm tempeh, and sauerkraut. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 462142,
      "primary_message": "Return skillet to medium-high heat, add more butter, and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 462143,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 462144,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Add to the medium bowl with the ranch dressing and toss to coat.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 462145,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
