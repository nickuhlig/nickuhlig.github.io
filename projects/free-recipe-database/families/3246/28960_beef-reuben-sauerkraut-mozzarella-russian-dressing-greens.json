  "instructions": [
    {
      "id": 462224,
      "primary_message": "Divide dressing between a small and medium bowl. Set medium bowl aside for the salad.",
      "secondary_message": "¼ cup ranch dressing"
    },
    {
      "id": 462225,
      "primary_message": "Add ketchup, Dijon, Worcestershire, and smoked paprika to the small bowl with the ranch. Stir to combine the Russian dressing and set aside.",
      "secondary_message": "1 tbsp ketchup\n2 tsp Dijon mustard\n1 tsp Worcestershire sauce\n½ tsp smoked paprika"
    },
    {
      "id": 462226,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 462227,
      "primary_message": "Drain sauerkraut in a colander to remove excess liquid.",
      "secondary_message": "½ cup sauerkraut"
    },
    {
      "id": 462228,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462229,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Evenly spread with Russian dressing; layer half of the slices with cheese, roast beef, and sauerkraut. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "4 slices whole grain bread\n227 g deli roast beef"
    },
    {
      "id": 462230,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 462231,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 462232,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Add to the medium bowl with the ranch dressing and toss to coat.",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 462233,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
