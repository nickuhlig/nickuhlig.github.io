  "instructions": [
    {
      "id": 462112,
      "primary_message": "Divide dressing between a small and large bowl. Set large bowl aside for the salad.",
      "secondary_message": "¾ cup ranch dressing"
    },
    {
      "id": 462113,
      "primary_message": "Add ketchup, Dijon, Worcestershire, and smoked paprika to the small bowl with the ranch. Stir to combine the Russian dressing and set aside.",
      "secondary_message": "3 tbsp ketchup\n2 tbsp Dijon mustard\n1 tbsp Worcestershire sauce\n1 ½ tsp smoked paprika"
    },
    {
      "id": 462114,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 462115,
      "primary_message": "Drain sauerkraut in a colander to remove excess liquid.",
      "secondary_message": "1 ½ cups sauerkraut"
    },
    {
      "id": 462116,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462117,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Evenly spread with Russian dressing; layer half of the slices with cheese, roast beef, and sauerkraut. Cover sandwiches with the remaining bread slices.",
      "secondary_message": "12 slices whole grain bread\n24 oz deli roast beef"
    },
    {
      "id": 462118,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 462119,
      "primary_message": "Remove the sandwiches to a plate and add more butter to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Transfer to a cutting board and slice in half.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 462120,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Add to the large bowl with the ranch dressing and toss to coat.",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 462121,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
