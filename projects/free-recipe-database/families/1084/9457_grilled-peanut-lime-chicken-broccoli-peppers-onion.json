  "instructions": [
    {
      "id": 150615,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "5 limes\n3 crowns broccoli\n3 red bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 150616,
      "primary_message": "Peel and mince the garlic. Place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 150617,
      "primary_message": "Juice three limes into the bowl with the garlic. Add oil, peanut butter, soy sauce, honey, and Worcestershire; whisk to combine. Pour half of the marinade into a small bowl and set aside. ",
      "secondary_message": "½ cup extra virgin olive oil\n⅓ cup natural peanut butter\n⅓ cup soy sauce\n1 tbsp honey\n1 ½ tsp Worcestershire sauce"
    },
    {
      "id": 150618,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Add the chicken to the large bowl with the marinade. Toss to coat and set aside.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 150619,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 150620,
      "primary_message": "Seed and slice the bell peppers into strips.",
      "secondary_message": null
    },
    {
      "id": 150621,
      "primary_message": "Preheat a grill pan or skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 150622,
      "primary_message": "Coat the grill pan with oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 150623,
      "primary_message": "Working in batches if necessary add the broccoli and bell peppers to the grill pan and cook, stirring occasionally, until veggies are crisp-tender, 6-7 minutes. Remove and set aside on a plate; cover with foil.",
      "secondary_message": null
    },
    {
      "id": 150624,
      "primary_message": "Meanwhile, peel and slice the onions into thick rings.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 150625,
      "primary_message": "Add the onions to the grill pan. Cook, flipping once, until the onions start to soften and grill marks appear, 6-7 minutes. Remove and add to the plate with the veggies. Cover with the foil.",
      "secondary_message": null
    },
    {
      "id": 150626,
      "primary_message": "Coat the grill pan with additional oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 150627,
      "primary_message": "Working in batches if necessary, add the chicken to the grill pan; cook, flipping once, until cooked through and golden, 5-6 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 150628,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 150629,
      "primary_message": "Slice the remaining limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 150630,
      "primary_message": "Divide the chicken and veggies between plates; garnish with cilantro and lime wedges and serve with the reserved marinade for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
