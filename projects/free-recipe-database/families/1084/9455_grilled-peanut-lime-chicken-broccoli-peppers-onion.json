  "instructions": [
    {
      "id": 150583,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 crown broccoli\n1 red bell pepper\n½ small bunch cilantro"
    },
    {
      "id": 150584,
      "primary_message": "Peel and mince the garlic. Place in a large bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 150585,
      "primary_message": "Juice one lime into the bowl with the garlic. Add oil, peanut butter, soy sauce, honey, and Worcestershire; whisk to combine. Pour half of the marinade into a small bowl and set aside. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp natural peanut butter\n2 tbsp soy sauce\n1 tsp honey\n½ tsp Worcestershire sauce"
    },
    {
      "id": 150586,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Add the chicken to the large bowl with the marinade. Toss to coat and set aside.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 150587,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 150588,
      "primary_message": "Seed and slice the bell pepper into strips.",
      "secondary_message": null
    },
    {
      "id": 150589,
      "primary_message": "Preheat a grill pan or skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 150590,
      "primary_message": "Coat the grill pan with oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 150591,
      "primary_message": "Add the broccoli and bell pepper to the grill pan and cook, stirring occasionally, until veggies are crisp-tender, 4-5 minutes. Remove and set aside on a plate; cover with foil.",
      "secondary_message": null
    },
    {
      "id": 150592,
      "primary_message": "Meanwhile, peel and slice the onion into thick rings.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 150593,
      "primary_message": "Add the onion to the grill pan. Cook, flipping once, until the onion starts to soften and grill marks appear, 4-5 minutes. Remove and add to the plate with the veggies. Cover with the foil.",
      "secondary_message": null
    },
    {
      "id": 150594,
      "primary_message": "Coat the grill pan with additional oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 150595,
      "primary_message": "Add the chicken to the grill pan; cook, flipping once, until cooked through and golden, 4-5 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 150596,
      "primary_message": "Meanwhile, shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 150597,
      "primary_message": "Slice the remaining lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 150598,
      "primary_message": "Divide the chicken and veggies between plates; garnish with cilantro and lime wedges and serve with the reserved marinade for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
