  "instructions": [
    {
      "id": 1,
      "primary_message": "In a blender or food processor bowl, purée the peppers, garlic, and vinegar together until the mixture is coarsely chopped. Adjust chunkiness or smoothness to your preference.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer the pepper-garlic mixture to a large, deep stainless steel pot. Add the sugar to the pot. Bring to a boil over high heat, stirring occasionally, for 10 minutes. Stir in the pectin and boil hard, stirring constantly, for one minute. Remove from heat and skim off any foam that may form on the surface.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Quickly pour hot jelly into sterilized jars, leaving 1/2 inch (1/2 centimeter) headspace. Wipe rim. Place the flat lids on the jars. Screw down the bands until resistance is met.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "The jelly can be kept in the refrigerator for up to six months. If you would like to preserve it longer without refrigeration, follow the steps in A Beginner's Guide to Canning.",
      "secondary_message": null
    }
  ],
