  "instructions": [
    {
      "id": 160848,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 oranges\n2 avocados\n1 bunch radish\n2 English cucumbers\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 160849,
      "primary_message": "Cut off the skin and white pith from two oranges; cut between the membranes to release the segments. Juice the remaining oranges into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 160850,
      "primary_message": "Add oil, vinegar, Dijon, honey, and salt to the bowl with the orange juice. Whisk to combine.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tbsp Dijon mustard\n2 tsp honey\n½ tsp salt"
    },
    {
      "id": 160851,
      "primary_message": "Halve and pit the avocados; slice lengthwise and crosswise while still in the skin and scoop out with a spoon. Add to the bowl with the dressing along with the orange segments.",
      "secondary_message": null
    },
    {
      "id": 160852,
      "primary_message": "Trim off and discard tops and root ends of radishes and thinly slice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 160853,
      "primary_message": "Thinly slice cucumbers into half rounds and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 160854,
      "primary_message": "Crumble goat cheese with your hands and add to the bowl.",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 160855,
      "primary_message": "Add arugula to the bowl and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 160856,
      "primary_message": "To serve, divide salad between plates or bowls and top with smoked salmon. Enjoy!",
      "secondary_message": "2 (113 g) pkg smoked salmon"
    }
  ],
