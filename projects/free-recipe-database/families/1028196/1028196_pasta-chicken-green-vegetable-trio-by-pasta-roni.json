  "instructions": [
    {
      "primary_message": "Prepare Pasta Roni® Parmesan cheese according to package directions, stirring broccoli, green beans and zucchini in with pasta and special seasoning mix.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, in 10-inch nonstick skillet, heat oil over medium-high heat. Lightly season chicken strips with salt and pepper; add to skillet. Cook 6-8 minutes or until chicken is cooked through and no longer pink, stirring occasionally.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Stir chicken into cooked pasta and vegetable mixture.\n",
      "secondary_message": null
    }
