  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the ginger. Slice the scallion greens.",
      "secondary_message": "1 tsp ginger root\n3 scallion greens"
    },
    {
      "id": 1,
      "primary_message": "Combine stock, soy sauce, vinegar, hoisin, chili paste, sesame oil, sugar, and cornstarch in a small bowl and mix with a fork until blended and smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in a large wok over high heat until smoking. Add garlic and ginger and stir fry until fragrant, about 15 seconds. Immediately add whole chiles and chicken nuggets and toss to combine. Add sauce and simmer, stirring constantly, until thickened into a thick glossy glaze. Transfer contents immediately to a hot plate and serve with steamed rice.",
      "secondary_message": null
    }
