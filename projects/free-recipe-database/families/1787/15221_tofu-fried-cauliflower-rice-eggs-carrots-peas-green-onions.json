  "instructions": [
    {
      "id": 251027,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 251028,
      "primary_message": "Place oil, soy sauce, vinegar, chili-garlic sauce, and maple syrup in a large bowl; whisk to combine the marinade.",
      "secondary_message": "3 tbsp toasted sesame oil\n¼ cup soy sauce\n¼ cup rice vinegar\n2 tbsp chili-garlic sauce\n1 tbsp pure maple syrup"
    },
    {
      "id": 251029,
      "primary_message": "Medium dice tofu, add to the bowl with the marinade, and gently stir to coat; set aside to marinate.",
      "secondary_message": null
    },
    {
      "id": 251030,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 medium carrots\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 251031,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251032,
      "primary_message": "Meanwhile, in a medium bowl, whisk together the eggs and salt.",
      "secondary_message": "6 eggs\n3 pinch salt"
    },
    {
      "id": 251033,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour eggs into the skillet; scramble using a combination of stirring and folding. Cook until eggs are no longer runny, 2-3 minutes. Transfer eggs to a plate and set aside.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 251034,
      "primary_message": "Return skillet to medium-high heat. Working in batches if necessary, add tofu and marinade to the skillet; stir-fry until marinade reduces and coats the tofu, about 7 minutes. Transfer to the plate with the scrambled eggs. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 251035,
      "primary_message": "While the tofu is cooking, place peas and corn in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "2 cups frozen peas\n2 cups frozen corn"
    },
    {
      "id": 251036,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower and place in the reserved bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 251037,
      "primary_message": "Peel and small dice carrots.",
      "secondary_message": null
    },
    {
      "id": 251038,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251039,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the carrot and cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 251040,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 251041,
      "primary_message": "Add cauliflower, garlic, ginger, and salt to the pot with the carrot; continue to cook, stirring occasionally, until cauliflower begins to soften, 4-5 minutes.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 251042,
      "primary_message": "While the cauliflower is cooking, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 251043,
      "primary_message": "Add peas, corn, green onion, scrambled eggs, and tofu to the pot; stir to combine and continue to cook until fragrant and heated through, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 251044,
      "primary_message": "To serve, divide fried cauliflower rice between bowls. Drizzle with additional oil and soy sauce, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp soy sauce\n2 tbsp sesame seeds"
    }
  ],
