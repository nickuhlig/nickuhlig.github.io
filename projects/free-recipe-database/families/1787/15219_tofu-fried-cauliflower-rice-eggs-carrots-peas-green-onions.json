  "instructions": [
    {
      "id": 250993,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 250994,
      "primary_message": "Place oil, soy sauce, vinegar, chili-garlic sauce, and maple syrup in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "1 tbsp toasted sesame oil\n4 tsp soy sauce\n4 tsp rice vinegar\n2 tsp chili-garlic sauce\n1 tsp pure maple syrup"
    },
    {
      "id": 250995,
      "primary_message": "Medium dice tofu, add to the bowl with the marinade, and gently stir to coat; set aside to marinate.",
      "secondary_message": null
    },
    {
      "id": 250996,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 medium carrot\n1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 250997,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250998,
      "primary_message": "Meanwhile, in a small bowl, whisk together the eggs and salt.",
      "secondary_message": "2 eggs\n1 pinch salt"
    },
    {
      "id": 250999,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour eggs into the skillet; scramble using a combination of stirring and folding. Cook until eggs are no longer runny, 1-2 minutes. Transfer eggs to a plate and set aside.",
      "secondary_message": "½ tsp toasted sesame oil"
    },
    {
      "id": 251000,
      "primary_message": "Return skillet to medium-high heat. Add tofu and marinade to the skillet; stir-fry until marinade reduces and coats the tofu, about 5 minutes. Transfer to the plate with the scrambled eggs. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 251001,
      "primary_message": "While the tofu is cooking, place peas and corn in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "⅔ cup frozen peas\n⅔ cup frozen corn"
    },
    {
      "id": 251002,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in the reserved bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 251003,
      "primary_message": "Peel and small dice carrot.",
      "secondary_message": null
    },
    {
      "id": 251004,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Add the carrot and cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 251005,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 251006,
      "primary_message": "Add cauliflower, garlic, ginger, and salt to the skillet with the carrot; continue to cook, stirring occasionally, until cauliflower begins to soften, about 3 minutes.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 251007,
      "primary_message": "While the cauliflower is cooking, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 251008,
      "primary_message": "Add peas, corn, green onion, scrambled eggs, and tofu to the skillet; stir to combine and continue to cook until fragrant and heated through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 251009,
      "primary_message": "To serve, divide fried cauliflower rice between bowls. Drizzle with additional oil and soy sauce, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp soy sauce\n2 tsp sesame seeds"
    }
  ],
