  "instructions": [
    {
      "id": 251162,
      "primary_message": "Place soy sauce, vinegar, chili-garlic sauce, and maple syrup in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp rice vinegar\n4 tsp chili-garlic sauce\n2 tsp pure maple syrup"
    },
    {
      "id": 251163,
      "primary_message": "Thinly slice steak against the grain into strips and transfer to the bowl with the marinade; toss to coat and set aside to marinate.",
      "secondary_message": "0.68 kg striploin (New York strip) steak"
    },
    {
      "id": 251164,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n2 medium carrots\n2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 251165,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251166,
      "primary_message": "Meanwhile, in another medium bowl, whisk together the eggs and salt.",
      "secondary_message": "4 eggs\n⅛ tsp salt"
    },
    {
      "id": 251167,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour eggs into the skillet; scramble using a combination of stirring and folding. Cook until eggs are no longer runny, 1-2 minutes. Transfer eggs to a plate and set aside.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 251168,
      "primary_message": "Return skillet to medium-high heat; add more oil and swirl to coat the bottom. Add steak strips and marinade to the skillet; stir-fry until just cooked through, 3-5 minutes. Transfer to the plate with the scrambled eggs.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 251169,
      "primary_message": "While the steak is cooking, place peas and corn in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "⅔ cup frozen peas\n⅔ cup frozen corn"
    },
    {
      "id": 251170,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a large bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 251171,
      "primary_message": "Peel and small dice carrots.",
      "secondary_message": null
    },
    {
      "id": 251172,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Add the carrot and cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 251173,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 251174,
      "primary_message": "Add cauliflower, garlic, ginger, and salt to the skillet with the carrot; continue to cook, stirring occasionally, until cauliflower begins to soften, 3-4 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 251175,
      "primary_message": "While the cauliflower is cooking, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 251176,
      "primary_message": "Add peas, corn, green onion, scrambled eggs, steak, and any accumulated juices to the skillet; stir to combine and continue to cook until fragrant and heated through, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 251177,
      "primary_message": "To serve, divide fried cauliflower rice between bowls. Drizzle with additional oil and soy sauce, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp soy sauce\n4 tsp sesame seeds"
    }
  ],
