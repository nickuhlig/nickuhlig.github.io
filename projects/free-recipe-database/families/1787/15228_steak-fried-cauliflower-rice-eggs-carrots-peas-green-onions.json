  "instructions": [
    {
      "id": 251146,
      "primary_message": "Place soy sauce, vinegar, chili-garlic sauce, and maple syrup in a small bowl; whisk to combine the marinade.",
      "secondary_message": "4 tsp soy sauce\n4 tsp rice vinegar\n2 tsp chili-garlic sauce\n1 tsp pure maple syrup"
    },
    {
      "id": 251147,
      "primary_message": "Thinly slice steak against the grain into strips and transfer to the bowl with the marinade; toss to coat and set aside to marinate.",
      "secondary_message": "⅓ kg striploin (New York strip) steak"
    },
    {
      "id": 251148,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 medium carrot\n1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)"
    },
    {
      "id": 251149,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 251150,
      "primary_message": "Meanwhile, in another small bowl, whisk together the eggs and salt.",
      "secondary_message": "2 eggs\n1 pinch salt"
    },
    {
      "id": 251151,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour eggs into the skillet; scramble using a combination of stirring and folding. Cook until eggs are no longer runny, 1-2 minutes. Transfer eggs to a plate and set aside.",
      "secondary_message": "½ tsp toasted sesame oil"
    },
    {
      "id": 251152,
      "primary_message": "Return skillet to medium-high heat; add more oil and swirl to coat the bottom. Add steak strips and marinade to the skillet; stir-fry until just cooked through, 3-5 minutes. Transfer to the plate with the scrambled eggs.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 251153,
      "primary_message": "While the steak is cooking, place peas and corn in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "⅓ cup frozen peas\n⅓ cup frozen corn"
    },
    {
      "id": 251154,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a medium bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 251155,
      "primary_message": "Peel and small dice carrot.",
      "secondary_message": null
    },
    {
      "id": 251156,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat; add more oil and swirl to coat the bottom. Add the carrot and cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 251157,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 251158,
      "primary_message": "Add cauliflower, garlic, ginger, and salt to the skillet with the carrot; continue to cook, stirring occasionally, until cauliflower begins to soften, about 3 minutes.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 251159,
      "primary_message": "While the cauliflower is cooking, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 251160,
      "primary_message": "Add peas, corn, green onion, scrambled eggs, steak, and any accumulated juices to the skillet; stir to combine and continue to cook until fragrant and heated through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 251161,
      "primary_message": "To serve, divide fried cauliflower rice between bowls. Drizzle with additional oil and soy sauce, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tsp toasted sesame oil\n1 tsp soy sauce\n2 tsp sesame seeds"
    }
  ],
