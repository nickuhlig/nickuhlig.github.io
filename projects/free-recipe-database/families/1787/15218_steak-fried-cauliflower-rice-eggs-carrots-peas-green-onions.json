  "instructions": [
    {
      "id": 250976,
      "primary_message": "Place soy sauce, vinegar, chili-garlic sauce, and maple syrup in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "¼ cup soy sauce\n¼ cup rice vinegar\n2 tbsp chili-garlic sauce\n1 tbsp pure maple syrup"
    },
    {
      "id": 250977,
      "primary_message": "Thinly slice steak against the grain into strips and transfer to the bowl with the marinade; toss to coat and set aside to marinate.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 250978,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 medium carrots\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 250979,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250980,
      "primary_message": "Meanwhile, in another medium bowl, whisk together the eggs and salt.",
      "secondary_message": "6 eggs\n3 pinch salt"
    },
    {
      "id": 250981,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour eggs into the skillet; scramble using a combination of stirring and folding. Cook until eggs are no longer runny, 2-3 minutes. Transfer eggs to a plate and set aside.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 250982,
      "primary_message": "Return skillet to medium-high heat; add more oil and swirl to coat the bottom. Working in batches if necessary, add steak strips and marinade to the skillet; stir-fry until just cooked through, 3-5 minutes. Transfer to the plate with the scrambled eggs.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 250983,
      "primary_message": "While the steak is cooking, place peas and corn in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 cup frozen peas\n1 cup frozen corn"
    },
    {
      "id": 250984,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower and place in a large bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 250985,
      "primary_message": "Peel and small dice carrots.",
      "secondary_message": null
    },
    {
      "id": 250986,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250987,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the carrot and cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 250988,
      "primary_message": "Meanwhile, peel and mince garlic and ginger.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 250989,
      "primary_message": "Add cauliflower, garlic, ginger, and salt to the pot with the carrot; continue to cook, stirring occasionally, until cauliflower begins to soften, 4-5 minutes.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 250990,
      "primary_message": "While the cauliflower is cooking, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 250991,
      "primary_message": "Add peas, corn, green onion, scrambled eggs, steak, and any accumulated juices to the pot; stir to combine and continue to cook until fragrant and heated through, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 250992,
      "primary_message": "To serve, divide fried cauliflower rice between bowls. Drizzle with additional oil and soy sauce, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp toasted sesame oil\n1 tbsp soy sauce\n2 tbsp sesame seeds"
    }
  ],
