  "instructions": [
    {
      "id": 424098,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 424099,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 424100,
      "primary_message": "While the water heats up, drain and roughly chop artichoke hearts. Place in a baking dish. ",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 424101,
      "primary_message": "Add Alfredo sauce and spices to the baking dish with the artichokes. Stir to combine and set aside. ",
      "secondary_message": "½ (16 oz) jar Alfredo sauce\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 424102,
      "primary_message": "Once the water in the pan is boiling, add gnocchi and cauliflower. Cook, stirring occasionally, until gnocchi begins to float to the surface, 3-4 minutes.",
      "secondary_message": "1 (16 oz) pkg potato gnocchi\n1 (10 oz) bag cauliflower florets"
    },
    {
      "id": 424103,
      "primary_message": "Meanwhile, place frozen spinach in a colander. ",
      "secondary_message": "½ (16oz) bag frozen chopped spinach"
    },
    {
      "id": 424104,
      "primary_message": "When the gnocchi and cauliflower are done, drain in the colander over the spinach. ",
      "secondary_message": null
    },
    {
      "id": 424105,
      "primary_message": "Add gnocchi, cauliflower, and spinach to the baking dish. Stir to combine with the sauce, then top with cheese.",
      "secondary_message": "⅓ cup Parmesan cheese, shredded"
    },
    {
      "id": 424106,
      "primary_message": "Place baking dish in the oven and bake until cheese is golden, about 10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 424107,
      "primary_message": "To serve, divide gnocchi bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
