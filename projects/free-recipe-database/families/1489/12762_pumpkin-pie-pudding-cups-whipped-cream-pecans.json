  "instructions": [
    {
      "id": 214885,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 214886,
      "primary_message": "Using a box grater, coarsely grate cream cheese into another medium bowl; add cinnamon and nutmeg. Use a silicone spatula or fork to soften and combine the cream cheese mixture, creating a smooth cream.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese\n¾ tsp cinnamon\n3 pinch nutmeg, ground"
    },
    {
      "id": 214887,
      "primary_message": "Using a strainer, sift powdered sugar into the bowl with the cream cheese. Use the spatula or fork to mash and combine the mixture until smooth and no lumps remain.",
      "secondary_message": "1 ½ cup powdered sugar"
    },
    {
      "id": 214888,
      "primary_message": "Add pumpkin to the cream cheese mixture and fold to combine. Set aside.",
      "secondary_message": "1 ½ (398 ml) cans pure pumpkin purée"
    },
    {
      "id": 214889,
      "primary_message": "Remove bowl from the freezer. Pour cold cream into the bowl.",
      "secondary_message": "355 ml heavy cream"
    },
    {
      "id": 214890,
      "primary_message": "Add sugar and vanilla to the bowl with the cream; use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "1 tbsp powdered sugar\n¾ tsp vanilla extract"
    },
    {
      "id": 214891,
      "primary_message": "Transfer half the whipped cream to the bowl with the pumpkin mixture (reserve remaining whipped cream for garnish). Using a silicone spatula, gently fold the two together to combine the pudding.",
      "secondary_message": null
    },
    {
      "id": 214892,
      "primary_message": "Finely chop pecans.",
      "secondary_message": "½ cup pecans, dry roasted"
    },
    {
      "id": 214893,
      "primary_message": "Divide pudding between glasses. Top with remaining whipped cream, pecans, and cinnamon. Enjoy!",
      "secondary_message": "3 pinch cinnamon"
    }
  ],
