  "instructions": [
    {
      "id": 462974,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 462975,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n½ (8 oz) pkg sugar snap peas\n½ lemon"
    },
    {
      "id": 462976,
      "primary_message": "Once the water in the pan is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "1 (16 oz) pkg potato gnocchi\n½ tsp salt"
    },
    {
      "id": 462977,
      "primary_message": "While the gnocchi are cooking, peel, halve, and small dice onion. Peel and mince garlic. Place both in a small bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 462978,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462979,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 462980,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, chicken, and spices. Cook, stirring frequently, until chicken is golden and cooked through, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 462981,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Add broccoli and snap peas to the skillet. Cook, stirring frequently, until tender-crisp, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 462982,
      "primary_message": "Zest and juice lemon into the skillet, then add cooked gnocchi and stir to combine. Continue to cook, stirring occasionally, until gnocchi is warmed through, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 462983,
      "primary_message": "To serve, divide gnocchi, veggies, and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
