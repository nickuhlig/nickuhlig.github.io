  "instructions": [
    {
      "id": 217136,
      "primary_message": "Wash, dry, zest, and juice orange into a medium bowl.",
      "secondary_message": "1 orange"
    },
    {
      "id": 217137,
      "primary_message": "Add ricotta, honey, and vanilla to the bowl with the orange. Whisk until light, fluffy, and combined.",
      "secondary_message": "1 (425 g) pkg ricotta cheese\n2 tbsp honey\n1 tsp vanilla extract"
    },
    {
      "id": 217138,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice.",
      "secondary_message": "4 mangoes"
    },
    {
      "id": 217139,
      "primary_message": "To serve, divide whipped ricotta between bowls and top with mango. Enjoy!",
      "secondary_message": null
