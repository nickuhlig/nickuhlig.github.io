    },
    {
      "id": 217097,
      "primary_message": "Roughly chop pistachios and place in a small bowl.",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 217098,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice.",
