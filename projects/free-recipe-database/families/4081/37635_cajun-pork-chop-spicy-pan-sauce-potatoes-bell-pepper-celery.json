  "instructions": [
    {
      "id": 588912,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 588913,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lb new potatoes\n3 green bell peppers\n6 sticks celery"
    },
    {
      "id": 588914,
      "primary_message": "Quarter new potatoes. Divide between two large baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 588915,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the baking sheets with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 588916,
      "primary_message": "Trim and medium dice celery. Add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 588917,
      "primary_message": "Peel, halve, and medium dice onions. Add to the baking sheets.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 588918,
      "primary_message": "Peel and mince garlic, then add to the baking sheets. Drizzle veggies with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n1 tbsp Cajun seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 588919,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 588920,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 588921,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 tbsp Cajun seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 588922,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet with drippings for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 588923,
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add flour and cook, whisking constantly, for 1 minute.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp all-purpose flour"
    },
    {
      "id": 588924,
      "primary_message": "Add broth, hot sauce, salt, and pepper to the skillet, then whisk to combine the sauce. Cook, whisking frequently, until sauce is thickened, 3-4 minutes. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n2 tbsp hot sauce\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 588925,
      "primary_message": "To serve, divide pork and roasted veggies between plates. Spoon pan sauce over chops and enjoy!",
      "secondary_message": null
    }
  ],
