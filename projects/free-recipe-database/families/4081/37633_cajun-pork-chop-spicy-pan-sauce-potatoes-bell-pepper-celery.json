  "instructions": [
    {
      "id": 588884,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 588885,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb new potatoes\n1 green bell pepper\n2 sticks celery"
    },
    {
      "id": 588886,
      "primary_message": "Quarter new potatoes. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 588887,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the baking sheet with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 588888,
      "primary_message": "Trim and medium dice celery. Add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 588889,
      "primary_message": "Peel, halve, and medium dice onion. Add to the baking sheet.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 588890,
      "primary_message": "Peel and mince garlic, then add to the baking sheet. Drizzle veggies with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n1 tsp Cajun seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 588891,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 588892,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 588893,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 pork chops, boneless\n1 tsp Cajun seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 588894,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet with drippings for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 588895,
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add flour and cook, whisking constantly, for 1 minute.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 tsp all-purpose flour"
    },
    {
      "id": 588896,
      "primary_message": "Add broth, hot sauce, salt, and pepper to the skillet, then whisk to combine the sauce. Cook, whisking frequently, until sauce is thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n2 tsp hot sauce\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 588897,
      "primary_message": "To serve, divide pork and roasted veggies between plates. Spoon pan sauce over chops and enjoy!",
      "secondary_message": null
    }
  ],
