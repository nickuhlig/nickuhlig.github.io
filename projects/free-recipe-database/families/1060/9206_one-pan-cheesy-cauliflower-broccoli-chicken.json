  "instructions": [
    {
      "id": 145993,
      "primary_message": "Cut chicken into bite-sized pieces.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 145994,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 145995,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 145996,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 145997,
      "primary_message": "Add the chicken, onion, paprika, salt, and pepper to the skillet. Cook, stirring occasionally, until the chicken is cooked through, 5-7 minutes.",
      "secondary_message": "½ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 145998,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ crown broccoli"
    },
    {
      "id": 145999,
      "primary_message": "Cut the cauliflower into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 146000,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to bowl with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 146001,
      "primary_message": "Add the cauliflower, broccoli, and broth to the skillet and cover. Cook, stirring occasionally, until the vegetables are tender, 5-7 minutes.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 146002,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "⅓ (227 g) block cheddar cheese"
    },
    {
      "id": 146003,
      "primary_message": "Once the vegetables are tender, remove skillet from the heat. Add cheese, yogurt, salt, and pepper; stir until smooth and creamy.",
      "secondary_message": "⅛ cup plain Greek yogurt\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 146004,
      "primary_message": "To serve, divide the chicken and vegetables between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
