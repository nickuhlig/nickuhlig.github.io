  "instructions": [
    {
      "id": 146017,
      "primary_message": "Cut chicken into bite-sized pieces.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 146018,
      "primary_message": "Peel and small dice the onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 146019,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 146020,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 146021,
      "primary_message": "Add the chicken, onion, paprika, salt, and pepper to the pot and cook until the chicken is cooked through, 7-9 minutes.",
      "secondary_message": "1 ½ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 146022,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ crowns broccoli"
    },
    {
      "id": 146023,
      "primary_message": "Cut the cauliflower into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 146024,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to bowl with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 146025,
      "primary_message": "Add the cauliflower, broccoli, and broth to the pot and cover. Cook, stirring occasionally, until the vegetables are tender, 7-9 minutes.",
      "secondary_message": "355 ml chicken or vegetable broth"
    },
    {
      "id": 146026,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 146027,
      "primary_message": "Once the vegetables are tender, remove pot from the heat. Add cheese, yogurt, salt, and pepper; stir until smooth and creamy.",
      "secondary_message": "⅜ cup plain Greek yogurt\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 146028,
      "primary_message": "To serve, divide the chicken and vegetables between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
