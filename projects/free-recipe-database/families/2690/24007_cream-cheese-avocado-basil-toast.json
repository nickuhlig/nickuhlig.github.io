  "instructions": [
    {
      "id": 390755,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 390756,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 390757,
      "primary_message": "Meanwhile, wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice lengthwise into thin pieces.",
      "secondary_message": "½ avocado"
    },
    {
      "id": 390758,
      "primary_message": "Wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons.",
      "secondary_message": "¼ small pkg fresh basil"
    },
    {
      "id": 390759,
      "primary_message": "Divide cream cheese between toast slices and spread out in an even layer. Top with avocado, then season with salt and pepper.",
      "secondary_message": "⅓ (227 g) block cream cheese\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 390760,
      "primary_message": "To serve, divide toast between plates, sprinkle with basil, and drizzle with oil. Enjoy!",
      "secondary_message": "1 tsp extra virgin olive oil"
    }
  ],
