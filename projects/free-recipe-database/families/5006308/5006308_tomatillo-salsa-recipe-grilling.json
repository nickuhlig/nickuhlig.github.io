  "instructions": [
    {
      "id": 1,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread coals out evenly over the charcoal grate. Alternatively, set all the burners of a gas grill to high heat. Set cooking grate in place, cover grill, and allow to preheat for 5 minutes. Clean and oil grilling grate.\nPlace tomatillo halves on the grill, cut side down. Grill until browned and they begin to soften. Flip and continue to cook until completely softened. Remove the tomatillos to the work bowl of a blender or food processor. Let cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add garlic, chiles, cilantro, and 1/4 cup of water to the bowl and pulse until coarsely pureed. Pour salsa into a small dish and stir in the onion. Thin the salsa out with more water if necessary. Taste and add sugar to if the salsa is too tart. Season with salt to taste.",
      "secondary_message": null
    }
  ],
