  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the red onion. Finely dice the radishes. Quarter, core, and roughly chop the radicchio. Pick the parsley leaves from the stems and chop them.",
      "secondary_message": "½ small red onion\n3 radishes\n170 g radicchio\n½ cup fresh parsley"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, add onion and pour enough vinegar over it to just cover. Let stand 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place almonds in a zipper-lock plastic bag, push out air, and seal. Using a skillet, smash almonds until roughly crushed.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Drain onions. In a large bowl, combine marinated onions, smashed almonds, beans, radishes, scallions, radicchio, and parsley. Drizzle with vinaigrette, tossing, until ingredients are lightly coated. Season with salt and pepper. Serve. Salad can be refrigerated up to 3 days.",
      "secondary_message": null
    }
  ],
