  "instructions": [
    {
      "id": 49815,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n1 English cucumber"
    },
    {
      "id": 49816,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer ½ of the garlic to a medium bowl (that will hold the ground beef mixture) and transfer the other ½ to a salad bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 49817,
      "primary_message": "To the garlic in the salad bowl, add olive oil, red wine vinegar, Dijon, oregano, salt, and pepper; whisk together.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp red wine vinegar\n½ tsp Dijon mustard\n1 tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 49818,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice ½ of the onion and transfer to the medium bowl with the garlic, then thinly slice the other ½ crosswise and add to the salad bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 49819,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 49820,
      "primary_message": "To the medium bowl, add the ground beef, ½ pkg of the feta (save the other ½ pkg for the salad), Dijon, oregano, salt, and pepper; mix until well combined. Form the mixture into 4 patties and place on a plate.",
      "secondary_message": "1 ½ lb lean ground beef\n1 (4 oz) pkg crumbled feta cheese\n2 tsp Dijon mustard\n2 tsp oregano\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 49821,
      "primary_message": "Place the patties in the skillet and cook until cooked through and golden brown, 4 to 6 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 49822,
      "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into ¼-inch-thick pieces at an angle. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 49823,
      "primary_message": "Halve the grape tomatoes and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 49824,
      "primary_message": "Add the olives and remaining feta to the salad bowl; toss to combine.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 49825,
      "primary_message": "To serve, divide the burger patties and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
