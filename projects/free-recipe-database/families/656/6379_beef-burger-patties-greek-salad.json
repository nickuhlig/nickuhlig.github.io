  "instructions": [
    {
      "id": 77882,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkg grape tomatoes\n1 ½ English cucumber"
    },
    {
      "id": 77881,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer ½ of the garlic to a medium bowl (that will hold the ground beef mixture) and transfer the other ½ to a salad bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 77880,
      "primary_message": "To the garlic in the salad bowl, add olive oil, red wine vinegar, Dijon, oregano, salt, and pepper; whisk together.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n¾ tsp Dijon mustard\n1 ½ tsp oregano\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 77879,
      "primary_message": "Trim off and discard the ends of the onions and remove the outer layer; small dice ½ of the onions and transfer to the medium bowl with the garlic, then thinly slice the other ½ crosswise and add to the salad bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 77878,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 77877,
      "primary_message": "To the medium bowl, add the ground beef, half of the feta (save the other half for the salad), Dijon, oregano, salt, and pepper; mix until well combined. Form the mixture into 6 patties and place on a plate.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ (113 g) pkg crumbled feta cheese\n3 tsp Dijon mustard\n3 tsp oregano\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 77876,
      "primary_message": "Place the patties in the skillet and cook until cooked through and golden brown, 4 to 6 minutes per side. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 77875,
      "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into 6-mm-thick pieces at an angle. Add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77874,
      "primary_message": "Halve the grape tomatoes and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 77873,
      "primary_message": "Add the olives and remaining feta to the salad bowl; toss to combine.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 77872,
      "primary_message": "To serve, divide the burger patties and salad between plates. Enjoy!",
      "secondary_message": ""
    }
  ],
