  "instructions": [
    {
      "id": 359582,
      "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 359583,
      "primary_message": "Roughly chop eggs and add to the bowl with the tuna.",
      "secondary_message": "6 hard-cooked eggs, peeled"
    },
    {
      "id": 359584,
      "primary_message": "Mince olives and capers; add to the bowl.",
      "secondary_message": "1 cup Kalamata olives, pitted\n3 tbsp capers"
    },
    {
      "id": 359585,
      "primary_message": "Add pesto and mayo to the bowl; stir to combine the tuna mixture and set aside.",
      "secondary_message": "1 cup sun-dried tomato pesto\n3 tbsp avocado oil mayonnaise"
    },
    {
      "id": 359586,
      "primary_message": "Place broccoli slaw in a large bowl.",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 359587,
      "primary_message": "Wash and dry lettuce; chop or tear into bite-sized pieces and add to the bowl with the broccoli slaw.",
      "secondary_message": "3 heads butter (Boston) lettuce"
    },
    {
      "id": 359588,
      "primary_message": "Crumble goat cheese into the bowl; add pine nuts and vinaigrette. Toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) logs goat cheese\n⅓ cup pine nuts\n⅓ cup French vinaigrette"
    },
    {
      "id": 359589,
      "primary_message": "To serve, divide salad between plates and top with tuna mixture. Enjoy!",
      "secondary_message": null
    }
  ],
