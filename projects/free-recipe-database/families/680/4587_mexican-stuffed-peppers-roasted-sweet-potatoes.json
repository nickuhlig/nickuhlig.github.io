  "instructions": [
    {
      "id": 291095,
      "primary_message": "Preheat oven to 425°F. Position racks in the upper and lower thirds of the oven. ",
      "secondary_message": null
    },
    {
      "id": 291096,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ lb sweet potato\n1 red bell pepper\n1 yellow bell pepper\n1 small bunch cilantro"
    },
    {
      "id": 291097,
      "primary_message": "Peel and mince garlic; place half in a medium bowl. (Set remaining garlic aside for later use.)",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 291098,
      "primary_message": "Juice lime into the bowl with the garlic, then add oil and spices; stir to combine the spice oil.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp paprika\n½ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 291099,
      "primary_message": "Quarter sweet potato lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl with the spice oil and toss to combine. Transfer to a baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 291100,
      "primary_message": "Place baking sheet on lower rack of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, about 25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 291101,
      "primary_message": "Meanwhile, trim, seed, and halve bell peppers lengthwise. Transfer to another baking sheet, cut-side up, and drizzle with oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 291102,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in the reserved bowl along with the remaining garlic. (Set the rest of the cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 291103,
      "primary_message": "Add ground beef, tomato sauce, and spices to the bowl with the cilantro and garlic; stir to combine the filling. ",
      "secondary_message": "½ lb lean ground beef\n½ (8 oz) can tomato sauce\n2 tsp chili powder\n1 tsp cumin, ground\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 291104,
      "primary_message": "Divide filling between pepper halves. Place baking sheet on upper rack of the oven; bake until the peppers are tender and beef is almost cooked through, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 291105,
      "primary_message": "While the peppers are cooking, coarsely grate cheddar.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 291106,
      "primary_message": "When the peppers are tender, remove from the oven and sprinkle with cheese. Return to the oven and continue to bake until the beef is cooked through and cheese is melted, 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 291107,
      "primary_message": "To serve, divide stuffed peppers and sweet potato between plates. Sprinkle with reserved cilantro and enjoy! ",
      "secondary_message": null
    }
  ],
