  "instructions": [
    {
      "id": 520598,
      "primary_message": "Preheat oven to 220°C (425°F). Position racks in the upper, center, and lower thirds of the oven. ",
      "secondary_message": null
    },
    {
      "id": 520599,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n0.68 kg sweet potato\n3 red bell peppers\n3 yellow bell peppers\n3 small bunches cilantro"
    },
    {
      "id": 520600,
      "primary_message": "Peel and mince garlic; place half in a large bowl. (Set remaining garlic aside for later use.)",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 520601,
      "primary_message": "Juice limes into the bowl with the garlic, then add oil and spices; stir to combine the spice oil.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp cumin, ground\n1 tbsp paprika\n1 ½ tsp crushed red pepper\n1 ½ tsp salt"
    },
    {
      "id": 520602,
      "primary_message": "Quarter sweet potatoes lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl with the spice oil and toss to combine. Transfer to a large baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 520603,
      "primary_message": "Place baking sheet on lower rack of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until fork-tender, about 30 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 520604,
      "primary_message": "Meanwhile, trim, seed, and halve bell peppers lengthwise. Divide between two baking sheets, cut-side up, and drizzle with oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 520605,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in the reserved bowl along with the remaining garlic. (Set the rest of the cilantro aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 520606,
      "primary_message": "Add veggie ground, tomato sauce, and spices to the bowl with the cilantro and garlic; stir to combine the filling. ",
      "secondary_message": "680 g veggie ground, plant based\n1 ½ (213 ml) cans tomato sauce\n2 tbsp chili powder\n1 tbsp cumin, ground\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 520607,
      "primary_message": "Divide filling between pepper halves. Place baking sheets on upper racks of the oven; bake until the peppers are tender and filling is almost cooked through, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 520608,
      "primary_message": "While the peppers are cooking, coarsely grate cheddar.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 520609,
      "primary_message": "When the peppers are tender, remove from the oven and sprinkle with cheese. Return to the oven and continue to bake until the filling is cooked through and cheese is melted, 5-6 minutes more.",
      "secondary_message": null
    },
    {
      "id": 520610,
      "primary_message": "To serve, divide stuffed peppers and sweet potato between plates. Sprinkle with reserved cilantro and enjoy! ",
      "secondary_message": null
    }
  ],
