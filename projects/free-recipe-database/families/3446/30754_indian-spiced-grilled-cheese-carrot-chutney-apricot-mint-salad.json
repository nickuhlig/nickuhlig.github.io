  "instructions": [
    {
      "id": 487755,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "2 medium carrots\n2 apricots\n½ small pkg fresh mint\n½ head butter (Boston) lettuce"
    },
    {
      "id": 487756,
      "primary_message": "Peel, trim, and coarsely grate carrots. Place in a small saucepan.",
      "secondary_message": null
    },
    {
      "id": 487757,
      "primary_message": "Add water, vinegar, sugar, and spices to the pan with the carrot. Bring to a boil over medium-high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until carrots are soft and most of the liquid has evaporated, about 10 minutes. Remove chutney from heat.",
      "secondary_message": "2 tbsp water\n2 tbsp white wine vinegar\n1 tbsp brown sugar\n¾ tsp garam masala\n¼ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 487758,
      "primary_message": "Meanwhile, place oil, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 487759,
      "primary_message": "Halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into thin slices and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 487760,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl with the dressing and set aside. (Reserve remaining mint for the sandwiches.)",
      "secondary_message": null
    },
    {
      "id": 487761,
      "primary_message": "Slice mozzarella into thin rounds.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 487762,
      "primary_message": "When the carrot chutney is done, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 487763,
      "primary_message": "While the skillet heats up, place the bread slices on a flat surface. Layer mozzarella, chutney, and reserved mint over half of the slices, then cover sandwiches with the remaining bread slices.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 487764,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place sandwiches in the skillet and cook until the bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 487765,
      "primary_message": "Remove the sandwiches to a plate and add more oil to the skillet. Return sandwiches to the skillet, browned-side up, and cook until golden brown on the other side and the cheese is melted, 2-4 minutes more. Once done, transfer to a cutting board and slice in half.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 487766,
      "primary_message": "Meanwhile, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing and apricots, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 487767,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
