  "instructions": [
    {
      "id": 514053,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 514054,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.36 kg new potatoes\n3 medium carrots\n1 small bunch green onions (scallions)\n3 red bell peppers\n6 sticks celery"
    },
    {
      "id": 514055,
      "primary_message": "Quarter new potatoes. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 514056,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Add to the baking sheets with the potato.",
      "secondary_message": null
    },
    {
      "id": 514057,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the baking sheets. (Set remaining green onions aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 514058,
      "primary_message": "Trim, seed, and large dice bell peppers; add to the baking sheets. Drizzle veggies with hot sauce and oil, then season with salt. Stir to combine and spread out in an even layer.",
      "secondary_message": "⅓ cup hot sauce\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 514059,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until veggies are fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 514060,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 514061,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 514062,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 514063,
      "primary_message": "While the bacon is cooking, using a clean cutting board, trim and thinly slice celery crosswise. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 514064,
      "primary_message": "Place yogurt, mayo, vinegar, Dijon, sugar, and spices in a small bowl; whisk dressing until smooth.",
      "secondary_message": "1 cup plain Greek yogurt\n3 tbsp mayonnaise\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 514065,
      "primary_message": "Add blue cheese to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled blue cheese"
    },
    {
      "id": 514066,
      "primary_message": "To serve, divide roasted veggies between bowls. Top with celery, reserved green onions, dressing, hot sauce, and crispy bacon. Enjoy!",
      "secondary_message": "3 tbsp hot sauce"
    }
  ],
