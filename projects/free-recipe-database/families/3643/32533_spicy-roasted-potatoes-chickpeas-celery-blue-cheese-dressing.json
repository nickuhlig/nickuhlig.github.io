  "instructions": [
    {
      "id": 514067,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 514068,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg new potatoes\n1 medium carrot\n½ small bunch green onions (scallions)\n1 red bell pepper\n2 sticks celery"
    },
    {
      "id": 514069,
      "primary_message": "Quarter new potatoes. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 514070,
      "primary_message": "Peel, trim, and slice carrot crosswise into ¼-inch thick rounds. Add to the baking sheet with the potato.",
      "secondary_message": null
    },
    {
      "id": 514071,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the baking sheet. (Set remaining green onions aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 514072,
      "primary_message": "Trim, seed, and large dice bell pepper; add to the baking sheet. Drizzle veggies with hot sauce and oil, then season with salt. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp hot sauce\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 514073,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 514074,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Place on paper towels and pat dry. Place in a small bowl, drizzle with hot sauce, and season with salt. Stir to combine and set aside to marinate.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n1 tbsp hot sauce\n⅛ tsp salt"
    },
    {
      "id": 514075,
      "primary_message": "Trim and thinly slice celery crosswise. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 514076,
      "primary_message": "Place yogurt, mayo, vinegar, Dijon, sugar, and spices in another small bowl; whisk dressing until smooth.",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp mayonnaise\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp brown sugar\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 514077,
      "primary_message": "Add blue cheese to the bowl with the dressing and stir to combine.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 514078,
      "primary_message": "To serve, divide roasted veggies between bowls. Top with dressing, marinated chickpeas, celery, and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
