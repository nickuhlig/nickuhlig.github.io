  "instructions": [
    {
      "id": 514079,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 514080,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.91 kg new potatoes\n2 medium carrots\n1 small bunch green onions (scallions)\n2 red bell peppers\n4 sticks celery"
    },
    {
      "id": 514081,
      "primary_message": "Quarter new potatoes. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 514082,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Add to the baking sheet with the potato.",
      "secondary_message": null
    },
    {
      "id": 514083,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the baking sheet. (Set remaining green onions aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 514084,
      "primary_message": "Trim, seed, and large dice bell peppers; add to the baking sheet. Drizzle veggies with hot sauce and oil, then season with salt. Stir to combine and spread out in an even layer.",
      "secondary_message": "¼ cup hot sauce\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 514085,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway, until veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 514086,
      "primary_message": "Meanwhile, drain and rinse chickpeas. Place on paper towels and pat dry. Place in a medium bowl, drizzle with hot sauce, and season with salt. Stir to combine and set aside to marinate.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp hot sauce\n¼ tsp salt"
    },
    {
      "id": 514087,
      "primary_message": "Trim and thinly slice celery crosswise. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 514088,
      "primary_message": "Place yogurt, mayo, vinegar, Dijon, sugar, and spices in a small bowl; whisk dressing until smooth.",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp mayonnaise\n4 tsp apple cider vinegar\n2 tsp Dijon mustard\n2 tsp brown sugar\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 514089,
      "primary_message": "Add blue cheese to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 514090,
      "primary_message": "To serve, divide roasted veggies between bowls. Top with dressing, marinated chickpeas, celery, and reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
