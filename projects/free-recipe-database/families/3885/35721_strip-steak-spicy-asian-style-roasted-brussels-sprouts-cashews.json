  "instructions": [
    {
      "id": 562573,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 562574,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.36 kg Brussels sprouts\n3 limes\n3 red chili peppers\n1 small bunch cilantro"
    },
    {
      "id": 562575,
      "primary_message": "Trim and halve Brussels sprouts lengthwise; divide between two large baking sheet pans. Drizzle with oil, season with salt, and stir to coat. Spread out in an even layer.",
      "secondary_message": "3 tbsp neutral vegetable oil\n¾ tsp salt"
    },
    {
      "id": 562576,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until Brussels sprouts are golden and fork-tender, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 562577,
      "primary_message": "Meanwhile, peel and mince shallots and garlic. Place both in a small bowl.",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 562578,
      "primary_message": "Juice limes into the bowl with the shallot and garlic. Add soy sauce, fish sauce, and sugar, then stir to combine the dressing. Transfer half of the dressing to a large bowl and set aside. (Reserve remaining dressing for serving.)",
      "secondary_message": "¼ cup soy sauce\n1 ½ tbsp fish sauce\n1 tbsp brown sugar"
    },
    {
      "id": 562579,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 562580,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt"
    },
    {
      "id": 562581,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 562582,
      "primary_message": "Meanwhile, thinly slice chili peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the large bowl with the dressing. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 562583,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 562584,
      "primary_message": "Roughly chop cashews. Add to the bowl.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 562585,
      "primary_message": "Add roasted Brussels sprouts to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 562586,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 562587,
      "primary_message": "Divide steak and Brussels sprouts between plates. Serve with reserved dressing for dipping steak and enjoy!",
      "secondary_message": null
    }
  ],
