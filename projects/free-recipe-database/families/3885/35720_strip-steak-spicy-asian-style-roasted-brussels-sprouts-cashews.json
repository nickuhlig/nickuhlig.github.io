  "instructions": [
    {
      "id": 562558,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 562559,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.91 kg Brussels sprouts\n2 limes\n2 red chili peppers\n1 small bunch cilantro"
    },
    {
      "id": 562560,
      "primary_message": "Trim and halve Brussels sprouts lengthwise; transfer to a large baking sheet pan. Drizzle with oil, season with salt, and stir to coat. Spread out in an even layer.",
      "secondary_message": "2 tbsp neutral vegetable oil\n½ tsp salt"
    },
    {
      "id": 562561,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until Brussels sprouts are golden and fork-tender, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 562562,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place both in a small bowl.",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 562563,
      "primary_message": "Juice limes into the bowl with the shallot and garlic. Add soy sauce, fish sauce, and sugar, then stir to combine the dressing. Transfer half of the dressing to a medium bowl and set aside. (Reserve remaining dressing for serving.)",
      "secondary_message": "3 tbsp soy sauce\n1 tbsp fish sauce\n2 tsp brown sugar"
    },
    {
      "id": 562564,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 562565,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt"
    },
    {
      "id": 562566,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 562567,
      "primary_message": "Meanwhile, thinly slice chili peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the medium bowl with the dressing. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 562568,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 562569,
      "primary_message": "Roughly chop cashews. Add to the bowl.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 562570,
      "primary_message": "Add roasted Brussels sprouts to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 562571,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 562572,
      "primary_message": "Divide steak and Brussels sprouts between plates. Serve with reserved dressing for dipping steak and enjoy!",
      "secondary_message": null
    }
  ],
