  "instructions": [
    {
      "id": 562453,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 562454,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb Brussels sprouts\n1 lime\n1 red chili pepper\n½ small bunch cilantro"
    },
    {
      "id": 562455,
      "primary_message": "Trim and halve Brussels sprouts lengthwise; transfer to a baking sheet pan. Drizzle with oil, season with salt, and stir to coat. Spread out in an even layer.",
      "secondary_message": "1 tbsp neutral vegetable oil\n¼ tsp salt"
    },
    {
      "id": 562456,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until Brussels sprouts are golden and fork-tender, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 562457,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place both in a small bowl.",
      "secondary_message": "½ shallot\n1 clove garlic"
    },
    {
      "id": 562458,
      "primary_message": "Juice lime into the bowl with the shallot and garlic. Add soy sauce, fish sauce, and sugar, then stir to combine the dressing. Transfer half of the dressing to a medium bowl and set aside. (Reserve remaining dressing for serving.)",
      "secondary_message": "1 ½ tbsp soy sauce\n1 ½ tsp fish sauce\n1 tsp brown sugar"
    },
    {
      "id": 562459,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 562460,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt"
    },
    {
      "id": 562461,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tsp neutral vegetable oil"
    },
    {
      "id": 562462,
      "primary_message": "Meanwhile, thinly slice chili pepper into rings; seed and remove ribs with a spoon to reduce spice level. Add to the medium bowl with the dressing. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 562463,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 562464,
      "primary_message": "Roughly chop cashews. Add to the bowl.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 562465,
      "primary_message": "Add roasted Brussels sprouts to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 562466,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 562467,
      "primary_message": "Divide steak and Brussels sprouts between plates. Serve with reserved dressing for dipping steak and enjoy!",
      "secondary_message": null
    }
  ],
