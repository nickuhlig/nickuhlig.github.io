  "instructions": [
    {
      "id": 1,
      "primary_message": "Set the chicken thighs skin-side down on a cutting board. Cut a 1.5 cm thick slash on either side of the thigh bone. Season the thighs on both sides with 1/2 teaspoon of salt and 1/2 teaspoon of pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the chicken thighs skin-side down on non-stick skillet. Only then turn the heat to high. When the chicken starts to sizzle, turn heat to medium and move the thighs around to make sure they aren't sticking to the skillet. Cover the skillet and cook for 16 to 18 minutes. Check the chicken occasionally to keep it from sticking. If the skin is browning too much after 10 minutes, then turn the heat to low. When done, transfer the thighs to a warm oven.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour off all but 2 tablespoons of the chicken fat in the skillet. Turn the heat to high and then add the onion, garlic, and mushrooms. Sauté, stirring often, for about 3 minutes. Sprinkle in the remaining salt and pepper. Then pour in the wine. Continue to cook for one minute over high heat until the sauce reduces.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spoon some of the sauce onto a plate and top with one of the chicken thighs. Sprinkle on some chives and serve.",
      "secondary_message": null
    }
  ],
