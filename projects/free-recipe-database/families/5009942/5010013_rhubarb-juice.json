  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the rhubarb stalks crosswise into 1-inch pieces.",
      "secondary_message": "0.91 kg rhubarb stalks"
    },
    {
      "id": 1,
      "primary_message": "In a large Dutch oven, combine rhubarb and water. Bring to a boil over high heat, cover, and reduce heat to simmer for 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain liquid through a fine-mesh strainer into a pitcher or spouted bowl, pressing on the solids in strainer to extract as much juice as possible.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Refrigerate until cold, at least 3 hours. If the juice separates, leaving a yellowish sludge at the bottom, decant the clear pink liquid into a clean bottle or pitcher, leaving the sludge behind. Serve cold over ice, adding sugar to taste, if desired.",
      "secondary_message": null
    }
  ],
