  "instructions": [
    {
      "primary_message": "Cut butter into small pieces. Place in a small saucepan, along with milk, and melt over medium heat.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ cup whole milk"
    },
    {
      "primary_message": "Meanwhile, place flour, sugar, baking powder, and salt in a medium bowl. Whisk to combine.",
      "secondary_message": "1 ⅛ cups all-purpose flour\n1 ½ tbsp granulated sugar\n2 ½ tsp baking powder\n¼ tsp salt"
    },
    {
      "primary_message": "Add melted butter mixture, eggs, and vanilla to the bowl with the flour. Whisk until batter is just combined (it doesn't need to be totally smooth).",
      "secondary_message": "½ tsp vanilla extract"
    },
    {
      "primary_message": "Add chocolate chips to the bowl with the batter. Whisk once more to incorporate.",
      "secondary_message": "½ cup dark chocolate chips"
    },
    {
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, using a scant ¼-cup measure (or ladle), drop batter into the skillet, spacing scoops a few inches apart. Cook, flipping once, until pancakes are golden and cooked through, 1-2 minutes per side. Remove to a plate.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim and thinly strawberries lengthwise. Using the tip of a knife, cut out a small triangle-shaped notch from the top of each strawberry to create a heart shape.",
      "secondary_message": "½ (454 g) pkg strawberries"
    },
    {
      "primary_message": "To serve, divide pancakes between plates; top with butter, strawberries, and maple syrup. Enjoy!",
      "secondary_message": "1 tbsp butter, unsalted\n¼ cup pure maple syrup"
    }
  ],
