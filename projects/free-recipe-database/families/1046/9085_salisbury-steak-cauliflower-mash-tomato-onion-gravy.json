  "instructions": [
    {
      "id": 178268,
      "primary_message": "Fill a large pot with about 1-inch of hot water from the tap; cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 178269,
      "primary_message": "Wash cauliflower heads and cut off the leaves; roughly chop into bite-sized pieces.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 178270,
      "primary_message": "Once the water in the pot is boiling, add cauliflower, reduce heat to medium, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 178271,
      "primary_message": "Meanwhile, combine ground beef, eggs, almond meal, and spices in a medium bowl and mix with your hands until well combined.",
      "secondary_message": "2 ¼ lb lean ground beef\n3 eggs\n3 tbsp almond meal/flour\n1 tbsp onion powder\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 178272,
      "primary_message": "Form ground beef mixture into 6 equal-sized, approximately 1-inch thick, patties and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 178273,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 178274,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 178275,
      "primary_message": "Cooking in batches if necessary, place the patties in the skillet and cook until they are well done, 4-5 minutes per side. Once done, transfer the patties to a clean plate and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 178276,
      "primary_message": "When the cauliflower is cooked, drain in a colander, transfer to a blender, and add butter, salt, and pepper; purée until smooth. (Process in batches if necessary). Transfer to a medium bowl, cover with aluminum foil, and set aside. Reserve blender for later use. ",
      "secondary_message": "3 tbsp butter, unsalted\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 178277,
      "primary_message": "Meanwhile, peel and mince the onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 178278,
      "primary_message": "Return the skillet to medium heat. Add butter and onion; cook, stirring occasionally, until golden, about 4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 178279,
      "primary_message": "Add tomato paste, Dijon, soy sauce, and broth to the skillet. Bring to a boil and remove from heat.",
      "secondary_message": "3 tbsp tomato paste\n2 tbsp Dijon mustard\n2 tbsp soy sauce\n12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 178280,
      "primary_message": "Pour the onion gravy into the blender and process until smooth, about 1 minute. Process in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 178281,
      "primary_message": "To serve, divide cauliflower mash and Salisbury steak between plates. Top with gravy and enjoy!",
      "secondary_message": null
    }
  ],
