  "instructions": [
    {
      "id": 178282,
      "primary_message": "Fill a medium saucepan with about 1-inch of hot water from the tap; cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 178283,
      "primary_message": "Wash cauliflower and cut off the leaves; roughly chop into bite-sized pieces.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 178284,
      "primary_message": "Once the water in the saucepan is boiling, add cauliflower, reduce heat to medium, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 178285,
      "primary_message": "Meanwhile, combine ground beef, egg, almond meal, and spices in a medium bowl and mix with your hands until well combined.",
      "secondary_message": "¾ lb lean ground beef\n1 egg\n1 tbsp almond meal/flour\n1 tsp onion powder\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 178286,
      "primary_message": "Form ground beef mixture into 2 equal-sized, approximately 1-inch thick, patties and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 178287,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 178288,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 178289,
      "primary_message": "Place the patties in the skillet and cook until they are well done, 4-5 minutes per side. Once done, transfer the patties to a clean plate and cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 178290,
      "primary_message": "When the cauliflower is cooked, drain in a colander, transfer to a blender and add butter, salt, and pepper; purée until smooth. Transfer to a medium bowl, cover with aluminum foil, and set aside. Reserve blender for later use.",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 178291,
      "primary_message": "Meanwhile, peel and mince the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 178292,
      "primary_message": "Return the skillet to medium heat. Add butter and onion; cook, stirring occasionally, until golden, about 4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 178293,
      "primary_message": "Add tomato paste, Dijon, coconut aminos, and broth to the skillet. Bring to a boil and remove from heat.",
      "secondary_message": "1 tbsp tomato paste\n2 tsp Dijon mustard\n2 tsp coconut aminos\n4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 178294,
      "primary_message": "Pour the onion gravy into the blender and process until smooth, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 178295,
      "primary_message": "To serve, divide cauliflower mash and Salisbury steak between plates. Top with gravy and enjoy!",
      "secondary_message": null
    }
  ],
