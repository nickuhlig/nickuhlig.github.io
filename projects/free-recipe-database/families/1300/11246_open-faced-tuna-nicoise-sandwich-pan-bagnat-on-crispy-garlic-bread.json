  "instructions": [
    {
      "id": 187164,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 187165,
      "primary_message": "Meanwhile, preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 187166,
      "primary_message": "Place peas in colander and run under cold water to thaw. Transfer to a clean towel or paper towels and pat dry; set aside.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 187167,
      "primary_message": "Place oil, vinegar, mayo, capers, and Dijon in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n2 tbsp mayonnaise\n1 tbsp capers\n2 tsp Dijon mustard"
    },
    {
      "id": 187168,
      "primary_message": "Drain tuna and add to the bowl with the dressing. Add peas, stir to combine, and set aside. ",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 187169,
      "primary_message": "Wash, dry, and slice tomatoes into rounds; place in a medium bowl. ",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 187170,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems. Add to the bowl with the tomatoes.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 187171,
      "primary_message": "Drain and thinly slice artichokes. Halve olives and add both to the bowl.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n1 cup Kalamata olives, pitted"
    },
    {
      "id": 187172,
      "primary_message": "Peel and thinly slice shallots into rings. Add to the bowl and toss to combine the sandwich topping; set aside. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 187173,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 187174,
      "primary_message": "Cut rolls in half and place, cut-side up, on a large baking sheet pan. Drizzle with oil, then sprinkle with minced garlic and Italian seasoning. Place in the oven and toast, until golden and slightly crisp, 4-5 minutes.",
      "secondary_message": "4 whole grain buns or rolls\n2 tbsp extra virgin olive oil\n½ tsp Italian seasoning"
    },
    {
      "id": 187175,
      "primary_message": "Meanwhile, peel and slice eggs into rounds.",
      "secondary_message": null
    },
    {
      "id": 187176,
      "primary_message": "Spoon tuna mixture over the toasted rolls; layer with sandwich topping and sliced eggs.",
      "secondary_message": null
    },
    {
      "id": 187177,
      "primary_message": "To serve, divide sandwiches between plates and enjoy! ",
      "secondary_message": null
    }
  ],
