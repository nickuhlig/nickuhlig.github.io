  "instructions": [
    {
      "id": 108640,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 108641,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg green beans\n0.68 kg sweet potato"
    },
    {
      "id": 108642,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 108643,
      "primary_message": "When pan is hot, add almond meal and bread crumbs to dry pan. Toast, stirring often, until golden brown; about 2 minutes. Transfer the breading mix to a medium bowl and set pan aside to use later.",
      "secondary_message": "⅓ cup almond meal/flour\n1 ½ cup panko bread crumbs"
    },
    {
      "id": 108644,
      "primary_message": "Add salt and pepper to the bowl with the almonds and bread crumbs and stir to combine.",
      "secondary_message": "1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 108645,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 108646,
      "primary_message": "Crack the egg into another medium bowl and beat with a whisk or fork.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 108647,
      "primary_message": "One piece at a time, dip chicken fillets in the beaten egg (letting the excess drip off), then in the almond mixture (pressing to adhere) and place on a parchment lined baking sheet. Cook in the center of the oven until golden brown and cooked through; about 18 minutes.",
      "secondary_message": null
    },
    {
      "id": 108648,
      "primary_message": "Peel and cut the sweet potatoes into 1-inch cubes; transfer to a small saucepan. Add water to the saucepan, covering the potatoes, cover with a lid, and bring to a boil. Reduce heat to medium-low and cook until they are tender when pierced with a fork, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 108649,
      "primary_message": "Trim and discard the ends of the green beans.",
      "secondary_message": null
    },
    {
      "id": 108650,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 108651,
      "primary_message": "Peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 108652,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom. Add the beans, garlic, salt, and pepper. Cook, stirring occasionally, until the beans are tender-crisp, 3-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 108653,
      "primary_message": "Once the potatoes are tender, remove from heat, carefully scoop out ½ cup of the water and set aside. Drain the potatoes in a colander and return them back to the saucepan.",
      "secondary_message": null
    },
    {
      "id": 108654,
      "primary_message": "Add maple syrup, butter, salt, pepper and the reserved cooking water (if needed) to the potatoes; mash with a potato masher (or fork) until smooth.",
      "secondary_message": "2 tbsp pure maple syrup\n2 tsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 108655,
      "primary_message": "To serve, divide the almond-crusted chicken, green beans, and maple mash between plates. Enjoy!",
      "secondary_message": null
    }
  ],
