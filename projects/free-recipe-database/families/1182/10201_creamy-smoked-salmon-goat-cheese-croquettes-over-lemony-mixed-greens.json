  "instructions": [
    {
      "id": 162602,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 162603,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread crumbs and toast, stirring constantly, until crisp and golden. Immediately transfer to a plate and spread out in an even layer; set aside to cool.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 cup panko bread crumbs"
    },
    {
      "id": 162604,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small bunch green onions (scallions)\n2 medium carrots\n1 bunch radish\n1 pint grape tomatoes\n1 English cucumber\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 162605,
      "primary_message": "Zest lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 162606,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces. Add to the bowl with the lemon zest.",
      "secondary_message": null
    },
    {
      "id": 162607,
      "primary_message": "Roughly chop salmon into ¼-inch pieces; add to the bowl.",
      "secondary_message": "1 (4 oz) pkg smoked salmon"
    },
    {
      "id": 162608,
      "primary_message": "Crumble goat cheese into the bowl. Add mayo, dill, and crushed red pepper; mash with a fork to combine. Set aside.",
      "secondary_message": "2 (4 oz) logs goat cheese\n2 tbsp mayonnaise\n1 tsp dill\n⅛ tsp crushed red pepper"
    },
    {
      "id": 162609,
      "primary_message": "Juice lemon into a large salad bowl. Add oil, vinegar, maple syrup, and spices; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tsp white wine vinegar\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper\n¼ tsp dill"
    },
    {
      "id": 162610,
      "primary_message": "Trim carrots and peel into thin noodle-like sticks using a julienne (or regular) peeler. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 162611,
      "primary_message": "Trim radishes and thinly slice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 162612,
      "primary_message": "Halve tomatoes crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 162613,
      "primary_message": "Trim and thinly slice cucumber. Add to the salad bowl along with the mixed greens and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 162614,
      "primary_message": "Using a level tablespoon measure, form the goat cheese mixture into balls and place on the dish with the bread crumbs. Roll each goat cheese ball in the bread crumbs to coat.",
      "secondary_message": null
    },
    {
      "id": 162615,
      "primary_message": "To serve, divide salad between plates or bowls and top with goat cheese croquettes. Sprinkle any remaining bread crumbs over the salad and enjoy!",
      "secondary_message": null
    }
  ],
