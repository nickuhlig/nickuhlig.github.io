  "ingredients": [
    {
      "ingredient_id": 115,
      "name": "butter, cut into three even pieces",
      "quantity": "2 tbsp"
    },
    {
      "ingredient_id": 1216,
      "name": "hearty white bread, such as Pepperidge Farm or Arnold",
      "quantity": "2 slices"
    },
    {
      "ingredient_id": 1264,
      "name": "American cheese",
      "quantity": "2 slices"
    },
    {
      "ingredient_id": 1260,
      "name": "potato chips",
      "quantity": "1 big handful"
    },
    {
      "ingredient_id": 88,
