  "instructions": [
    {
      "id": 357109,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 357110,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Place half in a medium bowl, reserving the rest for garnish. ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 357111,
      "primary_message": "Peel and mince shallot and garlic. Transfer both to the bowl with the parsley.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 357112,
      "primary_message": "Add turkey, egg, bread crumbs, and spices to the bowl with the parsley and mix with your hands until well combined. ",
      "secondary_message": "⅓ kg ground turkey\n1 egg\n3 tbsp panko bread crumbs\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 357113,
      "primary_message": "Coat baking dish with a thin layer of oil. Using a tablespoon measure, form the meat mixture into rounded meatballs and place in the dish. Place the dish in the oven and bake until cooked through, 15-18 minutes. ",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 357114,
      "primary_message": "Meanwhile, peel additional garlic and place in a blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 357115,
      "primary_message": "Drain tomatoes and add to the blender along with sugar and spices. Blend on high until almost smooth.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n1 tsp brown sugar\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 357116,
      "primary_message": "Combine tomato purée and oil in a medium saucepan over medium-low heat; cook, stirring often, until sauce is thick and garlic is cooked through, 5-8 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 357117,
      "primary_message": "Meanwhile, coarsely grate mozzarella; finely grate Parmesan. Transfer both to a small bowl and toss to combine; set aside.",
      "secondary_message": "½ (227 g) block mozzarella cheese\n14 g Parmesan cheese"
    },
    {
      "id": 357118,
      "primary_message": "When the meatballs are done, carefully transfer them to the pan with the tomato sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 357119,
      "primary_message": "Set oven temperature to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 357120,
      "primary_message": "Split the rolls in half and place on a baking sheet pan, cut-side facing up. Place in the oven and cook until lightly toasted, 1-2 minutes. Remove from the oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 357121,
      "primary_message": "Set the tops of the rolls aside, leaving the bottoms on the baking sheet pan. Sprinkle bottom of rolls with half of the cheese. Divide meatballs and sauce between the rolls and top with remaining cheese. Place in the oven and broil to melt the cheese, about 1 minute. ",
      "secondary_message": null
    },
    {
      "id": 357122,
      "primary_message": "To serve, sprinkle reserved parsley and crushed red pepper over each sandwich. Close sandwiches and divide between plates. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
