  "instructions": [
    {
      "id": 357182,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 357183,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Place half in a large bowl, reserving the rest for garnish. ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 357184,
      "primary_message": "Peel and mince onion and garlic. Add both to the bowl with the parsley.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 357185,
      "primary_message": "Add veggie ground, eggs, bread crumbs, and spices to the bowl. Mix with your hands until well combined. ",
      "secondary_message": "680 g veggie ground, plant based\n3 eggs\n¾ cup panko bread crumbs\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 357186,
      "primary_message": "Coat a large baking sheet pan with a thin layer of oil. Using a tablespoon measure, form the mixture into rounded \"meatballs\" and arrange on the baking sheet. Place in the oven (it doesn't have to be fully heated) and bake until cooked through, 15-18 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 357187,
      "primary_message": "Meanwhile, peel additional garlic and place in a blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 357188,
      "primary_message": "Drain tomatoes; add to the blender along with sugar and spices. Blend on high until almost smooth.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n1 tbsp brown sugar\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 357189,
      "primary_message": "Combine tomato purée and oil in a large pot over medium-low heat. Cook, stirring often, until sauce is thick and garlic is cooked through, 7-10 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 357190,
      "primary_message": "Meanwhile, coarsely grate mozzarella; finely grate Parmesan. Transfer both to a medium bowl and toss to combine; set aside.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese\n43 g Parmesan cheese"
    },
    {
      "id": 357191,
      "primary_message": "When the meatballs are done, carefully transfer them to the pot with the tomato sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 357192,
      "primary_message": "Set oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 357193,
      "primary_message": "Split the rolls in half and divide between two additional baking sheets, cut-side facing up. Working in batches, place in the oven and broil until lightly toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 357194,
      "primary_message": "Set the tops of the rolls aside, leaving the bottoms on the baking sheets. Sprinkle bottom of rolls with half of the cheese. Divide meatballs and sauce between the rolls and top with remaining cheese. ",
      "secondary_message": null
    },
    {
      "id": 357195,
      "primary_message": "Working in batches, return baking sheets to the oven and broil until cheese is melted, about 1 minute. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 357196,
      "primary_message": "To serve, sprinkle reserved parsley and crushed red pepper over each sandwich. Close sandwiches and divide between plates. Enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
