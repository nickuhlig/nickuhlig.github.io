  "instructions": [
    {
      "id": 357006,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 357007,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Place half in a large bowl, reserving the rest for garnish. ",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 357008,
      "primary_message": "Peel and mince onion and garlic. Transfer both to the bowl with the parsley.",
      "secondary_message": "1 medium red onion\n3 cloves garlic"
    },
    {
      "id": 357009,
      "primary_message": "Add turkey, eggs, bread crumbs, and spices to the bowl with the parsley and mix with your hands until well combined. ",
      "secondary_message": "2 ¼ lb ground turkey\n3 eggs\n½ cup panko bread crumbs\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 357010,
      "primary_message": "Coat a large baking sheet pan with a thin layer of oil. Using a tablespoon measure, form the meat mixture into rounded meatballs and place in the dish. Place meatballs in the oven and bake until cooked through, about 18 minutes. ",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 357011,
      "primary_message": "Meanwhile, peel additional garlic and place in a blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 357012,
      "primary_message": "Drain tomatoes and add to the blender along with sugar and spices. Blend on high until almost smooth.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n1 tbsp brown sugar\n1 ½ tsp Italian seasoning\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 357013,
      "primary_message": "Combine tomato purée and oil in a large pot over medium-low heat; cook, stirring often, until sauce is thick and garlic is cooked through, 7-10 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 357014,
      "primary_message": "Meanwhile, coarsely grate mozzarella; finely grate Parmesan. Transfer both to a medium bowl and toss to combine; set aside.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese\n1 ½ oz Parmesan cheese"
    },
    {
      "id": 357015,
      "primary_message": "When the meatballs are done, carefully transfer them to the pot with the tomato sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 357016,
      "primary_message": "Set oven temperature to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 357017,
      "primary_message": "Split the rolls in half and divide between two additional baking sheets, cut-side facing up. Working in batches if necessary, place in the oven and broil until lightly toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 357018,
      "primary_message": "Set the tops of the rolls aside, leaving the bottoms on the baking sheets. Sprinkle bottom of rolls with half of the cheese. Divide meatballs and sauce between the rolls and top with remaining cheese.",
      "secondary_message": null
    },
    {
      "id": 357019,
      "primary_message": "Working in batches, return baking sheets to the oven and broil until cheese is melted, about 1 minute. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 357020,
      "primary_message": "To serve, sprinkle reserved parsley and crushed red pepper over each sandwich. Close sandwiches and divide between plates. Enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
