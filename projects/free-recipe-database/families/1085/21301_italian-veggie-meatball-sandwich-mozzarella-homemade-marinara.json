  "instructions": [
    {
      "id": 357021,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 357022,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Place half in a medium bowl, reserving the rest for garnish. ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 357023,
      "primary_message": "Peel and mince shallot and garlic. Add both to the bowl with the parsley.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 357024,
      "primary_message": "Add veggie ground, egg, bread crumbs, and spices to the bowl. Mix with your hands until well combined. ",
      "secondary_message": "8 oz veggie ground, plant based\n1 egg\n¼ cup panko bread crumbs\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 357025,
      "primary_message": "Coat a baking dish with a thin layer of oil. Using a tablespoon measure, form the mixture into rounded \"meatballs\" and arrange in the dish. Place dish in the oven (it doesn't have to be fully heated) and bake until cooked through, about 15 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 357026,
      "primary_message": "Meanwhile, peel additional garlic and place in a blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 357027,
      "primary_message": "Drain tomatoes; add to the blender along with sugar and spices. Blend on high until almost smooth.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n1 tsp brown sugar\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 357028,
      "primary_message": "Combine tomato purée and oil in a medium saucepan over medium-low heat. Cook, stirring often, until sauce is thick and garlic is cooked through, 5-8 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 357029,
      "primary_message": "Meanwhile, coarsely grate mozzarella; finely grate Parmesan. Transfer both to a small bowl and toss to combine; set aside.",
      "secondary_message": "½ (8 oz) block mozzarella cheese\n½ oz Parmesan cheese"
    },
    {
      "id": 357030,
      "primary_message": "When the meatballs are done, carefully transfer them to the pan with the tomato sauce; stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 357031,
      "primary_message": "Set oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 357032,
      "primary_message": "Split the rolls in half and transfer to a baking sheet pan, cut-side facing up. Place in the oven and broil until lightly toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 357033,
      "primary_message": "Set the tops of the rolls aside, leaving the bottoms on the baking sheet. Sprinkle bottom of rolls with half of the cheese. Divide meatballs and sauce between the rolls and top with remaining cheese. ",
      "secondary_message": null
    },
    {
      "id": 357034,
      "primary_message": "Return baking sheet to the oven and broil until cheese is melted, about 1 minute. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 357035,
      "primary_message": "To serve, sprinkle reserved parsley and crushed red pepper over each sandwich. Close sandwiches and divide between plates. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
