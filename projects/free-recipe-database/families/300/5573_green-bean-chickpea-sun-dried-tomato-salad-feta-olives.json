  "instructions": [
    {
      "id": 66698,
      "primary_message": "Preheat the oven to 200°C (400°F) and position rack in the centre. Line a baking sheet with parchment paper.",
      "secondary_message": ""
    },
    {
      "id": 66697,
      "primary_message": "Rinse the green beans. Trim ends, halve, and transfer to the baking sheet. Drizzle with olive oil and season with salt and pepper; toss to coat.",
      "secondary_message": "0.681 kg green beans\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 66696,
      "primary_message": "Place in the oven and roast until lightly charred, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 66695,
      "primary_message": "Rinse the chickpeas and set aside to drain.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 66694,
      "primary_message": "Peel and mince the garlic. Grate zest from the lemons. In a large bowl, whisk together the minced garlic, lemon zest and juice, olive oil, salt, and pepper.",
      "secondary_message": "3 cloves garlic\nzest and juice of 1 ½ lemon\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 66693,
      "primary_message": "Wash the tomatoes and parsley. Halve the tomatoes and add to the bowl. Shave the parsley leaves off the stems; discard the stems, chop the leaves, and add to the bowl.",
      "secondary_message": "1 ½ small pkg grape tomatoes\n1 ½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 66692,
      "primary_message": "Halve the olives and add to the bowl.",
      "secondary_message": "1 ½ cups Kalamata olives, pitted"
    },
    {
      "id": 66691,
      "primary_message": "Thinly slice the sun-dried tomatoes and add to the bowl.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 66690,
      "primary_message": "Stir in the chickpeas, green beans, and feta. Toss to coat.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 66689,
      "primary_message": "To serve, place salad on a plate and enjoy!",
      "secondary_message": ""
    }
  ],
