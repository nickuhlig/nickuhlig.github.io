  "instructions": [
    {
      "primary_message": "Place frozen chicken patties on a paper towel-lined (microwave safe) plate. Microwave on high, until heated through, 3-4 minutes. Top patties with cheese and microwave once more until cheese is melted, about 30 seconds. Allow to rest for 1-2 minutes.",
      "secondary_message": "2 slice pepper jack cheese, sliced"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and slice tomato crosswise into thin rounds. Season with salt and pepper.",
      "secondary_message": "1 tomato\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Toast buns if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "To assemble burgers, spread bottom side of the buns with guacamole, then top with a cheesy chicken patty and tomato slices. Close with top half of the bun.",
      "secondary_message": "⅓ cup guacamole"
    },
    {
      "primary_message": "To serve, divide burgers between plates. Enjoy!",
      "secondary_message": null
    }
  ],
