  "instructions": [
    {
      "id": 450586,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 450587,
      "primary_message": "Place eggs, Dijon, soy sauce, and spices in a medium bowl. Whisk until smooth. ",
      "secondary_message": "4 eggs\n4 tsp Dijon mustard\n2 tsp soy sauce\n½ tsp salt\n¼ tsp black pepper\n¼ tsp paprika"
    },
    {
      "id": 450588,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the egg mixture and whisk once more to combine. Set aside.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 450589,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. ",
      "secondary_message": "8 slices sourdough bread"
    },
    {
      "id": 450590,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg chives\n1 (5 oz) pkg spring mix (mixed greens)\n4 tomatoes"
    },
    {
      "id": 450591,
      "primary_message": "Divide cheesy egg mixture between toast slices, spreading it to the edges. Return toast to the oven and broil until topping is golden and bubbling at the edges, 1-2 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 450592,
      "primary_message": "Meanwhile, chop chives into small pieces. Place half in a clean medium bowl along with oil, vinegar, honey, Dijon, salt, and pepper. Whisk to combine the dressing. (Reserve remaining chives for serving.)",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp honey\n2 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 450593,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 450594,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Divide between toasts, then season with salt and pepper.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 450595,
      "primary_message": "Divide Welsh rarebit between plates and sprinkle with reserved chives. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
