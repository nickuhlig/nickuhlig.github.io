  "instructions": [
    {
      "id": 450656,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 450657,
      "primary_message": "Place eggs, Dijon, soy sauce, and spices in a medium bowl. Whisk until smooth. ",
      "secondary_message": "6 eggs\n2 tbsp Dijon mustard\n1 tbsp soy sauce\n¾ tsp salt\n½ tsp black pepper\n¼ tsp paprika"
    },
    {
      "id": 450658,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the egg mixture and whisk once more to combine. Set aside.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 450659,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. ",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 450660,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pkg chives\n1 ½ (142 g) pkgs spring mix (mixed greens)\n6 tomatoes"
    },
    {
      "id": 450661,
      "primary_message": "Divide cheesy egg mixture between toast slices, spreading it to the edges. Working in batches, return toast to the oven and broil until topping is golden and bubbling at the edges, 1-2 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 450662,
      "primary_message": "Meanwhile, chop chives into small pieces. Place half in a large bowl along with oil, vinegar, honey, Dijon, salt, and pepper. Whisk to combine the dressing. (Reserve remaining chives for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp honey\n1 tbsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 450663,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 450664,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Divide between toasts, then season with salt and pepper.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 450665,
      "primary_message": "Divide Welsh rarebit between plates and sprinkle with reserved chives. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
