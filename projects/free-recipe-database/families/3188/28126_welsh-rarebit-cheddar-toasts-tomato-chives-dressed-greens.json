  "instructions": [
    {
      "id": 450546,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 450547,
      "primary_message": "Place eggs, Dijon, Worcestershire, and spices in a small bowl. Whisk until smooth. ",
      "secondary_message": "2 eggs\n2 tsp Dijon mustard\n1 ½ tsp Worcestershire sauce\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp paprika"
    },
    {
      "id": 450548,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the egg mixture and whisk once more to combine. Set aside.",
      "secondary_message": "⅓ (8 oz) block cheddar cheese"
    },
    {
      "id": 450549,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. ",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 450550,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small pkg chives\n½ (5 oz) pkg spring mix (mixed greens)\n2 tomatoes"
    },
    {
      "id": 450551,
      "primary_message": "Divide cheesy egg mixture between toast slices, spreading it to the edges. Return toast to the oven and broil until topping is golden and bubbling at the edges, 1-2 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 450552,
      "primary_message": "Meanwhile, chop chives into small pieces. Place half in a medium bowl along with oil, vinegar, honey, Dijon, salt, and pepper. Whisk to combine the dressing. (Reserve remaining chives for serving.)",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp honey\n1 tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 450553,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 450554,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Divide between toasts, then season with salt and pepper. ",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 450555,
      "primary_message": "Divide Welsh rarebit between plates and sprinkle with reserved chives. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
