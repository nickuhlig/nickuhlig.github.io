  "instructions": [
    {
      "id": 521547,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 521548,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potato\n1 medium beet\n2 pears\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 521549,
      "primary_message": "Peel and medium dice sweet potato. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 521550,
      "primary_message": "Peel and trim beet; halve lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the baking sheet with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 521551,
      "primary_message": "Quarter, core, and slice pears lengthwise into ½-inch wedges. Add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 521552,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the baking sheet. Drizzle veggies and pears with oil, then season with spices; toss to coat and spread out in an even layer. (Reserve remaining parsley for serving.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 521553,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies and pears are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 521554,
      "primary_message": "When the roasted veggies and pears have about 7 minutes left, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 521555,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces. Place in a small bowl along with soy sauce, salt, and pepper; stir gently to coat.",
      "secondary_message": "1 (8 oz) package tempeh\n1 tsp soy sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 521556,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tempeh in a single layer and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 521557,
      "primary_message": "To serve, divide tempeh, roasted sweet potatoes, beets, and pears between plates. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
