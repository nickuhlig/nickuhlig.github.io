  "instructions": [
    {
      "id": 521523,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 521524,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n2 medium beets\n4 pears\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 521525,
      "primary_message": "Peel and medium dice sweet potatoes. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 521526,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the baking sheet with the sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 521527,
      "primary_message": "Quarter, core, and slice pears lengthwise into ½-inch wedges. Add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 521528,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the baking sheet. Drizzle veggies and pears with oil, then season with spices; toss to coat and spread out in an even layer. (Reserve remaining parsley for serving.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp onion powder\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 521529,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies and pears are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 521530,
      "primary_message": "When the roasted veggies and pears have about 12 minutes left, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 521531,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 521532,
      "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 521533,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 521534,
      "primary_message": "To serve, divide steak, roasted sweet potatoes, beets, and pears between plates. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
