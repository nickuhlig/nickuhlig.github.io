  "instructions": [
    {
      "id": 521569,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 521570,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n3 medium beets\n6 pears\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 521571,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 521572,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the baking sheets with the sweet potatoes.",
      "secondary_message": null
    },
    {
      "id": 521573,
      "primary_message": "Quarter, core, and slice pears lengthwise into ½-inch wedges. Add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 521574,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the baking sheets. Drizzle veggies and pears with oil, then season with spices; toss to coat and spread out in an even layer. (Reserve remaining parsley for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 521575,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies and pears are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 521576,
      "primary_message": "When the roasted veggies and pears have about 10 minutes left, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 521577,
      "primary_message": "While the skillet heats up, slice tempeh crosswise into ½-inch thick pieces. Place in a medium bowl along with soy sauce, salt, and pepper; stir gently to coat.",
      "secondary_message": "3 (8 oz) packages tempeh\n1 tbsp soy sauce\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 521578,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh in a single layer and cook, flipping once, until browned and warmed through, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 521579,
      "primary_message": "To serve, divide tempeh, roasted sweet potatoes, beets, and pears between plates. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
