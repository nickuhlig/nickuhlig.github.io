  "instructions": [
    {
      "id": 512644,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 512645,
      "primary_message": "Drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n3 tbsp extra virgin olive oil\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp coriander, ground\n¾ tsp cumin, ground\n3 pinch cinnamon, ground"
    },
    {
      "id": 512646,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 512647,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "1 ½ cups whole wheat couscous\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 512648,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small pkg fresh basil\n6 plums\n1 ½ English cucumbers"
    },
    {
      "id": 512649,
      "primary_message": "Zest and juice lemons into a large bowl. Add tahini, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp tahini\n2 tbsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 512650,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 512651,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512652,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512653,
      "primary_message": "Roughly chop apricots. Add to the bowl and set aside.",
      "secondary_message": "18 dried apricots"
    },
    {
      "id": 512654,
      "primary_message": "When the couscous is done, transfer to another baking sheet. Spread out in an even layer and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 512655,
      "primary_message": "Add cooled couscous to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 512656,
      "primary_message": "To serve, divide couscous salad and chickpeas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
