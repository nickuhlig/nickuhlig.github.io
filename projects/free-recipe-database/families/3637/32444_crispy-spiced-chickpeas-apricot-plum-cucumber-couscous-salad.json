  "instructions": [
    {
      "id": 512787,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 512788,
      "primary_message": "Drain and rinse chickpeas. Transfer to a large baking sheet pan and pat dry with paper towels. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper\n½ tsp coriander, ground\n½ tsp cumin, ground\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 512789,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 15-18 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 512790,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "1 cup whole wheat couscous\n473 ml chicken or vegetable broth"
    },
    {
      "id": 512791,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small pkg fresh basil\n4 plums\n1 English cucumber"
    },
    {
      "id": 512792,
      "primary_message": "Zest and juice lemon into a large bowl. Add tahini, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp tahini\n4 tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 512793,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 512794,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512795,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512796,
      "primary_message": "Roughly chop apricots. Add to the bowl and set aside.",
      "secondary_message": "12 dried apricots"
    },
    {
      "id": 512797,
      "primary_message": "When the couscous is done, transfer to a baking sheet. Spread out in an even layer and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 512798,
      "primary_message": "Add cooled couscous to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 512799,
      "primary_message": "To serve, divide couscous salad and chickpeas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
