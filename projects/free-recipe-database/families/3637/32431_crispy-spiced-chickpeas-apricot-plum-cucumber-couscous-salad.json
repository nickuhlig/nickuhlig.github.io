  "instructions": [
    {
      "id": 512618,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 512619,
      "primary_message": "Drain and rinse chickpeas. Transfer to a baking sheet pan and pat dry with paper towels. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n1 tbsp extra virgin olive oil\n½ tsp paprika\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp coriander, ground\n¼ tsp cumin, ground\n1 pinch cinnamon, ground"
    },
    {
      "id": 512620,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 15-18 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 512621,
      "primary_message": "Meanwhile, in a small saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "½ cup whole wheat couscous\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 512622,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg fresh basil\n2 plums\n½ English cucumber"
    },
    {
      "id": 512623,
      "primary_message": "Zest and juice lemon into a medium bowl. Add tahini, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp tahini\n2 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 512624,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 512625,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512626,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512627,
      "primary_message": "Roughly chop apricots. Add to the bowl and set aside.",
      "secondary_message": "6 dried apricots"
    },
    {
      "id": 512628,
      "primary_message": "When the couscous is done, transfer to another baking sheet. Spread out in an even layer and let cool slightly, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 512629,
      "primary_message": "Add cooled couscous to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 512630,
      "primary_message": "To serve, divide couscous salad and chickpeas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
