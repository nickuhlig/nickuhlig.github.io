  "instructions": [
    {
      "id": 512579,
      "primary_message": "In a small saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 512580,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 512581,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate. Season with spices on the top-side.",
      "secondary_message": "¾ lb salmon fillet\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper\n¼ tsp coriander, ground\n¼ tsp cumin, ground\n1 pinch cinnamon, ground"
    },
    {
      "id": 512582,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 512583,
      "primary_message": "While the salmon is cooking, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small pkg fresh basil\n2 plums\n½ English cucumber"
    },
    {
      "id": 512584,
      "primary_message": "Zest and juice lemon into a medium bowl. Add tahini, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp tahini\n2 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 512585,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 512586,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512587,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512588,
      "primary_message": "Roughly chop apricots. Add to the bowl and set aside. ",
      "secondary_message": "6 dried apricots"
    },
    {
      "id": 512589,
      "primary_message": "When the couscous is done, transfer to a baking sheet pan. Spread out in an even layer and let cool slightly, 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 512590,
      "primary_message": "Add cooled couscous to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 512591,
      "primary_message": "To serve, divide couscous salad and salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
