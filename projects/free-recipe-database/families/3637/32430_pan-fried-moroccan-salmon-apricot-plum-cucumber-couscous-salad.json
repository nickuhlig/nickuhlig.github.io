  "instructions": [
    {
      "id": 512605,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 512606,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 512607,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate. Season with spices on the top-side.",
      "secondary_message": "2 ¼ lb salmon fillet\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp coriander, ground\n¾ tsp cumin, ground\n3 pinch cinnamon, ground"
    },
    {
      "id": 512608,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 512609,
      "primary_message": "While the salmon is cooking, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small pkg fresh basil\n6 plums\n1 ½ English cucumbers"
    },
    {
      "id": 512610,
      "primary_message": "Zest and juice lemons into a large bowl. Add tahini, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp tahini\n2 tbsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 512611,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 512612,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512613,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 512614,
      "primary_message": "Roughly chop apricots. Add to the bowl and set aside. ",
      "secondary_message": "18 dried apricots"
    },
    {
      "id": 512615,
      "primary_message": "When the couscous is done, transfer to a large baking sheet pan. Spread out in an even layer and let cool slightly, 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 512616,
      "primary_message": "Add cooled couscous to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 512617,
      "primary_message": "To serve, divide couscous salad and salmon between plates. Enjoy!",
      "secondary_message": null
    }
  ],
