  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch green onion (scallion)\n1 (142 g) pkg baby spinach"
    },
    {
      "primary_message": "Peel and medium dice sweet potatoes. Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Set a 6-quart electric pressure cooker to sauté on HIGH.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pressure cooker heats up, trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pressure cooker insert is hot, add oil and swirl to coat the bottom. Add green onions, mushrooms, ginger, and salt; cook, stirring occasionally, until mushrooms are starting to soften, 2-3 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n1 (227 g) pkg sliced white mushrooms\n2 tbsp ginger paste\n¼ tsp salt"
    },
    {
      "primary_message": "Add sweet potato, broth, and spinach to the insert (do not stir), then lock lid and set to pressure cook on HIGH for 2 minutes. Once done, drape a clean towel over the vent, then manually release pressure. ",
      "secondary_message": "8 cups chicken or vegetable broth"
    },
    {
      "primary_message": "Meanwhile, medium dice tofu.",
      "secondary_message": "2 (340 g) pkg extra firm tofu"
    },
    {
      "primary_message": "When the pressure is released, carefully open and remove a 1/2-cup of broth to a small bowl; add miso paste and chili-garlic sauce, then whisk to combine. Return miso-broth mixture to the pressure cooker, along with tofu, and stir to combine the soup.",
      "secondary_message": "½ cup miso paste, white\n1 tbsp chili-garlic sauce"
    },
    {
      "primary_message": "Set the pressure cooker to sauté on HIGH and cook, stirring occasionally, until tofu is warmed through, 1-2 minutes more. ",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide soup between bowls and drizzle with additional oil. Enjoy!",
      "secondary_message": "1 tbsp toasted sesame oil"
    }
  ],
