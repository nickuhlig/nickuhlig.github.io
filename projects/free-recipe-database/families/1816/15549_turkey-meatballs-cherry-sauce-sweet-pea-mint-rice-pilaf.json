  "instructions": [
    {
      "id": 335389,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 335390,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 335391,
      "primary_message": "Wash, dry, and pick mint leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve remaining mint for the rice.)",
      "secondary_message": "1 small pkg fresh mint"
    },
    {
      "id": 335392,
      "primary_message": "Peel and mince garlic; add to the bowl with the mint along with turkey, eggs, bread crumbs, and spices. Using your hands, mix well to combine.",
      "secondary_message": "2 cloves garlic\n1 ½ lb ground turkey\n2 eggs\n⅔ cup panko bread crumbs\n2 tsp parsley flakes\n1 tsp sage, dried\n1 tsp cinnamon, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 335393,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 335394,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 335395,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until browned on all sides and cooked through, 6-8 minutes. Once done, transfer to a clean plate (leaving cooking juices in the skillet) and cover with foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 335396,
      "primary_message": "Meanwhile, place cherries in a colander and rinse under hot water (from the tap) to thaw; transfer to a cutting board and roughly chop.",
      "secondary_message": "3 cup frozen cherries"
    },
    {
      "id": 335397,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat; add cherries, water, honey, and spices. Stir to combine and bring to a simmer; reduce heat to medium-low and cook, stirring occasionally, until the sauce has thickened slightly, about 5 minutes.",
      "secondary_message": "½ cup water\n1 tbsp honey\n½ tsp rosemary, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 335398,
      "primary_message": "Return meatballs to the skillet and continue to cook, turning occasionally, until warmed through, about 3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 335399,
      "primary_message": "Place peas in the colander and rinse under hot water (from the tap) to thaw; set aside to drain.",
      "secondary_message": "2 cups frozen peas"
    },
    {
      "id": 335400,
      "primary_message": "Once the rice is done, add peas and reserved mint; gently stir to combine the rice pilaf.",
      "secondary_message": null
    },
    {
      "id": 335401,
      "primary_message": "To serve, divide rice pilaf, meatballs, and cherry sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
