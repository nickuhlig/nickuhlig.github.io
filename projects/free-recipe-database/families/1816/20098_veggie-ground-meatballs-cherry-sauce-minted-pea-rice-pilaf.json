  "instructions": [
    {
      "id": 335441,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 335442,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 335443,
      "primary_message": "Wash, dry, and pick mint leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve remaining mint for the rice.)",
      "secondary_message": "1 small pkg fresh mint"
    },
    {
      "id": 335444,
      "primary_message": "Peel and mince garlic; add to the bowl with the mint along with veggie ground, bread crumbs, and spices. Mix well to combine.",
      "secondary_message": "3 cloves garlic\n24 oz veggie ground, plant based\n¾ cup panko bread crumbs\n1 tbsp parsley flakes\n1 ½ tsp sage, dried\n1 ½ tsp cinnamon, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 335445,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs\" and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 335446,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 335447,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until browned on all sides and cooked through, 6-8 minutes. Once done, transfer to a clean plate and loosely cover with foil. (Reserve skillet for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 335448,
      "primary_message": "Meanwhile, place cherries in a colander and rinse under hot water (from the tap) to thaw; transfer to a cutting board and roughly chop.",
      "secondary_message": "4 ½ cup frozen cherries"
    },
    {
      "id": 335449,
      "primary_message": "Return skillet to medium-high heat; add cherries, water, maple syrup, and spices. Stir to combine and bring to a simmer; reduce heat to medium-low and cook, stirring occasionally, until the sauce has thickened slightly, 5-6 minutes.",
      "secondary_message": "¾ cup water\n1 ½ tbsp pure maple syrup\n¾ tsp rosemary, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 335450,
      "primary_message": "Return meatballs to the skillet and continue to cook, turning occasionally, until warmed through, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 335451,
      "primary_message": "Place peas in the colander and rinse under hot water (from the tap) to thaw; set aside to drain.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 335452,
      "primary_message": "Once the rice is done, add peas and reserved mint; gently stir to combine the rice pilaf.",
      "secondary_message": null
    },
    {
      "id": 335453,
      "primary_message": "To serve, divide rice pilaf, meatballs, and cherry sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
