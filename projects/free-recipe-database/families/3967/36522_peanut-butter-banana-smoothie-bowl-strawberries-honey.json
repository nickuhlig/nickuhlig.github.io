  "instructions": [
    {
      "id": 573407,
      "primary_message": "This recipe will make about 9 cups of smoothie. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 573408,
      "primary_message": "Wash, dry, trim, and thinly slice strawberries. Set aside.",
      "secondary_message": "1 ½ (454 g) pkgs strawberries"
    },
    {
      "id": 573409,
      "primary_message": "Peel bananas, break into chunks, and place in a blender. Add yogurt, milk, peanut butter, honey, vanilla, and cinnamon, then blend on high speed until smooth, 1-2 minutes.",
      "secondary_message": "6 bananas\n3 cups plain Greek yogurt\n355 ml whole milk\n½ cup natural peanut butter\n1 tbsp honey\n1 ½ tsp vanilla extract\n¾ tsp cinnamon, ground"
    },
    {
      "id": 573410,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 573411,
      "primary_message": "To serve, divide smoothie between bowls. Top with strawberries and peanuts, then drizzle with additional honey. Enjoy!",
      "secondary_message": "2 tbsp honey"
    }
  ],
