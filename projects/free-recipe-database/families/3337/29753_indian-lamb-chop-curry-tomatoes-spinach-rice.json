  "instructions": [
    {
      "id": 474119,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 474120,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 lime\n1 small pkg grape tomatoes\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 474121,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 474122,
      "primary_message": "While the rice is cooking, peel and mince ginger and garlic. Place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 474123,
      "primary_message": "Zest and juice lime into the bowl with the ginger and garlic. Add yogurt and spices, then whisk to combine the marinade. Add lamb chops, turn to coat, and set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n2 tsp chili powder\n2 tsp curry powder\n1 tsp salt\n½ tsp black pepper\n8 lamb loin chops"
    },
    {
      "id": 474124,
      "primary_message": "Halve grape tomatoes. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 474125,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the tomatoes.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 474126,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 474127,
      "primary_message": "While the skillet heats up, wipe excess marinade from chops, then transfer to a plate. (Reserve bowl with marinade for later use.)",
      "secondary_message": null
    },
    {
      "id": 474128,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and cook until golden and almost cooked through, about 2 minutes per side. Remove to a clean plate and set aside. (Reserve skillet with cooking juices for next step.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 474129,
      "primary_message": "Return skillet to medium heat. Add tomatoes and onions; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 474130,
      "primary_message": "Meanwhile, add water and cornstarch to the bowl with the reserved marinade, then whisk to combine.",
      "secondary_message": "1 cup water\n4 tsp cornstarch"
    },
    {
      "id": 474131,
      "primary_message": "When the tomatoes and onions are done, reduce heat to low. Add yogurt marinade to the skillet (adjusting heat as needed to ensure the yogurt does not split). Cook, stirring constantly, until sauce thickens, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 474132,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 474133,
      "primary_message": "Return lamb chops to the skillet, turning to coat in sauce. Continue to cook until chops are cooked through, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 474134,
      "primary_message": "To serve, divide rice and lamb chop curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
