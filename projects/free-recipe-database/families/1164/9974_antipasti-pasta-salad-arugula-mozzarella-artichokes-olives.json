  "instructions": [
    {
      "id": 405395,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n5 oz rotini pasta"
    },
    {
      "id": 405396,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 red bell pepper\n½ small pkg fresh basil\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 405397,
      "primary_message": "Seed and slice bell pepper into thin strips. Peel and mince shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 405398,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 405399,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers, shallots, and salt; cook, stirring often, until crisp-tender, about 5 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 405400,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the skillet with the peppers during the last 30 seconds of cooking. Remove both from heat and set aside to cool.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 405401,
      "primary_message": "Combine oil, vinegar, Dijon, and spices in a large salad bowl and whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp onion powder\n⅛ tsp Italian seasoning"
    },
    {
      "id": 405402,
      "primary_message": "Drain and thinly slice artichoke hearts; transfer to the bowl with the dressing.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 405403,
      "primary_message": "Cut cheese into ½-inch cubes; transfer to the bowl.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 405404,
      "primary_message": "Halve olives and add to the bowl.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 405405,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 405406,
      "primary_message": "When the pasta is done cooking, drain and rinse under cold, running water. Transfer pasta, bell pepper mixture, and arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 405407,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
