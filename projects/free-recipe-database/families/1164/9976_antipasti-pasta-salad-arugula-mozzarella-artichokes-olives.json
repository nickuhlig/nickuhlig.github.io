  "instructions": [
    {
      "id": 405421,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n15 oz rotini pasta"
    },
    {
      "id": 405422,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 red bell peppers\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 405423,
      "primary_message": "Seed and slice bell peppers into thin strips. Peel and mince onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 405424,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 405425,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers, onion, and salt; cook, stirring often, until crisp-tender, 6-7 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 405426,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the skillet with the peppers during the last 30 seconds of cooking. Remove both from heat and set aside to cool.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 405427,
      "primary_message": "Combine oil, vinegar, Dijon, and spices in a large salad bowl and whisk to combine the dressing. ",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup red wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper\n½ tsp onion powder\n½ tsp Italian seasoning"
    },
    {
      "id": 405428,
      "primary_message": "Drain and thinly slice artichoke hearts; transfer to the bowl with the dressing.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 405429,
      "primary_message": "Cut cheese into ½-inch cubes; transfer to the bowl.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 405430,
      "primary_message": "Halve olives and add to the bowl.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 405431,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 405432,
      "primary_message": "When the pasta is done cooking, drain and rinse under cold, running water. Transfer pasta, bell pepper mixture, and arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 405433,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
