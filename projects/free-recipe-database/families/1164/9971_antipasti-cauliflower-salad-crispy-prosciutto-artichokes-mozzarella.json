  "instructions": [
    {
      "id": 405350,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 405351,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n1 red bell pepper\n½ small pkg fresh basil\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 405352,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 405353,
      "primary_message": "Once the water comes to a boil, uncover, add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, about 3 minutes. Drain and rinse under cold, running water. Set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 405354,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. Lay prosciutto in the skillet and cook until it browns slightly, about 1 minute per side. Transfer to a plate and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil\n4 slices prosciutto"
    },
    {
      "id": 405355,
      "primary_message": "Seed and slice bell pepper into thin strips. Peel and mince shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 405356,
      "primary_message": "Return skillet to stove over medium-high heat. Add more oil and swirl to coat the bottom. Add peppers, shallots, and salt; cook, stirring often, until crisp-tender, about 5 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 405357,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the skillet with the peppers during the last 30 seconds of cooking. Remove both from heat and set aside to cool.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 405358,
      "primary_message": "Combine oil, vinegar, Dijon, and spices in a large salad bowl and whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp onion powder\n⅛ tsp Italian seasoning"
    },
    {
      "id": 405359,
      "primary_message": "Drain and thinly slice artichoke hearts; transfer to the bowl with the dressing.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 405360,
      "primary_message": "Cut cheese into ½-inch cubes. Halve olives. Transfer both to the bowl.",
      "secondary_message": "½ (8 oz) block mozzarella cheese\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 405361,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 405362,
      "primary_message": "Add cauliflower, bell pepper mixture, and arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 405363,
      "primary_message": "Chop or tear prosciutto into pieces.",
      "secondary_message": null
    },
    {
      "id": 405364,
      "primary_message": "To serve, divide cauliflower salad between plates or bowls and top with crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
