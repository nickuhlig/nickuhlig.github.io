  "instructions": [
    {
      "id": 405587,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 405588,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n3 red bell peppers\n1 small pkg fresh basil\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 405589,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 405590,
      "primary_message": "Once the water comes to a boil, uncover, add cauliflower and salt; stir for a few seconds. Cook until crisp-tender, 4-5 minutes. Drain and rinse under cold, running water. Set aside.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 405591,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, lay prosciutto in the skillet and cook until it browns slightly, about 1 minute per side. Transfer to a plate and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n12 slices prosciutto"
    },
    {
      "id": 405592,
      "primary_message": "Seed and slice bell peppers into thin strips. Peel and mince onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 405593,
      "primary_message": "Return skillet to stove over medium-high heat. Add more oil and swirl to coat the bottom. Add peppers, onion, and salt; cook, stirring often, until crisp-tender, 5-6 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 405594,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the skillet with the peppers during the last 30 seconds of cooking. Remove both from heat and set aside to cool.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 405595,
      "primary_message": "Combine oil, vinegar, Dijon, and spices in a large salad bowl and whisk to combine the dressing. ",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup red wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper\n½ tsp onion powder\n½ tsp Italian seasoning"
    },
    {
      "id": 405596,
      "primary_message": "Drain and thinly slice artichoke hearts; transfer to the bowl with the dressing.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 405597,
      "primary_message": "Cut cheese into ½-inch cubes. Halve olives. Transfer both to the bowl.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese\n¾ cup Kalamata olives, pitted"
    },
    {
      "id": 405598,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 405599,
      "primary_message": "Add cauliflower, bell pepper mixture, and arugula to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 405600,
      "primary_message": "Chop or tear prosciutto into pieces.",
      "secondary_message": null
    },
    {
      "id": 405601,
      "primary_message": "To serve, divide cauliflower salad between plates or bowls and top with crispy prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
