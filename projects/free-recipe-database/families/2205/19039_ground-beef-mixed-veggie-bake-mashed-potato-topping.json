  "instructions": [
    {
      "id": 312953,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "6 medium yellow potatoes\n6 medium carrots\n6 sticks celery"
    },
    {
      "id": 312954,
      "primary_message": "Peel and medium dice potatoes; place in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 312955,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; trim and small dice celery. Place both in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 312956,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 312957,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add beef and cook, breaking it apart with a spoon, until just browned, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1.02 kg lean ground beef"
    },
    {
      "id": 312958,
      "primary_message": "While the beef cooks, peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the carrot and celery. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 312959,
      "primary_message": "When the beef is done, add veggies and spices to the pot; continue to cook, stirring occasionally, until veggies soften, 5-6 minutes more. ",
      "secondary_message": "1 ½ tsp rosemary, dried\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 312960,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack about 6-inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 312961,
      "primary_message": "When the potatoes are done, drain in a colander and return to the pot. Add milk, salt, and pepper; using a potato masher, mash until smooth. Cover to keep warm and set aside. ",
      "secondary_message": "355 ml whole milk\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 312962,
      "primary_message": "When the veggies are soft, add flour and cook, stirring frequently, 1-2 minutes more. ",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 312963,
      "primary_message": "Add tomato sauce, broth, peas, and Worcestershire to the pot with the beef; stir to combine the beef filling and bring to a simmer. Once simmering, remove from heat and transfer filling to a large baking dish. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n355 ml chicken or vegetable broth\n1 ½ cups frozen peas\n2 tbsp Worcestershire sauce"
    },
    {
      "id": 312964,
      "primary_message": "Spoon mashed potatoes over the beef filling; using a fork, evenly spread mashed potatoes over the top, creating ridges.",
      "secondary_message": null
    },
    {
      "id": 312965,
      "primary_message": "Place baking dish in the oven and broil until the top is set and lightly golden, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 312966,
      "primary_message": "To serve, divide the bake between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
