  "instructions": [
    {
      "id": 312813,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "4 medium yellow potatoes\n4 medium carrots\n4 sticks celery"
    },
    {
      "id": 312814,
      "primary_message": "Peel and medium dice potatoes; place in a medium saucepan and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 312815,
      "primary_message": "Meanwhile, peel, trim, and small dice carrots; trim and small dice celery. Place both in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 312816,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 312817,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and cook, breaking it apart with a spoon, until just browned, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n16 oz veggie ground, plant based"
    },
    {
      "id": 312818,
      "primary_message": "While the veggie ground cooks, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the carrot and celery. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 312819,
      "primary_message": "When the veggie ground is done, add veggies and spices to the skillet; continue to cook, stirring occasionally, until veggies soften, 4-5 minutes more. ",
      "secondary_message": "1 tsp rosemary, dried\n1 tsp thyme, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 312820,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack about 6-inches from the top. ",
      "secondary_message": null
    },
    {
      "id": 312821,
      "primary_message": "When the potatoes are done, drain in a colander and return to the saucepan. Add milk, salt, and pepper; using a potato masher, mash until smooth. Cover to keep warm and set aside. ",
      "secondary_message": "8 fl oz (1 cup) almond milk, unsweetened\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 312822,
      "primary_message": "When the veggies are soft, add flour and cook, stirring frequently, 1 minute more. ",
      "secondary_message": "2 tbsp all-purpose flour"
    },
    {
      "id": 312823,
      "primary_message": "Add tomato sauce, broth, peas, and soy sauce to the skillet; stir to combine the veggie filling and bring to a boil. Once boiling, remove from heat. ",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 (8 oz) cans tomato sauce\n1 cup frozen peas\n4 tsp soy sauce"
    },
    {
      "id": 312824,
      "primary_message": "Spoon mashed potatoes over the veggie filling; using a fork, evenly spread mashed potatoes over the top, creating ridges.",
      "secondary_message": null
    },
    {
      "id": 312825,
      "primary_message": "Place skillet in the oven and broil until the top is set and lightly golden, 2-3 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 312826,
      "primary_message": "To serve, divide the skillet between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
