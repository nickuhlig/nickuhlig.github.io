  "instructions": [
    {
      "id": 166058,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 166059,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n6 red bell peppers\n6 medium yellow potatoes\n1 small bunch green onions (scallions)"
    },
    {
      "id": 166060,
      "primary_message": "Juice half of the lemons into a small bowl; slice the remaining lemons into rounds and set aside.",
      "secondary_message": null
    },
    {
      "id": 166061,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil and spices; whisk to combine.",
      "secondary_message": "3 cloves garlic\n⅓ cup extra virgin olive oil\n¾ tsp crushed red pepper\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 166062,
      "primary_message": "Pat tilapia dry with paper towels and place on a large baking sheet.",
      "secondary_message": "2 ¼ lb tilapia fillet"
    },
    {
      "id": 166063,
      "primary_message": "Seed and thinly slice the bell peppers and place on second large baking sheet, in a single layer.",
      "secondary_message": null
    },
    {
      "id": 166064,
      "primary_message": "Drizzle oil mixture over the fish and veggies. Place in the oven and bake until the fish is cooked through and the peppers are tender, about 22-24 minutes.",
      "secondary_message": null
    },
    {
      "id": 166065,
      "primary_message": "Meanwhile, peel and coarsely grate potatoes into a large bowl filled with cold water. Stir until the water is cloudy, drain, and add the potatoes back to the bowl. Cover potatoes with more cold water, stir, and drain once more. Pat dry with paper towels, squeezing out excess moisture.",
      "secondary_message": null
    },
    {
      "id": 166066,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 166067,
      "primary_message": "Trim off and discard the ends of the green onions; cut onions crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 166068,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add potatoes, half of the green onions, and spices; stir to combine, then flatten out in an even layer.",
      "secondary_message": "½ cup butter, unsalted\n¾ tsp paprika\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 166069,
      "primary_message": "Cook potatoes, without stirring, until a brown crust forms on the bottom, about 5 minutes. Stir and continue to cook hash browns until tender, 7-9 more minutes.",
      "secondary_message": null
    },
    {
      "id": 166070,
      "primary_message": "To serve, divide fish, bell peppers, and hash browns between plates. Garnish with remaining green onion and lemon slices. Enjoy!",
      "secondary_message": null
    }
  ],
