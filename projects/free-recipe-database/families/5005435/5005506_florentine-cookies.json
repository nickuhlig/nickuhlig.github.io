  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice and finely chop the blanched almonds. Zest the orange. Bring the unsalted butter to room temperature.",
      "secondary_message": "170 g blanched almonds\n1 orange\n5 tbsp unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to upper-middle and lower-middle positions and preheat to 175°C (350°F). Line two baking sheets with silipat liners (see note). In a medium bowl, combine almonds, flour, zest, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium saucepan, combine butter, corn syrup, heavy cream, and sugar over medium high heat. Bring to a boil, stirring occasionally. Once boiling, let boil hard for 1 minute, then take off heat, stir in vanilla, and pour over nut mixture. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When dough is cool enough to handle, scoop into rounded tablespoons and drop on prepared baking sheets at least 6-cm apart. Bake until golden and flat, 10 to 12 minutes. Let cool completely then gently remove from baking sheet.",
      "secondary_message": null
    }
  ],
