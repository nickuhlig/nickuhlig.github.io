  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Coat a baking dish with a thin layer of oil and set aside.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside.",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Add tomato sauce and tomatoes to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium and cook, stirring occasionally, until slightly thickened, 5-6 minutes.",
      "secondary_message": "426 ml tomato sauce\n1 (411 g) can diced tomatoes"
    },
    {
      "primary_message": "Add drained pasta to the skillet and toss to coat in the sauce. Transfer pasta to the baking dish and sprinkle with cheese. Place in the oven and bake until cheese is melted and bubbly, about 20 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
