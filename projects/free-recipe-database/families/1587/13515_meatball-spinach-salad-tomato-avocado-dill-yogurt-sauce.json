  "instructions": [
    {
      "id": 225517,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 225518,
      "primary_message": "Place beef and spices in a large bowl; mix with your hands until well combined.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 225519,
      "primary_message": "Using a scant ¼-cup measure, form the meat mixture into rounded meatballs and place on the prepared baking sheet.",
      "secondary_message": null
    },
    {
      "id": 225520,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until meatballs are cooked through, about 18 minutes.",
      "secondary_message": null
    },
    {
      "id": 225521,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 small pkgs grape tomatoes\n3 (142 g) pkg baby spinach\n1 ½ avocados"
    },
    {
      "id": 225522,
      "primary_message": "Zest lemons into a small bowl. Add yogurt and spices; whisk to combine the yogurt sauce and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 ½ tsp dill, dried\n¾ tsp onion powder\n3 pinch salt"
    },
    {
      "id": 225523,
      "primary_message": "Juice the lemons into a clean large bowl. Add oil, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 225524,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 225525,
      "primary_message": "Add spinach to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 225526,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 225527,
      "primary_message": "To serve, divide salad, avocado, and meatballs between plates. Top meatballs with yogurt sauce and enjoy!",
      "secondary_message": null
    }
  ],
