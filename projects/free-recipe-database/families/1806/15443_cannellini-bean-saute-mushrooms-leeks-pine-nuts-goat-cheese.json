  "instructions": [
    {
      "id": 254185,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n0.45 kg cremini mushrooms\n½ small pkg chives"
    },
    {
      "id": 254186,
      "primary_message": "Trim off the root ends and the dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick half-moons.",
      "secondary_message": null
    },
    {
      "id": 254187,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 254188,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 254189,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 254190,
      "primary_message": "Add garlic and leeks to the skillet; cook, stirring frequently, until softened, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 254191,
      "primary_message": "Meanwhile, quarter the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 254192,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 254193,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 254194,
      "primary_message": "Add mushrooms, chives (reserving a small handful for garnish), beans, tomatoes, tomato paste, and spices to the skillet. Cook, stirring occasionally, until sauce thickens and veggies soften, 6-7 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n2 tbsp tomato paste\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper\n¼ tsp thyme, dried"
    },
    {
      "id": 254195,
      "primary_message": "Meanwhile, crumble goat cheese into a small bowl.",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 254196,
      "primary_message": "Roughly chop pine nuts.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 254197,
      "primary_message": "To serve, divide bean and veggie sauté between bowls; top with goat cheese and pine nuts. Enjoy!",
      "secondary_message": null
    }
  ],
