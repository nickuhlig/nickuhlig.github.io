  "instructions": [
    {
      "id": 254211,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 leeks\n1.36 kg cremini mushrooms\n1 small pkg chives"
    },
    {
      "id": 254212,
      "primary_message": "Trim off the root ends and the dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick half-moons.",
      "secondary_message": null
    },
    {
      "id": 254213,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 254214,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 254215,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 254216,
      "primary_message": "Add garlic and leeks to the pot; cook, stirring frequently, until softened, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 254217,
      "primary_message": "Meanwhile, quarter the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 254218,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 254219,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 254220,
      "primary_message": "Add mushrooms, chives (reserving a small handful for garnish), beans, tomatoes, tomato paste, and spices to the pot. Cook, stirring occasionally, until sauce thickens and veggies soften, 7-8 minutes.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n6 tbsp tomato paste\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp thyme, dried"
    },
    {
      "id": 254221,
      "primary_message": "Meanwhile, crumble goat cheese into a medium bowl.",
      "secondary_message": "3 (113 g) logs goat cheese"
    },
    {
      "id": 254222,
      "primary_message": "Roughly chop pine nuts.",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 254223,
      "primary_message": "To serve, divide bean and veggie sauté between bowls; top with goat cheese and pine nuts. Enjoy!",
      "secondary_message": null
    }
  ],
