  "instructions": [
    {
      "id": 504897,
      "primary_message": "Place veggie ground, bread crumbs, soy sauce, and spices in a large bowl, then mix with your hands until well combined. Form the mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "24 oz veggie ground, plant based\n½ cup panko bread crumbs\n1 tbsp soy sauce\n1 ½ tsp coriander, ground\n1 ½ tsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 504898,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 504899,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 504900,
      "primary_message": "While the burgers are cooking, place ketchup and crushed red pepper in a small bowl. Stir to combine the spicy ketchup and set aside.",
      "secondary_message": "½ cup ketchup\n½ tsp crushed red pepper"
    },
    {
      "id": 504901,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 medium carrots\n1 ½ English cucumbers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 504902,
      "primary_message": "Juice limes into a clean large bowl. Add oil, maple syrup, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 ½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 504903,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel the carrot into noodle-like strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 504904,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 504905,
      "primary_message": "Peel, halve, and slice shallots lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 504906,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl, along with pine nuts, and toss to combine the salad.",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 504907,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 504908,
      "primary_message": "Spread spicy ketchup over the bottom half of each bun; top with burger patties and a small handful of salad. Close with the top half of each bun. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
