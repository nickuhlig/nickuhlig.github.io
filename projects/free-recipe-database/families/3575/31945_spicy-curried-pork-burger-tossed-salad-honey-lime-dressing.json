  "instructions": [
    {
      "id": 504909,
      "primary_message": "Place pork, bread crumbs, Worcestershire sauce, and spices in a medium bowl, then mix with your hands until well combined. Form the pork mixture into 2 equal-sized patties and place on a plate.",
      "secondary_message": "⅓ kg lean ground pork\n3 tbsp panko bread crumbs\n1 tsp Worcestershire sauce\n1 tsp curry powder\n½ tsp coriander, ground\n½ tsp salt"
    },
    {
      "id": 504910,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 504911,
      "primary_message": "Once the pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 504912,
      "primary_message": "While the burgers are cooking, place ketchup and crushed red pepper in a small bowl. Stir to combine the spicy ketchup and set aside.",
      "secondary_message": "3 tbsp ketchup\n⅛ tsp crushed red pepper"
    },
    {
      "id": 504913,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n1 medium carrot\n½ English cucumber\n½ head butter (Boston) lettuce"
    },
    {
      "id": 504914,
      "primary_message": "Juice lime into a clean medium bowl. Add oil, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 tsp honey\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 504915,
      "primary_message": "Peel and trim carrot; using a julienne (or regular) peeler, peel the carrot into noodle-like strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 504916,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 504917,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 504918,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 504919,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 504920,
      "primary_message": "Spread spicy ketchup over the bottom half of each bun; top with burger patties and a small handful of salad. Close with the top half of each bun. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
