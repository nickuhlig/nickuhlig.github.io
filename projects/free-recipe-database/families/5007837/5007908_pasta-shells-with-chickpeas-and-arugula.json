  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Drain and rinse the chickpeas. Chop the fresh mozzarella into 1/4-inch pieces. Grate the Parmesan cheese. Chop the arugula.",
      "secondary_message": "1 clove garlic\n1 (425 g) can chickpeas\n0.23 kg fresh mozzarella\n¼ cup Parmesan cheese\n2 cups arugula"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together vinegar, garlic, salt, a few cracks of black pepper, thyme, oregano, and olive oil. Add chickpeas and mozzarella. Toss well. Cover bowl with plastic wrap and set aside at room temperature for at least 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring a large pot of water to a boil. Add a tablespoon of salt and pasta. Cook according to the directions on the packaging until al dente. When done, drain in a colander.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toss pasta in large bowl with mozzarella and chickpeas. Add a handful of arugula a sprinkling of parmesan and stir. Continue this process until all of arugula and most of parmesan has been added. Arugula will wilt slightly due to warm pasta. Season to taste with more salt and pepper, if needed. Divide pasta between four large bowls, and sprinkle with remaining grated Parmesan. This pasta is great warm, but also works at room temperature.",
      "secondary_message": null
    }
  ],
