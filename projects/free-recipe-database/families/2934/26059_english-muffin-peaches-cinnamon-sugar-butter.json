  "instructions": [
    {
      "id": 414930,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the English muffins.)",
      "secondary_message": null
    },
    {
      "id": 414931,
      "primary_message": "Place butter, sugar, and cinnamon in a small bowl. Mash with the back of a spoon to combine the cinnamon-sugar butter. Set aside.",
      "secondary_message": "2 tsp butter, unsalted\n2 tsp brown sugar\n¼ tsp cinnamon, ground"
    },
    {
      "id": 414932,
      "primary_message": "Split muffins and arrange on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "2 English muffins"
    },
    {
      "id": 414933,
      "primary_message": "Meanwhile, wash, dry, and quarter peach lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Cut each quarter into thick slices.",
      "secondary_message": "1 peach"
    },
    {
      "id": 414934,
      "primary_message": "Spread each muffin with cinnamon-sugar butter, then top with peaches.",
      "secondary_message": null
    },
    {
      "id": 414935,
      "primary_message": "To serve, divide muffins between plates and enjoy!",
      "secondary_message": null
    }
  ],
