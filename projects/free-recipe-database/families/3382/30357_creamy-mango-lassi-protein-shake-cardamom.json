  "instructions": [
    {
      "id": 483371,
      "primary_message": "Not all protein powders are created equal. If desired, adjust shake consistency by adding more or less liquid per package instructions. This recipe will make about 12 cups of shake. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 483372,
      "primary_message": "Wash, dry, zest, and juice limes into a blender.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 483373,
      "primary_message": "Wash, dry, peel, and slice mango flesh away from the pits, starting with the flat sides; roughly chop the flesh. Add to the blender.",
      "secondary_message": "3 mangoes"
    },
    {
      "id": 483374,
      "primary_message": "Add milk, yogurt, protein powder, maple syrup, vanilla, salt, and cardamom to the blender. Blend on high speed for several minutes until smooth.",
      "secondary_message": "24 fl oz (3 cups) whole milk\n1 ½ cups plain Greek yogurt\n6 servings vanilla whey-based protein powder (containing 20 grams protein/serving)\n2 tbsp pure maple syrup\n¾ tsp vanilla extract\n3 pinch salt\n3 pinch cardamom, ground"
    },
    {
      "id": 483375,
      "primary_message": "To serve, divide shake between glasses, adding ice if desired. Enjoy!",
      "secondary_message": null
    }
  ],
