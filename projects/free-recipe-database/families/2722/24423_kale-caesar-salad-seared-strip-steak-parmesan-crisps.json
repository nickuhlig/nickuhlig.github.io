  "instructions": [
    {
      "id": 395678,
      "primary_message": "Preheat oven to 175°C (350°F). Line two baking sheet pans with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 395679,
      "primary_message": "Finely grate Parmesan. Place half in a large bowl and set aside for the salad. (Reserve remaining Parmesan for the next step.)",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 395680,
      "primary_message": "To make crisps from the remaining cheese, measure out 1 tbsp of grated Parmesan and place in a pile on one of the baking sheets. Repeat with remaining Parmesan, keeping the piles a few inches apart. Season with pepper. ",
      "secondary_message": "½ tsp black pepper"
    },
    {
      "id": 395681,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until Parmesan is lightly browned and crisp, 8-10 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 395682,
      "primary_message": "Meanwhile, peel and mince garlic. Mince anchovy fillets. Add both to the bowl with the reserved Parmesan.",
      "secondary_message": "3 cloves garlic\n3 anchovy fillets, packed in oil"
    },
    {
      "id": 395683,
      "primary_message": "Wash, dry, and juice lemons into the bowl. Add mayo, oil, vinegar, pepper, and salt; whisk to combine the dressing.",
      "secondary_message": "1 ½ lemons\n¼ cup avocado oil mayonnaise\n2 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 395684,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, about 2 minutes. Set aside.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 395685,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 395686,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 395687,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 395688,
      "primary_message": "Meanwhile, break Parmesan crisps into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 395689,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 395690,
      "primary_message": "To serve, divide salad between plates or bowls; top with Parmesan crisps and steak. Enjoy!",
      "secondary_message": null
    }
  ],
