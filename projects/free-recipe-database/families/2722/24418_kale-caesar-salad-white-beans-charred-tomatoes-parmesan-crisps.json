  "instructions": [
    {
      "id": 395610,
      "primary_message": "Preheat oven to 175°C (350°F). Line a baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 395611,
      "primary_message": "Finely grate Parmesan. Place half in a medium bowl and set aside for the salad. (Reserve remaining Parmesan for the next step.)",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 395612,
      "primary_message": "To make crisps from the remaining cheese, measure out 1 tbsp of grated Parmesan and place in a pile on the baking sheet. Repeat with remaining Parmesan, keeping the piles a few inches apart. Season with pepper. ",
      "secondary_message": "⅛ tsp black pepper"
    },
    {
      "id": 395613,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until Parmesan is lightly browned and crisp, 8-10 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 395614,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 395615,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. ",
      "secondary_message": "½ small pkg grape tomatoes\n½ lemon\n1 bunch kale"
    },
    {
      "id": 395616,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes, salt, and pepper; cook, stirring occasionally, until tomatoes start to burst and char, 5-6 minutes. Remove from heat and set aside to cool slightly, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 395617,
      "primary_message": "While the tomatoes are cooking, drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 395618,
      "primary_message": "Peel and mince garlic. Add to the bowl with the reserved Parmesan.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 395619,
      "primary_message": "Juice lemon into the bowl. Add mayo, oil, vinegar, soy sauce, pepper, and salt; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp extra virgin olive oil\n½ tsp red wine vinegar\n¼ tsp soy sauce\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 395620,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 395621,
      "primary_message": "Add cooled tomatoes and beans to the bowl. Gently toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 395622,
      "primary_message": "Break Parmesan crisps into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 395623,
      "primary_message": "To serve, divide salad between plates or bowls; top with Parmesan crisps. Enjoy!",
      "secondary_message": null
    }
  ],
