  "instructions": [
    {
      "id": 395409,
      "primary_message": "Preheat oven to 350°F. Line a baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 395410,
      "primary_message": "Finely grate Parmesan. Place half in a medium bowl and set aside for the salad. (Reserve remaining Parmesan for the next step.)",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 395411,
      "primary_message": "To make crisps from the remaining cheese, measure out 1 tbsp of grated Parmesan and place in a pile on the baking sheet. Repeat with remaining Parmesan, keeping the piles a few inches apart. Season with pepper. ",
      "secondary_message": "⅛ tsp black pepper"
    },
    {
      "id": 395412,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until Parmesan is lightly browned and crisp, 8-10 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 395413,
      "primary_message": "Meanwhile, peel and mince garlic. Mince anchovy fillet. Add both to the bowl with the reserved Parmesan.",
      "secondary_message": "1 clove garlic\n1 anchovy fillet, packed in oil"
    },
    {
      "id": 395414,
      "primary_message": "Wash, dry, and juice lemon into the bowl. Add mayo, oil, vinegar, pepper, and salt; whisk to combine the dressing.",
      "secondary_message": "½ lemon\n1 ½ tbsp mayonnaise\n2 tsp extra virgin olive oil\n½ tsp red wine vinegar\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 395415,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 395416,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 395417,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 395418,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 395419,
      "primary_message": "Meanwhile, break Parmesan crisps into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 395420,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 395421,
      "primary_message": "To serve, divide salad between plates or bowls; top with Parmesan crisps and steak. Enjoy!",
      "secondary_message": null
    }
  ],
