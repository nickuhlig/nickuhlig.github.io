  "instructions": [
    {
      "id": 395476,
      "primary_message": "Preheat oven to 350°F. Line two large baking sheet pans with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 395477,
      "primary_message": "Finely grate Parmesan. Place half in a large bowl and set aside for the salad. (Reserve remaining Parmesan for the next step.)",
      "secondary_message": "9 oz Parmesan cheese"
    },
    {
      "id": 395478,
      "primary_message": "To make crisps from the remaining cheese, measure out 1 tbsp of grated Parmesan and place in a pile on one of the baking sheets. Repeat with remaining Parmesan, keeping the piles a few inches apart. Season with pepper. ",
      "secondary_message": "½ tsp black pepper"
    },
    {
      "id": 395479,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until Parmesan is lightly browned and crisp, 8-10 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 395480,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 395481,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. ",
      "secondary_message": "1 ½ pints grape tomatoes\n1 ½ lemons\n3 bunches kale"
    },
    {
      "id": 395482,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes, salt, and pepper; cook, stirring occasionally, until tomatoes start to burst and char, 6-8 minutes. Remove from heat and set aside to cool slightly, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 395483,
      "primary_message": "While the tomatoes are cooking, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 395484,
      "primary_message": "Peel and mince garlic. Add to the bowl with the reserved Parmesan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 395485,
      "primary_message": "Juice lemons into the bowl. Add mayo, oil, vinegar, soy sauce, pepper, and salt; whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n3 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n¾ tsp soy sauce\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 395486,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, about 2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 395487,
      "primary_message": "Add cooled tomatoes and beans to the bowl. Gently toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 395488,
      "primary_message": "Break Parmesan crisps into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 395489,
      "primary_message": "To serve, divide salad between plates or bowls; top with Parmesan crisps. Enjoy!",
      "secondary_message": null
    }
  ],
