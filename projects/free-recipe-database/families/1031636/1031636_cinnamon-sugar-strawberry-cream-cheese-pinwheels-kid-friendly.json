  "instructions": [
    {
      "primary_message": "Wash, dry, trim, and small dice strawberries. Set aside.\n\n",
      "secondary_message": "½ (16 oz) pkg strawberries"
    },
    {
      "primary_message": "Place sugar and cinnamon in a small bowl, then stir to combine.\n\n",
      "secondary_message": "¼ cup granulated sugar\n1 tsp cinnamon, ground"
    },
    {
      "primary_message": "Arrange lavash (about 8 x 10-inches in size) on a flat surface. Spread 1/4-cup cream cheese over each piece of lavash in an even layer, making sure to spread it to the edges. \n\n",
      "secondary_message": "4 (8 x 10-inch) piece lavash bread\n1 cup whipped cream cheese spread"
    },
    {
      "primary_message": "Sprinkle cinnamon-sugar and strawberries evenly over the cream cheese. With the short edge of the lavash facing towards you, tightly roll to close. Cut each lavash roll-up crosswise into 8 \"pinwheels.\" (Secure with toothpicks if necessary.)\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pinwheels between plates and enjoy!",
      "secondary_message": null
    }
  ],
