  "instructions": [
    {
      "id": 511655,
      "primary_message": "Preheat oven to 230°C (450°F). Line two large baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 511656,
      "primary_message": "Wash, dry, and halve each acorn squash lengthwise; trim ends, scrape out the seeds, and cut crosswise into ¼-inch thick half-moons. Divide between the baking sheets and spread out in an even layer.",
      "secondary_message": "3 acorn squash"
    },
    {
      "id": 511657,
      "primary_message": "Small dice butter and sprinkle over the squash. Season with salt and pepper.",
      "secondary_message": "3 tbsp butter, unsalted\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 511658,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until squash is tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 511659,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511660,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp smoked paprika\n1 ½ tsp rosemary, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 511661,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add pork chops and cook until golden brown and cooked through, 4-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 511662,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 511663,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-low heat. Add more butter and swirl to coat the bottom. Add walnuts and cook, stirring occasionally, until toasted, about 3 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 511664,
      "primary_message": "While the walnuts are cooking, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 511665,
      "primary_message": "When the walnuts are done, add garlic, water, and coconut aminos to the skillet. Stir to combine the sauce and remove from heat.",
      "secondary_message": "3 tbsp water\n3 tbsp coconut aminos"
    },
    {
      "id": 511666,
      "primary_message": "To serve, divide squash and pork chops between plates. Sprinkle squash with feta and drizzle with sauce. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    }
  ],
