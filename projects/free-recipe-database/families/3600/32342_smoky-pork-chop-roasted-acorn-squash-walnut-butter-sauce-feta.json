  "instructions": [
    {
      "id": 511643,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 511644,
      "primary_message": "Wash, dry, and halve each acorn squash lengthwise; trim ends, scrape out the seeds, and cut crosswise into ¼-inch thick half-moons. Transfer to the baking sheet and spread out in an even layer.",
      "secondary_message": "2 acorn squash"
    },
    {
      "id": 511645,
      "primary_message": "Small dice butter and sprinkle over the squash. Season with salt and pepper.",
      "secondary_message": "2 tbsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 511646,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until squash is tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 511647,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511648,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp smoked paprika\n1 tsp rosemary, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 511649,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add pork chops and cook until golden brown and cooked through, 4-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 511650,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 511651,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-low heat. Add more butter and swirl to coat the bottom. Add walnuts and cook, stirring occasionally, until toasted, about 3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 511652,
      "primary_message": "While the walnuts are cooking, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 511653,
      "primary_message": "When the walnuts are done, add garlic, water, and coconut aminos to the skillet. Stir to combine the sauce and remove from heat.",
      "secondary_message": "2 tbsp water\n2 tbsp coconut aminos"
    },
    {
      "id": 511654,
      "primary_message": "To serve, divide squash and pork chops between plates. Sprinkle squash with feta and drizzle with sauce. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
