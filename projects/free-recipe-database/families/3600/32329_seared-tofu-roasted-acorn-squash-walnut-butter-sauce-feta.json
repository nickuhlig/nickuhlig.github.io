  "instructions": [
    {
      "id": 511481,
      "primary_message": "Preheat oven to 450°F. Line a baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 511482,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on another baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 511483,
      "primary_message": "Wash, dry, and halve acorn squash lengthwise; trim ends, scrape out the seeds, and cut crosswise into ¼-inch thick half-moons. Transfer to the prepared baking sheet and spread out in an even layer.",
      "secondary_message": "1 acorn squash"
    },
    {
      "id": 511484,
      "primary_message": "Small dice butter and sprinkle over the squash. Season with salt and pepper.",
      "secondary_message": "1 tbsp butter, unsalted\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 511485,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until squash is tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 511486,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 511487,
      "primary_message": "While the skillet heats up, cut the tofu planks in half along the long side. Place in a medium bowl, sprinkle with cornstarch and spices, then toss to coat.",
      "secondary_message": "1 tbsp cornstarch\n½ tsp smoked paprika\n½ tsp rosemary, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 511488,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add tofu and cook until golden, 2-3 minutes per side. Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 511489,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 511490,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-low heat. Add more butter and swirl to coat the bottom. Add walnuts and cook, stirring occasionally, until toasted, about 3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 511491,
      "primary_message": "While the walnuts are cooking, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 511492,
      "primary_message": "When the walnuts are done, add garlic, water, and soy sauce to the skillet. Stir to combine the sauce and remove from heat.",
      "secondary_message": "1 tbsp water\n1 tbsp soy sauce"
    },
    {
      "id": 511493,
      "primary_message": "To serve, divide squash and tofu between plates. Sprinkle squash with feta and drizzle with sauce. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
