  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large skillet, sauté pan, or wok, heat oil over medium-high heat until shimmering. Add cumin and mustard seeds and cook until they start to pop. Add onion and cook, stirring, until golden, about 8 minutes. Add ginger and garlic and cook until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce heat to medium-low, add tomato, cover, and cook until softened, about 10 minutes. Stir in coriander, garam masala, turmeric, chili powder, and salt. Add 1/2 cup water and bring to a boil over medium-high heat. Once boiling add the cauliflower and stir to combine. Cover and cook over medium-high heat until the cauliflower is translucent and soft, 10 to 20 minutes. Adjust heat to high and continue to cook, uncovered, until liquid has evaporated, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Sprinkle cilantro and peanuts over cauliflower and serve.",
      "secondary_message": null
    }
  ],
