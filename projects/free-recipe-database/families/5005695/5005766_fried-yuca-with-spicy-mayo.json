  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the stems and seeds from the jalapeño pepper, then roughly chop it.",
      "secondary_message": "1 jalapeño pepper"
    },
    {
      "id": 1,
      "primary_message": "Peel yuca, split in half crosswise, and cut into 1.5 to 2-cm thick batons. Place in a pot and cover with cold water by 5 cm. Season well with salt. Bring to a boil over high heat, reduce to a simmer, and cook until tender and yuca is starting to fray, about 15 minutes. Drain.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While yuca is cooking, combine mayonnaise, aji amarillo, lime juice, jalapeño, cilantro, and cheese in the jar of a blender and blend on high speed until smooth. Alternatively, blend in a up with a hand blender. Season to taste with salt if necessary. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When yuca is boiled, heat oil to 175°C (350°F) in a fryer, Dutch oven, or large wok over high heat. Adjust flame to maintain temperature. Add yuca and cook, agitating and flipping frequently, until golden brown and crisp, about 3 minutes. Transfer to a paper towel-lined tray and shake to drain. Season with salt. Serve immediately with sauce for dipping.",
      "secondary_message": null
    }
  ],
