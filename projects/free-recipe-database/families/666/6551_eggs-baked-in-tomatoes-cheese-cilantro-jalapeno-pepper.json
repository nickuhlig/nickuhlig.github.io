  "instructions": [
    {
      "id": 82712,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 82713,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium yellow onions\n3 small bunches cilantro\n6 jalapeño peppers\n3 pints grape tomatoes"
    },
    {
      "id": 82714,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 82715,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 82716,
      "primary_message": "Quarter the jalapeño pepper lengthwise; remove and discard the stem, seeds, and membranes. Finely dice half of the jalapeno peppers. Slice the remaining jalapeno peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 82717,
      "primary_message": "Once the pot is hot, add coconut oil and swirl to coat the bottom. Add onion, garlic, and minced jalapeno. Stirring frequently, cook until vegetables are softened, 3-4 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 82718,
      "primary_message": "Halve grape tomatoes and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 82719,
      "primary_message": "Drain and rinse the black beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 82720,
      "primary_message": "Add tomato sauce, black beans, oregano, chili powder and salt to the pot; stir to combine. Reduce heat to low and continue to cook, stirring occasionally, until reduced in volume, 6-8 minutes.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 tbsp oregano\n1 ½ tsp salt\n¾ tsp black pepper\n2 tbsp chili powder"
    },
    {
      "id": 82721,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 82722,
      "primary_message": "Grate mozzarella cheese.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 82723,
      "primary_message": "Pour the sauce from the skillet into a large baking dish. Gently crack the eggs into the baking dish. Top with cheese and sliced jalapeno peppers. Broil until the tops of the whites are set but the yolks are still runny, 2 to 4 minutes.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 82724,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 82725,
      "primary_message": "To serve, divide between plates, and garnish with cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
