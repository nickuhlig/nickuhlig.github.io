  "instructions": [
    {
      "id": 482413,
      "primary_message": "If using wooden skewers, place 2-4 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 482414,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb cremini mushrooms\n½ lemon\n1 head romaine lettuce"
    },
    {
      "id": 482415,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482416,
      "primary_message": "While the pan heats up, place mushrooms in a medium bowl. Add Worcestershire and spices, then toss to coat. Thread mushrooms onto the skewers and place on a plate. (If you don't have skewers, you can cook the mushrooms directly on the grill pan.)",
      "secondary_message": "2 tsp Worcestershire sauce\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 482417,
      "primary_message": "Once the pan is hot, coat with oil. Add mushroom skewers and cook, turning occasionally, until charred and tender, about 10 minutes. Return to the plate and loosely cover with aluminum foil. (Reserve grill pan for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 482418,
      "primary_message": "Meanwhile, juice lemon into a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 482419,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with mayo, oil, Dijon, Worcestershire, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n2 tbsp mayonnaise\n1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp Worcestershire sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 482420,
      "primary_message": "Pat the steak dry with paper towels. Place on another plate, then season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 482421,
      "primary_message": "Return grill pan to medium-high heat and coat with more oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 482422,
      "primary_message": "While the steak is cooking, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 482423,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and toss to combine the salad.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 482424,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 482425,
      "primary_message": "To serve, divide salad, steak, and mushrooms between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
