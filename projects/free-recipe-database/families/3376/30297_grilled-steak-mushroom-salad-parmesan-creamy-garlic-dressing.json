  "instructions": [
    {
      "id": 482514,
      "primary_message": "If using wooden skewers, place 6-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 482515,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb cremini mushrooms\n1 ½ lemons\n3 heads romaine lettuce"
    },
    {
      "id": 482516,
      "primary_message": "Place mushrooms in a medium bowl. Add coconut aminos and spices, then toss to coat. Thread mushrooms onto the skewers and place on a plate. (If you don't have skewers, you can cook the mushrooms directly on the grill pan.)",
      "secondary_message": "2 tbsp coconut aminos\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 482517,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 482518,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add mushroom skewers and cook, turning occasionally, until charred and tender, about 10 minutes. Return to the plate and loosely cover with aluminum foil. (Reserve grill pan for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 482519,
      "primary_message": "Meanwhile, juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 482520,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with mayo, oil, Dijon, coconut aminos, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup avocado oil mayonnaise\n3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp coconut aminos\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 482521,
      "primary_message": "Pat the steak dry with paper towels. Place on another plate, then season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 482522,
      "primary_message": "Return grill pan to medium-high heat and coat with more oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 482523,
      "primary_message": "While the steak is cooking, chop or tear lettuce into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 482524,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and toss to combine the salad.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 482525,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 482526,
      "primary_message": "To serve, divide salad, steak, and mushrooms between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
