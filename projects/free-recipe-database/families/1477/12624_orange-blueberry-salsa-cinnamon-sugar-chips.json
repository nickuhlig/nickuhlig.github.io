  "instructions": [
    {
      "id": 213009,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 213010,
      "primary_message": "Place sugar, cinnamon, and nutmeg in a large bowl; stir to combine the spice mix and set aside.",
      "secondary_message": "2 tbsp granulated sugar\n1 ½ tsp cinnamon\n½ tsp nutmeg, ground"
    },
    {
      "id": 213011,
      "primary_message": "Cut flatbreads into wedges, divide between two baking sheet pans, and spread out in an even layer.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 213012,
      "primary_message": "Drizzle oil over the wedges and sprinkle with spice mix; toss to coat, then spread back out in an even layer. (If the oil is solid, melt it in a small saucepan over low heat or in the microwave.)",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 213013,
      "primary_message": "Place wedges in the oven (it doesn't have to be fully heated) and bake until toasted and crisp, 8-10 minutes. Reserve bowl for the fruit salsa.",
      "secondary_message": null
    },
    {
      "id": 213014,
      "primary_message": "Meanwhile, wash, dry, and cut off skin and white pith from the oranges. Slice between the membranes to release segments, small dice, and transfer to the reserved bowl.",
      "secondary_message": "3 oranges"
    },
    {
      "id": 213015,
      "primary_message": "Wash, dry, and roughly chop blueberries; add to the bowl with the oranges.",
      "secondary_message": "1 ½ (170 g) pkg blueberries"
    },
    {
      "id": 213016,
      "primary_message": "Finely chop dates and add to the bowl along with maple syrup and cardamom. Stir to combine the fruit salsa.",
      "secondary_message": "¾ cup medjool dates, pitted\n1 ½ tsp pure maple syrup\n3 pinch cardamom, ground"
    },
    {
      "id": 213017,
      "primary_message": "Serve flatbread chips with fruit salsa on the side and enjoy!",
      "secondary_message": null
    }
  ],
