  "instructions": [
    {
      "id": 349354,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 349355,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 small bunches green onions (scallions)\n3 limes\n1 ½ mangoes\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 349356,
      "primary_message": "Place spices in a small bowl and stir to combine; set aside.",
      "secondary_message": "2 tbsp chili powder\n2 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 349357,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 349358,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349359,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add the turkey, spice mix, and half of the green onions (reserving the rest for garnish). Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg ground turkey"
    },
    {
      "id": 349360,
      "primary_message": "Meanwhile, divide pitas between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes. ",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 349361,
      "primary_message": "Remove pitas from oven and evenly spread with tomato sauce; top with turkey. Return baking sheets to the oven and bake until pizzas are warmed through, 6-7 minutes. Remove from oven.",
      "secondary_message": "1 ½ (213 ml) cans tomato sauce"
    },
    {
      "id": 349362,
      "primary_message": "While the pizzas are baking, juice half of the limes into the reserved bowl (set remaining limes aside for the dressing). Add yogurt and additional spices, then whisk to combine the lime crema; set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 ½ tsp cumin, ground\n1 ½ tsp garlic powder\n3 pinch salt"
    },
    {
      "id": 349363,
      "primary_message": "Juice remaining limes into a large bowl; add oil and additional spices. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 349364,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; small dice and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 349365,
      "primary_message": "Halve tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349366,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 349367,
      "primary_message": "To serve, divide pizzas and salad between plates; drizzle pizzas with lime crema and top with reserved green onion. Enjoy!",
      "secondary_message": null
    }
  ],
