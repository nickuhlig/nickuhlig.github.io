  "instructions": [
    {
      "id": 349298,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 349299,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 small bunches green onions (scallions)\n2 limes\n1 mango\n1 pint grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 349300,
      "primary_message": "Place spices in a small bowl and stir to combine; set aside.",
      "secondary_message": "4 tsp chili powder\n1 ½ tsp cumin, ground\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 349301,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349302,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 349303,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add the veggie ground, spice mix, and half of the green onions (reserving the rest for garnish). Cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based"
    },
    {
      "id": 349304,
      "primary_message": "Meanwhile, arrange pitas on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 5 minutes.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 349305,
      "primary_message": "Remove pitas from oven and evenly spread with tomato sauce; top with veggie ground. Return baking sheet to the oven and bake until pizzas are warmed through, about 5 minutes. Remove from oven.",
      "secondary_message": "1 (8 oz) can tomato sauce"
    },
    {
      "id": 349306,
      "primary_message": "While the pizzas are baking, juice one lime into the reserved bowl (set remaining lime aside for the dressing). Add yogurt and additional spices, then whisk to combine the lime crema; set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n1 tsp cumin, ground\n1 tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 349307,
      "primary_message": "Juice remaining lime into a medium bowl; add oil and additional spices. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 349308,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; small dice and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 349309,
      "primary_message": "Halve tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349310,
      "primary_message": "Add mixed greens to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 349311,
      "primary_message": "To serve, divide pizzas and salad between plates; drizzle pizzas with lime crema and top with reserved green onion. Enjoy!",
      "secondary_message": null
    }
  ],
