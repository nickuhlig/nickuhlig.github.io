  "instructions": [
    {
      "id": 40863,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n2 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 40864,
      "primary_message": "Trim off and discard the ends of the zucchini; quarter the zucchini lengthwise, then slice crosswise into ¼-inch-thick pieces. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 40865,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 40866,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces) and transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 40867,
      "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the bowl with the onion.",
      "secondary_message": null
    },
    {
      "id": 40868,
      "primary_message": "Add the ground beef to the saucepan; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer to a bowl, leaving some of the juices in the saucepan.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 40869,
      "primary_message": "Once the beef has been transferred, add the onion and jalapeño to the saucepan; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 40870,
      "primary_message": "While the onion cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 40871,
      "primary_message": "Add the garlic, chili powder, and cumin to the saucepan; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "2 tbsp chili powder\n2 tsp cumin"
    },
    {
      "id": 40872,
      "primary_message": "Add the zucchini to the saucepan and season with salt and pepper; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 40873,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 40874,
      "primary_message": "Return the beef to the saucepan, then add in the diced tomatoes, tomato paste, corn, and cilantro; season with salt and pepper. Bring the mixture to a boil, then reduce to a simmer and cook for 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n2 tbsp tomato paste\n1 cup frozen corn\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 40875,
      "primary_message": "To serve, divide the chili between bowls and top with spoonfuls of Greek yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
