  "instructions": [
    {
      "id": 504785,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 504786,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 504787,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 504788,
      "primary_message": "While the rice is cooking, trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 504789,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 504790,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the bell peppers and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 504791,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until almost cooked through, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg ground turkey\n3 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 504792,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the bell peppers and garlic (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 504793,
      "primary_message": "When the turkey is almost cooked through, add bell peppers, garlic, and cilantro to the skillet. Continue to cook, stirring occasionally, until turkey is cooked through and bell peppers are softened, 5-6 minutes more. Remove from heat and transfer to a large baking dish. ",
      "secondary_message": null
    },
    {
      "id": 504794,
      "primary_message": "While the turkey and bell peppers are cooking, coarsely grate cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 504795,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 504796,
      "primary_message": "When the rice is done, add to the baking dish with the turkey, along with tomatoes, then stir to combine. Top with cheese and place in the oven; broil until cheese is melted and golden, 3-4 minutes. Remove from oven.",
      "secondary_message": "3 (398 ml) cans diced tomatoes"
    },
    {
      "id": 504797,
      "primary_message": "To serve, divide bake between plates or bowls. Top with reserved cilantro and a dollop of yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
