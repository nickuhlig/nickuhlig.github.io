  "instructions": [
    {
      "id": 504720,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 504721,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 yellow bell pepper\n½ small bunch cilantro"
    },
    {
      "id": 504722,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 504723,
      "primary_message": "While the rice is cooking, trim, seed, and medium dice bell peppers. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 504724,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 504725,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the bell peppers and set aside.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 504726,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n1 tbsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 504727,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the bell peppers and garlic (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 504728,
      "primary_message": "When the veggie ground is almost cooked through, add bell peppers, garlic, and cilantro to the skillet. Continue to cook, stirring occasionally, until veggie ground is cooked through and bell peppers are softened, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 504729,
      "primary_message": "While the veggie ground and bell peppers are cooking, coarsely grate cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 504730,
      "primary_message": "Preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 504731,
      "primary_message": "When the rice is done, add to the skillet, along with tomatoes, then stir to combine. Top with cheese and place in the oven; broil until cheese is melted and golden, 3-4 minutes. Remove from oven.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 504732,
      "primary_message": "To serve, divide skillet between plates or bowls. Top with reserved cilantro and a dollop of yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
