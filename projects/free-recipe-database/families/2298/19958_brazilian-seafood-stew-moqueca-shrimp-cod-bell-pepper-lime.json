  "instructions": [
    {
      "id": 333176,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 red bell pepper\n1 green bell pepper\n2 tomatoes\n½ small bunch cilantro"
    },
    {
      "id": 333177,
      "primary_message": "Zest lime into a medium bowl. (Reserve lime for later use.)",
      "secondary_message": null
    },
    {
      "id": 333178,
      "primary_message": "Peel and mince garlic; add to the bowl with the lime zest along with chili-garlic sauce, salt, and pepper. Stir to combine the marinade.",
      "secondary_message": "2 cloves garlic\n1 tsp chili-garlic sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 333179,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry; add to the bowl with the marinade.",
      "secondary_message": "½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 333180,
      "primary_message": "Pat the cod dry with paper towels and cut into 1-inch pieces; add to the bowl and gently stir to coat. Set aside.",
      "secondary_message": "½ lb cod fillet"
    },
    {
      "id": 333181,
      "primary_message": "Using a clean cutting board, trim, seed, and halve bell peppers crosswise, then slice into thin strips; place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 333182,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 333183,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; add to the bowl with the bell pepper.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 333184,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add veggies and salt. Cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "2 tsp virgin coconut oil\n¼ tsp salt"
    },
    {
      "id": 333185,
      "primary_message": "While the veggies are cooking, medium dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 333186,
      "primary_message": "Add tomatoes and broth to the pan; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies are soft, 3-4 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 333187,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 333188,
      "primary_message": "Add marinated seafood and coconut milk to the pan; stir to combine, return to a simmer, and continue to cook until seafood is cooked through, 1 minute more.",
      "secondary_message": "1 (13.5 fl oz) can coconut milk"
    },
    {
      "id": 333189,
      "primary_message": "When the stew is done, juice reserved lime into the pan, add cilantro, and gently stir to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 333190,
      "primary_message": "To serve, divide seafood stew between bowls and enjoy!",
      "secondary_message": null
    }
  ],
