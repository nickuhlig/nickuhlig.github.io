  "instructions": [
    {
      "id": 333236,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 red bell peppers\n2 green bell peppers\n4 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 333237,
      "primary_message": "Zest limes into a medium bowl. (Reserve limes for later use.)",
      "secondary_message": null
    },
    {
      "id": 333238,
      "primary_message": "Peel and mince garlic; add to the bowl with the lime zest along with chili-garlic sauce, salt, and pepper. Stir to combine the marinade.",
      "secondary_message": "4 cloves garlic\n2 tsp chili-garlic sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 333239,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry; add to the bowl with the marinade.",
      "secondary_message": "0.45 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 333240,
      "primary_message": "Pat the cod dry with paper towels and cut into 1-inch pieces; add to the bowl and gently stir to coat. Set aside.",
      "secondary_message": "0.45 kg cod fillet"
    },
    {
      "id": 333241,
      "primary_message": "Using a clean cutting board, trim, seed, and halve bell peppers crosswise, then slice into thin strips; place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 333242,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 333243,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion; add to the bowl with the bell pepper.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 333244,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies and salt. Cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "4 tsp virgin coconut oil\n½ tsp salt"
    },
    {
      "id": 333245,
      "primary_message": "While the veggies are cooking, medium dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 333246,
      "primary_message": "Add tomatoes and broth to the pot; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies are soft, 3-4 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 333247,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 333248,
      "primary_message": "Add marinated seafood and coconut milk to the pot; stir to combine, return to a simmer, and continue to cook until seafood is cooked through, 1 minute more.",
      "secondary_message": "2 (398 ml) cans coconut milk"
    },
    {
      "id": 333249,
      "primary_message": "When the stew is done, juice reserved limes into the pot, add cilantro, and gently stir to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 333250,
      "primary_message": "To serve, divide seafood stew between bowls and enjoy!",
      "secondary_message": null
    }
  ],
