  "instructions": [
    {
      "id": 270971,
      "primary_message": "Preheat oven to 230°C (450°F). Position racks in the upper, center, and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 270972,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n6 crowns broccoli\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 270973,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl. ",
      "secondary_message": "3 cloves garlic\n3 tbsp capers"
    },
    {
      "id": 270974,
      "primary_message": "Zest lemons into the bowl with the garlic and capers (reserve lemons for the next step). Add mayo, salt, and pepper; stir to combine the aioli and set aside. ",
      "secondary_message": "⅓ cup mayonnaise\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 270975,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 270976,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 270977,
      "primary_message": "Divide broccoli between two large baking sheet pans. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 270978,
      "primary_message": "Place baking sheets on lower racks of the oven and roast, tossing halfway through, until broccoli is fork-tender and lightly charred, 12-15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 270979,
      "primary_message": "While the broccoli is roasting, pat cod dry with paper towels, cut into portions (if necessary), and transfer to another large baking sheet. Season with pepper, then wrap 2 slices of prosciutto around each portion; drizzle with oil.",
      "secondary_message": "1.02 kg cod fillet\n¾ tsp black pepper\n12 slices prosciutto\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 270980,
      "primary_message": "Place baking sheet on upper rack of the oven and roast until the fish is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 270981,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the dressing (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "id": 270982,
      "primary_message": "When the broccoli is done, add it to the bowl, along with the almonds, and toss to combine the salad. ",
      "secondary_message": "¾ cup almonds, sliced"
    },
    {
      "id": 270983,
      "primary_message": "To serve, divide cod and broccoli salad between plates; top fish with aioli and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
