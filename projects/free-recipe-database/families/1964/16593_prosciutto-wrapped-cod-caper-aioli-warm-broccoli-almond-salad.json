  "instructions": [
    {
      "id": 270997,
      "primary_message": "Preheat oven to 230°C (450°F). ",
      "secondary_message": null
    },
    {
      "id": 270998,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 crowns broccoli\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 270999,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl. ",
      "secondary_message": "2 cloves garlic\n2 tbsp capers"
    },
    {
      "id": 271000,
      "primary_message": "Zest lemon into the bowl with the garlic and capers (reserve lemon for the next step). Add mayo, salt, and pepper; stir to combine the aioli and set aside. ",
      "secondary_message": "⅓ cup avocado oil mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 271001,
      "primary_message": "Juice lemon into a medium bowl. Add oil, Dijon, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 271002,
      "primary_message": "Pat cod dry with paper towels, cut into portions (if necessary), and transfer to a baking sheet pan. Season with pepper, then wrap 3 slices of prosciutto around each portion; drizzle with oil.",
      "secondary_message": "0.68 kg cod fillet\n½ tsp black pepper\n12 slices prosciutto\n4 tsp extra virgin olive oil"
    },
    {
      "id": 271003,
      "primary_message": "Place baking sheet in the oven and roast until the fish is cooked through, 10-12 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 271004,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 271005,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271006,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli and cover; cook, stirring occasionally, until the broccoli is bright green and fork-tender, about 5 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 271007,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the dressing (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "id": 271008,
      "primary_message": "When the broccoli is done, add it to the bowl, along with the almonds, and toss to combine the salad. ",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 271009,
      "primary_message": "To serve, divide cod and broccoli salad between plates; top fish with aioli and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
