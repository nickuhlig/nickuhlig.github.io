  "instructions": [
    {
      "id": 270932,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 270933,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 crowns broccoli\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 270934,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl. ",
      "secondary_message": "3 cloves garlic\n3 tbsp capers"
    },
    {
      "id": 270935,
      "primary_message": "Zest lemons into the bowl with the garlic and capers (reserve lemons for the next step). Add mayo, salt, and pepper; stir to combine the aioli and set aside. ",
      "secondary_message": "½ cup avocado oil mayonnaise\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 270936,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 270937,
      "primary_message": "Pat cod dry with paper towels, cut into portions (if necessary), and transfer to a large baking sheet pan. Season with pepper, then wrap 3 slices of prosciutto around each portion; drizzle with oil.",
      "secondary_message": "2 ¼ lb cod fillet\n¾ tsp black pepper\n18 slices prosciutto\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 270938,
      "primary_message": "Place baking sheet in the oven and roast until the fish is cooked through, about 12 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 270939,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 270940,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 270941,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli and cover; cook, stirring occasionally, until the broccoli is bright green and fork-tender, about 6 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 270942,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the dressing (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "id": 270943,
      "primary_message": "When the broccoli is done, add it to the bowl, along with the almonds, and toss to combine the salad. ",
      "secondary_message": "¾ cup almonds, sliced"
    },
    {
      "id": 270944,
      "primary_message": "To serve, divide cod and broccoli salad between plates; top fish with aioli and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
