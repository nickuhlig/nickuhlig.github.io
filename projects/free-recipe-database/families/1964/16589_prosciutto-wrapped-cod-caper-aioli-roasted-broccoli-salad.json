  "instructions": [
    {
      "id": 270945,
      "primary_message": "Preheat oven to 230°C (450°F). Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 270946,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 crowns broccoli\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 270947,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl. ",
      "secondary_message": "1 clove garlic\n1 tbsp capers"
    },
    {
      "id": 270948,
      "primary_message": "Zest lemon into the bowl with the garlic and capers (reserve lemon for the next step). Add mayo, salt, and pepper; stir to combine the aioli and set aside. ",
      "secondary_message": "2 tbsp mayonnaise\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 270949,
      "primary_message": "Juice lemon into a medium bowl. Add oil, Dijon, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 270950,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 270951,
      "primary_message": "Transfer broccoli to a baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 270952,
      "primary_message": "Place baking sheet on lower rack of the oven and roast, tossing halfway through, until broccoli is fork-tender and lightly charred, 10-12 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 270953,
      "primary_message": "While the broccoli is roasting, pat cod dry with paper towels, cut into portions (if necessary), and transfer to another baking sheet. Season with pepper, then wrap 2 slices of prosciutto around each portion; drizzle with oil.",
      "secondary_message": "⅓ kg cod fillet\n¼ tsp black pepper\n4 slices prosciutto\n2 tsp extra virgin olive oil"
    },
    {
      "id": 270954,
      "primary_message": "Place baking sheet on upper rack of the oven and roast until the fish is cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 270955,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the dressing (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "id": 270956,
      "primary_message": "When the broccoli is done, add it to the bowl, along with the almonds, and toss to combine the salad. ",
      "secondary_message": "¼ cup almonds, sliced"
    },
    {
      "id": 270957,
      "primary_message": "To serve, divide cod and broccoli salad between plates; top fish with aioli and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
