  "instructions": [
    {
      "id": 270880,
      "primary_message": "Preheat oven to 450°F. Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 270881,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n4 crowns broccoli\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 270882,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl. ",
      "secondary_message": "2 cloves garlic\n2 tbsp capers"
    },
    {
      "id": 270883,
      "primary_message": "Zest lemons into the bowl with the garlic and capers (reserve lemons for the next step). Add mayo, salt, and pepper; stir to combine the aioli and set aside. ",
      "secondary_message": "¼ cup mayonnaise\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 270884,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, and spices; whisk to combine the dressing and set aside. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n4 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 270885,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 270886,
      "primary_message": "Transfer broccoli to a large baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to combine; spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 270887,
      "primary_message": "Place baking sheet on lower rack of the oven and roast, tossing halfway through, until broccoli is fork-tender and lightly charred, 10-12 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 270888,
      "primary_message": "While the broccoli is roasting, pat cod dry with paper towels, cut into portions (if necessary), and transfer to another baking sheet. Season with pepper, then wrap 2 slices of prosciutto around each portion; drizzle with oil.",
      "secondary_message": "1 ½ lb cod fillet\n½ tsp black pepper\n8 slices prosciutto\n4 tsp extra virgin olive oil"
    },
    {
      "id": 270889,
      "primary_message": "Place baking sheet on upper rack of the oven and roast until the fish is cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 270890,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Add half of the parsley to the bowl with the dressing (reserving the rest for garnish). ",
      "secondary_message": null
    },
    {
      "id": 270891,
      "primary_message": "When the broccoli is done, add it to the bowl, along with the almonds, and toss to combine the salad. ",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 270892,
      "primary_message": "To serve, divide cod and broccoli salad between plates; top fish with aioli and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
