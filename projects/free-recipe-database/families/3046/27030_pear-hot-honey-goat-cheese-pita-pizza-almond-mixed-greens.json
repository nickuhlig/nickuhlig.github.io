  "instructions": [
    {
      "id": 436113,
      "primary_message": "Preheat oven to 450°F. Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 436114,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 pears\n1 small pkg fresh thyme\n1 ½ lemons\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 436115,
      "primary_message": "Quarter, core, and thinly slice pears. Transfer to a large baking dish.",
      "secondary_message": null
    },
    {
      "id": 436116,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the baking dish with the pear.",
      "secondary_message": null
    },
    {
      "id": 436117,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick strips. Add to the baking dish, drizzle with oil, then season with salt and pepper; stir to combine.",
      "secondary_message": "1 ½ medium red onions\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 436118,
      "primary_message": "Place baking dish on the upper rack of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until pears and onions are soft and starting to brown, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 436119,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, honey, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp honey\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 436120,
      "primary_message": "Place goat cheese, honey, and crushed red pepper in a small bowl. Mash with the back of a spoon to combine and set aside. ",
      "secondary_message": "3 (4 oz) logs goat cheese\n¼ cup honey\n¾ tsp crushed red pepper"
    },
    {
      "id": 436121,
      "primary_message": "Divide pitas between two baking sheet pans. Place on the middle and lower racks and bake, flipping halfway through, until pitas are slightly crispy, 5-6 minutes. Remove from oven and set aside.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 436122,
      "primary_message": "When the pears and onion are done, remove from oven. Spread goat cheese over each pita, top with pears and onions, then cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 436123,
      "primary_message": "Add mixed greens and almonds to the bowl with the dressing, then toss to combine the salad.",
      "secondary_message": "⅓ cup almonds, sliced"
    },
    {
      "id": 436124,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
