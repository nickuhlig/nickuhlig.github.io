  "instructions": [
    {
      "id": 436125,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 436126,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 pears\n½ small pkg fresh thyme\n½ lemon\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 436127,
      "primary_message": "Quarter, core, and thinly slice pears. Transfer to a small baking dish.",
      "secondary_message": null
    },
    {
      "id": 436128,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the baking dish with the pear.",
      "secondary_message": null
    },
    {
      "id": 436129,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick strips. Add to the baking dish, drizzle with oil, then season with salt and pepper; stir to combine.",
      "secondary_message": "½ medium red onion\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 436130,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until pears and onions are soft and starting to brown, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 436131,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add oil, honey, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp honey\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 436132,
      "primary_message": "Place goat cheese, honey, and crushed red pepper in a small bowl. Mash with the back of a spoon to combine and set aside. ",
      "secondary_message": "1 (113 g) log goat cheese\n1 ½ tbsp honey\n¼ tsp crushed red pepper"
    },
    {
      "id": 436133,
      "primary_message": "Arrange pitas on a baking sheet pan. Add to the oven and bake, flipping halfway through, until pitas are slightly crispy, about 5 minutes. Remove from oven and set aside.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 436134,
      "primary_message": "When the pears and onion are done, remove from oven. Spread goat cheese over each pita, top with pears and onions, then cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 436135,
      "primary_message": "Add mixed greens and almonds to the bowl with the dressing, then toss to combine the salad.",
      "secondary_message": "⅛ cup almonds, sliced"
    },
    {
      "id": 436136,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
