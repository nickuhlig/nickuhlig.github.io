  "instructions": [
    {
      "id": 459208,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain, return to the pot, and set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g spaghetti pasta"
    },
    {
      "id": 459209,
      "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pot is boiling, reduce heat to medium-low.",
      "secondary_message": "1 tbsp white wine vinegar"
    },
    {
      "id": 459210,
      "primary_message": "While the water is heating, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ small bunches asparagus\n1 ½ (142 g) pkgs baby spinach\n1 ½ lemons"
    },
    {
      "id": 459211,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 459212,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Add to the bowl with the green onions.",
      "secondary_message": null
    },
    {
      "id": 459213,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 459214,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add garlic and peas to the bowl.",
      "secondary_message": "3 cloves garlic\n1 ½ cups frozen peas"
    },
    {
      "id": 459215,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until fork-tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "⅓ cup butter, unsalted\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 459216,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl and set aside.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 459217,
      "primary_message": "Gently crack eggs into additional small bowls (two eggs per bowl).",
      "secondary_message": "12 eggs"
    },
    {
      "id": 459218,
      "primary_message": "Adjust the heat of the pot as necessary so that the vinegar water is simmering. Working in batches, gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a plate.",
      "secondary_message": null
    },
    {
      "id": 459219,
      "primary_message": "When the veggies are done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Zest and juice lemons into the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 459220,
      "primary_message": "Add veggies to the pot with the drained spaghetti and set pot over medium-high heat. Cook, tossing occasionally, until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 459221,
      "primary_message": "To serve, divide pasta and eggs between bowls. Top with Parmesan and enjoy! ",
      "secondary_message": null
    }
  ],
