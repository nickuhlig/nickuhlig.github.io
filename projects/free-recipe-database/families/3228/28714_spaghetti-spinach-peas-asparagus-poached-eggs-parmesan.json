  "instructions": [
    {
      "id": 459096,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "½ tsp salt\n5 oz spaghetti pasta"
    },
    {
      "id": 459097,
      "primary_message": "Meanwhile, fill another medium saucepan about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pan is boiling, reduce heat to medium-low.",
      "secondary_message": "1 tsp white wine vinegar"
    },
    {
      "id": 459098,
      "primary_message": "While the water is heating, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small bunch green onions (scallions)\n½ small bunch asparagus\n½ (5 oz) pkg baby spinach\n½ lemon"
    },
    {
      "id": 459099,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 459100,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut into 1-inch pieces. Add to the bowl with the green onions.",
      "secondary_message": null
    },
    {
      "id": 459101,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 459102,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add garlic and peas to the bowl.",
      "secondary_message": "1 clove garlic\n½ cup frozen peas"
    },
    {
      "id": 459103,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until fork-tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 459104,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl and set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 459105,
      "primary_message": "Gently crack eggs into two additional small bowls (two eggs per bowl).",
      "secondary_message": "4 eggs"
    },
    {
      "id": 459106,
      "primary_message": "Adjust the heat of the saucepan as necessary so that the vinegar water is simmering. Gently tip bowls into the pan, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a plate.",
      "secondary_message": null
    },
    {
      "id": 459107,
      "primary_message": "When the veggies are done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 459108,
      "primary_message": "Zest and juice lemon into the skillet, then add drained spaghetti. Continue to cook, tossing occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 459109,
      "primary_message": "To serve, divide pasta and eggs between bowls. Top with Parmesan and enjoy! ",
      "secondary_message": null
    }
  ],
