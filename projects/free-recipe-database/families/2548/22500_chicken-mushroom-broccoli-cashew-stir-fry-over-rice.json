  "instructions": [
    {
      "id": 374729,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 374730,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 374731,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; medium dice. Place in a large bowl along with broccoli and mushrooms. Set aside.",
      "secondary_message": "3 red bell peppers\n1 ½ (510 g) bags broccoli florets\n3 (227g ) pkg sliced white mushrooms"
    },
    {
      "id": 374732,
      "primary_message": "Pat the chicken thighs dry with paper towels and cut into bite-sized pieces. Sprinkle with cornstarch and salt on both sides. ",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n2 tbsp cornstarch\n1 ½ tsp salt"
    },
    {
      "id": 374733,
      "primary_message": "Preheat a large pot over high heat. ",
      "secondary_message": null
    },
    {
      "id": 374734,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the chicken and cook, stirring occasionally, until golden and almost cooked through, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 374735,
      "primary_message": "Add veggies to the pot, cover with a lid, and continue to cook, stirring occasionally, until just tender, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 374736,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop cashews. ",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 374737,
      "primary_message": "When the veggies are done, add stir-fry sauce to the pot. Continue to cook, stirring occasionally, until sauce is warmed through, 2-3 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": "¾ cup stir-fry sauce"
    },
    {
      "id": 374738,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with cashews. Enjoy!",
      "secondary_message": null
    }
  ],
