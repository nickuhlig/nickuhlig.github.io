  "instructions": [
    {
      "id": 374719,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n½ tsp salt"
    },
    {
      "id": 374720,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 374721,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; medium dice. Place in a large bowl along with broccoli and mushrooms. Set aside.",
      "secondary_message": "2 red bell peppers\n1 (510 g) bag broccoli florets\n2 (227g ) pkg sliced white mushrooms"
    },
    {
      "id": 374722,
      "primary_message": "Preheat a large skillet over high heat. ",
      "secondary_message": null
    },
    {
      "id": 374723,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and cut into bite-sized pieces. Sprinkle with cornstarch and salt on both sides. ",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n4 tsp cornstarch\n1 tsp salt"
    },
    {
      "id": 374724,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the chicken and cook, stirring occasionally, until golden and almost cooked through, 3-4 minutes.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 374725,
      "primary_message": "Add veggies to the skillet, cover with a lid, and continue to cook, stirring occasionally, until just tender, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 374726,
      "primary_message": "Meanwhile, using a clean cutting board, roughly chop cashews. ",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 374727,
      "primary_message": "When the veggies are done, add stir-fry sauce to the skillet. Continue to cook, stirring occasionally, until sauce is warmed through, 1-2 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": "½ cup stir-fry sauce"
    },
    {
      "id": 374728,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with cashews. Enjoy!",
      "secondary_message": null
    }
  ],
