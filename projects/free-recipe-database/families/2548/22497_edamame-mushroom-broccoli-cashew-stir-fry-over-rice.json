  "instructions": [
    {
      "id": 374700,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 374701,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 374702,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell peppers; medium dice. ",
      "secondary_message": "3 red bell peppers"
    },
    {
      "id": 374703,
      "primary_message": "Preheat a large pot over high heat. ",
      "secondary_message": null
    },
    {
      "id": 374704,
      "primary_message": "While the pot heats up, place edamame in the colander and rinse under hot, running water (from the tap) to defrost. ",
      "secondary_message": "4 ½ cups edamame"
    },
    {
      "id": 374705,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add edamame, bell pepper, broccoli, mushrooms, and salt; stir-fry until fork-tender, about 5 minutes. ",
      "secondary_message": "3 tbsp toasted sesame oil\n1 ½ (18 oz) bags broccoli florets\n3 (8 oz) pkg sliced white mushrooms\n¾ tsp salt"
    },
    {
      "id": 374706,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 374707,
      "primary_message": "When the veggies are done, add stir-fry sauce to the pot. Continue to cook, stirring occasionally, until sauce is warmed through, 2-3 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": "1 cup stir-fry sauce"
    },
    {
      "id": 374708,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with cashews. Enjoy!",
      "secondary_message": null
    }
  ],
