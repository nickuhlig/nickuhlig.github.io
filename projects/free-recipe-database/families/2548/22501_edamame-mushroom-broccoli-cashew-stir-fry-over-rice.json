  "instructions": [
    {
      "id": 374739,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 374740,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 374741,
      "primary_message": "Meanwhile, wash, dry, trim, and seed bell pepper; medium dice. ",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 374742,
      "primary_message": "Preheat a skillet over high heat. ",
      "secondary_message": null
    },
    {
      "id": 374743,
      "primary_message": "While the skillet heats up, place edamame in the colander and rinse under hot, running water (from the tap) to defrost. ",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 374744,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add edamame, bell pepper, broccoli, mushrooms, and salt; stir-fry until fork-tender, 4-5 minutes. ",
      "secondary_message": "1 tbsp toasted sesame oil\n½ (510 g) bag broccoli florets\n1 (227g ) pkg sliced white mushrooms\n¼ tsp salt"
    },
    {
      "id": 374745,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "⅛ cup cashews, roasted unsalted"
    },
    {
      "id": 374746,
      "primary_message": "When the veggies are done, add stir-fry sauce to the skillet. Continue to cook, stirring occasionally, until sauce is warmed through, 1-2 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": "⅓ cup stir-fry sauce"
    },
    {
      "id": 374747,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls; sprinkle with cashews. Enjoy!",
      "secondary_message": null
    }
  ],
