  "instructions": [
    {
      "id": 12560,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "¾ cup quinoa\n12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 12561,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by whisking together garlic, lemon juice, oil, salt, pepper, and cumin.",
      "secondary_message": "2 cloves garlic\n1 lemon\n3 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cumin"
    },
    {
      "id": 12562,
      "primary_message": "Wash and dry tomatoes, cucumber, parsley, and mint. Halve and add tomatoes to bowl with dressing. Medium dice and add cucumber to bowl. Shave parsley leaves off the stems; discard the stems, mince the leaves, and add to bowl. Pick mint leaves off the stems; discard the stems, mince the leaves, and add to bowl.",
      "secondary_message": "1 pint grape tomatoes\r\n1 English cucumber\r\n½ small bunch Italian (flat-leaf) parsley\r\n½ small pkg fresh mint"
    },
    {
      "id": 12563,
      "primary_message": "Uncover quinoa, fluff with a fork, and drain any excess liquid. Add quinoa to bowl and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 12564,
      "primary_message": "To serve, place salad in a bowl. Enjoy!",
      "secondary_message": ""
    }
  ],
