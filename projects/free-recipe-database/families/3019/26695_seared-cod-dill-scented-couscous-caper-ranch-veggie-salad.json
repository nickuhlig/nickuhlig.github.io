  "instructions": [
    {
      "id": 431716,
      "primary_message": "In a small saucepan, bring broth to a boil over medium-high heat. Once boiling, remove from heat, add couscous, dill, and salt, then stir to combine. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous\n½ tsp dill, dried\n¼ tsp salt"
    },
    {
      "id": 431717,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431718,
      "primary_message": "While the skillet heats up, pat cod dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg cod fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 431719,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cod and pan-fry until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 431720,
      "primary_message": "Meanwhile, wash, dry, and quarter tomatoes. Place in a medium bowl.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 431721,
      "primary_message": "Drain and roughly chop capers. Add to the bowl with the tomatoes along with the carrots and dressing. Stir to combine the salad.",
      "secondary_message": "2 tbsp capers\n½ (283 g) bag shredded carrots\n⅓ cup ranch dressing"
    },
    {
      "id": 431722,
      "primary_message": "To serve, divide cod, salad, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
