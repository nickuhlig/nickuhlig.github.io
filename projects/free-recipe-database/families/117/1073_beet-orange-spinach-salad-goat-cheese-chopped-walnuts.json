  "instructions": [
    {
      "id": 8298,
      "primary_message": "Preheat oven to 500°F.",
      "secondary_message": ""
    },
    {
      "id": 8299,
      "primary_message": "Wash, trim root ends, peel, and thinly slice beets into half rounds. Transfer to a sheet pan, drizzle with oil, and season with salt and pepper.",
      "secondary_message": "2 beets\r\n1 tsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 8300,
      "primary_message": "Place in the oven and roast until beets are tender, 20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 8301,
      "primary_message": "Wash and dry spinach and oranges. Peel and thinly slice oranges into half rounds.",
      "secondary_message": "½ (5 oz) pkg baby spinach\r\n2 oranges"
    },
    {
      "id": 8302,
      "primary_message": "In a small bowl, prepare dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "3 tbsp extra virgin olive oil\r\n1 tsp balsamic vinegar\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 8303,
      "primary_message": "Crumble goat cheese into a small bowl. Roughly chop walnuts.",
      "secondary_message": "½ (4 oz) pkg goat cheese\r\n¼ cup walnuts"
    },
    {
      "id": 8304,
      "primary_message": "To serve, arrange a bed of spinach on a plate and top with beet and orange slices. Sprinkle with goat cheese, walnuts, and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
