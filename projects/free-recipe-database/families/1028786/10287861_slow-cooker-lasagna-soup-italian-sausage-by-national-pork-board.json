  "instructions": [
    {
      "primary_message": "In a large skillet over high heat, brown the Italian sausage for 4 minutes. Break apart the sausage as it browns.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add onion and garlic, then cook for another 1–2 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from heat and drain the extra grease. Transfer the cooked sausage and onion to a slow cooker.\n",
      "secondary_message": null
    },
    {
      "primary_message": "To the slow cooker, add the tomatoes, chicken broth, tomato paste, Italian seasoning, crushed red pepper, salt, and pepper. Stir to combine well.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cook on high for 3 hours, then add the noodles and stir to incorporate.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Set to low heat, then cook for another 30 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, scoop into bowls and garnish with a tablespoon of ricotta cheese, chopped parsley, and grated Parmesan cheese.\n",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: Ground pork is safe to eat when cooked to 160°F.\n",
      "secondary_message": null
    }
  ],
