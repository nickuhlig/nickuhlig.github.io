  "instructions": [
    {
      "id": 175542,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain pasta and return to pot; set aside.",
      "secondary_message": "15 oz penne pasta"
    },
    {
      "id": 175543,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 tomatoes\n3 medium zucchini squash\n¾ lb cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 175544,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 175545,
      "primary_message": "Peel the carrots and onions. Slice carrots into ¼-inch rounds; slice onions in half and then into thin half moons. Transfer both to a medium bowl.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 175546,
      "primary_message": "Thinly slice mushrooms; add to the bowl with the carrot and onion.",
      "secondary_message": null
    },
    {
      "id": 175547,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into half rounds; add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 175548,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 175549,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 175550,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 175551,
      "primary_message": "Add veggies to the pot along with the garlic and spices; cook, stirring occasionally, until vegetables are crisp tender, 5-6 minutes.",
      "secondary_message": "¾ tsp basil\n¾ tsp oregano\n¾ tsp thyme\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 175552,
      "primary_message": "Meanwhile, small dice the tomatoes and grate the Parmesean. ",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 175553,
      "primary_message": "Shave leaves off the stems of the parsley; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 175554,
      "primary_message": "When the veggies are done, stir in the beans, diced tomatoes, half the parsley, oil, capers, and red wine vinegar; cook an additional 2 minutes. Reserve remaining parsley for garnish.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp capers\n2 tbsp red wine vinegar"
    },
    {
      "id": 175555,
      "primary_message": "Transfer vegetable mixture to the pot with the pasta and toss gently to combine.",
      "secondary_message": null
    },
    {
      "id": 175556,
      "primary_message": "To serve, divide the pasta mixture between plates; top with Parmesan and remaining parsley. Enjoy!",
      "secondary_message": null
    }
  ],
