  "instructions": [
    {
      "primary_message": "Wash, dry, and pick 24 large basil leaves off the stems (if needed, you can double up smaller leaves to make larger ones). Arrange leaves on a serving platter, spacing them at least 1/4-inch apart.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "primary_message": "Wash, dry, and cut each tomato crosswise into 4 slices. Arrange slices on top of the basil leaves. ",
      "secondary_message": null
    },
    {
      "primary_message": "Count out 12 mozzarella balls and cut each in half. Top tomato slices with a piece of mozzarella, flat-side facing down.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella balls (ciliegine or \"cherry size\")"
    },
    {
      "primary_message": "Count out 24 sliced olives. Place one olive over each piece of mozzarella.",
      "secondary_message": "¼ cup sliced black olives"
    },
    {
      "primary_message": "Just before serving, season caprese \"eyeballs\" with salt and pepper, then drizzle with oil and vinegar. Enjoy!",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper\n2 tsp extra virgin olive oil\n2 tsp balsamic vinegar"
    }
  ],
