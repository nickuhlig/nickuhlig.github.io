  "instructions": [
    {
      "id": 246143,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 246144,
      "primary_message": "Heat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 246145,
      "primary_message": "While the pot heats up, cut chicken into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 246146,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 246147,
      "primary_message": "Add chicken to the pot and cook, stirring occasionally, until golden brown and cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 246148,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 246149,
      "primary_message": "Wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 246150,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 246151,
      "primary_message": "When the chicken is done, transfer to a large baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 246152,
      "primary_message": "Return the pot to medium heat. Once the pot is hot, add garlic, milk, and spices. Add cream cheese to the pot in pieces, and whisk until melted and smooth, about 5 minutes.",
      "secondary_message": "177 ml whole milk\n¾ tsp salt\n½ tsp black pepper\n½ tsp onion powder\n½ tsp coriander, ground\n1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 246153,
      "primary_message": "Pour cream cheese mixture over the chicken. Top with broccoli and grated cheese.",
      "secondary_message": null
    },
    {
      "id": 246154,
      "primary_message": "Place dish in the oven and bake until bubbly and cheese is melted, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 246155,
      "primary_message": "To serve, divide casserole between bowls and enjoy!",
      "secondary_message": null
    }
  ],
