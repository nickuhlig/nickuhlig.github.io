  "instructions": [
    {
      "id": 246078,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 246079,
      "primary_message": "Heat a medium saucepan over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 246080,
      "primary_message": "While the pan heats up, cut chicken into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 246081,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 246082,
      "primary_message": "Add chicken to the pan and cook, stirring occasionally, until golden brown and cooked through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 246083,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 246084,
      "primary_message": "Wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 246085,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 246086,
      "primary_message": "When the chicken is done, transfer to a small baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 246087,
      "primary_message": "Return the saucepan to medium heat. Once the pot is hot, add garlic, milk, and spices. Add cream cheese to the pan in pieces, and whisk until melted and smooth, 2-3 minutes.",
      "secondary_message": "2 fl oz (¼ cup) whole milk\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp onion powder\n⅛ tsp coriander, ground\n½ (8 oz) block cream cheese"
    },
    {
      "id": 246088,
      "primary_message": "Pour cream cheese mixture over the chicken. Top with broccoli and grated cheese.",
      "secondary_message": null
    },
    {
      "id": 246089,
      "primary_message": "Place dish in the oven and bake until bubbly and cheese is melted, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 246090,
      "primary_message": "To serve, divide casserole between bowls and enjoy!",
      "secondary_message": null
    }
  ],
