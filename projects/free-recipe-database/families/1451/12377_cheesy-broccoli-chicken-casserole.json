  "instructions": [
    {
      "id": 246130,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 246131,
      "primary_message": "Heat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 246132,
      "primary_message": "While the pot heats up, cut chicken into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 246133,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 246134,
      "primary_message": "Add chicken to the pot and cook, stirring occasionally, until golden brown and cooked through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 246135,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 246136,
      "primary_message": "Wash and dry broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 246137,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 246138,
      "primary_message": "When the chicken is done, transfer to a medium baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 246139,
      "primary_message": "Return the pot to medium heat. Once the pot is hot, add garlic, milk, and spices. Add cream cheese to the pot in pieces, and whisk until melted and smooth, 2-3 minutes.",
      "secondary_message": "118 ml (½ cup) whole milk\n½ tsp salt\n¼ tsp black pepper\n¼ tsp onion powder\n¼ tsp coriander, ground\n1 (227 g) block cream cheese"
    },
    {
      "id": 246140,
      "primary_message": "Pour cream cheese mixture over the chicken. Top with broccoli and grated cheese.",
      "secondary_message": null
    },
    {
      "id": 246141,
      "primary_message": "Place dish in the oven and bake until bubbly and cheese is melted, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 246142,
      "primary_message": "To serve, divide casserole between bowls and enjoy!",
      "secondary_message": null
    }
  ],
