  "instructions": [
    {
      "id": 239347,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz penne pasta"
    },
    {
      "id": 239348,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ oranges\n2 Granny Smith apples\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 239349,
      "primary_message": "Juice oranges into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 239350,
      "primary_message": "Add oil, vinegar, Dijon, maple syrup, salt, and pepper to the bowl with the orange juice; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 239351,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 239352,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 239353,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the skillet and pan-fry until cooked through and golden brown, 3-4 minutes per side. Remove from heat and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 239354,
      "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and thinly slice shallots into half-moons; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 239355,
      "primary_message": "Quarter, core, and thinly slice apples; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 239356,
      "primary_message": "Coarsely chop pecans and add to the bowl.",
      "secondary_message": "⅓ cup pecans, dry roasted"
    },
    {
      "id": 239357,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl along with the mixed greens. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 239358,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 239359,
      "primary_message": "To serve, divide the salad between plates or bowls and top with sliced chicken. Enjoy!",
      "secondary_message": null
    }
  ],
