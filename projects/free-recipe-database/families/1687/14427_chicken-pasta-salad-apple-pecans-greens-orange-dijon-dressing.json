  "instructions": [
    {
      "id": 239399,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n142 g penne pasta"
    },
    {
      "id": 239400,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ orange\n½ Granny Smith apple\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 239401,
      "primary_message": "Juice orange into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 239402,
      "primary_message": "Add oil, vinegar, Dijon, maple syrup, salt, and pepper to the bowl with the orange juice; whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 239403,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 239404,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 239405,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet and pan-fry until cooked through and golden brown, 3-4 minutes per side. Remove from heat and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 239406,
      "primary_message": "Meanwhile, using a clean cutting board, peel, halve, and thinly slice shallot into half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 239407,
      "primary_message": "Quarter, core, and thinly slice apple; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 239408,
      "primary_message": "Coarsely chop pecans and add to the bowl.",
      "secondary_message": "⅛ cup pecans, dry roasted"
    },
    {
      "id": 239409,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl along with the mixed greens. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 239410,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 239411,
      "primary_message": "To serve, divide the salad between plates or bowls and top with sliced chicken. Enjoy!",
      "secondary_message": null
    }
  ],
