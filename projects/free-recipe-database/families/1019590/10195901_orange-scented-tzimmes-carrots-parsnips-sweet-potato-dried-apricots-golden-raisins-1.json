  "instructions": [
    {
      "primary_message": "Preheat a large pot over medium-low heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pot heats up, peel, halve, and slice onion crosswise into thin half-moons.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft and golden, 10-15 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "454 g sweet potato"
    },
    {
      "primary_message": "Peel, trim, and slice carrots crosswise into 1-inch pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and large dice parsnips. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and large dice sweet potatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Small dice apricots and add to the bowl along with the raisins.",
      "secondary_message": "½ cup raisins"
    },
    {
      "primary_message": "Zest one orange into the bowl, then juice both oranges into the bowl and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "When the onions are done, add veggies and fruit to the pot along with water, honey, cinnamon, and salt; stir to combine the tzimmes. Cover and bring to a simmer over medium heat.",
      "secondary_message": "⅓ cup water\n⅓ cup honey\n½ tsp cinnamon, ground\n½ tsp salt"
    },
    {
      "primary_message": "Once the tzimmes is simmering, reduce heat to low and cook, still covered, until the veggies and fruit are soft, about 45 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "When the veggies and fruit are soft, uncover and continue to simmer, stirring occasionally, until sauce has thickened, 8-10 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer tzimmes to a serving dish and enjoy warm or at room temperature!",
      "secondary_message": null
    }
  ],
