  "instructions": [
    {
      "id": 278773,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n½ lb green beans"
    },
    {
      "id": 278774,
      "primary_message": "Peel, trim, and small dice carrot; trim and small dice celery. Place both in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 278775,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 278776,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the carrot and celery.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 278777,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 278778,
      "primary_message": "Meanwhile, drain and rinse kidney beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can kidney beans"
    },
    {
      "id": 278779,
      "primary_message": "When the veggies are soft, add broth and tomatoes; stir to combine the soup and bring to a boil.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 278780,
      "primary_message": "Once the soup is boiling, add the kidney beans and pasta; stir to combine. Reduce heat to medium, cover, and cook, stirring occasionally until the pasta is partially cooked, about 5 minutes.",
      "secondary_message": "3 oz macaroni (elbow) pasta"
    },
    {
      "id": 278781,
      "primary_message": "Meanwhile, trim and cut green beans into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 278782,
      "primary_message": "Add green beans to the soup and continue to cook, stirring occasionally, until pasta and veggies are tender, 3-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 278783,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
