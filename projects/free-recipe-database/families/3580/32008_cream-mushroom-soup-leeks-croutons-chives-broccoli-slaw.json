  "instructions": [
    {
      "id": 505959,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 505960,
      "primary_message": "While the pan heats up, cut bread into 1-inch cubes.",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 505961,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 3-4 minutes. Transfer to a small bowl, then season with salt and pepper. (Reserve pan for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 505962,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 leek\n⅓ kg cremini mushrooms\n½ small pkg chives"
    },
    {
      "id": 505963,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 505964,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the leeks.",
      "secondary_message": null
    },
    {
      "id": 505965,
      "primary_message": "Return pan to medium-high heat, add more oil, and swirl to coat the bottom. Add leeks, mushrooms, and spices; cook, stirring occasionally, until softened and mushrooms release their liquid, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 505966,
      "primary_message": "When the veggies are soft, add flour to the pan. Cook, stirring constantly, for 1 minute.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 505967,
      "primary_message": "Add broth to the pan, stir to combine the soup, and bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until mushrooms are very tender 8-10 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 505968,
      "primary_message": "Meanwhile, chop chives into small pieces. Place half in the reserved bowl along with oil, vinegar, Dijon, honey, salt, and pepper, then whisk to combine the dressing. (Reserve remaining chives for serving.)",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 505969,
      "primary_message": "Add broccoli slaw to the bowl with dressing, then stir to combine. Set aside.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 505970,
      "primary_message": "When the mushrooms are tender, using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": null
    },
    {
      "id": 505971,
      "primary_message": "Add cream to the pan. Continue to cook, stirring occasionally, until soup is warmed through, 1 minute more. Remove from heat.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 505972,
      "primary_message": "Divide soup between bowls; top with croutons and reserved chives. Serve with slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
