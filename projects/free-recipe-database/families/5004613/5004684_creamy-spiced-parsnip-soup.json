  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the yellow onions. Dice the celery. Dice the leek. Smash the garlic. Stem and roughly chop the jalapeño pepper. Peel the ginger sliced. Peel and roughly chop the parsnips. Juice the Lemon.",
      "secondary_message": "3 medium yellow onions\n2 stalks celery\n1 leek, white and light green parts only\n6 medium cloves garlic\n1 jalapeño pepper\n1 (5 cm) piece ginger root\n1.36 kg parsnips\n1 Lemon, to taste"
    },
    {
      "id": 1,
      "primary_message": "In a Dutch oven, heat oil over medium-high heat until shimmering. Add coriander seeds and cook until fragrant, about 30 seconds. Add onion, celery, leek, garlic, jalapeño, and ginger, and cook, stirring occasionally, until softened, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add parsnips and stock and bring to a boil. Lower heat and simmer until parsnips are tender, about 20 minutes. Using a blender or immersion blender, purée soup until smooth (it will be thick at this point). Season with salt and pepper. For an extra-silky texture, press soup into a bowl through a fine-mesh strainer. Thin soup to desired consistency with water or additional stock and season once more with salt and pepper. Add lemon juice 1 teaspoon at a time to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Wipe out Dutch oven and return soup to Dutch oven. Reheat over medium heat, stirring, until hot. Serve, spooning dollops of spiced whipped cream and a sprinkle of cayenne on each bowl.",
      "secondary_message": null
    }
  ],
