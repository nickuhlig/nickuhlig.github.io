  "instructions": [
    {
      "id": 62314,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 62313,
      "primary_message": "Wash blackberries.",
      "secondary_message": "3 (170 g) pkg blackberries"
    },
    {
      "id": 62312,
      "primary_message": "Season pork generously with salt and pepper.",
      "secondary_message": "6 pork chops, bone-in\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 62311,
      "primary_message": "Coat grill or bottom of skillet with oil. Place pork on grill/skillet and cook until cooked through, 4-6 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 62310,
      "primary_message": "Heat a small saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 62309,
      "primary_message": "Coat bottom of saucepan with oil. Add blackberries, vinegar, honey, and salt. Reduce heat to medium-low and, stirring occasionally, cook until sauce thickens and some of the berries collapse, 10-12 minutes.",
      "secondary_message": "¾ tbsp extra virgin olive oil\n6 tbsp balsamic vinegar\n1 ½ tbsp honey\n⅜ tsp salt"
    },
    {
      "id": 62308,
      "primary_message": "Grate 3 tsp of lemon zest. In a medium bowl, prepare dressing by whisking together lemon zest and juice, olive oil, honey, salt, and pepper.",
      "secondary_message": "zest and juice of 1 ½ lemon\n4 ½ tbsp extra virgin olive oil\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 62307,
      "primary_message": "Wash and dry arugula. Add to bowl with dressing and toss to coat.",
      "secondary_message": "1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 62306,
      "primary_message": "Shave or grate ⅓ cup of Parmesan.",
      "secondary_message": "42 g Parmesan cheese"
    },
    {
      "id": 62305,
      "primary_message": "To serve, place pork chops on a plate and spoon blackberry sauce over top. Add salad on the side and garnish with Parmesan and pine nuts. Enjoy!",
      "secondary_message": "⅜ cup pine nuts"
    }
  ],
