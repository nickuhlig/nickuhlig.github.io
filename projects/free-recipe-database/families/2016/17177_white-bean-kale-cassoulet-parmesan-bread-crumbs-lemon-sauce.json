  "instructions": [
    {
      "id": 279133,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n2 medium carrots\n1 stick celery\n½ bunch kale\n½ lemon"
    },
    {
      "id": 279134,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 279135,
      "primary_message": "Trim off the root end and dark green top of the leek, leaving only the white and pale green parts. Cut the leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise and place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 279136,
      "primary_message": "Peel, trim, and medium dice carrots; trim and thinly slice celery. Add both to the bowl with the leek. ",
      "secondary_message": null
    },
    {
      "id": 279137,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 279138,
      "primary_message": "While the skillet heats up, peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 279139,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and salt to the skillet; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 279140,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 279141,
      "primary_message": "When the veggies have softened, add kale, beans, broth, and spices to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium and cook, stirring occasionally, until beans and kale are tender, 8-10 minutes.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n½ tsp rosemary, dried\n½ tsp parsley flakes\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 279142,
      "primary_message": "Meanwhile, peel and mince additional garlic; finely grate Parmesan. Place both in the reserved bowl along with bread crumbs, oil, and pepper; use your hands to combine the bread crumb mixture.",
      "secondary_message": "1 clove garlic\n1 oz Parmesan cheese\n½ cup panko bread crumbs\n2 tsp extra virgin olive oil\n⅛ tsp black pepper"
    },
    {
      "id": 279143,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 279144,
      "primary_message": "When the beans and kale are tender, remove from the heat, and top with an even layer of the bread crumb mixture. (Reserve bowl for lemon sauce.)",
      "secondary_message": null
    },
    {
      "id": 279145,
      "primary_message": "Place skillet in the oven and broil until bread crumbs are golden brown and crisp, about 1 minute. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 279146,
      "primary_message": "Meanwhile, wipe the reserved bowl clean with paper towels. Zest and juice lemon into the bowl, then add mayo, parsley flakes, and salt; whisk to combine the lemon sauce.",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp parsley flakes\n1 pinch salt"
    },
    {
      "id": 279147,
      "primary_message": "To serve, divide \"cassoulet\" between plates or bowls and drizzle with lemon sauce. Enjoy!",
      "secondary_message": null
    }
  ],
