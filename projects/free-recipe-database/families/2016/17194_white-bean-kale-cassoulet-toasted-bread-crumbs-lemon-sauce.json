  "instructions": [
    {
      "id": 279388,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 leeks\n6 medium carrots\n3 sticks celery\n1 ½ bunches kale\n1 ½ lemons"
    },
    {
      "id": 279389,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 279390,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 279391,
      "primary_message": "Peel, trim, and medium dice carrots; trim and thinly slice celery. Add both to the bowl with the leek. ",
      "secondary_message": null
    },
    {
      "id": 279392,
      "primary_message": "Peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 279393,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 279394,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and salt to the pot; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 279395,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 279396,
      "primary_message": "When the veggies have softened, add kale, beans, broth, and spices to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium and cook, stirring occasionally, until beans and kale are tender, about 10 minutes.",
      "secondary_message": "355 ml chicken or vegetable broth\n1 ½ tsp rosemary, dried\n1 ½ tsp parsley flakes\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 279397,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in the reserved bowl along with bread crumbs, nutritional yeast, oil, and pepper; use your hands to combine the bread crumb mixture.",
      "secondary_message": "3 cloves garlic\n1 ½ cup panko bread crumbs\n¾ cup nutritional yeast flakes\n2 tbsp extra virgin olive oil\n½ tsp black pepper"
    },
    {
      "id": 279398,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 279399,
      "primary_message": "When the beans and kale are tender, remove from the heat, then transfer to a large baking dish; top with an even layer of the bread crumb mixture. (Reserve bowl for lemon sauce.)",
      "secondary_message": null
    },
    {
      "id": 279400,
      "primary_message": "Place baking dish in the oven and broil until bread crumbs are golden brown and crisp, about 1 minute. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 279401,
      "primary_message": "Meanwhile, wipe the reserved bowl clean with paper towels. Zest and juice lemons into the bowl, then add mayo, parsley flakes, and salt; whisk to combine the lemon sauce.",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 ½ tsp parsley flakes\n3 pinch salt"
    },
    {
      "id": 279402,
      "primary_message": "To serve, divide \"cassoulet\" between plates or bowls and drizzle with lemon sauce. Enjoy!",
      "secondary_message": null
    }
  ],
