  "instructions": [
    {
      "id": 485560,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 (2 ½ cm) piece ginger root\n1 mango\n2 Gala apples\n½ English cucumber\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 485561,
      "primary_message": "Zest lemon into a medium bowl. (Reserve lemon for later use.)",
      "secondary_message": null
    },
    {
      "id": 485562,
      "primary_message": "Peel and mince ginger and garlic. Add to the bowl with the lemon zest, along with yogurt and spices. Whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n¼ cup plain Greek yogurt\n1 tsp garam masala\n1 tsp curry powder\n½ tsp salt"
    },
    {
      "id": 485563,
      "primary_message": "Pat chicken thighs dry with paper towels. Add to the bowl with the marinade and, using your hands, toss to coat.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 485564,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485565,
      "primary_message": "While the pan heats up, juice reserved lemon into a clean medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 485566,
      "primary_message": "Once the grill pan is hot, coat with oil. Add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 485567,
      "primary_message": "Meanwhile, peel mango and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 485568,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 485569,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 485570,
      "primary_message": "Thinly slice jalapeño pepper into rings; seed and remove ribs with a spoon to reduce spice level. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 485571,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 485572,
      "primary_message": "To serve, divide grilled chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
