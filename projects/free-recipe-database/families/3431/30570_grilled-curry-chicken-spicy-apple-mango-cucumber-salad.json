  "instructions": [
    {
      "id": 485547,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 (1 inch) pieces ginger root\n3 mangoes\n6 Gala apples\n1 ½ English cucumbers\n3 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 485548,
      "primary_message": "Zest lemons into a large bowl. (Reserve lemons for later use.)",
      "secondary_message": null
    },
    {
      "id": 485549,
      "primary_message": "Peel and mince ginger and garlic. Add to the bowl with the lemon zest, along with yogurt and spices. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n¾ cup plain Greek yogurt\n1 tbsp garam masala\n1 tbsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 485550,
      "primary_message": "Pat chicken thighs dry with paper towels. Add to the bowl with the marinade and, using your hands, toss to coat.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 485551,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485552,
      "primary_message": "While the pan heats up, juice reserved lemons into a clean large bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 485553,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 485554,
      "primary_message": "Meanwhile, peel mangos and slice flesh away from the pits, starting with the flat sides; roughly chop the flesh. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 485555,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 485556,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 485557,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 485558,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 485559,
      "primary_message": "To serve, divide grilled chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
