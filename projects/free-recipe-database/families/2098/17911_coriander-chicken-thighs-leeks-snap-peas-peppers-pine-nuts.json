  "instructions": [
    {
      "id": 308716,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 308717,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 leeks\n1 ½ lemons\n3 yellow bell peppers\n3 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 308718,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 308719,
      "primary_message": "Peel and mince garlic; zest lemons. Add both to the bowl with the leek and set aside. (Reserve lemons for later use.)",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 308720,
      "primary_message": "Pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 308721,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 308722,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and cook until golden, about 2 minutes per side. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 308723,
      "primary_message": "Once golden, transfer to a clean plate and cover with aluminum foil (the chicken will not be cooked all the way through). Reserve skillet (with juices) for the next step.",
      "secondary_message": null
    },
    {
      "id": 308724,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add leek, garlic, lemon zest, and spices; cook, stirring occasionally, until the leek starts to soften, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp coriander, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 308725,
      "primary_message": "Meanwhile, trim, seed, and medium dice bell peppers; cut snap peas in half crosswise. Place both in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 308726,
      "primary_message": "When the leek is soft, add bell pepper, snap peas, and broth to the skillet; stir to combine and bring to a simmer over medium-high heat. ",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 308727,
      "primary_message": "Once simmering, transfer veggies to a large baking dish and add chicken (along with any accumulated juices); nestle chicken into the veggies. Place baking dish on lower rack of the oven and bake until veggies are tender and chicken is cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 308728,
      "primary_message": "When the chicken is done, remove from oven and juice reserved lemons over top.",
      "secondary_message": null
    },
    {
      "id": 308729,
      "primary_message": "To serve, divide chicken, veggies, and sauce between plates or bowls. Sprinkle with pine nuts and enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
