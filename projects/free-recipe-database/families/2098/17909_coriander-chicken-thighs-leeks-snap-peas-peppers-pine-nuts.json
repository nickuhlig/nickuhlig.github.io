  "instructions": [
    {
      "id": 308690,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 308691,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n½ lemon\n1 yellow bell pepper\n1 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 308692,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 308693,
      "primary_message": "Peel and mince garlic; zest lemon. Add both to the bowl with the leek and set aside. (Reserve lemon for later use.)",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 308694,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 308695,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 308696,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add chicken and cook until golden, about 2 minutes per side. Once golden, transfer to a clean plate and cover with aluminum foil (the chicken will not be cooked all the way through). Reserve skillet (with juices) for the next step.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 308697,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add leek, garlic, lemon zest, and spices; cook, stirring occasionally, until the leek starts to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 308698,
      "primary_message": "Meanwhile, trim, seed, and medium dice bell pepper; cut snap peas in half crosswise. Place both in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 308699,
      "primary_message": "When the leek is soft, add bell pepper, snap peas, and broth to the skillet; stir to combine and bring to a simmer over medium-high heat. ",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 308700,
      "primary_message": "Once simmering, return chicken to the skillet (along with any accumulated juices) and nestle into the veggies. Place skillet in the oven and bake until veggies are tender and chicken is cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 308701,
      "primary_message": "When the chicken is done, remove from oven and juice reserved lemon over top.",
      "secondary_message": null
    },
    {
      "id": 308702,
      "primary_message": "To serve, divide chicken, veggies, and sauce between plates or bowls. Sprinkle with pine nuts and enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
