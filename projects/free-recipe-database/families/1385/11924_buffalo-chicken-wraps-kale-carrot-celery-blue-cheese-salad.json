  "instructions": [
    {
      "id": 214292,
      "primary_message": "Place chili-garlic sauce, vinegar, Worcestershire, and spices in a medium bowl; whisk to combine the Buffalo sauce.",
      "secondary_message": "3 tbsp chili-garlic sauce\n2 tsp apple cider vinegar\n2 tsp Worcestershire sauce\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt"
    },
    {
      "id": 214293,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets; cut each fillet crosswise into 1-inch thick strips.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 214294,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 214295,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 214296,
      "primary_message": "Add chicken and buffalo sauce to the skillet, tossing to coat. Cook, turning strips occasionally, until cooked through; 5-6 minutes. Remove skillet from the heat and set aside. (Reserve sauce bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 214297,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 bunches kale\n2 medium carrots\n4 sticks celery"
    },
    {
      "id": 214298,
      "primary_message": "Using a clean cutting board, fold kale leaves in half lengthwise and slice off the thickest part of the stems. Set 12 leaves aside for the wraps.",
      "secondary_message": null
    },
    {
      "id": 214299,
      "primary_message": "Chop or tear remaining kale leaves into bite-sized pieces and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 214300,
      "primary_message": "Peel, trim, and grate carrots; add to the bowl with the kale. ",
      "secondary_message": null
    },
    {
      "id": 214301,
      "primary_message": "Trim celery and cut crosswise into ¼-inch pieces. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 214302,
      "primary_message": "Combine yogurt, mayo, blue cheese, Worcestershire, and spices in the reserved bowl. Whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n½ cup avocado oil mayonnaise\n1 (113 g) pkg crumbled blue cheese\n2 tsp Worcestershire sauce\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp black pepper"
    },
    {
      "id": 214303,
      "primary_message": "Place reserved kale leaves on a flat surface and spread with half of the blue cheese dressing. Divide chicken and half of the salad between them; roll tightly and secure with a toothpick if needed.",
      "secondary_message": null
    },
    {
      "id": 214304,
      "primary_message": "Divide wraps between plates. Serve with remaining salad and dressing on the side. Enjoy!",
      "secondary_message": null
    }
  ],
