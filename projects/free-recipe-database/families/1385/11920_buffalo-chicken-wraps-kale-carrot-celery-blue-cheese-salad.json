  "instructions": [
    {
      "id": 214243,
      "primary_message": "Place chili-garlic sauce, vinegar, honey, Worcestershire, and spices in a small bowl; whisk to combine the Buffalo sauce.",
      "secondary_message": "1 ½ tbsp chili-garlic sauce\n2 tsp apple cider vinegar\n2 tsp honey\n1 tsp Worcestershire sauce\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt"
    },
    {
      "id": 214244,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets; cut each fillet crosswise into 1-inch thick strips.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 214245,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 214246,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 214247,
      "primary_message": "Add chicken and buffalo sauce to the skillet, tossing to coat. Cook, turning strips occasionally, until cooked through; 4-5 minutes. Remove skillet from the heat and set aside. (Reserve sauce bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 214248,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ bunch kale\n2 medium carrots\n2 sticks celery"
    },
    {
      "id": 214249,
      "primary_message": "Using a clean cutting board, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 214250,
      "primary_message": "Peel, trim, and grate carrots; add to the bowl with the kale. ",
      "secondary_message": null
    },
    {
      "id": 214251,
      "primary_message": "Trim celery and cut crosswise into ¼-inch pieces. Add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 214252,
      "primary_message": "Place yogurt, blue cheese, water, Worcestershire, vinegar, and spices in the reserved bowl. Whisk to combine the dressing. ",
      "secondary_message": "½ cup plain Greek yogurt\n½ (113 g) pkg crumbled blue cheese\n1 tbsp water\n1 tsp Worcestershire sauce\n1 tsp apple cider vinegar\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp black pepper\n1 pinch salt"
    },
    {
      "id": 214253,
      "primary_message": "Place tortillas on a flat surface and spread with half of the blue cheese dressing. Divide chicken and half of the salad between them; roll tightly to close and cut in half. ",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 214254,
      "primary_message": "Divide wraps between plates. Serve with remaining salad and dressing on the side. Enjoy!",
      "secondary_message": null
    }
  ],
