  "instructions": [
    {
      "id": 406680,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 406681,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with oil, and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "4 crowns broccoli\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 406682,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until broccoli is golden brown and tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 406683,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 406684,
      "primary_message": "Mince olives, anchovy fillets, and capers. Add all three to the bowl with the parsley along with oil and vinegar; stir to combine the tapenade and set aside.",
      "secondary_message": "½ cup Kalamata olives, pitted\n2 anchovy fillets, packed in oil\n2 tbsp capers\n2 tbsp extra virgin olive oil\n2 tsp red wine vinegar"
    },
    {
      "id": 406685,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 406686,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 406687,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, about 5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 406688,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 406689,
      "primary_message": "To serve, divide steak between plates. Add tapenade to each plate, spreading it out in an even layer, then top with roasted broccoli. Enjoy!",
      "secondary_message": null
    }
  ],
