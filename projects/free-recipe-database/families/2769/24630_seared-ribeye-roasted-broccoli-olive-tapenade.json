  "instructions": [
    {
      "id": 406690,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 406691,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Divide between two large baking sheet pans, drizzle with oil, and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "6 crowns broccoli\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 406692,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until broccoli is golden brown and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 406693,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 406694,
      "primary_message": "Mince olives, anchovy fillets, and capers. Add all three to the bowl with the parsley along with oil and vinegar; stir to combine the tapenade and set aside.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n3 anchovy fillets, packed in oil\n3 tbsp capers\n3 tbsp extra virgin olive oil\n1 tbsp red wine vinegar"
    },
    {
      "id": 406695,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 406696,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 406697,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 406698,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 406699,
      "primary_message": "To serve, divide steak between plates. Add tapenade to each plate, spreading it out in an even layer, then top with roasted broccoli. Enjoy!",
      "secondary_message": null
    }
  ],
