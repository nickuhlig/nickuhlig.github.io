  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the yellow onion. Thinly slice the celery crosswise. Cut the carrots into 1/2 inch-thick slices. Slice the whole canned plum tomatoes into 1/2 inch-thick slices. Smash the garlic. Cut the bone-in skin-on split chicken breasts in half crosswise. Scrub and cut the red potatoes into 1 inch cubes. Chop the fresh cilantro leaves. Chop the fresh mint. Cut the limes into wedges. Cut the ripe avocado into 1/4 inch cubes.",
      "secondary_message": "1 medium yellow onion\n3 stalks celery\n3 medium carrots\n2 whole canned plum tomatoes\n4 cloves garlic\n2 bone-in skin-on split chicken breasts\n3 medium red potatoes\n1 cup fresh cilantro leaves\n¼ cup fresh mint\n2 limes\n1 ripe avocado"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in large pot or Dutch oven over medium-high heat until shimmering. Add onion, celery, carrots, tomatoes and juice, garlic, and 1 teaspoon salt and cook, stirring, until onion is softened and translucent, 5 to 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Season chicken with salt and pepper and add to pot. Add broth, water, rice, cilantro, and mint. Bring to a boil over high heat, then, reduce heat to medium-low and simmer, skimming surface from time to time. Simmer until chicken is cooked through, about 25 minutes. With tongs, remove chicken and place in bowl. Remove and discard cilantro and mint.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir potatoes and zucchini into pot and cook until fork-tender, about 15 minutes. Meanwhile, using 2 forks, carefully remove and discard chicken skin and bones. Shred chicken and return to pot. Adjust seasonings with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Serve in bowls and garnish with mint and cilantro. Serve with limes, avocado, and jalapeños.",
      "secondary_message": null
    }
  ],
