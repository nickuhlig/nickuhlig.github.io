  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the yellow onion. Seed and cut the green bell peppers into 1-inch squares.",
      "secondary_message": "¾ cup yellow onion, from 1 small onion\n2 medium green bell peppers"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, combine chickpea flour, red chile, cumin, and coriander. Place chickpea flour mixture in a medium nonstick skillet; cook over medium heat, stirring occasionally, until fragrant but not browned, about 1 minute. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Return pan to medium heat and add oil or ghee until shimmering. Add the mustard seeds and cook, stirring often, until they sputter, about 30 seconds. Add the onion; cook until slightly soft but not browned, about 1 minute. Add the bell peppers and salt and stir until fragrant and the mixture is coated with the ghee or oil, about 1 minute. Reduce heat to low; cook, stirring occasionally, until bell peppers are crisp tender and release their liquid, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the spiced flour mix and stir vigorously to blend the flour with the oil and juices in the pan until the bell peppers are evenly coated in seasoning, about 1 minute. Stop stirring and allow the dish to cook for 1 minute longer. Season to taste with salt. Serve hot with rotis and dal tadka.",
      "secondary_message": null
    }
  ],
