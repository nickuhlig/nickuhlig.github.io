  "instructions": [
    {
      "id": 1,
      "primary_message": "In a heavy-bottomed saucepan, bring milk to a simmer over medium-high heat, stirring frequently. Stir in cocoa nibs, cover, and let steep for 2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a clean heavy-bottomed saucepan, whisk together sugar and cocoa powder until no large lumps of cocoa remain. Then whisk in egg yolks until thoroughly combined. (Whisking in a different order will lead to a clumpy mess.)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Strain milk into yolk mixture, pressing on cocoa nibs to squeeze out all possible dairy, then whisk dairy to combine. Set pan over medium heat and cook, whisking frequently, until custard reaches 77°C on an instant-read thermometer. Custard should coat the back of a spoon and a finger swiped across it should leave a clean line.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add chocolate and stir until thoroughly melted. Strain into a container or bowl, add salt, and chill in refrigerator or ice bath until base cools to 4°C (4°C). Churn in ice cream maker according to manufacturer's instructions, then serve right away as soft serve or transfer to an airtight container to harden in freezer for 3 to 4 hours before scooping.",
      "secondary_message": null
    }
  ],
