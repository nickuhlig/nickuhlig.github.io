  "instructions": [
    {
      "id": 476723,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 476724,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 476725,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, sugar, and salt. Whisk to combine the marinade and set aside.",
      "secondary_message": "6 cloves garlic\n⅓ cup extra virgin olive oil\n⅓ cup apple cider vinegar\n1 ½ tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 476726,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 476727,
      "primary_message": "While the rice is cooking, wash and dry the fresh produce.",
      "secondary_message": "3 jalapeño peppers\n3 yellow bell peppers\n9 tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 476728,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl with the marinade. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 476729,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476730,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 476731,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 476732,
      "primary_message": "Cut tofu planks in half, then cut each half into two triangles. Place in another large bowl, add soy sauce and spices, then gently stir to coat.",
      "secondary_message": "3 tbsp soy sauce\n1 tbsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 476733,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 476734,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add tofu and grill until charred and warmed through, 3-4 minutes per side. Remove to a large plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 476735,
      "primary_message": "To serve, divide rice, tofu, and marinated tomatoes between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
