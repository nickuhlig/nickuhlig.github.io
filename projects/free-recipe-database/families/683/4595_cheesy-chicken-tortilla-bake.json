  "instructions": [
    {
      "id": 188944,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 188945,
      "primary_message": "Add chicken and salt to a medium saucepan. Cover with water and bring to a boil. ",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n1 tsp salt\n4 cup water"
    },
    {
      "id": 188946,
      "primary_message": "Turn heat down to medium and simmer until chicken is cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 188947,
      "primary_message": "Meanwhile, heat oil in a second saucepan over medium heat. ",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 188948,
      "primary_message": "Peel and small dice onion. Peel and mince garlic. Add both to second preheated pan.",
      "secondary_message": "1 medium yellow onion\n1 clove garlic"
    },
    {
      "id": 188949,
      "primary_message": "Wash and dry bell pepper and jalapeno. Seed and remove ribs with a spoon. Be careful, with jalapenos, not to touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.",
      "secondary_message": "½ red bell pepper\n½ jalapeño pepper"
    },
    {
      "id": 188950,
      "primary_message": "Small dice all peppers and add to the pan. ",
      "secondary_message": null
    },
    {
      "id": 188951,
      "primary_message": "Season with chili powder, cumin, and salt. Cook until vegetables are softened, about 5 minutes.",
      "secondary_message": "½ tsp chili powder\n½ tsp cumin\n½ tsp salt"
    },
    {
      "id": 188952,
      "primary_message": "Drain diced tomatoes; discard juice and add tomatoes to the pan. ",
      "secondary_message": "1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 188953,
      "primary_message": "Add yogurt, mayo, and flour to the pan, stirring to combine. Bring mixture to a boil and then reduce heat to minimum.",
      "secondary_message": "1 tbsp mayonnaise\n1 tbsp all-purpose flour\n¼ cup plain Greek yogurt"
    },
    {
      "id": 188954,
      "primary_message": "When chicken is done, drain and shred with a fork. Add to vegetable and yogurt mixture.",
      "secondary_message": null
    },
    {
      "id": 188955,
      "primary_message": "To assemble, place a tortilla on the bottom of a baking dish. Cover with half of the chicken mixture. Add a second tortilla and remainder of the chicken mixture. ",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 188956,
      "primary_message": "Top with cheese. Broil for 3 minutes until cheese on top melts and becomes golden brown. ",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 188957,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 188958,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 188959,
      "primary_message": "To serve, divide the tortilla between plates, top with green onions, cilantro, and a drizzle of yogurt. Enjoy!",
      "secondary_message": "⅛ cup plain Greek yogurt"
    }
  ],
