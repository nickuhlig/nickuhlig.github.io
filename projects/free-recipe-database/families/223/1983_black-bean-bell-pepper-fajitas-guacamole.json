  "instructions": [
    {
      "id": 18488,
      "primary_message": "Wash and dry bell peppers. Seed, slice into thin strips, and transfer to a bowl.",
      "secondary_message": "1 red bell pepper\r\n1 yellow bell pepper"
    },
    {
      "id": 18489,
      "primary_message": "Peel, thinly slice into half rings, and add onion to bowl with peppers. Peel and mince garlic; add ½ to bowl with vegetables and place the other ½ into a small bowl for preparing guacamole.",
      "secondary_message": "½ medium red onion\r\n2 cloves garlic"
    },
    {
      "id": 18490,
      "primary_message": "Halve avocado and remove pit; scoop out the flesh into bowl with garlic.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 18491,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 18492,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add ½ to bowl with avocado and save the rest for garnishing.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 18493,
      "primary_message": "Add lime juice, salt, and pepper to avocado. Mash with a fork until smooth. Set aside.",
      "secondary_message": "juice of ½ lime\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 18494,
      "primary_message": "Coat bottom of skillet with oil. Add peppers, onion, and garlic from bowl. Stirring frequently, cook until peppers are tender-crisp, 4-5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 18495,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 18496,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 18497,
      "primary_message": "Add beans to skillet with vegetables. Season with chili powder, cumin, salt, and pepper. Stir to combine and cook until beans are heated through, 1-2 minutes.",
      "secondary_message": "½ tsp chili powder\r\n½ tsp cumin\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 18498,
      "primary_message": "Cut remaining ½ lime into wedges.",
      "secondary_message": ""
    },
    {
      "id": 18499,
      "primary_message": "Place tortillas on a plate and top with fajita filling. Garnish with guacamole, remaining cilantro, and lime wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
