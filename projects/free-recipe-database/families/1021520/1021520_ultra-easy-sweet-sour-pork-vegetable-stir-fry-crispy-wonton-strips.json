  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom; add pork and cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove to a plate, reserving the skillet (with cooking juices) for the next step. ",
      "secondary_message": "neutral vegetable oil\n8 oz lean ground pork"
    },
    {
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies and stir-fry until warmed through and tender, 4-5 minutes.",
      "secondary_message": "neutral vegetable oil\n1 (16 oz) pkg frozen stir-fry vegetables"
    },
    {
      "primary_message": "When the veggies are tender, return cooked pork to the skillet and add sauce. Stir to combine and continue to cook until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "1 (11 oz) pkg sweet & sour cooking sauce"
    },
    {
      "primary_message": "To serve, divide pork stir-fry and sauce between plates or bowls. Top with wonton strips and enjoy!",
      "secondary_message": "1 cup wonton strips"
    }
  ],
