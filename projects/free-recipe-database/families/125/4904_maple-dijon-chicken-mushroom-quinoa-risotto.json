  "instructions": [
    {
      "id": 59651,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": ""
    },
    {
      "id": 59646,
      "primary_message": "In a small saucepan, combine quinoa, broth, and water; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n531 ml (2 ¼ cups) chicken or vegetable broth\n¾ cup water"
    },
    {
      "id": 59645,
      "primary_message": "Place chicken thighs in a baking dish.",
      "secondary_message": "1.362 kg chicken thighs, boneless skinless"
    },
    {
      "id": 59644,
      "primary_message": "Peel and mince garlic. In a medium bowl, mix together ½ of the garlic (save the rest for the mushrooms), maple syrup, Dijon, vinegar, rosemary, salt, and pepper. Pour over top chicken and turn to coat.",
      "secondary_message": "9 cloves garlic\n6 tbsp pure maple syrup\n6 tbsp Dijon mustard\n1 ½ tbsp rice vinegar\n1 ½ tsp rosemary\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 59650,
      "primary_message": "Place in the oven and roast until chicken is cooked through, 15-20 minutes. Scoop sauce over chicken halfway though.",
      "secondary_message": ""
    },
    {
      "id": 59643,
      "primary_message": "Wash, dry, and thinly slice mushrooms.",
      "secondary_message": "0.681 kg white mushrooms"
    },
    {
      "id": 59649,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 59642,
      "primary_message": "Coat bottom of skillet with oil. Add garlic and cook until fragrant, 15-30 seconds. Add mushrooms and season with rosemary, salt, and pepper. Stirring occasionally, cook until tender, 3-5 minutes.",
      "secondary_message": "about 3 tbsp extra virgin olive oil\n¾ tsp rosemary\n⅜ tsp salt\n3 pinches black pepper"
    },
    {
      "id": 59648,
      "primary_message": "Grate ⅓ cup of Parmesan.",
      "secondary_message": "42 g Parmesan cheese"
    },
    {
      "id": 59641,
      "primary_message": "Add broth to mushrooms and cook until liquid thickens, 2-3 minutes. Add spinach and stir until wilted. Then stir in quinoa and Parmesan.",
      "secondary_message": "177 ml (¾ cup) chicken or vegetable broth\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 59647,
      "primary_message": "To serve, place risotto on a plate and top with chicken. Enjoy!",
      "secondary_message": ""
    }
  ],
