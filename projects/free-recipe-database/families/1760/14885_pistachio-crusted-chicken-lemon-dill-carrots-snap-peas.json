  "instructions": [
    {
      "id": 246065,
      "primary_message": "Preheat oven to 220°C (425°F). Coat two baking sheet pans with a thin layer of oil and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 246066,
      "primary_message": "Finely chop pistachios and place in a medium bowl. Add spices and stir to combine the coating.",
      "secondary_message": "1 ½ cups pistachios, unsalted\n1 tbsp paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 246067,
      "primary_message": "Crack eggs into another medium bowl and beat with a whisk or fork.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 246068,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 246069,
      "primary_message": "Working one by one, dip chicken cutlets into the egg, shake off excess, then dredge in the pistachio coating, pressing to adhere. Divide between the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 246070,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until the chicken is golden and cooked through, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 246071,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 (227 g) pkg sugar snap peas\n1 ½ lemons"
    },
    {
      "id": 246072,
      "primary_message": "Using a clean cutting board, peel, trim, and slice carrots crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 246073,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 246074,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the carrots and snap peas; cook, stirring occasionally, until starting to soften, about 6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 246075,
      "primary_message": "Zest lemons into the pot and add spices; continue to cook, stirring occasionally, until veggies are fork-tender, 4 minutes more.",
      "secondary_message": "1 ½ tsp dill, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 246076,
      "primary_message": "Meanwhile, cut lemons into wedges for serving.",
      "secondary_message": null
    },
    {
      "id": 246077,
      "primary_message": "To serve, divide chicken and veggies between plates. Squeeze lemon over the chicken and enjoy!",
      "secondary_message": null
    }
  ],
