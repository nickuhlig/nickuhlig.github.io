  "instructions": [
    {
      "id": 460392,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 460393,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n0.23 kg cremini mushrooms\n1 tomato\n½ lime"
    },
    {
      "id": 460394,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 460395,
      "primary_message": "Thinly slice mushrooms. Add to the baking sheet with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 460396,
      "primary_message": "Drain and rinse beans. Add to the baking sheet, drizzle with oil, and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "1 (398 ml) can pinto beans\n1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 460397,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies and beans are tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 460398,
      "primary_message": "Meanwhile, small dice tomato and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 460399,
      "primary_message": "Juice lime into a small bowl. Add mayo, chili powder, and salt, then stir to combine the sauce. Set aside.",
      "secondary_message": "3 tbsp vegan mayonnaise\n½ tsp chili powder\n⅛ tsp salt"
    },
    {
      "id": 460400,
      "primary_message": "When the veggies are almost done, warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 460401,
      "primary_message": "To serve, divide tortillas between plates, then fill with roasted veggies and beans. Top tacos with tomatoes and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
