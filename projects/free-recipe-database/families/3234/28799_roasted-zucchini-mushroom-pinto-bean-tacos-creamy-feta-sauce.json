  "instructions": [
    {
      "id": 460372,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 460373,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n0.45 kg cremini mushrooms\n2 tomatoes\n1 lime"
    },
    {
      "id": 460374,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 460375,
      "primary_message": "Thinly slice mushrooms. Add to the baking sheet with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 460376,
      "primary_message": "Drain and rinse beans. Add to the baking sheet, drizzle with oil, and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 (398 ml) cans pinto beans\n2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 460377,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies and beans are tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 460378,
      "primary_message": "Meanwhile, small dice tomatoes and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 460379,
      "primary_message": "Juice lime into a small bowl. Add feta, mayo, chili powder, and salt, then stir to combine the sauce. Set aside.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n¼ cup mayonnaise\n1 tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 460380,
      "primary_message": "When the veggies are almost done, warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 460381,
      "primary_message": "To serve, divide tortillas between plates, then fill with roasted veggies and beans. Top tacos with tomatoes and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
