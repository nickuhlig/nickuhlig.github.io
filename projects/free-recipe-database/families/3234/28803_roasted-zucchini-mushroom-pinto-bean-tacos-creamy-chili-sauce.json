  "instructions": [
    {
      "id": 460412,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 460413,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n0.68 kg cremini mushrooms\n3 tomatoes\n1 ½ limes"
    },
    {
      "id": 460414,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 460415,
      "primary_message": "Thinly slice mushrooms. Add to the baking sheets with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 460416,
      "primary_message": "Drain and rinse beans. Add to the baking sheets, drizzle with oil, and season with spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "3 (398 ml) cans pinto beans\n3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n¾ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 460417,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies and beans are tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 460418,
      "primary_message": "Meanwhile, small dice tomatoes and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 460419,
      "primary_message": "Juice limes into a medium bowl. Add mayo, chili powder, and salt, then stir to combine the sauce. Set aside.",
      "secondary_message": "½ cup vegan mayonnaise\n1 ½ tsp chili powder\n½ tsp salt"
    },
    {
      "id": 460420,
      "primary_message": "When the veggies are almost done, warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small flour tortillas"
    },
    {
      "id": 460421,
      "primary_message": "To serve, divide tortillas between plates, then fill with roasted veggies and beans. Top tacos with tomatoes and sauce. Enjoy!",
      "secondary_message": null
    }
  ],
