  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the Spanish-style dry-cured chorizo into 1/2-inch dice. Cut the fresh corn kernels from 4 to 5 cobs of corn. Pick the cilantro leaves and tender stems from the thick stems and roughly chop them. Juice the lime.",
      "secondary_message": "4 oz Spanish-style dry-cured chorizo\n4 cups fresh corn kernels\n¼ cup fresh cilantro leaves, tender stems\n½ lime"
    },
    {
      "id": 1,
      "primary_message": "Combine chorizo and olive oil in a large, heavy-bottomed skillet and cook over medium-low heat, stirring frequently, until chorizo has rendered most of its fat and is crisp all around, about 5 minutes. Add corn, increase heat to high, and cook, stirring and tossing frequently, until corn is cooked through and deeply browned in spots, about 4 minutes. Stir in cilantro and lime juice and season with salt and pepper. Serve.",
      "secondary_message": null
    }
  ],
