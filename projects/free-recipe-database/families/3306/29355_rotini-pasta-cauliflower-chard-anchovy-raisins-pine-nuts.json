  "instructions": [
    {
      "id": 467729,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "¾ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 467730,
      "primary_message": "Meanwhile, preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 467731,
      "primary_message": "Once the pot is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve pot for later use.)",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 467732,
      "primary_message": "Wash and dry cauliflower; separate each head into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 467733,
      "primary_message": "Return pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467734,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add cauliflower and salt; cook stirring occasionally, until tender and deeply browned, about 10 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 467735,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl bowl and stems in another small bowl. (Set bowl with leaves aside.)",
      "secondary_message": "1 ½ bunches Swiss chard"
    },
    {
      "id": 467736,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the chard stems.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 467737,
      "primary_message": "Mince anchovy fillets. Add to the bowl, along with raisins and crushed red pepper, then stir to combine. Set aside.",
      "secondary_message": "9 anchovy fillets, packed in oil\n¾ cup raisins\n¾ tsp crushed red pepper"
    },
    {
      "id": 467738,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 467739,
      "primary_message": "When the cauliflower is browned, add anchovy mixture to the pot. Cook, stirring occasionally, until garlic is fragrant, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 467740,
      "primary_message": "Add drained pasta, ½-cup reserved pasta water, vinegar, and toasted pine nuts to the pot. Continue to cook, stirring frequently, until heated through, 2-3 minutes more. (Add more pasta water, 1 tablespoon at a time, as needed, to coat the pasta.)",
      "secondary_message": "3 tbsp red wine vinegar"
    },
    {
      "id": 467741,
      "primary_message": "Add chard leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 467742,
      "primary_message": "Add Parmesan and salt to the pot; continue to cook, stirring occasionally, until the chard is tender, 1-2 minutes more. Remove from heat.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 467743,
      "primary_message": "To serve, divide pasta between plates or bowls. Drizzle with oil and enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil"
    }
  ],
