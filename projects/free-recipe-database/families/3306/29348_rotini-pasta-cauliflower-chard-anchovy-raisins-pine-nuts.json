  "instructions": [
    {
      "id": 467624,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "½ tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 467625,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 467626,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 467627,
      "primary_message": "Wash and dry cauliflower; separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 467628,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467629,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower and salt; cook stirring occasionally, until tender and deeply browned, 7-10 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 467630,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl and stems in another small bowl. (Set bowl with leaves aside.)",
      "secondary_message": "1 bunch Swiss chard"
    },
    {
      "id": 467631,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the chard stems.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 467632,
      "primary_message": "Mince anchovy fillets. Add to the bowl, along with raisins and crushed red pepper, then stir to combine. Set aside.",
      "secondary_message": "6 anchovy fillets, packed in oil\n½ cup raisins\n½ tsp crushed red pepper"
    },
    {
      "id": 467633,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 467634,
      "primary_message": "When the cauliflower is browned, add anchovy mixture to the skillet. Cook, stirring occasionally, until garlic is fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 467635,
      "primary_message": "Add drained pasta, reserved pasta water, vinegar, and toasted pine nuts to the skillet. Continue to cook, stirring frequently, until heated through, 1-2 minutes more. (Add more pasta water, 1 tablespoon at a time, as needed, to coat the pasta.)",
      "secondary_message": "2 tbsp red wine vinegar"
    },
    {
      "id": 467636,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 467637,
      "primary_message": "Add Parmesan and salt to the skillet; continue to cook, stirring occasionally, until the chard is tender, 30-60 seconds more. Remove from heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 467638,
      "primary_message": "To serve, divide pasta between plates or bowls. Drizzle with oil and enjoy!",
      "secondary_message": "4 tsp extra virgin olive oil"
    }
  ],
