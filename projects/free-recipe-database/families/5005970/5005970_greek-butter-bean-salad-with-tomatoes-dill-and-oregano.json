  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the yellow onion. Mince the garlic. Drain and rinse the butter beans.",
      "secondary_message": "½ medium yellow onion\n2 medium cloves garlic\n1 (14 ½ oz) can butter beans"
    },
    {
      "id": 1,
      "primary_message": "In a medium skillet, heat oil over medium heat until shimmering. Add onion and garlic and cook, stirring, until tender and nearly translucent, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add beans, tomato puree, vinegar, dill, parsley, oregano, and cinnamon. Season with salt and pepper, bring to a simmer, and cook until flavors meld, about 3 minutes. Refrigerate until ready to serve or cool to room temperature before serving. This dish is best eaten at room temperature, so remove from the refrigerator 1 hour before serving. Before serving, drizzle with oil and garnish with extra herbs.",
      "secondary_message": null
    }
