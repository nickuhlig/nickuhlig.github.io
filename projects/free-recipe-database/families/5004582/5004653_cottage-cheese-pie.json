  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Beat the eggs.",
      "secondary_message": "2 medium eggs"
    },
    {
      "id": 1,
      "primary_message": "For the Crust: Pulse flour, pinch of salt, and baking powder in a food processor until combined, about 10 short pulses. Add cream cheese and pulse until coarsely incorporated, about 8 short pulses. Add butter cubes and pulse until dough forms pea-sized balls, about 8 short pulses. Add cream, vanilla, and vinegar and continue to pulse until dough pulls away from sides, 8 to 12 short pulses. Transfer dough to a large sheet of plastic wrap and shape into a 0.5-cm thick disc. Cover with plastic wrap and refrigerate for at least 2 hours and up to 3 days. Remove from refrigerator and press into a 23-cm pie plate, using fingertips to form an even layer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To Assemble: Adjust oven rack to center position and preheat oven to 180°C (350°F). Whisk together eggs, flour, and sugar using an electric handheld mixture until smooth. Fold in cottage cheese, lemon zest and juice, heavy cream, and vanilla extract. Pour into prepared pie shell. Bake until set in the middle, about 40 minutes. Let cool slightly and serve.",
      "secondary_message": null
    }
  ],
