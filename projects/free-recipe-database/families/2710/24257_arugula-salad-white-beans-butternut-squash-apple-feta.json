  "instructions": [
    {
      "id": 393489,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 393490,
      "primary_message": "Drain and rinse beans. Transfer to a large baking sheet pan and set aside.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 393491,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small butternut squash\n2 Granny Smith apples\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 393492,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and small dice. Add to the baking sheet with the beans. Drizzle with oil and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tsp thyme, dried\n½ tsp salt\n½ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 393493,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until beans are slightly crisp and squash is fork-tender, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 393494,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, maple syrup, and spices in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n4 tsp pure maple syrup\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 393495,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 393496,
      "primary_message": "When the beans and butternut squash are done, remove from the oven and let cool, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 393497,
      "primary_message": "Add cooled beans and squash, arugula, and feta to the bowl with the dressing and apple. Toss to combine the salad. ",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 393498,
      "primary_message": "To serve, divide salad between plates or bowls; top with pumpkin seeds. Enjoy!",
      "secondary_message": "¼ cup pumpkin seeds"
    }
  ],
