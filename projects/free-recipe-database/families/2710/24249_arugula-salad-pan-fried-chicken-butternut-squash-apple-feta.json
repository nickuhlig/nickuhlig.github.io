  "instructions": [
    {
      "id": 393397,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 393398,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ small butternut squash\n3 Granny Smith apples\n3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 393399,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and small dice. Transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n¾ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 393400,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden brown and fork-tender, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 393401,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 393402,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 393403,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove chicken to a plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 393404,
      "primary_message": "While the chicken is cooking, place oil, vinegar, Dijon, maple syrup, and spices in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n2 tbsp Dijon mustard\n1 ½ tbsp pure maple syrup\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 393405,
      "primary_message": "Using a clean cutting board, quarter, core, and small dice apples. Add to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 393406,
      "primary_message": "When the butternut squash is done, remove from the oven and let cool, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 393407,
      "primary_message": "Slice chicken into thin strips. ",
      "secondary_message": null
    },
    {
      "id": 393408,
      "primary_message": "Add cooled squash, arugula, and feta to the bowl with the dressing and apple. Toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 393409,
      "primary_message": "To serve, divide salad between plates or bowls; top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
