  "instructions": [
    {
      "id": 393430,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 393431,
      "primary_message": "Drain and rinse beans. Divide between two baking sheet pans and set aside.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 393432,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ small butternut squash\n3 Granny Smith apples\n3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 393433,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and small dice. Add to the baking sheets with the beans. Drizzle with oil and season with spices; toss to coat and spread out in an even layer. ",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tbsp thyme, dried\n¾ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 393434,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until beans are slightly crisp and squash is fork-tender, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 393435,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, maple syrup, and spices in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n2 tbsp Dijon mustard\n2 tbsp pure maple syrup\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 393436,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 393437,
      "primary_message": "When the beans and butternut squash are done, remove from the oven and let cool, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 393438,
      "primary_message": "Add cooled beans and squash, arugula, and feta to the bowl with the dressing and apple. Toss to combine the salad. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 393439,
      "primary_message": "To serve, divide salad between plates or bowls; top with pumpkin seeds. Enjoy!",
      "secondary_message": "⅓ cup pumpkin seeds"
    }
  ],
