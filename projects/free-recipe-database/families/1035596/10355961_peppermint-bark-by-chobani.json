  "instructions": [
    {
      "primary_message": "TO MAKE THE GANACHE: Plate a pot of hot water on the stove. Bring to a simmer. This will be used as a double boiler.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place 4 cups white chocolate and heavy cream in a metal bowl that will fit on top of the simmering pot of water. Make sure that the water does not touch the bottom of the bowl.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Stir mixture with a whisk, occasionally, until chocolate and heavy cream are melted together. Remove the bowl from the heat and allow to cool for 3 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Slowly add in Chobani® whole milk plain Greek yogurt and 1 tsp peppermint extract, then whisk until smooth. Set aside and cool to room temperature.\n",
      "secondary_message": null
    },
    {
      "primary_message": "TO MAKE THE BARK: Line a half sheet pan (approximately 18 x 13-inch) with parchment paper.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place the semi-sweet chocolate chips in a bowl that will fit on top of the pot without letting the water touch the bottom of bowl. Add more water if needed. Using a rubber spatula, stir occasionally until chocolate is completely melted.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from heat and spread chocolate evenly on parchment-lined sheet pan. Place pan in refrigerator and allow to harden.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place 3 cups white chocolate in a clean bowl that will fit on top of pot. Repeat step 3.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from heat and let cool for 5 minutes, occasionally stirring with a rubber spatula. Add 1/2 tsp peppermint extract to white chocolate and stir to combine.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove pan with semi-sweet chocolate from refrigerator and spread white chocolate on top evenly. Return to fridge to harden.\n",
      "secondary_message": null
    },
    {
      "primary_message": "TO ASSEMBLE: Once both layers of chocolate are hardened and ganache is at room temperature, spread the ganache evenly over bark. Sprinkle peppermint pieces over ganache and place bark in freezer to set for at least 30 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut or break into desired size pieces. Store in freezer.\n",
      "secondary_message": null
    }
  ],
