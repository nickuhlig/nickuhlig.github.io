  "instructions": [
    {
      "id": 299108,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches cilantro\n6 medium zucchini squash\n3 jalapeño peppers\n1 ½ bunches radish\n1 ½ limes"
    },
    {
      "id": 299110,
      "primary_message": "Shave cilantro leaves off the stems; discard stems. Place half of the leaves in a small bowl and set aside for serving; mince remaining leaves and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 299112,
      "primary_message": "Add veggie ground, salt, and pepper to the bowl with the minced cilantro; mix with your hands until well combined. Form the mixture into 6 equal-sized patties, place on a plate, and set aside. ",
      "secondary_message": "680 g veggie ground, plant based\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 299114,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 299115,
      "primary_message": "While the skillet heats up, place mayo and chili-garlic sauce in another small bowl; stir to combine the spicy mayo and set aside.",
      "secondary_message": "¼ cup vegan mayonnaise\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 299116,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 299117,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 299118,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the zucchini; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 299119,
      "primary_message": "Peel, halve, and thinly slice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 299120,
      "primary_message": "Once the patties are done, transfer to a clean plate and loosely cover with aluminum foil. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 299121,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 299122,
      "primary_message": "Add zucchini, jalapeño, water, salt, and pepper to the skillet; continue to cook, stirring occasionally, until veggies are fork-tender, 4-5 minutes more.",
      "secondary_message": "3 tbsp water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 299123,
      "primary_message": "Meanwhile, trim and thinly slice radishes.",
      "secondary_message": null
    },
    {
      "id": 299124,
      "primary_message": "When the veggies are done, juice limes into the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 299125,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 299126,
      "primary_message": "Place bottom half of each bun on a plate; spread with spicy mayo, then layer with veggie burgers, radish, and reserved cilantro leaves. Close with the top half of each bun and serve with sautéed veggies on the side. Enjoy!",
      "secondary_message": null
    }
  ],
