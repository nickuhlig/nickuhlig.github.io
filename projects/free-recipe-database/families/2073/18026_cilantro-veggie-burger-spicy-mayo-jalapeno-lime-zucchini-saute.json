  "instructions": [
    {
      "id": 298816,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n2 medium zucchini squash\n1 jalapeño pepper\n½ bunch radish\n½ lime"
    },
    {
      "id": 298817,
      "primary_message": "Shave cilantro leaves off the stems; discard stems. Place half of the leaves in a small bowl and set aside for serving; mince remaining leaves and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 298818,
      "primary_message": "Add veggie ground, salt, and pepper to the bowl with the minced cilantro; mix with your hands until well combined. Form the mixture into 2 equal-sized patties, place on a plate, and set aside. ",
      "secondary_message": "8 oz veggie ground, plant based\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 298819,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 298820,
      "primary_message": "While the skillet heats up, place mayo and chili-garlic sauce in another small bowl; stir to combine the spicy mayo and set aside.",
      "secondary_message": "1 ½ tbsp vegan mayonnaise\n1 tsp chili-garlic sauce"
    },
    {
      "id": 298821,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes. Transfer to a clean plate and loosely cover with foil. (Reserve skillet for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 298822,
      "primary_message": "Meanwhile, trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Place in another small bowl.",
      "secondary_message": null
    },
    {
      "id": 298823,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl with the zucchini; set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 298824,
      "primary_message": "Peel, halve, and thinly slice onion. Peel and mince garlic.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 298825,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 298826,
      "primary_message": "Add zucchini, jalapeño, water, salt, and pepper to the skillet; continue to cook, stirring occasionally, until veggies are fork-tender, 3-4 minutes more.",
      "secondary_message": "1 tbsp water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 298827,
      "primary_message": "Meanwhile, trim and thinly slice radishes.",
      "secondary_message": null
    },
    {
      "id": 298828,
      "primary_message": "When the veggies are done, juice lime into the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 298829,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 298830,
      "primary_message": "Place bottom half of each bun on a plate; spread with spicy mayo, then layer with veggie burgers, radish, and reserved cilantro leaves. Close with the top half of each bun and serve with sautéed veggies on the side. Enjoy!",
      "secondary_message": null
    }
  ],
