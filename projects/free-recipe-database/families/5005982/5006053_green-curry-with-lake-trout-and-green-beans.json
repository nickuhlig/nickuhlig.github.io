  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the baby eggplants into 1/2-inch cubes. Remove the skin from the lake trout, then cut it into 1-inch cubes. Pick the basil leaves from the stems and roughly chop them.",
      "secondary_message": "1 cup baby eggplants\n227 g lake trout\n8 leaves basil leaves"
    },
    {
      "id": 1,
      "primary_message": "Without shaking the coconut milk can, remove the lid and spoon off a 1/4 cup of the thick cream on top. Transfer this to a 30-cm non-stick skillet, and turn the heat to medium-high. When the fat separates and liquid starts to sizzle, stir in the green curry paste and reduce the heat to medium-low. Cook, stirring occasionally, until the paste is very fragrant, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the green beans and eggplant and stir well with the curry paste. Cook, stirring occasionally, until coated in the curry paste and starting to soften, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour in the remaining coconut milk, stir to combine, and then bring to a boil over medium-high heat. Reduce heat to maintain a steady simmer, and cook for seven minutes. Add the frozen peas and fish pieces, and continue cooking until they are almost cooked through, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add fish sauce, chicken stock, and sugar and stir to dissolve sugar. Simmer for 1 minute longer. Remove from off the heat, add most of the Thai basil. Add lime juice to taste. Serve the curry in bowls with white rice on the side. Garnish with remaining Thai basil.",
      "secondary_message": null
    }
  ],
