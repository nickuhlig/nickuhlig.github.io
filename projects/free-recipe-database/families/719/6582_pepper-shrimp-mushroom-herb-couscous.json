  "instructions": [
    {
      "id": 104769,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 104770,
      "primary_message": "In a medium bowl combine olive oil, crushed red pepper, black pepper, paprika, and salt. Add shrimp and toss until well coated; set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp crushed red pepper\n¾ tsp black pepper\n1 ½ tsp paprika\n¾ tsp salt"
    },
    {
      "id": 104771,
      "primary_message": "In a large pot, bring the broth to a boil.",
      "secondary_message": "1065 ml chicken or vegetable broth"
    },
    {
      "id": 104772,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n0.68 kg cremini mushrooms\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ small pkgs fresh thyme"
    },
    {
      "id": 104773,
      "primary_message": "Add the couscous to the pot, stir, remove from heat, and cover. Let sit for 5 minutes, then fluff with a fork.",
      "secondary_message": "3 cups whole wheat couscous"
    },
    {
      "id": 104774,
      "primary_message": "Peel and mince the shallots. Small dice the bell peppers.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 104775,
      "primary_message": "Preheat a large nonstick skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 104776,
      "primary_message": "Add the shallots and bell peppers to the skillet and cook, stirring frequently, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 104777,
      "primary_message": "Slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 104778,
      "primary_message": "Add the mushrooms and shrimp to the skillet. Cook until the shrimp are translucent, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 104779,
      "primary_message": "Shave the leaves off the parsley; discard the stems and mince the leaves. Set aside (saving a small amount for garnish). Repeat for the thyme.",
      "secondary_message": null
    },
    {
      "id": 104780,
      "primary_message": "Remove the skillet from heat; stir in the cooked couscous, parsley, and thyme. If necessary, use a large bowl to combine the couscous with the shrimp and vegetables.",
      "secondary_message": null
    },
    {
      "id": 104781,
      "primary_message": "To serve, divide between bowls and garnish with fresh herbs. Enjoy!",
      "secondary_message": null
    }
  ],
