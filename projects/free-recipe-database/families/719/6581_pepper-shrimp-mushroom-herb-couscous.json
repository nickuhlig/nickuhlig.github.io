  "instructions": [
    {
      "id": 104755,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 104756,
      "primary_message": "In a medium bowl combine olive oil, crushed red pepper, black pepper, paprika, and salt. Add shrimp and toss until well coated; set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp crushed red pepper\n½ tsp black pepper\n1 tsp paprika\n½ tsp salt"
    },
    {
      "id": 104757,
      "primary_message": "In a small saucepan, bring the broth to a boil.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 104758,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n0.45 kg cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg fresh thyme"
    },
    {
      "id": 104759,
      "primary_message": "Add the couscous to the saucepan, stir, remove from heat, and cover. Let sit for 5 minutes, then fluff with a fork.",
      "secondary_message": "2 cups whole wheat couscous"
    },
    {
      "id": 104760,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 104761,
      "primary_message": "Peel and mince the shallots. Small dice the bell peppers.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 104762,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 104763,
      "primary_message": "Add the shallots and bell peppers to the skillet and cook, stirring frequently, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 104764,
      "primary_message": "Slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 104765,
      "primary_message": "Add the mushrooms and shrimp to the skillet. Cook until the shrimp are translucent, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 104766,
      "primary_message": "Shave the leaves off the parsley; discard the stems and mince the leaves. Set aside (saving a small amount for garnish). Repeat for the thyme.",
      "secondary_message": null
    },
    {
      "id": 104767,
      "primary_message": "Remove skillet from heat; stir in the cooked couscous, parsley, and thyme.",
      "secondary_message": null
    },
    {
      "id": 104768,
      "primary_message": "To serve, divide between bowls and garnish with fresh herbs. Enjoy!",
      "secondary_message": null
    }
  ],
