  "instructions": [
    {
      "id": 104700,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 104701,
      "primary_message": "In a medium bowl combine olive oil, crushed red pepper, black pepper, paprika, and salt. Add shrimp and toss until well coated; set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp crushed red pepper\n¼ tsp black pepper\n½ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 104702,
      "primary_message": "In a small saucepan, bring the broth to a boil.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 104703,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n½ lb cremini mushrooms\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg fresh thyme"
    },
    {
      "id": 104704,
      "primary_message": "Add the couscous to the saucepan, stir, remove from heat, and cover. Let sit for 5 minutes, then fluff with a fork.",
      "secondary_message": "1 cup whole wheat couscous"
    },
    {
      "id": 104705,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 104706,
      "primary_message": "Peel and mince the shallot. Small dice the bell pepper.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 104707,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 104708,
      "primary_message": "Add the shallot and bell pepper to the skillet and cook, stirring frequently, until softened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 104709,
      "primary_message": "Slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 104710,
      "primary_message": "Add the mushrooms and shrimp to the skillet. Cook, stirring frequently, until the shrimp are translucent, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 104711,
      "primary_message": "Shave the leaves off the parsley; discard the stems and mince the leaves. Set aside (saving a small amount for garnish). Repeat for the thyme.",
      "secondary_message": null
    },
    {
      "id": 104712,
      "primary_message": "Remove skillet from heat; stir in the cooked couscous, parsley, and thyme.",
      "secondary_message": null
    },
    {
      "id": 104713,
      "primary_message": "To serve, divide between bowls and garnish with fresh herbs. Enjoy!",
      "secondary_message": null
    }
  ],
