  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 150°C (300°F), position rack in middle position, and grease a rimmed baking sheet with oil or nonstick cooking spray. In a medium bowl, stir together sugar, cocoa powder, chocolate, salt, cinnamon, cayenne, nutmeg, allspice, and ginger.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, lightly beat egg white until slightly foamy. Stir in spiced sugar until a smooth batter forms (it will start out looking dry but will loosen as you stir).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fold in pecans until evenly coated. Spread glazed pecans in a single even layer on the prepared baking sheet and bake until nuts are lightly toasted, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Let cool, stirring nuts every few minutes to prevent sticking. Once cool, break up any remaining clumps and serve. Nuts can be stored in an airtight container at room temperature for up to 1 week.",
      "secondary_message": null
    }
  ],
