  "instructions": [
    {
      "id": 478628,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 478629,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 bunches Swiss chard\n3 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 478630,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 478631,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a large bowl and stems in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 478632,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 478633,
      "primary_message": "While the pot heats up, peel and thinly slice garlic. Add to the bowl with the chard stems.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 478634,
      "primary_message": "When the pot is hot, add oil and swirl to coat the bottom. Add chard stems, garlic, and crushed red pepper. Cook, stirring occasionally, until garlic is fragrant, about 1 minute.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp crushed red pepper"
    },
    {
      "id": 478635,
      "primary_message": "Add beans and salt to the pot. Continue to cook, stirring occasionally, until warmed through, 1-2 minutes more.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 478636,
      "primary_message": "Add chard leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 478637,
      "primary_message": "Zest and juice lemons into the pot.",
      "secondary_message": null
    },
    {
      "id": 478638,
      "primary_message": "Halve olives lengthwise. Add to the pot along with the feta.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 478639,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add half to the pot and stir to combine. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 478640,
      "primary_message": "To serve, divide quinoa and bean-chard sauté between bowls. Drizzle with oil and top with reserved mint. Enjoy!",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    }
  ],
