  "instructions": [
    {
      "id": 478615,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n2 cup water\n½ tsp salt"
    },
    {
      "id": 478616,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 bunches Swiss chard\n2 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 478617,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 478618,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl and stems in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 478619,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 478620,
      "primary_message": "While the skillet heats up, peel and thinly slice garlic. Add to the bowl with the chard stems.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 478621,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, garlic, and crushed red pepper. Cook, stirring occasionally, until garlic is fragrant, about 30 seconds.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp crushed red pepper"
    },
    {
      "id": 478622,
      "primary_message": "Add beans and salt to the skillet. Continue to cook, stirring occasionally, until warmed through, about 1 minute.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 478623,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 478624,
      "primary_message": "Zest and juice lemons into the skillet.",
      "secondary_message": null
    },
    {
      "id": 478625,
      "primary_message": "Halve olives lengthwise. Add to the skillet along with the feta.",
      "secondary_message": "½ cup Kalamata olives, pitted\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 478626,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add half to the skillet and stir to combine. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 478627,
      "primary_message": "To serve, divide quinoa and bean-chard sauté between bowls. Drizzle with oil and top with reserved mint. Enjoy!",
      "secondary_message": "1 tbsp extra virgin olive oil"
    }
  ],
