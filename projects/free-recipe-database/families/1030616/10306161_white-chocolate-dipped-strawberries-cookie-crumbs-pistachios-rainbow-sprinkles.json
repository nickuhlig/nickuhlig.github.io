  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place cookies in a resealable plastic bag and have fun crushing them. (Use your hands, a flat-bottomed glass, rolling pin, or small saucepan to help!) Transfer to a small bowl and set aside.",
      "secondary_message": "½ cup vanilla shortbread cookie"
    },
    {
      "primary_message": "Finely chop pistachios. Place in another small bowl and set aside.\n\n",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "primary_message": "Place sprinkles in a third small bowl and set aside. \n\n",
      "secondary_message": "½ cup rainbow sprinkles"
    },
    {
      "primary_message": "Place melting chocolate in a microwave safe bowl. Place bowl in the microwave and heat on 50% power or defrost setting for 1 minute. Stir, then repeat heating at 50% power for 30-second intervals, until smooth and completely melted. \n\n",
      "secondary_message": "1 (283 g) pkg melting white chocolate candy wafers"
    },
    {
      "primary_message": "Meanwhile, wash and dry strawberries. Place on a plate and set aside.\n\n\n\n",
      "secondary_message": "1 (454 g) pkg strawberries"
    },
    {
      "primary_message": "Line additional plates with parchment paper for everyone who will be taking part in decorating strawberries.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Working with one strawberry at a time, gather the leaves into a \"handle\" then carefully dip into the chocolate. (Alternatively, you can insert a skewer or fork in the stem end of the strawberries to assist with dipping.) Dip chocolate-covered strawberries in one (or several!) of the toppings, then transfer to the parchment-lined plate. Repeat with remaining strawberries.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Show off your creations, share, and enjoy!",
      "secondary_message": null
    }
  ],
