  "instructions": [
    {
      "id": 226206,
      "primary_message": "Set butter on the counter to soften.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 226207,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 226208,
      "primary_message": "Wash, dry, trim, and halve strawberries; transfer to a small baking dish. Drizzle with vanilla and sprinkle with sugar.",
      "secondary_message": "1 (454 g) pkg strawberries\n1 tsp vanilla extract\n1 ½ tbsp brown sugar"
    },
    {
      "id": 226209,
      "primary_message": "Place dish in the oven (it doesn't have to be fully heated) and bake until strawberries are soft and starting to release their juices, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 226210,
      "primary_message": "Meanwhile, combine sugar and cinnamon in a small bowl.",
      "secondary_message": "2 tbsp brown sugar\n1 tsp cinnamon, ground"
    },
    {
      "id": 226211,
      "primary_message": "Place bread slices on a baking sheet pan; spread with softened butter and sprinkle with half of the cinnamon-sugar. Set remaining cinnamon-sugar aside.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 226212,
      "primary_message": "Place bread in the oven and bake until toasted and bubbling, about 5 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 226213,
      "primary_message": "Remove strawberries from the oven and gently crush with a potato masher or fork. Set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 226214,
      "primary_message": "To serve, divide toast between plates and top with strawberries. Sprinkle with remaining cinnamon-sugar and enjoy!",
      "secondary_message": null
    }
  ],
