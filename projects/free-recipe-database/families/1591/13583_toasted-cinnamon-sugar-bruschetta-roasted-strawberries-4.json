  "instructions": [
    {
      "primary_message": "Set butter on the counter to soften.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and halve strawberries; transfer to a baking dish. Drizzle with vanilla and sprinkle with sugar.",
      "secondary_message": "2 (454 g) pkg strawberries\n2 tsp vanilla extract\nbrown sugar"
    },
    {
      "primary_message": "Place dish in the oven (it doesn't have to be fully heated) and bake until strawberries are soft and starting to release their juices, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, combine sugar and cinnamon in a small bowl.",
      "secondary_message": "brown sugar\n2 tsp cinnamon, ground"
    },
    {
      "primary_message": "Place bread slices on a large baking sheet pan; spread with softened butter and sprinkle with half of the cinnamon-sugar. Set remaining cinnamon-sugar aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place bread in the oven and bake until toasted and bubbling, about 5 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove strawberries from the oven and gently crush with a potato masher or fork. Set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide toast between plates and top with strawberries. Sprinkle with remaining cinnamon-sugar and enjoy!",
      "secondary_message": null
    }
  ],
