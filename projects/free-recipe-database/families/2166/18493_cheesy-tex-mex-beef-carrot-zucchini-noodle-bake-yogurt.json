  "instructions": [
    {
      "id": 302921,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 medium carrots\n3 yellow bell peppers\n3 tomatoes"
    },
    {
      "id": 302922,
      "primary_message": "Trim zucchini and carrots; use a julienne (or regular) peeler to make noodles. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 302923,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the veggie noodles and set aside.",
      "secondary_message": null
    },
    {
      "id": 302924,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 302925,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302926,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add onion, garlic, beef, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg lean ground beef\n2 tbsp chili powder\n1 tbsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 302927,
      "primary_message": "Meanwhile, grate cheddar and set aside.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 302928,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 302929,
      "primary_message": "When the beef is done, add veggie noodles, bell pepper, and water to the pot; continue to cook, stirring occasionally, until the liquid has evaporated and veggies are tender, 4-5 minutes more.",
      "secondary_message": "¾ cup water"
    },
    {
      "id": 302930,
      "primary_message": "Meanwhile, medium dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 302931,
      "primary_message": "When the veggies are tender, add tomato and tomato sauce to the pot; stir to combine and bring to a simmer.",
      "secondary_message": "3 (213 ml) cans tomato sauce"
    },
    {
      "id": 302932,
      "primary_message": "Once simmering, transfer beef and veggie mixture to a large baking dish; sprinkle with cheese. Place in the oven and broil until cheese is melted and golden, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 302933,
      "primary_message": "To serve, divide bake between plates or bowls and top with a dollop of yogurt. Enjoy!",
      "secondary_message": "⅓ cup plain Greek yogurt"
    }
  ],
