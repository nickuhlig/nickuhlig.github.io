  "instructions": [
    {
      "id": 302934,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 medium carrot\n1 yellow bell pepper\n1 tomato"
    },
    {
      "id": 302935,
      "primary_message": "Trim zucchini and carrot; use a julienne (or regular) peeler to make noodles. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 302936,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl with the veggie noodles and set aside.",
      "secondary_message": null
    },
    {
      "id": 302937,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 302938,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 302939,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion, garlic, veggie ground, and spices. Cook, breaking the veggie ground apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n2 tsp chili powder\n1 tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 302940,
      "primary_message": "Meanwhile, grate cheddar and set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 302941,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 302942,
      "primary_message": "When the veggie ground is done, add veggie noodles, bell pepper, and water to the skillet; continue to cook, stirring occasionally, until the liquid has evaporated and veggies are tender, 3-4 minutes more.",
      "secondary_message": "¼ cup water"
    },
    {
      "id": 302943,
      "primary_message": "Meanwhile, medium dice tomato.",
      "secondary_message": null
    },
    {
      "id": 302944,
      "primary_message": "When the veggies are tender, add tomato and tomato sauce to the skillet; stir to combine and bring to a simmer. Once simmering, remove from heat and sprinkle with cheddar.",
      "secondary_message": "1 (213 ml) can tomato sauce"
    },
    {
      "id": 302945,
      "primary_message": "Place skillet in the oven and broil until cheese is melted and golden, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 302946,
      "primary_message": "To serve, divide skillet between plates or bowls and top with a dollop of yogurt. Enjoy!",
      "secondary_message": "⅛ cup plain Greek yogurt"
    }
  ],
