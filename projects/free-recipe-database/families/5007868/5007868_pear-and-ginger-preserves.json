  "instructions": [
    {
      "id": 1,
      "primary_message": "Place pears, white sugar, brown sugar, lemon juice, lemon zest, crystallized ginger, and minced ginger in a medium saucepan. Bring to a boil over medium-high heat. Reduce heat to medium and continue to cook, stirring occasionally, until thickened and sauce has gelled, 20 to 30 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer sauce to an airtight container and place in refrigerator 24 hours before using, or can by ladling jam into jars, leaving 1/4-inch headspace. Cover and process jars in boiling hot water bath for 10 minutes. Remove from water and let cool for 24 hours. Store in a cool dark place. Refrigerate after opening.",
      "secondary_message": null
    }
  ],
