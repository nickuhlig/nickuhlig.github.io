  "instructions": [
    {
      "id": 403296,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 403297,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ lb green beans\n½ medium head napa cabbage"
    },
    {
      "id": 403298,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 403299,
      "primary_message": "While the rice is cooking, juice lime into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 403300,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with fish sauce, soy sauce, sugar, cornstarch, oil, and chili-garlic sauce. Whisk to combine the sauce.",
      "secondary_message": "1 clove garlic\n2 tbsp fish sauce\n1 tbsp soy sauce\n1 tbsp brown sugar\n1 tbsp cornstarch\n2 tsp extra virgin olive oil\n1 tsp chili-garlic sauce"
    },
    {
      "id": 403301,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry, then add to the bowl with the sauce. Stir to coat and set aside to marinate.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 403302,
      "primary_message": "Meanwhile, trim off and discard root end of cabbage; quarter lengthwise, then cut crosswise into bite-sized pieces. Place in another medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 403303,
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. ",
      "secondary_message": null
    },
    {
      "id": 403304,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 403305,
      "primary_message": "While the skillet heats up, peel and thinly slice additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 403306,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green beans and garlic; cook, stirring frequently, until beans begin to soften, about 3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 403307,
      "primary_message": "Add cabbage to the skillet. Continue to cook, stirring frequently, until veggies are just tender, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 403308,
      "primary_message": "Add shrimp, sauce, and cashews to the skillet. Cook, stirring occasionally, until shrimp is opaque and sauce has thickened, about 3 minutes. Remove from heat.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 403309,
      "primary_message": "To serve, divide rice and shrimp stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
