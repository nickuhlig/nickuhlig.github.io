  "instructions": [
    {
      "id": 403324,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 403325,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 ½ lb green beans\n1 ½ medium heads napa cabbage"
    },
    {
      "id": 403326,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 403327,
      "primary_message": "While the rice is cooking, juice limes into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 403328,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with fish sauce, soy sauce, sugar, cornstarch, oil, and chili-garlic sauce. Whisk to combine the sauce.",
      "secondary_message": "3 cloves garlic\n⅓ cup fish sauce\n3 tbsp soy sauce\n3 tbsp brown sugar\n3 tbsp cornstarch\n2 tbsp extra virgin olive oil\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 403329,
      "primary_message": "If using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry, then add to the bowl with the sauce. Stir to coat and set aside to marinate.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 403330,
      "primary_message": "Meanwhile, trim off and discard root end of each cabbage; quarter lengthwise, then cut crosswise into bite-sized pieces. Place in another large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 403331,
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. ",
      "secondary_message": null
    },
    {
      "id": 403332,
      "primary_message": "Peel and thinly slice additional garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 403333,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 403334,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add green beans and garlic; cook, stirring frequently, until beans begin to soften, about 4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 403335,
      "primary_message": "Add cabbage to the pot. Continue to cook, stirring frequently, until veggies are just tender, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 403336,
      "primary_message": "Add shrimp, sauce, and cashews to the pot. Cook, stirring occasionally, until shrimp is opaque and sauce has thickened, 4-5 minutes. Remove from heat.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 403337,
      "primary_message": "To serve, divide rice and shrimp stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
