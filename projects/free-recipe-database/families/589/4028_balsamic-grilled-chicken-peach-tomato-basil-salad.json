  "instructions": [
    {
      "id": 45071,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 peaches\n4 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 45072,
      "primary_message": "Halve the tomatoes lengthwise and cut out and discard the stem ends; cut the halves into thin wedges. Transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45073,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard the pits; cut each quarter lengthwise into thin wedges. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45074,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 45075,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Transfer to a medium bowl (that will be used to marinade the chicken).",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 45076,
      "primary_message": "To the garlic, add olive oil, balsamic vinegar, salt, and pepper; whisk together.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 45077,
      "primary_message": "Pat dry the chicken breasts with paper towels and place in the bowl with the marinade; turn to coat.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 45078,
      "primary_message": "Carefully place the chicken breasts in the grill pan / skillet; cook until the chicken is golden brown and cooked through (check doneness with a thermometer or cut into the chicken with a knife), 6 to 8 minutes per side. Once done, transfer the chicken to plate.",
      "secondary_message": null
    },
    {
      "id": 45079,
      "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise. Add to the salad bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 45080,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45081,
      "primary_message": "Drizzle the salad with olive oil and balsamic vinegar, then season with salt and pepper; gently toss until well combined.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 45082,
      "primary_message": "Slice the chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 45083,
      "primary_message": "To serve, divide the salad and chicken slices between plates. Enjoy!",
      "secondary_message": null
    }
  ],
