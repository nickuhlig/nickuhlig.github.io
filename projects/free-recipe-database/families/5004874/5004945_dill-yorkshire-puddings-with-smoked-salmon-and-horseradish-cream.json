  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Yorkshire Pudding: Adjust oven rack to middle position and preheat oven to 230°C (450°F). Combine the eggs, flour, milk, and garlic in a blender and blend until smooth, about 30 seconds. Transfer to a medium bowl. Mix in chopped dill and season with salt and pepper. Cover and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Horseradish Cream: In a medium bowl, whisk together the crème fraîche and horseradish and season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Divide vegetable oil between muffin wells. Place muffin tin in oven and heat until oil is lightly smoking, about 10 minutes. Remove muffin tin from oven and working quickly, divide batter among the muffin cups. Return to oven and bake until Yorkshire puddings are puffed and golden, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Serve the Yorkshire puddings immediately with smoked salmon and horseradish cream, garnishing with scallions and sliced lemon.",
      "secondary_message": null
    }
  ],
