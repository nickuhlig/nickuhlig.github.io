  "instructions": [
    {
      "id": 145541,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 145542,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 crown broccoli\n1 small bunch green onions (scallions)"
    },
    {
      "id": 145543,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 145544,
      "primary_message": "Peel and mince or grate the ginger. Peel and mince the garlic. Chop the broccoli into small pieces. Transfer all to a medium bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 145545,
      "primary_message": "Trim off the ends of the green onions; cut crosswise into ¼-inch pieces at an angle. Transfer half the onions to the bowl with the other veggies; set the other half aside to use as garnish.",
      "secondary_message": null
    },
    {
      "id": 145546,
      "primary_message": "Preheat a nonstick skillet over high heat. Add oil and swirl to coat bottom.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 145547,
      "primary_message": "Crack the eggs into a medium bowl and beat with a whisk or fork.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 145548,
      "primary_message": "Add half of the egg mixture to the skillet and gently swirl the pan so that the egg forms a thin layer coating the bottom of the pan. Cook until the egg is just set and the edges begin to turn golden, about 1 minute. Carefully slide the egg onto a cutting board and allow to cool for a few minutes.",
      "secondary_message": null
    },
    {
      "id": 145549,
      "primary_message": "Add more oil to the pan and repeat with the remaining eggs.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 145550,
      "primary_message": "Return the skillet to the stove and lower the heat to medium. Add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 145551,
      "primary_message": "Add the bowl of veggies to the skillet. Cook, stirring occasionally, until broccoli turns bright green, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 145552,
      "primary_message": "Add peas and edamame to the skillet and continue cooking for another 2 minutes.",
      "secondary_message": "1 ½ cups frozen peas\n1 ½ cups edamame"
    },
    {
      "id": 145553,
      "primary_message": "Meanwhile, roll the egg omelets tightly and cut on a diagonal into ½-inch slices.",
      "secondary_message": null
    },
    {
      "id": 145554,
      "primary_message": "Add rice and soy sauce to the skillet and cook, stirring often, until well combined and heated through, 3-4 minutes.",
      "secondary_message": "⅓ cup soy sauce"
    },
    {
      "id": 145555,
      "primary_message": "To serve, divide fried rice between plates and top with egg slices and remaining green onion. Enjoy!",
      "secondary_message": null
    }
  ],
