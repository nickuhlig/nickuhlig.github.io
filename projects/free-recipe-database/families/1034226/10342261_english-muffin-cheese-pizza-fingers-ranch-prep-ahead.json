  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium and 4 mini food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Split muffins and arrange, cut-side down, on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, 2-3 minutes. Remove from oven. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spread toasted muffins with pizza sauce, then top with cheese and Italian seasoning. \n\n",
      "secondary_message": "1 cup pizza sauce\n⅔ cup shredded cheese, Italian blend\n⅛ tsp Italian seasoning"
    },
    {
      "primary_message": "Return baking sheet to the oven and continue to broil until cheese is melted, 1-2 minutes. Remove from oven and set aside to cool.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, divide ranch between the mini food storage containers, cover with lids, and set aside.\n\n",
      "secondary_message": "½ cup ranch dressing"
    },
    {
      "primary_message": "Cut cooled pizzas into \"fingers.\" Divide pizza fingers and dressing between the medium food storage containers, cover with a lid, and refrigerate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, warm pizza fingers in a toaster oven or microwave (if desired), then dip in ranch. Enjoy!",
      "secondary_message": null
    }
  ],
