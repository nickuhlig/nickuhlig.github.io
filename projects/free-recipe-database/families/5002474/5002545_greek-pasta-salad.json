  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Grate or mince the garlic. Halve the cherry tomatoes. Chop the Persian cucumbers. Halve the pitted mixed Greek olives. Drain the jarred sliced pepperoncini peppers. Slice and roughly chop the pickled red onions. Crumble the block feta cheese packed in brine. Pick the dill fronds from the stems and chop them.",
      "secondary_message": "1 lemon\n1 medium clove garlic\n0.34 kg cherry tomatoes\n3 medium Persian cucumbers\n1 cup pitted mixed Greek olives\n¾ cup jarred sliced pepperoncini peppers\n⅓ cup pickled red onions\n227 g block feta cheese packed in brine\n⅓ cup fresh dill, plus more for serving"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk oil, red wine vinegar, lemon juice, Dijon mustard, honey, garlic, oregano, 1 1/2 teaspoons kosher salt, and pepper until combined; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large pot of salted boiling water, cook pasta until fully tender, about 2 minutes past the al dente stage. Drain pasta and transfer to a rimmed baking sheet, then quickly toss with 1/2 cup of prepared dressing. Let cool completely on sheet pan, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add tomatoes, cucumbers, olives, pepperoncini, pickled onions, feta, dill, and cooled pasta to the large bowl with remaining dressing and toss until evenly coated. Season to taste with salt and pepper. Cover and refrigerate until flavors meld, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer pasta salad to a serving bowl. Top with additional dill. Serve.",
      "secondary_message": null
    }
  ],
