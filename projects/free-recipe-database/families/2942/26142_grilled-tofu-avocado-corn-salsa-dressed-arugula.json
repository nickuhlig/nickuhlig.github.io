  "instructions": [
    {
      "id": 415876,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 415877,
      "primary_message": "Meanwhile, place corn in a colander and rinse under hot water (from the tap) to defrost. Transfer to a medium bowl. ",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 415878,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl with the corn, along with the salsa, and stir to combine; set aside.",
      "secondary_message": "3 avocados\n1 ½ cup salsa"
    },
    {
      "id": 415879,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415880,
      "primary_message": "While the pan heats up, cut the tofu planks in half crosswise. Sprinkle with cornstarch, chili powder, and salt on both sides. ",
      "secondary_message": "3 tbsp cornstarch\n1 tbsp chili powder\n1 ½ tsp salt"
    },
    {
      "id": 415881,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add tofu and cook until golden, 2-3 minutes per side. Transfer to a plate. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 415882,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 415883,
      "primary_message": "To serve, divide tofu, salsa, and arugula between plates; drizzle arugula with vinaigrette. Enjoy!",
      "secondary_message": "⅓ cup French vinaigrette"
    }
  ],
