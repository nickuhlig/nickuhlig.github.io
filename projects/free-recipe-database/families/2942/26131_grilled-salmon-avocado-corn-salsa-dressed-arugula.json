  "instructions": [
    {
      "id": 415794,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415795,
      "primary_message": "While the pan heats up, pat salmon dry with paper towels. Place on a plate and season the top side with salt and pepper. ",
      "secondary_message": "¾ lb salmon fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 415796,
      "primary_message": "Once the pan is hot, coat with oil. Add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 415797,
      "primary_message": "Meanwhile, place corn in a colander and rinse under hot water (from the tap) to defrost. Transfer to a small bowl. ",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 415798,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the bowl with the corn, along with the salsa, and stir to combine; set aside.",
      "secondary_message": "1 avocado\n½ cup salsa"
    },
    {
      "id": 415799,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed).",
      "secondary_message": "½ (5 oz) pkg baby arugula"
    },
    {
      "id": 415800,
      "primary_message": "To serve, divide salmon, salsa, and arugula between plates; drizzle arugula with vinaigrette. Enjoy!",
      "secondary_message": "2 tbsp French vinaigrette"
    }
  ],
