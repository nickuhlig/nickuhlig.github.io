  "instructions": [
    {
      "id": 273255,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 273256,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "⅓ kg sweet potato\n½ small bunch fresh dill\n½ lemon\n2 medium carrots\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 273257,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 273258,
      "primary_message": "Place oil, sesame seeds, spices, and sugar in a medium bowl; stir to combine the spice oil.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp sesame seeds\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp paprika\n½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp brown sugar"
    },
    {
      "id": 273259,
      "primary_message": "Peel, trim, and slice sweet potato crosswise into ½-inch thick rounds. Add to the bowl with the spice oil along with chickpeas; using your hands, gently toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 273260,
      "primary_message": "Transfer chickpeas and sweet potato to a baking sheet pan, then spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 273261,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping sweet potato halfway through, until sweet potato is tender and chickpeas are crisp, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 273262,
      "primary_message": "Meanwhile, wipe reserved bowl clean with paper towels. ",
      "secondary_message": null
    },
    {
      "id": 273263,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in the bowl. ",
      "secondary_message": null
    },
    {
      "id": 273264,
      "primary_message": "Juice lemon into the bowl with the dill. ",
      "secondary_message": null
    },
    {
      "id": 273265,
      "primary_message": "Add feta, yogurt, mayo, water, salt, and pepper to the bowl; whisk to combine the dressing. (Add additional water, 1 teaspoon at a time, if necessary, to reach a drizzling consistency.)",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n¼ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tbsp water\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 273266,
      "primary_message": "Peel, trim, and julienne or coarsely grate carrots; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 273267,
      "primary_message": "Roughly chop spinach, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 273268,
      "primary_message": "To serve, divide chickpeas, sweet potato, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
