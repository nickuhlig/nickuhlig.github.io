  "instructions": [
    {
      "id": 273283,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 273284,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1.02 kg sweet potatoes\n1 small bunch fresh dill\n1 ½ lemons\n6 medium carrots\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 273285,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 273286,
      "primary_message": "Place oil, sesame seeds, spices, and sugar in a large bowl; stir to combine the spice oil.",
      "secondary_message": "⅓ cup extra virgin olive oil\n2 tbsp sesame seeds\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n1 ½ tsp paprika\n1 ½ tsp chili powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp brown sugar"
    },
    {
      "id": 273287,
      "primary_message": "Peel, trim, and slice sweet potatoes crosswise into ½-inch thick rounds. Add to the bowl with the spice oil along with chickpeas; using your hands, gently toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 273288,
      "primary_message": "Divide chickpeas and sweet potato between two baking sheet pans, then spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 273289,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, flipping sweet potato halfway through, until sweet potato is tender and chickpeas are crisp, about 25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 273290,
      "primary_message": "Meanwhile, wipe reserved bowl clean with paper towels. ",
      "secondary_message": null
    },
    {
      "id": 273291,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in the bowl. ",
      "secondary_message": null
    },
    {
      "id": 273292,
      "primary_message": "Juice lemons into the bowl with the dill. ",
      "secondary_message": null
    },
    {
      "id": 273293,
      "primary_message": "Add feta, yogurt, mayo, water, salt, and pepper to the bowl; whisk to combine the dressing. (Add additional water, 1 tablespoon at a time, if necessary, to reach a drizzling consistency.)",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n3 tbsp water\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 273294,
      "primary_message": "Peel, trim, and julienne or coarsely grate carrots; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 273295,
      "primary_message": "Roughly chop spinach, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 273296,
      "primary_message": "To serve, divide chickpeas, sweet potato, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
