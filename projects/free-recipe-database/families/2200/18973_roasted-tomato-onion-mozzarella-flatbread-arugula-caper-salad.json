  "instructions": [
    {
      "id": 312059,
      "primary_message": "Preheat oven to 450°F. Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 312060,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 pints grape tomatoes\n1 ½ lemons\n1 ½ yellow bell peppers\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 312061,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces; halve tomatoes. Transfer both to a large baking sheet pan, drizzle with oil, and season with spices. Toss to combine, then spread out in an even layer.",
      "secondary_message": "1 ½ medium red onions\n1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 312062,
      "primary_message": "Place baking sheet on the upper rack of the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies soften, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 312063,
      "primary_message": "Meanwhile, divide flatbreads between two baking sheets. Place on the middle and lower racks and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 312064,
      "primary_message": "While the flatbreads are baking, juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 312065,
      "primary_message": "Peel and mince garlic; mince capers. Add both to the bowl with the lemon juice along with oil, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp capers\n2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 312066,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 312067,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 312068,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 312069,
      "primary_message": "When the veggies are done, sprinkle mozzarella over the flatbreads; top with the roasted veggies and half of the basil. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 312070,
      "primary_message": "Return flatbreads to the oven and bake until warmed through and cheese is melted, 5-6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 312071,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and bell pepper; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 312072,
      "primary_message": "Slice flatbreads, divide between plates, and sprinkle with reserved basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
