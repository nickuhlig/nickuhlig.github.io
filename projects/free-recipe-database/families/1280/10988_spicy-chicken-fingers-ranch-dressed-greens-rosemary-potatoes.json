  "instructions": [
    {
      "id": 180963,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 180964,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n1 head romaine lettuce\n1 small pkg grape tomatoes"
    },
    {
      "id": 180965,
      "primary_message": "Peel and mince garlic; place in a large bowl along with oil and spices.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp rosemary\n½ tsp black pepper"
    },
    {
      "id": 180966,
      "primary_message": "Halve potatoes, add to the bowl with the garlic oil, and toss to combine. Spread out in a single layer on a large baking sheet pan and place in the oven. Roast until potatoes are fork-tender, tossing halfway through, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 180967,
      "primary_message": "Slice the chicken breasts into ¾-inch strips. Place in the bowl used for the potatoes and season with chili-garlic sauce, salt, and pepper; toss to combine.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n1 tbsp chili-garlic sauce\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 180968,
      "primary_message": "Add bread crumbs to the bowl with the chicken and toss well to coat. Place on another large baking sheet pan and drizzle with oil. Add to the oven, and bake until cooked through, turning once, about 15 minutes.",
      "secondary_message": "1 cup panko bread crumbs\n2 tsp extra virgin olive oil"
    },
    {
      "id": 180969,
      "primary_message": "Meanwhile, finely grate Parmesan and place in a clean large bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 180970,
      "primary_message": "Add mayo, vinegar, oil, and spices to the bowl with the Parmesan; whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n4 tsp white wine vinegar\n2 tsp extra virgin olive oil\n¼ tsp dill\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 180971,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 180972,
      "primary_message": "Halve tomatoes and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 180973,
      "primary_message": "To serve, divide rosemary potatoes, chicken strips, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
