  "instructions": [
    {
      "id": 180952,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 180953,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg new potatoes\n½ head romaine lettuce\n½ small pkg grape tomatoes"
    },
    {
      "id": 180954,
      "primary_message": "Peel and mince garlic; place in a medium bowl along with oil and spices.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp rosemary\n¼ tsp black pepper"
    },
    {
      "id": 180955,
      "primary_message": "Halve potatoes, add to the bowl with the garlic oil, and toss to combine. Spread out in a single layer on a baking sheet pan and place in the oven. Roast until potatoes are fork-tender, tossing halfway through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 180956,
      "primary_message": "Slice the chicken breasts into ¾-inch strips. Place in the bowl used for the potatoes and season with chili-garlic sauce, salt, and pepper; toss to combine.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n1 ½ tsp chili-garlic sauce\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 180957,
      "primary_message": "Add bread crumbs to the bowl with the chicken and toss well to coat. Place on another baking sheet pan and drizzle with oil. Add to the oven, and bake until cooked through, turning once, 12-15 minutes.",
      "secondary_message": "½ cup panko bread crumbs\n1 tsp extra virgin olive oil"
    },
    {
      "id": 180958,
      "primary_message": "Meanwhile, finely grate Parmesan and place in a clean medium bowl.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 180959,
      "primary_message": "Add mayo, vinegar, oil, and spices to the bowl with the Parmesan; whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp mayonnaise\n2 tsp white wine vinegar\n1 tsp extra virgin olive oil\n⅛ tsp dill\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 180960,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 180961,
      "primary_message": "Halve tomatoes and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 180962,
      "primary_message": "To serve, divide rosemary potatoes, chicken strips, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
