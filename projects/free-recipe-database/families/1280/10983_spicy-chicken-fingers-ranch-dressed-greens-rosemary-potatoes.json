  "instructions": [
    {
      "id": 180908,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 180909,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n1 ½ heads romaine lettuce\n1 ½ pints grape tomatoes"
    },
    {
      "id": 180910,
      "primary_message": "Peel and mince garlic; place in a large bowl along with oil and spices.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp rosemary\n¾ tsp black pepper"
    },
    {
      "id": 180911,
      "primary_message": "Halve potatoes, add to the bowl with the garlic oil, and toss to combine. Spread out in a single layer between two baking sheet pans and place in the oven. Roast until potatoes are fork-tender, tossing halfway through, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 180912,
      "primary_message": "Slice the chicken breasts into ¾-inch strips. Place in the bowl used for the potatoes and season with chili-garlic sauce, salt, and pepper; toss to combine.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tbsp chili-garlic sauce\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 180913,
      "primary_message": "Add bread crumbs to the bowl with the chicken and toss well to coat. Place on a third large baking sheet pan and drizzle with oil. Add to the oven, and bake until cooked through, turning once, about 15 minutes.",
      "secondary_message": "1 ½ cup panko bread crumbs\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 180914,
      "primary_message": "Meanwhile, finely grate Parmesan and place in a clean large bowl.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 180915,
      "primary_message": "Add mayo, vinegar, oil, and spices to the bowl with the Parmesan; whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp white wine vinegar\n1 tbsp extra virgin olive oil\n½ tsp dill\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 180916,
      "primary_message": "Chop or tear romaine leaves into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 180917,
      "primary_message": "Halve tomatoes and add to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 180918,
      "primary_message": "To serve, divide rosemary potatoes, chicken strips, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
