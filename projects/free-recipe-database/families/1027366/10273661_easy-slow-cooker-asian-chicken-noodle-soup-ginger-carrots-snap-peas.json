  "instructions": [
    {
      "primary_message": "Pat chicken dry with paper towels and medium dice. Place in a 6-quart slow cooker insert along with broth, shredded carrots, vinegar, soy sauce, ginger paste, salt, and pepper. Stir to combine, cover, and cook until chicken is cooked through and tender, 3-4 hours on LOW.",
      "secondary_message": "680 g chicken breasts, boneless skinless\n8 cups chicken or vegetable broth\n1 (283 g) bag shredded carrots\n2 tbsp rice vinegar\n2 tbsp soy sauce\n1 tbsp ginger paste\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "When the chicken is cooked through, wash and dry snap peas. Break pasta in half. Add both to the slow cooker, along with hoisin sauce, and stir to combine. Continue to cook until snap peas and pasta are tender, about 30 minutes.",
      "secondary_message": "1 (227 g) pkg sugar snap peas\n170 g angel hair pasta\n2 tbsp hoisin sauce"
    },
    {
      "primary_message": "To serve, divide soup between bowls. Enjoy!",
      "secondary_message": null
    }
