  "instructions": [
    {
      "id": 397098,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 397099,
      "primary_message": "Place curry paste, water, oil, sesame seeds, and spices in a large bowl. Stir to combine the marinade. ",
      "secondary_message": "⅓ cup Thai curry paste, green\n⅓ cup water\n¼ cup toasted sesame oil\n1 tbsp sesame seeds\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 397100,
      "primary_message": "Wash, dry, trim, and seed bell peppers; large dice. Add to the bowl with the marinade along with the broccoli and mushrooms; stir to coat.",
      "secondary_message": "3 red bell peppers\n1 ½ (18 oz) bags broccoli florets\n3 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 397101,
      "primary_message": "Divide veggies between two large baking sheet pans and spread out in an even layer. Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 397102,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 397103,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 397104,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 397105,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 397106,
      "primary_message": "To serve, divide steak and veggies between plates; sprinkle veggies with more sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
