  "instructions": [
    {
      "id": 397089,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 397090,
      "primary_message": "Place curry paste, water, oil, sesame seeds, and spices in a large bowl. Stir to combine the marinade. ",
      "secondary_message": "¼ cup Thai curry paste, green\n¼ cup water\n3 tbsp toasted sesame oil\n2 tsp sesame seeds\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 397091,
      "primary_message": "Wash, dry, trim, and seed bell peppers; large dice. Add to the bowl with the marinade along with the broccoli and mushrooms; stir to coat.",
      "secondary_message": "2 red bell peppers\n1 (18 oz) bag broccoli florets\n2 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 397092,
      "primary_message": "Transfer veggies to a large baking sheet pan and spread out in an even layer. Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 12-15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 397093,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 397094,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 397095,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 397096,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 397097,
      "primary_message": "To serve, divide steak and veggies between plates; sprinkle veggies with more sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
