  "instructions": [
    {
      "id": 397080,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 397081,
      "primary_message": "Place curry paste, water, oil, sesame seeds, and spices in a medium bowl. Stir to combine the marinade. ",
      "secondary_message": "2 tbsp Thai curry paste, green\n2 tbsp water\n1 ½ tbsp toasted sesame oil\n1 tsp sesame seeds\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 397082,
      "primary_message": "Wash, dry, trim, and seed bell pepper; large dice. Add to the bowl with the marinade along with the broccoli and mushrooms; stir to coat.",
      "secondary_message": "1 red bell pepper\n½ (18 oz) bag broccoli florets\n1 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 397083,
      "primary_message": "Transfer veggies to a baking sheet pan and spread out in an even layer. Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 12-15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 397084,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 397085,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "¾ lb ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 397086,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 397087,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 397088,
      "primary_message": "To serve, divide steak and veggies between plates; sprinkle veggies with more sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
