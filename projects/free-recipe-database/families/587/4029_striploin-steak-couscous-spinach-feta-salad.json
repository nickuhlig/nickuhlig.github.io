  "instructions": [
    {
      "id": 45084,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach\n1 lemon"
    },
    {
      "id": 45085,
      "primary_message": "Grate all of the zest from the lemon, then juice the lemon; add both to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45086,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the salad bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 45087,
      "primary_message": "To the salad bowl, add olive oil, salt, and pepper; whisk together and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 45088,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 45089,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 45090,
      "primary_message": "Once the skillet is hot, add the pine nuts; cook, stirring constantly, until they are golden brown, 2 to 3 minutes. Once done, add to the salad bowl.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 45091,
      "primary_message": "Once the pine nuts have been transferred, add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 45092,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 45093,
      "primary_message": "Add the broth and water to a small saucepan; bring to a boil over high heat.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n4 fl oz (½ cup) water"
    },
    {
      "id": 45094,
      "primary_message": "In batches, stack the spinach leaves and roll tightly into a cigar, then slice crosswise into a chiffonade (thin ribbons). Transfer to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 45095,
      "primary_message": "Once the liquid comes to a boil, add couscous and salt; give it a stir and cover with a lid. Remove from the heat and let it stand for 5 minutes.",
      "secondary_message": "1 cup whole wheat couscous\n½ tsp salt"
    },
    {
      "id": 45096,
      "primary_message": "Add the feta to the salad bowl.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 45097,
      "primary_message": "Place the steak on a cutting board and thinly slice against the grain into strips.",
      "secondary_message": null
    },
    {
      "id": 45098,
      "primary_message": "Uncover the couscous and fluff with a fork; add to the salad bowl and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 45099,
      "primary_message": "To serve, divide the steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
