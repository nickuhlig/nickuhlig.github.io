  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thaw the frozen puff pastry. Thinly slice the mortadella.",
      "secondary_message": "½ lb frozen puff pastry\n¼ lb mortadella"
    },
    {
      "id": 1,
      "primary_message": "Preheat a Belgian waffle iron according to manufacturer directions. Combine olive oil, parsley, garlic, and capers and, using a mini food processor or an immersion blender, process into a semi-smooth sauce. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Lightly dust a work surface with flour. Lay out puff pastry sheet, lightly flour top, and roll into an approximate 16- by 16-inch square. Spread garlic sauce on puff pastry, leaving a 1 inch border on all edges. Layer mortadella on top, leaving a 1-inch border on all edges.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Roll puff pastry sheet away from you like a jelly roll. When completely rolled, pinch seam to seal.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pinch ends of puff pastry to seal, then coil into a disk-shaped spiral. Place spiral in center of preheated waffle iron. Cook until puff pastry is deep golden brown on all surfaces and an instant-read thermometer inserted into the center registers 190 to 200°F, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer to a cutting board, cut into wedges, and serve immediately.",
      "secondary_message": null
    }
  ],
