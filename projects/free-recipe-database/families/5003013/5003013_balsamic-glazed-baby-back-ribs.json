  "instructions": [
    {
      "id": 1,
      "primary_message": "To make the rub: Mix together brown sugar, salt, sugar, paprika, white pepper, black pepper, ground mustard, dried thyme, garlic powder, Szechuan peppercorns, and cayenne pepper in a small bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove membrane from back of each rack of ribs and trim meat of excess fat. Season ribs liberally with rub all over.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fire up smoker or grill to 225°F, adding chunks of smoking wood when at temperature. When the wood is ignited and producing smoke, place the ribs in smoker or grill, meat side up, and smoke until the ribs have a slight bend when lifted from one end, 4-5 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In the last 1/2 hour of cooking, baste top of each rack with balsamic barbecue sauce and continue smoking to caramelize sauce. Remove from smoker, slice, and serve with remaining balsamic barbecue sauce.",
      "secondary_message": null
    }
  ],
