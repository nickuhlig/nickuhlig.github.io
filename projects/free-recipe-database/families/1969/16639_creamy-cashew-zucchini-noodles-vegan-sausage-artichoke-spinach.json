  "instructions": [
    {
      "id": 271635,
      "primary_message": "Boil water in a kettle. (If you do not have a kettle, boil water in a small saucepan, starting with hot water from the tap.) In a medium heat-safe bowl, pour boiling water over cashews and set aside to soak.",
      "secondary_message": "3 cup water\n1 ½ cups cashews, roasted unsalted"
    },
    {
      "id": 271636,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271637,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate and cover with foil. (Reserve pot for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 271638,
      "primary_message": "While the sausages are cooking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "12 medium zucchini squash\n3 (5 oz) pkgs baby spinach\n1 ½ lemons"
    },
    {
      "id": 271639,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 271640,
      "primary_message": "Drain and thinly slice artichoke hearts; add to the bowl with the zucchini and set aside.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 271641,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 271642,
      "primary_message": "Return pot to medium heat.",
      "secondary_message": null
    },
    {
      "id": 271643,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add garlic and cook, stirring occasionally, until fragrant, 1-2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 271644,
      "primary_message": "Add zucchini, artichokes, and spinach to the pot in handfuls, waiting for the veggies to wilt slightly before adding the next handful. Cook, stirring occasionally, until veggies are tender, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 271645,
      "primary_message": "Meanwhile, drain cashews and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 271646,
      "primary_message": "Juice lemons into the blender with the cashews. Add broth, nutritional yeast, flour, and spices to the blender; purée on high until the sauce is smooth.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n½ cup nutritional yeast flakes\n2 tbsp all-purpose flour\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp onion powder\n¾ tsp paprika"
    },
    {
      "id": 271647,
      "primary_message": "Cut sausages crosswise into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 271648,
      "primary_message": "Add sauce and sausage to the pot; stir to combine with the veggies. Continue to cook, stirring often, until warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271649,
      "primary_message": "To serve, divide veggies, sauce, and sausage between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
