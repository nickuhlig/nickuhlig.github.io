  "instructions": [
    {
      "id": 529841,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 529842,
      "primary_message": "Place vinegar and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup rice vinegar\n½ tsp salt"
    },
    {
      "id": 529843,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 529844,
      "primary_message": "Peel, trim, and halve carrots lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the pickling liquid. ",
      "secondary_message": null
    },
    {
      "id": 529845,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 529846,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 529847,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 529848,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 529849,
      "primary_message": "While the skillet heats up, place shrimp in a medium bowl along with cornstarch, salt, and pepper. Toss to coat. ",
      "secondary_message": "4 tsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 529850,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp and cook, stirring occasionally, until just opaque, 2-3 minutes. Remove from heat, add hot sauce, and stir to combine. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ cup hot sauce"
    },
    {
      "id": 529851,
      "primary_message": "Meanwhile, place oil, salt, and pepper in a clean medium bowl, then whisk to combine the dressing. Add pickled veggies and arugula, then toss to combine the salad. ",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 529852,
      "primary_message": "Top each flatbread with a small handful of the arugula salad, spicy shrimp, and blue cheese. Slice into wedges. (Reserve remaining salad for serving.)",
      "secondary_message": "1 (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 529853,
      "primary_message": "Divide flatbreads between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
