  "instructions": [
    {
      "id": 98068,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 98069,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 98070,
      "primary_message": "While the rice cooks, wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 medium zucchini squash\n1 medium carrot\n½ lime\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 98071,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 98072,
      "primary_message": "Slice the zucchini into ¼-inch rounds.",
      "secondary_message": null
    },
    {
      "id": 98073,
      "primary_message": "Peel and thinly slice the carrot into ¼-inch rounds.",
      "secondary_message": null
    },
    {
      "id": 98074,
      "primary_message": "Peel and thinly slice onion into half rings.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 98075,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 98076,
      "primary_message": "Juice the lime into a medium bowl. Peel and mince the garlic and ginger and add them to the bowl with the lime juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 98077,
      "primary_message": "Once the skillet is hot add the broccoli, zucchini, carrot, and onion. Cook, stirring occasionally, until the vegetables are crisp-tender; 7-9 minutes. Once done, transfer to a medium bowl or large plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 98078,
      "primary_message": "While veggies cook, finish preparing the dressing by whisking the peanut butter, soy sauce, water, and crushed red pepper into the bowl with the garlic, ginger, and lime juice. Set aside.",
      "secondary_message": "2 tbsp natural peanut butter\n1 tbsp soy sauce\n1 tbsp water\n¼ tsp crushed red pepper"
    },
    {
      "id": 98079,
      "primary_message": "Pat the scallops dry with a paper towel. Season with salt and pepper.",
      "secondary_message": "⅓ kg sea scallops\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 98080,
      "primary_message": "Return the skillet to the heat, add the oil, and carefully add the scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1-2 minutes per side.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 98081,
      "primary_message": "To serve, divide the rice into bowls. Top with sautéed vegetables and scallops; drizzle with peanut sauce and sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
