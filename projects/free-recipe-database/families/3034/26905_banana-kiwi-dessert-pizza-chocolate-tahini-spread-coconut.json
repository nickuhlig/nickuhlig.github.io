  "instructions": [
    {
      "id": 434550,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 434551,
      "primary_message": "Arrange flatbreads on a baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 10 minutes. Remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 434552,
      "primary_message": "Meanwhile, place tahini, maple syrup, cocoa powder, cinnamon, and salt in a small bowl. Whisk to combine and set aside. ",
      "secondary_message": "3 tbsp tahini\n1 ½ tbsp pure maple syrup\n1 tbsp cocoa powder\n¼ tsp cinnamon, ground\n1 pinch salt"
    },
    {
      "id": 434553,
      "primary_message": "Wash, dry, peel, and trim kiwis; slice crosswise into ½-inch thick rounds.",
      "secondary_message": "2 kiwifruit"
    },
    {
      "id": 434554,
      "primary_message": "Peel and slice banana crosswise into ¼-inch thick pieces. ",
      "secondary_message": "1 banana"
    },
    {
      "id": 434555,
      "primary_message": "Spread tahini mixture over each flatbread, then top with kiwifruit, banana, and coconut. ",
      "secondary_message": "⅛ cup shredded unsweetened coconut"
    },
    {
      "id": 434556,
      "primary_message": "To serve, slice pizzas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
