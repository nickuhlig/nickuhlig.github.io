  "instructions": [
    {
      "id": 434543,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 434544,
      "primary_message": "Divide flatbreads between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 10 minutes. Remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 434545,
      "primary_message": "Meanwhile, place tahini, maple syrup, cocoa powder, cinnamon, and salt in a small bowl. Whisk to combine and set aside. ",
      "secondary_message": "½ cup tahini\n¼ cup pure maple syrup\n3 tbsp cocoa powder\n¾ tsp cinnamon, ground\n3 pinch salt"
    },
    {
      "id": 434546,
      "primary_message": "Wash, dry, peel, and trim kiwis; slice crosswise into ½-inch thick rounds.",
      "secondary_message": "6 kiwifruit"
    },
    {
      "id": 434547,
      "primary_message": "Peel and slice bananas crosswise into ¼-inch thick pieces. ",
      "secondary_message": "3 bananas"
    },
    {
      "id": 434548,
      "primary_message": "Spread tahini mixture over each flatbread, then top with kiwifruit, banana, and coconut. ",
      "secondary_message": "⅓ cup shredded unsweetened coconut"
    },
    {
      "id": 434549,
      "primary_message": "To serve, slice pizzas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
