  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the cloves of the garlic head. Pick the rosemary leaves from the stems and chop them. Quarter the lemon. Bring the butter to room temperature.",
      "secondary_message": "1 large garlic head\n2 tbsp fresh rosemary\n1 lemon\n½ cup butter"
    },
    {
      "id": 1,
      "primary_message": "Sprinkle shrimp with 1 tablespoon of seasoning. (This may be done up to an hour ahead).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat a large skillet over high heat; add the oil and heat briefly. Add the garlic and rosemary to the pan and stir to lightly brown garlic, watching carefully to prevent burning.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the shrimp, Worcestershire sauce, hot sauce, and lemon juice and quarters. Lightly stir the shrimp and the ingredients, just enough to mix.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pour in the beer, stirring to release any bits clinging to the bottom of the skillet, and boil the mixture to reduce while shaking the pan. Cook shrimp 2 to 2 1/2 minutes, depending on size, and add remaining seafood seasoning and salt and pepper to taste. When shrimp are finished cooking, the liquid should have a sauce consistency.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Quickly whisk in the butter, turning the heat down as necessary, until it is melted into the sauce, leaving it thick and emulsified. Taste and add salt and pepper if desired. Remove lemon quarters. Serve with crusty bread, lots of napkins, and fingerbowls. Garnish each serving with a lemon piece.",
      "secondary_message": null
    }
  ],
