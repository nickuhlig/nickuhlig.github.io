  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together honey, lime juice, cayenne pepper, and salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For a Charcoal Grill: Light one chimney full of charcoal. When all charcoal is lit and covered with gray ash, pour out and spread the coals evenly over entire surface of coal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes.For a Gas Grill: Turn all burners to high; cover; and heat grill until hot, about 15 minutes. Leave all burners on high.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Clean and oil the grilling grate. Brush each side of watermelon slices with spicy lime and honey mixture. Place watermelon and grill and cook until grill marks developed, about 2 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove watermelon from grill, sprinkle with mint, and serve with lime wedges.",
      "secondary_message": null
    }
  ],
