  "instructions": [
    {
      "id": 534137,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 534138,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 small pkgs grape tomatoes\n1 ½ lemons\n3 (142 g) pkgs baby arugula"
    },
    {
      "id": 534139,
      "primary_message": "Peel and mince garlic. Place in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 534140,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 534141,
      "primary_message": "Zest and juice lemons into the bowl. Add oil, sugar, and spices, then stir to coat. Transfer tomatoes to a large baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp brown sugar\n1 tbsp paprika\n1 ½ tsp oregano, dried\n¾ tsp cumin, ground\n¼ tsp salt"
    },
    {
      "id": 534142,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tomatoes are soft and juicy, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 534143,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 534144,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 534145,
      "primary_message": "Pat halloumi dry with paper towels; holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half lengthwise into 1-inch thick strips. Season both sides with pepper.",
      "secondary_message": "3 (250 g) pkgs halloumi cheese\n1 ½ tsp black pepper"
    },
    {
      "id": 534146,
      "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Working in batches if necessary, add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove to a plate and cover with aluminum foil to keep warm.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 534147,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in the reserved bowl, then whisk to combine the dressing. Add arugula and toss to coat. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp crushed red pepper\n¼ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 534148,
      "primary_message": "When the tomatoes are done, remove from the oven. Using a potato masher or fork, lightly crush the tomatoes so that they are jammy but not totally smooth (there should still be a few large pieces of tomato).",
      "secondary_message": null
    },
    {
      "id": 534149,
      "primary_message": "To serve, divide arugula between plates or bowls. Top with halloumi, jammy tomatoes, and pine nuts. Enjoy!",
      "secondary_message": null
    }
  ],
