  "instructions": [
    {
      "id": 468623,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil and set aside. ",
      "secondary_message": null
    },
    {
      "id": 468624,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 red bell pepper\n1 green bell pepper\n2 caps portobello mushrooms\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 468625,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 468626,
      "primary_message": "Remove stems from portobello mushrooms; thinly slice. Add to the baking sheet with the peppers.",
      "secondary_message": null
    },
    {
      "id": 468627,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons; add to the baking sheet. Drizzle veggies with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "½ medium yellow onion\n2 tbsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 468628,
      "primary_message": "Place veggies in the oven and bake, stirring halfway through, until softened and starting to color in spots, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 468629,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, sugar, and salt in a medium bowl. Whisk to combine the dressing and set aside. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp red wine vinegar\n½ tsp Dijon mustard\n½ tsp brown sugar\n⅛ tsp salt"
    },
    {
      "id": 468630,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "⅓ (227 g) block mozzarella cheese"
    },
    {
      "id": 468631,
      "primary_message": "When the veggies are done, remove from the oven. Change oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 468632,
      "primary_message": "Sprinkle veggies with cheese. Return baking sheet to the oven and broil until cheese is melted, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 468633,
      "primary_message": "Carefully remove cooked veggies from the baking sheet by lifting the corners of the foil and transferring the whole sheet to a flat surface. (Reserve baking sheet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 468634,
      "primary_message": "Arrange bread on the reserved baking sheet. Place bread in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 468635,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 468636,
      "primary_message": "To serve, divide dressed arugula and toast between plates; top the toast with cheesy mushrooms and peppers. Enjoy!",
      "secondary_message": null
    }
  ],
