  "instructions": [
    {
      "id": 142006,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 142007,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 142008,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 142009,
      "primary_message": "Add ground beef to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes. ",
      "secondary_message": "⅓ kg lean ground beef"
    },
    {
      "id": 142010,
      "primary_message": "Meanwhile, coarsely grate the cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 142011,
      "primary_message": "Wash, dry, trim, and cut the beans into 2-inch pieces.",
      "secondary_message": "0.23 kg green beans"
    },
    {
      "id": 142012,
      "primary_message": "Add garlic to the skillet and cook, stirring often, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 142013,
      "primary_message": "Add ricotta, salt, and pepper to the skillet and stir until the ricotta is melted, about 1 minute; reduce heat to medium-low.",
      "secondary_message": "½ (425 g) pkg ricotta cheese\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 142014,
      "primary_message": "Add the beans to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 142015,
      "primary_message": "Sprinkle cheese over the skillet and place in the oven. Bake until beans are tender-crisp and cheese is melted, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 142016,
      "primary_message": "To serve, divide casserole between plates and enjoy!",
      "secondary_message": null
    }
  ],
