  "instructions": [
    {
      "primary_message": "FOR THE COOKIES: Preheat oven to 350°F and line 2 sheet pans with parchment paper.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Whisk the egg in a medium-sized mixing bowl. Add egg to melted butter, sugar and vanilla extract and stir to combine.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Sift the cocoa powder, flour, baking powder and 1/2 tsp salt into the bowl and stir to combine again.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Scoop 1-2 tablespoons of dough onto the sheet pans and lightly press down on the tops.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 11 minutes and remove from oven. They will be soft, but will firm as they cool. Leave untouched until cool.\n",
      "secondary_message": null
    },
    {
      "primary_message": "FOR THE BUTTERCREAM: Combine powdered sugar, Peet's French Roast Coffee (strongly brewed and cooled), softened butter and 1/8 tsp salt in a stand mixer. Mix on low until completely smooth. Keep the buttercream at room temperature until the cookies cool.\n",
      "secondary_message": null
    },
    {
      "primary_message": "FOR ASSEMBLY: When the cookies are cool, smooth a thick layer of buttercream on top and enjoy.\n",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: Store cookies in an airtight container in the refrigerator and enjoy within 5 days.\n",
      "secondary_message": null
    }
  ],
