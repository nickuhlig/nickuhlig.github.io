  "instructions": [
    {
      "id": 363778,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 363779,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 363780,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ English cucumbers\n6 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 363781,
      "primary_message": "Zest lemons into a large bowl (set lemons aside for later use).",
      "secondary_message": null
    },
    {
      "id": 363782,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon zest along with mayo, salt, and pepper; stir to combine the marinade.",
      "secondary_message": "3 cloves garlic\n⅓ cup mayonnaise\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 363783,
      "primary_message": "Cut tofu into 1-inch cubes. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": null
    },
    {
      "id": 363784,
      "primary_message": "Thread tofu onto skewers and place on a large plate. Alternatively, you can cook the tofu pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 363785,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 363786,
      "primary_message": "Once the pan is hot, working in batches if necessary, add the skewers and grill, turning occasionally, until tofu is golden, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 363787,
      "primary_message": "Meanwhile, peel and mince shallots. Place in another large bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 363788,
      "primary_message": "Juice lemons into the bowl with the shallot. Add oil, honey, Dijon, and spices; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp honey\n1 ½ tsp Dijon mustard\n¾ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363789,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 363790,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 363791,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl along with the feta and almonds; stir to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup almonds, sliced"
    },
    {
      "id": 363792,
      "primary_message": "To serve, divide salad and skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
