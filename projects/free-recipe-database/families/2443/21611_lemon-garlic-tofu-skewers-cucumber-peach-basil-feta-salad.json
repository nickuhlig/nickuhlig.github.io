  "instructions": [
    {
      "id": 363850,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 363851,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 363852,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 English cucumber\n4 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 363853,
      "primary_message": "Zest lemon into a medium bowl (set lemon aside for later use).",
      "secondary_message": null
    },
    {
      "id": 363854,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon zest along with mayo, salt, and pepper; stir to combine the marinade.",
      "secondary_message": "2 cloves garlic\n¼ cup mayonnaise\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363855,
      "primary_message": "Cut tofu into 1-inch cubes. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": null
    },
    {
      "id": 363856,
      "primary_message": "Thread tofu onto skewers and place on a plate. Alternatively, you can cook the tofu pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 363857,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 363858,
      "primary_message": "Once the pan is hot, add the skewers and grill, turning occasionally, until tofu is golden, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 363859,
      "primary_message": "Meanwhile, peel and mince shallot. Place in another medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 363860,
      "primary_message": "Juice lemon into the bowl with the shallot. Add oil, honey, Dijon, and spices; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp Dijon mustard\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 363861,
      "primary_message": "Trim and medium dice cucumber. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 363862,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 363863,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl along with the feta and almonds; stir to combine the salad.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ cup almonds, sliced"
    },
    {
      "id": 363864,
      "primary_message": "To serve, divide salad and skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
