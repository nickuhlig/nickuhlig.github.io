  "instructions": [
    {
      "id": 177232,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small pineapple\n2 avocados\n1 small bunch cilantro\n2 limes\n2 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 177233,
      "primary_message": "Cut off skin from pineapple, core, and small dice; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 177234,
      "primary_message": "Peel and mince the shallots; add to the bowl with the pineapple.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 177235,
      "primary_message": "Halve and pit the avocados; scoop out the flesh, small dice, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 177236,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 177237,
      "primary_message": "Juice one lime into the bowl with the pineapple; add oil, salt, and pepper. Stir to combine the salsa. Cut remaining lime into wedges.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 177238,
      "primary_message": "Combine the spices in a small bowl.",
      "secondary_message": "2 tsp paprika\n1 tsp garlic powder\n1 tsp oregano\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 177239,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 177240,
      "primary_message": "While the skillet heats up, pat the fish dry with paper towel and place on a plate; rub fish all over with the spice mixture.",
      "secondary_message": "0.68 kg tilapia fillet"
    },
    {
      "id": 177241,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 177242,
      "primary_message": "Add fish to the skillet and cook, flipping once, until blackened and can be easily flaked with a fork, about 5 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 177243,
      "primary_message": "To serve, divide the tilapia and greens between plates; top greens with pineapple salsa and place lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
