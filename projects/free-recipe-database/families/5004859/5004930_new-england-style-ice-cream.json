  "instructions": [
    {
      "id": 1,
      "primary_message": "In a heavy-bottomed saucepan, whisk together egg yolks, sugar, and corn syrup until well combined. Add cream and 1 1/4 cups evaporated milk and whisk to combine. In a small bowl, stir remaining 1/4 cup evaporated milk with arrowroot starch until is dissolved and forms a slurry with no lumps. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place saucepan over medium-low heat and cook, whisking frequently, until the custard's temperature reaches 77°C. (Custard is ready when it coats a spoon and a finger swiped across the back leaves a clean line.)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from heat and stir in arrowroot starch slurry, vanilla extract, and salt. Pour custard through a fine-mesh strainer into an airtight container and chill in an ice bath or refrigerator until temperature drops to 4°C (4°C), about 4 hours for ice bath, up to overnight for refrigerator.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Churn ice cream until it just takes on a firm soft serve consistency without any runniness; a spoon pressed across the top should leave a clean impression that doesn't collapse. Then, working very quickly, transfer ice cream to a wide, flat airtight container and chill in the bottom-back of a well-stocked freezer for at least 6 hours, preferably overnight. Avoid opening freezer door during hardening if possible. When ice cream is fully hardened, serve with plenty of mix-ins.",
      "secondary_message": null
    }
  ],
