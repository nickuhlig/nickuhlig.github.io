  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine vinegar, water, sugar, and salt in a small saucepan. Bring to a boil over high heat. Add jalapeño and red onion. Cook, stirring frequently, until onions have lightly softened and are translucent and jalapeños have become dirty green, about 2 minutes. Remove from heat and set aside. See note.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Carefully slit open the front of the Fritos bag with a knife or kitchen shears and pull sides apart. Place bag with opening facing up in a bowl. Add half of chili and stir to combine. Top with remaining chili. Garnish with pickled onions and jalapeño rings, sliced avocado, cilantro, and scallions if desired. Allow to sit until softened to desired texture and eat with lime wedge (if desired).",
      "secondary_message": null
    }
  ],
