  "instructions": [
    {
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and return to the pot.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi\n1 tsp salt"
    },
    {
      "primary_message": "Meanwhile, preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pan heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add onion and spices; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n1 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Add tomato sauce and cream to the pan, then stir to combine the rosé sauce. Bring to a simmer, then reduce heat to medium-low; continue to cook until sauce is thickened slightly, 3-4 minutes. Remove from heat.\n\n",
      "secondary_message": "1 (8 fl oz) can tomato sauce\n¾ cup heavy whipping cream"
    },
    {
      "primary_message": "Add rosé sauce and cheese to the pot with the gnocchi. Return to medium heat and cook, stirring constantly, until cheese is melted and gnocchi is coated in sauce, about 1 minute. Remove from heat.",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    },
    {
      "primary_message": "To serve, divide gnocchi and sauce between plates or bowls, sprinkle with additional cheese, and enjoy!",
      "secondary_message": "½ cup Parmesan cheese, shredded"
    }
  ],
