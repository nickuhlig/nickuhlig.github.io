  "instructions": [
    {
      "id": 621435,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 621436,
      "primary_message": "Slice tortillas in half, then crosswise into ½-inch strips. Transfer to a baking sheet pan, drizzle with oil, and season with salt; toss to coat and spread out in a single layer.",
      "secondary_message": "2 small corn tortillas\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 621437,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tortilla strips are golden and crispy, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 621438,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 red bell pepper\n1 medium zucchini squash\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 621439,
      "primary_message": "Trim and medium dice celery. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 621440,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 621441,
      "primary_message": "Trim and coarsely grate zucchini. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 621442,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 621443,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 621444,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion, garlic, chicken, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n0.23 kg ground chicken\n2 tsp chili powder\n¼ tsp cumin, ground\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 621445,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 621446,
      "primary_message": "When the chicken is done, add veggies, corn, and flour to the pan. Stir to combine and continue to cook until veggies are tender, 3-4 minutes more.",
      "secondary_message": "⅓ cup frozen corn\n2 tsp all-purpose flour"
    },
    {
      "id": 621447,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 621448,
      "primary_message": "When the veggies are done, add beans and broth to the pan; stir to combine the chili and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and chili thickens slightly, 10-12 minutes. ",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 621449,
      "primary_message": "When the chili is done, juice lime into the pan. Add cilantro and yogurt, stir to combine, and remove from heat.",
      "secondary_message": "⅓ cup plain Greek yogurt"
    },
    {
      "id": 621450,
      "primary_message": "To serve, divide chili between bowls and top with crispy tortilla strips. Enjoy!",
      "secondary_message": null
    }
  ],
