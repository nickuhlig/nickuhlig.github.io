  "instructions": [
    {
      "id": 621467,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 621468,
      "primary_message": "Slice tortillas in half, then crosswise into ½-inch strips. Transfer to a large baking sheet pan, drizzle with oil, and season with salt; toss to coat and spread out in a single layer.",
      "secondary_message": "6 small corn tortillas\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 621469,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tortilla strips are golden and crispy, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 621470,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n3 red bell peppers\n3 medium zucchini squash\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 621471,
      "primary_message": "Trim and medium dice celery. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 621472,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 621473,
      "primary_message": "Trim and coarsely grate zucchini. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 621474,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 621475,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 621476,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, chicken, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n0.68 kg ground chicken\n2 tbsp chili powder\n¾ tsp cumin, ground\n1 ½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 621477,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 621478,
      "primary_message": "When the chicken is done, add veggies, corn, and flour to the pot. Stir to combine and continue to cook until veggies are tender, 4-5 minutes more.",
      "secondary_message": "1 cup frozen corn\n2 tbsp all-purpose flour"
    },
    {
      "id": 621479,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 621480,
      "primary_message": "When the veggies are done, add beans and broth to the pot; stir to combine the chili and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and chili thickens slightly, 10-12 minutes. ",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 621481,
      "primary_message": "When the chili is done, juice limes into the pot. Add cilantro and yogurt, stir to combine, and remove from heat.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 621482,
      "primary_message": "To serve, divide chili between bowls and top with crispy tortilla strips. Enjoy!",
      "secondary_message": null
    }
  ],
