  "instructions": [
    {
      "id": 621451,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 621452,
      "primary_message": "Slice tortillas in half, then crosswise into ½-inch strips. Transfer to a baking sheet pan, drizzle with oil, and season with salt; toss to coat and spread out in a single layer.",
      "secondary_message": "4 small corn tortillas\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 621453,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tortilla strips are golden and crispy, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 621454,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 sticks celery\n2 red bell peppers\n2 medium zucchini squash\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 621455,
      "primary_message": "Trim and medium dice celery. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 621456,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 621457,
      "primary_message": "Trim and coarsely grate zucchini. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 621458,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 621459,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 621460,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, chicken, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n0.45 kg ground chicken\n4 tsp chili powder\n½ tsp cumin, ground\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 621461,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 621462,
      "primary_message": "When the chicken is done, add veggies, corn, and flour to the pot. Stir to combine and continue to cook until veggies are tender, 3-4 minutes more.",
      "secondary_message": "⅔ cup frozen corn\n4 tsp all-purpose flour"
    },
    {
      "id": 621463,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 621464,
      "primary_message": "When the veggies are done, add beans and broth to the pot; stir to combine the chili and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender and chili thickens slightly, 10-12 minutes. ",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 621465,
      "primary_message": "When the chili is done, juice lime into the pot. Add cilantro and yogurt, stir to combine, and remove from heat.",
      "secondary_message": "⅔ cup plain Greek yogurt"
    },
    {
      "id": 621466,
      "primary_message": "To serve, divide chili between bowls and top with crispy tortilla strips. Enjoy!",
      "secondary_message": null
    }
  ],
