  "instructions": [
    {
      "id": 372670,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 372671,
      "primary_message": "While the pan heats up, peel, halve, and slice onions crosswise into thin half-moons.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 372672,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until onion is soft and caramelized, about 20 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 372673,
      "primary_message": "Meanwhile, roughly chop cranberries and place in a large bowl.",
      "secondary_message": "⅓ cup dried cranberries"
    },
    {
      "id": 372674,
      "primary_message": "Add turkey, bread crumbs, and spices to the bowl with the cranberries. Mix with your hands until well combined. Form the turkey mixture into 6 equal-sized patties and place on a plate. ",
      "secondary_message": "1.02 kg ground turkey\n¾ cup panko bread crumbs\n1 tbsp sage, dried\n1 tbsp Italian seasoning\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 372675,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 372676,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 372677,
      "primary_message": "Meanwhile, place vinegar, oil, honey, Dijon, salt, and pepper in a clean large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp apple cider vinegar\n2 tbsp extra virgin olive oil\n1 tbsp honey\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 372678,
      "primary_message": "Wash, dry, quarter, and core apples; small dice. Add to the bowl with the dressing.",
      "secondary_message": "3 Granny Smith apples"
    },
    {
      "id": 372679,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl, along with additional cranberries, and toss to combine the salad. Set aside.",
      "secondary_message": "1 ½ (142 g) pkg spring mix (mixed greens)\n⅓ cup dried cranberries"
    },
    {
      "id": 372680,
      "primary_message": "When the onions are done, add vinegar and Worcestershire to the pan, then stir to combine. Remove from heat. ",
      "secondary_message": "2 tbsp red wine vinegar\n1 ½ tsp Worcestershire sauce"
    },
    {
      "id": 372681,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 372682,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 372683,
      "primary_message": "Place bottom half of each bun on a plate; layer with burger patties, onions, goat cheese, and a small portion of the salad. Close with the top half of each bun and serve with remaining salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
