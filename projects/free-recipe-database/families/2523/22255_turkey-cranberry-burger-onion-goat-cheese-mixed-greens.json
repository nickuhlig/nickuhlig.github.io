  "instructions": [
    {
      "id": 372642,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 372643,
      "primary_message": "While the pan heats up, peel, halve, and slice onion crosswise into thin half-moons.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 372644,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and salt; cook, stirring occasionally, until onion is soft and caramelized, 15-20 minutes.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 372645,
      "primary_message": "Meanwhile, roughly chop cranberries and place in a medium bowl.",
      "secondary_message": "⅛ cup dried cranberries"
    },
    {
      "id": 372646,
      "primary_message": "Add turkey, bread crumbs, and spices to the bowl with the cranberries. Mix with your hands until well combined. Form the turkey mixture into 2 equal-sized patties and place on a plate. ",
      "secondary_message": "⅓ kg ground turkey\n¼ cup panko bread crumbs\n1 tsp sage, dried\n1 tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 372647,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 372648,
      "primary_message": "Once the pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 372649,
      "primary_message": "Meanwhile, place vinegar, oil, honey, Dijon, salt, and pepper in a clean medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp apple cider vinegar\n2 tsp extra virgin olive oil\n1 tsp honey\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 372650,
      "primary_message": "Wash, dry, quarter, and core apple; small dice. Add to the bowl with the dressing.",
      "secondary_message": "1 Granny Smith apple"
    },
    {
      "id": 372651,
      "primary_message": "Wash and dry the mixed greens (skip this step if they came pre-washed). Add to the bowl, along with additional cranberries, and toss to combine the salad. Set aside.",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)\n⅛ cup dried cranberries"
    },
    {
      "id": 372652,
      "primary_message": "When the onions are done, add vinegar and Worcestershire to the pan, then stir to combine. Remove from heat. ",
      "secondary_message": "2 tsp red wine vinegar\n½ tsp Worcestershire sauce"
    },
    {
      "id": 372653,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 372654,
      "primary_message": "Crumble goat cheese into a small bowl.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 372655,
      "primary_message": "Place bottom half of each bun on a plate; layer with burger patties, onions, goat cheese, and a small portion of the salad. Close with the top half of each bun and serve with remaining salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
