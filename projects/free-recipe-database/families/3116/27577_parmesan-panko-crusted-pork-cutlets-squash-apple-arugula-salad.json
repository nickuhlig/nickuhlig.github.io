  "instructions": [
    {
      "id": 443121,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 443122,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small butternut squash\n1 Gala apple\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 443123,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out seeds, and medium dice the flesh. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 443124,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden brown and fork-tender, 15-20 minutes. Remove from oven and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 443125,
      "primary_message": "Meanwhile, finely grate Parmesan. Transfer to a plate along with bread crumbs and spices. Stir to combine the coating and set aside.",
      "secondary_message": "28 g Parmesan cheese\n⅓ cup panko bread crumbs\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 443126,
      "primary_message": "Place egg in a medium bowl and beat with a whisk or fork until smooth. Set aside.",
      "secondary_message": "1 egg"
    },
    {
      "id": 443127,
      "primary_message": "Pat pork dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 443128,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 443129,
      "primary_message": "While the skillet heats up, dip the cutlets into the beaten egg (letting the excess drip off), then into the bread crumb mixture, pressing gently to adhere. Transfer to another plate. ",
      "secondary_message": null
    },
    {
      "id": 443130,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the breaded cutlets and pan-fry until golden brown and cooked through, about 3 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 443131,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, maple syrup, salt, and pepper in a clean medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp pure maple syrup\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 443132,
      "primary_message": "Using a clean cutting board, quarter, core, and medium dice apple. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 443133,
      "primary_message": "Add cooled squash and arugula to the bowl. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 443134,
      "primary_message": "To serve, divide pork cutlets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
