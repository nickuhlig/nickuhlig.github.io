  "instructions": [
    {
      "id": 443051,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 443052,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small butternut squash\n2 Gala apples\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 443053,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out seeds, and medium dice the flesh. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 443054,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until squash is golden brown and fork-tender, 15-20 minutes. Remove from oven and set aside to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 443055,
      "primary_message": "Meanwhile, finely grate Parmesan. Transfer to a plate along with bread crumbs and spices. Stir to combine the coating and set aside.",
      "secondary_message": "2 oz Parmesan cheese\n⅔ cup panko bread crumbs\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 443056,
      "primary_message": "Place eggs in a medium bowl and beat with a whisk or fork until smooth. Set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 443057,
      "primary_message": "Pat pork dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chops in half horizontally to form thin cutlets.",
      "secondary_message": "4 pork chops, boneless"
    },
    {
      "id": 443058,
      "primary_message": "Dip the cutlets into the beaten egg (letting the excess drip off), then into the bread crumb mixture, pressing gently to adhere. Transfer to another plate. ",
      "secondary_message": null
    },
    {
      "id": 443059,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 443060,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the breaded cutlets and pan-fry until golden brown and cooked through, about 3 minutes per side. Transfer to a clean plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 443061,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, maple syrup, salt, and pepper in a large bowl. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 443062,
      "primary_message": "Using a clean cutting board, quarter, core, and medium dice apples. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 443063,
      "primary_message": "Add cooled squash and arugula to the bowl. Toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 443064,
      "primary_message": "To serve, divide pork cutlets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
