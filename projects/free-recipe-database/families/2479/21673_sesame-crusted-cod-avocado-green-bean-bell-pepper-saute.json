  "instructions": [
    {
      "id": 364765,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb green beans\n1 yellow bell pepper\n1 (1 inch) piece ginger root\n1 avocado"
    },
    {
      "id": 364766,
      "primary_message": "Trim green beans, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 364767,
      "primary_message": "Pat the cod dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb cod fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 364768,
      "primary_message": "Place egg and cornstarch in another medium bowl; beat with a whisk or fork until smooth.",
      "secondary_message": "1 egg\n1 tbsp cornstarch"
    },
    {
      "id": 364769,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364770,
      "primary_message": "While the skillet heats up, place sesame seeds on another plate. Dip cod in the egg mixture, then dredge in the sesame seeds, pressing gently to adhere; return to the plate.",
      "secondary_message": "⅓ cup sesame seeds"
    },
    {
      "id": 364771,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cod and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 364772,
      "primary_message": "Meanwhile, trim, seed, and slice bell pepper lengthwise into thin strips; add to the bowl with the green beans.",
      "secondary_message": null
    },
    {
      "id": 364773,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 364774,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until softened, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 364775,
      "primary_message": "Meanwhile, halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 364776,
      "primary_message": "To serve, divide cod and veggies between plates or bowls; top cod with avocado. Enjoy!",
      "secondary_message": null
    }
  ],
