  "instructions": [
    {
      "id": 365025,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 365026,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg green beans\n3 yellow bell peppers\n3 (2 ½ cm) pieces ginger root\n3 avocados"
    },
    {
      "id": 365027,
      "primary_message": "Trim green beans, place in a large bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 365028,
      "primary_message": "Cut the tofu planks in half crosswise; season with salt and pepper on both sides.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 365029,
      "primary_message": "Place eggs and cornstarch in a medium bowl; beat with a whisk or fork until smooth.",
      "secondary_message": "3 eggs\n3 tbsp cornstarch"
    },
    {
      "id": 365030,
      "primary_message": "Place sesame seeds on another plate. Dip tofu in the egg mixture, then dredge in the sesame seeds, pressing gently to adhere; return to the baking sheet.",
      "secondary_message": "1 cup sesame seeds"
    },
    {
      "id": 365031,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 365032,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and pan-fry until the coating is golden and tofu is warmed through, 3-4 minutes per side. Return to the baking sheet and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 365033,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the green beans.",
      "secondary_message": null
    },
    {
      "id": 365034,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 365035,
      "primary_message": "Preheat a large pot over medium heat. When the pot is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until softened, 7-8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 365036,
      "primary_message": "Meanwhile, halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 365037,
      "primary_message": "To serve, divide tofu and veggies between plates or bowls; top tofu with avocado. Enjoy!",
      "secondary_message": null
    }
  ],
