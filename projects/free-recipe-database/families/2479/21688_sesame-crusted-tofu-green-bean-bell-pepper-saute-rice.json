  "instructions": [
    {
      "id": 364957,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 364958,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 364959,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 364960,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.23 kg green beans\n1 yellow bell pepper\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 364961,
      "primary_message": "Trim green beans, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 364962,
      "primary_message": "Cut the tofu planks in half crosswise; season with salt and pepper on both sides.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 364963,
      "primary_message": "Place egg and cornstarch in another medium bowl; beat with a whisk or fork until smooth.",
      "secondary_message": "1 egg\n1 tbsp cornstarch"
    },
    {
      "id": 364964,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364965,
      "primary_message": "While the skillet heats up, place sesame seeds on another plate. Dip tofu in the egg mixture, then dredge in the sesame seeds, pressing gently to adhere; return to the baking sheet.",
      "secondary_message": "⅓ cup sesame seeds"
    },
    {
      "id": 364966,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry until the coating is golden and tofu is warmed through, 3-4 minutes per side. Return to the baking sheet and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 364967,
      "primary_message": "Meanwhile, trim, seed, and slice bell pepper lengthwise into thin strips; add to the bowl with the green beans.",
      "secondary_message": null
    },
    {
      "id": 364968,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 364969,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until softened, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 364970,
      "primary_message": "To serve, divide rice between plates or bowls; top with tofu and veggies. Enjoy!",
      "secondary_message": null
    }
  ],
