  "instructions": [
    {
      "id": 364789,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb green beans\n3 yellow bell peppers\n3 (1 inch) pieces ginger root\n3 avocados"
    },
    {
      "id": 364790,
      "primary_message": "Trim green beans, place in a large bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 364791,
      "primary_message": "Pat the cod dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb cod fillet\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 364792,
      "primary_message": "Place eggs and cornstarch in a medium bowl; beat with a whisk or fork until smooth.",
      "secondary_message": "3 eggs\n3 tbsp cornstarch"
    },
    {
      "id": 364793,
      "primary_message": "Place sesame seeds on another plate. Dip cod in the egg mixture, then dredge in the sesame seeds, pressing gently to adhere; return to the plate.",
      "secondary_message": "1 cup sesame seeds"
    },
    {
      "id": 364794,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 364795,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add cod and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 364796,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the green beans.",
      "secondary_message": null
    },
    {
      "id": 364797,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 364798,
      "primary_message": "Preheat a large pot over medium heat. When the pot is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until softened, 7-8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 364799,
      "primary_message": "Meanwhile, halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 364800,
      "primary_message": "To serve, divide cod and veggies between plates or bowls; top cod with avocado. Enjoy!",
      "secondary_message": null
    }
  ],
