  "instructions": [
    {
      "id": 423345,
      "primary_message": "Preheat oven to 230°C (450°F). Coat two large baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 423346,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Divide between the baking sheets, arranging the slices in a single layer.",
      "secondary_message": "3 (510 g) tubes polenta, pre-cooked"
    },
    {
      "id": 423347,
      "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the topping.",
      "secondary_message": null
    },
    {
      "id": 423348,
      "primary_message": "Drain and rinse beans. Place in a large bowl along with pesto, salt, and pepper; stir to combine.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans\n¾ cup basil pesto\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 423349,
      "primary_message": "Remove baking sheets from the oven. Spoon the bean topping over the polenta slices, then top with cheese. (Wipe bowl clean with paper towels and reserve for later use.)",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 423350,
      "primary_message": "Return baking sheets to the oven and bake until polenta stacks are warmed through and cheese is melted, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423351,
      "primary_message": "Meanwhile, wash and dry spring mix (skip if it came pre-washed). Place in the reserved bowl along with the carrots.",
      "secondary_message": "1 ½ (142 g) pkgs spring mix (mixed greens)\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 423352,
      "primary_message": "Drain and roughly chop artichokes and roasted peppers. Add both to the bowl with the mixed greens, along with the dressing, and toss to combine the salad.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated\n1 ½ (340 g) jars roasted red bell peppers\n⅓ cup Italian salad dressing"
    },
    {
      "id": 423353,
      "primary_message": "To serve, divide polenta stacks and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
