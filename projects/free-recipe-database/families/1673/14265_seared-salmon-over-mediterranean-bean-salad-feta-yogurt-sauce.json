  "instructions": [
    {
      "id": 236741,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ English cucumber\n½ pint grape tomatoes"
    },
    {
      "id": 236742,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 236743,
      "primary_message": "Juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 236744,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice. ",
      "secondary_message": null
    },
    {
      "id": 236745,
      "primary_message": "Add yogurt, water, salt, and pepper to the bowl; whisk to combine the yogurt sauce and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp water\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 236746,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 236747,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate; season with spices on the top-side. ",
      "secondary_message": "¾ lb salmon fillet\n¼ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 236748,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side depending on thickness. Transfer to a clean plate and loosely cover with foil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 236749,
      "primary_message": "Meanwhile, peel and thinly slice the shallot into rings; place in a medium bowl. ",
      "secondary_message": "½ shallot"
    },
    {
      "id": 236750,
      "primary_message": "Trim cucumber, halve lengthwise, then thinly slice crosswise into half-moons. Add to the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 236751,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 236752,
      "primary_message": "Add beans, feta, oil, salt, and pepper to the bowl; stir to combine the bean salad. ",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 236753,
      "primary_message": "Divide bean salad and salmon between plates; drizzle yogurt sauce over the salmon just before serving. Enjoy!",
      "secondary_message": null
    }
  ],
