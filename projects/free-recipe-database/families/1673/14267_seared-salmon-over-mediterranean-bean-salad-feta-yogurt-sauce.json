  "instructions": [
    {
      "id": 236767,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ English cucumbers\n1 ½ pints grape tomatoes"
    },
    {
      "id": 236768,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 236769,
      "primary_message": "Juice lemons into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 236770,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice. ",
      "secondary_message": null
    },
    {
      "id": 236771,
      "primary_message": "Add yogurt, water, salt, and pepper to the bowl; whisk to combine the yogurt sauce and set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n⅓ cup water\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 236772,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 236773,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place, skin-side down, on a plate; season with spices on the top-side. ",
      "secondary_message": "2 ¼ lb salmon fillet\n¾ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 236774,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side depending on thickness. Transfer to a clean plate and loosely cover with foil. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 236775,
      "primary_message": "Meanwhile, peel and thinly slice the shallots into rings; place in a large bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 236776,
      "primary_message": "Trim cucumbers, halve lengthwise, then thinly slice crosswise into half-moons. Add to the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 236777,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 236778,
      "primary_message": "Add beans, feta, oil, salt, and pepper to the bowl; stir to combine the bean salad. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 236779,
      "primary_message": "Divide bean salad and salmon between plates; drizzle yogurt sauce over the salmon just before serving. Enjoy!",
      "secondary_message": null
    }
  ],
