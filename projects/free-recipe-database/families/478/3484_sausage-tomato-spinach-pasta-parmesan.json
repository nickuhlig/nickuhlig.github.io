  "instructions": [
    {
      "id": 36868,
      "primary_message": "Wash and dry the spinach. (Skip this step if the spinach came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 36869,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 36870,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; cut the onion into ¼-inch cubes and transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 36871,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add the garlic to the bowl with the onion.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 36872,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 36873,
      "primary_message": "Slice the sausages into ¼-inch-thick rounds.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 36874,
      "primary_message": "When the water in the saucepan comes to a boil, uncover the pan and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions).",
      "secondary_message": "2 tbsp salt\n10 oz (about 3 cups) penne pasta"
    },
    {
      "id": 36875,
      "primary_message": "Once the sauté pan is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 36876,
      "primary_message": "Add the onion, garlic, sausage slices, and crushed red pepper to the pan; cook, stirring occasionally, until the onion is softened and the sausage slices are browned, 3 to 5 minutes.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 36877,
      "primary_message": "Add the diced tomatoes to the sauté pan and season with oregano, salt, and pepper; bring to a boil, then reduce to a simmer and cook until the pasta is ready.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 36878,
      "primary_message": "Finely grate ¼ cup of Parmesan and transfer to a small bowl.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 36879,
      "primary_message": "Once done, drain the pasta in a colander.",
      "secondary_message": null
    },
    {
      "id": 36880,
      "primary_message": "Add the pasta and spinach to the sauté pan; stir until the spinach is wilted and the ingredients are combined, 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 36881,
      "primary_message": "To serve, spoon the pasta into a bowl and sprinkle with the Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
