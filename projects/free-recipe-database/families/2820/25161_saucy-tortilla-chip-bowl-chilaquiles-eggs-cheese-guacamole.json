  "instructions": [
    {
      "id": 420456,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 ½ heads butter (Boston) lettuce\n3 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 420457,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420458,
      "primary_message": "While the pot heats up, trim and halve zucchini lengthwise, then slice crosswise into into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 420459,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add zucchini and cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 420460,
      "primary_message": "Meanwhile, chop lettuce crosswise into thin (shred-like) strips. Transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 420461,
      "primary_message": "Small dice tomatoes. Add to the plate with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 420462,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the pot. (Add remaining cilantro to the plate and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 420463,
      "primary_message": "Add salsa and broth to the pot; stir to combine. Continue to cook, stirring occasionally, until the sauce is slightly thickened, 5-6 minutes.",
      "secondary_message": "3 cup salsa\n355 ml chicken or vegetable broth"
    },
    {
      "id": 420464,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420465,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n12 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 420466,
      "primary_message": "When the sauce has thickened, add chips to the pot and turn to coat. Cook, stirring occasionally, until just starting to soften and warm through, 3-4 minutes. Remove from heat.",
      "secondary_message": "170 g tortilla chips"
    },
    {
      "id": 420467,
      "primary_message": "To serve, divide chips and sauce between bowls. Top with cheese, eggs, guacamole, tomato, lettuce, and reserved cilantro. Enjoy!",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend\n1 ½ cups guacamole"
    }
  ],
