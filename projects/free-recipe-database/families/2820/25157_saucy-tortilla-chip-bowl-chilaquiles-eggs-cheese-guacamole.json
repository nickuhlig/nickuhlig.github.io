  "instructions": [
    {
      "id": 420408,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 head butter (Boston) lettuce\n2 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 420409,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420410,
      "primary_message": "While the skillet heats up, trim and halve zucchini lengthwise, then slice crosswise into into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 420411,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add zucchini and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 420412,
      "primary_message": "Meanwhile, chop lettuce crosswise into thin (shred-like) strips. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 420413,
      "primary_message": "Small dice tomatoes. Add to the plate with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 420414,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the skillet. (Add remaining cilantro to the plate and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 420415,
      "primary_message": "Add salsa and broth to the skillet; stir to combine. Continue to cook, stirring occasionally, until the sauce is slightly thickened, 4-5 minutes.",
      "secondary_message": "2 cup salsa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 420416,
      "primary_message": "Meanwhile, preheat another large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420417,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 420418,
      "primary_message": "When the sauce has thickened, add chips to the skillet and turn to coat. Cook, stirring occasionally, until just starting to soften and warm through, 2-3 minutes. Remove from heat.",
      "secondary_message": "4 oz tortilla chips"
    },
    {
      "id": 420419,
      "primary_message": "To serve, divide chips and sauce between bowls. Top with cheese, eggs, guacamole, tomato, lettuce, and reserved cilantro. Enjoy!",
      "secondary_message": "1 cup shredded cheese, Mexican blend\n1 cup guacamole"
    }
  ],
