  "instructions": [
    {
      "id": 220503,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220504,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels. Season chicken with spices on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n½ tsp garlic powder\n¼ tsp cayenne pepper\n¼ tsp paprika"
    },
    {
      "id": 220505,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and sear until cooked through and golden brown; 3-4 minutes per side. Remove to a clean plate and cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 220506,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n2 sticks celery\n2 green bell peppers"
    },
    {
      "id": 220507,
      "primary_message": "Cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 220508,
      "primary_message": "Heat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220509,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add cauliflower, salt, and pepper; cook, stirring occasionally, until tender, about 10 minutes. Cover and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 220510,
      "primary_message": "Meanwhile, peel and mince onion and garlic; transfer both to a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 220511,
      "primary_message": "Small dice celery. Trim, seed, and small dice bell peppers. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 220512,
      "primary_message": "Return the skillet to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 220513,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until tender, 5-7 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 220514,
      "primary_message": "Add tomatoes, raisins, curry powder, and salt to the skillet; stir to combine and bring to a simmer. Continue to cook until flavors meld and raisins are plump, 2-3 minutes.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n¼ cup raisins\n2 tsp curry powder\n½ tsp salt"
    },
    {
      "id": 220515,
      "primary_message": "To serve, divide cauliflower rice, chicken, and veggies between plates. Top veggies with almonds and enjoy! ",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
