  "instructions": [
    {
      "id": 220360,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 220361,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 220362,
      "primary_message": "Meanwhile, place flour and spices in a large bowl; stir to combine. ",
      "secondary_message": "¾ cup all-purpose flour\n¾ tsp salt\n¾ tsp garlic powder\n½ tsp cayenne pepper\n½ tsp paprika"
    },
    {
      "id": 220363,
      "primary_message": "Pat chicken thighs dry with paper towels. Transfer to the bowl with the seasoned flour and toss to coat, shaking off any excess flour. ",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 220364,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220365,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until it is cooked through and golden brown, 3-4 minutes per side. Remove to a clean plate and cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 220366,
      "primary_message": "Meanwhile, peel and mince onions and garlic; transfer both to another large bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 220367,
      "primary_message": "Wash, dry, and small dice celery; add to the bowl. ",
      "secondary_message": "3 sticks celery"
    },
    {
      "id": 220368,
      "primary_message": "Wash, dry, trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 220369,
      "primary_message": "Return the pot to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 220370,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until tender, 6-8 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 220371,
      "primary_message": "Add tomatoes, raisins, curry powder, and salt to the pot; stir to combine and bring to a simmer. Once simmering, continue to cook until flavors meld and raisins are plump, 3-4 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n⅓ cup raisins\n1 tbsp curry powder\n¾ tsp salt"
    },
    {
      "id": 220372,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates. Top veggies with almonds and enjoy! ",
      "secondary_message": "½ cup almonds, sliced"
    }
  ],
