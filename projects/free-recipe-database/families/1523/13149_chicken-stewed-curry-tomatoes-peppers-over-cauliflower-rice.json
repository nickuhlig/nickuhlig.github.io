  "instructions": [
    {
      "id": 220516,
      "primary_message": "Pat chicken thighs dry with paper towels and season with spices on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n¾ tsp garlic powder\n½ tsp cayenne pepper\n½ tsp paprika"
    },
    {
      "id": 220517,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220518,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and sear until cooked through and golden brown; 3-4 minutes per side. Remove to a clean plate and cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 220519,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 sticks celery\n3 green bell peppers"
    },
    {
      "id": 220520,
      "primary_message": "Cut cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 220521,
      "primary_message": "Heat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220522,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add cauliflower, salt, and pepper; cook, stirring occasionally, until tender, 10-12 minutes. Cover and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 220523,
      "primary_message": "Meanwhile, peel and mince onions and garlic; transfer both to a large bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 220524,
      "primary_message": "Small dice celery. Trim, seed, and small dice bell peppers. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 220525,
      "primary_message": "Return the pot (used to cook the chicken) to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 220526,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until tender, 6-8 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 220527,
      "primary_message": "Add tomatoes, raisins, curry powder, and salt to the pot; stir to combine and bring to a simmer. Continue to cook until flavors meld and raisins are plump, 3-4 minutes.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n⅓ cup raisins\n1 tbsp curry powder\n¾ tsp salt"
    },
    {
      "id": 220528,
      "primary_message": "To serve, divide cauliflower rice, chicken, and veggies between plates. Top veggies with almonds and enjoy! ",
      "secondary_message": "⅓ cup almonds, sliced"
    }
  ],
