  "instructions": [
    {
      "id": 220451,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 220452,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 220453,
      "primary_message": "Meanwhile, place flour and spices in a medium bowl; stir to combine. ",
      "secondary_message": "¼ cup all-purpose flour\n¼ tsp salt\n¼ tsp garlic powder\n⅛ tsp cayenne pepper\n⅛ tsp paprika"
    },
    {
      "id": 220454,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220455,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels. Transfer to the bowl with the seasoned flour and toss to coat, shaking off any excess flour. ",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 220456,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until cooked through and golden brown, 3-4 minutes per side. Remove to a clean plate and cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 220457,
      "primary_message": "Meanwhile, peel and mince onion and garlic; transfer both to another medium bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 220458,
      "primary_message": "Wash, dry, and small dice celery; add to the bowl. ",
      "secondary_message": "1 stick celery"
    },
    {
      "id": 220459,
      "primary_message": "Wash, dry, trim, seed, and small dice bell pepper; add to the bowl. ",
      "secondary_message": "1 green bell pepper"
    },
    {
      "id": 220460,
      "primary_message": "Return the skillet to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 220461,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until tender, 5-7 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 220462,
      "primary_message": "Add tomatoes, raisins, curry powder, and salt to the skillet; stir to combine and bring to a simmer. Once simmering, continue to cook until flavors meld and raisins are plump, 2-3 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n⅛ cup raisins\n1 tsp curry powder\n¼ tsp salt"
    },
    {
      "id": 220463,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates. Top veggies with almonds and enjoy! ",
      "secondary_message": "⅛ cup almonds, sliced"
    }
  ],
