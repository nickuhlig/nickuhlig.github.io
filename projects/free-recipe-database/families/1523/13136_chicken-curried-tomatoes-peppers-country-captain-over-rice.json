  "instructions": [
    {
      "id": 220347,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 220348,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 220349,
      "primary_message": "Meanwhile, place flour and spices in a large bowl; stir to combine. ",
      "secondary_message": "½ cup all-purpose flour\n½ tsp salt\n½ tsp garlic powder\n¼ tsp cayenne pepper\n¼ tsp paprika"
    },
    {
      "id": 220350,
      "primary_message": "Pat chicken thighs dry with paper towels. Transfer to the bowl with the seasoned flour and toss to coat, shaking off any excess flour. ",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 220351,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220352,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until cooked through and golden brown, 3-4 minutes per side. Remove to a clean plate and cover with aluminum foil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 220353,
      "primary_message": "Meanwhile, peel and mince onion and garlic; transfer both to a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 220354,
      "primary_message": "Wash, dry, and small dice celery; add to the bowl. ",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 220355,
      "primary_message": "Wash, dry, trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 220356,
      "primary_message": "Return the skillet to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 220357,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until tender, 5-7 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 220358,
      "primary_message": "Add tomatoes, raisins, curry powder, and salt to the skillet; stir to combine and bring to a simmer. Once simmering, continue to cook until flavors meld and raisins are plump, 2-3 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n¼ cup raisins\n2 tsp curry powder\n½ tsp salt"
    },
    {
      "id": 220359,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates. Top veggies with almonds and enjoy! ",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
