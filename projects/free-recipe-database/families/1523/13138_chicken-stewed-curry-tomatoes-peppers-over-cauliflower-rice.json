  "instructions": [
    {
      "id": 220373,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220374,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels. Season chicken with spices on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n¼ tsp garlic powder\n⅛ tsp cayenne pepper\n⅛ tsp paprika"
    },
    {
      "id": 220375,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and sear until cooked through and golden brown; 3-4 minutes per side. Remove to a clean plate and cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 220376,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 stick celery\n1 green bell pepper"
    },
    {
      "id": 220377,
      "primary_message": "Cut cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 220378,
      "primary_message": "Heat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220379,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add cauliflower, salt, and pepper; cook, stirring occasionally, until tender, 8-10 minutes. Cover and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 220380,
      "primary_message": "Meanwhile, peel and mince onion and garlic; transfer both to a medium bowl. ",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 220381,
      "primary_message": "Small dice celery. Trim, seed, and small dice bell pepper. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 220382,
      "primary_message": "Return the skillet to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 220383,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until tender, 5-7 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 220384,
      "primary_message": "Add tomatoes, raisins, curry powder, and salt to the skillet; stir to combine and bring to a simmer. Continue to cook until flavors meld and raisins are plump, 2-3 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n⅛ cup raisins\n1 tsp curry powder\n¼ tsp salt"
    },
    {
      "id": 220385,
      "primary_message": "To serve, divide cauliflower rice, chicken, and veggies between plates. Top veggies with almonds and enjoy! ",
      "secondary_message": "⅛ cup almonds, sliced"
    }
  ],
