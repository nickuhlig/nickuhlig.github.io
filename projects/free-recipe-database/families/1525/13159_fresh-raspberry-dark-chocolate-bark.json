  "instructions": [
    {
      "id": 220568,
      "primary_message": "Line the bottom of a small baking dish with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 220569,
      "primary_message": "Fill a small saucepan about halfway with hot water (from the tap); cover and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 220570,
      "primary_message": "Meanwhile, wash and dry raspberries.",
      "secondary_message": "½ (6 oz) pkg raspberries"
    },
    {
      "id": 220571,
      "primary_message": "Uncover the pan and place a small, heat-proof, bowl over the simmering water, allowing it to sit on the rim. Add chocolate and oil to the bowl; using a silicone spatula, stir continuously, until melted.",
      "secondary_message": "⅓ cup dark chocolate chips\n½ tsp virgin coconut oil"
    },
    {
      "id": 220572,
      "primary_message": "Remove bowl from the heat. Add vanilla and salt; stir until smooth.",
      "secondary_message": "⅛ tsp vanilla extract\n1 pinch salt"
    },
    {
      "id": 220573,
      "primary_message": "Pour chocolate mixture into the baking dish. Using a silicone spatula, spread out to a thickness of ¼-inch. ",
      "secondary_message": null
    },
    {
      "id": 220574,
      "primary_message": "Sprinkle raspberries over the chocolate, pressing gently into the surface to adhere. Place baking dish in the refrigerator and chill until firm, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 220575,
      "primary_message": "Remove bark from the refrigerator, transfer to a cutting board, and chop into large pieces. Store in the refrigerator until ready to serve.",
      "secondary_message": null
    },
    {
      "id": 220576,
      "primary_message": "To serve, divide chocolate bark between plates and enjoy!",
      "secondary_message": null
    }
  ],
