  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, pour enough vinegar over shallot to just cover and let stand for at least 15 and up to 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, heat oil in a large cast iron skillet over high heat until smoking. Working in batches to avoid crowding the pan, add broccoli florets, season with salt, and cook until charred on first side, about 2 minutes. Turn broccoli and char other side. Transfer to a plate or baking sheet to cool. Repeat with remaining broccoli.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In serving bowls, arrange broccoli with sardines, pickled shallot, and mint leaves, seasoning with salt as needed. Serve.",
      "secondary_message": null
    }
  ],
