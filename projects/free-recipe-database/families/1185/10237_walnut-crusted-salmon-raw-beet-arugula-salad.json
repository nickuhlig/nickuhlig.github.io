  "instructions": [
    {
      "id": 163260,
      "primary_message": "Preheat oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 163261,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 medium beets\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 163262,
      "primary_message": "Finely chop walnuts; place in a small bowl and stir in oil.",
      "secondary_message": "¾ cup walnuts\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 163263,
      "primary_message": "Peel and mince garlic. Zest lemons and place both in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 163264,
      "primary_message": "Add Dijon, honey, and spices to the bowl with the garlic and lemon zest; whisk to combine.",
      "secondary_message": "3 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp Italian seasoning\n¾ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 163265,
      "primary_message": "Pat fish dry with paper towels and place, skin-side down, on the baking sheet. Spread with Dijon mixture and top with walnuts. Reserve Dijon bowl to use for the salad.",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 163266,
      "primary_message": "Place baking sheet in the oven and bake until salmon is cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 163267,
      "primary_message": "Meanwhile, juice lemons into the reserved bowl; add oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp apple cider vinegar\n2 tbsp Dijon mustard\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 163268,
      "primary_message": "Trim, peel, and coarsely grate the beets; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 163269,
      "primary_message": "Peel and mince shallots; add to the bowl.",
      "secondary_message": "1 ½ shallots"
    },
    {
      "id": 163270,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 163271,
      "primary_message": "To serve, divide arugula between plates and top with beet salad. Serve with salmon on the side and enjoy!",
      "secondary_message": null
    }
  ],
