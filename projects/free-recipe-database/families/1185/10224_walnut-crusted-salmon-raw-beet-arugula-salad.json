  "instructions": [
    {
      "id": 163104,
      "primary_message": "Preheat oven to 425°F. Line the bottom of a baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 163105,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 medium beet\n½ small bunch Italian (flat-leaf) parsley\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 163106,
      "primary_message": "Finely chop walnuts and place in a small bowl with bread crumbs and oil; stir to combine.",
      "secondary_message": "¼ cup walnuts\n3 tbsp panko bread crumbs\n1 tsp extra virgin olive oil"
    },
    {
      "id": 163107,
      "primary_message": "Peel and mince garlic. Zest lemon and place both in a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 163108,
      "primary_message": "Add Dijon, honey, and spices to the bowl with the garlic and lemon zest; whisk to combine.",
      "secondary_message": "1 tbsp Dijon mustard\n1 tsp honey\n¼ tsp Italian seasoning\n¼ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 163109,
      "primary_message": "Pat fish dry with paper towels and place, skin-side down, in the middle of the baking sheet. Spread with Dijon mixture and top with walnut mixture. Reserve Dijon bowl to use for the salad.",
      "secondary_message": "¾ lb salmon fillet"
    },
    {
      "id": 163110,
      "primary_message": "Place baking sheet in the oven and bake until salmon is cooked through, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 163111,
      "primary_message": "Meanwhile, juice lemon into the reserved bowl; add oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 163112,
      "primary_message": "Trim, peel, and coarsely grate the beet; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 163113,
      "primary_message": "Peel and mince shallot; add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 163114,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 163115,
      "primary_message": "To serve, divide arugula between plates and top with beet salad. Serve with salmon on the side and enjoy!",
      "secondary_message": null
    }
  ],
