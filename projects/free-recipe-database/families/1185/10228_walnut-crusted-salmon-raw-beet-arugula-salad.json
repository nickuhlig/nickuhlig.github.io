  "instructions": [
    {
      "id": 163152,
      "primary_message": "Preheat oven to 425°F. Line the baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 163153,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 medium beets\n1 small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 163154,
      "primary_message": "Finely chop walnuts; place in a small bowl and stir in oil.",
      "secondary_message": "½ cup walnuts\n2 tsp extra virgin olive oil"
    },
    {
      "id": 163155,
      "primary_message": "Peel and mince garlic. Zest lemon and place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 163156,
      "primary_message": "Add Dijon, honey, and spices to the bowl with the garlic and lemon zest; whisk to combine.",
      "secondary_message": "2 tbsp Dijon mustard\n2 tsp honey\n½ tsp Italian seasoning\n½ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 163157,
      "primary_message": "Pat fish dry with paper towels and place, skin-side down, on the baking sheet. Spread with Dijon mixture and top with walnuts. Reserve Dijon bowl to use for the salad.",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "id": 163158,
      "primary_message": "Place baking sheet in the oven and bake until salmon is cooked through, 12-14 minutes.",
      "secondary_message": null
    },
    {
      "id": 163159,
      "primary_message": "Meanwhile, juice lemon into the reserved bowl; add oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 163160,
      "primary_message": "Trim, peel, and coarsely grate the beets; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 163161,
      "primary_message": "Peel and mince shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 163162,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 163163,
      "primary_message": "To serve, divide arugula between plates and top with beet salad. Serve with salmon on the side and enjoy!",
      "secondary_message": null
    }
  ],
