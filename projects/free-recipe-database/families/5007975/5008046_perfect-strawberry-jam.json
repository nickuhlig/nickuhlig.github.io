  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Coarsely chop the strawberries. Juice the lemon.",
      "secondary_message": "4 cups strawberries\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Whisk the sugar and pectin a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine the strawberries, lemon juice, calcium water, and butter in a large, heavy-bottomed pot and bring to a boil over medium-high heat. Add the honey and the sugar-pectin mixture and return the fruit mixture to a boil, stirring constantly. Boil hard for one minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove pot from heat and skim any foam from surface of jam with cold metal spoon. Ladle jam into hot sterilized jars and process them in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
