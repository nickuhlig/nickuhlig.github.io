  "instructions": [
    {
      "primary_message": "Wash and dry bell pepper and tomato. Trim, seed, and slice bell pepper lengthwise into thin strips. Medium dice tomato.",
      "secondary_message": "1 yellow bell pepper\n1 tomato"
    },
    {
      "primary_message": "Warm tortillas in a skillet or microwave (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "If desired, transfer chicken to a microwave-safe bowl, cover with a damp paper towel, and place in the microwave. Heat on high until warmed through, 2-3 minutes. (The chicken is also great in these tacos if left cold.)",
      "secondary_message": "8 oz cooked chicken (shredded)"
    },
    {
      "primary_message": "Divide tortillas between plates, then fill with chicken, bell pepper, and tomato. Top with tzatziki, season with salt and pepper if desired, and enjoy!",
