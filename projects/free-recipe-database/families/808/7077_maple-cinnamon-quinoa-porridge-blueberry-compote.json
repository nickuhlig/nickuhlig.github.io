  "instructions": [
    {
      "id": 178432,
      "primary_message": "Place quinoa, milk, maple syrup, salt, and cinnamon in a small saucepan. Bring to a boil over medium-high heat. ",
      "secondary_message": "½ cup quinoa\n12 fl oz (1 ½ cups) whole milk\n1 tbsp pure maple syrup\n⅛ tsp salt\n1 tsp cinnamon"
    },
    {
      "id": 178433,
      "primary_message": "Once the quinoa mixture comes to a boil, reduce heat to low, allow to cool slightly, and cover with a lid. Cook until most of the liquid is absorbed, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 178434,
      "primary_message": "Add the blueberries and maple syrup to another small saucepan. Heat on medium-high, 3-4 minutes.",
      "secondary_message": "1 cup frozen blueberries\n1 tbsp pure maple syrup"
    },
    {
      "id": 178435,
      "primary_message": "To serve, divide porridge between bowls, drizzle with more milk, and top with blueberry compote. Enjoy!",
      "secondary_message": "2 fl oz (¼ cup) whole milk"
    }
  ],
