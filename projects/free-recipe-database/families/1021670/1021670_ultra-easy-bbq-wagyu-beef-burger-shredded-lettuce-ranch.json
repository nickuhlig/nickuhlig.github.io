  "instructions": [
    {
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat. Once the pan is hot, coat with oil. Season patties with salt and pepper, then place on the pan. Grill patties, undisturbed, for 3-3½ minutes; flip and grill an additional 3-3½ minutes, until cooked through. Once done, remove to a plate and drizzle with barbecue sauce.",
      "secondary_message": "1 tsp neutral vegetable oil\n¼ tsp salt\n¼ tsp black pepper\n2 tbsp barbecue sauce"
    },
    {
      "primary_message": "Toast buns if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, place bottom half of each bun on a plate; layer with dressing, a BBQ burger patty, and lettuce. Close with the top half of each bun and enjoy!",
      "secondary_message": "3 tbsp ranch dressing\n1 cup shredded lettuce"
    }
