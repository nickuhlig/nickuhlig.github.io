  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Line a 17 x 11-inch rimmed baking sheet pan with parchment paper and coat with cooking spray. (if your baking sheet is different dimensions, adjust cooking time accordingly.)\n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Wash, dry, and zest lemon into a large bowl. Add flour, sugar, baking powder, baking soda, and salt, then whisk to combine the dry ingredients. (Reserve lemon for another use.)\n\n",
      "secondary_message": "½ lemon\n2 ¼ cups all-purpose flour\n¼ cup granulated sugar\n2 tsp baking powder\n½ tsp baking soda\n½ tsp salt"
    },
    {
      "primary_message": "Melt butter in a microwave or saucepan. Transfer to a medium bowl, along with buttermilk and eggs, then whisk to combine. Add wet ingredients to the bowl with the dry ingredients and stir until just combined. Pour batter into the baking sheet and spread out in an even layer. \n\n",
      "secondary_message": "¼ cup butter, unsalted\n2 cups reduced-fat buttermilk"
    },
    {
      "primary_message": "Wash and dry blueberries. Sprinkle over the pancake batter.\n\n",
      "secondary_message": "1 (170 g) pkg blueberries"
    },
    {
      "primary_message": "Place baking sheet in the preheated oven and bake until a toothpick inserted in the middle comes out clean and edges are golden, about 15 minutes. Remove sheet pan \"pancake\" from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, arrange sausage patties on another large baking sheet in a single layer. Add to the oven and bake until cooked through and golden, 12-15 minutes (or cook according to package instructions). Remove from oven. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut pancake into 8 pieces.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide pancakes and sausage between plates. Serve with maple syrup and butter. Enjoy!\n\n",
      "secondary_message": "½ cup pure maple syrup\n¼ cup butter, unsalted"
    }
  ],
