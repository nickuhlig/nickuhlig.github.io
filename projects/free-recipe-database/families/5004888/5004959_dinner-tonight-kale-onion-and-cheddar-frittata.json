  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve and slice the red onion into half moons. Slice the lacinato kale crosswise into ribbons.",
      "secondary_message": "1 small red onion\n⅔ bunch lacinato kale"
    },
    {
      "id": 1,
      "primary_message": "Over medium heat in a heavy 25-cm, broiler-safe skillet (not non-stick), heat the olive oil and add the onion, cooking until softened but not browned. Add the kale, an additional tablespoon of olive oil, and a couple pinches of salt. Stir until the kale begins to wilt, then cover, reduce the heat to low, and cook for 15-20 minutes. Stir occasionally.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, beat the eggs well with a fork, then beat in the shredded cheese and a pinch of salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When the kale mixture is tender and caramelized, remove from the skillet and let cool slightly, then whisk into the egg mixture. Add 1/2 tablespoon oil to the pan, and pour the mixture back into the skillet over low heat, spreading out the kale evenly. Cook over low heat until the top just barely begins to set. In the meantime, preheat your broiler.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cook for 30-60 seconds under the broiler, until the top is gently browned. Serve warm or at room temperature.",
      "secondary_message": null
    }
  ],
