  "instructions": [
    {
      "id": 213274,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to a medium saucepan. Add broth and salt, then bring to a boil over high heat. Reduce heat to a simmer, cover, and cook until tender, 15-20 minutes.",
      "secondary_message": "1 ½ cups brown lentils\n36 fl oz (4 ½ cups) chicken or vegetable broth\n¾ tsp salt"
    },
    {
      "id": 213275,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb cremini mushrooms\n3 green bell peppers\n1 ½ avocados\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 213276,
      "primary_message": "Peel and mince onions and garlic; transfer both to a large bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 213277,
      "primary_message": "Roughly chop mushrooms. Trim, seed, and roughly chop peppers. Add both to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 213278,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 213279,
      "primary_message": "Add vegetables, sugar, and spices to the skillet; stir to combine. Cook, stirring occasionally, until the vegetables are tender-crisp, 4-5 minutes. ",
      "secondary_message": "2 tbsp brown sugar\n1 ½ tsp cumin\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp chili powder"
    },
    {
      "id": 213280,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, sugar, and salt in the bowl used for the veggies. Whisk to combine the dressing and set aside. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp brown sugar\n3 pinch salt"
    },
    {
      "id": 213281,
      "primary_message": "Add tomato sauce to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to medium-low, and continue to cook, stirring occasionally, until the vegetables are tender, 4-5 minutes. ",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 213282,
      "primary_message": "Meanwhile, halve and pit avocados. Slice thinly while still in skin, then scoop out into the bowl with the dressing. Add spinach and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 213283,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 213284,
      "primary_message": "When the lentils are tender, drain, and add to the skillet with the vegetables; stir to combine the sloppy joe mix. ",
      "secondary_message": null
    },
    {
      "id": 213285,
      "primary_message": "To serve, place the bottom half of a bun on each plate. Top with sloppy joe mix and close with top half of the bun. Divide salad between plates and enjoy! ",
      "secondary_message": null
    }
  ],
