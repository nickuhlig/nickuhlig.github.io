  "instructions": [
    {
      "id": 8942,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Season the rice with salt and add water; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n¼ tsp salt\n236 ml (1 cup) water"
    },
    {
      "id": 8943,
      "primary_message": "Peel and mince garlic. Wash, seed, and small dice bell pepper. Remove husks and silks from corn. Hold vertically in the middle of a bowl and slice kernels off the cob.",
      "secondary_message": "2 cloves garlic\n1 yellow bell pepper\n1 ear corn"
    },
    {
      "id": 40246,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 8944,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 8945,
      "primary_message": "In a small bowl, mix together chili powder, cumin, salt, and pepper.",
      "secondary_message": "½ tsp chili powder\r\n½ tsp cumin\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 8946,
      "primary_message": "Rub fish with spice mixture.",
      "secondary_message": "0.227 kg tilapia fillet"
    },
    {
      "id": 8947,
      "primary_message": "Coat bottom of skillet with oil. Add fish and cook until white and flaky, 2-3 minutes per side. Transfer to plate and set aside.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 8948,
      "primary_message": "Return skillet to stove. Add garlic and cook until fragrant, 15-30 seconds. Add bell pepper and corn and, stirring occasionally, cook until tender-crisp, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 8949,
      "primary_message": "Drain and rinse black beans. Add to skillet and stir until heated through, about 1 minute.",
      "secondary_message": "½ (398 ml) can black beans"
    },
    {
      "id": 8950,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Halve and pit avocado; scoop out and medium dice.",
      "secondary_message": "½ small bunch cilantro\r\n1 avocado"
    },
    {
      "id": 40245,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 8951,
      "primary_message": "To serve, place rice in a bowl and top with bean mixture and fish. Garnish with avocado, cilantro, and lime juice. Enjoy!",
      "secondary_message": "½ lime"
    }
  ],
