  "ingredients": [
    {
      "ingredient_id": 116,
      "name": "all-purpose flour, plus more for dusting",
      "quantity": "2 cups (11 oz)"
    },
    {
      "ingredient_id": 331,
      "name": "baking powder",
      "quantity": "1 ½ tbsp (6 oz)"
    },
    {
      "ingredient_id": 88,
      "name": "kosher salt",
      "quantity": "1 tsp (2 oz)"
    },
    {
      "ingredient_id": 346,
      "name": "granulated sugar",
      "quantity": "1 tbsp (5 oz)"
    },
    {
      "ingredient_id": 1752,
      "name": "heavy cream",
      "quantity": "1 ½ cups"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together flour, baking powder, salt, and sugar.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add heavy cream and stir gently with a wooden spoon until dry ingredients are just moistened.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Turn out dough onto a lighted floured work surface. Using your hands, fold it one or two times so it becomes a cohesive mass and press it down to an even 1.5-cm thickness. Using a 5-cm round cookie cutter, cut out biscuits as closely together as possible and transfer to a rimmed baking sheet. Gather together scraps, pat down, and cut out more biscuits. Discard any remaining scraps.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bake the biscuits in a 205°C (400°F) oven until risen and golden, about 12-15 minutes. Let cool slightly and serve warm.",
      "secondary_message": null
    }
  ],
