  "instructions": [
    {
      "primary_message": "Preheat oven to 300°F. Pour ¼-inch water into a roasting pan; set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and slide thyme leaves off the stems; discard stems and place leaves in a small bowl.",
      "secondary_message": "½ small pkg fresh thyme"
    },
    {
      "primary_message": "Add water, peach preserves, maple syrup, and mustard to the bowl with the thyme. Whisk to combine. Add additional water, if needed, to reach a glaze-like consistency. ",
      "secondary_message": "1 cup peach preserves\n½ cup pure maple syrup\n2 tbsp wholegrain mustard"
    },
    {
      "primary_message": "Pat ham dry with paper towels; transfer to the roasting pan. Use toothpicks to secure the slices together, then tent ham with aluminum foil. ",
      "secondary_message": "4.54 kg whole ham, spiral cut, bone-in"
    },
    {
      "primary_message": "Place roasting pan in the oven and roast until a thermometer inserted into the thickest part of the ham registers 135°F, about 1 ½ hours, brushing with the glaze every 10-15 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove roasting pan from the oven and transfer ham to a cutting board. Let rest, loosely covered with foil, about 15 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove toothpicks and carve ham. ",
      "secondary_message": null
    }
  ],
