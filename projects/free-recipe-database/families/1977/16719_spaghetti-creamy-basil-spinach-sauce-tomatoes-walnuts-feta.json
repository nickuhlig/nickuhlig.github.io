  "instructions": [
    {
      "id": 321487,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "2 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 321488,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 small pkgs grape tomatoes\n1 (142 g) pkg baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 321489,
      "primary_message": "Roughly chop walnuts, place in a small bowl, and set aside.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 321490,
      "primary_message": "Halve tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 321491,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw. Transfer to a medium bowl.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 321492,
      "primary_message": "Peel garlic and add to the bowl with the peas. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 321493,
      "primary_message": "Pick basil leaves off the stems and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 321494,
      "primary_message": "Add spinach, half of the feta (reserving remaining feta for garnish), cream cheese, oil, salt, and 1 cup reserved pasta water to the bowl. Working in batches if necessary, transfer the spinach mixture to a blender and purée sauce until smooth.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ (227 g) block cream cheese\n¼ cup extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 321495,
      "primary_message": "Return drained pasta to the pot. Add sauce and tomatoes; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 321496,
      "primary_message": "Return pot to medium-low heat and cook, stirring often, until sauce coats the pasta and tomatoes are warmed through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 321497,
      "primary_message": "To serve, divide pasta between plates or bowls; top with walnuts, remaining feta, and crushed red pepper. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
