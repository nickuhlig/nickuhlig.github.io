  "instructions": [
    {
      "id": 321476,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ½-cup of pasta cooking water before draining.)",
      "secondary_message": "1 tsp salt\n142 g spaghetti pasta"
    },
    {
      "id": 321477,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg grape tomatoes\n½ (142 g) pkg baby spinach\n½ small pkg fresh basil"
    },
    {
      "id": 321478,
      "primary_message": "Roughly chop walnuts, place in a small bowl, and set aside.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 321479,
      "primary_message": "Halve tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 321480,
      "primary_message": "Place peas in a colander and run under hot water (from the tap) to thaw. Transfer to a blender.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 321481,
      "primary_message": "Peel garlic and add to the blender with the peas. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 321482,
      "primary_message": "Pick basil leaves off the stems and add to the blender.",
      "secondary_message": null
    },
    {
      "id": 321483,
      "primary_message": "Add spinach, half of the feta (reserving remaining feta for garnish), cream cheese, oil, salt, and ½-cup reserved pasta water; purée sauce until smooth.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n¼ (227 g) block cream cheese\n2 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 321484,
      "primary_message": "Return drained pasta to the pan. Add sauce and tomatoes; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 321485,
      "primary_message": "Return pan to medium-low heat and cook, stirring often, until sauce coats the pasta and tomatoes are warmed through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 321486,
      "primary_message": "To serve, divide pasta between plates or bowls; top with walnuts, remaining feta, and crushed red pepper. Enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
