  "instructions": [
    {
      "id": 361954,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 361955,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n1 avocado\n½ small bunch fresh dill"
    },
    {
      "id": 361956,
      "primary_message": "Place seeds and spices in a small bowl; stir to combine the \"everything spice\" mixture.",
      "secondary_message": "2 tsp sesame seeds\n1 tsp poppy seeds\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 361957,
      "primary_message": "Pat the salmon dry with paper towels and place, skin-side down, on the baking sheet. Spread with Dijon, then sprinkle evenly with the spice mixture, pressing gently to adhere.",
      "secondary_message": "¾ lb salmon fillet\n1 tbsp Dijon mustard"
    },
    {
      "id": 361958,
      "primary_message": "Place fish in the oven (it doesn't have to be fully heated) and bake until cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 361959,
      "primary_message": "Meanwhile, place oil, vinegar, capers, and salt in a medium bowl; stir to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tbsp capers\n¼ tsp salt"
    },
    {
      "id": 361960,
      "primary_message": "Peel, halve, and thinly slice onion crosswise into half-moons. Add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 361961,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361962,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon into the bowl.",
      "secondary_message": null
    },
    {
      "id": 361963,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 361964,
      "primary_message": "To serve, divide the salmon and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
