  "instructions": [
    {
      "id": 361976,
      "primary_message": "Preheat oven to 450°F. Coat a large baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 361977,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n3 avocados\n1 small bunch fresh dill"
    },
    {
      "id": 361978,
      "primary_message": "Place seeds and spices in a small bowl; stir to combine the \"everything spice\" mixture.",
      "secondary_message": "2 tbsp sesame seeds\n1 tbsp poppy seeds\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 361979,
      "primary_message": "Pat the salmon dry with paper towels and place, skin-side down, on the baking sheet. Spread with Dijon, then sprinkle evenly with the spice mixture, pressing gently to adhere.",
      "secondary_message": "2 ¼ lb salmon fillet\n3 tbsp Dijon mustard"
    },
    {
      "id": 361980,
      "primary_message": "Place fish in the oven (it doesn't have to be fully heated) and bake until cooked through, about 10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 361981,
      "primary_message": "Meanwhile, place oil, vinegar, capers, and salt in a large bowl; stir to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n3 tbsp capers\n¾ tsp salt"
    },
    {
      "id": 361982,
      "primary_message": "Peel, halve, and thinly slice onions crosswise into half-moons. Add to the bowl with the dressing.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 361983,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361984,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon into the bowl.",
      "secondary_message": null
    },
    {
      "id": 361985,
      "primary_message": "Shave dill leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 361986,
      "primary_message": "To serve, divide the salmon and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
