  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk eggs with 2 generous pinches of salt and set aside. In a medium bowl, toss tomatoes with a generous pinch salt, then transfer tomatoes to a strainer and set over bowl to drain.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in a large cast iron or non-stick skillet over medium-high heat until shimmering. Add onion and jalapeños and cook, stirring, until softened but not browned, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add eggs and cook, stirring until curds begin to form, 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Stir in 1 cup crushed Doritos and continue to cook until eggs are nearly set, about 2 minutes. Stir in cheese until mostly melted. Add tomatoes and continue to cook, stirring, until tomatoes are warmed through and eggs are just cooked, 1-2 minutes longer. Season with salt and pepper and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Serve migas with warm tortillas and avocado, if desired, and top with crushed Doritos and hot sauce.",
      "secondary_message": null
    }
  ],
