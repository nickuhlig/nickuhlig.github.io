  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Grate the ginger. Toast the sesame seeds. Thinly slice the rib eye.",
      "secondary_message": "2 cloves garlic\n1 tsp ginger\n1 tsp sesame seeds\n0.45 kg rib eye"
    },
    {
      "id": 1,
      "primary_message": "Add the soy sauce, sugar, sesame oil, mirin, onion, garlic, ginger, sesame seeds, and black pepper to a large bowl. Whisk until combined. Toss in the meat, cover, and set in the fridge for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat a grill pan or a large iron skillet to high heat. Remove the meat from the marinade, and then toss in the pan. Cook for a few minutes on each side, until nicely browned.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Serve the beef with lettuce, white rice, kimchi, and hot bean paste.",
      "secondary_message": null
    }
