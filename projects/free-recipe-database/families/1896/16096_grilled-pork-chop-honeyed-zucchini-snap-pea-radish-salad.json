  "instructions": [
    {
      "id": 263979,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 medium zucchini squash\n3 (227 g) pkg sugar snap peas\n1 ½ bunches radish"
    },
    {
      "id": 263980,
      "primary_message": "Zest lemons into a small bowl (set lemons aside for later). Add oil, salt, and pepper to the bowl; stir to combine the lemon oil.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 263981,
      "primary_message": "Trim and slice zucchini lengthwise into ¼-inch thick planks; transfer to a large plate and drizzle both sides with the lemon oil.",
      "secondary_message": null
    },
    {
      "id": 263982,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263983,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add zucchini planks and grill, flipping once, until charred and fork-tender, about 3 minutes per side; return to the plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 263984,
      "primary_message": "Meanwhile, pat pork chops dry with paper towels and place on another large plate; season with spices on both sides.",
      "secondary_message": "6 pork chops, bone-in\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp sage, dried"
    },
    {
      "id": 263985,
      "primary_message": "Once the zucchini is done, coat the pan with oil; working in batches if necessary, add pork chops and grill until golden and cooked through, 4-5 minutes per side. Add to the plate with the zucchini.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 263986,
      "primary_message": "While the chops are cooking, juice reserved lemons into a medium bowl; add mayo and spices. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tsp garlic powder\n1 ½ tsp dill, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 263987,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263988,
      "primary_message": "Trim and thinly slice radishes; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 263989,
      "primary_message": "To serve, divide pork chops, zucchini, and salad between plates. Drizzle honey over the zucchini and enjoy!",
      "secondary_message": "1 tbsp honey"
    }
  ],
