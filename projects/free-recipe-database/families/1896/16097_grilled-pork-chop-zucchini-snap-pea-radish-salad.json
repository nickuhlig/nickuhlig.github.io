  "instructions": [
    {
      "id": 263990,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ medium zucchini squash\n1 (227 g) pkg sugar snap peas\n½ bunch radish"
    },
    {
      "id": 263991,
      "primary_message": "Zest half the lemon into a small bowl (set lemon aside for later). Add oil, salt, and pepper to the bowl; stir to combine the lemon oil.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 263992,
      "primary_message": "Trim and slice zucchini crosswise into ¼-inch thick rounds; add to the bowl with the lemon oil and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 263993,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 263994,
      "primary_message": "Once the grill pan is hot, add zucchini and grill, flipping once, until charred and fork-tender, 1-2 minutes per side; transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 263995,
      "primary_message": "Meanwhile, pat the pork chops dry with paper towels and place on another plate; season with spices on both sides.",
      "secondary_message": "2 pork chops, bone-in\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp sage, dried"
    },
    {
      "id": 263996,
      "primary_message": "Once the zucchini is done, coat the pan with oil; add pork chops and grill until golden and cooked through, 4-5 minutes per side. Add to the plate with the zucchini.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 263997,
      "primary_message": "While the chops are cooking, juice reserved lemon into a medium bowl; add mayo and spices. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp avocado oil mayonnaise\n½ tsp garlic powder\n½ tsp dill, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 263998,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 263999,
      "primary_message": "Trim and thinly slice radishes; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 264000,
      "primary_message": "To serve, divide pork chops, zucchini, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
