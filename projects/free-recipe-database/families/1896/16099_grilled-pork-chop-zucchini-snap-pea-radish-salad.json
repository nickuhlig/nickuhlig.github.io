  "instructions": [
    {
      "id": 264012,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n2 medium zucchini squash\n3 (227 g) pkg sugar snap peas\n1 ½ bunches radish"
    },
    {
      "id": 264013,
      "primary_message": "Zest half of the lemons into a medium bowl (set lemons aside for later). Add oil, salt, and pepper to the bowl; stir to combine the lemon oil.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 264014,
      "primary_message": "Trim and slice zucchini crosswise into ¼-inch thick rounds; add to the bowl with the lemon oil and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 264015,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 264016,
      "primary_message": "Once the grill pan is hot, add zucchini and grill, flipping once, until charred and fork-tender, 1-2 minutes per side; transfer to a large plate and loosely cover with aluminum foil. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 264017,
      "primary_message": "Meanwhile, pat the pork chops dry with paper towels and place on another large plate; season with spices on both sides.",
      "secondary_message": "6 pork chops, bone-in\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp sage, dried"
    },
    {
      "id": 264018,
      "primary_message": "Once the zucchini is done, coat the pan with oil; working in batches if necessary, add pork chops and grill until golden and cooked through, 4-5 minutes per side. Add to the plate with the zucchini.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 264019,
      "primary_message": "While the chops are cooking, juice lemons into the reserved bowl; add mayo and spices. Whisk to combine the dressing. ",
      "secondary_message": "⅓ cup avocado oil mayonnaise\n1 ½ tsp garlic powder\n1 ½ tsp dill, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 264020,
      "primary_message": "Cut snap peas crosswise into ¼-inch pieces; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 264021,
      "primary_message": "Trim and thinly slice radishes; add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 264022,
      "primary_message": "To serve, divide pork chops, zucchini, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
