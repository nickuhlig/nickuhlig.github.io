  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer pita to a baking sheet pan. Spread with pesto, then top with cheese. ",
      "secondary_message": "1 white pita bread\n3 tbsp basil pesto\n½ cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until cheese is melted, 8-10 minutes. Remove from oven and set aside to cool completely, 20-30 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve orange lengthwise, then slice into 1-inch thick wedges.",
      "secondary_message": "½ orange"
    },
    {
      "primary_message": "Place granola in the first small compartment of the bento box. ",
      "secondary_message": "⅓ cup granola"
    },
    {
      "primary_message": "Wash and dry tomatoes. Place in the second small compartment of the bento box. ",
      "secondary_message": "⅓ cup grape tomatoes"
    },
    {
      "primary_message": "When the pizza is cool, cut into wedges and place in the large compartment of the bento box.",
      "secondary_message": null
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
