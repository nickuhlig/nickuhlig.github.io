  "instructions": [
    {
      "id": 22681,
      "primary_message": "Wash green beans, carrot, and bell pepper.",
      "secondary_message": "½ lb green beans\r\n1 medium carrot\r\n1 red bell pepper"
    },
    {
      "id": 22682,
      "primary_message": "Trim green bean ends and transfer to a large bowl. Seed and slice pepper into strips lengthwise; add to bowl. Trim ends, peel, and thinly slice carrot on the diagonal; add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 22683,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 22684,
      "primary_message": "Season steak with salt and pepper on both sides.",
      "secondary_message": "¾ lb ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 22685,
      "primary_message": "Coat grill or skillet with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 22686,
      "primary_message": "Heat a separate skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 22687,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic\r\n"
    },
    {
      "id": 22688,
      "primary_message": "Melt butter in skillet and add garlic; cook until fragrant, 15-30 seconds. Add vegetables and cook, stirring often, until tender-crisp, 5-6 minutes. Season with salt and pepper; toss to coat.",
      "secondary_message": "2 tbsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 22689,
      "primary_message": "Serve steak with sautéed vegetables on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
