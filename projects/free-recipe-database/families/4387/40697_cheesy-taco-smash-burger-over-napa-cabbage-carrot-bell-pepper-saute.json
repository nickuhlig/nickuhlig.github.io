  "instructions": [
    {
      "id": 629056,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n3 medium carrots\n3 green bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 629057,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 629058,
      "primary_message": "Peel and trim carrots; using a peeler, peel the carrot into noodle-like strips. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 629059,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 629060,
      "primary_message": "Place beef, tomato paste, and spices in another large bowl. Use your hands to combine the beef mixture. Form into 6 equal-sized meatballs and place on a plate.",
      "secondary_message": "2 ¼ lb lean ground beef\n3 tbsp tomato paste\n1 ½ tsp chili powder\n¾ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 629061,
      "primary_message": "Preheat a large skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 629062,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs to the skillet, spacing them apart; press down with the bottom of a spatula to form ½-inch thick patties. Cook, undisturbed, until golden on one side, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 629063,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 629064,
      "primary_message": "When the burgers are done on one side, flip and top with cheese. Continue to cook until cheese melts and burgers are cooked through, 3-4 minutes more. Transfer burgers to a plate and loosely cover with aluminum foil. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 629065,
      "primary_message": "While the burgers are cooking, peel and mince garlic. Add to the bowl with the veggies.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 629066,
      "primary_message": "Return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies, garlic, salt, and pepper; cook, stirring occasionally, until veggies are tender-crisp, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 629067,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. When the veggies are done, add cilantro to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 629068,
      "primary_message": "To serve, divide vegetable sauté between plates or bowls, then top with cheesy burgers and yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
