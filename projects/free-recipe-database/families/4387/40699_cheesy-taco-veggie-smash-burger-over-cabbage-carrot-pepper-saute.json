  "instructions": [
    {
      "id": 629082,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n2 medium carrots\n2 green bell peppers\n1 small bunch cilantro"
    },
    {
      "id": 629083,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 629084,
      "primary_message": "Peel and trim carrots; using a peeler, peel the carrot into noodle-like strips. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 629085,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 629086,
      "primary_message": "Place veggie ground, tomato paste, and spices into a medium bowl. Use your hands to combine the mixture. Form into 4 equal-sized \"meatballs\" and place on a plate.",
      "secondary_message": "16 oz veggie ground, plant based\n2 tbsp tomato paste\n1 tsp chili powder\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 629087,
      "primary_message": "Preheat a large skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 629088,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs to the skillet, spacing them apart; press down with the bottom of a spatula to form ½-inch thick patties. Cook, undisturbed, until golden on one side, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 629089,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 629090,
      "primary_message": "When the burgers are done on one side, flip and top with cheese. Continue to cook until cheese melts and burgers are cooked through, 3-4 minutes more. Transfer burgers to a plate and loosely cover with aluminum foil. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": null
    },
    {
      "id": 629091,
      "primary_message": "While the burgers are cooking, peel and mince garlic. Add to the bowl with the vegetables.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 629092,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat, add more oil, and swirl to coat the bottom. Add vegetables, garlic, salt, and pepper; cook, stirring occasionally, until vegetables are tender-crisp, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 629093,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. When the vegetables are done, add cilantro to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 629094,
      "primary_message": "To serve, divide vegetable sauté between plates or bowls, then top with cheesy burgers and yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
