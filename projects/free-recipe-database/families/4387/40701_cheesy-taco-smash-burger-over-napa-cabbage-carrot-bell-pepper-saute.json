  "instructions": [
    {
      "id": 629108,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 medium carrot\n1 green bell pepper\n½ small bunch cilantro"
    },
    {
      "id": 629109,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 629110,
      "primary_message": "Peel and trim carrot; using a peeler, peel the carrot into noodle-like strips. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 629111,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 629112,
      "primary_message": "Place beef, tomato paste, and spices in another medium bowl. Use your hands to combine the beef mixture. Form into 2 equal-sized meatballs and place on a plate.",
      "secondary_message": "⅓ kg lean ground beef\n1 tbsp tomato paste\n½ tsp chili powder\n¼ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 629113,
      "primary_message": "Preheat a skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 629114,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs to the skillet, spacing them apart; press down with the bottom of a spatula to form ½-inch thick patties. Cook, undisturbed, until golden on one side, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 629115,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 629116,
      "primary_message": "When the burgers are done on one side, flip and top with cheese. Continue to cook until cheese melts and burgers are cooked through, 3-4 minutes more. Transfer burgers to a plate and loosely cover with aluminum foil. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 629117,
      "primary_message": "While the burgers are cooking, peel and mince garlic. Add to the bowl with the veggies.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 629118,
      "primary_message": "Return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies, garlic, salt, and pepper; cook, stirring occasionally, until veggies are tender-crisp, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 629119,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. When the veggies are done, add cilantro to the skillet, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 629120,
      "primary_message": "To serve, divide vegetable sauté between plates or bowls, then top with cheesy burgers and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
