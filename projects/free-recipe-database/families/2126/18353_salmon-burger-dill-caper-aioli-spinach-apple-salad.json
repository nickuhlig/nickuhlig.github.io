  "instructions": [
    {
      "id": 301068,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 sticks celery\n1 Gala apple\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 301069,
      "primary_message": "Drain salmon, place in a medium bowl, and flake with a fork; add egg, bread crumbs, mayo, and spices. Stir to combine the salmon mixture, form into 2 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "1 (213 g) can wild pink salmon, traditional style\n1 egg\n⅓ cup panko bread crumbs\n1 tbsp mayonnaise\n½ tsp dill, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301070,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl, add mayo, and stir to combine the aioli; set aside.",
      "secondary_message": "1 clove garlic\n1 tbsp capers\n2 tbsp mayonnaise"
    },
    {
      "id": 301071,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 301072,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add salmon patties and cook until browned and warmed through, about 5 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 301073,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a clean medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 301074,
      "primary_message": "Trim and thinly slice celery crosswise; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 301075,
      "primary_message": "Quarter, core, and thinly slice apple; add to the bowl along with spinach and cranberries. Toss to combine the salad and set aside.",
      "secondary_message": "⅛ cup dried cranberries"
    },
    {
      "id": 301076,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 301077,
      "primary_message": "To assemble the burgers, spread the bottom half of each bun with aioli; layer with a salmon patty and the top half of each bun.",
      "secondary_message": null
    },
    {
      "id": 301078,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
