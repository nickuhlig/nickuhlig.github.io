  "instructions": [
    {
      "id": 301090,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 sticks celery\n3 Gala apples\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 301091,
      "primary_message": "Drain salmon, place in a medium bowl, and flake with a fork; add eggs, bread crumbs, mayo, and spices. Stir to combine the salmon mixture, form into 6 equal-sized patties, place on a plate, and set aside.",
      "secondary_message": "3 (213 g) cans wild pink salmon, traditional style\n3 eggs\n1 cup panko bread crumbs\n3 tbsp mayonnaise\n1 ½ tsp dill, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 301092,
      "primary_message": "Peel and mince garlic; mince capers. Place both in a small bowl, add mayo, and stir to combine the aioli; set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp capers\n⅓ cup mayonnaise"
    },
    {
      "id": 301093,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 301094,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon patties and cook until browned and warmed through, about 5 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 301095,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301096,
      "primary_message": "Trim and thinly slice celery crosswise; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 301097,
      "primary_message": "Quarter, core, and thinly slice apples; add to the bowl along with spinach and cranberries. Toss to combine the salad and set aside.",
      "secondary_message": "⅓ cup dried cranberries"
    },
    {
      "id": 301098,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 301099,
      "primary_message": "To assemble the burgers, spread the bottom half of each bun with aioli; layer with a salmon patty and the top half of each bun.",
      "secondary_message": null
    },
    {
      "id": 301100,
      "primary_message": "To serve, divide burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
