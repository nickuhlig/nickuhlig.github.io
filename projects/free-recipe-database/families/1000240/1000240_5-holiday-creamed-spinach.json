  "instructions": [
    {
      "primary_message": "Fill a large pot with hot water (from the tap), cover, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the water is heating, cut cream cheese into small pieces. Place in a small bowl. ",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic.  ",
      "secondary_message": "1 medium yellow onion\n3 clove garlic"
    },
    {
      "primary_message": "Wash the spinach (skip this step if it came pre-washed). ",
      "secondary_message": "2 (16 oz) pkg baby spinach"
    },
    {
      "primary_message": "Once the water in the pot is boiling, uncover. Working in batches if necessary, add salt and spinach, and stir until wilted, about 1 minute. Drain in a colander and rinse with cold water to cool (if cooking in batches, use tongs to transfer spinach to a colander). (Reserve pot for later use.) ",
      "secondary_message": "2 tsp salt"
    },
    {
      "primary_message": "Working in batches, take handfuls of the cooled spinach and use your hands to gently squeeze out any excess water. Place in a medium bowl and set aside. ",
      "secondary_message": null
    },
    {
      "primary_message": "If necessary, wipe the pot clean with paper towels, then return to medium heat. Once the pot is hot, add butter and swirl to coat the bottom.  ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "primary_message": "Add onion, garlic, salt, and pepper to the pot. Cook, stirring occasionally, until onion is soft, about 4 minutes. ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Add flour and cook, stirring constantly, for 1 minute.  ",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "primary_message": "Add softened cream cheese, cream, shredded cheese, and spices to the pot. Cook, stirring frequently, until cheeses melt and sauce thickens, about 3 minutes.  ",
      "secondary_message": "16 fl oz heavy whipping cream\n¾ cup shredded cheese, Italian blend\n1 ½ tsp salt\n1 tsp nutmeg, ground\n½ tsp black pepper"
    },
    {
      "primary_message": "Add spinach back to the pot and continue to cook, stirring frequently, until warmed through, 2-3 minutes. Remove from heat.  ",
      "secondary_message": null
    }
  ],
