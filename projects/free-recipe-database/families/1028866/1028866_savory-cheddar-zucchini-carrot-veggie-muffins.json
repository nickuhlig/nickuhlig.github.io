  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved if you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 400°F. Coat 12 muffin cups with cooking spray. (Alternatively, line a muffin pan with paper liners.) \n\n",
      "secondary_message": "2 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place butter in a small saucepan and melt over medium heat. Remove from heat.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, place flour, baking powder, baking soda, and spices in a large bowl. Whisk to combine the dry ingredients.\n\n",
      "secondary_message": "1 ½ cups all-purpose flour\n1 tsp baking powder\n½ tsp baking soda\n½ tsp onion powder\n½ tsp salt\n¼ tsp garlic powder\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Wash, dry, trim, and coarsely grate zucchini. Use paper towels or a clean cloth to squeeze excess moisture out of the grated zucchini. Add zucchini to the bowl with the dry ingredients.\n\n",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "primary_message": "Wash, dry, peel, and trim carrots; coarsely grate. Add to the bowl along with cheese. Stir well to coat the veggies in flour. ",
      "secondary_message": "1 cup cheddar cheese, shredded"
    },
    {
      "primary_message": "Place melted butter, buttermilk, and eggs in a medium bowl, then whisk to combine. Add to the bowl with the flour mixture and gently stir until batter is just combined. ",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "primary_message": "Divide the batter between muffin cups (about ¼-cup per muffin). Place muffin pan in the preheated oven and bake until a toothpick inserted into the center of a muffin comes out clean, about 20 minutes. Remove from oven and allow to cool slightly, 5 minutes. Remove muffins from the pan and set on a wire rack to cool completely, 30 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Serve cooled muffins and enjoy!",
      "secondary_message": null
    }
  ],
