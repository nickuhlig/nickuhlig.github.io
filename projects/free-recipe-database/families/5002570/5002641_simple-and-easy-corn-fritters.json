  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large bowl, whisk together cornmeal, flour, baking powder, salt, and sugar. In a separate bowl combine milk and eggs then pour wet ingredients over dry ingredients and whisk to combine. Add melted butter and corn and mix well.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To a Dutch oven or wok, add oil until it measures 5-cm deep and heat to 175°C (350°F). Working in batches, drop corn fritter batter into hot oil one tablespoon at a time. Cook, agitating and turning frequently until golden brown and crisp on all sides and fritters are cooked through, about 4 minutes total. Remove fritters to a large plate lined with paper towels and season with salt. Return oil to 175°C and repeat with remaining batter. Serve immediately, garnished with powdered sugar or sliced scallions.",
      "secondary_message": null
    }
  ],
