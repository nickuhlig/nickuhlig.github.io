  "instructions": [
    {
      "id": 14902,
      "primary_message": "Wash and large dice potatoes. Transfer to a medium saucepan, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain.",
      "secondary_message": "6 medium red potatoes"
    },
    {
      "id": 14903,
      "primary_message": "Peel and mince garlic. Grate ¼ cup of Parmesan.",
      "secondary_message": "4 cloves garlic\n1 oz Parmesan cheese"
    },
    {
      "id": 14904,
      "primary_message": "In a small bowl, prepare dressing by whisking together garlic, ½ of the Grated parmesan (save the rest for garnishing), lemon juice, yogurt, olive oil, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "juice of ½ lemon \n½ cup plain Greek yogurt\n4 tbsp extra virgin olive oil\n½ tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 14905,
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then chop crosswise into thin (shred-like) strips. Transfer to a large bowl.",
      "secondary_message": "2 heads romaine lettuce"
    },
    {
      "id": 14906,
      "primary_message": "Wash and dry green onions. Trim and discard root ends and chop onions. Add to bowl with romaine.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 14907,
      "primary_message": "Cut remaining ½ lemon into wedges.",
      "secondary_message": ""
    },
    {
      "id": 14908,
      "primary_message": "Add potatoes to bowl and pour in dressing. Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 14909,
      "primary_message": "To serve, place salad on a plate and garnish with remaining Parmesan and lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
