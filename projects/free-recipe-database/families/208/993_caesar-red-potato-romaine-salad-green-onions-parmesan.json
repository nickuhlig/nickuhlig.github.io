  "instructions": [
    {
      "id": 14782,
      "primary_message": "Wash and large dice potatoes. Transfer to a small saucepan, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain.",
      "secondary_message": "3 medium red potatoes"
    },
    {
      "id": 14783,
      "primary_message": "Peel and mince garlic. Grate ⅛ cup of Parmesan.",
      "secondary_message": "2 cloves garlic\r\n14 g Parmesan cheese"
    },
    {
      "id": 14784,
      "primary_message": "In a small bowl, prepare dressing by whisking together garlic, ½ of the grated Parmesan (save the rest for garnishing), lemon juice, yogurt, olive oil, Dijon, Worcestershire, salt, and pepper. Set aside.",
      "secondary_message": "juice of ¼ lemon \n¼ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n¼ tsp Dijon mustard\n¼ tsp Worcestershire sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 14785,
      "primary_message": "Wash and dry lettuce. Halve lengthwise, then hop crosswise into thin (shred-like) strips. Transfer to a large bowl.",
      "secondary_message": "1 head romaine lettuce"
    },
    {
      "id": 14786,
      "primary_message": "Wash and dry green onions. Trim and discard root ends and chop onions. Add to bowl with romaine.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 14787,
      "primary_message": "Cut remaining ¼ lemon into wedges.",
      "secondary_message": ""
    },
    {
      "id": 14788,
      "primary_message": "Add potatoes to bowl and pour in dressing. Toss salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 14789,
      "primary_message": "To serve, place salad on a plate and garnish with remaining Parmesan and lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
