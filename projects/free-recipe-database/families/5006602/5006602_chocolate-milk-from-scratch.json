  "instructions": [
    {
      "id": 1,
      "primary_message": "In a microwave-safe container, heat 1/4 cup of the milk until steaming, about 15 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the cocoa powder and honey (or sugar) to the hot milk, and stir vigorously until all the lumps are gone.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer the cocoa mix into your glass of choice, and fill with the remaining cold milk. Enjoy!",
      "secondary_message": null
    }
