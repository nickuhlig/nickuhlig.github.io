  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and cut the frozen ripe banana into 4 pieces.",
      "secondary_message": "1 large frozen ripe banana"
    },
    {
      "id": 1,
      "primary_message": "In a large skillet, toast oats over medium heat, stirring constantly, until lightly browned and nutty in fragrance, about 1 minute and 30 seconds. Transfer to a shallow plate to cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a blender, blend 1 1/4 cups almond milk, bananas, ice cubes, dates, sugar or honey (if using), vanilla extract, cocoa powder, 1/4 cup peanut butter, and cooled toasted oats until smooth, about 1 minute. Pour evenly into 2 cups.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For Serving: If desired, mix remaining 1 tablespoon peanut butter with remaining 2 teaspoons almond milk until a smooth syrup forms. Drizzle peanut butter mixture evenly over top of each glass. Garnish with cacao nibs and sprinkle with crushed peanuts, if desired.",
      "secondary_message": null
    }
  ],
