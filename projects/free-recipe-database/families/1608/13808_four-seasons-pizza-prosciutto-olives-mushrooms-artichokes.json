  "instructions": [
    {
      "id": 232514,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 232515,
      "primary_message": "Place tomato sauce and spices in a small bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n1 tsp Italian seasoning\n¼ tsp onion powder\n¼ tsp garlic powder\n¼ tsp crushed red pepper\n⅛ tsp salt"
    },
    {
      "id": 232516,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from the oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 232517,
      "primary_message": "Meanwhile, wash, dry, and cut mushrooms into ¼-inch thick slices. Transfer to a large plate.",
      "secondary_message": "0.23 kg white mushrooms"
    },
    {
      "id": 232518,
      "primary_message": "Slice olives and add to the plate with the mushrooms.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 232519,
      "primary_message": "Drain and slice artichokes; add to the plate.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 232520,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces and place on the plate.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 232521,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 232522,
      "primary_message": "Spread tomato sauce over each toasted flatbread and sprinkle with cheese.",
      "secondary_message": null
    },
    {
      "id": 232523,
      "primary_message": "Divide mushrooms, olives, artichokes, and prosciutto between flatbreads, piling each ingredient in their own quarter.",
      "secondary_message": null
    },
    {
      "id": 232524,
      "primary_message": "Return prepared flatbreads to the oven and bake until cheese is melted and mushrooms have softened, 5-7 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 232525,
      "primary_message": "To serve, slice flatbread pizzas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
