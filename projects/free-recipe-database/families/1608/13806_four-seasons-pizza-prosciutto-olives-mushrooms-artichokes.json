  "instructions": [
    {
      "id": 232490,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 232491,
      "primary_message": "Place tomato sauce and spices in a medium bowl; whisk to combine the sauce and set aside.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 ½ tsp Italian seasoning\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp crushed red pepper\n3 pinch salt"
    },
    {
      "id": 232492,
      "primary_message": "Divide flatbreads between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, about 10 minutes. Remove from the oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 232493,
      "primary_message": "Meanwhile, wash, dry, and cut mushrooms into ¼-inch thick slices. Transfer to a platter.",
      "secondary_message": "¾ lb white mushrooms"
    },
    {
      "id": 232494,
      "primary_message": "Slice olives and add to the platter with the mushrooms.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 232495,
      "primary_message": "Drain and slice artichokes; add to the platter.",
      "secondary_message": "1 ½ (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 232496,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces and place on the platter.",
      "secondary_message": "9 slices prosciutto"
    },
    {
      "id": 232497,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 232498,
      "primary_message": "Spread tomato sauce over each toasted flatbread and sprinkle with cheese.",
      "secondary_message": null
    },
    {
      "id": 232499,
      "primary_message": "Divide mushrooms, olives, artichokes, and prosciutto between flatbreads, piling each ingredient in their own quarter.",
      "secondary_message": null
    },
    {
      "id": 232500,
      "primary_message": "Return prepared flatbreads to the oven and bake until cheese is melted and mushrooms have softened, about 7 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 232501,
      "primary_message": "To serve, slice flatbread pizzas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
