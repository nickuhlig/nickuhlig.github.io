  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 small bunch fresh dill\n2 pints grape tomatoes\n2 English cucumbers"
    },
    {
      "primary_message": "Juice one lemon into a baking dish. Add oil, vinegar, sugar, and spices, then whisk to combine the marinade. (Reserve remaining lemon for later use.)",
      "secondary_message": "extra virgin olive oil\nbalsamic vinegar\n2 tsp brown sugar\ngarlic powder\noregano, dried\nsalt\nblack pepper"
    },
    {
      "primary_message": "Pat the salmon dry with paper towels. Add to the baking dish with the marinade and turn to coat.",
      "secondary_message": "1 ½ lb salmon fillet"
    },
    {
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until salmon is opaque and cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Divide between a small and a medium bowl, then set the medium bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "primary_message": "Juice reserved lemon into the small bowl with the dill. Add yogurt, mayo, and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n¼ cup mayonnaise\noregano, dried\nsalt\nblack pepper"
    },
    {
      "primary_message": "Add oil, vinegar, and spices to the medium bowl with the dill, then whisk to combine the dressing.",
      "secondary_message": "extra virgin olive oil\nbalsamic vinegar\ngarlic powder\noregano, dried\nsalt\nblack pepper"
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "primary_message": "Roughly chop olives. Add to the bowl, along with feta, and stir to combine the salad.",
      "secondary_message": "½ cup Kalamata olives, pitted\n1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "primary_message": "To serve, divide salad and salmon between plates or bowls. Top salmon with sauce and enjoy!",
      "secondary_message": null
    }
  ],
