  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch fresh dill\n3 pints grape tomatoes\n3 English cucumbers"
    },
    {
      "primary_message": "Juice half of the lemons into a large baking dish. Add oil, vinegar, sugar, and spices, then whisk to combine the marinade. (Reserve remaining lemons for later use.)",
      "secondary_message": "extra virgin olive oil\nbalsamic vinegar\n1 tbsp brown sugar\ngarlic powder\noregano, dried\nsalt\nblack pepper"
    },
    {
      "primary_message": "Pat the salmon dry with paper towels. Add to the baking dish with the marinade and turn to coat.",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until salmon is opaque and cooked through, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and mince the leaves. Divide between a small and a large bowl, then set the large bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "primary_message": "Juice reserved lemons into the small bowl with the dill. Add yogurt, mayo, and spices, then whisk to combine the sauce. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\noregano, dried\nsalt\nblack pepper"
    },
    {
      "primary_message": "Add oil, vinegar, and spices to the large bowl with the dill, then whisk to combine the dressing.",
      "secondary_message": "extra virgin olive oil\nbalsamic vinegar\ngarlic powder\noregano, dried\nsalt\nblack pepper"
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and medium dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "primary_message": "Roughly chop olives. Add to the bowl, along with feta, and stir to combine the salad.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "primary_message": "To serve, divide salad and salmon between plates or bowls. Top salmon with sauce and enjoy!",
      "secondary_message": null
    }
  ],
