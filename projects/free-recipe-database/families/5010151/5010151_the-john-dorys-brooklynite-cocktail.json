  "instructions": [
    {
      "id": 1,
      "primary_message": "To make quick honey syrup, stir boiling water into honey in a heatsafe container. Make sure honey is completely dissolved and let cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add lime juice, 3/4 ounce honey syrup, rum, and bitters to a cocktail shaker and fill with ice. Shake well until very cold. Strain into cocktail glass and serve up with lime wedge.",
      "secondary_message": null
    }
