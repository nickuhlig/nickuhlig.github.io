  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Adobo Marinade: Adjust oven rack to center position and preheat oven to 175°C (350°F). Place dried ancho chiles on a microwave-safe plate and microwave until pliable and toasty-smelling, 10 to 20 seconds. Transfer to the jar of a blender and add chipotle peppers, olive oil, garlic, oregano, cumin seeds, coriander seeds, cloves, brown sugar, vinegar, soy sauce, and fish sauce. Blend until a smooth sauce has formed, about 1 minute. Season to taste with salt. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Pineapple: Rub pineapple on all sides with half of the marinade and arrange on a foil-lined rimmed baking sheet. Drape pineapple with bacon slices. Transfer to oven and roast until pineapple is tender and deepens in color and bacon is crisp, 45 minutes to 1 hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To Serve: Remove bacon and cut into 5-cm pieces. Slice pineapple into 0.5 to 1.5-cm slices. Serve pineapple and bacon tucked into double-stacked corn tortillas topped with remaining marinade, salsa verde, cotija, fresh chiles, and cilantro.",
      "secondary_message": null
    }
  ],
