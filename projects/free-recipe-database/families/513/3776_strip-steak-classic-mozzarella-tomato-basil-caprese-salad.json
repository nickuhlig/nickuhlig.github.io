  "instructions": [
    {
      "id": 41531,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small pkg grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 41532,
      "primary_message": "Halve the grape tomatoes and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 41533,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 41534,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 41535,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 41536,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 41537,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and tear the leaves into smaller pieces. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 41538,
      "primary_message": "Tear the mozzarella into bite-sized chunk and place them in a small bowl.",
      "secondary_message": "1 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 41539,
      "primary_message": "Thinly slice the steak against the grain into strips.",
      "secondary_message": null
    },
    {
      "id": 41540,
      "primary_message": "To serve, divide the tomatoes between plates (placing them on one side and leaving room for the steak on the other side), scatter the mozzarella chunks and basil leaves on top, drizzle with olive oil, and season with salt and pepper. Place the steak beside the salad. Enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    }
  ],
