  "instructions": [
    {
      "id": 568765,
      "primary_message": "Place tomato sauce and spices in a small saucepan. Stir to combine and bring to a simmer over medium heat. Once simmering, remove from heat and cover to keep warm. ",
      "secondary_message": "1 (8 oz) can tomato sauce\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 568766,
      "primary_message": "Meanwhile, drain olives. ",
      "secondary_message": "1 (3.8 oz) can sliced black olives"
    },
    {
      "id": 568767,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568768,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide mushrooms, olives, and cheese between them, arranging on one half of each tortilla. Season with spices, then fold in half to close.",
      "secondary_message": "2 large flour tortillas\n1 (8 oz) pkg sliced white mushrooms\n⅔ cup shredded cheese, Italian blend\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 568769,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add quesadillas and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 568770,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed).",
      "secondary_message": "½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 568771,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and medium dice. Set aside. ",
      "secondary_message": "½ avocado"
    },
    {
      "id": 568772,
      "primary_message": "Cut each quesadilla into wedges.",
      "secondary_message": null
    },
    {
      "id": 568773,
      "primary_message": "Divide quesadillas and mixed greens between plates. Top greens with avocado, then drizzle with dressing. Serve with tomato sauce for dipping and enjoy!",
      "secondary_message": "2 tbsp Italian salad dressing"
    }
  ],
