  "instructions": [
    {
      "id": 568810,
      "primary_message": "Place tomato sauce and spices in a medium saucepan. Stir to combine and bring to a simmer over medium heat. Once simmering, remove from heat and cover to keep warm. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 568811,
      "primary_message": "Meanwhile, drain olives. ",
      "secondary_message": "3 (108 g) cans sliced black olives"
    },
    {
      "id": 568812,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 568813,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide mushrooms, olives, and cheese between them, arranging on one half of each tortilla. Season with spices, then fold in half to close.",
      "secondary_message": "6 large flour tortillas\n3 (227g ) pkgs sliced white mushrooms\n2 cups shredded cheese, Italian blend\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 568814,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add quesadillas and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 568815,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed).",
      "secondary_message": "1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 568816,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and medium dice. Set aside. ",
      "secondary_message": "1 ½ avocados"
    },
    {
      "id": 568817,
      "primary_message": "Cut each quesadilla into wedges.",
      "secondary_message": null
    },
    {
      "id": 568818,
      "primary_message": "Divide quesadillas and mixed greens between plates. Top greens with avocado, then drizzle with dressing. Serve with tomato sauce for dipping and enjoy!",
      "secondary_message": "⅓ cup Italian salad dressing"
    }
  ],
