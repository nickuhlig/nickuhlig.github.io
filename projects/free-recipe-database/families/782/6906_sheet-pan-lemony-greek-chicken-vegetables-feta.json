  "instructions": [
    {
      "id": 100108,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 100109,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 small pkg grape tomatoes\n1 orange bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 100110,
      "primary_message": "Zest the lemon into a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 100111,
      "primary_message": "Juice the lemon into a medium bowl. Peel and mince garlic and add to the same bowl. Add oil and spices and whisk to combine to make the marinade.",
      "secondary_message": "4 cloves garlic\n¼ cup extra virgin olive oil\n1 ½ tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 100112,
      "primary_message": "Chop the bell pepper into 1-inch pieces. Peel and chop the onion into 1-inch pieces. Transfer both to the baking sheet along with the tomatoes.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 100113,
      "primary_message": "Pour about half of the marinade over the vegetables and stir to coat. Place in the oven while you prepare the chicken, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 100114,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place the chicken in the bowl with the remaining marinade and gently toss until evenly coated.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 100115,
      "primary_message": "Remove the vegetables from the oven and stir well. Push the vegetables to each side and lay the chicken flat in the center of the pan. Return to the oven and bake for 14 minutes or until chicken is cooked through. Change setting to broil and cook for another 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 100116,
      "primary_message": "While chicken is cooking, halve olives and set aside.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 100117,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 100118,
      "primary_message": "Remove the baking sheet from the oven and sprinkle the vegetables with olives, lemon zest, parsley, and feta.",
      "secondary_message": "¼ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 100119,
      "primary_message": "To serve, divide the chicken and vegetables between plates and enjoy!",
      "secondary_message": null
    }
  ],
