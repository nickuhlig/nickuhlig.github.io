  "instructions": [
    {
      "id": 382681,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 382682,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 382683,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 382684,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 382685,
      "primary_message": "While the skillet heats up, wash, dry, trim, and seed bell pepper; slice lengthwise into thin strips.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 382686,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add curry paste and salt; cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "2 tsp virgin coconut oil\n2 tbsp Thai curry paste, green\n¼ tsp salt"
    },
    {
      "id": 382687,
      "primary_message": "Add bell pepper, broccoli, coconut milk, and broth to the skillet. Stir to combine and bring to a simmer over medium-high heat. Once the curry is simmering, reduce heat to medium and cook until veggies start to soften, about 5 minutes.",
      "secondary_message": "½ (18 oz) bag broccoli florets\n½ (13.5 fl oz) can coconut milk\n4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 382688,
      "primary_message": "Meanwhile, wash, dry, and cut lime into wedges. Set aside for serving.",
      "secondary_message": "½ lime"
    },
    {
      "id": 382689,
      "primary_message": "Medium dice tofu.",
      "secondary_message": null
    },
    {
      "id": 382690,
      "primary_message": "When the veggies are softened, add tofu to the skillet. Continue to cook until veggies are tender and tofu is warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 382691,
      "primary_message": "Divide rice and curry between plates or bowls; serve with lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
