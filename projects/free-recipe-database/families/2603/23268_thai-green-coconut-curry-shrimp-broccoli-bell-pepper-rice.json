  "instructions": [
    {
      "id": 382670,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 382671,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 382672,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ limes"
    },
    {
      "id": 382673,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 382674,
      "primary_message": "Trim and seed bell peppers; slice lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 382675,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 382676,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add curry paste and salt; cook, stirring constantly, until fragrant, 1-2 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n⅓ cup Thai curry paste, green\n¾ tsp salt"
    },
    {
      "id": 382677,
      "primary_message": "Add bell pepper, broccoli, coconut milk, and broth to the pot. Stir to combine and bring to a simmer over medium-high heat. Once the curry is simmering, reduce heat to medium and cook until veggies start to soften, about 5 minutes.",
      "secondary_message": "1 ½ (18 oz) bags broccoli florets\n1 ½ (13.5 fl oz) cans coconut milk\n12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 382678,
      "primary_message": "Meanwhile, cut limes into wedges. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 382679,
      "primary_message": "When the veggies are softened, add shrimp to the pot. Continue to cook until veggies are tender and shrimp are cooked through, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 382680,
      "primary_message": "Divide rice and curry between plates or bowls; serve with lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
