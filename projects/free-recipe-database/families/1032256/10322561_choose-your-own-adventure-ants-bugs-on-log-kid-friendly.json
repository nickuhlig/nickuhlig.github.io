  "instructions": [
    {
      "primary_message": "Place peanut butter, cheese spread, and cream cheese each in their own small bowls. Set aside. \n\n",
      "secondary_message": "2 tbsp peanut butter, creamy\n2 tbsp cheddar cheese spread\n2 tbsp whipped cream cheese spread"
    },
    {
      "primary_message": "Place raisins, dried cranberries, sunflower seeds, and pistachios on a plate, keeping them separate. Set the \"ants\" and \"bugs\" aside. \n\n",
      "secondary_message": "1 tbsp raisins\n1 tbsp dried cranberries\n1 tbsp sunflower seeds\n1 tbsp pistachios, unsalted"
    },
    {
      "primary_message": "Wash, dry, trim, and cut celery crosswise into 3-inch long sticks. Divide \"logs\" between four additional plates.\n\n",
      "secondary_message": "4 stick celery"
    },
    {
      "primary_message": "Fill logs with your choice of spread, then mix and match the ants and bugs to line up on top. Show off your creations and enjoy!",
      "secondary_message": null
    }
  ],
