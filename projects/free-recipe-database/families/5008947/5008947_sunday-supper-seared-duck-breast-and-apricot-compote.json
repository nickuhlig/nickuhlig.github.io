  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pit and coarsely chop the apricots.",
      "secondary_message": "4 apricots"
    },
    {
      "id": 1,
      "primary_message": "Score fat side of duck breasts with a sharp knife until it almost reaches the meat. Season duck with a good amount of salt and a sprinkle of pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine apricots, pineapple juice, and brown sugar in small sauce pan and bring to a gentle simmer over medium heat, and cook for 6 minutes, or until apricots are soft and thick.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat skillet large enough to hold both breasts over high heat, add breasts skin side down, and cook until skin is deep golden brown and much of the fat is rendered, about 5 minutes. Flip duck breasts and cook to until medium rare (130°F or 40°C internal temperature), about another 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Allow duck to rest before slicing and serve with a big dollop of apricot compote.",
      "secondary_message": null
    }
  ],
