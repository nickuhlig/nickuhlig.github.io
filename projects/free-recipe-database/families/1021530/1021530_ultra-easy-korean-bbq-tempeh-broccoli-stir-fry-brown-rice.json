  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli, salt, and pepper, then stir-fry until fork-tender, 4-5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n½ (18 oz) bag broccoli florets\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, place rice pouch in the microwave, seam-side up. Heat on high for 3-4 minutes (until pouch balloons up with steam for 30 seconds). Allow steam to vent before opening pouch. (Alternatively, rice can be heated in a saucepan according to package instructions.)",
      "secondary_message": "1 (10 oz) pouch frozen brown rice, pre-cooked"
    },
    {
      "primary_message": "When the broccoli is done, crumble tempeh into the skillet with your fingers. Add stir-fry sauce and water, stir to combine, and continue to cook until warmed through, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 (8 oz) pkg tempeh\n⅓ cup stir-fry sauce"
    },
    {
      "primary_message": "To serve, divide rice, tempeh stir-fry, and sauce between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
