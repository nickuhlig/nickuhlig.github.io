  "instructions": [
    {
      "id": 420764,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 420765,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "8 caps portobello mushrooms\n1 (5 oz) pkg baby spinach\n1 (6 oz) pkg blueberries"
    },
    {
      "id": 420766,
      "primary_message": "Remove stems from portobello mushrooms and carefully scrape out the gills. Transfer to a baking sheet pan, rub with oil, and season with spices on both sides; arrange cap-side up.",
      "secondary_message": "8 caps portobello mushrooms\n2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 420767,
      "primary_message": "Place mushrooms in the oven and broil until starting to soften, about 6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 420768,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420769,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based"
    },
    {
      "id": 420770,
      "primary_message": "When the veggie ground is done, add barbecue sauce, stir to combine, and remove from heat.",
      "secondary_message": "⅔ cup barbecue sauce"
    },
    {
      "id": 420771,
      "primary_message": "Using tongs, carefully flip the mushrooms, cap-side down. Fill with BBQ veggie ground and top with cheese.",
      "secondary_message": "1 cup shredded cheese, Italian blend"
    },
    {
      "id": 420772,
      "primary_message": "Return baking sheet to the oven and continue to broil until the mushrooms are soft and cheese is melted, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 420773,
      "primary_message": "Meanwhile, place spinach, blueberries, and dressing in a medium bowl. Toss to combine the salad.",
      "secondary_message": "¼ cup honey mustard dressing"
    },
    {
      "id": 420774,
      "primary_message": "To serve, divide stuffed mushrooms and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
