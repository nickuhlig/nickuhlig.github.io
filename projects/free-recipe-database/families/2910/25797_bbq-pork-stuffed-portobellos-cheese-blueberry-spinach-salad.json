  "instructions": [
    {
      "id": 420808,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 420809,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "12 caps portobello mushrooms\n1 ½ (142 g) pkgs baby spinach\n1 ½ (170 g) pkgs blueberries"
    },
    {
      "id": 420810,
      "primary_message": "Remove stems from portobello mushrooms and carefully scrape out the gills. Transfer to a large baking sheet pan, rub with oil, and season with spices on both sides; arrange cap-side up.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 420811,
      "primary_message": "Place mushrooms in the oven and broil until starting to soften, 6-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 420812,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 420813,
      "primary_message": "Once the skillet is hot, add pork and cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1.02 kg lean ground pork"
    },
    {
      "id": 420814,
      "primary_message": "When the pork is done, add barbecue sauce, stir to combine, and remove from heat.",
      "secondary_message": "1 cup barbecue sauce"
    },
    {
      "id": 420815,
      "primary_message": "Using tongs, carefully flip the mushrooms, cap-side down. Fill with BBQ pork and top with cheese.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 420816,
      "primary_message": "Return baking sheet to the oven and continue to broil until the mushrooms are soft and cheese is melted, 4-5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 420817,
      "primary_message": "Meanwhile, place spinach, blueberries, and dressing in a large bowl. Toss to combine the salad.",
      "secondary_message": "⅓ cup honey mustard dressing"
    },
    {
      "id": 420818,
      "primary_message": "To serve, divide stuffed mushrooms and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
