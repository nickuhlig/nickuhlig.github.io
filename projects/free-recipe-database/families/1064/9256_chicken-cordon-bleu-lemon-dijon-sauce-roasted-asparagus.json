  "instructions": [
    {
      "id": 147715,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 147716,
      "primary_message": "Wash, dry, and snap or cut off the woody ends of the asparagus. Divide between two baking sheet pans, drizzle with oil, and season with salt and pepper. ",
      "secondary_message": "3 small bunches asparagus\n3 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 147717,
      "primary_message": "Place baking sheets in the bottom half of the oven and bake until tender-crisp, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 147718,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 147719,
      "primary_message": "Preheat broiler on high, leaving the asparagus in the bottom of the oven until it is finished cooking.",
      "secondary_message": null
    },
    {
      "id": 147720,
      "primary_message": "Wash and juice the lemons into a small bowl. Add broth and Dijon; whisk until smooth.",
      "secondary_message": "1 ½ lemons\n355 ml chicken or vegetable broth\n2 tbsp Dijon mustard"
    },
    {
      "id": 147721,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 147722,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 147723,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 147724,
      "primary_message": "Cooking in batches if necessary, add cutlets to the skillet and cook until lightly golden, about 2 minutes per side. Remove to a plate.",
      "secondary_message": null
    },
    {
      "id": 147725,
      "primary_message": "Meanwhile, slice the cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 147726,
      "primary_message": "Add garlic to the skillet and cook until fragrant, about 30 seconds. Add broth mixture and whisk, scraping up the browned bits, until mixture thickens slightly, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 147727,
      "primary_message": "Transfer the sauce into a large baking dish and lay cutlets on top. Place two slices of prosciutto on each cutlet and top with cheese. Place dish in the oven and broil until cheese is melted and golden and chicken is cooked through, 3-5 minutes. ",
      "secondary_message": "24 slices prosciutto"
    },
    {
      "id": 147728,
      "primary_message": "To serve, divide chicken cutlets, sauce, and asparagus between plates. Enjoy!",
      "secondary_message": null
    }
  ],
