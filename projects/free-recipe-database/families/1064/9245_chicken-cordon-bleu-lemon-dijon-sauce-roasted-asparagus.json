  "instructions": [
    {
      "id": 147555,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 147556,
      "primary_message": "Wash, dry, and snap or cut off the woody ends of the asparagus. Place on a baking sheet pan, drizzle with oil, and season with salt and pepper. ",
      "secondary_message": "1 small bunch asparagus\n1 tbsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 147557,
      "primary_message": "Place baking sheet in the bottom half of the oven and bake until tender-crisp, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 147558,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 147559,
      "primary_message": "Preheat broiler on high, leaving the asparagus in the bottom of the oven until it is finished cooking.",
      "secondary_message": null
    },
    {
      "id": 147560,
      "primary_message": "Place flour in a shallow dish; lightly dredge the chicken in the flour, shake off excess, and place on a plate.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 147561,
      "primary_message": "Wash and juice the lemon into a small bowl. Add broth, Dijon, and flour; whisk until smooth.",
      "secondary_message": "½ lemon\n4 fl oz (½ cup) chicken or vegetable broth\n2 tsp Dijon mustard\n1 tsp all-purpose flour"
    },
    {
      "id": 147562,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 147563,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 147564,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 147565,
      "primary_message": "Add breaded cutlets to the skillet and cook until lightly golden, about 2 minutes per side. Remove to a plate.",
      "secondary_message": null
    },
    {
      "id": 147566,
      "primary_message": "Meanwhile, slice the cheese.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 147567,
      "primary_message": "Add garlic to the skillet and cook until fragrant, about 30 seconds. Add broth mixture and whisk, scraping up the browned bits, until mixture thickens slightly, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 147568,
      "primary_message": "Return the cutlets to the skillet. Place two slices of prosciutto on each cutlet and top with cheese. Place skillet in the oven and broil until cheese is melted and golden and chicken is cooked through, about 3 minutes.",
      "secondary_message": "8 slices prosciutto"
    },
    {
      "id": 147569,
      "primary_message": "To serve, divide chicken cutlets, sauce, and asparagus between plates. Enjoy!",
      "secondary_message": null
    }
  ],
