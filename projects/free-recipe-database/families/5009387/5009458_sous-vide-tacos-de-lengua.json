  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Split the onion in half. Split the roma tomato in half.",
      "secondary_message": "1 medium onion\n1 roma tomato"
    },
    {
      "id": 1,
      "primary_message": "Season tongue with salt and pepper and place in vacuum bag with cilantro, onion, tomato, and fat. Cook at 77°C until completely tender, at least 24 hours, and up to 48. Place bag in ice bath and cool completely, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Open bag carefully and pour contents into large wire-mesh strainer set over bowl. Transfer tongue to cutting board and discard remaining solids. Carefully peel outer membrane off of tongue and discard. Chop tongue into 1.5-cm pieces.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine chipoles, adobo sauce, and half of liquid from tongue in blender and blend until smooth. Season to taste with lime juice and salt. Set aside. Combine tongue and remaining liquid in heavy-bottomed 10 or 30-cm skillet. Bring to a simmer over high heat, reduce to medium and cook, stirring frequently, until liquid is reduced and tongue has started to crisp, about 8 minutes. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To serve, wrap a scoop of tongue in a double layer of corn tortillas. Top with chipotle sauce and diced onions, scallions, or cilantro as desired. Pass additional lime wedges.",
      "secondary_message": null
    }
  ],
