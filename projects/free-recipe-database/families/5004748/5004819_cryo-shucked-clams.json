  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Rinse the littleneck clams.",
      "secondary_message": "50 littleneck clams"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, combine water and salt and stir until salt is dissolved. Transfer one-third of brine to another large bowl and add clams. Set clams in refrigerator and let soak for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drain clams, then rinse clams and bowl. Return clams to bowl, add half of remaining brine and transfer to refrigerator to soak for 30 more minutes. Drain and repeat once more with remaining brine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Arrange clams in a single layer on a rimmed baking sheet and freeze overnight or up to 1 week, wrapping with plastic wrap once clams are frozen solid.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When ready to shuck, transfer clams to refrigerator to thaw; the clams will pop open as they thaw. Using a spoon, pry open clam shells fully and scoop them into a bowl set over another bowl filled with ice; be sure to catch all of the clam juice in the bowl as you shuck the clams. Pour any extra clam liquid in the baking sheet into the bowl of clams.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Using a pair of scissors, trim around the belly and foot sections (the soft, round center area and firm adjacent meat) of each clam. Transfer belly (also known as the visceral mass) and foot to a small bowl, cover with plastic, and refrigerate until ready to use. Add trimmings to the bowl of clam juice; cover and refrigerate until ready to use.",
      "secondary_message": null
    }
  ],
