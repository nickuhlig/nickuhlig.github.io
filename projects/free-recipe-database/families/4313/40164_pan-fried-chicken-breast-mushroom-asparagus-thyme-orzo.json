  "instructions": [
    {
      "id": 622611,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb white mushrooms\n½ small bunch asparagus\n½ small pkg fresh thyme"
    },
    {
      "id": 622612,
      "primary_message": "Quarter mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622613,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 622614,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622615,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622616,
      "primary_message": "While the pan heats up, peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 622617,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, thyme, and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 622618,
      "primary_message": "Add broth, orzo, and Worcestershire to the pan; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n5 oz orzo pasta\n2 tsp Worcestershire sauce"
    },
    {
      "id": 622619,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622620,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season both sides with spices.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 622621,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 622622,
      "primary_message": "To serve, divide chicken and orzo between plates. Enjoy!",
      "secondary_message": null
    }
  ],
