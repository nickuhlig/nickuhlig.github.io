  "instructions": [
    {
      "id": 622748,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 622749,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg white mushrooms\n1 ½ small bunches asparagus\n1 small pkg fresh thyme"
    },
    {
      "id": 622750,
      "primary_message": "Quarter mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622751,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 622752,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622753,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622754,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 622755,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, thyme, and spices; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 622756,
      "primary_message": "Add broth, orzo, and soy sauce to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n425 g orzo pasta\n2 tbsp soy sauce"
    },
    {
      "id": 622757,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622758,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise. Place on a plate, then sprinkle both sides with cornstarch and spices.",
      "secondary_message": "3 tbsp cornstarch\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 622759,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and pan-fry until golden brown and warmed through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 622760,
      "primary_message": "To serve, divide tofu and orzo between plates. Enjoy!",
      "secondary_message": null
    }
  ],
