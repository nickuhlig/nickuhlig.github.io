  "instructions": [
    {
      "id": 622635,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb white mushrooms\n1 ½ small bunches asparagus\n1 small pkg fresh thyme"
    },
    {
      "id": 622636,
      "primary_message": "Quarter mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622637,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 622638,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622639,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622640,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 622641,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, thyme, and spices; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 622642,
      "primary_message": "Add broth, orzo, and Worcestershire to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n15 oz orzo pasta\n2 tbsp Worcestershire sauce"
    },
    {
      "id": 622643,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622644,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season both sides with spices.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 622645,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 622646,
      "primary_message": "To serve, divide chicken and orzo between plates. Enjoy!",
      "secondary_message": null
    }
  ],
