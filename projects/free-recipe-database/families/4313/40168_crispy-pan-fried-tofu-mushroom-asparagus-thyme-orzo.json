  "instructions": [
    {
      "id": 622660,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 622661,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb white mushrooms\n1 small bunch asparagus\n1 small pkg fresh thyme"
    },
    {
      "id": 622662,
      "primary_message": "Quarter mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622663,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 622664,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622665,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622666,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 622667,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, thyme, and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 622668,
      "primary_message": "Add broth, orzo, and soy sauce to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n10 oz orzo pasta\n4 tsp soy sauce"
    },
    {
      "id": 622669,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622670,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise. Place on a plate, then sprinkle both sides with cornstarch and spices.",
      "secondary_message": "2 tbsp cornstarch\n½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 622671,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry until golden brown and warmed through, 3-4 minutes per side. Transfer to a clean plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 622672,
      "primary_message": "To serve, divide tofu and orzo between plates. Enjoy!",
      "secondary_message": null
    }
  ],
