  "instructions": [
    {
      "id": 622698,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg white mushrooms\n1 small bunch asparagus\n1 small pkg fresh thyme"
    },
    {
      "id": 622699,
      "primary_message": "Quarter mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622700,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Add to the bowl with the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 622701,
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Add leaves to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622702,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622703,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion. Add to the bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 622704,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, thyme, and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 622705,
      "primary_message": "Add broth, orzo, and Worcestershire to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n283 g orzo pasta\n4 tsp Worcestershire sauce"
    },
    {
      "id": 622706,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 622707,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season both sides with spices.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 622708,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 622709,
      "primary_message": "To serve, divide chicken and orzo between plates. Enjoy!",
      "secondary_message": null
    }
  ],
