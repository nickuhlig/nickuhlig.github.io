  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "1 cup unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 175°C (350°F). Grease or line two baking sheets.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together cocoa powder, flour, salt, and chili powder.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat together butter and sugar until light and fluffy, about 4 minutes. Mix in eggs and beat for another minute. Beat in flour mixture and continue to beat until dough has become smooth and cohesive, about two minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Split dough in two equal parts. Roll each half into a 4 cm wide log. Wrap each log in plastic wrap. Let dough chill in refrigerator for 1 hour.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cut dough logs into 1.5-cm thick coins. Arrange coins on baking sheets. Bake until evenly lightened in color but still chewy in texture, about 16 minutes. Let cookies cool before dusting with confectioners sugar and extra ancho chili powder, if desired.",
      "secondary_message": null
    }
  ],
