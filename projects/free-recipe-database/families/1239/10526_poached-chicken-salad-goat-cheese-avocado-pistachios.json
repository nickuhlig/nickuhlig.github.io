  "instructions": [
    {
      "id": 182460,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 182461,
      "primary_message": "Place chicken, salt, and pepper in a large pot and cover with water by 1-inch; bring to a boil. Reduce heat and simmer until chicken is cooked through, 8-10 minutes. Transfer chicken to a plate to cool.",
      "secondary_message": "1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 182462,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 sticks celery\n2 lemons\n2 (142 g) pkg spring mix (mixed greens)\n1 avocado"
    },
    {
      "id": 182463,
      "primary_message": "Using a clean cutting board trim and medium dice celery; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 182464,
      "primary_message": "Zest lemons into the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 182465,
      "primary_message": "Roughly chop pistachios; add to the bowl along with yogurt and spices. Stir to combine and set aside.",
      "secondary_message": "¼ cup pistachios, unsalted\n1 cup plain Greek yogurt\n½ tsp thyme\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 182466,
      "primary_message": "Juice the lemons into a large bowl. Add oil and whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 182467,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 182468,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 182469,
      "primary_message": "Using two forks, shred chicken and add to the bowl with the yogurt mixture. Mix well to combine.",
      "secondary_message": null
    },
    {
      "id": 182470,
      "primary_message": "To serve, place salad greens on a plate and top with chicken salad, sliced avocado, and crumbled goat cheese. Enjoy!",
      "secondary_message": "1 (113 g) log goat cheese"
    }
  ],
