  "instructions": [
    {
      "id": 405106,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 sticks celery\n1 small bunch Italian (flat-leaf) parsley\n1 ½ pints grape tomatoes\n1 ½ yellow bell peppers\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 405107,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 405108,
      "primary_message": "Peel and mince garlic; place in a small bowl along with oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n½ cup extra virgin olive oil\n⅓ cup white wine vinegar\n2 tbsp Dijon mustard\n1 tbsp honey\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp oregano, dried\n¾ tsp onion powder"
    },
    {
      "id": 405109,
      "primary_message": "Peel, halve, and slice shallots into thin half-moons; place in a medium bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 405110,
      "primary_message": "Trim celery and cut crosswise into thin pieces; add to the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 405111,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 405112,
      "primary_message": "Mince sun-dried tomatoes; add to the bowl along with the chickpeas, half the dressing (reserving the rest for serving), salt, and crushed red pepper. Stir to combine and set aside to marinate.",
      "secondary_message": "6 sun-dried tomatoes, oil-packed\n½ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 405113,
      "primary_message": "Meanwhile, halve tomatoes and place on a platter.",
      "secondary_message": null
    },
    {
      "id": 405114,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the platter with the tomatoes, keeping them separate.",
      "secondary_message": null
    },
    {
      "id": 405115,
      "primary_message": "Medium dice mozzarella and add to the platter.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 405116,
      "primary_message": "Cut or tear each slice of prosciutto into 3 pieces; roll each piece and add to the platter.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 405117,
      "primary_message": "Add artichokes and olives to the platter. ",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated\n1 cup Kalamata olives, pitted"
    },
    {
      "id": 405118,
      "primary_message": "To serve, divide mixed greens between plates or bowls. Place a scoop of marinated chickpeas in the center of the greens, then surround with tomatoes, bell pepper, mozzarella, prosciutto, artichokes, and olives. Drizzle with reserved dressing and enjoy!",
      "secondary_message": null
    }
  ],
