  "instructions": [
    {
      "id": 405282,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 sticks celery\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg grape tomatoes\n1 yellow bell pepper\n2 medium carrots\n2 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 405283,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 405284,
      "primary_message": "Peel and mince garlic; place in a small bowl along with oil, vinegar, Dijon, honey, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 cloves garlic\n⅓ cup extra virgin olive oil\n¼ cup white wine vinegar\n4 tsp Dijon mustard\n2 tsp honey\n1 tsp salt\n½ tsp black pepper\n½ tsp oregano, dried\n½ tsp onion powder"
    },
    {
      "id": 405285,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; place in a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 405286,
      "primary_message": "Trim celery and cut crosswise into thin pieces; add to the bowl with the shallot.",
      "secondary_message": null
    },
    {
      "id": 405287,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 405288,
      "primary_message": "Mince sun-dried tomatoes; add to the bowl along with the chickpeas, half the dressing (reserving the rest for serving), salt, and crushed red pepper. Stir to combine and set aside to marinate.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 405289,
      "primary_message": "Meanwhile, halve tomatoes and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 405290,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the plate with the tomatoes, keeping them separate.",
      "secondary_message": null
    },
    {
      "id": 405291,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the plate.",
      "secondary_message": null
    },
    {
      "id": 405292,
      "primary_message": "Medium dice mozzarella and add to the plate.",
      "secondary_message": "⅔ (227 g) block mozzarella cheese"
    },
    {
      "id": 405293,
      "primary_message": "Add artichokes and olives to the plate.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated\n⅔ cup Kalamata olives, pitted"
    },
    {
      "id": 405294,
      "primary_message": "To serve, divide mixed greens between plates or bowls. Place a scoop of marinated chickpeas in the center of the greens, then surround with tomatoes, bell pepper, carrot, mozzarella, artichokes, and olives. Drizzle with reserved dressing and enjoy!",
      "secondary_message": null
    }
  ],
