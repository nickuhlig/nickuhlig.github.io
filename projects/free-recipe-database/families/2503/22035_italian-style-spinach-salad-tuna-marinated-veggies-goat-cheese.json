  "instructions": [
    {
      "id": 369708,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small bunch fresh dill\n3 avocados\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 369709,
      "primary_message": "Drain tuna, place in a large bowl, and flake with a fork.",
      "secondary_message": "6 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 369710,
      "primary_message": "Drain and thinly slice artichokes. Add to the bowl with the tuna.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 369711,
      "primary_message": "Drain and small dice peppers. Add to the bowl.",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers"
    },
    {
      "id": 369712,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369713,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369714,
      "primary_message": "Add almonds and dressing to the bowl. Stir to combine the tuna salad.",
      "secondary_message": "1 cup almonds, sliced\n½ cup Italian salad dressing"
    },
    {
      "id": 369715,
      "primary_message": "To serve, divide spinach and tuna salad between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    }
  ],
