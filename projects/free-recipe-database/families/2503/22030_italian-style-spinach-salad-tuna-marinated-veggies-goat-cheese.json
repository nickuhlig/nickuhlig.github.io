  "instructions": [
    {
      "id": 369668,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small bunch fresh dill\n1 avocado\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 369669,
      "primary_message": "Drain tuna, place in a medium bowl, and flake with a fork.",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 369670,
      "primary_message": "Drain and thinly slice artichokes. Add to the bowl with the tuna.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 369671,
      "primary_message": "Drain and small dice peppers. Add to the bowl.",
      "secondary_message": "½ (12 oz) jar roasted red bell peppers"
    },
    {
      "id": 369672,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369673,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 369674,
      "primary_message": "Add almonds and dressing to the bowl. Stir to combine the tuna salad.",
      "secondary_message": "⅓ cup almonds, sliced\n3 tbsp Italian salad dressing"
    },
    {
      "id": 369675,
      "primary_message": "To serve, divide spinach and tuna salad between plates or bowls. Crumble goat cheese over top and enjoy!",
      "secondary_message": "½ (4 oz) log goat cheese"
    }
  ],
