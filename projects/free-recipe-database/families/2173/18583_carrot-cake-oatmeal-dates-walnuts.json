  "instructions": [
    {
      "id": 304357,
      "primary_message": "Wash, dry, trim, and peel carrots; coarsely grate.",
      "secondary_message": "6 medium carrots"
    },
    {
      "id": 304358,
      "primary_message": "Place water and salt in a large pot, cover, and bring to a boil over high heat. ",
      "secondary_message": "42 fl oz (5 ¼ cups) water\n3 pinch salt"
    },
    {
      "id": 304359,
      "primary_message": "Meanwhile, roughly chop dates.",
      "secondary_message": "¾ cup medjool dates, pitted"
    },
    {
      "id": 304360,
      "primary_message": "Once the water is boiling, stir in carrots, dates, oats, and spices. Reduce heat to low, cover, and let simmer, stirring occasionally, until oatmeal reaches desired consistency, 3-5 minutes.",
      "secondary_message": "3 cup oats, quick cooking\n1 ½ tsp cinnamon, ground\n½ tsp cloves, ground\n¼ tsp nutmeg, ground"
    },
    {
      "id": 304361,
      "primary_message": "While the oatmeal cooks, roughly chop walnuts.",
      "secondary_message": "1 cup walnuts"
    },
    {
      "id": 304362,
      "primary_message": "Divide oatmeal between bowls; top with walnuts and sprinkle with sugar. Serve with milk and enjoy!",
      "secondary_message": "2 tbsp brown sugar\n12 fl oz (1 ½ cups) whole milk"
    }
  ],
