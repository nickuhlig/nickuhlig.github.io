  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium and 4 mini food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place oil, vinegar, maple syrup, Dijon, salt, and pepper in a small bowl, then whisk to combine the dressing. Divide between mini containers, cover, and set aside.\n\n",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n1 ¼ tsp pure maple syrup\n¾ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "1 (16 oz) pkg strawberries\n1 (6 oz) pkg raspberries\n1 (6 oz) pkg blueberries\n¼ small pkg fresh basil"
    },
    {
      "primary_message": "Trim and quarter strawberries lengthwise. Place in a medium bowl along with raspberries and blueberries.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Tear mozzarella balls in half (or halve using a knife) and add to the bowl with the berries. Gently stir to combine the salad, then divide between the medium containers. \n\n",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella balls (ciliegine or \"cherry size\")"
    },
    {
      "primary_message": "Divide basil sprigs between containers with the salad, then cover and refrigerate along with the dressing.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, tear basil into bite-sized pieces, drizzle salad with dressing, and gently stir to combine. Enjoy!",
      "secondary_message": null
    }
  ],
