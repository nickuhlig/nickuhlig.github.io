  "instructions": [
    {
      "id": 91310,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 peaches\n1 ½ small pkgs fresh mint\n3 English cucumbers\n3 limes"
    },
    {
      "id": 91311,
      "primary_message": "Grate the zest from the limes, juice the limes; add both to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 91312,
      "primary_message": "Peel and grate the fresh ginger and add to the bowl.",
      "secondary_message": "1 ½ (2 ½ cm) pieces ginger root"
    },
    {
      "id": 91313,
      "primary_message": "Add fish sauce, maple syrup, chili-garlic sauce, salt, and pepper to the bowl. Whisk the dressing together and pour half of it into a salad bowl and put to the side.",
      "secondary_message": "3 tbsp fish sauce\n3 tbsp pure maple syrup\n1 ½ tsp chili-garlic sauce\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 91314,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 91315,
      "primary_message": "Add chicken to the large bowl containing half the sauce and toss to coat.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 91316,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook until browned and cooked through (about 4-6 minutes per side). Discard any remaining marinade.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 91317,
      "primary_message": "To the remaining dressing (in the salad bowl) add salt, water, and olive oil and whisk together.",
      "secondary_message": "3 pinch salt\n3 tbsp extra virgin olive oil\n3 tbsp water"
    },
    {
      "id": 91318,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove the pit; cut each quarter lengthwise into thin wedges and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 91319,
      "primary_message": "Trim the ends of the cucumber, halve lengthwise, and thinly slice into half rounds, and add to salad bowl.",
      "secondary_message": null
    },
    {
      "id": 91320,
      "primary_message": "Pick the mint leaves off the stems; discard the stems and tear the leaves into small pieces. Roughly chop the peanuts. Add everything to salad bowl with dressing and toss to coat.",
      "secondary_message": "1 ½ small pkgs fresh mint\n¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 91321,
      "primary_message": "To serve, divide the chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
