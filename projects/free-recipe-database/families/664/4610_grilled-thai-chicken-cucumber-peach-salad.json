  "instructions": [
    {
      "id": 91298,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 peaches\n1 small pkg fresh mint\n2 English cucumbers\n2 limes"
    },
    {
      "id": 91299,
      "primary_message": "Grate the zest from the limes, juice the limes; add both to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 91300,
      "primary_message": "Peel and grate the fresh ginger and add to the medium bowl.",
      "secondary_message": "1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 91301,
      "primary_message": "Add fish sauce, maple syrup, chili-garlic sauce, salt, and pepper to the medium bowl. Whisk the dressing together and pour half of it into a salad bowl and put to the side.",
      "secondary_message": "2 tbsp fish sauce\n2 tbsp pure maple syrup\n1 tsp chili-garlic sauce\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 91302,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 91303,
      "primary_message": "Add chicken to the medium bowl containing half the sauce and toss to coat.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 91304,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook until browned and cooked through (about 4-6 minutes per side). Discard any remaining marinade.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 91305,
      "primary_message": "To the remaining dressing (in the salad bowl) add salt, water, and olive oil and whisk together.",
      "secondary_message": "⅛ tsp salt\n2 tbsp extra virgin olive oil\n2 tbsp water"
    },
    {
      "id": 91306,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove the pit; cut each quarter lengthwise into thin wedges and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 91307,
      "primary_message": "Trim the ends of the cucumber, halve lengthwise, and thinly slice into half rounds, and add to salad bowl.",
      "secondary_message": null
    },
    {
      "id": 91308,
      "primary_message": "Pick the mint leaves off the stems; discard the stems and tear the leaves into small pieces. Roughly chop the peanuts. Add everything to salad bowl with dressing and toss to coat.",
      "secondary_message": "1 small pkg fresh mint\n½ cup peanuts, roasted unsalted"
    },
    {
      "id": 91309,
      "primary_message": "To serve, divide the chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
