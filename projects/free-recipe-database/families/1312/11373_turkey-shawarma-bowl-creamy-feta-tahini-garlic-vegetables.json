  "instructions": [
    {
      "id": 334430,
      "primary_message": "Preheat oven to 400°F. Line two baking sheet pans with parchment paper (optional). ",
      "secondary_message": null
    },
    {
      "id": 334431,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 medium zucchini squash\n1 ½ pints grape tomatoes\n1 small pkg fresh mint\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 334432,
      "primary_message": "Juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 334433,
      "primary_message": "Peel and mince garlic. Add to the bowl along with tahini, oil, salt, and pepper; whisk to combine the marinade.",
      "secondary_message": "6 cloves garlic\n3 tbsp tahini\n1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 334434,
      "primary_message": "Trim and thinly slice zucchini into rounds and add to the bowl with the marinade. ",
      "secondary_message": null
    },
    {
      "id": 334435,
      "primary_message": "Peel, halve, and thinly slice onions into half moons. Halve tomatoes. Add both to the bowl and toss to coat. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 334436,
      "primary_message": "Divide veggies between baking sheets and spread out in a single layer. Place in the oven and roast until tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 334437,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334438,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the ground turkey and season with spices. Cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes. Cover with a lid and remove from heat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n2 ¼ lb ground turkey\n1 tbsp cumin, ground\n1 ½ tsp salt\n¾ tsp coriander, ground\n¾ tsp paprika\n¾ tsp turmeric, ground"
    },
    {
      "id": 334439,
      "primary_message": "Meanwhile, place feta and yogurt in a medium bowl; whisk to combine. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup plain Greek yogurt"
    },
    {
      "id": 334440,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Sprinkle over roasted veggies and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 334441,
      "primary_message": "Toast pita if desired, then cut into wedges.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 334442,
      "primary_message": "To serve, divide pita, arugula, turkey, and veggies between bowls. Top with creamy feta and enjoy!",
      "secondary_message": null
    }
  ],
