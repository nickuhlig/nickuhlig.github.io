  "instructions": [
    {
      "id": 334404,
      "primary_message": "Preheat oven to 400°F. Line a baking sheet pan with parchment paper (optional).",
      "secondary_message": null
    },
    {
      "id": 334405,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 medium zucchini squash\n½ pint grape tomatoes\n½ small pkg fresh mint\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 334406,
      "primary_message": "Juice lemon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 334407,
      "primary_message": "Peel and mince garlic. Add to the bowl along with tahini, oil, salt, and pepper; whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n1 tbsp tahini\n1 ½ tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 334408,
      "primary_message": "Trim and thinly slice zucchini into rounds and add to the bowl with the marinade. ",
      "secondary_message": null
    },
    {
      "id": 334409,
      "primary_message": "Peel, halve, and thinly slice onion into half moons. Halve tomatoes. Add both to the bowl and toss to coat. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 334410,
      "primary_message": "Transfer veggies to the baking sheet and spread out in a single layer. Place in the oven and roast until tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 334411,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334412,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the ground turkey and season with spices. Cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes. Cover with a lid and remove from heat. ",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¾ lb ground turkey\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp coriander, ground\n¼ tsp paprika\n¼ tsp turmeric, ground"
    },
    {
      "id": 334413,
      "primary_message": "Meanwhile, place feta and yogurt in a small bowl; whisk to combine. ",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese\n¼ cup plain Greek yogurt"
    },
    {
      "id": 334414,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Sprinkle over roasted veggies and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 334415,
      "primary_message": "Toast pita if desired, then cut into wedges.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 334416,
      "primary_message": "To serve, divide pita, arugula, turkey, and veggies between bowls. Top with creamy feta and enjoy!",
      "secondary_message": null
    }
  ],
