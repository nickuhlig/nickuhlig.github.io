  "instructions": [
    {
      "id": 334606,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 334607,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 medium zucchini squash\n1 small pkg grape tomatoes\n1 small pkg fresh mint\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 334608,
      "primary_message": "Juice lemon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 334609,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice along with tahini, oil, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "4 cloves garlic\n2 tbsp tahini\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 334610,
      "primary_message": "Trim and thinly slice zucchini into rounds; add to the bowl with the marinade. ",
      "secondary_message": null
    },
    {
      "id": 334611,
      "primary_message": "Halve tomatoes; peel, halve, and slice onion into thin half-moons. Add both to the bowl and toss to coat. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 334612,
      "primary_message": "Transfer vegetables to a large baking sheet pan and spread out in a single layer; place in the oven and roast until tender, tossing halfway through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 334613,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334614,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until browned and crumbly, about 5 minutes. Cover with a lid and remove from heat. ",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n2 tsp cumin, ground\n½ tsp salt\n½ tsp coriander, ground\n½ tsp paprika\n½ tsp turmeric, ground"
    },
    {
      "id": 334615,
      "primary_message": "Meanwhile, place feta and yogurt in a small bowl; stir to combine. ",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n½ cup plain Greek yogurt"
    },
    {
      "id": 334616,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Sprinkle over roasted vegetables and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 334617,
      "primary_message": "Toast pita if desired, then cut into wedges.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 334618,
      "primary_message": "To serve, divide pita, arugula, veggie ground, and vegetables between bowls. Top with creamy feta and enjoy!",
      "secondary_message": null
    }
  ],
