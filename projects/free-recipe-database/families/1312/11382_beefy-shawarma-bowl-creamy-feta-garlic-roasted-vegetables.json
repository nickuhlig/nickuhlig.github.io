  "instructions": [
    {
      "id": 334581,
      "primary_message": "Preheat oven to 205°C (400°F). ",
      "secondary_message": null
    },
    {
      "id": 334582,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 medium zucchini squash\n1 ½ small pkgs grape tomatoes\n1 small pkg fresh mint\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 334583,
      "primary_message": "Juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 334584,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil, salt, and pepper; whisk to combine the marinade.",
      "secondary_message": "6 cloves garlic\n1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 334585,
      "primary_message": "Trim and thinly slice zucchini into rounds and add to the bowl with the marinade. ",
      "secondary_message": null
    },
    {
      "id": 334586,
      "primary_message": "Peel, halve, and thinly slice onions into half moons. Halve tomatoes. Add both to the bowl and toss to coat. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 334587,
      "primary_message": "Divide veggies between two baking sheet pans and spread out in a single layer. Place in the oven and roast until tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 334588,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334589,
      "primary_message": "Once the skillet is hot, add the ground beef and season with spices. Cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes. Cover with a lid and remove from heat.",
      "secondary_message": "1.02 kg lean ground beef\n1 tbsp cumin, ground\n1 ½ tsp salt\n¾ tsp coriander, ground\n¾ tsp paprika\n¾ tsp turmeric, ground"
    },
    {
      "id": 334590,
      "primary_message": "Meanwhile, place feta and yogurt in a medium bowl; whisk to combine.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n¾ cup plain Greek yogurt"
    },
    {
      "id": 334591,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Sprinkle over roasted veggies and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 334592,
      "primary_message": "To serve, divide arugula, ground beef, and veggies between bowls. Top with creamy feta and enjoy! ",
      "secondary_message": null
    }
  ],
