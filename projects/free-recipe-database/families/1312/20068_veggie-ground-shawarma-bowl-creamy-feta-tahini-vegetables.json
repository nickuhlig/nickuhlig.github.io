  "instructions": [
    {
      "id": 334505,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 334506,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 medium zucchini squash\n1 ½ pints grape tomatoes\n1 small pkg fresh mint\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 334507,
      "primary_message": "Juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 334508,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon juice along with tahini, oil, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "6 cloves garlic\n3 tbsp tahini\n1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 334509,
      "primary_message": "Trim and thinly slice zucchini into rounds; add to the bowl with the marinade. ",
      "secondary_message": null
    },
    {
      "id": 334510,
      "primary_message": "Halve tomatoes; peel, halve, and slice onions into thin half-moons. Add both to the bowl and toss to coat. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 334511,
      "primary_message": "Divide vegetables between two baking sheet pans and spread out in a single layer; place in the oven and roast until tender, tossing halfway through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 334512,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334513,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Cover with a lid and remove from heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 tbsp cumin, ground\n¾ tsp salt\n¾ tsp coriander, ground\n¾ tsp paprika\n¾ tsp turmeric, ground"
    },
    {
      "id": 334514,
      "primary_message": "Meanwhile, place feta and yogurt in a medium bowl; stir to combine. ",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup plain Greek yogurt"
    },
    {
      "id": 334515,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Sprinkle over roasted vegetables and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 334516,
      "primary_message": "Toast pita if desired, then cut into wedges.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 334517,
      "primary_message": "To serve, divide pita, arugula, veggie ground, and vegetables between bowls. Top with creamy feta and enjoy!",
      "secondary_message": null
    }
  ],
