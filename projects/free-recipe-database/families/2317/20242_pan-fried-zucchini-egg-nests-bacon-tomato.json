  "instructions": [
    {
      "id": 337733,
      "primary_message": "Preheat two large skillets over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 337734,
      "primary_message": "Once the skillets are hot, divide bacon between them and cook until crispy, 3-5 minutes per side. Remove bacon to a paper towel-lined plate. (Reserve both skillets with drippings for later use.)",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 337735,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. ",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 337736,
      "primary_message": "Return both skillets (with drippings) to medium-high heat; divide the zucchini noodles and spices between them. Cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 337737,
      "primary_message": "When the zucchini noodles are soft, reduce heat to medium-low. Using a spatula, divide and shape noodles into 12 flattened mounds (6 mounds per skillet), making an indent at the center of each to create a \"nest.\"",
      "secondary_message": null
    },
    {
      "id": 337738,
      "primary_message": "Gently crack an egg into each \"nest.\" Cover each skillet with a lid and cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes; remove from heat.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 337739,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 337740,
      "primary_message": "To serve, divide zucchini egg nests, bacon, and tomatoes between plates; season eggs with salt and pepper. Enjoy!",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
