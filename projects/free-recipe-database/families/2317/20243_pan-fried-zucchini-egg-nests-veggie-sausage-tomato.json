  "instructions": [
    {
      "id": 337741,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 337742,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add sausages and cook until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n2 pre-cooked vegan sausage"
    },
    {
      "id": 337743,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. ",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 337744,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom; add zucchini noodles and spices. Cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 337745,
      "primary_message": "When the zucchini noodles are soft, reduce heat to medium-low. Using a spatula, divide and shape noodles into 4 flattened mounds, making an indent at the center of each to create a \"nest.\"",
      "secondary_message": null
    },
    {
      "id": 337746,
      "primary_message": "Gently crack an egg into each \"nest.\" Cover the skillet with a lid and cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes; remove from heat.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 337747,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "½ small pkg grape tomatoes"
    },
    {
      "id": 337748,
      "primary_message": "Slice sausages into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 337749,
      "primary_message": "To serve, divide zucchini egg nests, sausage, and tomatoes between plates; season eggs with salt and pepper. Enjoy!",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    }
  ],
