  "instructions": [
    {
      "id": 622521,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n6 medium carrots\n1 small bunch cilantro"
    },
    {
      "id": 622522,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622523,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 622524,
      "primary_message": "Peel, halve, and mince onions; peel and mince garlic. Add both to the bowl and set aside.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 622525,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 622526,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp chili powder\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 622527,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 622528,
      "primary_message": "When the veggie ground is done, add vegetables and tomato paste to the pot. Cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "9 tbsp tomato paste"
    },
    {
      "id": 622529,
      "primary_message": "Add beans and broth to the pot; stir to combine the chili, then bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 622530,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 622531,
      "primary_message": "When the chili is done, add half of the cilantro and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 622532,
      "primary_message": "To serve, divide chili between bowls; top with reserved cilantro and a dollop of yogurt. Enjoy!",
      "secondary_message": "⅓ cup plain Greek yogurt"
    }
  ],
