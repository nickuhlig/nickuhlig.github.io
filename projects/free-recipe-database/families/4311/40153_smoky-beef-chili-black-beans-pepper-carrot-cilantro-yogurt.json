  "instructions": [
    {
      "id": 622473,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n4 medium carrots\n1 small bunch cilantro"
    },
    {
      "id": 622474,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622475,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 622476,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 622477,
      "primary_message": "While the pot heats up, peel, halve, and mince onion; peel and mince garlic. Add both to the bowl with the other veggies and set aside.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 622478,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add beef and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n0.68 kg lean ground beef\n4 tsp chili powder\n1 tsp smoked paprika\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 622479,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 622480,
      "primary_message": "When the beef is done, add veggies and tomato paste to the pot; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "6 tbsp tomato paste"
    },
    {
      "id": 622481,
      "primary_message": "Add beans and broth to the pot; stir to combine the chili, then bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 622482,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 622483,
      "primary_message": "When the chili is done, add half of the cilantro and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 622484,
      "primary_message": "To serve, divide chili between bowls; top with reserved cilantro and a dollop of yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
