  "instructions": [
    {
      "id": 622497,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n2 medium carrots\n½ small bunch cilantro"
    },
    {
      "id": 622498,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 622499,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 622500,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 622501,
      "primary_message": "While the pan heats up, peel, halve, and mince onion; peel and mince garlic. Add both to the bowl with the other vegetables and set aside.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 622502,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n227 g veggie ground, plant based\n1 tsp chili powder\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 622503,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 622504,
      "primary_message": "When the veggie ground is done, add vegetables and tomato paste to the pan. Cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp tomato paste"
    },
    {
      "id": 622505,
      "primary_message": "Add beans and broth to the pan; stir to combine the chili, then bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "473 ml chicken or vegetable broth"
    },
    {
      "id": 622506,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 622507,
      "primary_message": "When the chili is done, add half of the cilantro and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 622508,
      "primary_message": "To serve, divide chili between bowls; top with reserved cilantro and a dollop of yogurt. Enjoy!",
      "secondary_message": "⅛ cup plain Greek yogurt"
    }
  ],
