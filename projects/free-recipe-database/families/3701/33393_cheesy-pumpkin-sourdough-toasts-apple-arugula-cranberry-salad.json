  "instructions": [
    {
      "id": 527464,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 527465,
      "primary_message": "Coarsely grate cheese. Place in a medium bowl along with pumpkin, eggs, and spices, then whisk until smooth. Set aside.",
      "secondary_message": "1 (227 g) block cheddar cheese\n1 ½ (398 ml) cans pure pumpkin purée\n3 eggs\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp paprika"
    },
    {
      "id": 527466,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 527467,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 Granny Smith apples\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 527468,
      "primary_message": "Divide cheesy pumpkin mixture between toast slices, spreading it to the edges. Working in batches, return toast to the oven and broil until topping is golden around the edges and warmed through, 1-2 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 527469,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, honey, Dijon, and salt, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp honey\n1 tbsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 527470,
      "primary_message": "Add arugula and cranberries to the bowl with the dressing, then toss to combine the salad. Set aside.",
      "secondary_message": "¾ cup dried cranberries"
    },
    {
      "id": 527471,
      "primary_message": "Quarter, core, and thinly slice apples.",
      "secondary_message": null
    },
    {
      "id": 527472,
      "primary_message": "Divide cheesy pumpkin toasts between plates and top with apple slices. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
