  "instructions": [
    {
      "id": 527428,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 527429,
      "primary_message": "Coarsely grate cheese. Place in a medium bowl along with pumpkin, eggs, and spices, then whisk until smooth. Set aside.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese\n1 (15 oz) can pure pumpkin purée\n2 eggs\n1 tsp salt\n½ tsp black pepper\n½ tsp paprika"
    },
    {
      "id": 527430,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "8 slices sourdough bread"
    },
    {
      "id": 527431,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 Granny Smith apples\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 527432,
      "primary_message": "Divide cheesy pumpkin mixture between toast slices, spreading it to the edges. Return toast to the oven and broil until topping is golden around the edges and warmed through, 1-2 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 527433,
      "primary_message": "Meanwhile, juice lemon into a clean medium bowl. Add oil, honey, Dijon, and salt, then whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp honey\n2 tsp Dijon mustard\n¼ tsp salt"
    },
    {
      "id": 527434,
      "primary_message": "Add arugula and cranberries to the bowl with the dressing, then toss to combine the salad. Set aside.",
      "secondary_message": "½ cup dried cranberries"
    },
    {
      "id": 527435,
      "primary_message": "Quarter, core, and thinly slice apples.",
      "secondary_message": null
    },
    {
      "id": 527436,
      "primary_message": "Divide cheesy pumpkin toasts between plates and top with apple slices. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
