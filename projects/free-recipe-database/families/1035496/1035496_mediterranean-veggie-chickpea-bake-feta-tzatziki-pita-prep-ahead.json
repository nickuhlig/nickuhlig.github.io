  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium and 4 mini food storage containers as well as 4 resealable plastic bags.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 450°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Drain and rinse chickpeas. Divide between two large baking sheet pans.",
      "secondary_message": "2 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Add to the baking sheets with the chickpeas.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry tomatoes. Add to the baking sheets.\n\n",
      "secondary_message": "2 pint grape tomatoes"
    },
    {
      "primary_message": "Peel, halve, and slice onions lengthwise into thin strips. Add to the baking sheets, drizzle with vinaigrette, then season with spices. Stir to combine and spread out in an even layer.\n\n",
      "secondary_message": "⅓ cup balsamic vinaigrette\n1 ½ tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring once, until veggies are tender and tomatoes start to burst, 20-25 minutes. Remove from oven and set aside to cool completely, about 20 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, cut pitas into wedges, divide between plastic bags, and store at room temperature.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the chickpea bake is cool, divide between the medium storage containers, then sprinkle with feta.\n\n",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "primary_message": "Divide tzatziki between the mini containers, add to the chickpea bake, then cover and refrigerate until ready to eat.\n\n",
      "secondary_message": "1 cup tzatziki sauce"
    },
    {
      "primary_message": "When ready to eat, heat chickpea bake in an oven or microwave. Enjoy with pita wedges and tzatziki on the side.",
      "secondary_message": null
    }
  ],
