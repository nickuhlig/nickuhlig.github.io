  "instructions": [
    {
      "id": 98484,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 98485,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n0.23 kg cremini mushrooms\n¼ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 98486,
      "primary_message": "Small dice the potato (cut into ¼-inch cubes). Transfer to a medium saucepan and cover with hot water (from the tap). Bring to a boil; reduce heat and simmer, covered, for 7 minutes. Once finished, drain the potatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 98487,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 98488,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 98489,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 98490,
      "primary_message": "Add the onion to the skillet; cook, stirring frequently, until slightly softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 98491,
      "primary_message": "Slice the mushrooms and add to the skillet along with spices.",
      "secondary_message": "¼ tsp thyme\n¼ tsp paprika\n¼ tsp turmeric\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 98492,
      "primary_message": "Crumble the tofu with your fingers into the skillet. Add the cooked potatoes and stir to combine. Sauté until the mushrooms are softened, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 98493,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 98494,
      "primary_message": "Divide the potatoes and veggies between plates and top with minced parsley. Enjoy!",
      "secondary_message": null
    }
  ],
