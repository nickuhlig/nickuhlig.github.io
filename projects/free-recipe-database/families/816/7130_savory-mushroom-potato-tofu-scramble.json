  "instructions": [
    {
      "id": 98506,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 98507,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n0.68 kg cremini mushrooms\n¾ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 98508,
      "primary_message": "Small dice the potatoes (cut into ¼-inch cubes). Transfer to a large pot and cover with hot water (from the tap). Bring to a boil; reduce heat and simmer, covered, for 11 minutes. Once finished, drain the potatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 98509,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 98510,
      "primary_message": "Preheat a large pot over medium heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 98511,
      "primary_message": "Add the onion to the skillet; cook, stirring frequently, until slightly softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 98512,
      "primary_message": "Slice the mushrooms and add to the pot along with spices.",
      "secondary_message": "¾ tsp thyme\n¾ tsp paprika\n¾ tsp turmeric\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 98513,
      "primary_message": "Crumble the tofu with your fingers into the skillet. Add the cooked potatoes and stir to combine. Sauté until the mushrooms are softened, 7-9 minutes.",
      "secondary_message": null
    },
    {
      "id": 98514,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 98515,
      "primary_message": "Divide the potatoes and veggies between plates and top with minced parsley. Enjoy!",
      "secondary_message": null
    }
  ],
