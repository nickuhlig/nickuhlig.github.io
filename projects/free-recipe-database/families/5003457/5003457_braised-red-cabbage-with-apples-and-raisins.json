  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Chop the purple cabbage. Cut the gala apple into matchsticks.",
      "secondary_message": "1 clove garlic\n1 medium head purple cabbage, about 12 cups\n1 gala apple"
    },
    {
      "id": 1,
      "primary_message": "Melt butter in a large saucepan over medium high heat. Add garlic and cook for one minute. Add cabbage, raisins, caraway seeds, and apple cider and cook, covered, for 10 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add apples and cook, covered, until cabbage is tender, about 5 minutes. Add apple cider vinegar and cook, stirring occasionally for three minutes. Season to taste with salt and pepper.",
      "secondary_message": null
    }
