  "instructions": [
    {
      "id": 445559,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch cilantro\n1 ½ jalapeño peppers\n6 tomatoes\n1 ½ bunches radish"
    },
    {
      "id": 445560,
      "primary_message": "Zest and juice limes. Divide between a small and large bowl.",
      "secondary_message": null
    },
    {
      "id": 445561,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between the bowls. (Set large bowl aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 445562,
      "primary_message": "Add mayo and spices to the small bowl, then stir to combine the lime aioli. Set aside.",
      "secondary_message": "½ cup mayonnaise\n¾ tsp garlic powder\n3 pinch cumin, ground\n3 pinch salt"
    },
    {
      "id": 445563,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445564,
      "primary_message": "While the skillet heats up, peel, halve, and mince onions. Add half to the large bowl with the lime and cilantro, then set aside. (Reserve remaining onion for the next step.) ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 445565,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using your fingers, crumble tempeh into the skillet, then add reserved onion, salt, and pepper. Cook, stirring occasionally, until the tempeh is browned and onion is soft, 6-7 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n3 (8 oz) packages tempeh\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445566,
      "primary_message": "Reduce heat to medium. Add tomato sauce, water, nutritional yeast, and spices to the skillet, then stir to combine. Continue to cook, stirring occasionally, until sauce thickens, 6-7 minutes. Remove from heat.",
      "secondary_message": "1 ½ (8 oz) cans tomato sauce\n¾ cup water\n⅓ cup nutritional yeast flakes\n1 tbsp cumin, ground\n1 tbsp chili powder\n1 ½ tsp smoked paprika\n¾ tsp salt"
    },
    {
      "id": 445567,
      "primary_message": "Meanwhile, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the large bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 445568,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445569,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl, along with salt and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 445570,
      "primary_message": "Warm tortillas in another skillet or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 445571,
      "primary_message": "To serve, divide tortillas between plates; fill with saucy tempeh and salsa. Drizzle with lime aioli and enjoy!",
      "secondary_message": null
    }
  ],
