  "instructions": [
    {
      "id": 445650,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n½ jalapeño pepper\n2 tomatoes\n½ bunch radish"
    },
    {
      "id": 445651,
      "primary_message": "Zest and juice lime. Divide between a small and medium bowl.",
      "secondary_message": null
    },
    {
      "id": 445652,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between the bowls. (Set medium bowl aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 445653,
      "primary_message": "Add mayo and spices to the small bowl, then stir to combine the lime aioli. Set aside.",
      "secondary_message": "3 tbsp vegan mayonnaise\n¼ tsp garlic powder\n1 pinch cumin, ground\n1 pinch salt"
    },
    {
      "id": 445654,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 445655,
      "primary_message": "While the skillet heats up, peel, halve, and mince onion. Add half to the medium bowl with the lime and cilantro, then set aside. (Reserve remaining onion for the next step.) ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 445656,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Using your fingers, crumble tempeh into the skillet, then add reserved onion, salt, and pepper. Cook, stirring occasionally, until the tempeh is browned and onion is soft, about 5 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil\n1 (227g ) pkg tempeh\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 445657,
      "primary_message": "Reduce heat to medium. Add tomato sauce, water, nutritional yeast, and spices to the skillet, then stir to combine. Continue to cook, stirring occasionally, until sauce thickens, about 5 minutes. Remove from heat.",
      "secondary_message": "½ (213 ml) can tomato sauce\n¼ cup water\n⅛ cup nutritional yeast flakes\n1 tsp cumin, ground\n1 tsp chili powder\n½ tsp smoked paprika\n¼ tsp salt"
    },
    {
      "id": 445658,
      "primary_message": "Meanwhile, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the medium bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 445659,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 445660,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl, along with salt and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 445661,
      "primary_message": "Warm tortillas in another skillet or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 445662,
      "primary_message": "To serve, divide tortillas between plates; fill with saucy tempeh and salsa. Drizzle with lime aioli and enjoy!",
      "secondary_message": null
    }
  ],
