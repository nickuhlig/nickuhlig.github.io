  "instructions": [
    {
      "id": 574767,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n3 tomatoes\n3 jalapeño peppers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 574768,
      "primary_message": "Zest limes into a small bowl. (Reserve limes for later use.)",
      "secondary_message": null
    },
    {
      "id": 574769,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime zest, along with mayo and garlic powder, then stir to combine the aioli. Set aside.",
      "secondary_message": "3 tbsp mayonnaise\n¼ tsp garlic powder"
    },
    {
      "id": 574770,
      "primary_message": "Juice reserved limes into a large bowl. Add oil and spices, then whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp chili powder\n¼ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 574771,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl with the dressing and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 574772,
      "primary_message": "Peel and mince garlic. Place in another large bowl along with veggie ground, bread crumbs, and spices; mix with your hands until well combined. Form the veggie ground mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "3 cloves garlic\n680 g veggie ground, plant based\n¾ cup panko bread crumbs\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 574773,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574774,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 574775,
      "primary_message": "Meanwhile, slice tomatoes crosswise into thin rounds. Place on another plate.",
      "secondary_message": null
    },
    {
      "id": 574776,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the plate with the tomato. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 574777,
      "primary_message": "Add 6 lettuce leaves to the plate, then chop or tear remaining lettuce into bite-sized pieces. Add chopped lettuce to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 574778,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 574779,
      "primary_message": "Spread aioli over the bottom half of each bun, then top with burger patties, jalapeño, tomato, and lettuce. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
