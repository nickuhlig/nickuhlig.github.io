  "instructions": [
    {
      "id": 574637,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 small bunch cilantro\n2 tomatoes\n2 jalapeño peppers\n1 head butter (Boston) lettuce"
    },
    {
      "id": 574638,
      "primary_message": "Zest lime into a small bowl. (Reserve lime for later use.)",
      "secondary_message": null
    },
    {
      "id": 574639,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime zest, along with mayo and garlic powder, then stir to combine the aioli. Set aside.",
      "secondary_message": "2 tbsp mayonnaise\n¼ tsp garlic powder"
    },
    {
      "id": 574640,
      "primary_message": "Juice reserved lime into a medium bowl. Add oil and spices, then whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 574641,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl with the dressing and set aside.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 574642,
      "primary_message": "Peel and mince garlic. Place in another medium bowl along with veggie ground, bread crumbs, and spices; mix with your hands until well combined. Form the veggie ground mixture into 4 equal-sized patties and place on a plate.",
      "secondary_message": "2 cloves garlic\n16 oz veggie ground, plant based\n½ cup panko bread crumbs\n2 tsp chili powder\n1 tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 574643,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 574644,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 574645,
      "primary_message": "Meanwhile, slice tomatoes crosswise into thin rounds. Place on another plate.",
      "secondary_message": null
    },
    {
      "id": 574646,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. Add to the plate with the tomato. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 574647,
      "primary_message": "Add 4 lettuce leaves to the plate, then chop or tear remaining lettuce into bite-sized pieces. Add chopped lettuce to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 574648,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 574649,
      "primary_message": "Spread aioli over the bottom half of each bun, then top with burger patties, jalapeño, tomato, and lettuce. Close with the top half of each bun. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
