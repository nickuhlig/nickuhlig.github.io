  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Very thinly slice the sage leaves crosswise. Trim the woody ends of the asparagus.",
      "secondary_message": "3 sage leaves\n½ bunch asparagus"
    },
    {
      "id": 1,
      "primary_message": "Preheat broiler and position rack about 10 to 15 cm from it. In a small skillet, heat olive oil with red pepper flakes over medium-high heat until shimmering. Add sage and let frizzle until pan goes silent. Add bread crumbs and cook, tossing and stirring constantly, until toasted. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "On a rimmed baking sheet, drizzle asparagus with oil and toss to coat. Season with salt. Broil asparagus, shaking and rotating pan occasionally to cook them evenly on all sides, until asparagus is blistered, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, in a small nonstick or cast iron skillet, melt butter over medium-high heat until foaming. Add egg and cook until whites are set and have a thin crispy ring around their edge, and the yolk is still runny. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Arrange asparagus on a plate in a single, even layer. Drizzle with fresh olive oil and season with salt and pepper. Break gorgonzola into small chunks and scatter them all over the asparagus. Scatter some seasoned bread crumbs all over, then top with some grated Parmigiano-Reggiano cheese. Slide the egg on top, then drizzle with more oil and top with more bread crumbs and grated cheese. Finish with freshly ground black pepper, then serve.",
      "secondary_message": null
    }
  ],
