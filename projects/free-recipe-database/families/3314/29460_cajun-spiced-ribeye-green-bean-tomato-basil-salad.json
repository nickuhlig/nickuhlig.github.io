  "instructions": [
    {
      "id": 469860,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg green beans\n3 small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 469861,
      "primary_message": "Trim and cut green beans crosswise into 1-inch pieces. Place in a large pot and cover with hot water (from the tap).",
      "secondary_message": null
    },
    {
      "id": 469862,
      "primary_message": "Bring green beans to a boil over high heat. Once boiling, reduce heat to medium and cook until fork-tender, 2-3 minutes. Drain and rinse under cold water to cool, then set aside to drain further.",
      "secondary_message": null
    },
    {
      "id": 469863,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 469864,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; sprinkle Cajun seasoning and salt on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp Cajun seasoning\n¾ tsp salt"
    },
    {
      "id": 469865,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 469866,
      "primary_message": "While the steak is cooking, peel and mince shallot. Place in a large bowl along with oil, vinegar, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 469867,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 469868,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl, along with the cooked green beans, and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 469869,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 469870,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
