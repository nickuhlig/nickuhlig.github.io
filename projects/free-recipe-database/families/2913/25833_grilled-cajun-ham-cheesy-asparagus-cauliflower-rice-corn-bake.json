  "instructions": [
    {
      "id": 422164,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 422165,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into bite-sized pieces. Divide between two large baking sheet pans.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 422166,
      "primary_message": "Add riced cauliflower and corn to the baking sheets with the asparagus; drizzle with oil and sprinkle with Cajun seasoning. Stir to combine and spread out in an even layer.",
      "secondary_message": "3 (12 oz) bags frozen, riced cauliflower\n3 cups frozen corn\n¼ cup extra virgin olive oil\n2 tbsp Cajun seasoning"
    },
    {
      "id": 422167,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 422168,
      "primary_message": "When the veggies are soft, remove from the oven and stir. Return baking sheets to the oven and continue to roast until veggies are tender and golden, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 422169,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 422170,
      "primary_message": "While the pan heats up, cut ham into portions. Sprinkle both sides with additional Cajun seasoning.",
      "secondary_message": "24 oz ham steak, boneless\n1 tbsp Cajun seasoning"
    },
    {
      "id": 422171,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches, add ham steaks and grill, flipping once, until charred and warmed through, about 5 minutes. Remove to a plate and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 422172,
      "primary_message": "While the ham is cooking, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 422173,
      "primary_message": "When the veggies are done, remove from the oven. Add parsley, cheese, and salsa to the baking sheets, then stir to combine.",
      "secondary_message": "2 cups shredded cheese, Italian blend\n2 cup salsa"
    },
    {
      "id": 422174,
      "primary_message": "To serve, divide the cauliflower rice bake and ham steaks between plates. Enjoy!",
      "secondary_message": null
    }
  ],
