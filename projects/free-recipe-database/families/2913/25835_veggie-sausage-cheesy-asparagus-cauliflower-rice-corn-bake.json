  "instructions": [
    {
      "id": 422185,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 422186,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into bite-sized pieces. Transfer to a large baking sheet pan.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 422187,
      "primary_message": "Add riced cauliflower and corn to the baking sheet with the asparagus; drizzle with oil and sprinkle with Cajun seasoning. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 (12 oz) bags frozen, riced cauliflower\n2 cups frozen corn\n3 tbsp extra virgin olive oil\n4 tsp Cajun seasoning"
    },
    {
      "id": 422188,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are starting to soften, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 422189,
      "primary_message": "When the veggies are soft, remove from the oven and stir. Return baking sheet to the oven and continue to roast until veggies are tender and golden, 8-10 minutes more.",
      "secondary_message": null
    },
    {
      "id": 422190,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 422191,
      "primary_message": "Once the pan is hot, coat with oil. Add sausages and grill, turning occasionally, until charred and warmed through, about 5 minutes (or cook according to package instructions). Remove to a plate and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 pre-cooked vegan sausage"
    },
    {
      "id": 422192,
      "primary_message": "While the sausages are cooking, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 422193,
      "primary_message": "When the veggies are done, remove from the oven. Add parsley, cheese, and salsa to the baking sheet, then stir to combine.",
      "secondary_message": "1 ⅓ cups shredded cheese, Italian blend\n1 ⅓ cup salsa"
    },
    {
      "id": 422194,
      "primary_message": "To serve, divide the cauliflower rice bake and sausages between plates. Enjoy!",
      "secondary_message": null
    }
  ],
