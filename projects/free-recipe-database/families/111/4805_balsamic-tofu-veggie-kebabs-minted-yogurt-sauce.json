  "instructions": [
    {
      "id": 58652,
      "primary_message": "Peel and mince garlic. Wash and dry mint. Pick the leaves off the stems; discard the stems and mince the leaves. In a large bowl, prepare marinade by whisking together ½ of the garlic and mint (save the rest for the sauce), oil, vinegar, salt, and pepper.",
      "secondary_message": "9 cloves garlic\n6 tbsp extra virgin olive oil\n6 tbsp balsamic vinegar\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 58657,
      "primary_message": "Drain and medium dice tofu; place on paper towels and pat dry. Add to bowl with marinade and toss to coat. Set aside.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 58658,
      "primary_message": "Wash and dry bell peppers and mushrooms. Seed and large dice the bell peppers. Halve the mushrooms. Peel and large dice onion. Add vegetables to bowl with tofu and toss.",
      "secondary_message": "3 red bell pepper\n¾ lb white mushrooms\n1 ½ medium yellow onion"
    },
    {
      "id": 58653,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 58654,
      "primary_message": "Thread tofu and vegetables onto skewers. Alternatively, you can cook the tofu and vegetable pieces directly on the grill/skillet without skewers.",
      "secondary_message": ""
    },
    {
      "id": 58651,
      "primary_message": "Coat grill or bottom of skillet with oil. Add tofu and vegetables; cook, turning occasionally, until tofu is browned and vegetables are tender, 8-10 minutes total.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 58655,
      "primary_message": "In a small bowl, prepare sauce by whisking together yogurt, salt, pepper, and remaining garlic and mint.",
      "secondary_message": "1 ½ cup plain Greek yogurt\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 58656,
      "primary_message": "To serve, place kebabs on a plate with yogurt sauce on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
