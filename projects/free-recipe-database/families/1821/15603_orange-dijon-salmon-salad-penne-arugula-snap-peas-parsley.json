  "instructions": [
    {
      "id": 256728,
      "primary_message": "Preheat oven to 205°C (400°F). Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 256729,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n2 oranges\n1 (227 g) pkg sugar snap peas\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 256730,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Transfer half to a small bowl and half to a large bowl; set the large bowl aside.",
      "secondary_message": null
    },
    {
      "id": 256731,
      "primary_message": "Zest oranges into the small bowl with the parsley (set oranges aside for later use), then add Dijon, oil, salt, and pepper. Stir to combine the herb paste.",
      "secondary_message": "4 tsp Dijon mustard\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 256732,
      "primary_message": "Pat salmon dry with paper towels and place on the baking sheet; spread herb paste evenly over top.",
      "secondary_message": "0.68 kg salmon fillet"
    },
    {
      "id": 256733,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until the salmon is opaque and flakes easily with a fork, 12-15 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": null
    },
    {
      "id": 256734,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g penne pasta"
    },
    {
      "id": 256735,
      "primary_message": "While the pasta is cooking, peel and mince garlic; add to the large bowl with the remaining parsley.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 256736,
      "primary_message": "Juice reserved oranges into the bowl, then add oil, Dijon, honey, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp Dijon mustard\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 256737,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons; add to the bowl with the dressing and stir to combine.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 256738,
      "primary_message": "Thinly slice snap peas crosswise and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256739,
      "primary_message": "When the pasta is done, drain in a colander and rinse under cold water to cool. Add to the bowl with the dressing along with the arugula; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 256740,
      "primary_message": "When the salmon is cool enough to handle, break into large chunks with your fingers.",
      "secondary_message": null
    },
    {
      "id": 256741,
      "primary_message": "To serve, divide salad between plates or bowls and top with salmon. Enjoy!",
      "secondary_message": null
    }
  ],
