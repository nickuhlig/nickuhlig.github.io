  "instructions": [
    {
      "id": 48268,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n1 avocado\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 48264,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 48276,
      "primary_message": "In a small bowl, combine chili powder, salt, and pepper.",
      "secondary_message": "1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48265,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; rub with the spice mixture on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak"
    },
    {
      "id": 48266,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 48267,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 48270,
      "primary_message": "Halve the cucumber crosswise, then quarter lengthwise and slice crosswise at an angle; transfer to a salad bowl.",
      "secondary_message": null
    },
    {
      "id": 48269,
      "primary_message": "Halve and pit the avocado; scoop out the flesh with a spoon and medium dice; add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 48272,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 48271,
      "primary_message": "Juice the lime and pour over the salad.",
      "secondary_message": ""
    },
    {
      "id": 48273,
      "primary_message": "Drizzle the salad with olive oil and season with cumin, salt, and pepper; toss to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48275,
      "primary_message": "To serve, divide the steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
