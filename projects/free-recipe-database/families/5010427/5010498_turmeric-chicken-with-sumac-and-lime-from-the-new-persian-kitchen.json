  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, mix the turmeric with 1 tablespoon salt and 2 teaspoons pepper. Place the chicken on a rimmed baking sheet and sprinkle with the spice mixture, turning to coat both sides.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat a large skillet over medium-high heat and add the oil. Brown the chicken well on both sides, about 7 minutes per side. Pour in the water, then add the garlic, stirring it into the water. Bring the water to a boil, then turn down the heat to low and cover. Braise the chicken for 25 minutes, until the inside is opaque. Transfer the chicken to a serving platter, turn up the heat to high, and reduce the cooking liquid for a few minutes, stirring occasionally until it’s slightly thickened. Season to taste with salt and pepper, and pour the sauce over the chicken.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Dust the chicken with sumac and pepper, garnish with lime halves, and serve.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Vegetarian Option: Use whole portobello mushrooms in place of the chicken, or use 0.45 kg firm tofu, well drained and cut into slabs 2.5 cm thick. You will need a little extra oil for searing than what is called for in the recipe.",
      "secondary_message": null
    }
  ],
