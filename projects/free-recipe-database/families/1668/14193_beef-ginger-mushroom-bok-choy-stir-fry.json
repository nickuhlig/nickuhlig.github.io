  "instructions": [
    {
      "id": 235695,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n9 baby bok choy\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 235696,
      "primary_message": "Thinly slice steak against the grain into strips. Transfer to a medium bowl, add coconut aminos, and toss to combine; set aside to marinate.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n⅓ cup coconut aminos"
    },
    {
      "id": 235697,
      "primary_message": "Meanwhile, using a clean cutting board, thinly slice mushrooms; transfer to another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 235698,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 235699,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add steak strips to the pot and stir-fry until just cooked through, 6-7 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 235700,
      "primary_message": "Meanwhile, trim ends and separate bok choy into leaves.",
      "secondary_message": null
    },
    {
      "id": 235701,
      "primary_message": "When the steak strips are done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 235702,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until starting to brown, about 5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 235703,
      "primary_message": "While the mushrooms cook, slice white stems of the bok choy crosswise into thin strips; chop or tear leaves into bite-sized pieces. Transfer leaves to the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 235704,
      "primary_message": "Add bok choy stems to the pot and stir to combine. Cook, stirring occasionally, until veggies are fork-tender, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 235705,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add to the pot and stir-fry until fragrant, about 30 seconds.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 235706,
      "primary_message": "Add bok choy leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 235707,
      "primary_message": "Return steak strips (and any accumulated juices) to the pot along with coconut aminos and vinegar; stir to combine and remove from heat.",
      "secondary_message": "3 tbsp coconut aminos\n1 tbsp rice vinegar"
    },
    {
      "id": 235708,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
