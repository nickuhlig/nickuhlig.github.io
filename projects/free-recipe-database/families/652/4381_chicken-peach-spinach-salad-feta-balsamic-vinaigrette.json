  "instructions": [
    {
      "id": 49609,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 peaches\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 49615,
      "primary_message": "Transfer the spinach to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 49614,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard the pit; cut each quarter lengthwise into thin wedges. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 49616,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Transfer to a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 49610,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 49611,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 49612,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 49613,
      "primary_message": "Place the chicken cutlets in the skillet; cook until they are golden brown on the outside and cooked through in the center, 2 to 4 minutes per side. Once done, transfer to a plate. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 49617,
      "primary_message": "To the garlic, add olive oil, balsamic vinegar, Dijon, salt, and pepper; whisk together.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tbsp balsamic vinegar\n¼ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 50526,
      "primary_message": "Add feta to the salad bowl.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 50527,
      "primary_message": "Pour the dressing over the salad and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 49618,
      "primary_message": "Slice the chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 49619,
      "primary_message": "To serve, divide the salad between plates and top with the chicken strips. Enjoy!",
      "secondary_message": null
    }
  ],
