  "instructions": [
    {
      "id": 157928,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¼ lb cremini mushrooms\n½ medium head cauliflower\n½ small pkg chives"
    },
    {
      "id": 157929,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157930,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 157931,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 157932,
      "primary_message": "Meanwhile, peel and mince shallot. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 157933,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157934,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add shallot; cook, stirring often, until softened, 2-3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 157935,
      "primary_message": "Slice mushrooms. Add to the pan with the shallot; cook, stirring often, until soft and browned around the edges, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 157936,
      "primary_message": "Cut cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower.",
      "secondary_message": null
    },
    {
      "id": 157937,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 157938,
      "primary_message": "Add cauliflower, garlic, broth, salt, and pepper to the pan. Continue to cook, stirring often, until cauliflower has softened, 5-6 minutes.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 157939,
      "primary_message": "Meanwhile, finely grate Parmesan. Add Parmesan and cream to the pan with the cauliflower. Reduce heat to medium and cook, stirring often, until slightly thickened, 3-5 minutes. Remove from heat. ",
      "secondary_message": "½ oz Parmesan cheese\n2 fl oz (¼ cup) heavy cream"
    },
    {
      "id": 157940,
      "primary_message": "Mince chives. Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 157941,
      "primary_message": "To serve, divide cauliflower risotto and steak between bowls or plates and garnish with chives. Enjoy!",
      "secondary_message": null
    }
  ],
