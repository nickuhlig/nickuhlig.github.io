  "instructions": [
    {
      "id": 157942,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb cremini mushrooms\n1 medium head cauliflower\n1 small pkg chives"
    },
    {
      "id": 157943,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157944,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 157945,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 157946,
      "primary_message": "Meanwhile, peel and mince onion. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 157947,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157948,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion and cook, stirring often, until softened, 2-3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 157949,
      "primary_message": "Slice mushrooms. Add to the pot with the onion; cook, stirring often, until soft and browned around the edges, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 157950,
      "primary_message": "Cut cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower.",
      "secondary_message": null
    },
    {
      "id": 157951,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 157952,
      "primary_message": "Add cauliflower, garlic, broth, salt, and pepper to the pot. Continue to cook, stirring often, until cauliflower has softened, 5-6 minutes.",
      "secondary_message": "6 fl oz (¾ cup) chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 157953,
      "primary_message": "Meanwhile, finely grate Parmesan. Add Parmesan and cream to the pot with the cauliflower. Reduce heat to medium and cook, stirring often, until slightly thickened, 3-5 minutes. Remove from heat. ",
      "secondary_message": "1 oz Parmesan cheese\n4 fl oz (½ cup) heavy cream"
    },
    {
      "id": 157954,
      "primary_message": "Mince chives. Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 157955,
      "primary_message": "To serve, divide cauliflower risotto and steak between bowls or plates and garnish with chives. Enjoy!",
      "secondary_message": null
    }
  ],
