  "instructions": [
    {
      "id": 157956,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb cremini mushrooms\n1 ½ medium heads cauliflower\n1 small pkg chives"
    },
    {
      "id": 157957,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157958,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 157959,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 157960,
      "primary_message": "Meanwhile, peel and mince onion. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 157961,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 157962,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion and cook, stirring often, until softened, 3-4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 157963,
      "primary_message": "Slice mushrooms. Add to the pot with the onion; cook, stirring often, until soft and browned around the edges, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 157964,
      "primary_message": "Cut cauliflower heads into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate cauliflower.",
      "secondary_message": null
    },
    {
      "id": 157965,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 157966,
      "primary_message": "Add cauliflower, garlic, broth, salt, and pepper to the pot. Continue to cook, stirring often, until cauliflower has softened, 6-7 minutes.",
      "secondary_message": "10 fl oz (1 ¼ cups) chicken or vegetable broth\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 157967,
      "primary_message": "Meanwhile, finely grate Parmesan. Add Parmesan and cream to the pot with the cauliflower. Reduce heat to medium and cook, stirring often, until slightly thickened, 4-6 minutes. Remove from heat. ",
      "secondary_message": "1 ½ oz Parmesan cheese\n6 fl oz (¾ cup) heavy cream"
    },
    {
      "id": 157968,
      "primary_message": "Mince chives. Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 157969,
      "primary_message": "To serve, divide cauliflower risotto and steak between bowls or plates and garnish with chives. Enjoy!",
      "secondary_message": null
    }
  ],
