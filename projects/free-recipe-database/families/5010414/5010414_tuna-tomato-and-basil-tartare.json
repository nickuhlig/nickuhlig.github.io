  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the sinew from the sushi grade fresh tuna, then roughly chop it. Discard the seeds from the vine-ripened tomato, then roughly chop it. Finely mince the shallot. Pick the basil leaves from the stems and roughly chop them. Slice the baguette into thin rounds, then toast it.",
      "secondary_message": "10 to 12 oz sushi grade fresh tuna\n1 vine-ripened tomato\n1 small shallot\n15 fresh basil leaves\n1 baguette"
    },
    {
      "id": 1,
      "primary_message": "Combine tuna, tomato, shallot, and basil in bowl of food processer. Season to taste with salt and pepper. Pulse 10 times. Scrape down the sides with a silicone spatula, and pulse until roughly chopped, about 10 more 1-second pulses.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer to a bowl. Toss with olive oil and vinegar (see note). Serve immediately with toasted baguette slices.",
      "secondary_message": null
    }
  ],
