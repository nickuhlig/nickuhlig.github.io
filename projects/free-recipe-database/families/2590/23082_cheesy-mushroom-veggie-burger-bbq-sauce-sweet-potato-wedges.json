  "instructions": [
    {
      "id": 421682,
      "primary_message": "Preheat oven to 425°F. Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 421683,
      "primary_message": "Wash, dry, peel, and cut each sweet potato lengthwise into 6-8 wedges, depending on size, then divide between two baking sheet pans. Drizzle with oil and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "2 ¼ lb sweet potatoes\n1 ½ tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 421684,
      "primary_message": "Place baking sheets on the upper and middle racks of the oven (it doesn't have to be fully heated) and bake, flipping once, until golden and fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421685,
      "primary_message": "Meanwhile, wash and dry mushrooms; remove stems and scrape out the gills. Transfer to another baking sheet, drizzle with oil, and season with spices. Place on the lower rack of the oven and bake until tender, 15-20 minutes. Remove from oven.",
      "secondary_message": "6 caps portobello mushrooms\n1 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 421686,
      "primary_message": "While the mushrooms are baking, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 421687,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook until golden brown on one side, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 veggie burger patties, plant-based"
    },
    {
      "id": 421688,
      "primary_message": "Flip the burger patties, top with cheese, and continue to cook until cheese is melted and patties are cooked through, 4-5 minutes more (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421689,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 421690,
      "primary_message": "Place the bottom half of each bun on a flat surface, then top with barbecue sauce, cheesy burger patties, and mushrooms. Close with the top half of each bun.",
      "secondary_message": "⅓ cup barbecue sauce"
    },
    {
      "id": 421691,
      "primary_message": "To serve, divide veggie burgers and sweet potato wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
