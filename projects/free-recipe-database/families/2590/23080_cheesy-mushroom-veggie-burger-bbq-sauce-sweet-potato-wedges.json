  "instructions": [
    {
      "id": 421662,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 421663,
      "primary_message": "Wash, dry, peel, and cut each sweet potato lengthwise into 6-8 wedges, depending on size, then transfer to a baking sheet pan. Drizzle with oil and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "¾ lb sweet potato\n1 ½ tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 421664,
      "primary_message": "Place sweet potatoes in the oven (it doesn't have to be fully heated) and bake, flipping once, until golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421665,
      "primary_message": "Meanwhile, wash and dry mushrooms; remove stems and scrape out the gills. Transfer to another baking sheet, drizzle with oil, and season with spices. Add to the oven and bake until tender, about 15 minutes. Remove from oven. ",
      "secondary_message": "2 caps portobello mushrooms\n1 tsp extra virgin olive oil\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 421666,
      "primary_message": "While the mushrooms are baking, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 421667,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook until golden brown on one side, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 veggie burger patties, plant-based"
    },
    {
      "id": 421668,
      "primary_message": "Flip the burger patties, top with cheese, and continue to cook until cheese is melted and patties are cooked through, 4-5 minutes more (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "½ cup shredded cheese, Italian blend"
    },
    {
      "id": 421669,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 421670,
      "primary_message": "Place the bottom half of each bun on a flat surface, then top with barbecue sauce, cheesy burger patties, and mushrooms. Close with the top half of each bun.",
      "secondary_message": "2 tbsp barbecue sauce"
    },
    {
      "id": 421671,
      "primary_message": "To serve, divide veggie burgers and sweet potato wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
