  "instructions": [
    {
      "id": 127211,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¼ medium head napa cabbage\n½ small pkg grape tomatoes\n½ small pkg chives"
    },
    {
      "id": 127212,
      "primary_message": "Trim off and discard the root end of the cabbage; quarter the cabbage lengthwise, then thinly slice crosswise and add to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 127213,
      "primary_message": "Peel shallot and slice in half lengthwise, then thinly slice into half rings. Add to the bowl with the cabbage. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 127214,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 127215,
      "primary_message": "Add eggs and spices to the bowl with the cabbage and stir to combine. ",
      "secondary_message": "2 eggs\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 127216,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 127217,
      "primary_message": "Add cabbage mixture to the skillet, pressing down with a spatula to flatten. Then, using the spatula, divide the mixture into 4 hash browns. Cook until tender and golden, about 3 minutes per side; transfer to a plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 127218,
      "primary_message": "Meanwhile, halve grape tomatoes and chop chives into small pieces. Transfer both to a small bowl with oil, salt, and pepper; stir to combine the salad.",
      "secondary_message": "1 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 127219,
      "primary_message": "Wipe out the skillet and return to medium heat; add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 127220,
      "primary_message": "Gently crack the eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but the yolks are still runny, 3-4 minutes.",
      "secondary_message": "4 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 127221,
      "primary_message": "To serve, divide hash browns, eggs, and tomato salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
