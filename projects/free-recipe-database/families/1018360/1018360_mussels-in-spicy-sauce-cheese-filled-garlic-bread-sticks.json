  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Line a baking sheet with foil and apply cooking spray.",
      "secondary_message": null
    },
    {
      "primary_message": "Mince garlic and parsley. Place in a saucepan with the butter and melt over medium heat. Set aside.",
      "secondary_message": "3 clove garlic\n1 tbsp Italian (flat-leaf) parsley\n4 tbsp salted butter"
    },
    {
      "primary_message": "Unroll dough on a lightly floured surface. Cut the dough in half lengthwise, and then cut into quarters, to yield 8 small rectangles.",
      "secondary_message": "1 (13.8 oz) pkg pizza dough"
    },
    {
      "primary_message": "Top each rectangle with a mozzarella stick. Roll dough over cheese stick and tightly pinch the seams closed. Place on prepared baking sheet 2-inches apart. Repeat with remaining bread sticks.",
      "secondary_message": "8 mozzarella string cheese sticks"
    },
    {
      "primary_message": "Brush tops of each bread stick with butter mixture. Reserve remaining butter mixture.",
      "secondary_message": null
    },
    {
      "primary_message": "Sprinkle cheese on top of each bread stick.",
      "secondary_message": "¼ cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "Bake for 12 - 15 minutes, until golden brown. Brush remaining butter mixture over the hot bread sticks.",
      "secondary_message": null
    },
    {
      "primary_message": "Prepare mussels in a spicy sauce per package instructions and serve with warm cheese-filled garlic bread sticks.",
      "secondary_message": "1 (16 oz) pkg mussels in a spicy sauce"
    }
  ],
