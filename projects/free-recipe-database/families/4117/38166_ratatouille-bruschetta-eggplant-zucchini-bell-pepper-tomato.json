  "instructions": [
    {
      "id": 596220,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 596221,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n6 medium zucchini squash\n3 yellow bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 596222,
      "primary_message": "Peel and thinly slice garlic. Place in a large bowl along with tomato sauce, oil, and spices. Stir to combine the sauce.",
      "secondary_message": "3 cloves garlic\n3 (8 oz) cans tomato sauce\n3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596223,
      "primary_message": "Trim and medium dice eggplants and zucchini. Add both to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 596224,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596225,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl and stir to combine the ratatouille veggies. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 596226,
      "primary_message": "Divide ratatouille veggies between two large baking sheet pans and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 596227,
      "primary_message": "Meanwhile, place oil and spices in a small bowl. Stir to combine the spice oil.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp basil, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 596228,
      "primary_message": "Carefully remove cooked veggies from the baking sheets by lifting the corners of the foil and transferring the whole sheets to a flat surface. (Stack foil layers one on top of the other if counter space is limited. Reserve baking sheets for the next step.)",
      "secondary_message": null
    },
    {
      "id": 596229,
      "primary_message": "Divide bread between the reserved baking sheets, then drizzle with spice oil on both sides. Place bread in the oven and bake, flipping halfway through, until toasted, 6-8 minutes; remove from oven.",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 596230,
      "primary_message": "To serve, divide toast between plates, then top with ratatouille and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
