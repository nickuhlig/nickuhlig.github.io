  "instructions": [
    {
      "id": 596198,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 596199,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n2 medium zucchini squash\n1 yellow bell pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 596200,
      "primary_message": "Peel and thinly slice garlic. Place in a medium bowl along with tomato sauce, oil, and spices. Stir to combine the sauce.",
      "secondary_message": "1 clove garlic\n1 (8 oz) can tomato sauce\n1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 596201,
      "primary_message": "Trim and medium dice eggplant and zucchini. Add both to the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 596202,
      "primary_message": "Trim, seed, and medium dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 596203,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl and stir to combine the ratatouille veggies. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 596204,
      "primary_message": "Transfer ratatouille veggies to a large baking sheet pan and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 596205,
      "primary_message": "Meanwhile, place oil and spices in a small bowl. Stir to combine the spice oil.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 596206,
      "primary_message": "Arrange bread on another baking sheet and drizzle with spice oil on both sides.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 596207,
      "primary_message": "When the veggies are done, place bread in the oven and bake, flipping halfway through, until toasted, 5-6 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 596208,
      "primary_message": "To serve, divide toast between plates, then top with ratatouille and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
