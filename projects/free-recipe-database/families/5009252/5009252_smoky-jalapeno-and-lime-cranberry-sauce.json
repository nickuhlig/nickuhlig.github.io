  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine cranberries, sugar, water, lime juice, lime zest, jalapeños, and salt in a medium saucepan. Bring to a boil over medium-high heat. Cook, stirring occasionally, until berries start to pop, about 5 minutes. Press berries against side of pan with a wooden spoon and continue to cook until berries have broken down and sauce thickens to a jam-like consistency, about 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove from heat, stir in mezcal, and let cool for 30 minutes. Adjust consistency with water as needed. Serve immediately or place in an airtight container and store in the refrigerator for up to 3 weeks.",
      "secondary_message": null
    }
  ],
