  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Drain and rinse the black beans. Drain the Ro*Tel Diced Tomatoes with Green Chiles. Pick the cilantro leaves from the stems and chop them. Thinly slice the scallions. Finely dice the avocado.",
      "secondary_message": "1 (425 g) can black beans\n2 (283 g) cans Ro*Tel Diced Tomatoes with Green Chiles\n3 tbsp fresh cilantro leaves, plus more for garnish\n4 scallions, plus more for garnish\n1 avocado"
    },
    {
      "id": 1,
      "primary_message": "Heat vegetable oil in a medium saucepan over high heat until shimmering. Add chorizo and cook, stirring frequently, until well browned and slightly dry, about 10 minutes. Remove 2 tablespoons and set aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add cheese dip, black beans (reserving 2 tablespoons for garnish), tomatoes, cilantro, scallions, avocado, and minced serrano or jalapeño and stir to combine. Stir in hot sauce to taste. Heat, stirring, until hot.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to a warm serving bowl. Garnish with reserved chorizo, black beans, cilantro, and scallions, and serve immediately with tortilla chips.",
      "secondary_message": null
    }
  ],
