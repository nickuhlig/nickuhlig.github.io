  "instructions": [
    {
      "id": 1,
      "primary_message": "For the syrup: heat water and sugar until water comes to a boil, stirring to dissolve. Remove from heat and add tea leaves. Steep 10 minutes. Strain and let cool before using.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the cocktail: fill a cocktail shaker with ice, add rum, apricot liqueur, Earl Grey syrup, lemon juice, and orange bitters. Shake well. Fill a highball glass with fresh ice and strain cocktail into serving glass. Top with Bitter Lemon soda. Garnish if desired and serve immediately.",
      "secondary_message": null
    }
