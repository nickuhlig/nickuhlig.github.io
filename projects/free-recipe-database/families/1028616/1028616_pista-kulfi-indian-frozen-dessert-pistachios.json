  "instructions": [
    {
      "primary_message": "If using paper cups, ensure you have enough space in your freezer to accommodate a small baking sheet pan or tray. Arrange cups on a baking sheet or tray and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place milk and saffron in a small bowl, then set aside to infuse for 10 minutes. ",
      "secondary_message": "2 tbsp whole milk\n1 pinch saffron threads"
    },
    {
      "primary_message": "Meanwhile, mince pistachios and set aside. \n\n",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "primary_message": "When the saffron is done infusing, place infused milk (and saffron threads) in a blender along with sweetened condensed milk, evaporated milk, cream, and cardamom. Blend on high until smooth, 1-2 minutes. ",
      "secondary_message": "1 (14 oz) can sweetened condensed milk\n1 (12 oz) can evaporated milk\n¾ cup heavy whipping cream\n½ tsp cardamom, ground"
    },
    {
      "primary_message": "If desired, add food coloring to the blender and blend once more until kulfi mixture is green. Add minced pistachios and pulse a few times to combine. ",
      "secondary_message": "6 drop green food coloring"
    },
    {
      "primary_message": "Divide kulfi mixture between the cups or popsicle molds.",
      "secondary_message": null
    },
    {
      "primary_message": "Carefully place baking sheet in the freezer and chill until semi-set, about 2 hours.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove baking sheet from the freezer. Insert popsicle sticks into the center of the kulfi, then return to the freezer. Continue to freeze until fully set, 1 hour more. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once set, remove kulfi from the freezer and rinse under hot water, from the tap, if necessary, to loosen and remove from their molds. Share and enjoy!",
      "secondary_message": null
    }
  ],
