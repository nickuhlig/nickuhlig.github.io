  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Split the yellow onions in half. Roughly slice the hand ginger root. Thinly slice the white onion. Thinly slice the scallions. Trim the bean sprouts. Thinly slice the Thai chiles. Cut each lime into 4 wedges.",
      "secondary_message": "2 medium yellow onions\n1 small hand ginger root\n1 small white onion\n½ cup scallions\n2 cups bean sprouts\nThai chiles\n2 limes"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a pressure cooker over high heat until smoking. Add halved onions and ginger, cut sides down. Cook without moving, reducing heat if smoking excessively, until onion and ginger are well charred, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add chicken, cilantro, star anise, fennel seed, coriander, cinnamon, and cloves to the pot. Add 1900 ml of water, the fish sauce, and the sugar to the pot. Seal the pressure cooker and bring it to high pressure over high heat. Cook on high pressure for 20 minutes, then shock under cold running water in the sink (or release pressure valve if using an electric pressure cooker).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Open pressure cooker. Transfer chicken legs to a plate. Pour broth through a fine mesh strainer into a clean pot and discard solids. Skim any scum off the surface of the broth using a ladle, but leave the small bubbles of fat intact. Season broth to taste with more fish sauce and sugar if desired.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To serve, place prepared pho noodles in individual bowls. Top with chicken legs, sliced onions, and scallions. Pour hot broth over chicken and noodles. Serve immediately, allowing guests to add herbs, bean sprouts, chiles, lime, and sauces as they wish.",
      "secondary_message": null
    }
  ],
