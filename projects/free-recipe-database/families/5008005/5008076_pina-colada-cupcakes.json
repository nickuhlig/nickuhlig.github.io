  "instructions": [
    {
      "id": 1,
      "primary_message": "Make Cupcakes: Preheat oven to 175°C (350°F). Line mini-muffin tin with wrappers.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together flour, baking powder, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, cream together butter and sugar until light and fluffy, about 3 minutes. Add egg and vanilla extract and beat until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Beat in 1/2 of flour mixture until combined. Add rum and cream of coconut and beat until combined. Beat in remaining flour mixture.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stir in pineapple and juice until evenly incorporated.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Pour batter evenly among wrappers, filling each 3/4 full. Bake until cupcakes are golden and a tester comes out clean, about 22 minutes. Move to a wire baking rack and let cool.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Make Frosting: In a large bowl, cream together cream cheese, butter, and confectioners' sugar until light and fluffy, about 4 minutes. Add salt, rum, and cream of coconut and beat until combined and frosting is smooth and creamy, about 3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Fold in sweetened coconut flakes.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Assembly: Place frosting in a pastry bag fitted with a medium tip. Pipe frosting onto cupcakes. Garnish each cupcake with a coconut flake, if desired.",
      "secondary_message": null
    }
  ],
