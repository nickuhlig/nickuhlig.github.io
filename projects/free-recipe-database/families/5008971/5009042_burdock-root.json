  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash and peel the burdock root. Cut the root into 10 cm length segments, then quarter each root lengthwise. Place the prepped root in a ice water bath with a splash of vinegar as you go along.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place a saute pan over medium heat and add the oil. Saute the burdock root for 4 to 6 minutes, until the roots is lightly browned.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the sake, soy sauce and sugar. Simmer the mixture for another 5 minutes, until the burdock is cooked through but still crispy. Serve at room temperature or cold.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To pickle burdock root:\nWash and peel the burdock root. Cut the root into 10 cm length segments, then quarter each root lengthwise. Place the prepped root in a ice water bath with a splash of vinegar as you go along.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bring a pot of water to boil. Parboil cut and skinned segments of burdock for 2 minutes. Drain, then immediately plunge back into the ice water bath.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "In the meantime, combine the ingredients for the brine in a plastic bag and shake around to mix. Remove the burdock from the ice bath and place into the brine in the plastic bag. Refrigerate the bag overnight, taking care that all the pieces of burdock are immersed in the brine. You may need to weigh the bag down with something heavier in order to get an even distribution of liquid. The pickles will keep in the bag for up to a week.",
      "secondary_message": null
    }
  ],
