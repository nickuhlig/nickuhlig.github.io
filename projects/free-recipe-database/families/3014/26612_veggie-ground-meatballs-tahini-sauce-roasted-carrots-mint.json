  "instructions": [
    {
      "id": 430909,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 430910,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 medium carrots\n1 small bunch green onions (scallions)\n2 small pkgs fresh mint\n2 lemons"
    },
    {
      "id": 430911,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 430912,
      "primary_message": "Drizzle carrots with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp cumin, ground\n2 tsp coriander, ground\n½ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 430913,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until carrots are tender and golden brown, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 430914,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Divide between a medium and a small bowl.",
      "secondary_message": null
    },
    {
      "id": 430915,
      "primary_message": "Pick mint leaves off the stems; discard stems. Mince half of the leaves and add to the medium bowl. Roughly chop (or tear) remaining leaves and add to the small bowl; set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 430916,
      "primary_message": "Add veggie ground, feta, bread crumbs, and spices to the medium bowl; use your hands to combine the veggie ground mixture. Using a tablespoon measure, form the mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": "16 oz veggie ground, plant based\n1 (4 oz) pkg crumbled feta cheese\n½ cup panko bread crumbs\n1 tbsp cumin, ground\n2 tsp coriander, ground\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 430917,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 430918,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 430919,
      "primary_message": "When the carrots are golden, remove from the oven and toss. Add meatballs to the baking sheet, nestling them into the carrots. ",
      "secondary_message": null
    },
    {
      "id": 430920,
      "primary_message": "Return baking sheet to the oven and continue to roast until the carrots are deep brown and meatballs are cooked through, about 5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 430921,
      "primary_message": "Meanwhile, juice one lemon into another small bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 430922,
      "primary_message": "Add tahini, water, and spices to the bowl with the lemon juice. Whisk to combine the sauce.",
      "secondary_message": "¼ cup tahini\n¼ cup water\n½ tsp garlic powder\n½ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 430923,
      "primary_message": "Divide carrots and meatballs between plates; drizzle meatballs with tahini sauce and top veggies with reserved green onion and mint. Serve with lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
