  "instructions": [
    {
      "id": 431014,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 431015,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "18 medium carrots\n1 small bunch green onions (scallions)\n3 small pkgs fresh mint\n3 lemons"
    },
    {
      "id": 431016,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 431017,
      "primary_message": "Drizzle carrots with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp cumin, ground\n1 tbsp coriander, ground\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 431018,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until carrots are tender and golden brown, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 431019,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Divide between a large and a small bowl.",
      "secondary_message": null
    },
    {
      "id": 431020,
      "primary_message": "Pick mint leaves off the stems; discard stems. Mince half of the leaves and add to the large bowl. Roughly chop (or tear) remaining leaves and add to the small bowl; set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 431021,
      "primary_message": "Add veggie ground, feta, bread crumbs, and spices to the large bowl; use your hands to combine the veggie ground mixture. Using a tablespoon measure, form the mixture into rounded \"meatballs\" and place on a large plate.",
      "secondary_message": "680 g veggie ground, plant based\n1 ½ (113 g) pkgs crumbled feta cheese\n¾ cup panko bread crumbs\n1 ½ tbsp cumin, ground\n1 tbsp coriander, ground\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 431022,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431023,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 431024,
      "primary_message": "When the carrots are golden, remove from the oven and toss. Add meatballs to the baking sheets, nestling them into the carrots. ",
      "secondary_message": null
    },
    {
      "id": 431025,
      "primary_message": "Return baking sheets to the oven and continue to roast until the carrots are deep brown and meatballs are cooked through, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 431026,
      "primary_message": "Meanwhile, juice half of the lemons into another small bowl. Cut remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 431027,
      "primary_message": "Add tahini, water, and spices to the bowl with the lemon juice. Whisk to combine the sauce.",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n¾ tsp garlic powder\n¾ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 431028,
      "primary_message": "Divide carrots and meatballs between plates; drizzle meatballs with tahini sauce and top veggies with reserved green onion and mint. Serve with lemon wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
