  "instructions": [
    {
      "id": 221162,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 221163,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini. Halve lengthwise, then slice crosswise into thin half-moons. Transfer to a baking sheet pan.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 221164,
      "primary_message": "Peel, halve, and thinly slice onion. Add to the baking sheet.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 221165,
      "primary_message": "Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 221166,
      "primary_message": "Peel garlic, place in the center of a small square of aluminum foil, and drizzle with oil. Fold foil around the garlic to close the packet. Place garlic packet on the baking sheet with the veggies.",
      "secondary_message": "4 cloves garlic\n1 tsp extra virgin olive oil"
    },
    {
      "id": 221167,
      "primary_message": "Place veggies in the oven and bake until zucchini is tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 221168,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes; transfer to a medium bowl, add oil and spices, then toss to combine. Set aside to marinate.",
      "secondary_message": "½ pint grape tomatoes\n1 tsp extra virgin olive oil\n¼ tsp Italian seasoning\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 221169,
      "primary_message": "Coarsely grate mozzarella. Cut cream cheese into small pieces. Set cheeses aside, keeping them separate.",
      "secondary_message": "½ (8 oz) block mozzarella cheese\n¼ (8 oz) block cream cheese"
    },
    {
      "id": 221170,
      "primary_message": "When the vegetables are done, remove from the oven and carefully transfer to the bowl with the tomatoes; stir to combine and set aside. (Leave garlic packet on the baking sheet).",
      "secondary_message": null
    },
    {
      "id": 221171,
      "primary_message": "Place pitas on the baking sheet with the garlic packet. Return to oven and toast for 5 minutes. Remove from oven.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 221172,
      "primary_message": "Meanwhile, preheat a small saucepan over medium heat. Once the pan is hot, add oil, flour, and spices. Whisk constantly for 30 seconds.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp all-purpose flour\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 221173,
      "primary_message": "Reduce heat to low; whisk in broth and cream cheese until smooth, 2-3 minutes. Remove from heat.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 221174,
      "primary_message": "Carefully remove garlic from the packet and roughly chop; add to the pan with the white sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 221175,
      "primary_message": "Top toasted pitas with white sauce, mozzarella, and veggies. Return pitas to the oven and bake until the cheese melts, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 221176,
      "primary_message": "To serve, divide pitas between plates and enjoy!",
      "secondary_message": null
    }
  ],
