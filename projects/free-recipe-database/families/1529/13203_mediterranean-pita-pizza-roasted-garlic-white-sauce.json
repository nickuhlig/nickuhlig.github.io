  "instructions": [
    {
      "id": 221192,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 221193,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini. Halve lengthwise, then slice crosswise into thin half-moons. Transfer to a large baking sheet pan.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 221194,
      "primary_message": "Peel, halve, and thinly slice onions. Add to the baking sheet.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 221195,
      "primary_message": "Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 221196,
      "primary_message": "Peel garlic, place in the center of a medium-size square of aluminum foil, and drizzle with oil. Fold foil around the garlic to close the packet. Place garlic packet on the baking sheet with the veggies.",
      "secondary_message": "12 cloves garlic\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 221197,
      "primary_message": "Place veggies in the oven and bake until zucchini is tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 221198,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes; transfer to a large bowl, add oil and spices, then toss to combine. Set aside to marinate.",
      "secondary_message": "1 ½ pints grape tomatoes\n1 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 221199,
      "primary_message": "Coarsely grate mozzarella. Cut cream cheese into small pieces. Set cheeses aside, keeping them separate.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese\n¾ (8 oz) block cream cheese"
    },
    {
      "id": 221200,
      "primary_message": "When the vegetables are done, remove from the oven and carefully transfer to the bowl with the tomatoes; stir to combine and set aside. (Leave garlic packet on the baking sheet).",
      "secondary_message": null
    },
    {
      "id": 221201,
      "primary_message": "Divide pitas between two baking sheets (leaving the garlic packet on one). Return to the oven and toast for 5-7 minutes. Remove from oven.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 221202,
      "primary_message": "Meanwhile, preheat a medium saucepan over medium heat. Once the pan is hot, add oil, flour, and spices. Whisk constantly for 30 seconds.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp all-purpose flour\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 221203,
      "primary_message": "Reduce heat to low; whisk in broth and cream cheese until smooth, 3-4 minutes. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 221204,
      "primary_message": "Carefully remove garlic from the packet and roughly chop; add to the pan with the white sauce and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 221205,
      "primary_message": "Top toasted pitas with white sauce, mozzarella, and veggies. Return pitas to the oven and bake until the cheese melts, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 221206,
      "primary_message": "To serve, divide pitas between plates and enjoy!",
      "secondary_message": null
    }
  ],
