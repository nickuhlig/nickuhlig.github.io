  "instructions": [
    {
      "id": 238862,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 238863,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 238864,
      "primary_message": "Meanwhile, using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 238865,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 238866,
      "primary_message": "While the rice is cooking, place oil and spices in a medium bowl; stir to combine the spice paste.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper\n½ tsp cumin, ground\n½ tsp turmeric, ground\n¼ tsp cinnamon, ground"
    },
    {
      "id": 238867,
      "primary_message": "Medium dice tofu, add to the bowl with the spice paste, and gently toss to coat. Transfer tofu to a large baking sheet and spread out in a single layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 238868,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until tofu is golden brown, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 238869,
      "primary_message": "Meanwhile, place peanut butter, soy sauce, water, vinegar, oil, and chili-garlic sauce in the reserved bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup natural peanut butter\n¼ cup soy sauce\n¼ cup water\n2 tbsp rice vinegar\n2 tbsp toasted sesame oil\n4 tsp chili-garlic sauce"
    },
    {
      "id": 238870,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 medium carrots\n½ small bunch cilantro"
    },
    {
      "id": 238871,
      "primary_message": "Trim, seed, and medium dice bell peppers; place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 238872,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the plate with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 238873,
      "primary_message": "Peel and thinly slice shallot lengthwise; add to the plate and set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 238874,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 238875,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 238876,
      "primary_message": "To serve, divide rice between bowls; top with baked tofu, bell pepper, carrot, shallot, edamame, and cilantro. Drizzle with sauce and enjoy!",
      "secondary_message": null
    }
  ],
