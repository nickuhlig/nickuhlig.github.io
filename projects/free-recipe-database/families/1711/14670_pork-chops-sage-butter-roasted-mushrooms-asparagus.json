  "instructions": [
    {
      "id": 242889,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 242890,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n½ lb white mushrooms\n½ small pkg fresh sage"
    },
    {
      "id": 242891,
      "primary_message": "Snap or cut off the woody ends of the asparagus and cut into 2-inch pieces. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 242892,
      "primary_message": "Slice mushrooms into ½-inch thick pieces; add to the baking sheet with the asparagus. Season veggies with salt and pepper; toss to combine, and spread out in an even layer.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 242893,
      "primary_message": "Cut butter into small pieces and dot over the veggies. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 242894,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the veggies are fork-tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 242895,
      "primary_message": "While the veggies are roasting, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242896,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 242897,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add pork chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate and loosely cover with aluminum foil; set aside.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 242898,
      "primary_message": "Meanwhile, pick sage leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 242899,
      "primary_message": "Return skillet to medium-high heat and add more butter; stir constantly until the butter is melted and golden brown, about 2 minutes. Remove from heat and stir in the sage.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 242900,
      "primary_message": "To serve, divide asparagus, mushrooms, and pork chops between plates. Top chops with sage butter and enjoy!",
      "secondary_message": null
    }
  ],
