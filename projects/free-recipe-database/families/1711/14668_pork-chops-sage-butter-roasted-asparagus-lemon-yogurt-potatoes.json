  "instructions": [
    {
      "id": 242857,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 242858,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n1 lemon\n2 small bunches asparagus\n½ small pkg fresh sage"
    },
    {
      "id": 242859,
      "primary_message": "Cut butter into small pieces and place in a small bowl; set aside.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 242860,
      "primary_message": "Quarter potatoes, transfer to a baking sheet pan, and spread out in a single layer. Dot half of the butter over the potatoes, then season with salt and pepper. (Set remaining butter aside.)",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 242861,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway though, until potatoes are fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 242862,
      "primary_message": "Meanwhile, zest lemon into a medium bowl; add yogurt, salt, and pepper. Whisk to combine the lemon-yogurt sauce and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 242863,
      "primary_message": "Cut the lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 242864,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Transfer to another baking sheet; dot with remaining butter and season with salt and pepper.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 242865,
      "primary_message": "Add asparagus to the oven and roast, tossing halfway through, until fork-tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 242866,
      "primary_message": "While the veggies are roasting, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242867,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 242868,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add pork chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate and loosely cover with aluminum foil; set aside.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 242869,
      "primary_message": "Meanwhile, pick sage leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 242870,
      "primary_message": "Return skillet to medium-high heat and add more butter; stir constantly until the butter is melted and golden brown, about 2 minutes. Remove from heat and stir in the sage.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 242871,
      "primary_message": "When the potatoes are done, add to the bowl with the lemon-yogurt sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 242872,
      "primary_message": "To serve, divide potatoes, asparagus, and pork chops between plates. Top chops with sage butter and a squeeze of lemon. Enjoy!",
      "secondary_message": null
    }
  ],
