  "instructions": [
    {
      "id": 242873,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 242874,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n1 ½ lemons\n3 small bunches asparagus\n1 small pkg fresh sage"
    },
    {
      "id": 242875,
      "primary_message": "Cut butter into small pieces and place in a small bowl; set aside.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 242876,
      "primary_message": "Quarter potatoes, transfer to a large baking sheet pan, and spread out in a single layer. Dot half of the butter over the potatoes, then season with salt and pepper. (Set remaining butter aside.)",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 242877,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway though, until potatoes are fork-tender, about 30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 242878,
      "primary_message": "Meanwhile, zest lemons into a large bowl; add yogurt, salt, and pepper. Whisk to combine the lemon-yogurt sauce and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 242879,
      "primary_message": "Cut the lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 242880,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Transfer to another large baking sheet; dot with remaining butter and season with salt and pepper.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 242881,
      "primary_message": "Add asparagus to the oven and roast, tossing halfway through, until fork-tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 242882,
      "primary_message": "While the veggies are roasting, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242883,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 242884,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add pork chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate and loosely cover with aluminum foil; set aside.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 242885,
      "primary_message": "Meanwhile, pick sage leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 242886,
      "primary_message": "Return skillet to medium-high heat and add more butter; stir constantly until the butter is melted and golden brown, 2-3 minutes. Remove from heat and stir in the sage.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 242887,
      "primary_message": "When the potatoes are done, add to the bowl with the lemon-yogurt sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 242888,
      "primary_message": "To serve, divide potatoes, asparagus, and pork chops between plates. Top chops with sage butter and a squeeze of lemon. Enjoy!",
      "secondary_message": null
    }
  ],
