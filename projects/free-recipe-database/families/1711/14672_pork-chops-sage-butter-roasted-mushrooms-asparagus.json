  "instructions": [
    {
      "id": 242913,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 242914,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n1 ½ lb white mushrooms\n1 small pkg fresh sage"
    },
    {
      "id": 242915,
      "primary_message": "Snap or cut off the woody ends of the asparagus and cut into 2-inch pieces. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 242916,
      "primary_message": "Slice mushrooms into ½-inch thick pieces; add to the baking sheets with the asparagus. Season veggies with salt and pepper; toss to combine, and spread out in an even layer.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 242917,
      "primary_message": "Cut butter into small pieces and dot over the veggies.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 242918,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the veggies are fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 242919,
      "primary_message": "While the veggies are roasting, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242920,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 242921,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add pork chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate and loosely cover with aluminum foil; set aside.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 242922,
      "primary_message": "Meanwhile, pick sage leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 242923,
      "primary_message": "Return skillet to medium-high heat and add more butter; stir constantly until the butter is melted and golden brown, 2-3 minutes. Remove from heat and stir in the sage.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 242924,
      "primary_message": "To serve, divide asparagus, mushrooms, and pork chops between plates. Top chops with sage butter and enjoy!",
      "secondary_message": null
    }
  ],
