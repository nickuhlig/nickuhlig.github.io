  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the onion. Stem, seed, and chop the whole jalapeño. Mince the ginger. Mince the garlic cloves. Chop the tomatoes. Well rinse and chop the spinach. Juice the lime.",
      "secondary_message": "½ medium onion\n1 whole jalapeño\n1 tsp ginger root\n2 medium garlic cloves\n1 cup tomatoes\n0.45 kg spinach, dried\n½ lime"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a large 30-cm cast-skillet set over medium-high. Add cumin seeds and stir constantly with a wooden spoon until seeds sizzle and turn slightly red, about 10 seconds. Add onion and jalapeño, and cook until onion starts to brown, 3 to 5 minutes. Stir in ginger and garlic and cook until fragrant, about 10 seconds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add chopped tomatoes and stir well. Cook until pieces start to break down to a sauce, 3 to 5 minutes. Add chickpeas and cook until warm, about 2 minutes. Season with 1 teaspoon salt and garam masala.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add a handful of spinach and stir until wilted. Continue process until all of the spinach has been added. Reduce heat to medium, and simmer until the liquid has reduced to a sauce. Turn off the heat and stir in lime juice.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat another large skillet over medium until warm. Add a flour tortilla and warm on both sides. Repeat with other tortillas.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spoon rice and spinach filling into the middle of a flour tortilla. Drizzle a little mango chutney on top (optional). Wrap burritos up and serve.",
      "secondary_message": null
    }
  ],
