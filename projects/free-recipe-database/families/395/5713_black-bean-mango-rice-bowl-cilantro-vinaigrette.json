  "instructions": [
    {
      "id": 68198,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "1 ½ cups basmati rice\n3 cups water\n¾ tsp salt"
    },
    {
      "id": 68197,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 jalapeño peppers\n3 mangoes\n3 limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 68209,
      "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 15 to 18 minutes. Remove from the heat and let the rice stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68208,
      "primary_message": "Seed and small dice the bell peppers; transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 68207,
      "primary_message": "Halve the jalapeños and remove the seeds; mince and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68206,
      "primary_message": "Peel and mince the garlic; add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 68205,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 68204,
      "primary_message": "Drain and rinse the black beans.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 68203,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 68202,
      "primary_message": "Add the peppers and garlic; cook until the bell pepper is softened, 2 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 68196,
      "primary_message": "Add the black beans and season with cumin, salt, and pepper. Cook, stirring occasionally, until warmed through, 2 to 3 minutes. Once done, turn off the heat.",
      "secondary_message": "1 ½ tsp cumin\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 68195,
      "primary_message": "Peel the mangoes and slice the flesh away from the pit, starting with the flat sides; medium dice the flesh and transfer to a bowl.",
      "secondary_message": ""
    },
    {
      "id": 68201,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Stir ½ of the cilantro into the beans (save the rest for the dressing).",
      "secondary_message": ""
    },
    {
      "id": 68200,
      "primary_message": "Juice the limes into a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 68194,
      "primary_message": "Add the remaining cilantro, olive oil, salt, and pepper to the lime juice; whisk together.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 68199,
      "primary_message": "Divide the rice between bowls, then add the black bean and pepper mixture, mango, and drizzle with the cilantro-lime dressing. Mix together and enjoy!",
      "secondary_message": ""
    }
  ],
