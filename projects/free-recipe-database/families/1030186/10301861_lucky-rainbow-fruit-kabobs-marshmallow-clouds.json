  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 kiwifruit\n1 mango\n113 g red grapes\n½ (170 g) pkg raspberries"
    },
    {
      "primary_message": "Peel, trim, and halve kiwis lengthwise, then slice each half crosswise into 3 half-moons (giving you 12 pieces total). Place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; large dice the flesh (aiming for 12 pieces total). Add to the plate with the kiwi, along with grapes and raspberries.",
      "secondary_message": null
    },
    {
      "primary_message": "Thread fruit onto skewers in a rainbow pattern: raspberry, mango, kiwi, grape. End with a marshmallow \"cloud.\"",
      "secondary_message": "12 bamboo skewer\n12 marshmallows"
    },
    {
      "primary_message": "Arrange fruit skewers on a platter, share, and enjoy!",
      "secondary_message": null
    }
  ],
