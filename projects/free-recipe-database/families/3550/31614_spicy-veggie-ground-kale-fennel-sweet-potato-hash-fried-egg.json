  "instructions": [
    {
      "id": 499628,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n3 fennel bulbs\n1 ½ bunches kale"
    },
    {
      "id": 499629,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 499630,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 499631,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl and set aside.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 499632,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 499633,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp paprika\n1 ½ tsp crushed red pepper\n¾ tsp Italian seasoning\n3 pinch nutmeg, ground"
    },
    {
      "id": 499634,
      "primary_message": "Using a slotted spoon, remove veggie ground to a plate; set aside. (Reserve pot for the next step.)",
      "secondary_message": null
    },
    {
      "id": 499635,
      "primary_message": "Return pot to medium-high heat, then add more oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until golden-brown and tender, 15-20 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 499636,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces.",
      "secondary_message": null
    },
    {
      "id": 499637,
      "primary_message": "When the vegetables are done, add vinegar and cooked veggie ground to the pot; stir to combine. Add kale to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": "1 ½ tbsp red wine vinegar"
    },
    {
      "id": 499638,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 499639,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 eggs\n3 pinch salt"
    },
    {
      "id": 499640,
      "primary_message": "To serve, divide hash between plates or bowls. Top with fried eggs and enjoy!",
      "secondary_message": null
    }
  ],
