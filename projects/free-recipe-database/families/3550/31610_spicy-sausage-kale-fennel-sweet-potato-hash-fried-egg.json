  "instructions": [
    {
      "id": 499576,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n2 fennel bulbs\n1 bunch kale"
    },
    {
      "id": 499577,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 499578,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 499579,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 499580,
      "primary_message": "While the skillet heats up, peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl and set aside.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 499581,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n0.45 kg ground pork sausage"
    },
    {
      "id": 499582,
      "primary_message": "Using a slotted spoon, remove sausage to a plate; set aside. (Reserve skillet with drippings for the next step.)",
      "secondary_message": null
    },
    {
      "id": 499583,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Add veggies, salt, and crushed red pepper; cook, stirring occasionally, until golden-brown and tender, 15-20 minutes.",
      "secondary_message": "1 tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 499584,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces.",
      "secondary_message": null
    },
    {
      "id": 499585,
      "primary_message": "When the veggies are done, add vinegar and cooked sausage to the skillet; stir to combine. Add kale to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": "2 tsp red wine vinegar"
    },
    {
      "id": 499586,
      "primary_message": "Preheat another skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 499587,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 eggs\n⅛ tsp salt"
    },
    {
      "id": 499588,
      "primary_message": "To serve, divide hash between plates or bowls. Top with fried eggs and enjoy!",
      "secondary_message": null
    }
  ],
