  "instructions": [
    {
      "id": 499602,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n1 fennel bulb\n½ bunch kale"
    },
    {
      "id": 499603,
      "primary_message": "Peel and medium dice sweet potato. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 499604,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 499605,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 499606,
      "primary_message": "While the skillet heats up, peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl and set aside.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 499607,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n227 g veggie ground, plant based\n1 tsp paprika\n½ tsp crushed red pepper\n¼ tsp Italian seasoning\n1 pinch nutmeg, ground"
    },
    {
      "id": 499608,
      "primary_message": "Using a slotted spoon, remove veggie ground to a plate; set aside. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 499609,
      "primary_message": "Return skillet to medium-high heat, then add more oil and swirl to coat the bottom. Add veggies and salt; cook, stirring occasionally, until golden-brown and tender, 15-20 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 499610,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces.",
      "secondary_message": null
    },
    {
      "id": 499611,
      "primary_message": "When the vegetables are done, add vinegar and cooked veggie ground to the skillet; stir to combine. Add kale to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": "1 ½ tsp red wine vinegar"
    },
    {
      "id": 499612,
      "primary_message": "Preheat another skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 499613,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 eggs\n1 pinch salt"
    },
    {
      "id": 499614,
      "primary_message": "To serve, divide hash between plates or bowls. Top with fried eggs and enjoy!",
      "secondary_message": null
    }
  ],
