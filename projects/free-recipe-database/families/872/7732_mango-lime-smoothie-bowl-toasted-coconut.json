  "instructions": [
    {
      "id": 113713,
      "primary_message": "This recipe will make about 6 cups of smoothie. Work in batches to best fit your blender.",
      "secondary_message": null
    },
    {
      "id": 113714,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 113715,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 mangoes\n1 lime"
    },
    {
      "id": 113716,
      "primary_message": "When the skillet is hot, add coconut to the pan. Cook, stirring often, until it becomes golden brown around the edges, 3-5 minutes. Transfer to a small bowl to cool.",
      "secondary_message": "1 cup shredded unsweetened coconut"
    },
    {
      "id": 113717,
      "primary_message": "Peel the mangos and slice the flesh away from the pits, starting with the flat sides. Medium dice the mangos and set aside.",
      "secondary_message": null
    },
    {
      "id": 113718,
      "primary_message": "Grate zest from the lime and set aside; juice lime into blender.",
      "secondary_message": null
    },
    {
      "id": 113719,
      "primary_message": "Add frozen mango, yogurt, milk, maple syrup, and spices to blender.",
      "secondary_message": "4 cup frozen mangoes\n2 cups plain Greek yogurt\n237 ml whole milk\n3 tbsp pure maple syrup\n¼ tsp turmeric\n¼ tsp cinnamon"
    },
    {
      "id": 113720,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 113721,
      "primary_message": "Divide smoothie between bowls and top with fresh mango, toasted coconut, and lime zest. Enjoy!",
      "secondary_message": null
    }
  ],
