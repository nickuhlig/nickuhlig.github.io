  "instructions": [
    {
      "id": 113680,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 113681,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 mango\n½ lime"
    },
    {
      "id": 113682,
      "primary_message": "When the skillet is hot, add coconut to the pan. Cook, stirring often, until it becomes golden brown around the edges, 3-5 minutes. Transfer to a small bowl to cool.",
      "secondary_message": "⅓ cup shredded unsweetened coconut"
    },
    {
      "id": 113683,
      "primary_message": "Peel the mango and slice the flesh away from the pit, starting with the flat sides. Medium dice the mango and set aside.",
      "secondary_message": null
    },
    {
      "id": 113684,
      "primary_message": "Grate zest from the lime and set aside; juice lime into blender.",
      "secondary_message": null
    },
    {
      "id": 113685,
      "primary_message": "Add frozen mango, coconut milk, water, maple syrup, and spices to blender.",
      "secondary_message": "2 cup frozen mangoes\n½ (13.5 fl oz) can coconut milk\n¼ cup water\n1 tbsp pure maple syrup\n⅛ tsp turmeric\n⅛ tsp cinnamon"
    },
    {
      "id": 113686,
      "primary_message": "Blend on high speed for several minutes until smooth.",
      "secondary_message": null
    },
    {
      "id": 113687,
      "primary_message": "Divide smoothie between bowls and top with fresh mango, toasted coconut, and lime zest. Enjoy!",
      "secondary_message": null
    }
  ],
