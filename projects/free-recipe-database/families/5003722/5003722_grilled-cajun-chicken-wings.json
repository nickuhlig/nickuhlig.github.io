  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, mix together baking powder, paprika, garlic powder, onion powder, thyme, oregano, cumin, salt, pepper, and cayenne.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pat chicken wings dry with paper towels. Place wings in a large bowl and sprinkle with seasoning mixture, tossing to evenly coat. Arrange wings in a single layer on a wire rack set inside a baking sheet lined with aluminum foil, leaving a little space between each wing. Place baking sheet with wings in refrigerator for 8 hours or overnight.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When ready to grill, melt butter in a small saucepan over medium heat. Stir in hot sauce and Worcestershire sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Place the wings skin side up over the cool side of the grill, cover, and cook until skins are crisp and browned, about 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer wings to a large bowl. Add in sauce and toss to thoroughly coat wings. Transfer to a platter and serve immediately.",
      "secondary_message": null
    }
  ],
