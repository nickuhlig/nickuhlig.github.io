  "instructions": [
    {
      "id": 209804,
      "primary_message": "Preheat the oven to 400°F. ",
      "secondary_message": null
    },
    {
      "id": 209805,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 lb sweet potatoes\n1 ½ limes\n3 tomatoes\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 209806,
      "primary_message": "Peel and large dice sweet potatoes. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 209807,
      "primary_message": "Peel and mince garlic. Add half to the baking sheet with the sweet potatoes, along with nutritional yeast, oil, and spices; toss to combine, then spread out in an even layer. Place remaining garlic in a small bowl and set aside.",
      "secondary_message": "6 cloves garlic\n⅓ cup nutritional yeast flakes\n2 tbsp extra virgin olive oil\n1 ½ tsp paprika\n¾ tsp cumin\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 209808,
      "primary_message": "Place sweet potatoes in the oven and bake, flipping halfway through, until fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 209809,
      "primary_message": "Meanwhile, juice limes into the bowl with the garlic; add mayo and whisk to combine the aioli. Set aside.",
      "secondary_message": "½ cup mayonnaise"
    },
    {
      "id": 209810,
      "primary_message": "Small dice tomatoes. Peel and small dice onion. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 209811,
      "primary_message": "Heat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 209812,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add tomatoes, onion, vinegar, chili-garlic sauce, paprika, and salt; cook, stirring frequently, until tomatoes have softened and reduced, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp chili-garlic sauce\n¾ tsp paprika\n¾ tsp salt"
    },
    {
      "id": 209813,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 209814,
      "primary_message": "Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 209815,
      "primary_message": "Add beans to the pan and stir to combine. Continue to cook until heated through, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209816,
      "primary_message": "To serve, divide sweet potatoes and veggie-bean sauté between bowls. Drizzle with aioli and enjoy!",
      "secondary_message": null
    }
  ],
