  "instructions": [
    {
      "id": 209817,
      "primary_message": "Preheat the oven to 400°F. ",
      "secondary_message": null
    },
    {
      "id": 209818,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lb sweet potato\n½ lime\n1 tomato\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 209819,
      "primary_message": "Peel and large dice sweet potatoes. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 209820,
      "primary_message": "Peel and mince garlic. Add half to the baking sheet with the sweet potatoes, along with nutritional yeast, oil, and spices; toss to combine, then spread out in an even layer. Place remaining garlic in a small bowl and set aside.",
      "secondary_message": "2 cloves garlic\n⅛ cup nutritional yeast flakes\n2 tsp extra virgin olive oil\n½ tsp paprika\n¼ tsp cumin\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 209821,
      "primary_message": "Place sweet potatoes in the oven and bake, flipping halfway through, until fork-tender, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 209822,
      "primary_message": "Meanwhile, juice lime into the bowl with the garlic; add mayo and whisk to combine the aioli. Set aside.",
      "secondary_message": "3 tbsp vegan mayonnaise"
    },
    {
      "id": 209823,
      "primary_message": "Small dice tomato. Peel and small dice shallot. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 209824,
      "primary_message": "Heat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 209825,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add tomatoes, shallot, vinegar, chili-garlic sauce, paprika, and salt; cook, stirring frequently, until tomatoes have softened and reduced, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp chili-garlic sauce\n¼ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 209826,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 209827,
      "primary_message": "Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 209828,
      "primary_message": "Add beans to the pan and stir to combine. Continue to cook until heated through, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209829,
      "primary_message": "To serve, divide sweet potatoes and veggie-bean sauté between bowls. Drizzle with aioli and enjoy!",
      "secondary_message": null
    }
  ],
