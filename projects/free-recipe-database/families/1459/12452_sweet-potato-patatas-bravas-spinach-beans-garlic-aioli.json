  "instructions": [
    {
      "id": 209869,
      "primary_message": "Preheat the oven to 205°C (400°F). ",
      "secondary_message": null
    },
    {
      "id": 209870,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.91 kg sweet potato\n1 lime\n2 tomatoes\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 209871,
      "primary_message": "Peel and large dice sweet potatoes. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 209872,
      "primary_message": "Peel and mince garlic. Add half to the baking sheet with the sweet potatoes, along with nutritional yeast, oil, and spices; toss to combine, then spread out in an even layer. Place remaining garlic in a small bowl and set aside.",
      "secondary_message": "4 cloves garlic\n¼ cup nutritional yeast flakes\n4 tsp extra virgin olive oil\n1 tsp paprika\n½ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 209873,
      "primary_message": "Place sweet potatoes in the oven and bake, flipping halfway through, until fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 209874,
      "primary_message": "Meanwhile, juice lime into the bowl with the garlic; add mayo and whisk to combine the aioli. Set aside.",
      "secondary_message": "⅓ cup mayonnaise"
    },
    {
      "id": 209875,
      "primary_message": "Small dice tomatoes. Peel and small dice onion. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 209876,
      "primary_message": "Heat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 209877,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add tomatoes, onion, vinegar, chili-garlic sauce, paprika, and salt; cook, stirring frequently, until tomatoes have softened and reduced, about 4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp apple cider vinegar\n2 tsp chili-garlic sauce\n½ tsp paprika\n½ tsp salt"
    },
    {
      "id": 209878,
      "primary_message": "Meanwhile, drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 209879,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 209880,
      "primary_message": "Add beans to the pot and stir to combine. Continue to cook until heated through, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209881,
      "primary_message": "To serve, divide sweet potatoes and veggie-bean sauté between bowls. Drizzle with aioli and enjoy!",
      "secondary_message": null
    }
  ],
