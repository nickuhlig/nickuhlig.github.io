  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chill the chopped peanut butter cups in freezer.",
      "secondary_message": "1 cup chopped peanut butter cups"
    },
    {
      "id": 1,
      "primary_message": "For Peanut Butter Ice Cream: Combine half and half, peanut butter, sugar, salt, and vanilla in blender. Blend until smooth, then transfer to an airtight container and chill for 3 hours or until very cold.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Churn base in ice cream maker according to manufacturer's instructions. Transfer to an airtight container, stir in frozen peanut butter cups, and chill in freezer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For Chocolate Fudge Swirl: Combine corn syrup, sugar, water, oil, chocolate, cocoa powder, and salt in a heavy-bottomed saucepan. Cook mixture on very low heat until chocolate is melted, sugar is fully dissolved, and all ingredients are fully incorporated. Cool chocolate sauce until just warm enough to pour freely from a spoon.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Retrieve peanut butter ice cream from freezer. Working very quickly, fold chocolate sauce into ice cream with a large spoon or rubber spatula. Fold—don't stir—ice cream just until swirl is distributed. Immediately return to coldest part of freezer and chill until firm, at least 3 hours.",
      "secondary_message": null
    }
  ],
