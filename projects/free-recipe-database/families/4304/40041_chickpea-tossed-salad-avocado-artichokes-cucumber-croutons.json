  "instructions": [
    {
      "id": 620991,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620992,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 620993,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 3-4 minutes. Remove from heat and set aside to cool slightly.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 620994,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n½ English cucumber\n1 tomato\n1 avocado\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 620995,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620996,
      "primary_message": "Juice lemon into the bowl with the parsley. Add mayo, oil, Dijon, maple syrup, and spices, then whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp vegan mayonnaise\n2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 620997,
      "primary_message": "Drain and rinse chickpeas, then pat dry with paper towels. Add to the bowl with the dressing, season with salt, and stir to coat.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n¼ tsp salt"
    },
    {
      "id": 620998,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 620999,
      "primary_message": "Medium dice tomato. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 621000,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 621001,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl, along with mixed greens and cooled croutons, then toss to combine the salad.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 621002,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
