  "instructions": [
    {
      "id": 620835,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620836,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 620837,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 4-5 minutes. Remove from heat and set aside to cool slightly.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 620838,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n1 ½ English cucumbers\n3 tomatoes\n3 avocados\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 620839,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 620840,
      "primary_message": "Juice lemons into the bowl with the parsley. Add mayo, oil, Dijon, maple syrup, and spices, then whisk to combine the dressing.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 620841,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 620842,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 620843,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 620844,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 620845,
      "primary_message": "Drain tuna and flake with a fork. Add to the bowl, along with mixed greens and cooled croutons, then toss to combine the salad.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 620846,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
