  "instructions": [
    {
      "id": 620967,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620968,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 620969,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 3-4 minutes. Remove from heat and set aside to cool slightly.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 620970,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n1 English cucumber\n2 tomatoes\n2 avocados\n2 (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 620971,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 620972,
      "primary_message": "Juice lemon into the bowl with the parsley. Add mayo, oil, Dijon, maple syrup, and spices, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 620973,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 620974,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 620975,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 620976,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 620977,
      "primary_message": "Drain tuna and flake with a fork. Add to the bowl, along with mixed greens and cooled croutons, then toss to combine the salad.",
      "secondary_message": "4 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 620978,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
