  "instructions": [
    {
      "id": 406874,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Place in a medium bowl. ",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 406875,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl with the zucchini. ",
      "secondary_message": "1 ½ (12 oz) jars roasted red bell peppers"
    },
    {
      "id": 406876,
      "primary_message": "Small dice ham. Add to the bowl. ",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 406877,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 406878,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, ham, and spices; cook, stirring occasionally, until veggies start to soften, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 406879,
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 406880,
      "primary_message": "When the veggies are soft, add beans and broth to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until veggies and beans are tender, 4-5 minutes. ",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 406881,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until kale is tender, 3-4 minutes more. Remove from heat. ",
      "secondary_message": "1 ½ (10 oz) bags kale, cut and ready to use"
    },
    {
      "id": 406882,
      "primary_message": "To serve, divide soup between bowls. Top with tortilla chips and enjoy!",
      "secondary_message": "6 oz tortilla chips"
    }
  ],
