  "instructions": [
    {
      "id": 406910,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Place in a small bowl. ",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 406911,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl with the zucchini. ",
      "secondary_message": "½ (340 g) jar roasted red bell peppers"
    },
    {
      "id": 406912,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 406913,
      "primary_message": "While the pan heats up, small dice ham. Add to the bowl. ",
      "secondary_message": "227 g ham steak, boneless"
    },
    {
      "id": 406914,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, ham, and spices; cook, stirring occasionally, until veggies start to soften, 2-3 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 406915,
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 406916,
      "primary_message": "When the veggies are soft, add beans and broth to the pan; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until veggies and beans are tender, 3-4 minutes. ",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 406917,
      "primary_message": "Add kale to the pan in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until kale is tender, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "½ (283 g) bag kale, cut and ready to use"
    },
    {
      "id": 406918,
      "primary_message": "To serve, divide soup between bowls. Top with tortilla chips and enjoy!",
      "secondary_message": "57 g tortilla chips"
    }
  ],
