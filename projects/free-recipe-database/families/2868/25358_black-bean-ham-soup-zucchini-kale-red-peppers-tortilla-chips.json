  "instructions": [
    {
      "id": 406919,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Place in a medium bowl. ",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 406920,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl with the zucchini. ",
      "secondary_message": "1 (340 g) jar roasted red bell peppers"
    },
    {
      "id": 406921,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 406922,
      "primary_message": "While the pot heats up, small dice ham. Add to the bowl. ",
      "secondary_message": "454 g ham steak, boneless"
    },
    {
      "id": 406923,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, ham, and spices; cook, stirring occasionally, until veggies start to soften, 2-3 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 406924,
      "primary_message": "Meanwhile, drain and rinse beans. ",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 406925,
      "primary_message": "When the veggies are soft, add beans and broth to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer until veggies and beans are tender, 3-4 minutes. ",
      "secondary_message": "1420 ml chicken or vegetable broth"
    },
    {
      "id": 406926,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until kale is tender, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "1 (283 g) bag kale, cut and ready to use"
    },
    {
      "id": 406927,
      "primary_message": "To serve, divide soup between bowls. Top with tortilla chips and enjoy!",
      "secondary_message": "113 g tortilla chips"
    }
  ],
