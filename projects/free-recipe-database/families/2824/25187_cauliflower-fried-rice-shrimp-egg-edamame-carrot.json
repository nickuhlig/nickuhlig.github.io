  "instructions": [
    {
      "id": 404332,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 404333,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 404334,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add shrimp and cook, stirring occasionally, until opaque, 3-4 minutes. Transfer to a plate and set aside. (Reserve pot for the next step.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 404335,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add riced cauliflower, carrots, edamame, and spices; cook, stirring occasionally, until softened, 6-7 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 (12 oz) bags frozen, riced cauliflower\n1 (10 oz) bag shredded carrots\n2 cups edamame\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 404336,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in a medium bowl. Whisk to combine.",
      "secondary_message": "4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 404337,
      "primary_message": "When the veggies are done, add egg to the pot and cook, stirring constantly, until set and no longer runny.",
      "secondary_message": null
    },
    {
      "id": 404338,
      "primary_message": "Return cooked shrimp to the pot. Add stir-fry sauce, stir to combine, and continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "⅔ cup stir-fry sauce"
    },
    {
      "id": 404339,
      "primary_message": "To serve, divide \"fried rice\" between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
