  "instructions": [
    {
      "id": 404362,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 404363,
      "primary_message": "While the pot heats up, place eggs, salt, and pepper in a large bowl. Whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 404364,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 404365,
      "primary_message": "Pour the egg mixture into the pot. Scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Transfer to a large plate and set aside. (Reserve pot for the next step.)",
      "secondary_message": null
    },
    {
      "id": 404366,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add riced cauliflower, carrots, edamame, and spices; cook, stirring occasionally, until softened, 7-8 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil\n3 (12 oz) bags frozen, riced cauliflower\n1 ½ (10 oz) bags shredded carrots\n6 cups edamame\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 404367,
      "primary_message": "When the veggies are done, return scrambled eggs to the pot. Add stir-fry sauce, stir to combine, and continue to cook until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "1 cup stir-fry sauce"
    },
    {
      "id": 404368,
      "primary_message": "To serve, divide \"fried rice\" between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
