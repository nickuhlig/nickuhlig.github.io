  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest the oranges. Mince or press the garlic. Thinly slice the red onions. Drain and rinse the chickpeas.",
      "secondary_message": "2 oranges\n3 cloves garlic\n4 medium red onions\n1 (425 g) can chickpeas"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to upper middle position and preheat oven to 220°C (425°F). Pat chicken dry with paper towels and season all over with 1 teaspoon salt and 1/4 teaspoon pepper; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Marinade: In a large bowl whisk to combine stock, orange zest, orange juice, oil, 1 tablespoon harissa, honey, garlic, cilantro, coriander, turmeric, ginger, cumin, and remaining 1 teaspoon salt. Taste marinade and add up to 1 tablespoon more harissa if needed for desired heat level.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To a rimmed baking sheet, add onions and chickpeas, pour half of marinade over top, and use hands or a large spoon to toss to coat and spread into an even layer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In bowl with remaining marinade, add chicken and use hands or a large spoon to thoroughly coat chicken with marinade. Place chicken, skin side up, on top of onions and chickpeas. Roast until onions are tender, chicken skin is browned and crispy, and a thermometer inserted into thickest part of chicken registers 79°C (79℃), 30 to 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Garnish chicken and chickpeas with cilantro and serve immediately.",
      "secondary_message": null
    }
  ],
