  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and halve the white onion. Peel and halve the carrots crosswise. Halve the celery sticks crosswise. Wash the thoroughly of the cilantro stems.",
      "secondary_message": "1 large white onion\n2 medium carrots\n2 large celery sticks\n1 bunch cilantro stems"
    },
    {
      "id": 1,
      "primary_message": "In a large pot, cover beef tongue with 4000 ml water. Bring to a boil over high heat, then reduce to a simmer and cook for 15 minutes, occasionally skimming scum that rises to the surface.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add halved onion, carrots, celery, cilantro stems, garlic cloves, bay leaves, black peppercorns, coriander seeds, cumin seeds, and 1 tablespoon salt. Cover and cook at a gentle simmer until the tongue can be easily pierced with a fork, 4 to 5 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove tongue and set aside to cool. Strain broth through a fine-mesh strainer into a heatproof container and discard the solids. Return broth to pot and bring to a boil, and cook until reduced to 8 cups, about 15 to 30 minutes. Meanwhile, peel the outer white membrane off the tongue and discard. Dice meat into 0.5-cm pieces. Skim fat from the surface of the broth and reserve (be sure to fully separate the skimmed fat from any traces of broth).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When ready to serve, in a large skillet, heat 1 tablespoon of reserved fat over medium-high until shimmering. Add diced tongue and cook, stirring frequently, until browned and lightly crisped, about 5 minutes. Season to taste with salt and pepper. Transfer to serving bowls and ladle broth on top. Serve with warmed tortillas, cilantro, onion, lime wedges, and salsa verde (if desired). Alternatively, serve the consomé on the side and serve as assembled tacos.",
      "secondary_message": null
    }
  ],
