  "instructions": [
    {
      "id": 133174,
      "primary_message": "Preheat oven to 230°C (450°F). Line a sheet pan with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 133175,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg sweet potato\n1 ½ lemons\n1 small pkg grape tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 133176,
      "primary_message": "Peel and cut sweet potatoes lengthwise into 4-6 wedges each, depending on size, then transfer to the sheet pan. Drizzle with oil and season with salt and pepper. ",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 133177,
      "primary_message": "Spread wedges out in an even layer, then place in the oven and bake for 10 minutes, until potatoes begin to soften slightly. ",
      "secondary_message": null
    },
    {
      "id": 133178,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 133179,
      "primary_message": "Juice half of a lemon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 133180,
      "primary_message": "Place drained chickpeas in the bowl with the lemon juice; add oil and spices. Toss to coat.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp cumin\n¼ tsp coriander\n¼ tsp paprika\n¼ tsp cinnamon\n¼ tsp salt"
    },
    {
      "id": 133181,
      "primary_message": "Remove sweet potatoes from the oven and flip using tongs. Sprinkle chickpeas (and any leftover seasoning) over the sweet potatoes in an even layer and return to the oven. Bake until chickpeas become crispy and potatoes can be pierced easily with a fork, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 133182,
      "primary_message": "Meanwhile, grate the zest from remaining lemon into a small bowl, then juice into the same bowl. ",
      "secondary_message": null
    },
    {
      "id": 133183,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon zest and juice. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 133184,
      "primary_message": "Add tahini and spices to the bowl and whisk to combine the sauce. Add 3-4 tablespoons cold water, if needed, to reach drizzling consistency. ",
      "secondary_message": "¼ cup tahini\n½ tsp dill\n¼ tsp salt\n⅛ tsp black pepper\n¼ cup water"
    },
    {
      "id": 133185,
      "primary_message": "Halve the grape tomatoes crosswise. ",
      "secondary_message": null
    },
    {
      "id": 133186,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 133187,
      "primary_message": "To serve, divide potatoes and chickpeas between plates. Top with tomatoes, parsley, and garlic-tahini sauce. Enjoy!",
      "secondary_message": null
    }
  ],
