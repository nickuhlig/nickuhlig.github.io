  "instructions": [
    {
      "id": 133118,
      "primary_message": "Preheat oven to 450°F. Line two sheet pans with aluminum foil. ",
      "secondary_message": null
    },
    {
      "id": 133119,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lb sweet potatoes\n4 ½ lemons\n3 pints grape tomatoes\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 133120,
      "primary_message": "Peel and cut sweet potatoes lengthwise into 4-6 wedges each, depending on size, then transfer to one of the sheet pans. Drizzle with oil and season with salt and pepper. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 133121,
      "primary_message": "Spread wedges out in an even layer, then place in the oven and bake for 10 minutes, until potatoes begin to soften slightly. ",
      "secondary_message": null
    },
    {
      "id": 133122,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 133123,
      "primary_message": "Juice one and a half of the lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 133124,
      "primary_message": "Place drained chickpeas in the bowl with the lemon juice; add oil and spices. Toss to coat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp cumin\n¾ tsp coriander\n¾ tsp paprika\n¾ tsp cinnamon\n¾ tsp salt"
    },
    {
      "id": 133125,
      "primary_message": "Remove sweet potatoes from the oven and flip using tongs. Transfer chickpeas (and any leftover seasoning) to the second sheet pan and spread out in an even layer. Place both pans in the oven and bake until chickpeas become crispy and potatoes can be pierced easily with a fork, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 133126,
      "primary_message": "Meanwhile, grate the zest from remaining lemons into a medium bowl, then juice into the same bowl. ",
      "secondary_message": null
    },
    {
      "id": 133127,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon zest and juice. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 133128,
      "primary_message": "Add tahini and spices to the bowl and whisk to combine the sauce. Add 5-6 tablespoons cold water, if needed, to reach drizzling consistency. ",
      "secondary_message": "¾ cup tahini\n1 ½ tsp dill\n¾ tsp salt\n½ tsp black pepper\n⅓ cup water"
    },
    {
      "id": 133129,
      "primary_message": "Halve the grape tomatoes crosswise. ",
      "secondary_message": null
    },
    {
      "id": 133130,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 133131,
      "primary_message": "To serve, divide potatoes and chickpeas between plates. Top with tomatoes, parsley, and garlic-tahini sauce. Enjoy!",
      "secondary_message": null
    }
  ],
