  "instructions": [
    {
      "id": 37815,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n2 avocados\n1 small bunch green onions (scallions)\n4 sticks celery\n1 head butter (Boston) lettuce "
    },
    {
      "id": 37816,
      "primary_message": "In a medium bowl, combine and mix together the spices. Transfer ½ tsp of the mixture to a small bowl for garnishing and set aside.",
      "secondary_message": "4 tsp chili powder\n1 tsp garlic powder\n1 tsp onion powder\n½ tsp salt\n½ tsp pepper"
    },
    {
      "id": 37817,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 37818,
      "primary_message": "While the skillet heats up, cut the chicken thighs into 6-mm strips. Add the chicken to the spice mixture and mix thoroughly with your hands.",
      "secondary_message": "0.907 kg chicken thighs, boneless skinless"
    },
    {
      "id": 37819,
      "primary_message": "Wash and dry the cutting board.",
      "secondary_message": null
    },
    {
      "id": 37820,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "4 tbsp virgin coconut oil"
    },
    {
      "id": 37821,
      "primary_message": "Add the chicken to the skillet; cook, stirring occasionally, until golden brown and cooked through, 7 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 37822,
      "primary_message": "While the chicken cooks, halve the tomatoes and transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 37823,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces. Place the onions next to the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 37824,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; thinly slice the flesh crosswise (without piercing the skin) and scoop out. Place the avocado slices next to the tomatoes and onions.",
      "secondary_message": null
    },
    {
      "id": 37825,
      "primary_message": "Trim off and discard the root end of the lettuce; separate the leaves and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 37826,
      "primary_message": "Trim off and discard the ends of the celery sticks; cut the sticks crosswise into thirds.",
      "secondary_message": null
    },
    {
      "id": 37827,
      "primary_message": "To serve, scoop the chicken into the lettuce leaves, then top with the tomatoes, green onions, and avocado slices. Garnish with the remaining spice mix and serve with the celery sticks on the side. Enjoy!",
      "secondary_message": null
    }
  ],
