  "instructions": [
    {
      "id": 191773,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pan is boiling, reduce heat to medium-low.",
      "secondary_message": "1 tbsp apple cider vinegar"
    },
    {
      "id": 191774,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.23 kg cremini mushrooms\n1 small pkg grape tomatoes\n½ bunch kale"
    },
    {
      "id": 191775,
      "primary_message": "Halve tomatoes, place them in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 191776,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 191777,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 191778,
      "primary_message": "While the skillet heats up, peel and mince the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 191779,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, garlic, and Italian seasoning; cook, stirring often, until the mushrooms are tender, 3-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp Italian seasoning"
    },
    {
      "id": 191780,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 191781,
      "primary_message": "Add tomatoes to the skillet, season with salt and pepper, and stir to combine.",
      "secondary_message": "¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 191782,
      "primary_message": "Stirring frequently, add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Cook until heated through, about 1 minute. Remove from heat and cover with a lid to keep warm.",
      "secondary_message": null
    },
    {
      "id": 191783,
      "primary_message": "Gently crack eggs into small bowls, 2 eggs per bowl.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 191784,
      "primary_message": "Adjust the heat as necessary so that the water in the saucepan is simmering. Gently tip bowls into the saucepan, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 191785,
      "primary_message": "To serve, divide vegetable sauté between plates. Top with poached eggs, season with salt and pepper, and enjoy!",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    }
  ],
