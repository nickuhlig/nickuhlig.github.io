  "instructions": [
    {
      "id": 191799,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pot is boiling, reduce heat to medium-low.",
      "secondary_message": "2 tbsp apple cider vinegar"
    },
    {
      "id": 191800,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n3 small pkgs grape tomatoes\n1 ½ bunches kale"
    },
    {
      "id": 191801,
      "primary_message": "Halve tomatoes, place them in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 191802,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 191803,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 191804,
      "primary_message": "While the skillet heats up, peel and mince the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 191805,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, garlic, and Italian seasoning; cook, stirring often, until the mushrooms are tender, 4-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning"
    },
    {
      "id": 191806,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces. ",
      "secondary_message": null
    },
    {
      "id": 191807,
      "primary_message": "Add tomatoes to the skillet, season with salt and pepper, and stir to combine.",
      "secondary_message": "¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 191808,
      "primary_message": "Stirring frequently, add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Cook until heated through, 1-2 minutes. Remove from heat and cover with a lid to keep warm.",
      "secondary_message": null
    },
    {
      "id": 191809,
      "primary_message": "Gently crack eggs into small bowls, 2 eggs per bowl.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 191810,
      "primary_message": "Adjust the heat as necessary so that the water in the pot is simmering. Working in batches, gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 191811,
      "primary_message": "To serve, divide vegetable sauté between plates. Top with poached eggs, season with salt and pepper, and enjoy!",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
