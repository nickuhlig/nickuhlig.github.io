  "instructions": [
    {
      "id": 629646,
      "primary_message": "Wash, dry, and shave dill leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with yogurt, vinegar, sugar, and salt, then stir to combine the dressing.",
      "secondary_message": "1 small bunch fresh dill\n½ cup plain Greek yogurt\n4 tsp white wine vinegar\n4 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 629647,
      "primary_message": "Wash, dry, trim, and slice cucumbers crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": "2 English cucumbers"
    },
    {
      "id": 629648,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 629649,
      "primary_message": "Drain sauerkraut in a colander to remove excess liquid. Set aside to drain further.",
      "secondary_message": "1 ⅓ cups sauerkraut"
    },
    {
      "id": 629650,
      "primary_message": "Stack roast beef slices one on top of another, then medium dice.",
      "secondary_message": "454 g deli roast beef"
    },
    {
      "id": 629651,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 629652,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide drained sauerkraut, roast beef, and cheese between them, arranging on one half of each tortilla. Fold in half to close.",
      "secondary_message": "4 large flour tortillas\n2 cups shredded cheese, Italian blend"
    },
    {
      "id": 629653,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, add quesadillas and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 629654,
      "primary_message": "Cut each quesadilla into wedges.",
      "secondary_message": null
    },
    {
      "id": 629655,
      "primary_message": "To serve, divide quesadillas and cucumber salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
