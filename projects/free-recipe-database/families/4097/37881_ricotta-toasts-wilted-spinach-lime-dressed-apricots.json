  "instructions": [
    {
      "id": 591978,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 591979,
      "primary_message": "Wash, dry, and juice limes into a large bowl. Add oil, sugar, and salt, then stir to combine the dressing. ",
      "secondary_message": "1 ½ limes\n1 tbsp extra virgin olive oil\n1 tbsp brown sugar\n3 pinch salt"
    },
    {
      "id": 591980,
      "primary_message": "Wash, dry, and halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pit. Cut each half into thin slices. Add to the bowl with the dressing, stir to coat, and set aside.",
      "secondary_message": "12 apricots"
    },
    {
      "id": 591981,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591982,
      "primary_message": "While the pot heats up, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "3 (142 g) pkgs baby spinach"
    },
    {
      "id": 591983,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat, season with spices, and stir to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp basil, dried\n¾ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 591984,
      "primary_message": "Meanwhile, divide bread between two baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 591985,
      "primary_message": "Divide toast between plates, spread with ricotta, then top with spinach. Serve with apricots on the side and enjoy!",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese"
    }
  ],
