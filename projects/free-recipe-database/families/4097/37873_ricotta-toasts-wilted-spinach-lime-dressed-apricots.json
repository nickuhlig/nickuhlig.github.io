  "instructions": [
    {
      "id": 591914,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 591915,
      "primary_message": "Wash, dry, and juice lime into a medium bowl. Add oil, sugar, and salt, then stir to combine the dressing. ",
      "secondary_message": "½ lime\n1 tsp extra virgin olive oil\n1 tsp brown sugar\n1 pinch salt"
    },
    {
      "id": 591916,
      "primary_message": "Wash, dry, and halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pit. Cut each half into thin slices. Add to the bowl with the dressing, stir to coat, and set aside.",
      "secondary_message": "4 apricots"
    },
    {
      "id": 591917,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 591918,
      "primary_message": "While the skillet heats up, wash and dry spinach (skip this step if it came pre-washed). ",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 591919,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat, season with spices, and stir to combine.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp basil, dried\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 591920,
      "primary_message": "Meanwhile, arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 591921,
      "primary_message": "Divide toast between plates, spread with ricotta, then top with spinach. Serve with apricots on the side and enjoy!",
      "secondary_message": "½ (15 oz) pkg ricotta cheese"
    }
  ],
