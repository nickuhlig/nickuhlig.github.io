  "instructions": [
    {
      "id": 25037,
      "primary_message": "If using frozen shrimp, place in a large bowl, cover with water, and set aside to defrost. If using fresh shrimp, skip this step.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen\n"
    },
    {
      "id": 25038,
      "primary_message": "Wash and dry the fresh produce. Halve the tomatoes. Halve and pit the avocados; thinly slice the flesh crosswise while still in the skin and scoop out with a spoon. Peel and mince the garlic.",
      "secondary_message": "2 (142 g) pkg baby spinach\r\n1 pint grape tomatoes\r\n2 avocados\r\n2 cloves garlic"
    },
    {
      "id": 25039,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 25040,
      "primary_message": "Drain the shrimp in a colander and run under cold water to melt any remaining ice chunks. Place on a clean towel (or paper towels) and pat dry.",
      "secondary_message": ""
    },
    {
      "id": 25041,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the minced garlic and cook until fragrant, 15-30 seconds. Add the shrimp and cook until opaque, 1-2 minutes per side.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 25042,
      "primary_message": "In a small bowl, prepare the dressing by whisking together lemon juice, olive oil, honey, salt, and pepper.",
      "secondary_message": "juice of 1 lemon\r\n4 tbsp extra virgin olive oil\r\n½ tsp honey\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 25043,
      "primary_message": "To serve, arrange a bed of spinach on a plate, top with the tomatoes, avocado and shrimp, and drizzle with the dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
