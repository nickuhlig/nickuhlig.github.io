  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 150°C (300°F). Line a rimmed baking sheet with parchment paper. Working over a bowl, using your fingers, tear each tomato in half and press out and discard the seeds. Arrange tomatoes on prepared baking sheet in one layer, season with salt, and drizzle all over with olive oil. Transfer to oven and cook until excess juices have evaporated and tomatoes look slightly dry on the exterior but still moist within, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer oven-roasted tomatoes to a work surface and chop finely.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to a large mixing bowl. Add 1/4 cup olive oil and basil and stir well. Season with salt and add red wine vinegar, about 1 teaspoon at a time, until tomatoes are very lightly tart. Stir in a pinch of sugar to help pump up tomatoes' natural sweetness even more; add more sugar sparingly to taste, if desired.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Rub top sides of toasts all over with garlic (rub more on for a stronger flavor, or less for a gentler one). Drizzle toasts with olive oil and season lightly with salt. Spoon tomatoes on top and serve.",
      "secondary_message": null
    }
  ],
