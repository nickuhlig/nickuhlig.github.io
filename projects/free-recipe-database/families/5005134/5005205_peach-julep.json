  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the overripe peach into slices. Juice the lemon.",
      "secondary_message": "¼ overripe peach\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "For Rooibos Tea Syrup: Pour boiling water over tea bags and let steep 5 minutes. Remove tea bags. Stir in sugar to dissolve. Let cool before using. Syrup can be stored in refrigerator for up to 1 week.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a mixing glass, muddle peach slices, rooibos syrup, and lemon juice into a rough pulp. Add cognac and Lillet blanc, stir to mix. Pour unstrained into serving glass.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fill serving glass with crushed ice, garnish with large bunch of mint.",
      "secondary_message": null
    }
  ],
