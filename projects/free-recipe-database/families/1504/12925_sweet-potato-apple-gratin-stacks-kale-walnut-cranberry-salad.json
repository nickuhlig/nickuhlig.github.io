  "instructions": [
    {
      "id": 233708,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 233709,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb sweet potato\n½ orange\n1 Gala apple\n½ bunch kale"
    },
    {
      "id": 233710,
      "primary_message": "Peel sweet potatoes and slice into ¼-inch thick rounds. Transfer to the baking sheet, arranging the slices in a single layer; season with salt and pepper.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 233711,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until sweet potatoes start to soften, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 233712,
      "primary_message": "Meanwhile, juice orange into a medium bowl. Add nutritional yeast, oil, Dijon, and spices; whisk to combine the dressing and set aside.",
      "secondary_message": "⅛ cup nutritional yeast flakes\n1 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¼ tsp salt\n1 pinch black pepper\n1 pinch cinnamon, ground"
    },
    {
      "id": 233713,
      "primary_message": "Quarter, core, and thinly slice apple.",
      "secondary_message": null
    },
    {
      "id": 233714,
      "primary_message": "Thinly slice cheese. ",
      "secondary_message": "⅓ (8 oz) block cheddar cheese"
    },
    {
      "id": 233715,
      "primary_message": "Remove the partially cooked sweet potatoes from the oven. Layer half the sweet potato slices with half the apple and cheese. If needed, use tongs to repeat layering with remaining sweet potato, apple, and cheese, ending with a cheese slice on top.",
      "secondary_message": null
    },
    {
      "id": 233716,
      "primary_message": "Return baking sheet to the oven; bake until sweet potatoes are fork-tender and cheese is melted, 10-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 233717,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 233718,
      "primary_message": "Coarsely chop walnuts and add to the bowl along with the cranberries; toss to combine the salad. ",
      "secondary_message": "¼ cup walnuts\n⅛ cup dried cranberries"
    },
    {
      "id": 233719,
      "primary_message": "To serve, divide sweet potato stacks and salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
