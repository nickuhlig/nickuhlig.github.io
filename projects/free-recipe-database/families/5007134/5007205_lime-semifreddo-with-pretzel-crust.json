  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Melt the unsalted butter. Juice the limes. Finely grate the zest from the lime. Bring the egg whites to room temperature.",
      "secondary_message": "5 tbsp unsalted butter\n4 limes\n2 tsp lime zest\n4 large egg whites"
    },
    {
      "id": 1,
      "primary_message": "Line a 9- by 13-cm loaf pan with plastic wrap, allowing it to hang generously over the edges. Combine pretzel crumbs, butter, and light brown sugar in medium bowl. Press mixture into bottom and 5 cm up sides of prepared loaf pan. Place pan in freezer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk sweetened condensed milk, lime juice, and lime zest in medium bowl until smooth; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir sugar, water, and corn syrup in heavy-bottomed medium saucepan over medium-low heat until sugar dissolves. Increase heat to medium-high and boil syrup until it registers 116°C on candy thermometer, 8 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While syrup boils, with electric mixer fitted with whisk attachment, beat whites and salt on medium speed until loosened, about 1 minute. Increase speed to medium-high and whisk until soft peaks form, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "When ready, with mixer running on medium-high speed, slowly and carefully add syrup to egg whites. Beat until outside of bowl is cool to the touch and whites are thick and glossy, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Mix about 1/3 of meringue to lime mixture. With rubber spatula, fold in remaining meringue. Scrape mixture into frozen crust and cover loosely with plastic wrap. Freeze at least 8 hours.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "When ready to serve, wipe sides of loaf pan with a towel dampened with hot water. Using the plastic wrap, pull the semifreddo up and out onto a platter; discard plastic wrap. Slice and serve immediately.",
      "secondary_message": null
    }
  ],
