  "instructions": [
    {
      "id": 314779,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n2 medium carrots\n1 green bell pepper\n1 jalapeño pepper\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 314780,
      "primary_message": "Trim and small dice celery; peel, trim, and small dice carrots. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 314781,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the celery and carrot.",
      "secondary_message": null
    },
    {
      "id": 314782,
      "primary_message": "Quarter jalapeño lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 314783,
      "primary_message": "Preheat a medium saucepan over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 314784,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 314785,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 7-8 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp chili powder\n½ tsp paprika\n¼ tsp salt"
    },
    {
      "id": 314786,
      "primary_message": "While the veggies cook, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 314787,
      "primary_message": "Add beans, broth, and tomatoes to the pan; stir to combine the chili and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies and beans are soft, about 10 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 (14.5 oz) can diced tomatoes"
    },
    {
      "id": 314788,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 314789,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 314790,
      "primary_message": "When the chili is done, remove from heat, add half of the parsley, and stir to combine. (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 314791,
      "primary_message": "To serve, divide chili between bowls and top with mozzarella, yogurt, and reserved parsley. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
