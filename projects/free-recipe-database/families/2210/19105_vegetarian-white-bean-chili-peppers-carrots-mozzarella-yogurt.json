  "instructions": [
    {
      "id": 314805,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n6 medium carrots\n3 green bell peppers\n3 jalapeño peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 314806,
      "primary_message": "Trim and small dice celery; peel, trim, and small dice carrots. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 314807,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the celery and carrot.",
      "secondary_message": null
    },
    {
      "id": 314808,
      "primary_message": "Quarter jalapeños lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 314809,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 314810,
      "primary_message": "Preheat a large pot over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 314811,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 8-10 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp paprika\n¾ tsp salt"
    },
    {
      "id": 314812,
      "primary_message": "While the veggies cook, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 314813,
      "primary_message": "Add beans, broth, and tomatoes to the pot; stir to combine the chili and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies and beans are soft, 10-12 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 314814,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 314815,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 314816,
      "primary_message": "When the chili is done, remove from heat, add half of the parsley, and stir to combine. (Reserve remaining parsley for garnish.)",
      "secondary_message": null
    },
    {
      "id": 314817,
      "primary_message": "To serve, divide chili between bowls and top with mozzarella, yogurt, and reserved parsley. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
