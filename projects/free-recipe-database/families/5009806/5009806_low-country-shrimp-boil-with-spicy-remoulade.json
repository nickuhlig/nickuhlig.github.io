  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly slice the garlic. Cut the smoked sausage into 2-inch pieces. Shuck and snap the fresh corn in half.",
      "secondary_message": "4 cloves garlic\n1 ½ lb smoked sausage\n3 ears fresh corn"
    },
    {
      "id": 1,
      "primary_message": "Combine horseradish, vinegar, ketchup, mayonnaise and Sriracha in a small bowl. Cover and refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring water, beer, Old Bay, cayenne, bay leaves, 1/2 tablespoon kosher salt, lemon juice, reserved lemon halves, and garlic to a boil in a large stockpot over high heat. Skim foam from top. Add potatoes, cover and cook 10 minutes (see note). Add smoked sausage and boil for another 4 minutes before adding corn. Cook for 7 more minutes, then add shrimp and cook until shrimp just turns pink and is no longer translucent, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Immediately drain cooking liquid using a colander and discard lemons and bay leaves. Pour potatoes, corn, sausage, and shrimp into a large serving bowl, platter, or on top of a paper-covered table. Sprinkle with additional Old Bay, if desired, and serve with prepared sauce, Tabasco, and napkins.",
      "secondary_message": null
    }
  ],
