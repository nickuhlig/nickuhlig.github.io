  "instructions": [
    {
      "id": 491795,
      "primary_message": "Place yogurt, mayo, chili-garlic sauce, and salt in a small bowl. Stir to combine the aioli and set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 tbsp chili-garlic sauce\n3 pinch salt"
    },
    {
      "id": 491796,
      "primary_message": "Wash, dry, and slice tomatoes crosswise into thin rounds. Place on a plate.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 491797,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the tomato.",
      "secondary_message": "1 ½ avocados"
    },
    {
      "id": 491798,
      "primary_message": "Slice eggs crosswise and add to the plate. Season tomato, avocado, and eggs with salt and pepper.",
      "secondary_message": "6 hard-cooked eggs, peeled\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 491799,
      "primary_message": "Split and toast muffins (if desired).",
      "secondary_message": "6 English muffins"
    },
    {
      "id": 491800,
      "primary_message": "To assemble the sandwiches, spread muffin halves with aioli. Layer the bottom halves with avocado, tomato, and egg, then close with the top halves.",
      "secondary_message": null
    },
    {
      "id": 491801,
      "primary_message": "To serve, divide sandwiches between plates and enjoy!",
      "secondary_message": null
    }
  ],
