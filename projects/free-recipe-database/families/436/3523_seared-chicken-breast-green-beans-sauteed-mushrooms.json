  "instructions": [
    {
      "id": 37467,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg green beans\n0.227 kg white mushrooms\n1 lemon"
    },
    {
      "id": 37468,
      "primary_message": "Trim and discard the ends of the green beans; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 37469,
      "primary_message": "Cut off the mushroom stem ends, then quarter the mushrooms lengthwise from cap to stem (you may need to cut them further if the mushrooms are large). Transfer everything to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 37470,
      "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds. Transfer to a small bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 37471,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic and add to the bowl with the shallot.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 37472,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 37473,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 37474,
      "primary_message": "Season the chicken with salt and pepper on both sides.",
      "secondary_message": "1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 37475,
      "primary_message": "Once the skillet is heated, add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 37476,
      "primary_message": "Add the chicken to the skillet and cook until it is cooked through and golden brown, 2 to 3 minutes per side. Once done, transfer the chicken to a plate and loosely cover with foil.",
      "secondary_message": null
    },
    {
      "id": 37477,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 37478,
      "primary_message": "Juice the lemon into a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 37479,
      "primary_message": "Once the chicken has been transferred, add more butter to the skillet, followed by the shallot, garlic, and mushrooms; season with salt and pepper. Cook, stirring occasionally, until the mushrooms have softened, 5 to 7 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 37480,
      "primary_message": "Once the water in the saucepan is boiling, season with salt and add in the green beans. Cook the beans until they are bright green and tender-crisp, 3 to 4 minutes.",
      "secondary_message": "2 tsp salt"
    },
    {
      "id": 37481,
      "primary_message": "Once the beans are cooked, drain them in a colander and rinse under cold water to stop the cooking process. Set aside to drain.",
      "secondary_message": null
    },
    {
      "id": 37482,
      "primary_message": "Add additional butter and the lemon juice to the skillet. Stir together, scraping up any browned bits from the bottom of the skillet, until the butter has melted.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 37483,
      "primary_message": "To serve, place the chicken and green beans on a plate and spoon the lemon butter and sautéed mushrooms over top. Enjoy!",
      "secondary_message": null
    }
  ],
