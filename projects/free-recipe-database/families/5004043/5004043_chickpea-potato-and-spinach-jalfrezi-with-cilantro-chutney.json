  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the garlic on a microplane grater. Grate the ginger on a microplane grater. Finely dice the red pepper. Peel, seed, and roughly chop the plum tomatoes. Roughly chop the curly spinach. Juice the lime. Pick the fresh cilantro leaves.",
      "secondary_message": "3 cloves garlic\n1 tbsp ginger root\n1 small red pepper\n2 small plum tomatoes\n8 oz curly spinach\n1 lime\n2 cups fresh cilantro leaves, tender stems"
    },
    {
      "id": 1,
      "primary_message": "Place potatoes in a large saucepan and cover with water by 1-inch. Season to taste with salt. Bring to a boil and simmer until potatoes are tender but not falling apart, about 10 minutes. Drain and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large heavy-bottomed saucepan or Dutch oven, heat oil over medium-high heat until shimmering. Add grated onion, garlic, ginger, chiles, cilantro stems, and red pepper, and cook, stirring frequently, until most of the moisture has evaporated and mixture is beginning to brown, about 10 minutes. Add turmeric, coriander, cumin, and paprika, and cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add chopped tomatoes, chickpeas, spinach, 1/2 cup of water, and cooked potatoes. Stir until spinach wilts. Add half of lime juice and season to taste with salt. reduce heat to lowest setting, cover, and keep warm while making chutney.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the Chutney: Combine cilantro, garlic, chile and remaining lime juice in a blender or in the cup of a hand blender and add 1/3 cup water. Blend until smooth, scraping down sides and adding water as necessary. Season to taste with salt.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add more liquid to jalfrezi if necessary and serve with chutney and steamed basmati rice or naan.",
      "secondary_message": null
    }
  ],
