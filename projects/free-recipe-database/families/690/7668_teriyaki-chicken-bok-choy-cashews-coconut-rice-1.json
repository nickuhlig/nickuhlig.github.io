  "instructions": [
    {
      "primary_message": "Heat a medium saucepan over high heat. Add coconut milk, water, and salt and bring to a boil.",
      "secondary_message": "1 (13.5 fl oz) can coconut milk\nsalt"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir in the rice, and reduce the heat to low. Cover and cook until the rice is tender and all liquid has been absorbed, about 12 minutes.",
      "secondary_message": "1 cup basmati rice"
    },
    {
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger.",
      "secondary_message": "6 cloves garlic\n2 (1 inch) pieces ginger root"
    },
    {
      "primary_message": "In a medium bowl, create a slurry by whisking together water and cornstarch until smooth. Add soy sauce, honey, and the minced garlic and ginger to make the teriyaki sauce.",
      "secondary_message": "2 tsp cornstarch\n2 tbsp honey"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Cut the chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "1 lb chicken breasts, boneless skinless\nsalt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom. Add the chicken and cook until browned and cooked through, 4-5 minutes.",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "primary_message": "Wash bok choy, trim ends, and chop into 1-inch pieces.",
      "secondary_message": "16 baby bok choy"
    },
    {
      "primary_message": "Add the bok choy to the skillet; cook, tossing frequently, until the bok choy is wilted and tender, 2-4 minutes. Add the teriyaki sauce. Cook, stirring often, until the sauce is slightly thickened, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide the rice between bowls, top with the stir fry, and sprinkle with cashews. Enjoy!",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    }
  ],
