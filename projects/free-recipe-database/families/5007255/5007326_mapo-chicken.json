  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the garlic. Grate the ginger. Slice the green onions.",
      "secondary_message": "5 cloves garlic\n1 (2 ½ cm) piece ginger\n1 bunch green onions, divided"
    },
    {
      "id": 1,
      "primary_message": "In small bowl, whisk cornstarch with chicken stock until combined; set aside. Heat Sichuan peppercorns in wok (or 30-cm non-stick skillet) over medium heat until fragrant, about one minute. Transfer to a mortar and pestle and pound until finely ground; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in wok over medium-high heat until smoking. Add garlic and ginger and cook until fragrant, about 15 seconds. Add chicken and chili paste and cook, stirring, until chicken is cooked through, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in the chili powder, wine, soy sauce, and cornstarch mixture. Bring to boil to thicken. Stir in ground Sichuan peppercorns, chili oil, and half of the green onions. Serve immediately with rice on the side and garnish with remaining green onions.",
      "secondary_message": null
    }
  ],
