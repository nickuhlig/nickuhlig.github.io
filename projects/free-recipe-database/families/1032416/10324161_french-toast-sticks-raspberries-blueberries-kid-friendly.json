  "instructions": [
    {
      "primary_message": " Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, place eggs, milk, sugar, vanilla, and spices in a medium bowl; whisk to combine. Add flour and baking powder, then whisk once more until batter is smooth. ",
      "secondary_message": "¼ cup whole milk\n1 tbsp granulated sugar\n¼ tsp vanilla\n½ tsp cinnamon, ground\n¼ tsp salt\n⅛ tsp nutmeg, ground\n¼ cup all-purpose flour\n1 tsp baking powder"
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, dip bread in batter, allowing excess to drip off. Add bread to the skillet and cook, flipping halfway through, until golden brown on both sides, 3-4 minutes. Transfer to a cutting board and slice each piece into 4 \"sticks.\"",
      "secondary_message": "1 tbsp butter, unsalted\n6 slice brioche bread"
    },
    {
      "primary_message": "Meanwhile, wash and dry raspberries and blueberries.",
      "secondary_message": "1 (170 g) pkg raspberries\n1 (170 g) pkg blueberries"
    },
    {
      "primary_message": "Divide French toast sticks and berries between plates. Using a fine mesh strainer, lightly dust the sticks with powdered sugar. Serve with a side of maple syrup for dipping and enjoy!",
      "secondary_message": "¼ cup powdered sugar\n½ cup pure maple syrup"
    }
  ],
