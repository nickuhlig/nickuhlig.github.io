  "instructions": [
    {
      "id": 95231,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 95232,
      "primary_message": "Wash and dry the fresh produce (skip the spinach if it came pre-washed).",
      "secondary_message": "1 ½ lb cremini mushrooms\n2 (5 oz) pkgs baby spinach\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 95233,
      "primary_message": "Medium dice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 95234,
      "primary_message": "Preheat a medium saucepan over medium heat; add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 95235,
      "primary_message": "Add the mushrooms and let cook for 5 minutes, stirring occasionally. Season with salt and pepper.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 95236,
      "primary_message": "Peel and mince the garlic. Peel and small dice the shallot.",
      "secondary_message": "4 cloves garlic\n2 shallots"
    },
    {
      "id": 95237,
      "primary_message": "Add shallots, oregano, basil, and half the garlic to the saucepan with the mushrooms and cook for 5 more minutes.",
      "secondary_message": "1 tsp oregano\n1 tsp basil"
    },
    {
      "id": 95238,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 95239,
      "primary_message": "Add the tomato sauce to the saucepan with the mushroom mixture and let simmer on low for 5 more minutes.",
      "secondary_message": "2 (8 oz) cans tomato sauce"
    },
    {
      "id": 95240,
      "primary_message": "Once the water comes to a boil, add the potato gnocchi to the pot and cook, uncovered, for 2 minutes, or until the gnocchi begin to float on the surface. Drain the gnocchi.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi"
    },
    {
      "id": 95241,
      "primary_message": "Preheat a large non-stick skillet over medium heat. Add the oil, remaining garlic, spinach, and sliced almonds. Cover with a lid and cook for 2-3 minutes, stirring occasionally, until the spinach begins to wilt.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 cup almonds, sliced"
    },
    {
      "id": 95242,
      "primary_message": "To serve, divide the gnocchi into bowls and top with tomato sauce and parsley. Arrange the sautéed spinach and almonds on the side. Enjoy!",
      "secondary_message": null
    }
  ],
