  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the red onion. Juice the limes.",
      "secondary_message": "1 red onion\n3 limes"
    },
    {
      "id": 1,
      "primary_message": "Place onion, peppercorns, allspice, and bay leaves in a small saucepan and cover with water. Bring to a boil over high heat. Remove from heat, drain carefully, and transfer onions to a sealable container, such as a Mason jar.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add grapefruit, orange, and lime juice. Onions should be submerged at this point; if they aren't, top off with extra lime juice. Stir to combine, season to taste with salt (they should be quite salty—use about 1 teaspoon of kosher salt or 1/2 teaspoon of table salt), cover, and refrigerate until color deepens, about 2 hours. Onions can be stored in the refrigerator for up to 2 weeks. Do not eat peppercorns, allspice berries, or bay leaves.",
      "secondary_message": null
    }
  ],
