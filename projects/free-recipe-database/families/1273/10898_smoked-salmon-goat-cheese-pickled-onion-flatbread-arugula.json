  "instructions": [
    {
      "id": 191821,
      "primary_message": "Set goat cheese on the counter and let it come to room temperature.",
      "secondary_message": "2 (4 oz) logs goat cheese"
    },
    {
      "id": 191822,
      "primary_message": "Peel and thinly slice onion into half rings. Place in a large bowl along with vinegar and salt. Stir to combine and set aside for 10 minutes.",
      "secondary_message": "1 medium red onion\n¼ cup white wine vinegar\n1 tsp salt"
    },
    {
      "id": 191823,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 191824,
      "primary_message": "Toast the flatbreads if desired.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 191825,
      "primary_message": "Spread flatbreads with goat cheese and top with salmon, capers, and half the pickled onions.",
      "secondary_message": "2 (4 oz) pkgs smoked salmon\n2 tbsp capers"
    },
    {
      "id": 191826,
      "primary_message": "Add oil, salt, and pepper to the bowl with the remaining onions and stir to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 191827,
      "primary_message": "Wash and dry the arugula. (Skip if it came pre-washed.) Add to the bowl with the dressing.",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 191828,
      "primary_message": "Add tomatoes to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 191829,
      "primary_message": "Divide flatbreads and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
