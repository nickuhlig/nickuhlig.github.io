  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place cookies in a resealable plastic bag and have fun crushing them into \"dirt.\" (Use your hands, a flat-bottomed glass, rolling pin, or small saucepan to help!) Transfer to a small bowl and set aside. \n\n",
      "secondary_message": "6 vanilla creme chocolate sandwich cookies"
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "¼ (16 oz) pkg strawberries\n1 kiwifruit\n½ (6 oz) pkg blueberries"
    },
    {
      "primary_message": "Trim strawberries. Trim and peel kiwi. Cut both into a variety of different shapes (triangles, half-moons, thin slices). Place cut fruit on a plate, along with the blueberries, and set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place pretzel sticks, dried cranberries, and pumpkin seeds each in their own additional small bowls. \n\n",
      "secondary_message": "½ cup pretzel sticks\n¼ cup dried cranberries\n¼ cup pumpkin seeds"
    },
    {
      "primary_message": "Remove graham crackers from their sleeves (keeping them as long rectangles) and evenly spread with cream cheese. Sprinkle some cookie crumb dirt at the bottom, then create flowers out of the pretzels, fruit, and pumpkin seeds. Get creative and have fun! \n\n",
      "secondary_message": "½ (12 oz) pkg whipped cream cheese spread"
    },
    {
      "primary_message": "Divide decorated graham crackers between plates and enjoy!",
      "secondary_message": null
    }
  ],
