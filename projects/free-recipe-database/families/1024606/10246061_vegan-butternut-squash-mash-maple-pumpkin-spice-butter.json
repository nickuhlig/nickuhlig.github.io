  "instructions": [
    {
      "primary_message": "Wash, dry, trim, and peel each squash; halve lengthwise, scrape out the seeds, and medium dice. Place squash in a large pot and cover with hot water (from the tap). Cover and bring to a boil over high heat; once boiling, reduce to a simmer and cook until soft, about 12 minutes.",
      "secondary_message": "2 small butternut squash"
    },
    {
      "primary_message": "Meanwhile, preheat a small saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the saucepan is hot, add vegan butter, maple syrup, and spices; cook, stirring occasionally, until bubbling and foamy, about 2 minutes. Remove from heat. ",
      "secondary_message": "½ cup vegan butter, plant-based\n3 tbsp pure maple syrup\n1 ½ tsp pumpkin spice mix\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "When the squash is done, drain in a colander and return to the pot. Add half of the maple-butter (reserving the rest for serving); mash until smooth and creamy. (Alternatively, you can place these ingredients in the bowl of a stand mixer with a paddle attachment; mix on medium-low speed until smooth and creamy, 1-2 minutes.)",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer mashed squash to a serving dish. Drizzle with reserved maple-butter and enjoy!",
      "secondary_message": null
    }
  ],
