  "instructions": [
    {
      "id": 1,
      "primary_message": "Place cucumber, mint leaves, and sugar in the bottom of a cocktail shaker. Muddle with a muddler until the sugar is dissolved, about 1 minute. Fill shaker with cracked ice and add remaining ingredients. Stir for 1 minute, then strain into chilled coupe or martini glass garnished with additional cucumber and mint.",
      "secondary_message": null
    }
