  "instructions": [
    {
      "id": 132050,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 lemon\n¼ small pkg fresh mint\n½ English cucumber\n½ pint grape tomatoes"
    },
    {
      "id": 132051,
      "primary_message": "Drain and rinse the chickpeas in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 132052,
      "primary_message": "Peel and mince shallot. Peel and mince garlic. Add chickpeas, shallot, and garlic to a medium bowl; mash the beans with a fork or potato masher until beans are broken down.",
      "secondary_message": "½ shallot\n1 clove garlic"
    },
    {
      "id": 132053,
      "primary_message": "Peel the carrot, then trim off the ends. Coarsely grate the carrots and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 132054,
      "primary_message": "Add egg, bread crumbs, and spices to the bowl and stir ingredients to combine. Mash the beans with a fork or potato masher once more, until a cohesive mixture is formed. ",
      "secondary_message": "1 egg\n2 tbsp panko bread crumbs\n¼ tsp salt\n⅛ tsp cayenne pepper\n½ tsp coriander\n½ tsp cumin\n⅛ tsp cinnamon"
    },
    {
      "id": 132055,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 132056,
      "primary_message": "Divide chickpea mixture into 8 portions. Using your hands, form each portion into a ball, then flatten into a 2-inch diameter patty. ",
      "secondary_message": null
    },
    {
      "id": 132057,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Place the chickpea patties in the skillet and cook until crispy and golden in color, about 5 minutes per side. Once done, transfer to a plate to cool slightly.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 132058,
      "primary_message": "Juice the lemon into the blender. ",
      "secondary_message": null
    },
    {
      "id": 132059,
      "primary_message": "Pick mint leaves off the stems; discard the stems and coarsely chop the leaves; add to the blender. ",
      "secondary_message": null
    },
    {
      "id": 132060,
      "primary_message": "Peel the garlic. Add garlic, tahini, and salt to the blender, and blend on high for 1-2 minutes to make a smooth sauce. Thin the sauce with 1-2 tbsp of cold water if necessary. ",
      "secondary_message": "1 clove garlic\n¼ cup tahini\n¼ tsp salt"
    },
    {
      "id": 132061,
      "primary_message": "Toast the pita bread if desired, then slice into quarters. ",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 132062,
      "primary_message": "Trim off and discard the ends of the cucumber; slice the cucumber crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 132063,
      "primary_message": "Halve the grape tomatoes crosswise. ",
      "secondary_message": null
    },
    {
      "id": 132064,
      "primary_message": "To serve, divide pita bread, chickpea patties, cucumbers and tomatoes between dishes and serve with a side of minty tahini sauce. Enjoy!",
      "secondary_message": null
    }
  ],
