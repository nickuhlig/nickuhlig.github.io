  "instructions": [
    {
      "id": 359334,
      "primary_message": "Peel and slice shallot crosswise into thin rings. Place in a medium bowl, drizzle with vinaigrette, and set aside to soften.",
      "secondary_message": "½ shallot\n2 tbsp French vinaigrette"
    },
    {
      "id": 359335,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ avocado\n½ yellow bell pepper\n1 tomato\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 359336,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 359337,
      "primary_message": "Trim, seed, and slice bell pepper into thin strips. Add to the plate with the avocado.",
      "secondary_message": null
    },
    {
      "id": 359338,
      "primary_message": "Slice tomato into thin rounds and add to the plate; set aside.",
      "secondary_message": null
    },
    {
      "id": 359339,
      "primary_message": "Place mayo and chili-garlic sauce in a small bowl. Stir to combine the spicy mayo.",
      "secondary_message": "1 ½ tbsp mayonnaise\n1 tsp chili-garlic sauce"
    },
    {
      "id": 359340,
      "primary_message": "Place tortillas on a flat surface and spread with a layer of spicy mayo. Divide avocado, bell pepper, tomato, turkey, and prosciutto between wraps. Roll tightly to close, then cut in half.",
      "secondary_message": "2 large flour tortillas\n8 oz oven roasted turkey breast, sliced\n4 slices prosciutto"
    },
    {
      "id": 359341,
      "primary_message": "Add mixed greens to the bowl with the shallot and dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 359342,
      "primary_message": "To serve, divide wraps and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
