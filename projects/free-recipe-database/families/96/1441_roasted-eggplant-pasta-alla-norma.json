  "instructions": [
    {
      "id": 12679,
      "primary_message": "Preheat oven to 218°C (425°F).",
      "secondary_message": ""
    },
    {
      "id": 12680,
      "primary_message": "Wash and large dice eggplant. Transfer to a sheet pan. Drizzle with oil and season with oregano, salt, and pepper; toss to coat.",
      "secondary_message": "1 eggplant\n2 tbsp extra virgin olive oil\n½ tsp oregano\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 12681,
      "primary_message": "Place in the oven and, stirring halfway though, bake until softened and browned, about 20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 12682,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "about 7 cups water\n1 tbsp salt\n170 g (1 quarter coin = 56 g) linguine pasta"
    },
    {
      "id": 12683,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 12684,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "½ medium yellow onion\r\n3 cloves garlic"
    },
    {
      "id": 12685,
      "primary_message": "Coat bottom of pan with oil. Add onion and, stirring frequently, cook until softened, 4-5 minutes.",
      "secondary_message": "about 1 tbsp extra virgin olive oil"
    },
    {
      "id": 12686,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 12687,
      "primary_message": "Add garlic and pepper to pan. Stir until fragrant, 15-30 seconds.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 12688,
      "primary_message": "Add tomatoes, vinegar, sugar, spices, and ½ of the basil (save the rest for garnishing). Cook for 4-6 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n½ tsp white wine vinegar\n1 pinch brown sugar\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 12690,
      "primary_message": "Drain pasta and add to pan with tomatoes. Add eggplant and toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 12691,
      "primary_message": "To serve, place pasta in a shallow bowl or on a plate and garnish with remaining basil. Enjoy!",
      "secondary_message": ""
    }
  ],
