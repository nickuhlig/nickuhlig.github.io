  "instructions": [
    {
      "id": 74992,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 74991,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n3 yellow bell peppers\n1 ½ small pkg fresh basil"
    },
    {
      "id": 74990,
      "primary_message": "Place the sausages on a plate and rub with a little olive oil.",
      "secondary_message": "9 pork sausages\n1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 74989,
      "primary_message": "Once the grill pan / skillet is hot, add the sausages and reduce the heat to medium. Cook, turning occasionally, until the sausages are cooked through, 12 to 15 minutes. Once done, transfer to a plate and cover with foil to keep warm.",
      "secondary_message": ""
    },
    {
      "id": 74988,
      "primary_message": "While the sausages cook, pick the basil leaves off the stems; discard the stems and mince the leaves. Transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 74987,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 74986,
      "primary_message": "To the basil and garlic, add olive oil, balsamic vinegar, salt, and pepper; whisk together.",
      "secondary_message": "3 tbsp extra virgin olive oil\n6 tbsp balsamic vinegar\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 74985,
      "primary_message": "Trim off and discard the ends of the zucchinis; halve the zucchinis crosswise, then cut each half lengthwise into 4 to 6 wedges. Add to the bowl with the marinade.",
      "secondary_message": ""
    },
    {
      "id": 74984,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Cut each quarter into thirds lengthwise and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 74983,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; cut lengthwise into 1 ¼-cm-thick wedges and add to the bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 74982,
      "primary_message": "Gently toss the vegetables until evenly coated with the marinade.",
      "secondary_message": ""
    },
    {
      "id": 74981,
      "primary_message": "Once the sausages have been transferred, add the vegetables to the grill pan / skillet. Cook, tossing occasionally, until they are tender and charred, 5 to 8 minutes. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 74980,
      "primary_message": "Cut the sausages at an angle into 2 ½-cm pieces.",
      "secondary_message": ""
    },
    {
      "id": 74979,
      "primary_message": "To serve, divide the grilled sausages and vegetables between plates. Enjoy!",
      "secondary_message": ""
    }
  ],
