  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and cut the parsnips into 1-inch pieces. Peel and cut the carrots into 1-inch pieces. Zest the lemon. Mince or grate the peeled fresh ginger on a Microplane.",
      "secondary_message": "2 large parsnips\n8 medium carrots\n1 lemon\n1 (5 cm) knob peeled fresh ginger"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 120°C (250°F) and adjust oven rack to center position. Season pork roast liberally with salt and pepper. In a small bowl, mix together smoked paprika, brown sugar, and garlic powder. Rub spice mixture all over pork.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place pork on a wire rack set in a rimmed baking sheet. Transfer to oven and roast until internal temperature reaches 60°C (140°F), about 2 hours. Remove from oven and tent with foil for at least 15 minutes and up to 45 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Increase oven temperature to 260°C (500°F). Bring a medium pot of salted water to a boil and cook parsnips and carrots until crisp-tender, about 3 minutes. Drain well. In a large bowl, toss parsnips, carrots, radishes, and turnips with just enough olive oil to coat. Arrange in a single even layer on 2 rimmed baking sheets and/or a large baking dish or roasting pan and roast until vegetables are browned and tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Return roast to oven and cook until crisp and browned on the exterior, about 10 minutes. Remove from oven, tent with foil, and allow to rest for 15 minutes. Return vegetables to bowl, drizzle lightly with fresh olive oil, and toss with parsley, lemon zest, and ginger. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Carve roast by slicing between each rib. Serve with roasted vegetables and tapenade sauce.",
      "secondary_message": null
    }
  ],
