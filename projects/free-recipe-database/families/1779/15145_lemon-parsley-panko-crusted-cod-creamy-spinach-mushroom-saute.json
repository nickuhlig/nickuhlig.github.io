  "instructions": [
    {
      "id": 250048,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 250049,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 small bunch Italian (flat-leaf) parsley\n0.45 kg cremini mushrooms\n2 (142 g) pkg baby spinach"
    },
    {
      "id": 250050,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 250051,
      "primary_message": "While the skillet heats up, peel and mince shallots.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 250052,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Zest and juice lemon into the skillet; add half the shallot (reserving the rest for later) and cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 250053,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 250054,
      "primary_message": "Add parsley, bread crumbs, salt, and pepper to the skillet. Cook, stirring frequently, until bread crumbs begin to brown, 3-4 minutes. Remove skillet from the heat.",
      "secondary_message": "½ cup panko bread crumbs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 250055,
      "primary_message": "Pat the cod dry with paper towels and place on a baking sheet pan. Coat the top side of each fillet with mayo, then press the bread crumb mixture on top to form a crust. (Reserve skillet for later use.)",
      "secondary_message": "0.68 kg cod fillet\n2 tbsp mayonnaise"
    },
    {
      "id": 250056,
      "primary_message": "Place baking sheet in the oven and bake until the fish is cooked through and flaky, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 250057,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 250058,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat.",
      "secondary_message": null
    },
    {
      "id": 250059,
      "primary_message": "Once the skillet is hot, add more butter and swirl to coat the bottom. Add remaining shallot, mushrooms, salt, and pepper to the skillet; cook, stirring often, until veggies start to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 250060,
      "primary_message": "Meanwhile, cut cream cheese into small pieces.",
      "secondary_message": "1 (227 g) block cream cheese"
    },
    {
      "id": 250061,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 250062,
      "primary_message": "Add cream cheese and cream to the skillet; stir until combined and warmed through, 2-3 minutes. Remove from heat.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 250063,
      "primary_message": "To serve, divide baked cod and veggie sauté between bowls or plates. Enjoy!",
      "secondary_message": null
    }
  ],
