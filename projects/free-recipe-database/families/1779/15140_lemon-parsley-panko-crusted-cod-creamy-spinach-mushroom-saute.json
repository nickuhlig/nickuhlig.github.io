  "instructions": [
    {
      "id": 249968,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 249969,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lb cremini mushrooms\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 249970,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 249971,
      "primary_message": "While the pot heats up, peel and mince onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 249972,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Zest and juice lemons into the pot; add half the onion (reserving the rest for later) and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 249973,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 249974,
      "primary_message": "Add parsley, bread crumbs, salt, and pepper to the pot. Cook, stirring frequently, until bread crumbs begin to brown, 4-5 minutes. Remove pot from the heat.",
      "secondary_message": "¾ cup panko bread crumbs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 249975,
      "primary_message": "Pat the cod dry with paper towels and place on a large baking sheet pan. Coat the top side of each fillet with mayo, then press the bread crumb mixture on top to form a crust. (Reserve pot for later use.)",
      "secondary_message": "2 ¼ lb cod fillet\n3 tbsp mayonnaise"
    },
    {
      "id": 249976,
      "primary_message": "Place baking sheet in the oven and bake until the fish is cooked through and flaky, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 249977,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 249978,
      "primary_message": "Wipe the pot clean with paper towels and return to medium heat.",
      "secondary_message": null
    },
    {
      "id": 249979,
      "primary_message": "Once the pot is hot, add more butter and swirl to coat the bottom. Add remaining onion, mushrooms, salt, and pepper to the pot; cook, stirring often, until veggies start to soften, 5-6 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 249980,
      "primary_message": "Meanwhile, cut cream cheese into small pieces.",
      "secondary_message": "1 ½ (8 oz) blocks cream cheese"
    },
    {
      "id": 249981,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 249982,
      "primary_message": "Add cream cheese and cream to the pot; stir until combined and warmed through, 3-4 minutes. Remove from heat.",
      "secondary_message": "6 fl oz (¾ cup) heavy whipping cream"
    },
    {
      "id": 249983,
      "primary_message": "To serve, divide baked cod and veggie sauté between bowls or plates. Enjoy!",
      "secondary_message": null
    }
  ],
