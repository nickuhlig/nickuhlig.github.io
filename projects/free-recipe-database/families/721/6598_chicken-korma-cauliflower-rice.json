  "instructions": [
    {
      "id": 86587,
      "primary_message": "Pat the chicken dry with paper towels, cut into bite-sized (1-inch) pieces, and set aside.",
      "secondary_message": "⅓ kg chicken thighs, boneless skinless"
    },
    {
      "id": 86588,
      "primary_message": "Peel and small dice onion. Peel and mince (or press) garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 86589,
      "primary_message": "Heat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 86590,
      "primary_message": "Wash, peel, and mince or grate ginger.",
      "secondary_message": "1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 86591,
      "primary_message": "Once the saucepan is hot, add coconut oil and swirl to coat the bottom. Add the onions, garlic, and ginger; cook, stirring constantly until onions are softened, 3 to 4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 86592,
      "primary_message": "Add the spices and cook, stirring constantly, until fragrant, 30 seconds.",
      "secondary_message": "2 tsp curry powder\n1 ½ tsp cumin\n½ tsp turmeric\n½ tsp chili powder"
    },
    {
      "id": 86593,
      "primary_message": "Add canned tomatoes, chicken, salt, and pepper; stir until well combined. Bring to a boil and then reduce heat to medium, cover and cook until chicken is cooked through, about 10 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 86594,
      "primary_message": "While the chicken cooks, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 86595,
      "primary_message": "Wash the cauliflower and remove the leaves. Using a food processor or box grater, grate to rice-like texture.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 86596,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add cauliflower and cook, stirring occasionally, 5 to 7 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 86597,
      "primary_message": "Meanwhile, add the heavy cream and almond flour to the chicken mixture. Uncover and cook for another 5 minutes, stirring occasionally.",
      "secondary_message": "59 ml heavy cream\n1 tbsp almond meal/flour"
    },
    {
      "id": 86598,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Set some cilantro aside to use as garnish.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 86599,
      "primary_message": "When cooked, remove the cauliflower from the heat, add remaining cilantro, salt, and pepper and stir to combine.",
      "secondary_message": "¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 86600,
      "primary_message": "To serve, place cauliflower rice on a plate and top with chicken korma. Garnish with cilantro and enjoy!",
      "secondary_message": null
    }
  ],
