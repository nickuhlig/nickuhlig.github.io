  "instructions": [
    {
      "id": 1,
      "primary_message": "In a mixing bowl, season tomatoes with 1/4 teaspoon salt and toss to coat. Transfer tomatoes to a fine-mesh strainer and set over bowl. Set aside to drain for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a small bowl, whisk together vinegar, oil, lemon juice, lemon zest, and mustard. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Combine tomatoes, arugula, cilantro, mozzarella, parsley, basil, mint, both olives, and thyme in a large bowl. Add dressing to salad and toss thoroughly. Serve immediately.",
      "secondary_message": null
    }
  ],
