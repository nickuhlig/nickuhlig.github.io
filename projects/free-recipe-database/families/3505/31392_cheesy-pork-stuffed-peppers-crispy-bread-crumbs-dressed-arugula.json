  "instructions": [
    {
      "id": 495907,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 495908,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 red bell peppers\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 495909,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495910,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 495911,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-7 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 ¼ lb lean ground pork\n1 ½ tsp onion powder\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 495912,
      "primary_message": "While the pork is cooking, juice lemons into a large bowl. Add oil, Dijon, honey, and salt, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n½ tsp salt"
    },
    {
      "id": 495913,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 495914,
      "primary_message": "Finely grate Parmesan. When the pork is done, add Parmesan to the skillet, along with the reserved parsley, and stir to combine the filling. Remove from heat.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 495915,
      "primary_message": "Stuff peppers with pork filling, then top with bread crumbs. Return baking sheet to the oven and continue to broil until bread crumbs are toasted, 1 minute more. Remove from oven.",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 495916,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 495917,
      "primary_message": "To serve, divide stuffed peppers and arugula between plates. Enjoy!",
      "secondary_message": null
    }
  ],
