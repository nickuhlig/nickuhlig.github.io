  "instructions": [
    {
      "id": 496072,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 496073,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.) ",
      "secondary_message": "6 red bell peppers\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 496074,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 496075,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496076,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ tsp onion powder\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 496077,
      "primary_message": "While the veggie ground is cooking, juice lemons into a large bowl. Add oil, Dijon, honey, and salt, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n½ tsp salt"
    },
    {
      "id": 496078,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 496079,
      "primary_message": "Finely grate Parmesan. When the veggie ground is done, add Parmesan to the skillet, along with the reserved parsley, and stir to combine the filling. Remove from heat.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 496080,
      "primary_message": "Stuff peppers with veggie ground filling, then top with bread crumbs. Return baking sheet to the oven and continue to broil until bread crumbs are toasted, 1 minute more. Remove from oven.",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 496081,
      "primary_message": "Meanwhile, add arugula and pumpkin seeds to the bowl with the dressing. Toss to combine.",
      "secondary_message": "¾ cup pumpkin seeds"
    },
    {
      "id": 496082,
      "primary_message": "To serve, divide stuffed peppers and arugula between plates. Enjoy!",
      "secondary_message": null
    }
  ],
