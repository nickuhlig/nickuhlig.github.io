  "instructions": [
    {
      "id": 496028,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 496029,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 red bell peppers\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 496030,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 496031,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496032,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n0.68 kg lean ground pork\n1 tsp onion powder\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 496033,
      "primary_message": "While the pork is cooking, juice lemon into a medium bowl. Add oil, Dijon, honey, and salt, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt"
    },
    {
      "id": 496034,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 496035,
      "primary_message": "Finely grate Parmesan. When the pork is done, add Parmesan to the skillet, along with the reserved parsley, and stir to combine the filling. Remove from heat.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 496036,
      "primary_message": "Stuff peppers with pork filling, then top with bread crumbs. Return baking sheet to the oven and continue to broil until bread crumbs are toasted, 1 minute more. Remove from oven.",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 496037,
      "primary_message": "Meanwhile, add arugula to the bowl with the dressing and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 496038,
      "primary_message": "To serve, divide stuffed peppers and arugula between plates. Enjoy!",
      "secondary_message": null
    }
  ],
