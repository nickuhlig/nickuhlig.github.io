  "instructions": [
    {
      "id": 496061,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 496062,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.) ",
      "secondary_message": "4 red bell peppers\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 496063,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 496064,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 496065,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n1 tsp onion powder\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 496066,
      "primary_message": "While the veggie ground is cooking, juice lemon into a medium bowl. Add oil, Dijon, honey, and salt, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt"
    },
    {
      "id": 496067,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing and set aside. (Reserve remaining parsley for the next step.)",
      "secondary_message": null
    },
    {
      "id": 496068,
      "primary_message": "Finely grate Parmesan. When the veggie ground is done, add Parmesan to the skillet, along with the reserved parsley, and stir to combine the filling. Remove from heat.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 496069,
      "primary_message": "Stuff peppers with veggie ground filling, then top with bread crumbs. Return baking sheet to the oven and continue to broil until bread crumbs are toasted, 1 minute more. Remove from oven.",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 496070,
      "primary_message": "Meanwhile, add arugula and pumpkin seeds to the bowl with the dressing. Toss to combine.",
      "secondary_message": "½ cup pumpkin seeds"
    },
    {
      "id": 496071,
      "primary_message": "To serve, divide stuffed peppers and arugula between plates. Enjoy!",
      "secondary_message": null
    }
  ],
