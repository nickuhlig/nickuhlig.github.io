  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the red onion. Cut the navel oranges into trimmed segments.",
      "secondary_message": "¼ small red onion\n2 navel oranges"
    },
    {
      "id": 1,
      "primary_message": "Combine the arugula, fennel, fennel fronds, and orange segments in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk mustard, honey, and vinegar. Whisking constantly, drizzle in olive oil. Season to taste with salt and pepper. Dress salad as desired (not all the dressing needs to be used). Serve immediately. Extra dressing can be stored in an airtight container in the refrigerator for up to 1 month.",
      "secondary_message": null
    }
