  "instructions": [
    {
      "id": 374015,
      "primary_message": "Place tortillas on a flat surface. Spread each tortilla with mayo.",
      "secondary_message": "6 small flour tortillas\n2 tbsp mayonnaise"
    },
    {
      "id": 374016,
      "primary_message": "Thinly slice cheese and layer over the tortilla.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 374017,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh, then slice crosswise into thin half-moons. Layer over the cheese.",
      "secondary_message": "1 ½ avocados"
    },
    {
      "id": 374018,
      "primary_message": "Thinly slice sun-dried tomatoes. Place on top of the avocado. ",
      "secondary_message": "6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 374019,
      "primary_message": "Tightly roll tortillas around the filling and secure with toothpicks (optional).",
      "secondary_message": null
    },
    {
      "id": 374020,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
