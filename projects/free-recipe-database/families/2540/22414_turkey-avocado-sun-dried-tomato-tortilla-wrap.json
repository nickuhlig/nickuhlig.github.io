  "instructions": [
    {
      "id": 374054,
      "primary_message": "Place tortillas on a flat surface. Spread each tortilla with mayo, then layer with sliced turkey.",
      "secondary_message": "2 small flour tortillas\n2 tsp mayonnaise\n113 g oven roasted turkey breast, sliced"
    },
    {
      "id": 374055,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh, then slice crosswise into thin half-moons. Layer over the turkey.",
      "secondary_message": "½ avocado"
    },
    {
      "id": 374056,
      "primary_message": "Thinly slice sun-dried tomatoes. Place on top of the avocado. ",
      "secondary_message": "2 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 374057,
      "primary_message": "Tightly roll tortillas around the filling and secure with toothpicks (optional).",
      "secondary_message": null
    },
    {
      "id": 374058,
      "primary_message": "To serve, divide wraps between plates and enjoy!",
      "secondary_message": null
    }
