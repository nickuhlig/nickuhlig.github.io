  "instructions": [
    {
      "id": 490990,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ (142 g) pkgs baby spinach\n3 (170 g) pkgs blackberries"
    },
    {
      "id": 490991,
      "primary_message": "Juice lemons into a large bowl. Add oil, Dijon, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n1 ½ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 490992,
      "primary_message": "Crumble goat cheese into the bowl with the dressing.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 490993,
      "primary_message": "Add spinach, blackberries, and almonds to the bowl. Gently toss to combine the salad.",
      "secondary_message": "2 cups almonds, sliced"
    },
    {
      "id": 490994,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
