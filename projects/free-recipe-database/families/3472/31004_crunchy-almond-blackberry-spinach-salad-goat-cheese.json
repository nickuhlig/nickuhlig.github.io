  "instructions": [
    {
      "id": 490985,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lemon\n1 (142 g) pkg baby spinach\n2 (170 g) pkgs blackberries"
    },
    {
      "id": 490986,
      "primary_message": "Juice lemon into a medium bowl. Add oil, Dijon, honey, and spices, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 490987,
      "primary_message": "Crumble goat cheese into the bowl with the dressing.",
      "secondary_message": "1 (113 g) log goat cheese"
    },
    {
      "id": 490988,
      "primary_message": "Add spinach, blackberries, and almonds to the bowl. Gently toss to combine the salad.",
      "secondary_message": "1 ¼ cups almonds, sliced"
    },
    {
      "id": 490989,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
