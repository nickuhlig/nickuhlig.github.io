  "instructions": [
    {
      "id": 14712,
      "primary_message": "Wash and dry spinach. Wash and halve tomatoes.",
      "secondary_message": "1 (5 oz) pkg baby spinach\r\n1 pint grape tomatoes"
    },
    {
      "id": 14713,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 14714,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium red onion\r\n2 cloves garlic"
    },
    {
      "id": 14715,
      "primary_message": "Coat bottom of skillet with oil. Add onion and, stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "about 2 tbsp extra virgin olive oil"
    },
    {
      "id": 14716,
      "primary_message": "In a medium bowl, whisk together eggs, oregano, salt, and pepper.",
      "secondary_message": "12 eggs\r\n½ tsp oregano\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 14717,
      "primary_message": "Preheat oven to broil and position rack about 4 inches from the top.",
      "secondary_message": ""
    },
    {
      "id": 14718,
      "primary_message": "Add garlic and tomatoes to skillet. Stir to combine and cook for 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 14719,
      "primary_message": "Add spinach and stir to combine.",
      "secondary_message": ""
    },
    {
      "id": 14720,
      "primary_message": "Spread out ingredients evenly in the skillet. Pour in egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 6-8 minutes.",
      "secondary_message": ""
    },
    {
      "id": 14721,
      "primary_message": "Sprinkle feta over top. Place skillet in the oven under the broiler until the top is set, 2-3 minutes.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 14722,
      "primary_message": "To serve, cut frittata into wedges and place on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
