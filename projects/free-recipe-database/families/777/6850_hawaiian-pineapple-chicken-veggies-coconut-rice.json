  "instructions": [
    {
      "id": 115411,
      "primary_message": "Preheat oven to 375°F. Line two large baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 115412,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 lemon\n2 green bell peppers\n2 red bell peppers\n1 small bunch cilantro\n1 small pineapple"
    },
    {
      "id": 115413,
      "primary_message": "Peel and mince the garlic. Peel and mince (or grate) the ginger.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 115414,
      "primary_message": "Juice the lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 115415,
      "primary_message": "Add garlic, ginger, soy sauce, ketchup, brown sugar, rice vinegar, Worcestershire sauce, black pepper, and cornstarch to the bowl with the lemon juice. Whisk until smooth and set aside.",
      "secondary_message": "2 tbsp soy sauce\n½ cup ketchup\n2 tbsp brown sugar\n2 tbsp rice vinegar\n2 tbsp Worcestershire sauce\n¼ tsp black pepper\n4 tsp cornstarch"
    },
    {
      "id": 115416,
      "primary_message": "Seed the bell peppers and cut into 1-inch pieces; place in the bowl with the sauce.",
      "secondary_message": null
    },
    {
      "id": 115417,
      "primary_message": "Peel and cut the onions into 1-inch pieces; add to the bowl with the bell peppers.",
      "secondary_message": "2 medium red onions"
    },
    {
      "id": 115418,
      "primary_message": "Cut the chicken into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 115419,
      "primary_message": "Add the chicken into the large bowl with the sauce and veggies. Toss to combine and spread onto the baking sheets in a single layer; bake for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 115420,
      "primary_message": "Meanwhile, heat a medium saucepan over high heat. Add coconut milk, water, and salt and bring to a boil.",
      "secondary_message": "1 (13.5 fl oz) can coconut milk\n⅔ cup water\n½ tsp salt"
    },
    {
      "id": 115421,
      "primary_message": "Cut skin off pineapple, core, and cut into bite-sized pieces and set aside. You will need about 2 cups diced.",
      "secondary_message": null
    },
    {
      "id": 115422,
      "primary_message": "Once the liquid comes to a boil, stir in the rice, and reduce the heat to low. Cover and cook until the rice is tender and all liquid has been absorbed, about 12 minutes.",
      "secondary_message": "1 cup basmati rice"
    },
    {
      "id": 115423,
      "primary_message": "Remove chicken from oven and add the pineapple to the mixture. Return to oven and bake for another 10 minutes, until chicken is cooked through.",
      "secondary_message": null
    },
    {
      "id": 115424,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 115425,
      "primary_message": "To serve, divide the rice between bowls and top with the chicken and veggies. Garnish with cilantro and enjoy!",
      "secondary_message": null
    }
  ],
