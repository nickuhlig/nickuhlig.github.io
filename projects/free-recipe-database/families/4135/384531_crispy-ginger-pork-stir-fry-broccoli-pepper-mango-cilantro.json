  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat pork dry with paper towels and slice crosswise into thin strips. Place in a medium bowl, along with cornstarch, salt, and pepper, then toss to coat.",
      "secondary_message": "4 pork chops, boneless\n4 tsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork and cook, stirring occasionally, until golden, crispy, and cooked through, 4-5 minutes. Remove to a plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 mangoes\n2 red bell peppers\n2 (1 inch) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "primary_message": "Using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "primary_message": "Return the skillet (with cooking juices) to medium-high heat. Once the skillet is hot, add veggies, mango, ginger, and garlic; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place soy sauce, water, chili-garlic sauce, and honey in the reserved bowl, then whisk to combine the sauce.",
      "secondary_message": "½ cup tamari soy sauce\n4 tsp chili-garlic sauce\n4 tsp honey"
    },
    {
      "primary_message": "When the veggies are starting to soften, add sauce to the skillet. Continue to cook, stirring occasionally, until sauce has thickened slightly, 1-2 minutes more. ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the skillet, along with the crispy pork, and stir once more to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
