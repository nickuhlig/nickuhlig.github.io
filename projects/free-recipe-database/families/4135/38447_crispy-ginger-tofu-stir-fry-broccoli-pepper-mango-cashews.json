  "instructions": [
    {
      "id": 599996,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 599997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 crowns broccoli\n2 mangoes\n2 red bell peppers\n2 (1 inch) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 599998,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 599999,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a medium bowl, along with cornstarch, salt, and pepper, then toss to coat.",
      "secondary_message": "4 tsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 600000,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, stirring occasionally, until golden brown and crispy, 5-6 minutes. Remove to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 600001,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 600002,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 600003,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 600004,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 600005,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 600006,
      "primary_message": "Return the skillet to medium-high heat. Once the skillet is hot, add veggies, mango, ginger, and garlic; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp neutral vegetable oil"
    },
    {
      "id": 600007,
      "primary_message": "Meanwhile, place soy sauce, water, chili-garlic sauce, and maple syrup in the reserved bowl, then whisk to combine the sauce.",
      "secondary_message": "½ cup soy sauce\n½ cup water\n4 tsp chili-garlic sauce\n4 tsp pure maple syrup"
    },
    {
      "id": 600008,
      "primary_message": "When the veggies are starting to soften, add sauce and cashews to the skillet. Continue to cook, stirring occasionally, until sauce has thickened slightly, 1-2 minutes more. ",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 600009,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the skillet, along with the crispy tofu, and stir once more to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 600010,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
