  "instructions": [
    {
      "id": 599936,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 599937,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n1 mango\n1 red bell pepper\n1 (1 inch) piece ginger root\n½ small bunch cilantro"
    },
    {
      "id": 599938,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 599939,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a medium bowl, along with cornstarch, salt, and pepper, then toss to coat.",
      "secondary_message": "2 tsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 599940,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, stirring occasionally, until golden brown and crispy, 5-6 minutes. Remove to a plate. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 599941,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 599942,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 599943,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 599944,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 599945,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 599946,
      "primary_message": "Return the skillet to medium-high heat. Once the skillet is hot, add veggies, mango, ginger, and garlic; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 599947,
      "primary_message": "Meanwhile, place soy sauce, water, chili-garlic sauce, and honey in the reserved bowl, then whisk to combine the sauce.",
      "secondary_message": "¼ cup soy sauce\n¼ cup water\n2 tsp chili-garlic sauce\n2 tsp honey"
    },
    {
      "id": 599948,
      "primary_message": "When the veggies are starting to soften, add sauce and cashews to the skillet. Continue to cook, stirring occasionally, until sauce has thickened slightly, 1-2 minutes more. ",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 599949,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the skillet, along with the crispy tofu, and stir once more to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 599950,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
