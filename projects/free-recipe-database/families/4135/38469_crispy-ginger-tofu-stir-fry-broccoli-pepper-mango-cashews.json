  "instructions": [
    {
      "id": 600314,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 600315,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 mangoes\n3 red bell peppers\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 600316,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 600317,
      "primary_message": "While the pot heats up, medium dice tofu. Place in a large bowl, along with cornstarch, salt, and pepper, then toss to coat.",
      "secondary_message": "2 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 600318,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, stirring occasionally, until golden brown and crispy, 5-6 minutes. Remove to a plate. (Reserve pot for later use.)",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 600319,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 600320,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 600321,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 600322,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 600323,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 600324,
      "primary_message": "Return the pot to medium-high heat. Once the pot is hot, add veggies, mango, ginger, and garlic; cook, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 600325,
      "primary_message": "Meanwhile, place soy sauce, water, chili-garlic sauce, and honey in the reserved bowl, then whisk to combine the sauce.",
      "secondary_message": "¾ cup soy sauce\n¾ cup water\n2 tbsp chili-garlic sauce\n2 tbsp honey"
    },
    {
      "id": 600326,
      "primary_message": "When the veggies are starting to soften, add sauce and cashews to the pot. Continue to cook, stirring occasionally, until sauce has thickened slightly, 2-3 minutes more. ",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 600327,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the pot, along with the crispy tofu, and stir once more to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 600328,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
