  "instructions": [
    {
      "id": 600228,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 600229,
      "primary_message": "While the pot heats up, pat pork dry with paper towels and slice crosswise into thin strips. Place in a large bowl, along with cornstarch, salt, and pepper, then toss to coat.",
      "secondary_message": "6 pork chops, boneless\n2 tbsp cornstarch\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 600230,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add pork and cook, stirring occasionally, until golden, crispy, and cooked through, 4-5 minutes. Remove to a plate. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 600231,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n3 mangoes\n3 red bell peppers\n3 (2 ½ cm) pieces ginger root\n1 small bunch cilantro"
    },
    {
      "id": 600232,
      "primary_message": "Using a clean cutting board, separate broccoli into bite-sized florets and cut stems into smaller pieces. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 600233,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice the flesh. Add to the bowl with the broccoli.",
      "secondary_message": null
    },
    {
      "id": 600234,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 600235,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 600236,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 600237,
      "primary_message": "Return the pot (with cooking juices) to medium-high heat. Once the pot is hot, add veggies, mango, ginger, and garlic; cook, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 600238,
      "primary_message": "Meanwhile, place soy sauce, water, chili-garlic sauce, and honey in the reserved bowl, then whisk to combine the sauce.",
      "secondary_message": "¾ cup soy sauce\n¾ cup water\n2 tbsp chili-garlic sauce\n2 tbsp honey"
    },
    {
      "id": 600239,
      "primary_message": "When the veggies are starting to soften, add sauce and cashews to the pot. Continue to cook, stirring occasionally, until sauce has thickened slightly, 2-3 minutes more. ",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 600240,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the pot, along with the crispy pork, and stir once more to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 600241,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
