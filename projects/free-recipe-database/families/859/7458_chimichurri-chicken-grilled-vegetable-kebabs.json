  "instructions": [
    {
      "id": 107183,
      "primary_message": "If using wooden skewers, place 18-24 skewers in a shallow dish of water to soak.",
      "secondary_message": null
    },
    {
      "id": 107184,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n3 medium zucchini squash\n⅓ kg white mushrooms\n1 ½ small bunches cilantro\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 107185,
      "primary_message": "Shave parsley and cilantro leaves off the stems; discard the stems and mince the leaves. Transfer minced leaves to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 107186,
      "primary_message": "Peel and mince garlic and add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 107187,
      "primary_message": "To make the chimichurri sauce, add olive oil, red wine vinegar, oregano, cumin, crushed red pepper, and salt to the bowl with the fresh herbs and garlic. Stir to combine. Pour half of the sauce into a small bowl and set aside.",
      "secondary_message": "¾ cup extra virgin olive oil\n⅓ cup red wine vinegar\n1 ½ tsp oregano\n¾ tsp cumin\n⅜ tsp crushed red pepper"
    },
    {
      "id": 107188,
      "primary_message": "Pat dry the chicken with paper towels and cut into 1-inch cubes. Add to the medium bowl with the chimichurri sauce and stir to coat the chicken.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 107189,
      "primary_message": "Peel and chop onion into 1-inch pieces and a large bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 107190,
      "primary_message": "Seed and medium dice the peppers. Halve zucchinis lengthwise, then slice crosswise into 1-inch half rounds. Halve the mushrooms. Add veggies to the bowl with the onions.",
      "secondary_message": null
    },
    {
      "id": 107191,
      "primary_message": "Add oil, salt, and pepper to the veggies and toss until well coated.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 107192,
      "primary_message": "Place a rack in the upper third of the oven, about 5-inches from the broiler and preheat oven to broil. Alternatively, cook kebabs on a large outdoor grill.",
      "secondary_message": null
    },
    {
      "id": 107193,
      "primary_message": "Thread the chicken and vegetables onto skewers and place on a broiler pan. Alternatively, you can cook the chicken and vegetable pieces directly on the broiler pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 107194,
      "primary_message": "Place the pan in the oven and broil until the tops of the vegetables begin to brown, 8-10 minutes. Remove pan from the oven and use tongs to flip the kebabs. Return to the oven until chicken is cooked through, 4-5 minutes. Watch kebabs closely as the broiler can cook food very quickly.",
      "secondary_message": null
    },
    {
      "id": 107195,
      "primary_message": "To serve, divide kebabs between plates, top with the remaining chimichurri sauce and enjoy!",
      "secondary_message": null
    }
  ],
