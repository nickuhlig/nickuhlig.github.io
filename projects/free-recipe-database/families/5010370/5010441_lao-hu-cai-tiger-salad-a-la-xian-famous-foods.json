  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium mixing bowl, combine celery, long hot green pepper, scallions, and chopped cilantro.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, combine rice vinegar, salt, and sugar, then stir to dissolve the salt and sugar completely. Add soy sauce and sesame oil and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour dressing over vegetables, tossing to ensure thorough distribution.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Mound vegetables on a serving plate and sprinkle dried shrimp all over the top. Serve immediately.",
      "secondary_message": null
    }
