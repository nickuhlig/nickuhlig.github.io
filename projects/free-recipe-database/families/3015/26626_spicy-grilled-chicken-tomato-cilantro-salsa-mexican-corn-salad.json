  "instructions": [
    {
      "id": 431116,
      "primary_message": "Place hot sauce, oil, honey, and spices in a medium bowl. Stir to combine the marinade.",
      "secondary_message": "1 ½ tbsp hot sauce\n1 tbsp extra virgin olive oil\n1 tbsp honey\n1 tsp garlic powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 431117,
      "primary_message": "Add chicken to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 431118,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431119,
      "primary_message": "While the pan heats up, remove husks and silks from corn. Using your hands, snap each ear in half.",
      "secondary_message": "2 ears corn"
    },
    {
      "id": 431120,
      "primary_message": "Once the pan is hot, add corn cobs and grill, rotating occasionally, until slightly charred, 4-5 minutes. Remove to a plate and allow to cool slightly. (Reserve pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 431121,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n1 small pkg grape tomatoes\n½ orange bell pepper"
    },
    {
      "id": 431122,
      "primary_message": "Zest and juice lime into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 431123,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime.",
      "secondary_message": null
    },
    {
      "id": 431124,
      "primary_message": "Peel and mince shallots. Add to the bowl, along with the spices, and stir to combine the lime dressing. Transfer half of the dressing to a third medium bowl, then set both bowls aside.",
      "secondary_message": "2 shallots\n½ tsp chili powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 431125,
      "primary_message": "Return the grill pan to medium-high heat. Once the pan is hot, add chicken and grill until charred and cooked through, 3-4 minutes per side. Once done, add to the plate with the corn.",
      "secondary_message": null
    },
    {
      "id": 431126,
      "primary_message": "Meanwhile, quarter tomatoes. Trim, seed, and medium dice bell pepper. Add both to one of the bowls with the dressing, stir to combine the salsa, and set aside.",
      "secondary_message": null
    },
    {
      "id": 431127,
      "primary_message": "Working over the bowl with the remaining lime dressing, coarsely grate corn off of the cob, catching all of the kernels and juices in the bowl.",
      "secondary_message": null
    },
    {
      "id": 431128,
      "primary_message": "Add feta, yogurt, and mayo to the bowl with the corn. Stir to combine the corn salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n¼ cup plain Greek yogurt\n1 ½ tbsp mayonnaise"
    },
    {
      "id": 431129,
      "primary_message": "To serve, divide chicken, corn salad, and tomato salsa between plates. Enjoy!",
      "secondary_message": null
    }
  ],
