  "instructions": [
    {
      "id": 431101,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 431102,
      "primary_message": "Place hot sauce, oil, honey, and spices in a large bowl. Stir to combine the marinade. ",
      "secondary_message": "¼ cup hot sauce\n3 tbsp extra virgin olive oil\n3 tbsp honey\n1 tbsp garlic powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 431103,
      "primary_message": "Cut tofu planks in half, then cut each half into two triangles. Add tofu to the bowl with the marinade, gently stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 431104,
      "primary_message": "Remove husks and silks from corn. Using your hands, snap each ear in half.",
      "secondary_message": "6 ears corn"
    },
    {
      "id": 431105,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431106,
      "primary_message": "Once the pan is hot, working in batches if necessary, add corn cobs and grill, rotating occasionally, until slightly charred, 4-5 minutes. Remove to a plate and allow to cool slightly. (Reserve pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 431107,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch cilantro\n3 pints grape tomatoes\n1 ½ orange bell peppers"
    },
    {
      "id": 431108,
      "primary_message": "Zest and juice limes into another large bowl. ",
      "secondary_message": null
    },
    {
      "id": 431109,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime.",
      "secondary_message": null
    },
    {
      "id": 431110,
      "primary_message": "Peel, halve, and mince onion. Add to the bowl, along with the spices, and stir to combine the lime dressing. Transfer half of the dressing to a third large bowl, then set both bowls aside.",
      "secondary_message": "½ medium red onion\n1 ½ tsp chili powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 431111,
      "primary_message": "Return the grill pan to medium-high heat. Once the pan is hot, working in batches if necessary, add tofu and grill until charred and cooked through, 3-4 minutes per side. Add to the plate with the corn.",
      "secondary_message": null
    },
    {
      "id": 431112,
      "primary_message": "Meanwhile, quarter tomatoes. Trim, seed, and medium dice bell peppers. Add both to one of the bowls with the dressing, stir to combine the salsa, and set aside.",
      "secondary_message": null
    },
    {
      "id": 431113,
      "primary_message": "Working over the bowl with the remaining lime dressing, coarsely grate corn off of the cob, catching all of the kernels and juices in the bowl.",
      "secondary_message": null
    },
    {
      "id": 431114,
      "primary_message": "Add feta, yogurt, and mayo to the bowl with the corn. Stir to combine the corn salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ cup plain Greek yogurt\n¼ cup mayonnaise"
    },
    {
      "id": 431115,
      "primary_message": "To serve, divide tofu, corn salad, and tomato salsa between plates. Enjoy!",
      "secondary_message": null
    }
  ],
