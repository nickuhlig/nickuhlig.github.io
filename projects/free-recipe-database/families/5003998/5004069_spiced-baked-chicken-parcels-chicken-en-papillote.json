  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the onion. Seed and slice the red bell pepper into 1/4-inch strips. Halve the cherry tomatoes. Slice the lemon thin.",
      "secondary_message": "1 medium onion\n1 red bell pepper\n1 cup cherry tomatoes\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 190°C (375°F). Slice each chicken breast on the bias, into three or four equally thick pieces. Place chicken in large bowl and toss with the onion, pepper, tomatoes, Za'atar, oil, parsley, 1 1/2 teaspoons salt, and 1/2 teaspoon pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Lay four 12- by 30-cm pieces of parchment on work surface. Place mounds of the mixture (about 15 cm long and 8 cm wide) a few inches off the center of each square of parchment paper. Take care to equally divide the veggies and chicken between each serving. Place slices of lemon on top.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Working one package at a time, fold the parchment over the mixture. Starting at one corner, fold over the edges of the paper in small increments to form a tightly sealed half-moon shape. Repeat with remaining packets.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place the packets on a rimmed baking sheet and bake until the chicken is cooked through, 20 to 25 minutes (see note). Transfer each packet directly to a serving plate and serve, breaking open the packets at the table.",
      "secondary_message": null
    }
  ],
