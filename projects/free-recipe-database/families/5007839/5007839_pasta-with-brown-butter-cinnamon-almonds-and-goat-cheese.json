  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Sliver the almonds. Thinly slice the garlic. Tear the goat cheese into small bits.",
      "secondary_message": "⅓ cup almonds\n1 clove garlic\n2 oz goat cheese"
    },
    {
      "id": 1,
      "primary_message": "Bring a large pot of salted water to a boil. Cook the pasta according to the directions on the packaging. Drain, reserving 1/4 cup of cooking liquid.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While pasta cooks, melt butter in a medium-sized skillet over medium-low heat. Stir often with a wooden spoon until butter turns light brown and becomes fragrant, 1 to 2 minutes. Add almonds and garlic, stir well, and cook until almonds are light brown and toasted, 3 to 5 minutes. Stir in cinnamon and cook until fragrant, about 30 seconds. Set aside until pasta is cooked.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Increase heat on skillet to high, add pasta, pasta water, and lemon juice. Toss well. Continue cooking until sauce reduces and coats the noodles. Season to taste with salt. Serve noodles with goat cheese and grated parmesan.",
      "secondary_message": null
    }
  ],
