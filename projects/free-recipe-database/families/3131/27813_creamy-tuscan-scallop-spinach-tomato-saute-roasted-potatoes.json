  "instructions": [
    {
      "id": 446184,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 446185,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1.02 kg new potatoes\n1 ½ small pkgs grape tomatoes\n1 small pkg fresh basil\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 446186,
      "primary_message": "Halve potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 446187,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until potatoes are golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 446188,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. Peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 446189,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 446190,
      "primary_message": "When the potatoes have about 15 minutes left, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 446191,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and tomatoes; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 446192,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl, setting aside a small handful for serving.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 446193,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the Parmesan.",
      "secondary_message": null
    },
    {
      "id": 446194,
      "primary_message": "When the onion and tomato are done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 446195,
      "primary_message": "Add Parmesan, basil, cream, salt, and pepper to the pot. Continue to cook, stirring occasionally, until the cheese is melted and sauce is combined, 2-3 minutes.",
      "secondary_message": "355 ml heavy whipping cream\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 446196,
      "primary_message": "While the sauce is cooking, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg sea scallops\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 446197,
      "primary_message": "Add scallops to the pot with the sauce and gently stir to coat. Cook, stirring occasionally, until opaque, 6-7 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 446198,
      "primary_message": "To serve, divide creamy scallop sauté and potatoes between plates or bowls. Top with reserved Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
