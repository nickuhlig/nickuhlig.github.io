  "instructions": [
    {
      "id": 446076,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 446077,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb new potatoes\n1 pint grape tomatoes\n1 small pkg fresh basil\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 446078,
      "primary_message": "Halve potatoes. Transfer to a baking sheet pan, drizzle with oil, and season with spices; stir to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 446079,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until potatoes are golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 446080,
      "primary_message": "Meanwhile, peel, halve, and small dice onion. Peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 446081,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 446082,
      "primary_message": "When the potatoes have about 15 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 446083,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and tomatoes; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 446084,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in the reserved bowl, setting aside a small handful for serving.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 446085,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the Parmesan.",
      "secondary_message": null
    },
    {
      "id": 446086,
      "primary_message": "When the onion and tomato are done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 446087,
      "primary_message": "Add Parmesan, basil, cream, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until the cheese is melted and sauce is combined, 1-2 minutes.",
      "secondary_message": "8 fl oz (1 cup) heavy whipping cream\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 446088,
      "primary_message": "While the sauce is cooking, pat the scallops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb sea scallops\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 446089,
      "primary_message": "Add scallops to the skillet with the sauce and gently stir to coat. Cook, stirring occasionally, until opaque, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 446090,
      "primary_message": "To serve, divide creamy scallop sauté and potatoes between plates or bowls. Top with reserved Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
