  "instructions": [
    {
      "id": 18583,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 9-10 minutes.",
      "secondary_message": "about 7 cups water\r\n1 tbsp salt\r\n170 g (1 quarter coin = 57 g) fettuccine pasta"
    },
    {
      "id": 18584,
      "primary_message": "Wash asparagus and snap off woody ends. Cut diagonally into 5 cm pieces. Add to pasta during the last 2-3 minutes of cooking time.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 18585,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 18586,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 18587,
      "primary_message": "Add butter to pan and swirl to coat. Add garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 18588,
      "primary_message": "Sprinkle flour into pan and whisk until combined with the butter.",
      "secondary_message": "1 ½ tbsp all-purpose flour"
    },
    {
      "id": 18589,
      "primary_message": "Add broth and whisk until smooth. Then add milk and stir until sauce is thickened, 4-5 minutes.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n118 ml (½ cup) whole milk"
    },
    {
      "id": 18590,
      "primary_message": "Finely grate ¼ cup of Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 18591,
      "primary_message": "Add Parmesan, salt, and pepper to sauce. Stir until smooth, then reduce heat to low until pasta is ready.",
      "secondary_message": "¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 18896,
      "primary_message": "Drain pasta and asparagus in a colander, reserving about ½ cup of the pasta water.",
      "secondary_message": ""
    },
    {
      "id": 18592,
      "primary_message": "Add pasta, asparagus, and ½ of the reserved pasta water to sauce. Toss to combine. Add more pasta water to thin out the sauce if desired.",
      "secondary_message": ""
    },
    {
      "id": 18593,
      "primary_message": "Place on a plate, garnish with freshly ground pepper, and enjoy!",
      "secondary_message": ""
    }
  ],
