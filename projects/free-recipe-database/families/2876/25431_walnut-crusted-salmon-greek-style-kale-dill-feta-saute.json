  "instructions": [
    {
      "id": 408112,
      "primary_message": "Preheat oven to 425°F. Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 408113,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch fresh dill\n3 bunches kale\n1 small bunch green onions (scallions)"
    },
    {
      "id": 408114,
      "primary_message": "Mince walnuts. Place in a small bowl along with bread crumbs, oil, and salt; stir to combine the coating.",
      "secondary_message": "¾ cup walnuts\n½ cup panko bread crumbs\n2 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 408115,
      "primary_message": "Pat salmon dry with paper towels and place, skin-side down, on the baking sheet; season the top side with salt and pepper. Spread the fish with mayo, then sprinkle evenly with the coating, pressing gently to adhere. (Reserve bowl for later use.)",
      "secondary_message": "2 ¼ lb salmon fillet\n¾ tsp salt\n½ tsp black pepper\n¼ cup mayonnaise"
    },
    {
      "id": 408116,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until salmon is cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 408117,
      "primary_message": "Meanwhile, juice half of the lemons into the reserved bowl. Cut remaining lemons into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 408118,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice and set aside.",
      "secondary_message": null
    },
    {
      "id": 408119,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 408120,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 408121,
      "primary_message": "While the pot heats up, trim and thinly slice green onions crosswise. Add to the bowl with the kale.",
      "secondary_message": null
    },
    {
      "id": 408122,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add kale and green onions to the pot in handfuls, waiting for kale to wilt slightly before adding the next handful. Cook, stirring frequently, until the kale is tender, 2-3 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 408123,
      "primary_message": "Add lemon juice, dill, feta, crushed red pepper, and salt to the pot with the kale. Stir to combine and remove from heat.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n¾ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 408124,
      "primary_message": "To serve, divide salmon and kale between plates, then squeeze lemon over top. Enjoy!",
      "secondary_message": null
    }
  ],
