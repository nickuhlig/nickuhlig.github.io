  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thaw the frozen puff pastry.",
      "secondary_message": "0.23 kg frozen puff pastry"
    },
    {
      "id": 1,
      "primary_message": "Preheat a Belgian waffle iron according to manufacturer directions. Lightly dust a work surface. Lay out puff pastry sheet, lightly flour top, and roll into an approximate 16- by 41-cm square.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spread chicken on puff pastry, leaving a 2.5 cm border on all edges. Arrange blue cheese on top, then drizzle hot sauce all over, leaving a 2.5 cm border on all edges.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Roll puff pastry sheet away from you like a jelly roll. When completely rolled, pinch seam to seal.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Pinch ends of puff pastry to seal, then roll into a disk-shaped spiral. Place spiral in center of preheated waffle iron. Cook until puff pastry is deep golden brown on all surfaces and an instant-read thermometer inserted into the center registers 93°C, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer to a cutting board, cut into wedges, and serve immediately, serving blue cheese dressing and extra hot sauce on the side.",
      "secondary_message": null
    }
  ],
