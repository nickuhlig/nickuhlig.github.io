  "instructions": [
    {
      "id": 461356,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 461357,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n1 ½ lb Brussels sprouts\n1 ½ lemons"
    },
    {
      "id": 461358,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and medium dice. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 461359,
      "primary_message": "Trim and halve Brussels sprouts lengthwise. Add to the baking sheets with the squash.",
      "secondary_message": null
    },
    {
      "id": 461360,
      "primary_message": "Zest lemons into a small bowl (set aside for later use). Juice lemons over the veggies, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 461361,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 461362,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the veggies are fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 461363,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461364,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 461365,
      "primary_message": "Once the pan is hot, coat with butter. Working in batches if necessary, add steak and grill until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 461366,
      "primary_message": "While the steak is cooking, peel and mince shallots and garlic. Add both to the bowl with the lemon zest.",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 461367,
      "primary_message": "Cut additional butter into small pieces and add to the bowl along with Dijon and spices. Mash with the back of a spoon to combine the \"cowboy\" butter.",
      "secondary_message": "⅓ cup butter, unsalted\n1 tbsp Dijon mustard\n1 tbsp parsley flakes\n1 ½ tsp smoked paprika\n¾ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 461368,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 461369,
      "primary_message": "To serve, divide steak and veggies between plates. Top steak with cowboy butter and enjoy!",
      "secondary_message": null
    }
  ],
