  "instructions": [
    {
      "id": 461370,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 461371,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small butternut squash\n0.23 kg Brussels sprouts\n½ lemon"
    },
    {
      "id": 461372,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and medium dice. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 461373,
      "primary_message": "Trim and halve Brussels sprouts lengthwise. Add to the baking sheet with the squash.",
      "secondary_message": null
    },
    {
      "id": 461374,
      "primary_message": "Zest lemon into a small bowl (set aside for later use). Juice lemon over the veggies, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461375,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 461376,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the veggies are fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 461377,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 461378,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 461379,
      "primary_message": "Once the pan is hot, coat with butter. Add steak and grill until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp butter, unsalted"
    },
    {
      "id": 461380,
      "primary_message": "While the steak is cooking, peel and mince shallot and garlic. Add both to the bowl with the lemon zest.",
      "secondary_message": "½ shallot\n1 clove garlic"
    },
    {
      "id": 461381,
      "primary_message": "Cut additional butter into small pieces and add to the bowl along with Dijon and spices. Mash with the back of a spoon to combine the \"cowboy\" butter.",
      "secondary_message": "2 tbsp butter, unsalted\n1 tsp Dijon mustard\n1 tsp parsley flakes\n½ tsp smoked paprika\n¼ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 461382,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 461383,
      "primary_message": "To serve, divide steak and veggies between plates. Top steak with cowboy butter and enjoy!",
      "secondary_message": null
    }
  ],
