  "instructions": [
    {
      "id": 141790,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n6 sticks celery\n1 ½ medium heads cauliflower\n1 ½ small bunches green onions (scallions)"
    },
    {
      "id": 141791,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 141792,
      "primary_message": "Add the bacon to the pot and cook until crispy, 3-5 minutes per side. Work in batches if necessary.",
      "secondary_message": "6 slices bacon"
    },
    {
      "id": 141793,
      "primary_message": "Meanwhile, peel and small dice the potatoes. Trim ends and small dice celery. Add both to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 141794,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Chop cauliflower into small pieces and add to the bowl with the potatoes. ",
      "secondary_message": null
    },
    {
      "id": 141795,
      "primary_message": "Once the bacon is cooked, transfer to a plate lined with paper towels; pat to remove excess oil. Crumble or chop into small pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 141796,
      "primary_message": "Return pot (with bacon fat) to the stove over medium-high heat. Add the potatoes, celery, cauliflower, and broth; stir and bring to a boil. Reduce heat and simmer for 14-17 minutes, until potatoes are fork-tender. ",
      "secondary_message": "2129 ml chicken or vegetable broth"
    },
    {
      "id": 141797,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 141798,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces. ",
      "secondary_message": null
    },
    {
      "id": 141799,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 141800,
      "primary_message": "Add butter to the saucepan and swirl to coat the bottom. Add flour and whisk until smooth.",
      "secondary_message": "⅓ cup butter, unsalted\n⅓ cup all-purpose flour"
    },
    {
      "id": 141801,
      "primary_message": "Add milk to the saucepan and whisk until roux is thickened, 4-5 minutes. Stir in the cheese until melted (reserving a small amount for garnish). ",
      "secondary_message": "710 ml whole milk"
    },
    {
      "id": 141802,
      "primary_message": "Once the potatoes are done, remove pot from heat. Use a potato masher to break up the potato chunks. ",
      "secondary_message": null
    },
    {
      "id": 141803,
      "primary_message": "Slowly pour the cheese mixture into the pot and stir until combined. Add the spices and stir to combine.",
      "secondary_message": "2 tsp salt\n¾ tsp onion powder\n½ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 141804,
      "primary_message": "To serve, divide the soup between bowls. Top with remaining cheese, bacon, and green onions. Enjoy! ",
      "secondary_message": null
    }
  ],
