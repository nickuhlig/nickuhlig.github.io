  "instructions": [
    {
      "id": 141715,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n2 sticks celery\n½ medium head cauliflower\n½ small bunch green onions (scallions)"
    },
    {
      "id": 141716,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 141717,
      "primary_message": "Add the bacon to the pot and cook until crispy, 3-5 minutes per side.",
      "secondary_message": "2 slices bacon"
    },
    {
      "id": 141718,
      "primary_message": "Meanwhile, peel and small dice the potatoes. Trim ends and small dice celery. Add both to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 141719,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Chop the cauliflower into small pieces and add to the bowl with the potatoes. ",
      "secondary_message": null
    },
    {
      "id": 141720,
      "primary_message": "Once the bacon is cooked, transfer to a plate lined with paper towels; pat to remove excess oil. Crumble or chop into small pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 141721,
      "primary_message": "Return pot (with bacon fat) to the stove over medium-high heat. Add the potatoes, celery, cauliflower, and broth; stir and bring to a boil. Reduce heat and simmer for 10-15 minutes, until potatoes are fork-tender. ",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 141722,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 141723,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces. ",
      "secondary_message": null
    },
    {
      "id": 141724,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 141725,
      "primary_message": "Add butter to the saucepan and swirl to coat the bottom. Add flour and whisk until smooth.",
      "secondary_message": "2 tbsp butter, unsalted\n2 tbsp all-purpose flour"
    },
    {
      "id": 141726,
      "primary_message": "Add milk to the saucepan and whisk until roux is thickened, 2-3 minutes. Stir in the cheese until melted (reserving a small amount for garnish). ",
      "secondary_message": "8 fl oz (1 cup) whole milk"
    },
    {
      "id": 141727,
      "primary_message": "Once the potatoes are done, remove pot from heat. Use a potato masher to break up the potato chunks. ",
      "secondary_message": null
    },
    {
      "id": 141728,
      "primary_message": "Slowly pour the cheese mixture into the pot and stir until combined. Add the spices and stir to combine.",
      "secondary_message": "¾ tsp salt\n¼ tsp onion powder\n⅛ tsp garlic powder\n⅛ tsp black pepper"
    },
    {
      "id": 141729,
      "primary_message": "To serve, divide the soup between bowls. Top with remaining cheese, bacon, and green onions. Enjoy! ",
      "secondary_message": null
    }
  ],
