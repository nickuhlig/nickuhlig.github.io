  "instructions": [
    {
      "id": 321067,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 321068,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 321069,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 321070,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 321071,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n1 ½ small pineapples\n1 ½ small heads red cabbage"
    },
    {
      "id": 321072,
      "primary_message": "Peel and mince garlic; place in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 321073,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 321074,
      "primary_message": "Juice lemons into the bowl, then add oil, salt, and pepper; whisk to combine the marinade.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 321075,
      "primary_message": "Cut tofu into 1-inch cubes; add to the marinade, turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 321076,
      "primary_message": "Place yogurt, coconut, mayo, vinegar, Dijon, and salt in another large bowl; whisk to combine the dressing. ",
      "secondary_message": "1 cup plain Greek yogurt\n⅓ cup shredded unsweetened coconut\n⅓ cup mayonnaise\n3 tbsp apple cider vinegar\n2 tbsp Dijon mustard\n¾ tsp salt"
    },
    {
      "id": 321077,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and small dice. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 321078,
      "primary_message": "Halve each cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 321079,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321080,
      "primary_message": "While the pan heats up, thread tofu onto skewers. Alternatively, you can cook the tofu directly on the pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 321081,
      "primary_message": "Once the pan is hot, working in batches if necessary, add skewers; grill, turning occasionally, until tofu is lightly charred and warmed through, about 8 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 321082,
      "primary_message": "To serve, divide rice and slaw between plates; top with tofu skewers and enjoy!",
      "secondary_message": null
    }
  ],
