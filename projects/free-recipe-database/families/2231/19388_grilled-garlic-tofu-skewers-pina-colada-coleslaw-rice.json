  "instructions": [
    {
      "id": 320942,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 320943,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 320944,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 320945,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 320946,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ lemon\n½ small pineapple\n½ small head red cabbage"
    },
    {
      "id": 320947,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 320948,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 320949,
      "primary_message": "Juice lemon into the bowl, then add oil, salt, and pepper; whisk to combine the marinade.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 320950,
      "primary_message": "Cut tofu into 1-inch cubes; add to the marinade, turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 320951,
      "primary_message": "Place yogurt, coconut, mayo, vinegar, Dijon, and salt in another medium bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n⅛ cup shredded unsweetened coconut\n2 tbsp mayonnaise\n1 tbsp apple cider vinegar\n2 tsp Dijon mustard\n¼ tsp salt"
    },
    {
      "id": 320952,
      "primary_message": "Cut off skin from pineapple; quarter, core, and small dice. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 320953,
      "primary_message": "Halve cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips. Add to the bowl, stir to combine the slaw, and set aside.",
      "secondary_message": null
    },
    {
      "id": 320954,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 320955,
      "primary_message": "While the pan heats up, thread tofu onto skewers. Alternatively, you can cook the tofu directly on the pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 320956,
      "primary_message": "Once the pan is hot, add skewers; grill, turning occasionally, until tofu is lightly charred and warmed through, about 8 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 320957,
      "primary_message": "To serve, divide rice and slaw between plates; top with tofu skewers and enjoy!",
      "secondary_message": null
    }
  ],
