  "instructions": [
    {
      "id": 354578,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 354579,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n3 green bell peppers\n6 medium carrots"
    },
    {
      "id": 354580,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354581,
      "primary_message": "While the rice is cooking, peel, halve, and small dice onions; peel and mince garlic. Place both in a large bowl.",
      "secondary_message": "3 medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 354582,
      "primary_message": "Trim and small dice celery; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 354583,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354584,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354585,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 354586,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring often, until they begin to soften, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 354587,
      "primary_message": "Once the veggies are soft, add ground beef and spices to the pot. Continue to cook, breaking the meat apart with a spoon, until the beef is browned and crumbly, 5-6 minutes more.",
      "secondary_message": "2 ¼ lb lean ground beef\n2 tsp salt\n1 ½ tsp paprika\n1 ½ tsp thyme, dried\n1 ½ tsp oregano, dried\n½ tsp cayenne pepper\n½ tsp black pepper"
    },
    {
      "id": 354588,
      "primary_message": "Add cooked rice and additional broth to the pot; continue to cook, stirring occasionally, until heated through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 354589,
      "primary_message": "To serve, divide \"dirty rice\" between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
