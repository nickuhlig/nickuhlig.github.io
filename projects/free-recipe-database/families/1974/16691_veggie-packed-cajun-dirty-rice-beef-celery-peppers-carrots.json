  "instructions": [
    {
      "id": 354554,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 354555,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 green bell pepper\n2 medium carrots"
    },
    {
      "id": 354556,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354557,
      "primary_message": "While the rice is cooking, peel, halve, and small dice onion; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 354558,
      "primary_message": "Trim and small dice celery; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 354559,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354560,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354561,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 354562,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring often, until they begin to soften, 5-6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 354563,
      "primary_message": "Once the veggies are soft, add ground beef and spices to the skillet. Continue to cook, breaking the meat apart with a spoon, until the beef is browned and crumbly, 4-5 minutes more.",
      "secondary_message": "¾ lb lean ground beef\n¾ tsp salt\n½ tsp paprika\n½ tsp thyme, dried\n½ tsp oregano, dried\n⅛ tsp cayenne pepper\n⅛ tsp black pepper"
    },
    {
      "id": 354564,
      "primary_message": "Add cooked rice and additional broth to the skillet; continue to cook, stirring occasionally, until heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 354565,
      "primary_message": "To serve, divide \"dirty rice\" between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
