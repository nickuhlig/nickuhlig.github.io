  "instructions": [
    {
      "id": 354665,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 354666,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 green bell pepper\n2 medium carrots"
    },
    {
      "id": 354667,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354668,
      "primary_message": "While the rice is cooking, peel, halve, and small dice onion. Place in a medium bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 354669,
      "primary_message": "Peel and mince garlic. Add to the bowl with the onion.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 354670,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354671,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354672,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354673,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 354674,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the vegetables and cook, stirring often, until they begin to soften, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 354675,
      "primary_message": "When the vegetables are soft, add veggie ground and spices to the skillet. Continue to cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes more.",
      "secondary_message": "227 g veggie ground, plant based\n½ tsp salt\n½ tsp paprika\n½ tsp thyme, dried\n½ tsp oregano, dried\n⅛ tsp cayenne pepper\n⅛ tsp black pepper"
    },
    {
      "id": 354676,
      "primary_message": "Add cooked rice and additional broth to the skillet; continue to cook, stirring occasionally, until heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 354677,
      "primary_message": "To serve, divide \"dirty rice\" between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
