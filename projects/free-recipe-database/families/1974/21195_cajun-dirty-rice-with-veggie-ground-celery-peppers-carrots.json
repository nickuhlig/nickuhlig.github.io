  "instructions": [
    {
      "id": 354616,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 354617,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 sticks celery\n3 green bell peppers\n6 medium carrots"
    },
    {
      "id": 354618,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 354619,
      "primary_message": "While the rice is cooking, peel, halve, and small dice onions. Place in a large bowl.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 354620,
      "primary_message": "Peel and mince garlic. Add to the bowl with the onion.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 354621,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354622,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354623,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 354624,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 354625,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the vegetables and cook, stirring often, until they begin to soften, 6-7 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 354626,
      "primary_message": "When the vegetables are soft, add veggie ground and spices to the pot. Continue to cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes more.",
      "secondary_message": "24 oz veggie ground, plant based\n1 ½ tsp salt\n1 ½ tsp paprika\n1 ½ tsp thyme, dried\n1 ½ tsp oregano, dried\n¼ tsp cayenne pepper\n¼ tsp black pepper"
    },
    {
      "id": 354627,
      "primary_message": "Add cooked rice and additional broth to the pot; continue to cook, stirring occasionally, until heated through, about 3 minutes. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 354628,
      "primary_message": "To serve, divide \"dirty rice\" between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
