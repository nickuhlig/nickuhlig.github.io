  "instructions": [
    {
      "id": 167064,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n2 tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 167065,
      "primary_message": "Peel and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 167066,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 167067,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 167068,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 167069,
      "primary_message": "Add onion and garlic to the skillet and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 167070,
      "primary_message": "Trim ends from the zucchini and grate coarsely. ",
      "secondary_message": null
    },
    {
      "id": 167071,
      "primary_message": "Add zucchini and salt to the skillet; cook, stirring occasionally, until zucchini is tender and most of the liquid has evaporated, 5-6 minutes. Use a spoon to remove excess liquid if necessary.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 167072,
      "primary_message": "Meanwhile, grate mozzarella. Whisk eggs in a medium bowl; add half the cheese and stir to combine.",
      "secondary_message": "½ (227 g) block mozzarella cheese\n6 eggs"
    },
    {
      "id": 167073,
      "primary_message": "Spread the zucchini evenly in the skillet. Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 167074,
      "primary_message": "Slice tomatoes into wedges and place in a medium salad bowl; drizzle with olive oil and season with salt and pepper.",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 167075,
      "primary_message": "Sprinkle remaining cheese over the frittata; place skillet in the oven and broil until the top is set, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 167076,
      "primary_message": "Pick leaves off the stems of the basil, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the tomatoes and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 167077,
      "primary_message": "To serve, cut frittata into wedges and divide between plates with the tomato salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
