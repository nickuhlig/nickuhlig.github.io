  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pot heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices to the pot; cook, stirring occasionally, until onion is softened, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp minced garlic\n½ tsp salt\n¼ tsp black pepper\n¼ tsp Italian seasoning"
    },
    {
      "primary_message": "Meanwhile, drain and roughly chop artichoke hearts.",
      "secondary_message": "1 (13.75 oz) can artichoke hearts, in water"
    },
    {
      "primary_message": "When the onion is soft, add artichokes, chicken, rice, cream cheese, and sour cream to the pot, then stir to combine. Continue to cook, stirring occasionally, until the cream cheese is melted and combined, 2-3 minutes more.",
      "secondary_message": "2 cups cooked chicken (shredded)\n1 (8.5 oz) pouch basmati rice, pre-cooked\n½ (8 oz) block cream cheese\n¼ cup sour cream"
    },
    {
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful, then stir to combine. Remove from heat.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "Transfer the chicken mixture to an 8-inch square dish, sprinkle with cheese, then loosely cover the dish with aluminum foil. Place in the oven and bake for 20 minutes. Remove the foil and continue to bake until cheese is melted and bubbly, 20 minutes more. Remove from oven.",
      "secondary_message": "1 cup mozzarella cheese, shredded"
    },
    {
      "primary_message": "To serve, divide casserole between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
