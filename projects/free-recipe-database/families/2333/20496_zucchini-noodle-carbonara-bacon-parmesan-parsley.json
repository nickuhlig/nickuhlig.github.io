  "instructions": [
    {
      "id": 458344,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 458345,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 458346,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Divide between two baking sheet pans, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 458347,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini is tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 458348,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 458349,
      "primary_message": "Finely grate Parmesan; add to the bowl with the parsley, stir to combine, and set aside.",
      "secondary_message": "4 ½ oz Parmesan cheese"
    },
    {
      "id": 458350,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 458351,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 458352,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 458353,
      "primary_message": "Once the pot is hot, add onion, garlic, and bacon; cook, stirring occasionally, until onion is soft and bacon is crisp, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 458354,
      "primary_message": "Meanwhile, zest lemons into the reserved bowl. Using a clean cutting board, cut lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 458355,
      "primary_message": "Add half of the Parmesan-parsley mixture to the bowl with the lemon zest, along with eggs, cream, water, salt, and crushed red pepper. Whisk to combine the egg mixture. (Reserve remaining Parmesan-parsley mixture for serving.)",
      "secondary_message": "6 eggs\n12 fl oz (1 ½ cups) heavy whipping cream\n1 cup water\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 458356,
      "primary_message": "When the bacon is done, let pot cool slightly before returning to low heat. Add egg mixture to the warm pot (adjusting heat as needed to ensure the egg does not scramble), and cook, stirring frequently, until sauce thickens, 3-4 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 458357,
      "primary_message": "Divide zucchini noodles between plates or bowls; top with sauce and sprinkle with reserved Parmesan-parsley mixture. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
