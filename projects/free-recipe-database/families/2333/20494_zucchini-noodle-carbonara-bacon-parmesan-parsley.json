  "instructions": [
    {
      "id": 458316,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 458317,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n½ small bunch Italian (flat-leaf) parsley\n½ lemon"
    },
    {
      "id": 458318,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Transfer to a baking sheet pan, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 458319,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 458320,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 458321,
      "primary_message": "Finely grate Parmesan; add to the bowl with the parsley, stir to combine, and set aside.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 458322,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Place both in another small bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 458323,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 458324,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 458325,
      "primary_message": "Once the skillet is hot, add onion, garlic, and bacon; cook, stirring occasionally, until onion is soft and bacon is crisp, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": null
    },
    {
      "id": 458326,
      "primary_message": "Meanwhile, zest lemon into the reserved bowl. Using a clean cutting board, cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 458327,
      "primary_message": "Add half of the Parmesan-parsley mixture to the bowl with the lemon zest, along with eggs, cream, water, salt, and crushed red pepper. Whisk to combine the egg mixture. (Reserve remaining Parmesan-parsley mixture for serving.)",
      "secondary_message": "2 eggs\n4 fl oz (½ cup) heavy whipping cream\n⅓ cup water\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 458328,
      "primary_message": "When the bacon is done, let skillet cool slightly before returning to low heat. Add egg mixture to the warm skillet (adjusting heat as needed to ensure the egg does not scramble), and cook, stirring frequently, until sauce thickens, 2-3 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 458329,
      "primary_message": "Divide zucchini noodles between plates or bowls; top with sauce and sprinkle with reserved Parmesan-parsley mixture. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
