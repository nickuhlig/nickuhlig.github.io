  "instructions": [
    {
      "id": 396692,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 396693,
      "primary_message": "Meanwhile, wash, dry, peel, and mince ginger. Place in a large bowl along with oil, vinegar, soy sauce, miso paste, maple syrup, and pepper; whisk to combine the dressing. ",
      "secondary_message": "3 (1 inch) pieces ginger root\n¼ cup toasted sesame oil\n¼ cup rice vinegar\n¼ cup soy sauce\n3 tbsp miso paste, white\n3 tbsp pure maple syrup\n½ tsp black pepper"
    },
    {
      "id": 396694,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; drain and add to the bowl with the dressing.",
      "secondary_message": "4 ½ cups edamame"
    },
    {
      "id": 396695,
      "primary_message": "Wash, dry, trim, and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 396696,
      "primary_message": "Add cabbage to the bowl and set aside. ",
      "secondary_message": "1 ½ (14 oz) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 396697,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl and stir to combine the pasta salad. ",
      "secondary_message": null
    },
    {
      "id": 396698,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
