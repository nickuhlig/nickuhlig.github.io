  "instructions": [
    {
      "id": 398792,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 398793,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ (8 oz) pkg sugar snap peas\n1 ½ English cucumbers"
    },
    {
      "id": 398794,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 398795,
      "primary_message": "Halve snap peas crosswise. Add to the bowl with the green onions and set aside.",
      "secondary_message": null
    },
    {
      "id": 398796,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398797,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until almost cooked through, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp toasted sesame oil\n24 oz veggie ground, plant based\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 398798,
      "primary_message": "Add green onions and snap peas to the pot. Cook, stirring occasionally, until the vegetables are tender and veggie ground is cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 398799,
      "primary_message": "Meanwhile, trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 398800,
      "primary_message": "When the veggie ground and vegetables are done, add peanut sauce, water, and soy sauce to the pot. Continue to cook, stirring occasionally, until sauce is warmed through and thickened slightly, 2-3 minutes more.",
      "secondary_message": "¾ cup peanut sauce\n¼ cup water\n3 tbsp soy sauce"
    },
    {
      "id": 398801,
      "primary_message": "Add drained noodles to the pot, toss to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 398802,
      "primary_message": "To serve, divide saucy noodles, veggie ground, and vegetables between bowls; top with cucumber and carrots. Enjoy!",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots"
    }
  ],
