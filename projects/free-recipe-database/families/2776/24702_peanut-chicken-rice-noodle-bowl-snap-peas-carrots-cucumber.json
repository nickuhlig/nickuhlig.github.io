  "instructions": [
    {
      "id": 398758,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 398759,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ (8 oz) pkg sugar snap peas\n1 ½ English cucumbers"
    },
    {
      "id": 398760,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 398761,
      "primary_message": "Halve snap peas crosswise. Add to the bowl with the green onions and set aside.",
      "secondary_message": null
    },
    {
      "id": 398762,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Season with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 398763,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398764,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the chicken and cook, stirring occasionally, until golden and almost cooked through, 4-5 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 398765,
      "primary_message": "Add green onions and snap peas to the pot. Cook, stirring occasionally, until the veggies are tender and chicken is cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 398766,
      "primary_message": "Meanwhile, using a clean cutting board, trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 398767,
      "primary_message": "When the chicken and veggies are done, add peanut sauce, water, and soy sauce to the pot. Continue to cook, stirring occasionally, until sauce is warmed through and thickened slightly, 3-4 minutes more.",
      "secondary_message": "1 cup peanut sauce\n⅓ cup water\n3 tbsp soy sauce"
    },
    {
      "id": 398768,
      "primary_message": "Add drained noodles to the pot, toss to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 398769,
      "primary_message": "To serve, divide saucy noodles, chicken, and veggies between bowls; top with cucumber and carrots. Enjoy!",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots"
    }
  ],
