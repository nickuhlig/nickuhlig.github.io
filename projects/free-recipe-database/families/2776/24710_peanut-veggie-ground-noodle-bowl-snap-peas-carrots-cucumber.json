  "instructions": [
    {
      "id": 398850,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 398851,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 (227 g) pkg sugar snap peas\n1 English cucumber"
    },
    {
      "id": 398852,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 398853,
      "primary_message": "Halve snap peas crosswise. Add to the bowl with the green onions and set aside.",
      "secondary_message": null
    },
    {
      "id": 398854,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 398855,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until almost cooked through, 2-3 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n454 g veggie ground, plant based\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 398856,
      "primary_message": "Add green onions and snap peas to the skillet. Cook, stirring occasionally, until the vegetables are tender and veggie ground is cooked through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 398857,
      "primary_message": "Meanwhile, trim and halve cucumber lengthwise, then cut crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 398858,
      "primary_message": "When the veggie ground and vegetables are done, add peanut sauce, water, and soy sauce to the skillet. Continue to cook, stirring occasionally, until sauce is warmed through and thickened slightly, 1-2 minutes more.",
      "secondary_message": "½ cup peanut sauce\n3 tbsp water\n2 tbsp soy sauce"
    },
    {
      "id": 398859,
      "primary_message": "Add drained noodles to the skillet, toss to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 398860,
      "primary_message": "To serve, divide saucy noodles, veggie ground, and vegetables between bowls; top with cucumber and carrots. Enjoy!",
      "secondary_message": "1 (283 g) bag shredded carrots"
    }
  ],
