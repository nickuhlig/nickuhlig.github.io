  "instructions": [
    {
      "id": 34046,
      "primary_message": "Heat the oven to 500°F (260°C).",
      "secondary_message": null
    },
    {
      "id": 34047,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium beets\n1 bunch kale\n1 orange"
    },
    {
      "id": 34048,
      "primary_message": "Trim the ends and peel the beets; slice crosswise into 3-mm-thick rounds. Transfer to a baking sheet.",
      "secondary_message": null
    },
    {
      "id": 34049,
      "primary_message": "Halve the orange crosswise. Slice one half into rounds and add to the beets. Juice the other half into a bowl and set aside for later.",
      "secondary_message": null
    },
    {
      "id": 34050,
      "primary_message": "Drizzle the beet and orange slices with olive oil and sprinkle with salt and pepper; toss to coat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 34051,
      "primary_message": "Place the sheet in the oven and roast until the beet slices are tender, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 34052,
      "primary_message": "Fold the kale leaves in half lengthwise and slice off the stems. Roughly chop the leaves and transfer to a medium bowl. Cut the stems into 2 ½-cm pieces and transfer to a separate bowl.",
      "secondary_message": null
    },
    {
      "id": 34053,
      "primary_message": "Peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 34054,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "0.227 kg chicken breasts, boneless skinless"
    },
    {
      "id": 34055,
      "primary_message": "Season the chicken with salt and pepper on both sides.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 34056,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 34057,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 34058,
      "primary_message": "Place the chicken in the skillet and cook until it is browned and cooked through, 2 to 4 minutes per side. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 34059,
      "primary_message": "Once the chicken has been transferred, add more olive oil to the skillet. Then add the kale stems and season with a little salt; cook until they begin to soften, 3 to 4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 34060,
      "primary_message": "Add the garlic to the skillet and stir with the kale stems until fragrant, 15 to 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 34061,
      "primary_message": "Add the kale leaves and pour in the orange juice. Season with more salt and pepper. Stir well and cook until the leaves wilt, 2 to 3 minutes. Remove from the heat.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 34062,
      "primary_message": "Divide the chicken, beet and orange slices, and the kale sauté between two plates (or one plate and one lunch container). Enjoy!",
      "secondary_message": null
    }
  ],
