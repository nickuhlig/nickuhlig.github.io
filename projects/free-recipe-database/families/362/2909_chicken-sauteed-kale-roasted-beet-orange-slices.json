  "instructions": [
    {
      "id": 28188,
      "primary_message": "Heat the oven to 500°F.",
      "secondary_message": null
    },
    {
      "id": 28189,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium beets\n2 bunches kale\n2 oranges"
    },
    {
      "id": 28190,
      "primary_message": "Trim the ends and peel the beets; slice crosswise into ⅛-inch-thick rounds. Transfer to a baking sheet.",
      "secondary_message": null
    },
    {
      "id": 28191,
      "primary_message": "Slice one orange into rounds and add to the beets. Juice the other into a bowl and set aside for later.",
      "secondary_message": null
    },
    {
      "id": 28192,
      "primary_message": "Drizzle the beet and orange slices with olive oil and sprinkle with salt and pepper; toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 28193,
      "primary_message": "Place the sheet in the oven and roast until the beet slices are tender, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 28194,
      "primary_message": "Fold the kale leaves in half lengthwise and slice off the stems. Roughly chop the leaves and transfer to a medium bowl. Cut the stems into 1-inch pieces and transfer to a separate bowl.",
      "secondary_message": null
    },
    {
      "id": 28195,
      "primary_message": "Peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 28196,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets.",
      "secondary_message": "1 lb chicken breasts, boneless skinless"
    },
    {
      "id": 28197,
      "primary_message": "Season the chicken with salt and pepper on both sides.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 28198,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 28199,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 28200,
      "primary_message": "Place the chicken in the skillet and cook until it is browned and cooked through, 2 to 4 minutes per side. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 28201,
      "primary_message": "Once the chicken has been transferred, add more olive oil to the skillet. Then add the kale stems and season with a little salt; cook until they begin to soften, 3 to 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 28202,
      "primary_message": "Add the garlic to the skillet and stir with the kale stems until fragrant, 15 to 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 28203,
      "primary_message": "Add the kale leaves and pour in the orange juice. Season with more salt and pepper. Stir well and cook until the leaves wilt, 2 to 3 minutes. Remove from the heat.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 28204,
      "primary_message": "Divide the chicken, beet and orange slices, and the kale sauté between four plates (or two plates and two lunch containers). Enjoy!",
      "secondary_message": null
    }
  ],
