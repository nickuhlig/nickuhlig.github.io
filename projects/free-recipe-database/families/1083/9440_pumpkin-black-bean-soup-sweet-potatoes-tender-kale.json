  "instructions": [
    {
      "id": 149965,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 jalapeño pepper\n0.23 kg sweet potato\n½ bunch kale\n½ small bunch cilantro\n1 lime"
    },
    {
      "id": 149966,
      "primary_message": "Peel and mince ginger and garlic. Peel and small dice onion.",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 149967,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 149968,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 149969,
      "primary_message": "Once the pot is hot, add the oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 149970,
      "primary_message": "Add ginger, garlic, onion, and jalapeño to the pot; cook, stirring occasionally, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 149971,
      "primary_message": "Meanwhile, peel and dice sweet potato into ½-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 149972,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "½ (398 ml) can black beans"
    },
    {
      "id": 149973,
      "primary_message": "Add sweet potato, beans, broth, tomatoes with their juices, pumpkin, coconut milk, and spices to the pot. Stir to combine.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n1 (398 ml) can pure pumpkin purée\n½ (398 ml) can coconut milk\n1 tsp salt\n1 tsp chili powder\n½ tsp cumin"
    },
    {
      "id": 149974,
      "primary_message": "Bring to a boil over high heat, reduce heat to medium-low, and simmer until vegetables are tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 149975,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 149976,
      "primary_message": "Fold kale leaves in half lengthwise and slice off stems. Chop or tear leaves into bite-sized pieces and add to pot during the last 5 minutes of cook time.",
      "secondary_message": null
    },
    {
      "id": 149977,
      "primary_message": "Juice lime into the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 149978,
      "primary_message": "Divide the soup between bowls and top with cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
