  "instructions": [
    {
      "id": 149979,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 jalapeño peppers\n0.45 kg sweet potato\n1 bunch kale\n1 small bunch cilantro\n2 limes"
    },
    {
      "id": 149980,
      "primary_message": "Peel and mince ginger and garlic. Peel and small dice onions.",
      "secondary_message": "4 cloves garlic\n2 medium yellow onions"
    },
    {
      "id": 149981,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Finely dice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 149982,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 149983,
      "primary_message": "Once the pot is hot, add the oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 149984,
      "primary_message": "Add ginger, garlic, onion, and jalapeño to the pot; cook, stirring occasionally, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 149985,
      "primary_message": "Meanwhile, peel and dice sweet potatoes into ½-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 149986,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 149987,
      "primary_message": "Add sweet potato, beans, broth, tomatoes with their juices, pumpkin, coconut milk, and spices to the pot. Stir to combine.",
      "secondary_message": "1420 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes\n2 (398 ml) cans pure pumpkin purée\n1 (398 ml) can coconut milk\n2 tsp salt\n2 tsp chili powder\n1 tsp cumin"
    },
    {
      "id": 149988,
      "primary_message": "Bring to a boil over high heat, reduce heat to medium-low, and simmer until vegetables are tender, 15-20 min minutes.",
      "secondary_message": null
    },
    {
      "id": 149989,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 149990,
      "primary_message": "Fold kale leaves in half lengthwise and slice off stems. Chop or tear leaves into bite-sized pieces and add to pot during the last 5 minutes of cook time.",
      "secondary_message": null
    },
    {
      "id": 149991,
      "primary_message": "Juice limes into the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 149992,
      "primary_message": "Divide the soup between bowls and top with cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
