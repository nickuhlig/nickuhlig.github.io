  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the boneless skinless chicken breasts into 1-inch cubes.",
      "secondary_message": "0.68 kg boneless skinless chicken breasts"
    },
    {
      "id": 1,
      "primary_message": "To make marinade, whisk together oil, vinegar, lemon juice, parsley, basil, mint, oregano, and garlic. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place chicken in large resealable plastic bag. Pour in marinade, seal, and toss to combine. Place in refrigerator and allow to marinate for at least overnight, up to 3 days.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "If using wooden skewers, soak in water for at least 30 minutes.\nWhen ready to cook, thread chicken onto skewers, dividing meat equally between each skewer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over coal grate. Alternatively, set all the burners of a gas grill to medium-high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil grilling grate. Grill skewers until chicken is browned on all sides and cooked through, 2 to 3 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Open roll and lay grilled skewer inside. Gripping the roll at the bottom, carefully slide skewer off, leaving meat in the bread. Serve immediately.",
      "secondary_message": null
    }
  ],
