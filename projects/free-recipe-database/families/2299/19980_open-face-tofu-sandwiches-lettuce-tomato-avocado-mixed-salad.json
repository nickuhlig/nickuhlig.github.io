  "instructions": [
    {
      "id": 335122,
      "primary_message": "Cut tofu into ½-inch thick slices along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 335123,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n2 medium carrots\n1 head romaine lettuce\n2 tomatoes\n1 avocado"
    },
    {
      "id": 335124,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 335125,
      "primary_message": "While the skillet heats up, sprinkle tofu with cornstarch, salt, and pepper on both sides.",
      "secondary_message": "2 tbsp cornstarch\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 335126,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add tofu and cook, flipping once, until golden brown, 6-8 minutes. Return to the baking sheet. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 335127,
      "primary_message": "Meanwhile, juice lemon into a medium bowl; add oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 335128,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 335129,
      "primary_message": "Separate lettuce leaves; set aside 2 leaves per serving (1 leaf per sandwich) and chop or tear remaining leaves into bite-sized pieces. Add chopped lettuce to the bowl, along with broccoli slaw, and toss to combine the salad. Set aside.",
      "secondary_message": "1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 335130,
      "primary_message": "Slice tomatoes into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 335131,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 335132,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 335133,
      "primary_message": "Spread mayo over each bread slice; layer slices with lettuce, tomato, tofu, and avocado. ",
      "secondary_message": "3 tbsp vegan mayonnaise"
    },
    {
      "id": 335134,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
