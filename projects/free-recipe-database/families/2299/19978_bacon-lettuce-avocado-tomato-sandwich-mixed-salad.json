  "instructions": [
    {
      "id": 335098,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 medium carrots\n1 ½ heads romaine lettuce\n3 tomatoes\n1 ½ avocados"
    },
    {
      "id": 335099,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 335100,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add bacon and cook, turning occasionally, until crispy, 6-8 minutes. Using tongs, transfer bacon to a paper towel-lined plate.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 335101,
      "primary_message": "Meanwhile, juice lemons into a large bowl; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 335102,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 335103,
      "primary_message": "Separate lettuce leaves; set aside 1 leaf per sandwich and chop or tear remaining leaves into bite-sized pieces. Add chopped lettuce to the bowl, along with broccoli slaw, and toss to combine the salad; set aside.",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 335104,
      "primary_message": "Slice tomatoes into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 335105,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 335106,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 335107,
      "primary_message": "Spread mayo over each bread slice; layer half of the slices with lettuce, tomato, avocado, and bacon. Place remaining slices on top to close sandwiches.",
      "secondary_message": "¼ cup mayonnaise"
    },
    {
      "id": 335108,
      "primary_message": "To serve, divide salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
