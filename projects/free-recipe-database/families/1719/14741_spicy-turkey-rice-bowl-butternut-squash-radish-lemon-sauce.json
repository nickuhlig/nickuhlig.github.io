  "instructions": [
    {
      "id": 244011,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n3 bunches radish\n1 ½ lemons\n1 small bunch green onions (scallions)"
    },
    {
      "id": 244012,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot; add water, salt, and pepper.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 244013,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out seeds, and small dice the flesh. Add to the pot with the rice (do not stir). Bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 244014,
      "primary_message": "Meanwhile, place vinegar, maple syrup, and spices in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "3 tbsp apple cider vinegar\n1 ½ tsp pure maple syrup\n¾ tsp salt\n3 pinch crushed red pepper\n3 pinch coriander, ground"
    },
    {
      "id": 244015,
      "primary_message": "Once the liquid comes to a boil, cover the pot, and reduce heat to low. Cook rice and squash until liquid is fully absorbed and squash is tender, about 18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 244016,
      "primary_message": "While the rice and squash are cooking, trim off and discard tops and root ends of radishes; thinly slice and add to the bowl with the marinade. Toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 244017,
      "primary_message": "Juice lemons into a small bowl; add yogurt and spices. Whisk to combine the lemon sauce and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n1 ½ tsp garlic powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 244018,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 244019,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add ground turkey and cook, breaking apart with a spoon, until browned and crumbly, 7-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 ¼ lb ground turkey"
    },
    {
      "id": 244020,
      "primary_message": "Meanwhile, trim and thinly slice green onions crosswise.",
      "secondary_message": null
    },
    {
      "id": 244021,
      "primary_message": "Add water and spices to the skillet with the turkey; continue to cook, stirring often, until sauce is reduced by half, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 cup water\n3 tbsp chili powder\n¾ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 244022,
      "primary_message": "To serve, divide rice and squash between bowls; top with turkey, marinated radishes, and green onion. Drizzle with lemon sauce and enjoy!",
      "secondary_message": null
    }
  ],
