  "instructions": [
    {
      "id": 244049,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n1 ½ bunches radish\n1 ½ lemons\n1 small bunch green onions (scallions)"
    },
    {
      "id": 244050,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large pot; add water, salt, and pepper.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 244051,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out seeds, and small dice the flesh. Add to the pot with the rice (do not stir). Bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 244052,
      "primary_message": "Meanwhile, place vinegar, maple syrup, and spices in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "1 ½ tbsp apple cider vinegar\n¾ tsp pure maple syrup\n½ tsp salt\n⅛ tsp crushed red pepper\n⅛ tsp coriander, ground"
    },
    {
      "id": 244053,
      "primary_message": "Once the liquid comes to a boil, cover the pot, and reduce heat to low. Cook rice and squash until liquid is fully absorbed and squash is tender, about 18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 244054,
      "primary_message": "While the rice and squash are cooking, trim off and discard tops and root ends of radishes; thinly slice and add to the bowl with the marinade. Toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 244055,
      "primary_message": "Juice lemons into a small bowl; add mayo and spices. Whisk to combine the lemon sauce and set aside.",
      "secondary_message": "½ cup vegan mayonnaise\n¾ tsp garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 244056,
      "primary_message": "Thinly slice sausages crosswise.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 244057,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 244058,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until browned and warmed through, 4-5 minutes. (Or cook sausages according to package directions.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 244059,
      "primary_message": "Meanwhile, trim and thinly slice green onions crosswise.",
      "secondary_message": null
    },
    {
      "id": 244060,
      "primary_message": "Add water and spices to the skillet; continue to cook, stirring often, until sauce is reduced by half, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 cup water\n3 tbsp chili powder\n¾ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 244061,
      "primary_message": "To serve, divide rice and squash between bowls; top with sausage, marinated radishes, and green onion. Drizzle with lemon sauce and enjoy!",
      "secondary_message": null
    }
  ],
