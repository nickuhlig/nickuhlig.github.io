  "instructions": [
    {
      "id": 244111,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n1 bunch radish\n1 lemon\n1 small bunch green onions (scallions)"
    },
    {
      "id": 244112,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan; add water, salt, and pepper.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 244113,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out seeds, and small dice the flesh. Add to the saucepan with the rice (do not stir). Bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 244114,
      "primary_message": "Meanwhile, place vinegar, maple syrup, and spices in a small bowl; whisk to combine the marinade.",
      "secondary_message": "1 tbsp apple cider vinegar\n½ tsp pure maple syrup\n¼ tsp salt\n1 pinch crushed red pepper\n1 pinch coriander, ground"
    },
    {
      "id": 244115,
      "primary_message": "Once the liquid comes to a boil, cover the saucepan, and reduce heat to low. Cook rice and squash until liquid is fully absorbed and squash is tender, about 18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 244116,
      "primary_message": "While the rice and squash are cooking, trim off and discard tops and root ends of radishes; thinly slice and add to the bowl with the marinade. Toss to coat and set aside.",
      "secondary_message": null
    },
    {
      "id": 244117,
      "primary_message": "Juice lemon into another small bowl; add mayo and spices. Whisk to combine the lemon sauce and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n½ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 244118,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 244119,
      "primary_message": "While the skillet heats up, thinly slice sausages crosswise.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 244120,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until browned and warmed through, 3-4 minutes. (Or cook sausages according to package directions.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 244121,
      "primary_message": "Meanwhile, trim and thinly slice green onions crosswise.",
      "secondary_message": null
    },
    {
      "id": 244122,
      "primary_message": "Add water and spices to the skillet; continue to cook, stirring often, until sauce is reduced by half, about 1 minute. Remove from heat.",
      "secondary_message": "⅔ cup water\n2 tbsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n½ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 244123,
      "primary_message": "To serve, divide rice and squash between bowls; top with sausage, marinated radishes, and green onion. Drizzle with lemon sauce and enjoy!",
      "secondary_message": null
    }
  ],
