  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve the cemita buns. Shred the iceberg lettuce. Halve, pit, and slice the ripe avocado. Shred the Queso Oaxaca.",
      "secondary_message": "4 cemita buns\n½ cup iceberg lettuce\n1 medium ripe avocado\n1 cup Queso Oaxaca"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together mayonnaise and the 2 tablespoons adobo sauce. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Season burger patties generously with salt and pepper and cook burgers to desired doneness on an oiled hot griddle, grill, or in 2 large skillets on the stovetop, 125°F for medium rare or 135°F for medium. Transfer to a plate and allow to rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toast cut surfaces of buns on the griddle, grill, or skillets, pressing down with a sturdy spatula to compress.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spread refried beans on bottom bun halves, then top with shredded iceberg, papalo or cilantro leaves, tomato, and burger patties. Set avocado slices on top of burger patties, top with mounds of shredded cheese, followed by the remaining 4 chipotle peppers.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Spread chipotle mayonnaise on top bun halves and close sandwiches. Serve right away.",
      "secondary_message": null
    }
  ],
