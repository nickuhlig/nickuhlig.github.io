  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil, and swirl to coat the bottom. Add beef and cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Reduce heat to medium, add taco seasoning and water, then stir to combine. Simmer until sauce is reduced, about 1 min. Remove from heat.",
      "secondary_message": "extra virgin olive oil\n8 oz lean ground beef\n1 ½ tbsp taco seasoning"
    },
    {
      "primary_message": "Lay tortillas on a flat surface, divide beef and cheese between them, arranging on one half of each tortilla. Fold in half to close. ",
      "secondary_message": "⅔ cup shredded cheese, Mexican blend"
    },
    {
      "primary_message": "Wipe skillet clean with paper towel and set over medium heat; add oil and swirl to coat the bottom. Add quesadillas and cook, flipping halfway through, until cheese is melted and tortillas are golden on both sides, 5-6 minutes. Remove to a cutting board.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with salsa on the side and enjoy!",
      "secondary_message": "½ cup fresh salsa"
    }
  ],
