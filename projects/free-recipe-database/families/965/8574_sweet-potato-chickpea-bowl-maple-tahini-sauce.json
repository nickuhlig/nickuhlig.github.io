  "instructions": [
    {
      "id": 503081,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 503082,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n3 crowns broccoli\n1 ½ bunches kale\n1 ½ lemons"
    },
    {
      "id": 503083,
      "primary_message": "Peel the sweet potatoes and onions; cut both into 1-inch pieces. Transfer to a large bowl; add oil, salt, and pepper, and toss to coat. Divide veggies between three baking sheets and bake, until softened, about 10 minutes. Reserve bowl for later use.",
      "secondary_message": "1 ½ medium red onions\n1 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 503084,
      "primary_message": "Meanwhile, drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 503085,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place broccoli in the large bowl, add oil, salt, and pepper, and toss to coat. Add to baking sheets with the sweet potatoes, tossing to combine; bake until cooked through, about 10 more minutes. Reserve bowl for later use. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 503086,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503087,
      "primary_message": "Combine spices in a small bowl.",
      "secondary_message": "1 tbsp cumin, ground\n1 tbsp chili powder\n1 ½ tsp garlic powder\n1 ½ tsp oregano, dried\n1 ½ tsp turmeric, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 503088,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 503089,
      "primary_message": "Add chickpeas and spices to the skillet and toss to coat. Cook, stirring occasionally, until chickpeas are golden and fragrant, about 15 minutes. When done, set aside.",
      "secondary_message": null
    },
    {
      "id": 503090,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the large bowl; add oil, salt, and pepper and toss to combine. Add to the baking sheets and cook until wilted, about 5 more minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 503091,
      "primary_message": "Juice lemons into a small bowl; add tahini, maple syrup, and water, whisking to combine the dressing. Add additional water as needed to reach a drizzling consistency.",
      "secondary_message": "¾ cup tahini\n2 tbsp pure maple syrup\n⅓ cup water"
    },
    {
      "id": 503092,
      "primary_message": "To serve, divide roasted vegetables and chickpeas between bowls. Drizzle with tahini-maple dressing and enjoy!",
      "secondary_message": null
    }
  ],
