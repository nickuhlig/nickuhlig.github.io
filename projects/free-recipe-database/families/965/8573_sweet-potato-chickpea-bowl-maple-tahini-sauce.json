  "instructions": [
    {
      "id": 503069,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 503070,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n2 crowns broccoli\n1 bunch kale\n1 lemon"
    },
    {
      "id": 503071,
      "primary_message": "Peel the sweet potatoes and onions; cut both into 1-inch pieces. Transfer to a large bowl; add oil, salt, and pepper, and toss to coat. Divide veggies between two baking sheets and bake, until softened, about 10 minutes. Reserve bowl for later use.",
      "secondary_message": "1 medium red onion\n2 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 503072,
      "primary_message": "Meanwhile, drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 503073,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Place broccoli in the large bowl, add oil, salt, and pepper, and toss to coat. Add to baking sheets with the sweet potatoes, tossing to combine; bake until cooked through, about 10 more minutes. Reserve bowl for later use. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 503074,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 503075,
      "primary_message": "Combine spices in a small bowl.",
      "secondary_message": "2 tsp cumin, ground\n2 tsp chili powder\n1 tsp garlic powder\n1 tsp oregano, dried\n1 tsp turmeric, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 503076,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 503077,
      "primary_message": "Add chickpeas and spices to the skillet and toss to coat. Cook, stirring occasionally, until chickpeas are golden and fragrant, about 12 minutes. When done, set aside.",
      "secondary_message": null
    },
    {
      "id": 503078,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to the large bowl; add oil, salt, and pepper and toss to combine. Add to the baking sheets and cook until wilted, about 5 more minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 503079,
      "primary_message": "Juice lemon into a small bowl; add tahini, maple syrup, and water, whisking to combine the dressing. Add additional water as needed to reach a drizzling consistency.",
      "secondary_message": "½ cup tahini\n4 tsp pure maple syrup\n¼ cup water"
    },
    {
      "id": 503080,
      "primary_message": "To serve, divide roasted vegetables and chickpeas between bowls. Drizzle with tahini-maple dressing and enjoy!",
      "secondary_message": null
    }
  ],
