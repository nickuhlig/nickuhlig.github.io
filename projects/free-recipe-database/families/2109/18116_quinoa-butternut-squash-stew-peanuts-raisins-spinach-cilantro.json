  "instructions": [
    {
      "id": 320819,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ small butternut squash\n½ red bell pepper\n½ (5 oz) pkg baby spinach\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 320820,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out seeds, and small dice. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 320821,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the squash and set aside.",
      "secondary_message": null
    },
    {
      "id": 320822,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 320823,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. ",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 320824,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, about 2 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 320825,
      "primary_message": "Add squash, bell pepper, tomatoes, water, quinoa, and spices to the pan. Stir to combine the stew and bring to a boil over high heat; once boiling, reduce heat to low, cover, and cook until squash and quinoa are tender, about 20 minutes. (Reserve bowl for next step.)",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n1 ½ cup water\n½ cup quinoa\n1 tsp chili powder\n½ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 320826,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 320827,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 320828,
      "primary_message": "When the quinoa is tender, add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 320829,
      "primary_message": "Add peanut butter, additional water, raisins, and half of the cilantro to the stew. Stir to combine and continue to cook until warmed through, about 3 minutes. (Reserve remaining cilantro for serving.) ",
      "secondary_message": "¼ cup natural peanut butter\n¼ cup water\n⅛ cup raisins"
    },
    {
      "id": 320830,
      "primary_message": "Meanwhile, roughly chop peanuts. Slice lime into wedges.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 320831,
      "primary_message": "Divide stew between bowls; top with reserved cilantro and peanuts. Serve with lime wedges for squeezing over and enjoy!",
      "secondary_message": null
    }
  ],
