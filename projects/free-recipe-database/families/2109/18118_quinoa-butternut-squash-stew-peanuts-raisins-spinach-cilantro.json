  "instructions": [
    {
      "id": 320845,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ small butternut squash\n1 ½ red bell peppers\n1 ½ (5 oz) pkgs baby spinach\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 320846,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out seeds, and small dice. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 320847,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the squash and set aside.",
      "secondary_message": null
    },
    {
      "id": 320848,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. ",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 320849,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 320850,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and garlic; cook, stirring occasionally, until softened, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 320851,
      "primary_message": "Add squash, bell pepper, tomatoes, water, quinoa, and spices to the pot. Stir to combine the stew and bring to a boil over high heat; once boiling, reduce heat to low, cover, and cook until squash and quinoa are tender, 20-25 minutes. (Reserve bowl for next step.)",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n4 ½ cup water\n1 ½ cups quinoa\n1 tbsp chili powder\n1 ½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 320852,
      "primary_message": "Meanwhile, roughly chop spinach and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 320853,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 320854,
      "primary_message": "When the quinoa is tender, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 320855,
      "primary_message": "Add peanut butter, additional water, raisins, and half of the cilantro to the stew. Stir to combine and continue to cook until warmed through, about 4 minutes. (Reserve remaining cilantro for serving.) ",
      "secondary_message": "¾ cup natural peanut butter\n¾ cup water\n⅓ cup raisins"
    },
    {
      "id": 320856,
      "primary_message": "Meanwhile, roughly chop peanuts. Slice limes into wedges.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 320857,
      "primary_message": "Divide stew between bowls; top with reserved cilantro and peanuts. Serve with lime wedges for squeezing over and enjoy!",
      "secondary_message": null
    }
  ],
