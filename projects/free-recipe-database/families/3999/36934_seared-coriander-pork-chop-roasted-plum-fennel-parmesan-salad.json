  "instructions": [
    {
      "id": 579307,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 579308,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 plums\n1 fennel bulb\n1 (1 inch) piece ginger root"
    },
    {
      "id": 579309,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into thin slices and transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 579310,
      "primary_message": "Trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Add to the baking sheet with the plums.",
      "secondary_message": null
    },
    {
      "id": 579311,
      "primary_message": "Peel and mince ginger. Add to the baking sheet, then drizzle plums and fennel with oil. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp cardamom, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 579312,
      "primary_message": "Place baking sheet in oven (it doesn't have to be fully heated) and roast, stirring halfway through, until plums and fennel are golden and tender, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 579313,
      "primary_message": "Meanwhile preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 579314,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 pork chops, bone-in\n½ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 579315,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 579316,
      "primary_message": "Meanwhile, place oil, honey, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp honey\n1 tsp white wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 579317,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl with the dressing.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 579318,
      "primary_message": "When the plums and fennel are done, add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 579319,
      "primary_message": "To serve, divide pork chops and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
