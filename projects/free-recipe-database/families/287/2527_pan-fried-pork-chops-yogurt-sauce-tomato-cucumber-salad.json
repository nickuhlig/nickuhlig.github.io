  "instructions": [
    {
      "id": 24483,
      "primary_message": "In a small bowl, prepare the yogurt sauce by whisking together the yogurt, vinegar, olive oil, dill, salt, and pepper. Place in the fridge to chill.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp red wine vinegar\n1 tsp extra virgin olive oil\n1 tsp dill\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 24484,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 24485,
      "primary_message": "Season both sides of the pork chops with salt and pepper.",
      "secondary_message": "4 pork chops, boneless\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 24486,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the pork chops and cook until browned and cooked through, 3-5 minutes per side. Transfer to a plate and let them rest for 2-3 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 24487,
      "primary_message": "Wash and dry the fresh produce. Halve the cucumbers crosswise, then quarter lengthwise and slice crosswise on an angle; transfer to a medium bowl. Halve the tomatoes; add to the bowl.",
      "secondary_message": "2 English cucumbers\r\n2 small pkg grape tomatoes"
    },
    {
      "id": 24488,
      "primary_message": "Peel and mince the garlic; add to bowl with salad. Drizzle the salad with olive oil and season with oregano, salt, and pepper; toss to coat.",
      "secondary_message": "2 cloves garlic\r\n2 tsp extra virgin olive oil\r\n½ tsp oregano\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 24489,
      "primary_message": "To serve, arrange the tomato-cucumber salad on a plate and place a pork chops over top. Spoon yogurt sauce on top of the pork or serve on the side and enjoy!",
      "secondary_message": ""
    }
  ],
