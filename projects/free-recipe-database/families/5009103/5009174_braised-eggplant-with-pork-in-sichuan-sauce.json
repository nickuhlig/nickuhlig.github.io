  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the ginger. Finely chop the garlic. Remove the seeds and ribs from the hot green chiles, then finely chop them.",
      "secondary_message": "2 tbsp ginger root\n3 cloves garlic\n2 small hot green chiles"
    },
    {
      "id": 1,
      "primary_message": "Slice eggplant into quarters lengthwise, then cut into 8 to 10 cm lengths. Place pieces in bamboo steamer and steam in wok over medium heat until fully tender, about 15 minutes. Indentation made with finger on eggplant should not spring back. Transfer eggplant to bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, combine Shaoxing wine and cornstarch in medium bowl and whisk until no dry cornstarch remains. Add broth, bean paste, soy sauce, black vinegar, and sugar and whisk to combine. Combine ginger, garlic, scallion whites, and chiles in small bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil in wok over high heat until just beginning to smoke. Add ground pork and stir-fry for 30 seconds until most of pink color is gone. Push pork to sides of wok to make space at bottom. Add ginger mixture and stir fry 30 seconds until aromatic. Add eggplant and toss to combine. Add sauce mixture and bring to a boil. Reduce to a simmer and cook, stirring occasionally, until sauce is rich, thick, and glossy, about 20 minutes. Stir in scallion greens, and serve immediately.",
      "secondary_message": null
    }
  ],
