  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thaw the package of puff pastry. Core, thinly slice, and slice the peeled, of the granny smith apples. Chop the walnuts. Juice the lemon.",
      "secondary_message": "8 ⅝ oz package of puff pastry\n3 cups granny smith apples\n¼ cup walnuts\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together sugar, cinnamon, and flour. Add cranberries and walnuts and stir to combine. Add apples and lemon juice and toss, stirring until the apples are well coated; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Lightly flour a clean work surface and roll puff pastry out to a 16 by 12-inch rectangle. With the short side facing you, sprinkle 1/2 of pastry with apple mixture, leaving a 1-inch border at the end closest to you. Roll the pastry up, jelly roll-style, and crimp to seal edges. Transfer strudel to prepared baking sheet and brush top with egg wash. Cut three slits on top of the pastry to let steam escape. Bake until top is golden, about 35 minutes. Transfer baking sheet to a wire rack and let cool for 20 minutes. Dust with confectioners sugar before serving, if desired.",
      "secondary_message": null
    }
  ],
