  "instructions": [
    {
      "id": 466625,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 466626,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ English cucumber\n½ small pkg fresh mint\n½ small bunch cilantro\n½ head butter (Boston) lettuce"
    },
    {
      "id": 466627,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 466628,
      "primary_message": "While the rice is cooking, juice lime into a medium bowl. Add fish sauce, sugar, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp fish sauce\n1 ½ tsp brown sugar\n¾ tsp crushed red pepper"
    },
    {
      "id": 466629,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 466630,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 466631,
      "primary_message": "While the skillet heats up, pat cod dry with paper towels, then season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg cod fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 466632,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cod and cook, turning once, until lightly browned and just cooked through, about 8 minutes. Remove from heat.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 466633,
      "primary_message": "Meanwhile, roughly chop peanuts. Place in a small bowl and set aside for serving.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 466634,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 466635,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 466636,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 466637,
      "primary_message": "When the cod is done, transfer to the cutting board and, using a fork, break the fish into bite-size pieces. Add to the bowl and gently stir to combine the filling. ",
      "secondary_message": null
    },
    {
      "id": 466638,
      "primary_message": "Separate lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Divide cod filling between lettuce cups and top with peanuts. Serve with rice on the side and enjoy!",
      "secondary_message": null
    }
  ],
