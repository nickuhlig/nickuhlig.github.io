  "instructions": [
    {
      "id": 466653,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 466654,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ English cucumbers\n2 small pkgs fresh mint\n1 small bunch cilantro\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 466655,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 466656,
      "primary_message": "While the rice is cooking, juice limes into a large bowl. Add fish sauce, sugar, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup fish sauce\n1 ½ tbsp brown sugar\n2 tsp crushed red pepper"
    },
    {
      "id": 466657,
      "primary_message": "Peel, halve, and mince onion. Add to the bowl with the dressing, stir to combine, and set aside.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 466658,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 466659,
      "primary_message": "While the skillet heats up, pat cod dry with paper towels, then season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg cod fillet\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 466660,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cod and cook, turning once, until lightly browned and just cooked through, about 10 minutes. Remove from heat.",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 466661,
      "primary_message": "Meanwhile, roughly chop peanuts. Place in a small bowl and set aside for serving.",
      "secondary_message": "1 cup peanuts, roasted unsalted"
    },
    {
      "id": 466662,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 466663,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 466664,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 466665,
      "primary_message": "When the cod is done, transfer to the cutting board and, using a fork, break the fish into bite-size pieces. Add to the bowl and gently stir to combine the filling. ",
      "secondary_message": null
    },
    {
      "id": 466666,
      "primary_message": "Separate lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Divide cod filling between lettuce cups and top with peanuts. Serve with rice on the side and enjoy!",
      "secondary_message": null
    }
  ],
