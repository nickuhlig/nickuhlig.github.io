  "instructions": [
    {
      "id": 622771,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 tomatoes\n1 small pkg fresh basil\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 622772,
      "primary_message": "Peel and mince shallots. Place in a large bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 622773,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 622774,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622775,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622776,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 622777,
      "primary_message": "Slice mozzarella into rounds. Place on a plate.",
      "secondary_message": "1 (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 622778,
      "primary_message": "Chop or tear prosciutto into bite sized pieces. Add to the plate with the mozzarella.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 622779,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread mayo on the inside of the pitas, then fill with mozzarella, prosciutto, and a small portion of salad. (Reserve remaining salad for serving.)",
      "secondary_message": "4 whole grain pitas\n4 tsp mayonnaise"
    },
    {
      "id": 622780,
      "primary_message": "Divide pitas between plates and serve with remaining salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
