  "instructions": [
    {
      "id": 622866,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 tomatoes\n1 small pkg fresh basil\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 622867,
      "primary_message": "Peel, halve, and mince onion. Place in a large bowl along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "½ medium red onion\n3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 622868,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 622869,
      "primary_message": "Medium dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622870,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 622871,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 622872,
      "primary_message": "Slice mozzarella into rounds.",
      "secondary_message": "3 (227 g) pkgs fresh mozzarella cheese"
    },
    {
      "id": 622873,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread mayo on the inside of the pitas, then fill with mozzarella and a small portion of salad. (Reserve remaining salad for serving.)",
      "secondary_message": "6 whole grain pitas\n2 tbsp mayonnaise"
    },
    {
      "id": 622874,
      "primary_message": "Divide pitas between plates and serve with remaining salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
