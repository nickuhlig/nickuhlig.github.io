  "instructions": [
    {
      "id": 163008,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n6 sticks celery\n1 small bunch Italian (flat-leaf) parsley\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 163009,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 163010,
      "primary_message": "Zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 163011,
      "primary_message": "Peel and mince shallots; add to the bowl with the lemon and stir to combine.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 163012,
      "primary_message": "Trim celery and thinly slice crosswise at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 163013,
      "primary_message": "Thinly slice sun-dried tomatoes and add to the bowl.",
      "secondary_message": "15 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 163014,
      "primary_message": "Drain and thinly slice artichokes; add to the bowl.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 163015,
      "primary_message": "Halve olives lengthwise and add to the bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 163016,
      "primary_message": "Cut cheese into small cubes; add to the bowl.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 163017,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add most of the parsley to the bowl (reserve a small amount for garnish).",
      "secondary_message": null
    },
    {
      "id": 163018,
      "primary_message": "Drain and flake tuna. Add to the bowl along with beans, mayo, and pepper. Stir to combine the salad.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water\n3 tbsp mayonnaise\n½ tsp black pepper"
    },
    {
      "id": 163019,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Top with tuna salad and garnish with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
