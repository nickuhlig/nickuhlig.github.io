  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the shallots. Roughly crumble the Roquefort. Clean and debeard the mussels.",
      "secondary_message": "2 medium shallots\n50 g Roquefort\n0.91 kg mussels"
    },
    {
      "id": 1,
      "primary_message": "Heat the olive oil in a large straight-sided sauté pan or saucepan over medium heat until shimmering. Add the shallots, and cook, stirring constantly until just soft, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the wine and thyme, and increase the heat to high. When the wine boils, add the Roquefort and mussels. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cover the pot, and cook over medium-high heat, stirring occasionally, until all the mussels have opened, 4 to 5 minutes. Turn off the heat, stir in the cream, and serve with crusty bread.",
      "secondary_message": null
    }
  ],
