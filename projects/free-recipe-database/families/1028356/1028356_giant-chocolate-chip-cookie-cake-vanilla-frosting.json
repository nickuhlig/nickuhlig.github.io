  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Spray the bottom and sides of a 9-inch round cake pan with cooking spray. Cut a piece of parchment paper to fit the bottom and press down into the pan. Set aside.",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place butter in a small saucepan and melt over medium heat. Remove from heat.",
      "secondary_message": "½ cup butter, unsalted"
    },
    {
      "primary_message": "Meanwhile, place flour, baking soda, and salt in a medium bowl. Whisk to combine the dry ingredients and set aside.",
      "secondary_message": "1 cup all-purpose flour\n¼ tsp baking soda\n¼ tsp salt"
    },
    {
      "primary_message": "Transfer melted butter to another medium bowl, then add both sugars, egg, and vanilla. Whisk to combine the wet ingredients. \n\n",
      "secondary_message": "½ cup brown sugar\n¼ cup granulated sugar\n1 egg\n1 tsp vanilla extract"
    },
    {
      "primary_message": "Add the dry ingredients to bowl with the wet ingredients and stir until cookie dough is just combined. Add chocolate chips and stir once more to combine. Transfer cookie dough to the pan and spread out in an even layer.",
      "secondary_message": "½ cup milk chocolate chips"
    },
    {
      "primary_message": "Place pan in the preheated oven and bake until cookie is golden and edges are set, about 20 minutes. Remove from oven and set aside to cool completely, 1 hour.",
      "secondary_message": null
    },
    {
      "primary_message": "When the cookie is cool, transfer frosting to a piping bag with a star tip.",
      "secondary_message": "½ (16 oz) tub vanilla frosting"
    },
    {
      "primary_message": "Remove cookie from pan and place on a cutting board. Decorate with frosting around the edge, then top with sprinkles. Cut into wedges. ",
      "secondary_message": "2 tbsp rainbow sprinkles"
    },
    {
      "primary_message": "To serve, transfer cookie wedges to a platter, share, and enjoy! ",
      "secondary_message": null
    }
  ],
