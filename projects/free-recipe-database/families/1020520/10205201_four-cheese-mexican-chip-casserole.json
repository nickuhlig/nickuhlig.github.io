  "instructions": [
    {
      "primary_message": "Cook beef and onion in large skillet over medium heat 10 minutes or until beef is no longer pink, stirring frequently; pour off drippings. Add tomato sauce, chilies, cumin and salt; simmer 10 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "primary_message": "Coat medium casserole dish with cooking spray. Layer half of the tortilla chips, 3/4 cup cheese and half of the beef mixture in dish. Repeat layering with remaining chips, 3/4 cup cheese and beef mixture.",
      "secondary_message": null
    },
    {
      "primary_message": "Cover dish with foil; bake in preheated 350°F oven 20 minutes. Uncover; spread sour cream over beef mixture and top with remaining cheese. Return to oven; bake 10 minutes or until hot and cheese is melted.",
      "secondary_message": null
    }
  ],
