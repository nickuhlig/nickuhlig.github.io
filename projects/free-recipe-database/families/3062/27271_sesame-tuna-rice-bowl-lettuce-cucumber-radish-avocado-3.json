  "instructions": [
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ English cucumber\n½ bunch radish\n½ avocado\n½ head butter (Boston) lettuce"
    },
    {
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "While the rice is cooking, trim and cut green onions crosswise into thin pieces. Place half in a small bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "primary_message": "Drain tuna, add to the bowl with the green onion, and flake with a fork. Add mayo, oil, vinegar, soy sauce, and chili-garlic sauce; stir to combine and set aside. ",
      "secondary_message": "2 (6 oz) cans chunk light tuna in water\nmayonnaise\n2 tsp toasted sesame oil\nrice vinegar\n½ tsp chili-garlic sauce"
    },
    {
      "primary_message": "Place additional mayo, vinegar, soy sauce, sugar, and garlic powder in another small bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "mayonnaise\nrice vinegar\n1 tsp brown sugar\n½ tsp garlic powder"
    },
    {
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Place on a plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide rice, tuna, and veggies between bowls; top with reserved green onions and sesame seeds. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 ½ tsp sesame seeds"
    }
  ],
