  "instructions": [
    {
      "id": 439141,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 439142,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ English cucumbers\n1 ½ bunches radish\n1 ½ avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 439143,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 439144,
      "primary_message": "While the rice is cooking, trim and cut green onions crosswise into thin pieces. Place half in a large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 439145,
      "primary_message": "Drain tuna, add to the bowl with the green onion, and flake with a fork. Add mayo, oil, vinegar, soy sauce, and chili-garlic sauce; stir to combine and set aside. ",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water\n¾ cup mayonnaise\n2 tbsp toasted sesame oil\n1 tbsp rice vinegar\n1 tbsp soy sauce\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 439146,
      "primary_message": "Place additional mayo, vinegar, soy sauce, sugar, and garlic powder in a small bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n2 tbsp rice vinegar\n2 tbsp soy sauce\n1 tbsp brown sugar\n1 ½ tsp garlic powder"
    },
    {
      "id": 439147,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Place on a platter.",
      "secondary_message": null
    },
    {
      "id": 439148,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the platter with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 439149,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the platter.",
      "secondary_message": null
    },
    {
      "id": 439150,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips.",
      "secondary_message": null
    },
    {
      "id": 439151,
      "primary_message": "Divide rice, tuna, and veggies between bowls; top with reserved green onions and sesame seeds. Serve with dressing on the side and enjoy!",
      "secondary_message": "1 ½ tbsp sesame seeds"
    }
  ],
