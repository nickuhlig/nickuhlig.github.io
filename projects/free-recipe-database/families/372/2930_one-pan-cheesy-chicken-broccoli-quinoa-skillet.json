  "instructions": [
    {
      "id": 28511,
      "primary_message": "Peel and small dice the onion; transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 28512,
      "primary_message": "Peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 28513,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 28514,
      "primary_message": "Cut the chicken into bite-sized cubes.",
      "secondary_message": "1 lb chicken breasts, boneless skinless"
    },
    {
      "id": 28515,
      "primary_message": "Add olive oil to the pan and swirl to coat the bottom.",
      "secondary_message": "4 tbsp extra virgin olive oil"
    },
    {
      "id": 28516,
      "primary_message": "Add the onion and chicken to the pan; cook, stirring occasionally, until the onion is softened and the chicken is browned, 3 to 4 minutes. The chicken just needs to be browned and doesn't have to be cooked all the way through.",
      "secondary_message": null
    },
    {
      "id": 28517,
      "primary_message": "Add the garlic and stir until fragrant, 15 to 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 28518,
      "primary_message": "Add in the quinoa and broth; stir to combine. Bring to a boil, then reduce the heat to low, cover, and cook for 10 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 28519,
      "primary_message": "Wash the cutting board (if used to cut the chicken) and return to the counter.",
      "secondary_message": null
    },
    {
      "id": 28520,
      "primary_message": "While the quinoa cooks, wash the broccoli. Cut the broccoli heads into bite-sized florets and medium dice the stems.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 28521,
      "primary_message": "Coarsely grate 1 cup of cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 28522,
      "primary_message": "Once the quinoa has cooked for 10 minutes, quickly add the broccoli over the top and season with salt and pepper. Cook, covered, until the quinoa is cooked and the broccoli is tender, an additional 5 to 7 minutes.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 28523,
      "primary_message": "Stir the mixture, then sprinkle the cheddar over top; cook until the cheese is fully melted, 1 to 3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 28524,
      "primary_message": "Divide the dish between four plates (or two plates and two lunch containers). Enjoy!",
      "secondary_message": null
    }
  ],
