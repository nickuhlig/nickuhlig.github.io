  "instructions": [
    {
      "id": 151717,
      "primary_message": "Wash and dry the tomatoes; cut in half crosswise and set aside.",
      "secondary_message": "3 pints grape tomatoes"
    },
    {
      "id": 151718,
      "primary_message": "Peel and thinly slice shallots into rings. ",
      "secondary_message": "3 shallots"
    },
    {
      "id": 151719,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 151720,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the shallots and cook, stirring often, until soft and caramelized, 4-5 minutes.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 151721,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 151722,
      "primary_message": "Add tomatoes, garlic, and spices to the skillet. Cook, stirring often, until tomatoes begin to soften and juices have thickened, 5-6 minutes.",
      "secondary_message": "¾ tsp oregano\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 151723,
      "primary_message": "Meanwhile, toast the bread.",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 151724,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 151725,
      "primary_message": "Add basil to the skillet and stir to combine; remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 151726,
      "primary_message": "To serve, divide toast between plates. Spoon warm tomato mixture over the toast and top with feta. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
