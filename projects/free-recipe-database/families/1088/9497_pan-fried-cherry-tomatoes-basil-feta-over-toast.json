  "instructions": [
    {
      "id": 151697,
      "primary_message": "Peel and thinly slice the shallot into rings.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 151698,
      "primary_message": "Preheat a nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 151699,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 151700,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the shallots and cook, stirring often, until soft and caramelized, 2-3 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 151701,
      "primary_message": "Meanwhile, wash and dry the tomatoes; cut in half crosswise.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 151702,
      "primary_message": "Add tomatoes, garlic, and spices to the skillet. Cook, stirring often, until tomatoes begin to soften and juices have thickened, 3-4 minutes.",
      "secondary_message": "¼ tsp oregano\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 151703,
      "primary_message": "Toast the bread.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 151704,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 151705,
      "primary_message": "Add basil to the skillet and stir to combine; remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 151706,
      "primary_message": "To serve, divide toast between plates. Spoon warm tomato mixture over the toast and top with feta. Enjoy!",
      "secondary_message": "¼ (4 oz) pkg crumbled feta cheese"
    }
  ],
