  "instructions": [
    {
      "id": 431974,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 431975,
      "primary_message": "Coat two baking dishes with a thin layer of oil, then sprinkle Parmesan and Italian seasoning over the bottom each dish.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 cup Parmesan cheese, shredded\n1 tbsp Italian seasoning"
    },
    {
      "id": 431976,
      "primary_message": "Wash, dry, and halve potatoes. Arrange in the baking dishes, cut-side down, and press down firmly into the cheese. Drizzle with additional oil and season with salt.",
      "secondary_message": "1.02 kg new potatoes\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 431977,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and roast, undisturbed, until potatoes are tender and Parmesan is browned and crispy, 30-35 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 431978,
      "primary_message": "When the potatoes have about 15 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 431979,
      "primary_message": "While the skillet heats up, pat salmon dry with paper towels and place, skin-side down, on a plate. Season the top side of the salmon with salt and pepper.",
      "secondary_message": "1.02 kg salmon fillet\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 431980,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add salmon, skin-side down, and cook, flipping once, until skin is crispy and flesh is opaque, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 431981,
      "primary_message": "Meanwhile, wash, dry, and medium dice cucumbers. Place in a large bowl along with shredded cabbage and dressing, then stir to combine the salad.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n½ cup Italian salad dressing"
    },
    {
      "id": 431982,
      "primary_message": "To serve, divide salmon, potatoes, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
