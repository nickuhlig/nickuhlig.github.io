  "instructions": [
    {
      "id": 342726,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 ½ lemons\n3 English cucumbers\n3 yellow bell peppers\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 342727,
      "primary_message": "Cut cream cheese into small pieces and place in a medium bowl.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 342728,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the cream cheese.",
      "secondary_message": null
    },
    {
      "id": 342729,
      "primary_message": "Peel and mince garlic; add to the bowl. Use the back of a spoon to soften and combine the cream cheese mixture.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 342730,
      "primary_message": "Juice lemons into the bowl. Add yogurt, salt, and pepper; stir to combine and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 342731,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into (thin) half-moons.",
      "secondary_message": null
    },
    {
      "id": 342732,
      "primary_message": "Lay tortillas on a flat surface. Using a spatula, spread cream cheese mixture evenly over each tortilla.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 342733,
      "primary_message": "Top tortillas with half of the cucumbers (reserve remaining cucumbers for the salad); roll tightly to close and cut crosswise into pieces. Set aside.",
      "secondary_message": null
    },
    {
      "id": 342734,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 342735,
      "primary_message": "Add reserved cucumbers to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 342736,
      "primary_message": "Trim, seed, and thinly slice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 342737,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces; add to the bowl, along with the pine nuts, and toss to combine the salad.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 342738,
      "primary_message": "To serve, divide roll-ups and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
