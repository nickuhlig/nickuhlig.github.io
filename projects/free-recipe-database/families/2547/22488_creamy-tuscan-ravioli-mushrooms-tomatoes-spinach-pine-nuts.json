  "instructions": [
    {
      "id": 374608,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and ravioli, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions). Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n27 oz cheese ravioli, fresh or frozen"
    },
    {
      "id": 374609,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 374610,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 374611,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add garlic and cook until fragrant, about 30 seconds.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 374612,
      "primary_message": "Add mushrooms to the pot and cook, stirring occasionally, until golden brown, 4-5 minutes.",
      "secondary_message": "3 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 374613,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes.",
      "secondary_message": "3 pints grape tomatoes"
    },
    {
      "id": 374614,
      "primary_message": "Wash and dry the spinach. (Skip if it came pre-washed.)",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 374615,
      "primary_message": "When the mushrooms are done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 374616,
      "primary_message": "Add tomatoes and spices to the pot, then stir to combine. Continue to cook, stirring occasionally, until tomatoes begin to soften, 4-5 minutes.",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 374617,
      "primary_message": "Add ravioli and Alfredo sauce to the pot. Continue to cook, stirring occasionally, until sauce is warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 ½ (16 oz) jars Alfredo sauce"
    },
    {
      "id": 374618,
      "primary_message": "To serve, divide ravioli and sauce between plates or bowls. Sprinkle with pine nuts and enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
