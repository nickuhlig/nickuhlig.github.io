  "instructions": [
    {
      "id": 479692,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium yellow potatoes\n2 medium carrots\n1 lemon\n1 head romaine lettuce"
    },
    {
      "id": 479693,
      "primary_message": "Peel and medium dice potatoes. Place in a large pot.",
      "secondary_message": null
    },
    {
      "id": 479694,
      "primary_message": "Peel, trim, and medium dice carrots. Add to the pot with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 479695,
      "primary_message": "Peel and mince garlic. Add to the pot.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 479696,
      "primary_message": "Add broth, beans with their liquid (do not drain), and spices to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies and beans are tender, 12-15 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n2 (398 ml) cans pinto beans\n1 tsp salt\n½ tsp onion powder\n½ tsp rosemary, dried\n½ tsp crushed red pepper"
    },
    {
      "id": 479697,
      "primary_message": "Meanwhile, peel and mince additional garlic. Place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 479698,
      "primary_message": "Juice lemon into the bowl with the garlic. Add mayo, Dijon, soy sauce, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp Dijon mustard\n1 tsp soy sauce\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 479699,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing, toss to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 479700,
      "primary_message": "When the soup is done, remove from the heat. Use a hand blender to purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.) ",
      "secondary_message": null
    },
    {
      "id": 479701,
      "primary_message": "Coarsely grate cheese. Add to the soup and stir until melted and combined.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 479702,
      "primary_message": "Divide soup between bowls. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
