  "instructions": [
    {
      "id": 249205,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 249206,
      "primary_message": "Wash, dry, and trim eggplants; slice into ¼-inch thick rounds.",
      "secondary_message": "3 eggplants"
    },
    {
      "id": 249207,
      "primary_message": "Place eggplant in a large bowl along with oil, salt, and pepper. Toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 249208,
      "primary_message": "Divide eggplant between two baking sheet pans and arrange in a single layer. Place in the oven and roast, flipping halfway through, until eggplant is soft, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 249209,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half the parsley in a medium bowl (setting the rest aside for garnish).",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 249210,
      "primary_message": "Add tomato sauce, Italian seasoning, and salt to the bowl with the parsley; stir to combine.",
      "secondary_message": "4 ½ (213 ml) cans tomato sauce\n1 tbsp Italian seasoning\n1 ½ tsp salt"
    },
    {
      "id": 249211,
      "primary_message": "Grate mozzarella. Finely grate Parmesan.",
      "secondary_message": "3 (227 g) blocks mozzarella cheese\n170 g Parmesan cheese"
    },
    {
      "id": 249212,
      "primary_message": "Pour a thin layer of tomato sauce in the bottom of a large baking dish. Place half the roasted eggplant slices in the dish, arranging them in a single layer; top with half of the remaining sauce and half of the mozzarella and Parmesan. Repeat with the remaining eggplant, sauce, and cheese.",
      "secondary_message": null
    },
    {
      "id": 249213,
      "primary_message": "Place baking dish in the oven and bake until eggplant is warmed through and cheese is melted and bubbly, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 249214,
      "primary_message": "Remove dish from the oven and top with remaining parsley.",
      "secondary_message": null
    },
    {
      "id": 249215,
      "primary_message": "To serve, divide eggplant bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
