  "instructions": [
    {
      "id": 249161,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 249162,
      "primary_message": "Wash, dry, and trim eggplants; slice into ¼-inch thick rounds.",
      "secondary_message": "2 eggplants"
    },
    {
      "id": 249163,
      "primary_message": "Place eggplant in a large bowl along with oil, salt, and pepper. Toss to coat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 249164,
      "primary_message": "Arrange eggplant in a single layer on a large baking sheet pan. Place in the oven and roast, flipping halfway through, until eggplant is soft, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 249165,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half the parsley in a medium bowl (setting the rest aside for garnish).",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 249166,
      "primary_message": "Add tomato sauce, Italian seasoning, and salt to the bowl with the parsley; stir to combine.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n2 tsp Italian seasoning\n1 tsp salt"
    },
    {
      "id": 249167,
      "primary_message": "Grate mozzarella. Finely grate Parmesan.",
      "secondary_message": "2 (8 oz) blocks mozzarella cheese\n4 oz Parmesan cheese"
    },
    {
      "id": 249168,
      "primary_message": "Pour a thin layer of tomato sauce in the bottom of a medium baking dish. Place half the roasted eggplant slices in the dish, arranging them in a single layer; top with half of the remaining sauce and half of the mozzarella and Parmesan. Repeat with the remaining eggplant, sauce, and cheese.",
      "secondary_message": null
    },
    {
      "id": 249169,
      "primary_message": "Place baking dish in the oven and bake until eggplant is warmed through and cheese is melted and bubbly, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 249170,
      "primary_message": "Remove dish from the oven and top with remaining parsley.",
      "secondary_message": null
    },
    {
      "id": 249171,
      "primary_message": "To serve, divide eggplant bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
