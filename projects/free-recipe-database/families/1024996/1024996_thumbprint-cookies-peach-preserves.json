  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Line two large baking sheet pans with parchment paper. (Bake in batches, if necessary, depending on the size of your baking sheets.)",
      "secondary_message": null
    },
    {
      "primary_message": "Cut butter into small pieces. Place in a large bowl and set aside to soften.",
      "secondary_message": "¾ cup butter, unsalted"
    },
    {
      "primary_message": " Place flour, baking powder, and salt in a medium bowl. Whisk to combine the dry ingredients and set aside.",
      "secondary_message": "1 ¾ cups all-purpose flour\n½ tsp baking powder\n¼ tsp salt"
    },
    {
      "primary_message": "Place egg and vanilla in a small bowl. Whisk to combine the wet ingredients and set aside.",
      "secondary_message": "1 egg\n1 tsp vanilla extract"
    },
    {
      "primary_message": "Once the butter has softened, add sugar to the bowl and beat with a hand mixer on medium-high until light and fluffy, about 3 minutes. Scrape down the sides of the bowl with a silicone spatula.",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "primary_message": "Add wet ingredients to the bowl with the butter mixture. Mix on medium speed until fully combined. Scrape down the sides of the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Add dry ingredients to the bowl. Mix on low speed until just combined.",
      "secondary_message": null
    },
    {
      "primary_message": "Using a cookie scoop or tablespoon measure, drop rounded scoops of dough onto the baking sheets, spacing them 1 ½-inches apart. Using a clean, moistened finger or handle of a wooden spoon, make an indentation in the middle of the dough, creating a divot.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill each divot with ½ a teaspoon of preserves.",
      "secondary_message": "⅓ cup peach preserves"
    },
    {
      "primary_message": "Place baking sheets in the oven and bake until cookies start to turn golden around the edges, 14-16 minutes. Remove from oven and let cool.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, transfer cookies to a platter. Enjoy!",
      "secondary_message": null
    }
  ],
