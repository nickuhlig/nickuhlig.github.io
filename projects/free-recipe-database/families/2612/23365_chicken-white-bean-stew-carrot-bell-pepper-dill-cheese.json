  "instructions": [
    {
      "id": 419662,
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Place in a small bowl.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "id": 419663,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 419664,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl with the bell pepper along with the carrots.",
      "secondary_message": "1 medium yellow onion\n½ (283 g) bag shredded carrots"
    },
    {
      "id": 419665,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 7-8 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp garlic powder\n¼ tsp dill, dried"
    },
    {
      "id": 419666,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 419667,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces.",
      "secondary_message": "½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 419668,
      "primary_message": "Add beans, chicken, and broth to the pan; stir to combine the stew and bring to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until veggies and beans are soft, about 10 minutes. Remove from heat.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 419669,
      "primary_message": "To serve, divide stew between bowls and top with cheese. Enjoy!",
      "secondary_message": "½ cup shredded cheese, Mexican blend"
    }
  ],
