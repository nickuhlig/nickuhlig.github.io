  "instructions": [
    {
      "id": 68807,
      "primary_message": "In a bowl, beat the eggs. In another bowl, combine almond meal, garlic powder, salt, pepper.",
      "secondary_message": "3 eggs\n1 ½ cup almond meal/flour\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 68806,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 68805,
      "primary_message": "Slice chicken in half horizontally to form thin fillets.",
      "secondary_message": "0.681 kg chicken breasts, boneless skinless"
    },
    {
      "id": 68804,
      "primary_message": "Dip chicken fillets in the egg, then coat in the almond meal mixture.",
      "secondary_message": ""
    },
    {
      "id": 68803,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until golden brown and cooked through, 3-4 minutes per side.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 68798,
      "primary_message": "In a small bowl, prepare the dressing by whisking together mayo, olive oil, vinegar, honey, salt, pepper, and poppy seeds. Set aside.",
      "secondary_message": "9 tbsp avocado oil mayonnaise\n6 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n1 ½ tbsp honey\n¾ tsp salt\n⅜ tsp black pepper\n3 tsp poppy seeds"
    },
    {
      "id": 68802,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Slice or tear leaves apart into smaller pieces. Transfer to a large bowl. Drizzle with lemon juice and massage leaves with your hands for 2-3 minutes.",
      "secondary_message": "3 bunches kale\njuice of 1 ½ lemon"
    },
    {
      "id": 68801,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out into a bowl.",
      "secondary_message": "3 avocados"
    },
    {
      "id": 68800,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 68799,
      "primary_message": "To serve, arrange kale on a plate, then add avocado slices and chicken strips. Drizzle with poppyseed dressing and enjoy!",
      "secondary_message": ""
    }
  ],
