  "instructions": [
    {
      "id": 269779,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 269780,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 lemons\n3 tomatoes\n1 ½ English cucumbers\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 269781,
      "primary_message": "Place pita breads on a cutting board. Holding a knife parallel to the board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and divide between two large baking sheet pans. ",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 269782,
      "primary_message": "Zest lemons into a small bowl (set lemons aside for later use). Add oil and spices to the bowl; stir to combine the herb oil. ",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp oregano, dried\n¾ tsp thyme, dried"
    },
    {
      "id": 269783,
      "primary_message": "Spoon herb oil over the pita, toss with your hands to coat, then spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until the pita chips are crisp, 8-10 minutes. Remove from the oven. (Reserve bowl for next step.)",
      "secondary_message": null
    },
    {
      "id": 269784,
      "primary_message": "Meanwhile, peel and mince garlic. Place in the reserved bowl along with yogurt, water, vinegar, and spices; whisk to combine the garlic yogurt and set aside.",
      "secondary_message": "3 cloves garlic\n1 ½ cups plain Greek yogurt\n3 tbsp water\n1 tbsp red wine vinegar\n¾ tsp dill, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 269785,
      "primary_message": "Peel additional garlic and place in a blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 269786,
      "primary_message": "Juice half of the lemons into the blender with the garlic (reserve remaining lemons for the salad dressing).",
      "secondary_message": null
    },
    {
      "id": 269787,
      "primary_message": "Drain and rinse chickpeas; add to the blender along with water, tahini, and spices. Blend on high until hummus is smooth; set aside.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n¾ cup water\n3 tbsp tahini\n¾ tsp salt\n½ tsp cumin, ground\n½ tsp paprika"
    },
    {
      "id": 269788,
      "primary_message": "Trim and small dice cucumbers; small dice tomatoes. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 269789,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the cucumber and tomato; stir to combine the veggie topping and set aside.",
      "secondary_message": null
    },
    {
      "id": 269790,
      "primary_message": "Juice remaining lemons into a large bowl. Add oil, honey, and spices; whisk to combine the dressing. Add mixed greens and toss to combine the salad.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp honey\n½ tsp salt\n½ tsp black pepper\n3 pinch oregano, dried"
    },
    {
      "id": 269791,
      "primary_message": "To assemble the \"nachos,\" spoon hummus, garlic yogurt, and veggie topping over the pita chips. Sprinkle with feta.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 269792,
      "primary_message": "To serve, divide \"nachos\" and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
