  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F and position rack in the center.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash asparagus and snap off woody ends. Transfer to a baking sheet pan.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "primary_message": "Peel and mince garlic. Sprinkle over the asparagus.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "primary_message": "Drizzle asparagus with olive oil and season with salt and pepper. Turn to coat.",
      "secondary_message": "extra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place salmon in the middle of the sheet, moving asparagus to the sides. Rub salmon with olive oil and season with salt and pepper.",
      "secondary_message": "680 g salmon fillet\nextra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Place in the oven and roast until salmon is opaque and asparagus is tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Cut 1 lemon into wedges.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, place asparagus and salmon on a plate. Garnish with lemon wedges and enjoy!",
      "secondary_message": null
    }
