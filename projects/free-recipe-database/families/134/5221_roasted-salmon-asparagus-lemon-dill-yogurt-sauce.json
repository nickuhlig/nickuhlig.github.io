  "instructions": [
    {
      "id": 62866,
      "primary_message": "Preheat oven to 220°C (425°F) and position rack in the center.",
      "secondary_message": ""
    },
    {
      "id": 62865,
      "primary_message": "Wash asparagus and snap off woody ends. Transfer to a baking sheet pan.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 62864,
      "primary_message": "Peel and mince garlic. Sprinkle ⅔ of it over the asparagus (save the rest for the sauce).",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 62863,
      "primary_message": "Drizzle asparagus with olive oil and season with salt and pepper. Turn to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 62862,
      "primary_message": "Place salmon in the middle of the sheet, moving asparagus to the sides. Rub salmon with olive oil and season with salt and pepper.",
      "secondary_message": "1.02 kg salmon fillet\n3 tsp extra virgin olive oil\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 62861,
      "primary_message": "Place in the oven and roast until salmon is opaque and asparagus is tender, 10-12 minutes.",
      "secondary_message": ""
    },
    {
      "id": 62858,
      "primary_message": "In a small bowl, prepare sauce by mixing together remaining garlic, lemon juice, yogurt, dill, salt, and pepper.",
      "secondary_message": "juice of 1 ½ lemon\n¾ cup plain Greek yogurt\n3 tsp dill\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 62860,
      "primary_message": "Cut remaining lemons into wedges.",
      "secondary_message": ""
    },
    {
      "id": 62859,
      "primary_message": "To serve, place asparagus and salmon on a plate, drizzle with yogurt sauce, and garnish with lemon wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
