  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F. Coat two large baking dishes with a thin layer of oil and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Wash, dry, and juice lemon into a small bowl. Add apricot preserves, Dijon, sugar, and spices. Stir to combine the apricot glaze.",
      "secondary_message": "½ lemon\n½ cup apricot preserves\n2 tbsp Dijon mustard\n2 tbsp brown sugar\n¼ tsp cinnamon, ground\n⅛ tsp cloves, ground\n⅛ tsp salt"
    },
    {
      "primary_message": "Cut the ham in half lengthwise, then cut each half crosswise into 3 equal-sized steaks. Divide steaks between the baking dishes and arrange in a single layer. Drizzle apricot glaze over top.",
      "secondary_message": "907 g smoked ham, boneless"
    },
    {
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake until ham steaks are warmed through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer ham steaks to a serving platter and drizzle with apricot glaze from the dish. Enjoy!",
      "secondary_message": null
    }
  ],
