  "instructions": [
    {
      "id": 166194,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 166195,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 bunches radish\n½ red chili pepper\n½ small bunch cilantro"
    },
    {
      "id": 166196,
      "primary_message": "Peel and trim carrots; slice crosswise into ¼-inch thick rounds. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 166197,
      "primary_message": "Trim off and discard tops and root ends of radishes; halve and add to the pan with the carrots. Drizzle with oil and season with salt and pepper; toss to combine, then spread out in an even layer.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 166198,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway through, until veggies are tender, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 166199,
      "primary_message": "Meanwhile, preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 166200,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb ribeye steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 166201,
      "primary_message": "Once the grill pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a cutting board and let rest 5 minutes.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 166202,
      "primary_message": "Meanwhile, halve chili pepper lengthwise; seed and remove ribs of the pepper with a spoon. Mince and place in a small bowl. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 166203,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 166204,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 166205,
      "primary_message": "Drain and mince artichokes. Add to the bowl along with oil, vinegar, and spices; stir to combine the chimichurri.",
      "secondary_message": "½ (6 oz) jar artichoke hearts, marinated\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp oregano\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 166206,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 166207,
      "primary_message": "To serve, divide steak and veggies between plates. Spoon chimichurri over the steak and enjoy!",
      "secondary_message": null
    }
  ],
