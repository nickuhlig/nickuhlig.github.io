  "instructions": [
    {
      "id": 166334,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 166335,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 bunches radish\n1 red chili pepper\n1 small bunch cilantro"
    },
    {
      "id": 166336,
      "primary_message": "Peel and trim carrots; slice crosswise into ¼-inch thick rounds. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 166337,
      "primary_message": "Trim off and discard tops and root ends of radishes; halve and add to the pan with the carrots. Drizzle with oil and season with salt and pepper; toss to combine, then spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 166338,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway through, until veggies are tender, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 166339,
      "primary_message": "Meanwhile, preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 166340,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 166341,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a cutting board and let rest 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 166342,
      "primary_message": "Meanwhile, halve chili pepper lengthwise; seed and remove ribs of the pepper with a spoon. Mince and place in a medium bowl. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 166343,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 166344,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 166345,
      "primary_message": "Drain and mince artichokes. Add to the bowl along with oil, vinegar, and spices; stir to combine the chimichurri.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 166346,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 166347,
      "primary_message": "To serve, divide steak and veggies between plates. Spoon chimichurri over the steak and enjoy!",
      "secondary_message": null
    }
  ],
