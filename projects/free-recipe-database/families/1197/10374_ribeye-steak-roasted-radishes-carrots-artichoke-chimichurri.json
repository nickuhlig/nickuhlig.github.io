  "instructions": [
    {
      "id": 166306,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 166307,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 bunches radish\n1 ½ red chili peppers\n1 ½ small bunches cilantro"
    },
    {
      "id": 166308,
      "primary_message": "Peel and trim carrots; slice crosswise into ¼-inch thick rounds. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 166309,
      "primary_message": "Trim off and discard tops and root ends of radishes; halve and place on a second, large baking sheet pan. Drizzle  veggies with oil and season with salt and pepper; toss to combine, then spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 166310,
      "primary_message": "Place baking sheets in the oven and roast, tossing halfway through, until veggies are tender, about 25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 166311,
      "primary_message": "Meanwhile, preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 166312,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 166313,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a cutting board and let rest 5 minutes.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 166314,
      "primary_message": "Meanwhile, halve chili peppers lengthwise; seed and remove ribs of the peppers with a spoon. Mince and place in a medium bowl. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 166315,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 166316,
      "primary_message": "Shave cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 166317,
      "primary_message": "Drain and mince artichokes. Add to the bowl along with oil, vinegar, and spices; stir to combine the chimichurri.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated\n⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp oregano\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 166318,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 166319,
      "primary_message": "To serve, divide steak and veggies between plates. Spoon chimichurri over the steak and enjoy!",
      "secondary_message": null
    }
  ],
