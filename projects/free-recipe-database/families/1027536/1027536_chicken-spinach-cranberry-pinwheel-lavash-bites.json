  "instructions": [
    {
      "primary_message": "Drain chicken, place in a medium bowl, and mash with a potato masher or fork. Add mayo, cranberries, relish, salt, and pepper, then stir to combine the filling. Set aside.",
      "secondary_message": "2 (4.5 oz) can chunk chicken breast in water\n¼ cup mayonnaise\n¼ cup dried cranberries\n3 tbsp sweet pickle relish\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "2 cups baby spinach"
    },
    {
      "primary_message": "Arrange lavash on a flat surface. Divide chicken filling between them, then spread out in an even layer. Top with spinach, then roll tightly to close.\n\n",
      "secondary_message": "2 (8 x 10-inch) piece lavash bread"
    },
    {
      "primary_message": "Cut each lavash roll-up crosswise into 1 1/2-inch \"pinwheels.\" (Secure with toothpicks if necessary.)",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange pinwheels on a platter and enjoy!",
      "secondary_message": null
    }
