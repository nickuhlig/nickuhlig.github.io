  "instructions": [
    {
      "id": 245721,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ mangoes\n3 (2 ½ cm) pieces ginger root\n1 ½ limes\n1 ½ English cucumbers\n3 small pkgs grape tomatoes\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 245722,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides. Coarsely chop and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 245723,
      "primary_message": "Peel and roughly chop ginger; add to the blender.",
      "secondary_message": null
    },
    {
      "id": 245724,
      "primary_message": "Add ketchup, vinegar, soy sauce, sugar, and spices to the blender. Blend on high until smooth, adding water, 1 tbsp at a time, if needed, to reach a sauce consistency. Pour half of the BBQ sauce into a large bowl; set remaining sauce aside.",
      "secondary_message": "⅓ cup ketchup\n⅓ cup apple cider vinegar\n2 tbsp soy sauce\n2 tbsp brown sugar\n¾ tsp cinnamon, ground\n¾ tsp turmeric, ground\n½ tsp black pepper"
    },
    {
      "id": 245725,
      "primary_message": "Preheat a large grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 245726,
      "primary_message": "While the grill pan heats up, add drumsticks to the bowl with the sauce and turn to coat.",
      "secondary_message": "1.7 kg chicken drumsticks"
    },
    {
      "id": 245727,
      "primary_message": "Working in batches if necessary, place drumsticks on the pan and grill, turning occasionally, until cooked through, 15-18 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 245728,
      "primary_message": "Meanwhile, juice limes into another large bowl. Add oil and spices; whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp cumin, ground\n¾ tsp black pepper"
    },
    {
      "id": 245729,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 245730,
      "primary_message": "Halve tomatoes and add to the bowl along with arugula; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 245731,
      "primary_message": "When the chicken is done, remove to a baking dish and top with remaining BBQ sauce.",
      "secondary_message": null
    },
    {
      "id": 245732,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
