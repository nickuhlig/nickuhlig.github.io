  "instructions": [
    {
      "id": 245697,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ mango\n1 (2 ½ cm) piece ginger root\n½ lime\n½ English cucumber\n1 small pkg grape tomatoes\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 245698,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides. Coarsely chop and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 245699,
      "primary_message": "Peel and roughly chop ginger; add to the blender.",
      "secondary_message": null
    },
    {
      "id": 245700,
      "primary_message": "Add ketchup, vinegar, soy sauce, sugar, and spices to the blender. Blend on high until smooth, adding water, 1 tbsp at a time, if needed, to reach a sauce consistency. Pour half of the BBQ sauce into a medium bowl; set remaining sauce aside.",
      "secondary_message": "2 tbsp ketchup\n2 tbsp apple cider vinegar\n2 tsp soy sauce\n2 tsp brown sugar\n¼ tsp cinnamon, ground\n¼ tsp turmeric, ground\n⅛ tsp black pepper"
    },
    {
      "id": 245701,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 245702,
      "primary_message": "While the grill pan heats up, add drumsticks to the bowl with the sauce and turn to coat.",
      "secondary_message": "0.57 kg chicken drumsticks"
    },
    {
      "id": 245703,
      "primary_message": "Place drumsticks on the pan and grill, turning occasionally, until cooked through, about 15 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 245704,
      "primary_message": "Meanwhile, juice lime into another medium bowl. Add oil and spices; whisk to combine the dressing.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp cumin, ground\n¼ tsp black pepper"
    },
    {
      "id": 245705,
      "primary_message": "Trim and medium dice cucumber; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 245706,
      "primary_message": "Halve tomatoes and add to the bowl along with arugula; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 245707,
      "primary_message": "When the chicken is done, remove to a plate and top with remaining BBQ sauce.",
      "secondary_message": null
    },
    {
      "id": 245708,
      "primary_message": "To serve, divide chicken and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
