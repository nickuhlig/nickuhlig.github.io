  "instructions": [
    {
      "id": 448447,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 448448,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1.02 kg new potatoes\n3 Gala apples"
    },
    {
      "id": 448449,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 448450,
      "primary_message": "Quarter potatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 448451,
      "primary_message": "Quarter, core, and large dice apples. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 448452,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick strips. Add to the bowl along with oil and spices, then stir to combine. Divide mixture between two large baking sheet pans and spread out in an even layer.",
      "secondary_message": "1 ½ medium yellow onions\n3 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 448453,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the potatoes are just tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 448454,
      "primary_message": "Meanwhile, place mayo, water, curry powder, and salt in another small bowl. Stir to combine and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n2 tbsp water\n1 ½ tsp curry powder\n3 pinch salt"
    },
    {
      "id": 448455,
      "primary_message": "Slice sausages into 1-inch thick rounds.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 448456,
      "primary_message": "When the potatoes are just tender, remove baking sheets from the oven. Add sausages, drizzle with additional oil, and stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 448457,
      "primary_message": "Return baking sheets to the oven and continue to cook until sausages are warmed through, 4-5 minutes more (or cook sausages according to package instructions). Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 448458,
      "primary_message": "Meanwhile, place sauerkraut in a medium saucepan. Set over high heat and bring to a simmer, stirring occasionally. Cover and remove from heat.",
      "secondary_message": "3 cups sauerkraut"
    },
    {
      "id": 448459,
      "primary_message": "Add parsley to the baking sheets with the veggies and sausage, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 448460,
      "primary_message": "To serve, divide sausage bake between plates or bowls. Drizzle with curry mayo and top with warm sauerkraut. Enjoy!",
      "secondary_message": null
    }
  ],
