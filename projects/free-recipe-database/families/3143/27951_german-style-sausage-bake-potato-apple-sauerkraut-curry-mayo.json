  "instructions": [
    {
      "id": 448245,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 448246,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n2 ¼ lb new potatoes\n3 Gala apples"
    },
    {
      "id": 448247,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 448248,
      "primary_message": "Quarter potatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 448249,
      "primary_message": "Quarter, core, and large dice apples. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 448250,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick strips. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 448251,
      "primary_message": "Slice sausages into 1-inch thick rounds. Add to the bowl along with oil and spices, then stir to combine. Divide mixture between two large baking sheet pans and spread out in an even layer.",
      "secondary_message": "6 pork sausages\n3 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 448252,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until the potatoes are tender and sausage is cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 448253,
      "primary_message": "Meanwhile, place mayo, water, curry powder, and salt in another small bowl. Stir to combine the curry mayo and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp water\n1 ½ tsp curry powder\n3 pinch salt"
    },
    {
      "id": 448254,
      "primary_message": "When the sausage bake has about 5 minutes left, place sauerkraut in a medium saucepan. Set over high heat and bring to a simmer, stirring occasionally. Cover and remove from heat.",
      "secondary_message": "3 cups sauerkraut"
    },
    {
      "id": 448255,
      "primary_message": "Add parsley to the baking sheets with the veggies and sausage, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 448256,
      "primary_message": "To serve, divide sausage bake between plates or bowls. Drizzle with curry mayo and top with warm sauerkraut. Enjoy!",
      "secondary_message": null
    }
  ],
