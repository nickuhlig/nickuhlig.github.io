  "instructions": [
    {
      "id": 448377,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 448378,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n⅓ kg new potatoes\n1 Gala apple"
    },
    {
      "id": 448379,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl and set aside for later use.",
      "secondary_message": null
    },
    {
      "id": 448380,
      "primary_message": "Quarter potatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 448381,
      "primary_message": "Quarter, core, and large dice apple. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 448382,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick strips. Add to the bowl along with oil and spices, then stir to combine. Transfer mixture to a baking sheet pan and spread out in an even layer.",
      "secondary_message": "½ medium yellow onion\n1 tbsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 448383,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the potatoes are just tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 448384,
      "primary_message": "Meanwhile, place mayo, water, curry powder, and salt in another small bowl. Stir to combine and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp water\n½ tsp curry powder\n1 pinch salt"
    },
    {
      "id": 448385,
      "primary_message": "Slice sausages into 1-inch thick rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 448386,
      "primary_message": "When the potatoes are just tender, remove baking sheet from the oven. Add sausages, drizzle with additional oil, and stir to combine.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 448387,
      "primary_message": "Return baking sheet to the oven and continue to cook until sausages are warmed through, 4-5 minutes more (or cook sausages according to package instructions). Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 448388,
      "primary_message": "Meanwhile, place sauerkraut in a small saucepan. Set over high heat and bring to a simmer, stirring occasionally. Cover and remove from heat.",
      "secondary_message": "1 cup sauerkraut"
    },
    {
      "id": 448389,
      "primary_message": "Add parsley to the baking sheet with the veggies and sausage, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 448390,
      "primary_message": "To serve, divide sausage bake between plates or bowls. Drizzle with curry mayo and top with warm sauerkraut. Enjoy!",
      "secondary_message": null
    }
  ],
