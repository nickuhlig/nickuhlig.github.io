  "instructions": [
    {
      "id": 484451,
      "primary_message": "Place eggs in a large pot, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "18 eggs"
    },
    {
      "id": 484452,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch Italian (flat-leaf) parsley\n9 medium carrots\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 484453,
      "primary_message": "Juice lemons into a large bowl. Add oil, honey, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tbsp honey\n2 ½ tsp Dijon mustard\n¾ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 484454,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 484455,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 484456,
      "primary_message": "Peel and halve the eggs. Season with salt.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 484457,
      "primary_message": "Place mayo, water, and additional salt in a small bowl. Whisk to combine.",
      "secondary_message": "¾ cup mayonnaise\n2 tbsp water\n3 pinch salt"
    },
    {
      "id": 484458,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with carrot salad and eggs. Spoon mayo sauce over eggs, top with capers, and season with pepper. Enjoy!",
      "secondary_message": "3 tbsp capers\n½ tsp black pepper"
    }
  ],
