  "instructions": [
    {
      "id": 102436,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (16 oz) pkg strawberries\n2 kiwifruit\n2 oranges\n2 limes"
    },
    {
      "id": 102437,
      "primary_message": "Trim the strawberry tops and thinly slice; add to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 102438,
      "primary_message": "Using a knife, trim off the ends and peel the kiwis; slice into pieces and add to the bowl with the strawberries.",
      "secondary_message": null
    },
    {
      "id": 102439,
      "primary_message": "Slice off a piece from both orange ends, then place it flat on one of the ends and slice off the peel (from top to bottom), exposing the flesh; cut out the segments of flesh from between the membranes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 102440,
      "primary_message": "Juice the limes into the bowl with the fruit and toss to combine, set aside.",
      "secondary_message": null
    },
    {
      "id": 102441,
      "primary_message": "In a medium bowl, whisk together the eggs, milk, and cinnamon.",
      "secondary_message": "4 eggs\n4 fl oz (½ cup) whole milk\n½ tsp cinnamon"
    },
    {
      "id": 102442,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 102443,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 102444,
      "primary_message": "Working in batches, dip the slices of bread into the egg batter, covering both sides. Place into the hot skillet and cook for 2-3 min per side, until each side is browned evenly.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 102445,
      "primary_message": "Remove the slices of bread from the skillet and divide onto plates. Top with butter and a drizzle of maple syrup. Serve the fruit salad on the side. Enjoy!",
      "secondary_message": "2 tsp butter, unsalted\n¼ cup pure maple syrup"
    }
  ],
