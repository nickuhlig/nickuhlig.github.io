  "instructions": [
    {
      "id": 158297,
      "primary_message": "Cut chicken into thin strips.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 158298,
      "primary_message": "Preheat a large skillet over medium-high heat. Once skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 158299,
      "primary_message": "Add chicken and spices to the skillet; sauté until golden brown and cooked through, 5-7 minutes. Transfer chicken to a large bowl and cover with foil.",
      "secondary_message": "2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 158300,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 158301,
      "primary_message": "Wash, dry, and finely chop spinach. (Skip washing if it came pre-washed.)",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 158302,
      "primary_message": "Grate mozzarella and Parmesan.",
      "secondary_message": "½ (227 g) block mozzarella cheese\n57 g Parmesan cheese"
    },
    {
      "id": 158303,
      "primary_message": "Drain and finely chop artichokes.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 158304,
      "primary_message": "Return skillet to medium heat. Add more butter and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 158305,
      "primary_message": "Add garlic to the skillet and cook until fragrant, 15-30 seconds.",
      "secondary_message": null
    },
    {
      "id": 158306,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 158307,
      "primary_message": "Add mozzarella, Parmesan, artichokes, yogurt, and salt to the skillet. Stir until combined and cheese has melted. Transfer mixture to the bowl with the chicken and stir to combine. Wipe skillet clean and return to medium heat.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 158308,
      "primary_message": "Place bread slices on a flat surface. Top half the slices with the spinach-chicken mixture. Cover sandwiches with remaining bread slices.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 158309,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Cooking in batches if necessary, place sandwiches in the skillet and cook until bottoms are golden brown, 2-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 158310,
      "primary_message": "Remove sandwiches to a plate and add more butter to the skillet; return sandwiches to the skillet, browned-side-up, and cook until golden brown on the other side, 2-4 minutes more. Once done, transfer to a cutting board.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 158311,
      "primary_message": "To serve, cut sandwiches in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
