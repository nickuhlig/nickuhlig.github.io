  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the water heats up, wash, dry, and trim the green beans. Place in a large bowl. ",
      "secondary_message": "680 g green beans"
    },
    {
      "primary_message": "Once the water in the pot is boiling, uncover, add salt and green beans, and stir for a few seconds. Cook, stirring occasionally, until just tender, 3-4 minutes. Drain and rinse under cold water to cool; set aside. ",
      "secondary_message": "salt"
    },
    {
      "primary_message": "Meanwhile, peel and mince shallots and garlic. ",
      "secondary_message": "3 clove garlic"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add shallot, garlic, and almonds; cook, stirring occasionally, until fragrant, 3-4 minutes. ",
      "secondary_message": "3 tbsp butter, unsalted\n⅓ cup almonds, sliced"
    },
    {
      "primary_message": "Add drained green beans, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until beans are warmed through, about 2 minutes. Remove from heat.  ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, wash and dry lemon. When the green beans are done, zest and juice lemon into the skillet, then stir to combine.  ",
      "secondary_message": "½ lemon"
    }
  ],
