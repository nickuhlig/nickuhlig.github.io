  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n1 medium zucchini squash"
    },
    {
      "primary_message": "Peel, trim, and roughly chop carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim, seed, and roughly chop bell pepper. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and roughly chop zucchini. Add to the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pan heats up, peel, halve, and roughly chop onion. Add to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "primary_message": "When the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies are fork-tender, about 10 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "When the veggies are tender, add tomatoes to the pot; stir to combine the sauce and bring to a simmer over high heat. Once simmering, reduce to medium and continue to cook, stirring occasionally, until veggies are very soft, 15 minutes more.",
      "secondary_message": "2 (14.5 oz) can diced tomatoes"
    },
    {
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "primary_message": "When the veggies are very soft, using a hand blender, purée the sauce until smooth. (If using a regular blender, work in batches as needed, then return sauce to the pot.)",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls, then top with sauce and Parmesan. Enjoy! ",
      "secondary_message": "⅔ cup Parmesan cheese, shredded"
    }
  ],
