  "instructions": [
    {
      "id": 479953,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 479954,
      "primary_message": "Cut or tear bread into bite-sized pieces. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "6 slices sourdough bread\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 479955,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until croutons are golden and toasted, 10-12 minutes. Remove from oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 479956,
      "primary_message": "Meanwhile, peel, halve, and mince onion. Peel and mince garlic. Place both in a large bowl along with oil, vinegar, and spices. Whisk to combine the dressing. ",
      "secondary_message": "½ medium red onion\n3 cloves garlic\n¼ cup extra virgin olive oil\n¼ cup red wine vinegar\n1 ½ tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 479957,
      "primary_message": "Drain tuna, add to the bowl with the dressing, and flake with a fork. Stir to combine. ",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 479958,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 ½ English cucumbers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 479959,
      "primary_message": "Large dice tomatoes. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 479960,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 479961,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 479962,
      "primary_message": "Roughly chop olives. Add to the bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 479963,
      "primary_message": "Chop or tear mozzarella into bite-sized pieces. Add to the bowl.",
      "secondary_message": "1 ½ (8 oz) pkgs fresh mozzarella cheese"
    },
    {
      "id": 479964,
      "primary_message": "Add the cooled croutons and capers to the bowl. Stir once more to combine the salad.",
      "secondary_message": "4 ½ tbsp capers"
    },
    {
      "id": 479965,
      "primary_message": "To serve, divide panzanella salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
