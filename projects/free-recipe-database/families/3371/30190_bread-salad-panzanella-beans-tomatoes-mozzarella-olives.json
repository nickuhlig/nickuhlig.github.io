  "instructions": [
    {
      "id": 479966,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 479967,
      "primary_message": "Cut or tear bread into bite-sized pieces. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "2 slices sourdough bread\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 479968,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until croutons are golden and toasted, about 10 minutes. Remove from oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 479969,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place both in a medium bowl along with the vinegar, oil, and spices. Whisk to combine the dressing. ",
      "secondary_message": "1 shallot\n1 clove garlic\n1 ½ tbsp red wine vinegar\n1 tbsp extra virgin olive oil\n½ tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 479970,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing and stir to combine. ",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 479971,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n½ English cucumber\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 479972,
      "primary_message": "Large dice tomatoes. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 479973,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 479974,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 479975,
      "primary_message": "Roughly chop olives. Add to the bowl.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 479976,
      "primary_message": "Chop or tear mozzarella into bite-sized pieces. Add to the bowl.",
      "secondary_message": "½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 479977,
      "primary_message": "Add the cooled croutons and capers to the bowl. Stir once more to combine the salad.",
      "secondary_message": "1 ½ tbsp capers"
    },
    {
      "id": 479978,
      "primary_message": "To serve, divide panzanella salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
