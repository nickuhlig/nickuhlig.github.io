  "instructions": [
    {
      "id": 154158,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 154159,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 154160,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add pork chops and sear to develop a nice brown crust on one side, about 4 minutes. Flip and cook until other side is browned, about 3 more minutes. Transfer to a plate.",
      "secondary_message": "1 tbsp butter, unsalted\n2 pork chops, boneless"
    },
    {
      "id": 154161,
      "primary_message": "Meanwhile, peel and small dice the onion. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 154162,
      "primary_message": "Once you have removed the pork chops, reduce heat to medium, and add the onion. Cook, stirring occasionally, until softened, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 154163,
      "primary_message": "Wash and dry cabbage. Trim off and discard root end; halve lengthwise, then thinly slice crosswise.",
      "secondary_message": "½ medium head napa cabbage"
    },
    {
      "id": 154164,
      "primary_message": "Add cabbage to the skillet along with butter, salt, and pepper. Cook until tender, 2-3 minutes. Transfer the vegetables to a plate and cover with foil. ",
      "secondary_message": "2 tsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 154165,
      "primary_message": "Wash and juice lemon into the skillet. Add cream and mustard; stir until well combined. ",
      "secondary_message": "½ lemon\n4 fl oz (½ cup) heavy cream\n1 tbsp Dijon mustard"
    },
    {
      "id": 154166,
      "primary_message": "Add pork chops back to the pan; simmer over medium-low heat, spooning sauce over chops occasionally, until sauce thickens slightly, 3-4 minutes. Ensure pork chops are cooked through before removing from heat. ",
      "secondary_message": null
    },
    {
      "id": 154167,
      "primary_message": "To serve, divide cabbage between plates, top with pork chops, and drizzle with sauce. Enjoy! ",
      "secondary_message": null
    }
  ],
