  "instructions": [
    {
      "id": 245385,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 245386,
      "primary_message": "Once the skillet is hot, add bacon and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 245387,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245388,
      "primary_message": "Return skillet to medium-high heat; add chicken and stir-fry until golden and cooked through, 4-5 minutes. Use a slotted spoon to transfer the chicken to a plate, leaving the cooking juices in the skillet.",
      "secondary_message": null
    },
    {
      "id": 245389,
      "primary_message": "While the chicken is cooking, using a clean cutting board, peel, halve, and slice onion into thin half-moons. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 245390,
      "primary_message": "Return the skillet to medium-high heat; once the skillet is hot, add onion, garlic, corn, and spices. Cook, stirring occasionally, until the veggies are tender and starting to brown, 4-5 minutes.",
      "secondary_message": "1 cup frozen corn\n1 tsp thyme, dried\n½ tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245391,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 245392,
      "primary_message": "Add tomatoes and peas to the skillet, stirring to combine the succotash; continue to cook, stirring occasionally, until heated through, about 4 minutes.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 245393,
      "primary_message": "While the succotash is cooking, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 245394,
      "primary_message": "Chop or crumble bacon into pieces. ",
      "secondary_message": null
    },
    {
      "id": 245395,
      "primary_message": "Return chicken (with any accumulated juices), bacon, and parsley to the skillet (reserving a small handful of parsley for garnish). Stir to combine and cook until heated through, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 245396,
      "primary_message": "To serve, divide succotash between plates or bowls. Top with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
