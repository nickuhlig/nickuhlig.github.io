  "instructions": [
    {
      "id": 245445,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 245446,
      "primary_message": "Once the pot is hot, working in batches if necessary, add bacon and cook until crispy, 3-5 minutes per side. Remove to a paper towel-lined plate, leaving the drippings in the pot.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 245447,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 245448,
      "primary_message": "Return pot to medium-high heat; add chicken and stir-fry until golden and cooked through, 6-7 minutes. Use a slotted spoon to transfer the chicken to a plate, leaving the cooking juices in the pot.",
      "secondary_message": null
    },
    {
      "id": 245449,
      "primary_message": "While the chicken is cooking, using a clean cutting board, peel, halve, and slice onions into thin half-moons. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 245450,
      "primary_message": "Return the pot to medium-high heat; once the pot is hot, add onion, garlic, corn, and spices. Cook, stirring occasionally, until the veggies are tender and starting to brown, 6-7 minutes.",
      "secondary_message": "3 cups frozen corn\n1 tbsp thyme, dried\n1 ½ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 245451,
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes lengthwise.",
      "secondary_message": "3 small pkgs grape tomatoes"
    },
    {
      "id": 245452,
      "primary_message": "Add tomatoes and peas to the pot, stirring to combine the succotash; continue to cook, stirring occasionally, until heated through, about 6 minutes.",
      "secondary_message": "3 cups frozen peas"
    },
    {
      "id": 245453,
      "primary_message": "While the succotash is cooking, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 245454,
      "primary_message": "Chop or crumble bacon into pieces. ",
      "secondary_message": null
    },
    {
      "id": 245455,
      "primary_message": "Return chicken (with any accumulated juices), bacon, and parsley to the pot (reserving a small handful of parsley for garnish). Stir to combine and cook until heated through, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 245456,
      "primary_message": "To serve, divide succotash between plates or bowls. Top with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
