  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Coat a large baking dish with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the water heats up, wash, dry, trim, and halve Brussels sprouts lengthwise.\n\n",
      "secondary_message": "2 ¼ lb Brussels sprouts"
    },
    {
      "primary_message": "Once the water in the pot is boiling, uncover, add salt and Brussels sprouts, then stir for a few seconds. Reduce heat to medium and cook until bright green, about 2 minutes. Drain in a colander and rinse under cold water; set aside. \n\n",
      "secondary_message": "1 tsp salt"
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim, and slice green onions crosswise into thin pieces. Place a handful in a small bowl and set aside for serving. ",
      "secondary_message": "1 small bunch green onion (scallion)"
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel and mince garlic. ",
      "secondary_message": "2 clove garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add remaining green onions, garlic, and spices; cook, stirring occasionally, until softened, about 2 minutes. \n\n",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp thyme, dried\n½ tsp salt\n½ tsp black pepper\n¼ tsp nutmeg, ground\n⅛ tsp crushed red pepper"
    },
    {
      "primary_message": "Add cream to the skillet, stir to combine, and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until slightly thickened, about 2 minutes. ",
      "secondary_message": "1 ½ cups heavy whipping cream"
    },
    {
      "primary_message": "Add cheese to the skillet and stir to combine. Continue to cook, stirring occasionally, until cheese is melted and sauce is smooth, about 2 minutes. Remove from heat. ",
      "secondary_message": "1 cup sharp cheddar cheese, shredded"
    },
    {
      "primary_message": "Add drained Brussels sprouts to the skillet, then stir to combine. Transfer to the baking dish and top with additional cheese. \n\n",
      "secondary_message": "1 cup sharp cheddar cheese, shredded"
    },
    {
      "primary_message": "Place baking dish in the oven and bake until cheese is golden brown and sauce is bubbling, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Sprinkle with reserved green onions, share, and enjoy!",
      "secondary_message": null
    }
  ],
