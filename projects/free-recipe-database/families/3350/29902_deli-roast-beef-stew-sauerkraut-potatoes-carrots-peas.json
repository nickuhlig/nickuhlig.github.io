  "instructions": [
    {
      "id": 476001,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 476002,
      "primary_message": "While the pan heats up, wash, dry, trim, and cut green onions crosswise into thin pieces.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 476003,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add half of the green onions (reserving the rest for serving), shredded carrots, and spices; cook, stirring occasionally, until veggies soften, 3-4 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ (283 g) bag shredded carrots\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 476004,
      "primary_message": "Meanwhile, drain sauerkraut in a colander.",
      "secondary_message": "1 ½ cups sauerkraut"
    },
    {
      "id": 476005,
      "primary_message": "When the carrots have softened, add sauerkraut, broth, and shredded potatoes to the pan; stir to combine the stew and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until potatoes are tender, about 15 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n2 cups frozen shredded hash brown potatoes"
    },
    {
      "id": 476006,
      "primary_message": "Meanwhile, stack roast beef slices one on top of another, then medium dice. ",
      "secondary_message": "227 g deli roast beef"
    },
    {
      "id": 476007,
      "primary_message": "When the potatoes are tender, add roast beef and peas to the stew. Stir to combine and continue to cook until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 476008,
      "primary_message": "To serve, divide stew between bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
