  "instructions": [
    {
      "id": 475993,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 475994,
      "primary_message": "While the pot heats up, wash, dry, trim, and cut green onions crosswise into thin pieces.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 475995,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add half of the green onions (reserving the rest for serving), shredded carrots, and spices; cook, stirring occasionally, until veggies soften, 4-5 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ (10 oz) bags shredded carrots\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 475996,
      "primary_message": "Meanwhile, drain sauerkraut in a colander.",
      "secondary_message": "4 ½ cups sauerkraut"
    },
    {
      "id": 475997,
      "primary_message": "When the carrots have softened, add sauerkraut, broth, and shredded potatoes to the pot; stir to combine the stew and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until potatoes are tender, about 15 minutes.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n6 cups frozen shredded hash brown potatoes"
    },
    {
      "id": 475998,
      "primary_message": "Meanwhile, stack roast beef slices one on top of another, then medium dice. ",
      "secondary_message": "24 oz deli roast beef"
    },
    {
      "id": 475999,
      "primary_message": "When the potatoes are tender, add roast beef and peas to the stew. Stir to combine and continue to cook until warmed through, 2-3 minutes more. Remove from heat.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 476000,
      "primary_message": "To serve, divide stew between bowls. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
