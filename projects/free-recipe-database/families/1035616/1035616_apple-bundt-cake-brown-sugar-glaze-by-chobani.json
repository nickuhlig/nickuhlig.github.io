  "instructions": [
    {
      "primary_message": "TO MAKE SPICED APPLE BUNDT CAKE: Preheat oven to 350°F.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In a stand mixer on medium speed, beat sugar, oil, and eggs until light in color, about 3 minutes.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add vanilla extract and Chobani® whole milk plain Greek yogurt. Mix until incorporated, about 1 minute.\n",
      "secondary_message": null
    },
    {
      "primary_message": "In a medium bowl, sift all dry ingredients together.\n",
      "secondary_message": null
    },
    {
      "primary_message": "With mixer on low speed, spoon dry ingredients to form batter. Mix until just combined, about 1 minute.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add apples and fold in with spatula.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Grease Bundt cake pan with nonstick cooking spray, and dust lightly with flour. Tap out to remove any excess flour.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pour batter into Bundt cake pan, place in oven, and bake for 50 minutes, or until toothpick comes out clean.\n",
      "secondary_message": null
    },
    {
      "primary_message": "TO MAKE BROWN SUGAR GLAZE: In a small saucepan on medium-high heat, add brown sugar, butter, and apple cider. Bring to a boil and reduce until thick and syrupy.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Pour glaze over inverted bundt cake covering surface and letting it soak in.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Slice and serve warm.\n",
      "secondary_message": null
    }
  ],
