  "instructions": [
    {
      "id": 461098,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 461099,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with oil, and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "4 crowns broccoli\n4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 461100,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is golden brown and tender, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 461101,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 461102,
      "primary_message": "Once the skillet is hot, add oil, and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n½ cup panko bread crumbs\n⅛ tsp salt"
    },
    {
      "id": 461103,
      "primary_message": "Wipe the skillet clean with paper towels. Return to medium-high heat, add more oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 pork sausages"
    },
    {
      "id": 461104,
      "primary_message": "Meanwhile, finely grate Parmesan. Transfer to another small bowl.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 461105,
      "primary_message": "Peel and mince garlic. Mince anchovy fillets. Add both to the bowl with the Parmesan.",
      "secondary_message": "2 cloves garlic\n2 anchovy fillets, packed in oil"
    },
    {
      "id": 461106,
      "primary_message": "Wash, dry, and juice lemon into the bowl. Add mayo, oil, pepper, and salt; whisk to combine the dressing. ",
      "secondary_message": "1 lemon\n2 tbsp mayonnaise\n2 tbsp extra virgin olive oil\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 461107,
      "primary_message": "To serve, divide sausages and broccoli between plates. Drizzle broccoli with dressing and top with crispy bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
