  "instructions": [
    {
      "id": 461138,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 461139,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Divide between two large baking sheet pans, drizzle with oil, and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "6 crowns broccoli\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 461140,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is golden brown and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 461141,
      "primary_message": "When the broccoli has about 10 minutes left, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 461142,
      "primary_message": "Once the skillet is hot, add oil, and swirl to coat the bottom. Add bread crumbs and salt; cook, stirring frequently, until golden and crispy, 3-5 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ cup panko bread crumbs\n3 pinch salt"
    },
    {
      "id": 461143,
      "primary_message": "Wipe the skillet clean with paper towels. Return to medium-high heat, add more oil, and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 461144,
      "primary_message": "Meanwhile, finely grate Parmesan. Transfer to another small bowl.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 461145,
      "primary_message": "Peel and mince garlic. Mince capers. Add both to the bowl with the Parmesan.",
      "secondary_message": "3 cloves garlic\n1 ½ tbsp capers"
    },
    {
      "id": 461146,
      "primary_message": "Wash, dry, and juice lemons into the bowl. Add mayo, oil, pepper, and salt; whisk to combine the dressing. ",
      "secondary_message": "1 ½ lemons\n3 tbsp mayonnaise\n3 tbsp extra virgin olive oil\n¾ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 461147,
      "primary_message": "To serve, divide sausages and broccoli between plates. Drizzle broccoli with dressing and top with crispy bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
