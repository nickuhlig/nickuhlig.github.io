  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 205°C (400°F). Place bell peppers, poblanos, onion, and zucchini on a baking sheet. Toss with olive oil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, whisk together ancho chili powder, chipotle chili powder, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Sprinkle chili powder mix over vegetables and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Roast vegetables until soft and charred in spots, about 35 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer vegetables to a large bowl. Toss with sherry vinegar, cilantro, and Cojita cheese. Serve warm.",
      "secondary_message": null
    }
  ],
