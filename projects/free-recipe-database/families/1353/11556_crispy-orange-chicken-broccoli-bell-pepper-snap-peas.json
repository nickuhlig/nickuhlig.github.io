  "instructions": [
    {
      "id": 195353,
      "primary_message": "Cut chicken into bite-sized pieces and season with salt and pepper.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 195354,
      "primary_message": "Whisk eggs in a large bowl.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 195355,
      "primary_message": "Combine cornstarch and flour in a second large bowl.",
      "secondary_message": "½ cup cornstarch\n½ cup all-purpose flour"
    },
    {
      "id": 195356,
      "primary_message": "Toss chicken in the egg to coat. Working in batches, transfer chicken to the flour mixture, turn to coat, and shake off any excess. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 195357,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 195358,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the pot and cook, turning once, until chicken is golden brown and cooked through, 3-4 minutes. Transfer to a paper-towel lined plate. Wipe out the pot and set aside for later use.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 195359,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 oranges\n3 crowns broccoli\n3 red bell peppers\n1 ½ (8 oz) pkg sugar snap peas"
    },
    {
      "id": 195360,
      "primary_message": "Peel and mince garlic and ginger; place both in a second large pot.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 195361,
      "primary_message": "Zest and juice oranges into the pot; add vinegar, soy sauce, sugar, cornstarch, and crushed red pepper. Whisk to combine and place over medium heat; cook, whisking occasionally, until the sauce has thickened, 4-5 minutes. Remove from heat and set aside.",
      "secondary_message": "⅓ cup rice vinegar\n3 tbsp soy sauce\n3 tbsp brown sugar\n1 tbsp cornstarch\n¾ tsp crushed red pepper"
    },
    {
      "id": 195362,
      "primary_message": "Meanwhile, cut broccoli into bite-size florets. Seed and medium dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 195363,
      "primary_message": "Return the pot used for cooking the chicken to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 195364,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add broccoli, bell peppers, and snap peas to the pot; cook, stirring occasionally, until tender-crisp, 8-10 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 195365,
      "primary_message": "Add cooked chicken to the pot with the sauce and heat over medium until warmed through, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 195366,
      "primary_message": "To serve, divide chicken and vegetables between plates and enjoy!",
      "secondary_message": null
    }
  ],
