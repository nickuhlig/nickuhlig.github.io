  "instructions": [
    {
      "id": 195339,
      "primary_message": "Cut chicken into bite-sized pieces and season with salt and pepper.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 195340,
      "primary_message": "Whisk eggs in a medium bowl.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 195341,
      "primary_message": "Combine cornstarch and flour in a second medium bowl.",
      "secondary_message": "⅓ cup cornstarch\n⅓ cup all-purpose flour"
    },
    {
      "id": 195342,
      "primary_message": "Toss chicken in the egg to coat. Working in batches, transfer chicken to the flour mixture, turn to coat, and shake off any excess. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 195343,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 195344,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the skillet and cook, turning once, until chicken is golden brown and cooked through, 3-4 minutes. Transfer to a paper-towel lined plate. Wipe out the skillet and set aside for later use.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 195345,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 oranges\n2 crowns broccoli\n2 red bell peppers\n1 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 195346,
      "primary_message": "Peel and mince garlic and ginger; place both in a large pot.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 195347,
      "primary_message": "Zest and juice oranges into the pot; add vinegar, soy sauce, sugar, cornstarch, and crushed red pepper. Whisk to combine and place over medium heat; cook, whisking occasionally, until the sauce has thickened, 3-4 minutes. Remove from heat and set aside.",
      "secondary_message": "¼ cup rice vinegar\n2 tbsp soy sauce\n2 tbsp brown sugar\n2 tsp cornstarch\n½ tsp crushed red pepper"
    },
    {
      "id": 195348,
      "primary_message": "Meanwhile, cut broccoli into bite-size florets. Seed and medium dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 195349,
      "primary_message": "Return the skillet to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 195350,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli, bell peppers, and snap peas to the skillet; cook, stirring occasionally, until tender-crisp, 7-8 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 195351,
      "primary_message": "Add cooked chicken to the pot with the sauce and heat over medium until warmed through, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 195352,
      "primary_message": "To serve, divide chicken and vegetables between plates and enjoy!",
      "secondary_message": null
    }
  ],
