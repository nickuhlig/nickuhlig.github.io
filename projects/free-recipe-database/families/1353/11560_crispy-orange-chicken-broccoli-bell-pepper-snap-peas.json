  "instructions": [
    {
      "id": 195409,
      "primary_message": "Cut chicken into bite-sized pieces and season with salt and pepper.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 195410,
      "primary_message": "Whisk egg in a medium bowl.",
      "secondary_message": "1 egg"
    },
    {
      "id": 195411,
      "primary_message": "Combine cornstarch and flour in a second medium bowl.",
      "secondary_message": "3 tbsp cornstarch\n3 tbsp all-purpose flour"
    },
    {
      "id": 195412,
      "primary_message": "Toss chicken in the egg to coat. Working in batches, transfer chicken to the flour mixture, turn to coat, and shake off any excess. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 195413,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 195414,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet and cook, turning once, until chicken is golden brown and cooked through, 3-4 minutes. Transfer to a paper-towel lined plate. Wipe out the skillet and set aside for later use.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 195415,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 orange\n1 crown broccoli\n1 red bell pepper\n½ (227 g) pkg sugar snap peas"
    },
    {
      "id": 195416,
      "primary_message": "Peel and mince garlic and ginger; place both in a medium saucepan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 195417,
      "primary_message": "Zest and juice orange into the pan; add vinegar, soy sauce, sugar, cornstarch, and crushed red pepper. Whisk to combine and place over medium heat; cook, whisking occasionally, until the sauce has thickened, 3-4 minutes. Remove from heat and set aside.",
      "secondary_message": "2 tbsp rice vinegar\n1 tbsp soy sauce\n1 tbsp brown sugar\n1 tsp cornstarch\n¼ tsp crushed red pepper"
    },
    {
      "id": 195418,
      "primary_message": "Meanwhile, cut broccoli into bite-size florets. Seed and medium dice bell pepper.",
      "secondary_message": null
    },
    {
      "id": 195419,
      "primary_message": "Return the skillet to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 195420,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli, bell pepper, and snap peas to the skillet; cook, stirring occasionally, until tender-crisp, 6-7 minutes.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 195421,
      "primary_message": "Add cooked chicken to the pan with the sauce and heat over medium until warmed through, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 195422,
      "primary_message": "To serve, divide chicken and vegetables between plates and enjoy!",
      "secondary_message": null
    }
  ],
