  "instructions": [
    {
      "id": 380988,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 380989,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lb cremini mushrooms\n1 ½ lemons\n1 small pkg fresh basil\n3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 380990,
      "primary_message": "Quarter mushrooms and transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 380991,
      "primary_message": "Peel and mince garlic; add to the baking sheet with the mushrooms. Drizzle with oil and vinegar, then season with salt and pepper. Stir to combine and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 380992,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring once, until mushrooms are browned and tender, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 380993,
      "primary_message": "Meanwhile, zest and juice lemons into a large bowl. Add additional oil, Dijon, salt, and pepper. Whisk to combine the dressing and set aside. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 380994,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 380995,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 380996,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add steak and grill until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 380997,
      "primary_message": "Meanwhile, peel, halve, and slice shallots crosswise into thin half-moons. Roughly chop sun-dried tomatoes. Place both in a small bowl.",
      "secondary_message": "2 shallots\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 380998,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the shallot and sun-dried tomato.",
      "secondary_message": null
    },
    {
      "id": 380999,
      "primary_message": "Finely grate Parmesan. Add to the bowl and stir to combine.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 381000,
      "primary_message": "Once the mushrooms are tender, remove from oven and top with the Parmesan mixture. Return to the oven and continue to roast until Parmesan has melted, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 381001,
      "primary_message": "Meanwhile, thinly slice steak.",
      "secondary_message": null
    },
    {
      "id": 381002,
      "primary_message": "Once the Parmesan has melted, remove mushrooms from oven. Add to the bowl with the dressing, along with the arugula, and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 381003,
      "primary_message": "To serve, divide salad between plates or bowls and top with steak. Enjoy!",
      "secondary_message": null
    }
  ],
