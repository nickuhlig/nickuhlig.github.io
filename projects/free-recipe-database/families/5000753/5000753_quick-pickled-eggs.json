  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Hard-boil and peel the eggs. Peel the garlic.",
      "secondary_message": "8 large eggs\n3 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "In a 1-quart heat-safe glass jar with a lid, combine hard-boiled eggs with dill and garlic.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium saucepan, stir together vinegar, water, sugar, bay leaves, peppercorns, and salt. Cook over medium-high heat, stirring occasionally, until sugar dissolves, 5 minutes. Reduce heat to low and simmer until liquid reduces and darkens slightly, 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Carefully pour hot brine, along with bay leaves and peppercorns, over eggs, garlic, and dill. Cool to room temperature, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cover with a lid and refrigerate until eggs taste and smell vinegary and become beige, for at least 3 days and up to 2 weeks. Refrigerate until ready to serve.",
      "secondary_message": null
    }
  ],
