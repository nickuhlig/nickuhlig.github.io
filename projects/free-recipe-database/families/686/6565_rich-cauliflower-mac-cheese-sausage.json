  "instructions": [
    {
      "id": 330441,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces. Transfer to a large pot. ",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 330442,
      "primary_message": "Add hot water (from the tap) to the pot, so that the cauliflower is just covered. Bring to a boil over high heat. Cook until fork-tender, 4-5 minutes. Drain in a colander; set aside to drain further. (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 330443,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 330444,
      "primary_message": "Roughly chop the sausage. ",
      "secondary_message": "3 pork sausages"
    },
    {
      "id": 330445,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add the sausage. Cook, stirring often, until browned and cooked through, 5-6 minutes. Once done, transfer to a plate and reduce heat to low. ",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 330446,
      "primary_message": "Meanwhile, using a clean cutting board, wash, dry, and chop chives into small pieces; set aside. ",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 330447,
      "primary_message": "Coarsely grate cheddar. Finely grate Parmesan.",
      "secondary_message": "¾ (8 oz) block cheddar cheese\n6 oz Parmesan cheese"
    },
    {
      "id": 330448,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 330449,
      "primary_message": "Melt more butter in skillet. Add garlic and stir until fragrant, about 2 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 330450,
      "primary_message": "Stir in cream, Dijon, paprika, and pepper.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n1 ½ tsp Dijon mustard\n½ tsp paprika\n¼ tsp black pepper"
    },
    {
      "id": 330451,
      "primary_message": "When the cream is warmed, add cheddar and Parmesan. Cook, stirring well, until the cheese is melted and the mixture is smooth. ",
      "secondary_message": null
    },
    {
      "id": 330452,
      "primary_message": "Return drained cauliflower to the pot, add the cheese sauce, and stir until well coated.",
      "secondary_message": null
    },
    {
      "id": 330453,
      "primary_message": "Divide cheesy cauliflower between plates or bowls; sprinkle with sausage and chives. Enjoy!",
      "secondary_message": null
    }
  ],
