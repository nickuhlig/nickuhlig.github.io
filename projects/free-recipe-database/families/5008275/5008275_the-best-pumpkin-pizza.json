  "instructions": [
    {
      "id": 1,
      "primary_message": "Place each ball of pizza dough in a lightly oiled bowl and cover tightly with plastic wrap. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Adjust oven rack to center position and preheat oven to 325°F. Toss 3 pumpkin quarters with 1 tablespoon olive oil and coat thoroughly with hands. Season with salt and pepper. Place in a cast iron skillet or on a foil-lined rimmed baking sheet and roast until a knife meets no resistance when poked into the flesh around the stem, about 45 minutes. Remove from oven and set aside until cool enough to handle.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Scrape pumpkin flesh out into a large bowl. Add honey, cinnamon, nutmeg, and 2 tablespoons olive oil. Mash with a whisk until a rough purée is formed. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While pumpkins are roasting, cut remaining pumpkin quarter into 1/2-inch dice. Melt butter in a large skillet over high heat, swirling until foaming subsides. Add diced pumpkin and apple and cook, tossing and stirring frequently until tender and browned on most sides, about 10 minutes. Season to taste with salt and pepper; stir in minced sage. Transfer to a bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "When toppings are ready, adjust oven rack to top position under broiler and place a baking steel or pizza stone on top. Preheat oven to maximum heat setting. Allow to preheat for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Transfer one ball of pizza dough to a bowl of flour and turn to coat. Transfer to a lightly floured wooden pizza peel and stretch or roll into a thin circle. Top with half of shredded Gruyère cheese, half of the mozzarella applied in dollops, and a light sprinkling of Parmesan. Add mashed pumpkin in rough dollops around the cheese. Add half of sautéed pumpkin and apple. Sprinkle with torn sage leaves and half the scallion whites. Drizzle with 1 tablespoon olive oil and season with salt. Turn broiler on to high and launch pizza onto baking steel. Bake, rotating occasionally, until puffy and charred around the edges, about 4 minutes. Remove from oven, sprinkle with half the pale-green scallions, and serve. Repeat with remaining dough and toppings.",
      "secondary_message": null
    }
  ],
