  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the Yukon Gold potatoes into 1/2-inch discs. Slice the garlic thin.",
      "secondary_message": "4 large Yukon Gold potatoes\n8 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Add fat to heavy-bottomed 12-inch non-stick skillet and heat over medium-high heat until shimmering. Add potatoes and cook, stirring occasionally until lightly browned, about 6 minutes. Add garlic and continue to cook stirring occasionally, until potatoes are deep golden brown.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce heat to medium low. Add 3/4 cup water and salt to potatoes. Cover and cook until potatoes are tender, adding additional water if water evaporates before potatoes are cooked through. Cook until liquid is evaporated. Add parsley, season to taste with additional salt and black pepper, stir gently to combine, and serve immediately.",
      "secondary_message": null
    }
  ],
