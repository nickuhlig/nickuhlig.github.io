  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.\n\n",
      "secondary_message": "1 medium head cauliflower\n1 ½ lb Brussels sprouts"
    },
    {
      "primary_message": "Separate cauliflower head into bite-sized florets and cut stems into smaller pieces. Place in a large bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and halve Brussels sprouts. Add to the bowl with the cauliflower.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and medium dice sweet potatoes. Add to the bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and medium dice carrots. Add to the bowl, along with oil and spices, then stir to combine. Divide between two large baking sheet pans. (If needed, work in batches to best fit the size and number of baking sheets on hand.)\n\n",
      "secondary_message": "½ cup extra virgin olive oil\n2 tsp salt\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n1 tsp black pepper"
    },
    {
      "primary_message": "Working in batches if necessary, place baking sheets in the oven and roast, stirring veggies and rotating pans halfway through, until fork-tender, 25-30 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "STORING: When the veggies are done, let cool to room temperature, about 20 minutes. Divide veggies between resealable containers or plastic bags, pressing out as much air as possible. Place in the freezer and store for up to 2 months. HEATING: For best results, bake veggies from frozen in a preheated 425°F oven until warmed through, 12-15 minutes. If baking from thawed, reduce baking time to 10-12 minutes.",
      "secondary_message": null
    }
  ],
