  "instructions": [
    {
      "id": 1,
      "primary_message": "Fill a large pot or wok with 3 to 5 cm of water and place a steamer insert inside. Alternatively, adjust oven rack to center position and preheat oven to 175°C (350°F). Arrange fish steaks in a glass baking dish that just fits them. Combine chili sauce, oyster sauce, chilies, and shallots in a small bowl. Pour sauce over steaks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cover dish tightly with foil. Place in steamer or oven and cook until fish is barely cooked through, 15 to 20 minutes. Sprinkle with cilantro leaves and serve with steamed jasmine rice",
      "secondary_message": null
    }
  ],
