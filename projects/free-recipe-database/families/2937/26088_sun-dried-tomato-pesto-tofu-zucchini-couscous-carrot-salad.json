  "instructions": [
    {
      "id": 415153,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 415154,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 415155,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n6 medium zucchini squash\n1 ½ English cucumbers"
    },
    {
      "id": 415156,
      "primary_message": "Juice lemons into a large bowl. Add pesto, water, salt, and pepper, then stir to combine. Set aside. ",
      "secondary_message": "1 ½ cup sun-dried tomato pesto\n⅓ cup water\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 415157,
      "primary_message": "Medium dice tofu. Divide between two large baking sheets and season with salt. (Reuse the baking sheet from pressing the tofu to reduce dirty dishes.)",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 415158,
      "primary_message": "Trim and large dice zucchini. Add to the baking sheets with the tofu and drizzle with half of the pesto mixture; toss to combine and spread out in an even layer. (Reserve bowl with remaining pesto mixture for the salad.)",
      "secondary_message": null
    },
    {
      "id": 415159,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until tofu is golden and zucchini is tender, 18-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 415160,
      "primary_message": "While the tofu and zucchini are baking, in a medium saucepan, bring water and salt to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "3 cup water\n¾ tsp salt\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 415161,
      "primary_message": "Meanwhile, trim and medium dice cucumbers. Add to the bowl with the pesto mixture. ",
      "secondary_message": null
    },
    {
      "id": 415162,
      "primary_message": "Drain and roughly chop roasted peppers. Add to the bowl, along with the carrots, and stir to combine the salad.",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 415163,
      "primary_message": "To serve, divide couscous, tofu, zucchini, and carrot salad between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
