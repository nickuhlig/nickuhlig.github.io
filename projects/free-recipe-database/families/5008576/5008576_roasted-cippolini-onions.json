  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat the oil in a wide, deep, heavy bottomed, ovenproof pan over medium heat. Add the onions and cook, stirring, just until they begin to turn golden all over, about 5 minutes. Pour in the balsamic vinegar, season the onions with the salt and pepper and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer the pan to the oven and bake the onions, stirring them periodically to prevent scorching and ensure even cooking, until the vinegar is reduced to a syrupy glaze and the onions are meltingly soft, about 5 minutes. Serve the onions hot.",
      "secondary_message": null
    }
  ],
