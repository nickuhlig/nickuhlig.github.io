  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine the water, yeast, and rye flour in the bowl of your stand mixer and stir to combine. Let it sit for 10 minutes. It should be a bit bubbly.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add 2 cups of bread flour, salt, and cider vinegar. Knead with the stand mixer fitted with the dough hook until the dough is elastic - it won't be smooth because of the rye flour. Add the olive oil and continue kneading until the oil is incorporated.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Turn off the mixer and touch the dough - it should be tacky rather than sticky. If the dough is still sticky add more bread flour - perhaps up to another 1/4 cup - as needed. Add the caraway seeds and knead until they are well distributed. Cover the bowl with plastic wrap and set aside until the dough has doubled in size - about 50 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Preheat the oven to 350 degrees and line a baking pan with parchment paper. Flour your work surface, turn out the dough, and divide it into 3 roughly equal pieces. Form each piece into a log about 5 cm in diameter. Place them on the prepared baking sheet, leaving space between them for them to rise.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cover the dough with plastic wrap and set aside to rise until doubled, about 30 minutes. Remove the plastic wrap and bake at 350 degrees until nicely browned, about 25 minutes. Let the loaves cool completely on a rack before cutting.",
      "secondary_message": null
    }
  ],
