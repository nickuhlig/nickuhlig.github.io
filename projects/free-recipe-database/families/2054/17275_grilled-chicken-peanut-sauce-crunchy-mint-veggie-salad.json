  "instructions": [
    {
      "id": 280647,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 ½ pints grape tomatoes\n3 orange bell peppers\n1 ½ English cucumbers\n1 ½ avocados\n1 small pkg fresh mint"
    },
    {
      "id": 280648,
      "primary_message": "Juice limes into a small bowl; add peanut butter, soy sauce, honey, water, and spices. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "⅓ cup natural peanut butter\n2 tbsp soy sauce\n1 ½ tbsp honey\n2 tbsp water\n½ tsp turmeric, ground\n3 pinch curry powder\n3 pinch coriander, ground"
    },
    {
      "id": 280649,
      "primary_message": "Peel and mince garlic; place in a large bowl along with soy sauce, oil, and crushed red pepper. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n2 tbsp soy sauce\n1 ½ tbsp extra virgin olive oil\n½ tsp crushed red pepper"
    },
    {
      "id": 280650,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Add to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 280651,
      "primary_message": "Place oil, mayo, vinegar, salt, and pepper in another large bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp mayonnaise\n1 tbsp rice vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 280652,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 280653,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add chicken and cook until charred and cooked through, 3-4 minutes per side. Remove to a large plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 280654,
      "primary_message": "While the chicken is cooking, using a clean cutting board, peel, halve, and thinly slice onion into half-moons; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 280655,
      "primary_message": "Quarter tomatoes. Trim, seed, and small dice bell peppers; add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 280656,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 280657,
      "primary_message": "Halve and pit avocados, then scoop out with a spoon and medium dice; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 280658,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 280659,
      "primary_message": "To serve, divide chicken and salad between plates; drizzle chicken with peanut sauce and enjoy!",
      "secondary_message": null
    }
  ],
