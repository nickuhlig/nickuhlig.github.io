  "instructions": [
    {
      "id": 157600,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 lb cremini mushrooms\n1 pint grape tomatoes\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 157601,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 157602,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 157603,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towel and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 157604,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add onion and garlic and cook, stirring regularly, until onion begins to soften, 2-3 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 157605,
      "primary_message": "Add chicken to the skillet; cook until golden brown, about 2 minutes per side. Once golden, transfer to a plate and loosely cover with aluminum foil (the chicken will not be cooked all the way through). ",
      "secondary_message": null
    },
    {
      "id": 157606,
      "primary_message": "Meanwhile, slice the mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 157607,
      "primary_message": "Add mushrooms to the skillet, and cook until golden brown, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 157608,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 157609,
      "primary_message": "Add tomatoes and spices to the skillet and stir to combine. Continue to cook until veggies begin to soften, 2-3 minutes.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp crushed red pepper\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 157610,
      "primary_message": "Pour in the cream and return the chicken to the skillet, along with any accumulated juices from the plate. Cover and simmer until chicken is cooked through, 8-10 minutes. ",
      "secondary_message": "8 fl oz (1 cup) heavy cream"
    },
    {
      "id": 157611,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 157612,
      "primary_message": "Add cheese to the skillet and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 157613,
      "primary_message": "To serve, divide chicken and veggies between plates, spooning skillet sauce on top. Enjoy! ",
      "secondary_message": null
    }
  ],
