  "instructions": [
    {
      "id": 157656,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg cremini mushrooms\n1 ½ small pkgs grape tomatoes\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 157657,
      "primary_message": "Peel and small dice onions. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 157658,
      "primary_message": "Preheat a large pot over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 157659,
      "primary_message": "While the pot heats up, pat the chicken dry with paper towel and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 157660,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add onion and garlic and cook, stirring regularly, until onion begins to soften, 3-4 minutes. ",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 157661,
      "primary_message": "Working in batches if necessary, add chicken to the pot; cook until golden brown, about 2 minutes per side. Once golden, transfer to a plate and loosely cover with aluminum foil (the chicken will not be cooked all the way through). ",
      "secondary_message": null
    },
    {
      "id": 157662,
      "primary_message": "Meanwhile, slice the mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 157663,
      "primary_message": "Add mushrooms to the pot, and cook until golden brown, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 157664,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 157665,
      "primary_message": "Add tomatoes and spices to the pot and stir to combine. Continue to cook until veggies begin to soften, 3-4 minutes.",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 157666,
      "primary_message": "Pour in the cream and return the chicken to the pot, along with any accumulated juices from the plate. Cover and simmer until chicken is cooked through, 8-10 minutes. ",
      "secondary_message": "355 ml heavy cream"
    },
    {
      "id": 157667,
      "primary_message": "Meanwhile, finely grate Parmesan. ",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 157668,
      "primary_message": "Add cheese to the pot and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 157669,
      "primary_message": "To serve, divide chicken and veggies between plates, spooning sauce on top. Enjoy! ",
      "secondary_message": null
    }
  ],
