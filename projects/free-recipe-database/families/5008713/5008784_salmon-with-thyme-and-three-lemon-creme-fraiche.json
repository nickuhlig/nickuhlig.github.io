  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the thyme leaves from the stems. Thinly slice the lemon. Juice the lemon.",
      "secondary_message": "2 tsp thyme leaves\n1/2 lemon\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Preheat the oven to 175°C (350°F). Line a rimmed baking sheet with aluminum foil. Place thyme sprigs and sliced lemon in a pile in the center of the baking sheet large enough to hold the salmon. Rub salmon on all sides with olive oil and season with salt and pepper. Place salmon on top of thyme/lemon bed and transfer to oven. Roast until the internal temperature registers 125 to 55°C (130°F) on an instant read thermometer for medium-rare or 60°C for medium, 15 to 25 minutes. Remove from oven and allow to rest at least 5 minutes, or allow to cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir together the thyme leaves, lemon juice, lemon zest, preserved lemon (if using), and crème fraîche. Season with salt and pepper. Serve the salmon either hot or at room temperature with the lemon sauce.",
      "secondary_message": null
    }
  ],
