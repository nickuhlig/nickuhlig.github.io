  "instructions": [
    {
      "id": 356499,
      "primary_message": "Preheat oven to 450°F and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 356500,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 pints grape tomatoes\n2 lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 356501,
      "primary_message": "Place tomatoes and whole (unpeeled) garlic cloves on a large baking sheet pan. Drizzle with oil, then sprinkle with sugar and spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "12 cloves garlic\n¼ cup extra virgin olive oil\n2 tsp brown sugar\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n1 tsp crushed red pepper\n1 tsp salt"
    },
    {
      "id": 356502,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring tomatoes halfway through, until they start to burst, 13-15 minutes. ",
      "secondary_message": null
    },
    {
      "id": 356503,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356504,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt"
    },
    {
      "id": 356505,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate and set aside to rest.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 356506,
      "primary_message": "Meanwhile, zest and juice lemons into a medium bowl; add yogurt and salt. Whisk to combine the lemony yogurt and set aside.",
      "secondary_message": "2 cups plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 356507,
      "primary_message": "Once the tomatoes have begun to burst, change the oven to broil on high. Broil until tomatoes are lightly charred, about 3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 356508,
      "primary_message": "When the tomatoes are done, carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins. Return garlic to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 356509,
      "primary_message": "Shave parsley leaves off the stems; discard stems and chop the leaves. Add half of the parsley to the baking sheet with the tomatoes and garlic; toss to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 356510,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 356511,
      "primary_message": "To serve, divide steak and lemony yogurt between plates. Top yogurt with roasted tomatoes, garlic, and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
