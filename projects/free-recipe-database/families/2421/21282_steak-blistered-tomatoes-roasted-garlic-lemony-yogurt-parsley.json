  "instructions": [
    {
      "id": 356551,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 356552,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 small pkgs grape tomatoes\n3 lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 356553,
      "primary_message": "Divide tomatoes and whole (unpeeled) garlic cloves between two baking sheet pans. Drizzle with oil, then sprinkle with sugar and spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "18 cloves garlic\n⅓ cup extra virgin olive oil\n1 tbsp brown sugar\n2 tsp cumin, ground\n2 tsp coriander, ground\n1 ½ tsp crushed red pepper\n1 ½ tsp salt"
    },
    {
      "id": 356554,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring tomatoes halfway through, until they start to burst, 15-18 minutes. ",
      "secondary_message": null
    },
    {
      "id": 356555,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356556,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt"
    },
    {
      "id": 356557,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate and set aside to rest.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 356558,
      "primary_message": "Meanwhile, zest and juice lemons into a medium bowl; add yogurt and salt. Whisk to combine the lemony yogurt and set aside.",
      "secondary_message": "3 cups plain Greek yogurt\n¾ tsp salt"
    },
    {
      "id": 356559,
      "primary_message": "Once the tomatoes have begun to burst, remove from oven, and change oven to broil on high. Working in batches, return baking sheets to the oven and broil until tomatoes are lightly charred, about 3 minutes. Remove from oven",
      "secondary_message": null
    },
    {
      "id": 356560,
      "primary_message": "When the tomatoes are done, carefully transfer roasted garlic to the cutting board. Using the back of a spoon, press on the cloves to remove the skins. Return garlic to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 356561,
      "primary_message": "Shave parsley leaves off the stems; discard stems and chop the leaves. Add half of the parsley to the baking sheets with the tomatoes and garlic; toss to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 356562,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 356563,
      "primary_message": "To serve, divide steak and lemony yogurt between plates. Top yogurt with roasted tomatoes, garlic, and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
