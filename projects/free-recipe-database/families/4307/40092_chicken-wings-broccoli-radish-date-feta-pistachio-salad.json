  "instructions": [
    {
      "id": 621714,
      "primary_message": "Preheat oven to 260°C (500°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 621715,
      "primary_message": "Pat chicken wings dry with paper towels and place in a medium bowl. Sprinkle with cornstarch and spices, then toss to coat. Transfer to the baking sheet, spread out in an even layer, and drizzle with additional oil.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed\n2 tsp cornstarch\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 621716,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 621717,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 crown broccoli\n½ lemon\n½ small pkg fresh mint\n½ bunch radish"
    },
    {
      "id": 621718,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 621719,
      "primary_message": "While the skillet heats up, separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 621720,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli and spices; cook, stirring occasionally, until broccoli is tender-crisp, 2-3 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 621721,
      "primary_message": "While the broccoli is cooking, roughly chop dates.",
      "secondary_message": "⅛ cup medjool dates, pitted"
    },
    {
      "id": 621722,
      "primary_message": "When the broccoli is done, add dates and sesame seeds to the skillet, then stir to combine. Continue to cook, stirring occasionally, until dates have softened, 1-2 minutes more. Remove from heat.",
      "secondary_message": "2 tsp sesame seeds"
    },
    {
      "id": 621723,
      "primary_message": "Meanwhile, zest and juice lemon into a clean medium bowl. Add oil and spices, then whisk to combine the dressing.",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 621724,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 621725,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 621726,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 621727,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with feta and cooked broccoli, then toss to combine the salad.",
      "secondary_message": "⅛ cup pistachios, unsalted\n½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 621728,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
