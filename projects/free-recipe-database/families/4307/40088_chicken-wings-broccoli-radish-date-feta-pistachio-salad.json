  "instructions": [
    {
      "id": 621657,
      "primary_message": "Preheat oven to 500°F. Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 621658,
      "primary_message": "Pat chicken wings dry with paper towels and place in a large bowl. Sprinkle with cornstarch and spices, then toss to coat. Divide between the baking sheets, spread out in an even layer, and drizzle with additional oil.",
      "secondary_message": "3 lb chicken wings, split with tips removed\n2 tbsp cornstarch\n1 ½ tsp garlic powder\n¾ tsp salt\n¼ tsp black pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 621659,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 621660,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 crowns broccoli\n1 ½ lemons\n1 small pkg fresh mint\n1 ½ bunches radish"
    },
    {
      "id": 621661,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. ",
      "secondary_message": null
    },
    {
      "id": 621662,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 621663,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add broccoli and spices; cook, stirring occasionally, until broccoli is tender-crisp, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 621664,
      "primary_message": "While the broccoli is cooking, roughly chop dates.",
      "secondary_message": "⅓ cup medjool dates, pitted"
    },
    {
      "id": 621665,
      "primary_message": "When the broccoli is done, add dates and sesame seeds to the skillet, then stir to combine. Continue to cook, stirring occasionally, until dates have softened, 2-3 minutes more. Remove from heat.",
      "secondary_message": "2 tbsp sesame seeds"
    },
    {
      "id": 621666,
      "primary_message": "Meanwhile, zest and juice lemons into a clean large bowl. Add oil and spices, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 621667,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 621668,
      "primary_message": "Trim and slice radishes crosswise into thin rounds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 621669,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 621670,
      "primary_message": "Roughly chop pistachios. Add to the bowl, along with feta and cooked broccoli, then toss to combine the salad.",
      "secondary_message": "⅓ cup pistachios, unsalted\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 621671,
      "primary_message": "To serve, divide wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
