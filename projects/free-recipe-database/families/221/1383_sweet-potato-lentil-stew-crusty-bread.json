  "instructions": [
    {
      "id": 11985,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 11986,
      "primary_message": "Peel and small dice onion. Peel and mince garlic and ginger.",
      "secondary_message": "½ medium yellow onion\r\n2 cloves garlic\r\n1 (1 inch) piece ginger"
    },
    {
      "id": 11987,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and, stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 11988,
      "primary_message": "Rinse lentils under cold water.",
      "secondary_message": "¾ cup brown lentils"
    },
    {
      "id": 11989,
      "primary_message": "Wash potatoes and tomato. Peel and large dice the potatoes. Medium dice the tomato.",
      "secondary_message": "¾ lb sweet potatoes\n1 tomato"
    },
    {
      "id": 11990,
      "primary_message": "Add garlic, ginger, cumin, turmeric, curry, coriander, and salt to saucepan. Stir for about 1 minute.",
      "secondary_message": "½ tsp cumin\r\n½ tsp turmeric\r\n½ tsp curry powder\r\n½ tsp coriander\r\n¼ tsp salt"
    },
    {
      "id": 11991,
      "primary_message": "Add potatoes, tomatoes, lentils, and broth. Bring to a simmer and cook until potatoes and lentils are tender, 15-20 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 11992,
      "primary_message": "Toast bread.",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 11993,
      "primary_message": "To serve, add stew to a bowl and have with bread on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
