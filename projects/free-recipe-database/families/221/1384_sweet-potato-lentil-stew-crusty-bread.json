  "instructions": [
    {
      "id": 11994,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 11995,
      "primary_message": "Peel and small dice onion. Peel and mince garlic and ginger.",
      "secondary_message": "1 medium yellow onion\r\n4 cloves garlic\r\n2 (2 ½ cm) pieces ginger"
    },
    {
      "id": 11996,
      "primary_message": "Coat bottom of pot with oil. Add onion and, stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "about 2 tbsp virgin coconut oil"
    },
    {
      "id": 11997,
      "primary_message": "Rinse lentils under cold water.",
      "secondary_message": "1 ½ cups brown lentils"
    },
    {
      "id": 11998,
      "primary_message": "Wash potatoes and tomatoes. Peel and large dice the potatoes. Medium dice the tomatoes.",
      "secondary_message": "0.68 kg sweet potatoes\n2 tomatoes"
    },
    {
      "id": 11999,
      "primary_message": "Add garlic, ginger, cumin, turmeric, curry, coriander, and salt to pot. Stir for about 1 minute.",
      "secondary_message": "1 tsp cumin\r\n1 tsp turmeric\r\n1 tsp curry powder\r\n1 tsp coriander\r\n½ tsp salt"
    },
    {
      "id": 12000,
      "primary_message": "Add potatoes, tomatoes, lentils, and broth. Bring to a simmer and cook until potatoes and lentils are tender, 15-20 minutes.",
      "secondary_message": "472 ml (2 cups) chicken or vegetable broth"
    },
    {
      "id": 12001,
      "primary_message": "Toast bread.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 12002,
      "primary_message": "To serve, add stew to a bowl and have with bread on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
