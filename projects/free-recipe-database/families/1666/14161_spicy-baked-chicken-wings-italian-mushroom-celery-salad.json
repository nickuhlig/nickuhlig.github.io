  "instructions": [
    {
      "id": 235241,
      "primary_message": "Preheat oven to 475°F.",
      "secondary_message": null
    },
    {
      "id": 235242,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n4 sticks celery\n½ lb cremini mushrooms\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg chives"
    },
    {
      "id": 235243,
      "primary_message": "Juice half the lemon into a medium bowl (reserve remaining lemon for the salad). Add oil and spices; whisk to combine the marinade.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper\n¼ tsp thyme, dried"
    },
    {
      "id": 235244,
      "primary_message": "Add chicken wings to the bowl with the marinade and toss to coat; transfer to a baking sheet pan and spread out in a single layer.",
      "secondary_message": "1 lb chicken wings, split with tips removed"
    },
    {
      "id": 235245,
      "primary_message": "Place wings in the oven and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235246,
      "primary_message": "Meanwhile, juice remaining lemon into another medium bowl. Add oil, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp white wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 235247,
      "primary_message": "Trim celery and cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 235248,
      "primary_message": "Thinly slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235249,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235250,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235251,
      "primary_message": "Use a vegetable peeler to shave Parmesan; add to the bowl and gently toss to combine the salad.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 235252,
      "primary_message": "To serve, divide chicken wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
