  "instructions": [
    {
      "id": 235328,
      "primary_message": "Preheat oven to 245°C (475°F).",
      "secondary_message": null
    },
    {
      "id": 235329,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n8 sticks celery\n0.45 kg cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg chives"
    },
    {
      "id": 235330,
      "primary_message": "Juice one lemon into a large bowl (reserve remaining lemon for the salad). Add oil and spices; whisk to combine the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp onion powder\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper\n½ tsp thyme, dried"
    },
    {
      "id": 235331,
      "primary_message": "Add chicken wings to the bowl with the marinade and toss to coat; transfer to a large baking sheet pan and spread out in a single layer.",
      "secondary_message": "0.91 kg chicken wings, split with tips removed"
    },
    {
      "id": 235332,
      "primary_message": "Place wings in the oven and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235333,
      "primary_message": "Meanwhile, juice remaining lemon into another large bowl. Add oil, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tsp white wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 235334,
      "primary_message": "Trim celery and cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 235335,
      "primary_message": "Thinly slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235336,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235337,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235338,
      "primary_message": "Use a vegetable peeler to shave Parmesan; add to the bowl and gently toss to combine the salad.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 235339,
      "primary_message": "To serve, divide chicken wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
