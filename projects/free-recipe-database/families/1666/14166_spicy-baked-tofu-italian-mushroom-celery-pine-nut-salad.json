  "instructions": [
    {
      "id": 235303,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 235304,
      "primary_message": "Drain and cut tofu into ½-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Divide tofu slices, arranging them in a single layer, between two baking sheet pans. Set aside.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 235305,
      "primary_message": "Place oil and spices in a large bowl; stir to combine the herb oil.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp onion powder\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper\n¾ tsp thyme, dried"
    },
    {
      "id": 235306,
      "primary_message": "Coat the top side of the tofu with half the herb oil; gently flip tofu slices and coat the other side with remaining oil. (Reserve bowl for the salad.",
      "secondary_message": null
    },
    {
      "id": 235307,
      "primary_message": "Place tofu in the oven and bake, flipping once, until golden brown around the edges, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235308,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n12 sticks celery\n1 ½ lb cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg chives"
    },
    {
      "id": 235309,
      "primary_message": "Juice lemons into the reserved bowl. Add oil, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp white wine vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 235310,
      "primary_message": "Trim celery and cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 235311,
      "primary_message": "Thinly slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235312,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235313,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235314,
      "primary_message": "Use a vegetable peeler to shave Parmesan; add to the bowl along with the pine nuts and gently toss to combine the salad.",
      "secondary_message": "4 oz Parmesan cheese\n⅓ cup pine nuts"
    },
    {
      "id": 235315,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
