  "instructions": [
    {
      "id": 235265,
      "primary_message": "Preheat oven to 475°F.",
      "secondary_message": null
    },
    {
      "id": 235266,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n12 sticks celery\n1 ½ lb cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg chives"
    },
    {
      "id": 235267,
      "primary_message": "Juice half the lemons into a large bowl (reserve remaining lemons for the salad). Add oil and spices; whisk to combine the marinade.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp onion powder\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper\n¾ tsp thyme, dried"
    },
    {
      "id": 235268,
      "primary_message": "Add chicken wings to the bowl with the marinade and toss to coat; divide between two baking sheet pans and spread out in a single layer.",
      "secondary_message": "3 lb chicken wings, split with tips removed"
    },
    {
      "id": 235269,
      "primary_message": "Place wings in the oven and bake, turning once, until cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235270,
      "primary_message": "Meanwhile, juice remaining lemons into another large bowl. Add oil, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp white wine vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 235271,
      "primary_message": "Trim celery and cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 235272,
      "primary_message": "Thinly slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235273,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235274,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235275,
      "primary_message": "Use a vegetable peeler to shave Parmesan; add to the bowl and gently toss to combine the salad.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 235276,
      "primary_message": "To serve, divide chicken wings and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
