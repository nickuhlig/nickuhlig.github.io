  "instructions": [
    {
      "id": 235365,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 235366,
      "primary_message": "Drain and cut tofu into ½-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Arrange tofu slices, in a single layer, on a large baking sheet pan. Set aside.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 235367,
      "primary_message": "Place oil and spices in a large bowl; stir to combine the herb oil.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp onion powder\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper\n½ tsp thyme, dried"
    },
    {
      "id": 235368,
      "primary_message": "Coat the top side of the tofu with half the herb oil; gently flip tofu slices and coat the other side with remaining oil. (Reserve bowl for the salad.)",
      "secondary_message": null
    },
    {
      "id": 235369,
      "primary_message": "Place tofu in the oven and bake, flipping once, until golden brown around the edges, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 235370,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n8 sticks celery\n0.45 kg cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg chives"
    },
    {
      "id": 235371,
      "primary_message": "Juice lemon into the reserved bowl. Add oil, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tsp white wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 235372,
      "primary_message": "Trim celery and cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 235373,
      "primary_message": "Thinly slice mushrooms and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235374,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235375,
      "primary_message": "Chop chives into small pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 235376,
      "primary_message": "Use a vegetable peeler to shave Parmesan; add to the bowl along with the pine nuts and gently toss to combine the salad.",
      "secondary_message": "85 g Parmesan cheese\n¼ cup pine nuts"
    },
    {
      "id": 235377,
      "primary_message": "To serve, divide tofu and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
