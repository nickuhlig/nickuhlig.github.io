  "instructions": [
    {
      "id": 15221,
      "primary_message": "Heat a medium saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 15222,
      "primary_message": "Peel and small dice onion. Peel and mince garlic. Wash, seed, and mince jalapeño.",
      "secondary_message": "½ medium red onion\r\n2 cloves garlic\r\n1 jalapeño pepper"
    },
    {
      "id": 15223,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and jalapeño. Stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 15224,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "1 (15 oz) can kidney beans"
    },
    {
      "id": 15225,
      "primary_message": "Add garlic, chili powder, and cumin to saucepan. Stir and cook for 30 seconds.",
      "secondary_message": "1 tbsp chili powder\r\n1 tsp cumin"
    },
    {
      "id": 15226,
      "primary_message": "Add beef and, breaking apart with a spoon, cook until crumbly and browned, 2-3 minutes.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 15227,
      "primary_message": "Add beans, tomatoes, salt, and pepper. Bring to a boil. Reduce heat to a simmer and cook until chili thickens, about 10 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 15228,
      "primary_message": "Scoop out the avocado flesh and medium dice.",
      "secondary_message": "½ avocado"
    },
    {
      "id": 15229,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "1 whole grain bun or roll"
    },
    {
      "id": 15230,
      "primary_message": "To serve, place chili in a bowl and garnish with avocado. Enjoy with bread!",
      "secondary_message": ""
    }
  ],
