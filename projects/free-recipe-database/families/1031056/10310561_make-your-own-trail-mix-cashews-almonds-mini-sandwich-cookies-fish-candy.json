  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun! ",
      "secondary_message": null
    },
    {
      "primary_message": "Place cookies, almonds, cashews, cranberries, chocolate chips, and fish candy each in their own small bowl.\n\n",
      "secondary_message": "1 cup mini sandwich cookies\n½ cup almonds\n½ cup cashews, roasted unsalted\n½ cup dried cranberries\n½ cup white chocolate chips"
    },
    {
      "primary_message": "Give each chef a resealable plastic bag and allow them to create their own \"trail mix\" out of the offered ingredients. Seal and shake to combine.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Show off your creations, take it outside, explore, and enjoy!",
      "secondary_message": null
    }
