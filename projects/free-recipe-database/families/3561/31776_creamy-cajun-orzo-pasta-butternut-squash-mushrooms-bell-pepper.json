  "instructions": [
    {
      "id": 501818,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 501819,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ small butternut squash\n0.68 kg cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 501820,
      "primary_message": "Trim, seed, and small dice bell peppers. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 501821,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds, and small dice. Add to the baking sheets with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 501822,
      "primary_message": "Quarter mushrooms and add to the baking sheets. Drizzle veggies with oil, then sprinkle with Cajun seasoning and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp Cajun seasoning\n¾ tsp salt"
    },
    {
      "id": 501823,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies soften, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 501824,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 501825,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 501826,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 501827,
      "primary_message": "Add broth, orzo, and spices to the pot with the onion; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, 10-12 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n425 g orzo pasta\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 501828,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Set aside a small handful for serving.",
      "secondary_message": null
    },
    {
      "id": 501829,
      "primary_message": "Add roasted veggies, remaining parsley, and cream to the pot. Continue to cook, stirring frequently, until thickened, 3-4 minutes more. Remove from heat.",
      "secondary_message": "355 ml heavy whipping cream"
    },
    {
      "id": 501830,
      "primary_message": "To serve, divide orzo between plates or bowls. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
