  "instructions": [
    {
      "id": 501805,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 501806,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 small butternut squash\n0.45 kg cremini mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 501807,
      "primary_message": "Trim, seed, and small dice bell peppers. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 501808,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and small dice. Add to the baking sheet with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 501809,
      "primary_message": "Quarter mushrooms and add to the baking sheet. Drizzle veggies with oil, then sprinkle with Cajun seasoning and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp Cajun seasoning\n½ tsp salt"
    },
    {
      "id": 501810,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies soften, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 501811,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 501812,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 501813,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 501814,
      "primary_message": "Add broth, orzo, and spices to the skillet with the onion; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low and cook, stirring occasionally, until liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n283 g orzo pasta\n1 tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 501815,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Set aside a small handful for serving.",
      "secondary_message": null
    },
    {
      "id": 501816,
      "primary_message": "Add roasted veggies, remaining parsley, and cream to the skillet. Continue to cook, stirring frequently, until thickened, 2-3 minutes more. Remove from heat.",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 501817,
      "primary_message": "To serve, divide orzo between plates or bowls. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
