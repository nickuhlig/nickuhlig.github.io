  "instructions": [
    {
      "primary_message": "Preheat oven to 500°F and position rack in the centre.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. In a medium bowl, mix together the minced garlic, olive oil, sage, salt, and pepper.",
      "secondary_message": "6 cloves garlic\nextra virgin olive oil\nsalt\nblack pepper"
    },
    {
      "primary_message": "Wash and thinly slice lemons.",
      "secondary_message": null
    },
    {
      "primary_message": "Add chicken and lemon slices to bowl; toss to coat. Set aside.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "primary_message": "Heat a saucepan over medium heat. Add oil, maple syrup, chill powder, salt, and pepper. Simmer for 2-3 minutes while you prepare the squash.",
      "secondary_message": "3 tbsp virgin coconut oil\n3 tbsp pure maple syrup\n⅜ tsp chili powder\nsalt\nblack pepper"
    },
    {
      "primary_message": "Wash and halve squash lengthwise. Scoop out the seeds and cut crosswise into ¼ inch thick slices.",
      "secondary_message": "3 acorn squash"
    },
    {
      "primary_message": "Lightly coat a baking sheet with olive oil.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Add squash slices to baking sheet and pour the maple mixture over top. Toss to coat and arrange slices in a single layer.",
      "secondary_message": null
    },
    {
      "primary_message": "Place chicken and lemon slices on top of squash. Place in the oven and roast until squash is tender and chicken is cooked though, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Serve chicken thighs with squash on the side. Enjoy!",
      "secondary_message": null
    }
