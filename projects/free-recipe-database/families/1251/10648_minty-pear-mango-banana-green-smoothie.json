  "instructions": [
    {
      "id": 170796,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed). ",
      "secondary_message": "½ English cucumber\n1 pear\n½ lime\n½ small pkg fresh mint\n1 banana\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 170797,
      "primary_message": "Roughly chop cucumber; transfer to a blender along with cold water and maple syrup. Blend until smooth.",
      "secondary_message": "½ cup water\n1 tbsp pure maple syrup"
    },
    {
      "id": 170798,
      "primary_message": "Core and roughly chop the pear; add to the blender. ",
      "secondary_message": null
    },
    {
      "id": 170799,
      "primary_message": "Juice lime into the blender. ",
      "secondary_message": null
    },
    {
      "id": 170800,
      "primary_message": "Pick mint leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 170801,
      "primary_message": "Peel the banana, break into chunks and add to the blender along with the spinach.",
      "secondary_message": null
    },
    {
      "id": 170802,
      "primary_message": "Add 4 ice cubes, edamame, and mango to the blender. Blend on high speed for several minutes until smooth. ",
      "secondary_message": "¾ cup edamame\n½ cup frozen mangoes"
    },
    {
      "id": 170803,
      "primary_message": "Pour the smoothie into glasses and enjoy! ",
      "secondary_message": null
    }
  ],
