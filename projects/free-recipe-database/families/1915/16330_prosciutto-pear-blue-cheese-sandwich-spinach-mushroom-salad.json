  "instructions": [
    {
      "id": 267219,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 267220,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "⅓ kg white mushrooms\n3 pears\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 267221,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 267222,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 267223,
      "primary_message": "Divide bread slices between two baking sheet pans. Working in batches, place each baking sheet in the oven and broil until toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 267224,
      "primary_message": "Meanwhile, peel and thinly slice onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 267225,
      "primary_message": "Quarter, core, and thinly slice pears.",
      "secondary_message": null
    },
    {
      "id": 267226,
      "primary_message": "Spread mayo and Dijon over half of the toasted bread slices. Layer a small handful of spinach, onion, pear, prosciutto, and blue cheese over top (reserving remaining spinach for the salad). Close with remaining toast slices.",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp Dijon mustard\n24 slices prosciutto\n1 ½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 267227,
      "primary_message": "Add remaining spinach to the bowl with the dressing and mushrooms; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 267228,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
