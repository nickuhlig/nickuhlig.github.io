  "instructions": [
    {
      "id": 267139,
      "primary_message": "Preheat oven to broil on high and position rack about 6-inches from the top.",
      "secondary_message": null
    },
    {
      "id": 267140,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "¼ lb white mushrooms\n1 pear\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 267141,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp balsamic vinegar\n½ tsp Dijon mustard\n½ tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 267142,
      "primary_message": "Thinly slice mushrooms and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 267143,
      "primary_message": "Arrange bread slices on a baking sheet pan, place in the oven, and broil until toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 267144,
      "primary_message": "Meanwhile, peel and thinly slice shallot.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 267145,
      "primary_message": "Quarter, core, and thinly slice pear.",
      "secondary_message": null
    },
    {
      "id": 267146,
      "primary_message": "Spread mayo and Dijon over half of the toasted bread slices. Layer a small handful of spinach, shallot, pear, prosciutto, and blue cheese over top (reserving remaining spinach for the salad). Close with remaining toast slices.",
      "secondary_message": "1 ½ tbsp mayonnaise\n1 tsp Dijon mustard\n8 slices prosciutto\n½ (4 oz) pkg crumbled blue cheese"
    },
    {
      "id": 267147,
      "primary_message": "Add remaining spinach to the bowl with the dressing and mushrooms; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 267148,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
