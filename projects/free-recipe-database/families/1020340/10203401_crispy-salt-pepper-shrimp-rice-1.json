  "instructions": [
    {
      "primary_message": "Thaw shrimp per package instructions.",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, blend salt and pepper.  Set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Place shrimp and cornstarch in a bowl, toss to coat.",
      "secondary_message": null
    },
    {
      "primary_message": "In a large frypan, add enough oil to reach about ½” deep (you may not need all the oil). ",
      "secondary_message": null
    },
    {
      "primary_message": "Heat oil over medium high heat until it reaches 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Shake off excess cornstarch from shrimp and shallow fry in a single layer in small batches, 2 - 3 minutes per side.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer cooked shrimp to a clean bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once all of the shrimp has been cooked, carefully pour the oil, except for 2 tablespoons, into a heat proof container for reuse or to discard.",
      "secondary_message": null
    },
    {
      "primary_message": "In the same frypan with the reserved oil, cook garlic, jalapeño, and green onions over medium high heat.  Stir-fry for 1 minute, do not burn garlic.",
      "secondary_message": null
    },
    {
      "primary_message": "Add cooked shrimp, sprinkle with salt and pepper mixture, and stir.",
      "secondary_message": null
    },
    {
      "primary_message": "Serve with rice, cooked according to package instructions.",
      "secondary_message": null
    }
  ],
