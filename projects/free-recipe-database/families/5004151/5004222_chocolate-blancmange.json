  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together cornstarch, sugar, and cocoa powder; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium saucepan, combine milk, cornstarch mixture, and chocolate. Heat over medium heat, gently whisking constantly, until mixture comes to a boil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk in vanilla and pour into ramekins. Cover with plastic wrap to prevent a skin from forming and chill until set, at least 4 hours. Serve with whipped cream and fresh cherries.",
      "secondary_message": null
    }
  ],
