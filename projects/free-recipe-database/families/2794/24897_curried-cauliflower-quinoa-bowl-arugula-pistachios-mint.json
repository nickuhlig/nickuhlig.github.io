  "instructions": [
    {
      "id": 400807,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 400808,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 400809,
      "primary_message": "Meanwhile, place oil and spices in a large bowl. Stir to combine the spice oil.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp curry powder\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400810,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small pkg fresh mint\n1 ½ English cucumbers\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 400811,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the spice oil and stir to coat. Transfer to a large baking sheet pan and spread out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 400812,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is fork-tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400813,
      "primary_message": "While the cauliflower is roasting, pick mint leaves off the stems; discard stems and mince the leaves. Place half of the mint in a small bowl. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 400814,
      "primary_message": "Add mayo, tahini, water, vinegar, additional garlic powder, and salt to the bowl with the mint. Whisk to combine the sauce and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n½ cup tahini\n3 tbsp water\n3 tbsp apple cider vinegar\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 400815,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 400816,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "1 cup pistachios, unsalted"
    },
    {
      "id": 400817,
      "primary_message": "To serve, divide quinoa, cauliflower, arugula, and cucumber between bowls. Drizzle with sauce, then top with pistachios and reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
