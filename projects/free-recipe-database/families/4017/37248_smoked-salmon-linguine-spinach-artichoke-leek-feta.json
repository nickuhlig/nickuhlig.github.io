  "instructions": [
    {
      "id": 583843,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside.",
      "secondary_message": "¾ tsp salt\n425 g linguine pasta"
    },
    {
      "id": 583844,
      "primary_message": "Meanwhile, chop or tear smoked salmon into bite-sized pieces. Place in a small bowl and set aside. ",
      "secondary_message": "3 (113 g) pkgs smoked salmon"
    },
    {
      "id": 583845,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 leeks\n3 (142 g) pkgs baby spinach\n1 ½ lemons"
    },
    {
      "id": 583846,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 583847,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 583848,
      "primary_message": "While the pot heats up, peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 583849,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leek, garlic, and spices; cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 583850,
      "primary_message": "Meanwhile, drain and thinly slice artichoke hearts and sun-dried tomatoes.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 583851,
      "primary_message": "When the leek is done, add artichokes and sun-dried tomatoes to the pot, then stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 583852,
      "primary_message": "Add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 583853,
      "primary_message": "Juice lemons into the pot. Add drained pasta and smoked salmon, then toss to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 583854,
      "primary_message": "To serve, divide pasta between plates or bowls; top with feta and enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    }
  ],
