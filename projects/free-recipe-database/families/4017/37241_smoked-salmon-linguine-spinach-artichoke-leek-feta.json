  "instructions": [
    {
      "id": 583759,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside.",
      "secondary_message": "½ tsp salt\n10 oz linguine pasta"
    },
    {
      "id": 583760,
      "primary_message": "Meanwhile, chop or tear smoked salmon into bite-sized pieces. Place in a small bowl and set aside. ",
      "secondary_message": "2 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 583761,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 leeks\n2 (5 oz) pkgs baby spinach\n1 lemon"
    },
    {
      "id": 583762,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 583763,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 583764,
      "primary_message": "While the skillet heats up, peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 583765,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add leek, garlic, and spices; cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 583766,
      "primary_message": "Meanwhile, drain and thinly slice artichoke hearts and sun-dried tomatoes.",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated\n8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 583767,
      "primary_message": "When the leek is done, add artichokes and sun-dried tomatoes to the skillet, then stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 583768,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 583769,
      "primary_message": "Juice lemon into the skillet. Add drained pasta and smoked salmon, then toss to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 583770,
      "primary_message": "To serve, divide pasta between plates or bowls; top with feta and enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
