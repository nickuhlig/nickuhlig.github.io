  "instructions": [
    {
      "id": 435693,
      "primary_message": "Place water and salt in a large pot, cover, and bring to a boil over high heat.",
      "secondary_message": "1242 ml water\n3 pinch salt"
    },
    {
      "id": 435694,
      "primary_message": "Once boiling, stir in oats, maple syrup, and cardamom. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency.",
      "secondary_message": "3 cup oats, quick cooking\n1 tbsp pure maple syrup\n½ tsp cardamom, ground"
    },
    {
      "id": 435695,
      "primary_message": "Meanwhile, wash, dry, and peel oranges; separate into segments and roughly chop the flesh.",
      "secondary_message": "3 oranges"
    },
    {
      "id": 435696,
      "primary_message": "Roughly chop dates.",
      "secondary_message": "1 cup medjool dates, pitted"
    },
    {
      "id": 435697,
      "primary_message": "When the oatmeal is done, add tahini to the pot and stir to combine. Remove from heat.",
      "secondary_message": "3 tbsp tahini"
    },
    {
      "id": 435698,
      "primary_message": "To serve, divide oatmeal between bowls; top with oranges, dates, and sesame seeds. Drizzle with maple syrup and enjoy!",
      "secondary_message": "1 tbsp sesame seeds\n2 tbsp pure maple syrup"
    }
  ],
