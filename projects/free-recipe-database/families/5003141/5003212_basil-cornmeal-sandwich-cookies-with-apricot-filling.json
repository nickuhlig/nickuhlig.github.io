  "ingredients": [
    {
      "ingredient_id": 289,
      "name": "cornmeal",
      "quantity": "2 cups"
    },
    {
      "ingredient_id": 116,
      "name": "all purpose flour",
      "quantity": "2 tbsp (8 ¼ oz)"
    },
    {
      "ingredient_id": 331,
      "name": "baking powder",
      "quantity": "¼ tsp"
    },
    {
      "ingredient_id": 88,
      "name": "salt",
      "quantity": "½ tsp"
    },
    {
      "ingredient_id": 1710,
      "name": "confectioners sugar",
      "quantity": "1 ⅓ cups"
    },
    {
      "ingredient_id": 115,
      "name": "unsalted butter, at room temperature",
      "quantity": "2 sticks"
    },
    {
      "ingredient_id": 121,
      "name": "eggs",
      "quantity": "2 large"
    },
    {
      "ingredient_id": 1746,
      "name": "finely chopped fresh basil leaves",
      "quantity": "3 tbsp"
    },
    {
      "ingredient_id": 1585,
      "name": "apricot jam",
      "quantity": "½ cup"
    }
  ],
  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together cornmeal, flour, baking powder, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In the bowl of a stand mixer fitted with a paddle attachment, cream together butter and confectioners sugar. Add egg and beat to combine. Add dry ingredients and beat just until dough comes together. Stir in basil. Wrap dough in plastic wrap and refrigerate 1 hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven racks to upper- and lower-middle middle positions and preheat oven to 175°C (350°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "On a lightly floured surface, roll out dough to 0.5-cm thickness. Use a 5-cm cookie cutter to cut out cookies and transfer them to prepared baking sheets. Bake until golden, about 12 minutes. Let cool 5 minutes then transfer to a wire rack to finish cooling.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "When cookies are cool, layer bottom side of one cookie with 1/4- to 1/2-teaspoon jam. Top with a second cookie. Repeat to form remaining sandwiches.",
      "secondary_message": null
    }
  ],
