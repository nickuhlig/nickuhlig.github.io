  "instructions": [
    {
      "id": 218954,
      "primary_message": "Preheat oven to 190°C (375°F). Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 218955,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg red grapes\n1 small pkg fresh thyme\n1 ½ lemons\n3 bunches kale"
    },
    {
      "id": 218956,
      "primary_message": "Peel and thinly slice shallots into rings; transfer to the baking sheet along with the grapes.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 218957,
      "primary_message": "Slide thyme leaves off the stems; discard stems. Sprinkle thyme over the grapes, drizzle with oil and vinegar, and season with salt. Toss to coat, then spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n3 pinch salt"
    },
    {
      "id": 218958,
      "primary_message": "Place baking sheet in the oven and roast until grapes begin to swell, about 15 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 218959,
      "primary_message": "Meanwhile, peel and mince garlic; transfer to a large salad bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 218960,
      "primary_message": "Juice lemons into the bowl with the garlic. Add oil, maple syrup, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 ½ tsp balsamic vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 218961,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 218962,
      "primary_message": "Using your hands, massage kale with the dressing until wilted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 218963,
      "primary_message": "Chop or tear mozzarella into bite-sized pieces.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 218964,
      "primary_message": "Add mozzarella, pecans, warm grapes, shallots, and any roasting juices left in the pan, to the bowl with the kale. Toss to combine the salad.",
      "secondary_message": "2 cups pecans, dry roasted"
    },
    {
      "id": 218965,
      "primary_message": "To serve, divide salad between plates and enjoy!",
      "secondary_message": null
    }
  ],
