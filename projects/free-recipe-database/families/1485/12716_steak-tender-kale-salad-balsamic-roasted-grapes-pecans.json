  "instructions": [
    {
      "id": 218824,
      "primary_message": "Preheat oven to 375°F. Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 218825,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lb red grapes\n½ small pkg fresh thyme\n1 lemon\n2 bunches kale"
    },
    {
      "id": 218826,
      "primary_message": "Peel and thinly slice shallots into rings; transfer to the baking sheet along with the grapes.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 218827,
      "primary_message": "Slide thyme leaves off the stems; discard stems. Sprinkle thyme over the grapes, drizzle with oil and vinegar, and season with salt. Toss to coat, then spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n⅛ tsp salt"
    },
    {
      "id": 218828,
      "primary_message": "Place baking sheet in the oven and roast until grapes begin to swell, about 15 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 218829,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 218830,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 218831,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and let rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 218832,
      "primary_message": "While the steak is cooking, peel and mince garlic; transfer to a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 218833,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, maple syrup, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp pure maple syrup\n1 tsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 218834,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 218835,
      "primary_message": "Add warm grapes, shallots, and any roasting juices left in the pan, to the bowl with the kale. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 218836,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 218837,
      "primary_message": "To serve, divide salad between plates, top with steak and pecans. Enjoy!",
      "secondary_message": "½ cup pecans, dry roasted"
    }
  ],
