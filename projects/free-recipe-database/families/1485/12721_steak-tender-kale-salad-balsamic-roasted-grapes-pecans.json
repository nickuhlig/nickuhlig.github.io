  "instructions": [
    {
      "id": 218888,
      "primary_message": "Preheat oven to 190°C (375°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 218889,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg red grapes\n½ small pkg fresh thyme\n½ lemon\n1 bunch kale"
    },
    {
      "id": 218890,
      "primary_message": "Peel and thinly slice shallot into rings; transfer to the baking sheet along with the grapes.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 218891,
      "primary_message": "Slide thyme leaves off the stems; discard stems. Sprinkle thyme over the grapes, drizzle with oil and vinegar, and season with salt. Toss to coat, then spread out in an even layer.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 ½ tsp balsamic vinegar\n1 pinch salt"
    },
    {
      "id": 218892,
      "primary_message": "Place baking sheet in the oven and roast until grapes begin to swell, about 15 minutes. Remove from oven and set aside.",
      "secondary_message": null
    },
    {
      "id": 218893,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 218894,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 218895,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and let rest, about 5 minutes.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 218896,
      "primary_message": "While the steak is cooking, peel and mince garlic; transfer to a large bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 218897,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, maple syrup, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp pure maple syrup\n½ tsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 218898,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 218899,
      "primary_message": "Add warm grapes, shallots, and any roasting juices left in the pan, to the bowl with the kale. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 218900,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 218901,
      "primary_message": "To serve, divide salad between plates, top with steak and pecans. Enjoy!",
      "secondary_message": "¼ cup pecans, dry roasted"
    }
  ],
