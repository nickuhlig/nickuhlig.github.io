  "instructions": [
    {
      "id": 24812,
      "primary_message": "Wash the carrot and celery. Trim ends, peel, and small dice the carrot. Trim ends and small dice the celery. Peel and mince the onion. Peel and mince the garlic. Alternatively, place the vegetables in a food processor and pulse until finely chopped.",
      "secondary_message": "1 medium carrot\r\n1 stick celery\r\n½ medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 24813,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 24814,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add all the diced and minced vegetables. Cook, stirring frequently, until vegetables soften, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n"
    },
    {
      "id": 24815,
      "primary_message": "Push the veggie mixture to the side of the skillet, then add in the ground beef. Cook, breaking apart with a spoon, until beef is browned and no longer pink.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 24816,
      "primary_message": "Add diced tomatoes and tomato sauce to the beef and veggie mixture. Season with crushed red pepper, salt, and pepper. Bring to a boil, then lower the heat to medium-low and let simmer for 10-15 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\r\n1 (8 oz) can tomato sauce\r\n¼ tsp crushed red pepper\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 24817,
      "primary_message": "Wash and dry the basil; pick the leaves off the stems and slice into ribbons. Add about ½ to the sauce towards the end of cooking time and save the rest for garnishing.",
      "secondary_message": "½ small pkg fresh basil\r\n"
    },
    {
      "id": 24818,
      "primary_message": "Wash and dry zucchini; trim ends. Using a julienne peeler (or regular peeler), peel zucchini into noodle-like sticks. Leave raw or warm up in a skillet with a little olive until slightly softened.",
      "secondary_message": "2 medium zucchini squash\r\n"
    },
    {
      "id": 24819,
      "primary_message": "Finely grate ⅛ cup of parmesan.",
      "secondary_message": "½ oz Parmesan cheese\n"
    },
    {
      "id": 24820,
      "primary_message": "To serve, arrange zucchini noodles in a bowl and top with the bolognese sauce. Sprinkle with grated parmesan and remaining basil ribbons. Enjoy!",
      "secondary_message": ""
    }
  ],
