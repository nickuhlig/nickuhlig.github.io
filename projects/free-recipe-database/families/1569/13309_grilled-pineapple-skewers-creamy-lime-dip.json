  "instructions": [
    {
      "id": 222404,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 222405,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small pineapple\n½ lime"
    },
    {
      "id": 222406,
      "primary_message": "Peel and mince or grate ginger; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 222407,
      "primary_message": "Add sugar to the bowl with the ginger and stir to combine.",
      "secondary_message": "3 tbsp brown sugar"
    },
    {
      "id": 222408,
      "primary_message": "Cut skin off pineapple, quarter, core, and cut into bite-sized pieces; transfer to the bowl with the spiced sugar. Toss to coat.",
      "secondary_message": null
    },
    {
      "id": 222409,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 222410,
      "primary_message": "While the pan heats up, thread sugared pineapple onto the skewers. Alternatively, you can cook the pineapple directly on the pan without using skewers. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 222411,
      "primary_message": "Once the pan is hot, coat with oil. Add pineapple skewers and grill, turning occasionally, until charred and heated through, about 4 minutes. Remove to a plate and set aside.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 222412,
      "primary_message": "Meanwhile, zest and juice lime into the bowl used for the pineapple.",
      "secondary_message": null
    },
    {
      "id": 222413,
      "primary_message": "Using a box grater, coarsely grate cream cheese into the bowl with the lime. Use a silicone spatula or fork to soften and combine the cream cheese mixture, creating a smooth cream.",
      "secondary_message": "⅓ (227 g) block cream cheese"
    },
    {
      "id": 222414,
      "primary_message": "Add yogurt and honey to the bowl and stir to combine the dip.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp honey"
    },
    {
      "id": 222415,
      "primary_message": "To serve, divide pineapple skewers and dip between plates. Enjoy!",
      "secondary_message": null
    }
  ],
