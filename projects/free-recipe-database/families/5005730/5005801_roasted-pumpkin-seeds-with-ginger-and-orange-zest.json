  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the ginger. Grate the fresh orange zest. Mince the chives.",
      "secondary_message": "2 tsp ginger root\n2 tsp fresh orange zest\n3 tbsp chives"
    },
    {
      "id": 1,
      "primary_message": "Carefully wash pumpkin seeds to remove all excess pulp. Transfer pumpkin seeds to a paper towel–lined rimmed baking sheet. Allow to rest at room temperature until completely dry, about 1 hour. To speed up the process, dry pumpkin seeds in a 90°C (200°F) oven, stirring occasionally, or use a hair dryer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, combine olive oil with grated ginger and orange zest. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Adjust oven rack to center position and preheat oven to 160°C (325°F). Toss dried pumpkin seeds with ginger-orange oil and season with salt and pepper. Transfer to a rimmed baking sheet. Roast until pale golden brown, stirring occasionally, about 25 minutes total.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When seeds have cooled, transfer to a serving bowl, toss with minced chives, and serve.",
      "secondary_message": null
    }
  ],
