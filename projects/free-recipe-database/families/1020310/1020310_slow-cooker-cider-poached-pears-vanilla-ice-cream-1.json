  "instructions": [
    {
      "primary_message": "Chop ginger into small pieces. Place in a 4-quart slow cooker insert. ",
      "secondary_message": "1 tbsp candied (crystallized) ginger"
    },
    {
      "primary_message": "Break cinnamon stick in half. Add to the insert along with star anise, cloves, apple juice, and honey. Stir to combine the poaching liquid.",
      "secondary_message": "1 cinnamon stick\n2 star anise, whole\n2 cups apple juice\n¼ cup honey"
    },
    {
      "primary_message": "Wash, dry, peel, and halve pears lengthwise. Working one at a time, use a sharp paring knife, melon baller, or metal measuring spoon to cut out the core. Add pears to the insert, cover, and cook until tender, about 2 hours on high.",
      "secondary_message": null
    },
    {
      "primary_message": "When the pears are tender, use a slotted spoon to remove to a plate, leaving the poaching liquid in the insert.",
      "secondary_message": null
    },
    {
      "primary_message": "Strain poaching liquid into a medium saucepan using a fine mesh strainer. Bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once boiling, reduce heat to medium and simmer until the sauce is thick and syrupy, 20-25 minutes. Remove from heat and allow to cool slightly, 10 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide ice cream and pears between bowls. Drizzle with sauce and enjoy!",
      "secondary_message": "24 fl oz vanilla ice cream"
    }
  ],
