  "instructions": [
    {
      "id": 149175,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lb cremini mushrooms\n½ lemon\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 149176,
      "primary_message": "Peel and small dice onion; peel and mince garlic. Transfer both to a medium bowl.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 149177,
      "primary_message": "Thinly slice the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 149178,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 149179,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 149180,
      "primary_message": "Add onion and garlic to the skillet and cook, stirring occasionally, until softened, about 3 minutes. Reserve bowl for later.",
      "secondary_message": null
    },
    {
      "id": 149181,
      "primary_message": "Increase heat to medium-high and add mushrooms; season with salt and thyme. Cook, stirring occasionally, until mushrooms are softened and liquid has evaporated, about 7 minutes.",
      "secondary_message": "¼ tsp salt\n¼ tsp thyme"
    },
    {
      "id": 149182,
      "primary_message": "Meanwhile, roughly grate the cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 149183,
      "primary_message": "Combine eggs, half the cheese, salt, and pepper in the reserved bowl; whisk to combine.",
      "secondary_message": "6 eggs\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 149184,
      "primary_message": "Preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 149185,
      "primary_message": "Spread the mushrooms evenly in the skillet. Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 149186,
      "primary_message": "Sprinkle remaining cheese over the frittata. Place skillet in the oven until the top is set, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 149187,
      "primary_message": "Meanwhile, juice the lemon into a medium salad bowl. Add oil, Dijon salt, and pepper; whisk to combine the dressing. Add arugula and toss to combine the salad.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 149188,
      "primary_message": "To serve, cut frittata into wedges and place on plates; top with arugula and enjoy!",
      "secondary_message": null
    }
  ],
