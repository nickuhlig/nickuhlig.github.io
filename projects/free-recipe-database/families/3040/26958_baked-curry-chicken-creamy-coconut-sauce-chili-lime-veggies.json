  "instructions": [
    {
      "id": 435439,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 435440,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n6 medium carrots\n3 (1 inch) pieces ginger root\n1 ½ red chili peppers\n1 ½ limes\n1 small bunch cilantro"
    },
    {
      "id": 435441,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 435442,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Add to the baking sheets with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 435443,
      "primary_message": "Peel and mince garlic. Add to the baking sheets along with oil, salt, and pepper (if coconut oil is solid, melt in a medium saucepan over low heat). Stir to coat the veggies, then spread out in an even layer. ",
      "secondary_message": "3 cloves garlic\n3 tbsp virgin coconut oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 435444,
      "primary_message": "Pat chicken dry with paper towels and season with spices on both sides. Nestle chicken into the veggies on the baking sheets.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n1 ½ tbsp curry powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 435445,
      "primary_message": "Place baking sheets in the oven and roast, stirring veggies and flipping chicken halfway through, until veggies are tender and chicken is cooked through, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 435446,
      "primary_message": "Meanwhile, peel and mince ginger and additional garlic. Place both in a medium saucepan along with coconut milk and spices. Stir to combine the sauce.",
      "secondary_message": "3 cloves garlic\n1 ½ (13.5 fl oz) cans coconut milk\n¾ tsp turmeric, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 435447,
      "primary_message": "Set pan over high heat and bring sauce to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until reduced by half, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 435448,
      "primary_message": "While the sauce is simmering, thinly slice chili peppers into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 435449,
      "primary_message": "Zest and juice limes into the bowl with the chili pepper.",
      "secondary_message": null
    },
    {
      "id": 435450,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 435451,
      "primary_message": "Once the veggies are tender, remove from oven and transfer chicken to a plate. Sprinkle chili-lime mixture over the veggies and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 435452,
      "primary_message": "To serve, divide chicken and veggies between plates; spoon coconut sauce over chicken. Enjoy!",
      "secondary_message": null
    }
  ],
