  "instructions": [
    {
      "id": 435467,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 435468,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n4 medium carrots\n2 (2 ½ cm) pieces ginger root\n1 red chili pepper\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 435469,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 435470,
      "primary_message": "Peel, trim, and slice carrots crosswise into ¼-inch thick rounds. Add to the baking sheet with the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 435471,
      "primary_message": "Peel and mince garlic. Add to the baking sheet along with oil, salt, and pepper (if coconut oil is solid, melt in a small saucepan over low heat). Stir to coat the veggies, then spread out in an even layer. ",
      "secondary_message": "2 cloves garlic\n2 tbsp virgin coconut oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 435472,
      "primary_message": "Pat chicken dry with paper towels and season with spices on both sides. Nestle chicken into the veggies on the baking sheet.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n1 tbsp curry powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 435473,
      "primary_message": "Place baking sheet in the oven and roast, stirring veggies and flipping chicken halfway through, until veggies are tender and chicken is cooked through, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 435474,
      "primary_message": "Meanwhile, peel and mince ginger and additional garlic. Place both in a small saucepan along with coconut milk and spices. Stir to combine the sauce.",
      "secondary_message": "2 cloves garlic\n1 (398 ml) can coconut milk\n½ tsp turmeric, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 435475,
      "primary_message": "Set pan over high heat and bring sauce to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until reduced by half, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 435476,
      "primary_message": "While the sauce is simmering, thinly slice chili pepper into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.) Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 435477,
      "primary_message": "Zest and juice lime into the bowl with the chili pepper.",
      "secondary_message": null
    },
    {
      "id": 435478,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 435479,
      "primary_message": "Once the veggies are tender, remove from oven and transfer chicken to a plate. Sprinkle chili-lime mixture over the veggies and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 435480,
      "primary_message": "To serve, divide chicken and veggies between plates; spoon coconut sauce over chicken. Enjoy!",
      "secondary_message": null
    }
  ],
