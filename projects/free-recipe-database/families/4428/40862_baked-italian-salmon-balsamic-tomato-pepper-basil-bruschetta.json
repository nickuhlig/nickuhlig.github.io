  "instructions": [
    {
      "id": 630347,
      "primary_message": "Preheat oven to 220°C (425°F) and position rack in the upper third of the oven. Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 630348,
      "primary_message": "Place vinegar and sugar in a small saucepan, then bring to a boil over medium-high heat. Once boiling, reduce heat to medium-low and simmer until reduced by half, 6-7 minutes. Remove balsamic glaze from heat and set aside.",
      "secondary_message": "¾ cup balsamic vinegar\n1 ½ tbsp brown sugar"
    },
    {
      "id": 630349,
      "primary_message": "Meanwhile, pat salmon dry with paper towels. Transfer to the baking sheet, drizzle with oil, and season the top side with spices.",
      "secondary_message": "1.02 kg salmon fillet\n2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 630350,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 630351,
      "primary_message": "While the salmon is cooking, wash and dry the fresh produce.",
      "secondary_message": "3 small pkgs grape tomatoes\n1 ½ orange bell peppers\n1 small pkg fresh basil"
    },
    {
      "id": 630352,
      "primary_message": "Halve grape tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 630353,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 630354,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 630355,
      "primary_message": "Peel and mince shallot and garlic. Add both to the bowl along with oil, salt, and pepper. Stir to combine the bruschetta mixture and set aside.",
      "secondary_message": "1 shallot\n3 cloves garlic\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 630356,
      "primary_message": "When the salmon is done, change oven to broil on high. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 630357,
      "primary_message": "Arrange bread on a large baking sheet. Place in the oven and broil, flipping halfway through, until lightly toasted, 1-2 minutes. Remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices sourdough bread"
    },
    {
      "id": 630358,
      "primary_message": "To serve, divide salmon and toast between plates. Top toast with the bruschetta mixture, drizzle with balsamic glaze, and enjoy!",
      "secondary_message": null
    }
  ],
