  "instructions": [
    {
      "id": 630299,
      "primary_message": "Preheat oven to 425°F and position rack in the upper third of the oven. Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 630300,
      "primary_message": "Place vinegar and sugar in a small saucepan, then bring to a boil over medium-high heat. Once boiling, reduce heat to medium-low and simmer until reduced by half, 5-6 minutes. Remove balsamic glaze from heat and set aside.",
      "secondary_message": "½ cup balsamic vinegar\n1 tbsp brown sugar"
    },
    {
      "id": 630301,
      "primary_message": "Meanwhile, pat salmon dry with paper towels. Transfer to the baking sheet, drizzle with oil, and season the top side with spices.",
      "secondary_message": "1 ½ lb salmon fillet\n4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630302,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 630303,
      "primary_message": "While the salmon is cooking, wash and dry the fresh produce.",
      "secondary_message": "2 pints grape tomatoes\n1 orange bell pepper\n1 small pkg fresh basil"
    },
    {
      "id": 630304,
      "primary_message": "Halve grape tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 630305,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 630306,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 630307,
      "primary_message": "Peel and mince shallot and garlic. Add both to the bowl along with oil, salt, and pepper. Stir to combine the bruschetta mixture and set aside.",
      "secondary_message": "1 shallot\n2 cloves garlic\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 630308,
      "primary_message": "When the salmon is done, change oven to broil on high. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 630309,
      "primary_message": "Arrange bread on another baking sheet. Place in the oven and broil, flipping halfway through, until lightly toasted, 1-2 minutes. Remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 630310,
      "primary_message": "To serve, divide salmon and toast between plates. Top toast with the bruschetta mixture, drizzle with balsamic glaze, and enjoy!",
      "secondary_message": null
    }
  ],
