  "instructions": [
    {
      "id": 514181,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 514182,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "⅓ lb white mushrooms\n½ small pkg fresh basil\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 514183,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 pork sausages"
    },
    {
      "id": 514184,
      "primary_message": "Meanwhile, place water, oil, vinegar, tomato paste, maple syrup, Dijon, and spices in a small bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp water\n1 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 tbsp tomato paste\n1 tsp pure maple syrup\n1 tsp Dijon mustard\n½ tsp Italian seasoning\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 514185,
      "primary_message": "Thinly slice mushrooms. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 514186,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the plate with the mushrooms.",
      "secondary_message": "1 (6 oz) jar artichoke hearts, marinated"
    },
    {
      "id": 514187,
      "primary_message": "Cut mozzarella into bite-sized pieces. Add to the plate.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 514188,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 514189,
      "primary_message": "Transfer cooked sausages to the cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 514190,
      "primary_message": "To serve, divide mixed greens between plates or bowls. Top with mushrooms, artichokes, mozzarella, basil, and sausage. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
