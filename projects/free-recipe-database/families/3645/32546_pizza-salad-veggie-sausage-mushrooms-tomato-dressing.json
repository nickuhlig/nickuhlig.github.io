  "instructions": [
    {
      "id": 514221,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 514222,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "⅔ lb white mushrooms\n1 small pkg fresh basil\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 514223,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n4 pre-cooked vegan sausage"
    },
    {
      "id": 514224,
      "primary_message": "Meanwhile, place water, oil, vinegar, tomato paste, maple syrup, Dijon, and spices in a small bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp water\n2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n2 tbsp tomato paste\n2 tsp pure maple syrup\n2 tsp Dijon mustard\n1 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 514225,
      "primary_message": "Thinly slice mushrooms. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 514226,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the plate with the mushrooms.",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 514227,
      "primary_message": "Cut mozzarella into bite-sized pieces. Add to the plate.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 514228,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 514229,
      "primary_message": "Transfer cooked sausages to the cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 514230,
      "primary_message": "To serve, divide mixed greens between plates or bowls. Top with mushrooms, artichokes, mozzarella, basil, and sausage. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
