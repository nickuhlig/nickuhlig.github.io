  "instructions": [
    {
      "id": 336349,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 336350,
      "primary_message": "Wash, dry, and separate cauliflower into bite-sized florets; cut stems into smaller pieces. Place in a medium bowl.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 336351,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 336352,
      "primary_message": "While the skillet heats up, peel and mince garlic; add to the bowl with the cauliflower.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 336353,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add cauliflower, garlic, and spices. Cook, stirring occasionally, until the cauliflower has softened, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 336354,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces and place in the reserved bowl.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 336355,
      "primary_message": "Medium dice tofu and place in another medium bowl; sprinkle with cornstarch, salt, and pepper, then gently toss to coat.",
      "secondary_message": "4 tsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 336356,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Return cooked veggies to the bowl and set aside. (Reserve skillet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 336357,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom; add tofu and cook, turning occasionally, until golden brown on all sides, 6-7 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 336358,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 336359,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "1 (8 oz) block cream cheese"
    },
    {
      "id": 336360,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 336361,
      "primary_message": "Return veggies to the skillet and add cream cheese; cook, stirring occasionally, until cream cheese is melted and everything is warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 336362,
      "primary_message": "Top skillet with mozzarella and place in the oven; broil until the cheese is melted and bubbly, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 336363,
      "primary_message": "To serve, divide tofu and veggie skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
