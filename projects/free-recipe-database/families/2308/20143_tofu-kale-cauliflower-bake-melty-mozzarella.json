  "instructions": [
    {
      "id": 336364,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 336365,
      "primary_message": "Wash, dry, and separate each cauliflower into bite-sized florets; cut stems into smaller pieces. Place in a large bowl.",
      "secondary_message": "1 ½ medium heads cauliflower"
    },
    {
      "id": 336366,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 336367,
      "primary_message": "While the pot heats up, peel and mince garlic; add to the bowl with the cauliflower.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 336368,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add cauliflower, garlic, and spices. Cook, stirring occasionally, until the cauliflower has softened, 7-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 336369,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces and place in the reserved bowl.",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 336370,
      "primary_message": "Medium dice tofu and place in another large bowl; sprinkle with cornstarch, salt, and pepper, then gently toss to coat.",
      "secondary_message": "2 tbsp cornstarch\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 336371,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Return cooked veggies to the bowl and set aside. (Reserve pot for the next step.)",
      "secondary_message": null
    },
    {
      "id": 336372,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom; add tofu and cook, turning occasionally, until golden brown on all sides, 7-8 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 336373,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 336374,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "1 ½ (8 oz) blocks cream cheese"
    },
    {
      "id": 336375,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 336376,
      "primary_message": "Return veggies to the pot and add cream cheese; cook, stirring occasionally, until cream cheese is melted and everything is warmed through, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 336377,
      "primary_message": "Transfer mixture to a large baking dish, top with mozzarella, and place in the oven; broil until the cheese is melted and bubbly, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 336378,
      "primary_message": "To serve, divide tofu and veggie bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
