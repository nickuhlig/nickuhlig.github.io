  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the yellow onion. Finely dice the poblano peppers. Toast the soft hamburger buns.",
      "secondary_message": "1 large yellow onion\n2 medium poblano peppers\n4 soft hamburger buns"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a large skillet over medium-high heat until shimmering. Add onions and peppers and cook, stirring frequently, until softened and well-browned, about 10 minutes. Add chorizo and cook, breaking it up with a potato masher or whisk. Continue cook until meat is cooked through, abut 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drain excess fat and return pan to heat. Add sugar and tomato sauce and cook, stirring, until reduced to a sauce-like texture. Stir in hot sauce and season to taste with salt and pepper. Spoon mixture into toasted burger buns, top with avocado and onion, and serve.",
      "secondary_message": null
    }
  ],
