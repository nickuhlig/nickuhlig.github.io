  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine rice and almonds in blender. Blend on high speed, stopping to shake jar as necessary until roughly powdered, about 30 seconds. Add remaining ingredients to blender and blend on high speed for a further 1 minute. Refrigerate and let steep overnight. The next day, strain through a fine mesh strainer. Add more sugar, cinnamon, and vanilla to taste. Serve chilled over ice.",
      "secondary_message": null
    }
