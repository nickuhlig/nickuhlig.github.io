  "instructions": [
    {
      "id": 327939,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 ½ lemons\n3 English cucumbers"
    },
    {
      "id": 327940,
      "primary_message": "Trim and coarsely grate zucchini; transfer to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 327941,
      "primary_message": "Add turkey, half the feta, bread crumbs, and spices to the bowl with the zucchini. Mix with your hands until well combined. (Set remaining feta aside.)",
      "secondary_message": "2 ¼ lb ground turkey\n3 (4 oz) pkgs crumbled feta cheese\n¾ cup panko bread crumbs\n1 ½ tsp parsley flakes\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 327942,
      "primary_message": "Using a ⅓-cup measure, form turkey mixture into ½-inch thick fritters. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 327943,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 327944,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fritters to the skillet and cook, flipping once, until golden and cooked through, 10-12 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 327945,
      "primary_message": "Meanwhile, peel and mince garlic. Transfer to a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 327946,
      "primary_message": "Zest lemons into the bowl with the garlic; add yogurt, mayo, salt, and pepper. Whisk to combine the garlic-yogurt sauce and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp mayonnaise\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 327947,
      "primary_message": "Juice lemons into a clean large bowl. Add oil, salt, pepper, and remaining feta; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 327948,
      "primary_message": "Trim and thinly slice cucumbers. Transfer to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 327949,
      "primary_message": "Divide salad and fritters between plates; serve with garlic-yogurt sauce on the side. Enjoy!",
      "secondary_message": null
    }
  ],
