  "instructions": [
    {
      "id": 327983,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n½ lemon\n1 English cucumber"
    },
    {
      "id": 327984,
      "primary_message": "Trim and coarsely grate zucchini; place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 327985,
      "primary_message": "Add veggie ground, half of the feta, bread crumbs, and spices to the bowl with the zucchini; mix with your hands until well combined. (Set remaining feta aside.)",
      "secondary_message": "8 oz veggie ground, plant based\n1 (4 oz) pkg crumbled feta cheese\n¼ cup panko bread crumbs\n½ tsp parsley flakes\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 327986,
      "primary_message": "Using a ¼-cup measure, form veggie ground mixture into ½-inch thick fritters; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 327987,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 327988,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters to the skillet and cook, flipping once, until golden and cooked through, about 10 minutes. Remove to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 327989,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 327990,
      "primary_message": "Zest lemon into the bowl with the garlic, then add yogurt, mayo, salt, and pepper. Whisk to combine the garlic yogurt and set aside. (Reserve lemon for the next step.)",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 327991,
      "primary_message": "Juice lemon into a clean medium bowl. Add oil, salt, pepper, and remaining feta; whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 327992,
      "primary_message": "Trim and thinly slice cucumber; add to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 327993,
      "primary_message": "Divide salad and fritters between plates; serve with garlic yogurt on the side and enjoy!",
      "secondary_message": null
    }
  ],
