  "instructions": [
    {
      "id": 328115,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n½ lemon\n1 English cucumber"
    },
    {
      "id": 328116,
      "primary_message": "Trim and coarsely grate zucchini; transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 328117,
      "primary_message": "Add turkey, half the feta, and spices to the bowl with the zucchini. Mix with your hands until well combined. (Set remaining feta aside.)",
      "secondary_message": "⅓ kg ground turkey\n1 (113 g) pkg crumbled feta cheese\n½ tsp parsley flakes\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 328118,
      "primary_message": "Using a ⅓-cup measure, form turkey mixture into ½-inch thick fritters. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 328119,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 328120,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters to the skillet and cook, flipping once, until golden and cooked through, 10-12 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 328121,
      "primary_message": "Meanwhile, peel and mince garlic. Transfer to a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 328122,
      "primary_message": "Zest lemon into the bowl with the garlic; add yogurt, mayo, salt, and pepper. Whisk to combine the garlic-yogurt sauce and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 328123,
      "primary_message": "Juice lemon into a clean medium bowl. Add oil, salt, pepper, and remaining feta; whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 328124,
      "primary_message": "Trim and thinly slice cucumber. Transfer to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 328125,
      "primary_message": "Divide salad and fritters between plates; serve with garlic-yogurt sauce on the side. Enjoy!",
      "secondary_message": null
    }
  ],
