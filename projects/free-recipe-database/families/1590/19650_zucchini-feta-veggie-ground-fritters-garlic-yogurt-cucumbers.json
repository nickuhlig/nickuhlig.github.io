  "instructions": [
    {
      "id": 327994,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 lemon\n2 English cucumbers"
    },
    {
      "id": 327995,
      "primary_message": "Trim and coarsely grate zucchini; place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 327996,
      "primary_message": "Add veggie ground, half of the feta, bread crumbs, and spices to the bowl with the zucchini; mix with your hands until well combined. (Set remaining feta aside.)",
      "secondary_message": "16 oz veggie ground, plant based\n2 (4 oz) pkgs crumbled feta cheese\n½ cup panko bread crumbs\n1 tsp parsley flakes\n1 tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 327997,
      "primary_message": "Using a ¼-cup measure, form veggie ground mixture into ½-inch thick fritters; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 327998,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 327999,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fritters to the skillet and cook, flipping once, until golden and cooked through, about 10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 328000,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 328001,
      "primary_message": "Zest lemon into the bowl with the garlic, then add yogurt, mayo, salt, and pepper. Whisk to combine the garlic yogurt and set aside. (Reserve lemon for the next step.)",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp mayonnaise\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 328002,
      "primary_message": "Juice lemon into a clean medium bowl. Add oil, salt, pepper, and remaining feta; whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 328003,
      "primary_message": "Trim and thinly slice cucumbers; add to the bowl with the dressing and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 328004,
      "primary_message": "Divide salad and fritters between plates; serve with garlic yogurt on the side and enjoy!",
      "secondary_message": null
    }
  ],
