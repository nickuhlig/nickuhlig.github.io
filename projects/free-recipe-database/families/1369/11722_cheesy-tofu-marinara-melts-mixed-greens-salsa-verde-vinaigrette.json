  "instructions": [
    {
      "id": 205153,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 205154,
      "primary_message": "Meanwhile, peel and mince garlic and shallot. Mince capers. Place in a medium bowl along with oil, vinegar, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n½ shallot\n1 tbsp capers\n1 ½ tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 205155,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 205156,
      "primary_message": "While the skillet heats up, medium dice the tofu.",
      "secondary_message": null
    },
    {
      "id": 205157,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu, soy sauce, and Italian seasoning. Cook, stirring occasionally, until golden brown, 5-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n4 tsp soy sauce\n¾ tsp Italian seasoning"
    },
    {
      "id": 205158,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 205159,
      "primary_message": "Grate cheeses, combine in a small bowl, and set aside.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese\n1 oz Parmesan cheese"
    },
    {
      "id": 205160,
      "primary_message": "Peel and mince additional garlic. Mince sun-dried tomatoes.",
      "secondary_message": "1 clove garlic\n3 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 205161,
      "primary_message": "Add garlic, sun-dried tomatoes, and tomato sauce to the skillet with the tofu. Continue to cook, stirring often, until sauce thickens, 2-3 minutes. Remove from heat.",
      "secondary_message": "1 (8 oz) can tomato sauce"
    },
    {
      "id": 205162,
      "primary_message": "Split rolls in half and place, cut-side facing up, on a baking sheet. Place in the oven and broil until lightly toasted, about 1 minute. ",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 205163,
      "primary_message": "Remove rolls from the oven and top with half the cheese. Divide tofu mixture between rolls and cover with remaining cheese. Return to the oven and broil until cheese melts, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 205164,
      "primary_message": "Meanwhile, wash and dry parsley. Shave leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 205165,
      "primary_message": "Wash and dry the spring mix. (Skip if it came pre-washed.) Add to the bowl and toss to combine the salad.",
      "secondary_message": "½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 205166,
      "primary_message": "To serve, divide tofu melts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
