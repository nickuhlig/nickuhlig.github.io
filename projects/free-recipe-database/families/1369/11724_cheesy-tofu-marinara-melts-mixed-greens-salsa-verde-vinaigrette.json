  "instructions": [
    {
      "id": 205181,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 205182,
      "primary_message": "Meanwhile, peel and mince garlic and shallots. Mince capers. Place in a large bowl along with oil, vinegar, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n1 ½ shallots\n3 tbsp capers\n¼ cup extra virgin olive oil\n3 tbsp red wine vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 205183,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 205184,
      "primary_message": "While the skillet heats up, medium dice the tofu.",
      "secondary_message": null
    },
    {
      "id": 205185,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu, soy sauce, and Italian seasoning. Cook, stirring occasionally, until golden brown, 7-10 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¼ cup soy sauce\n2 ½ tsp Italian seasoning"
    },
    {
      "id": 205186,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 205187,
      "primary_message": "Grate cheeses, combine in a medium bowl, and set aside.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese\n3 oz Parmesan cheese"
    },
    {
      "id": 205188,
      "primary_message": "Peel and mince additional garlic. Mince sun-dried tomatoes.",
      "secondary_message": "3 cloves garlic\n9 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 205189,
      "primary_message": "Add garlic, sun-dried tomatoes, and tomato sauce to the skillet with the tofu. Continue to cook, stirring often, until sauce thickens, 4-5 minutes. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 205190,
      "primary_message": "Split rolls in half and place, cut-side facing up, on a large baking sheet pan. Place in the oven and broil until lightly toasted, about 1 minute. ",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 205191,
      "primary_message": "Remove rolls from the oven and top with half the cheese. Divide tofu mixture between rolls and cover with remaining cheese. Return to the oven and broil until cheese melts, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 205192,
      "primary_message": "Meanwhile, wash and dry parsley. Shave leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 205193,
      "primary_message": "Wash and dry the spring mix. (Skip if it came pre-washed.) Add to the bowl and toss to combine the salad.",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 205194,
      "primary_message": "To serve, divide tofu melts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
