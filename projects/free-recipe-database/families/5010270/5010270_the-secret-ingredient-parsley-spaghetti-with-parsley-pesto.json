  "instructions": [
    {
      "id": 1,
      "primary_message": "Cook the spaghetti in salted boiling water until al dente. Drain, and reserve a cup of pasta water.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Blast the garlic in the food processor until it’s smashed. Add the parsley, walnuts, Parmesan, olive oil, salt, and pepper. Whiz until it forms a thick paste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Toss the pasta with the pesto, and add reserved pasta water as needed. Serve right away. You can also spoon the pesto over grilled steak.",
      "secondary_message": null
    }
