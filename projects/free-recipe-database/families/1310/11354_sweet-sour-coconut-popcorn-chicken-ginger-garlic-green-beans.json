  "instructions": [
    {
      "id": 203427,
      "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 203428,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lb green beans\n2 (1 inch) pieces ginger root\n2 oranges"
    },
    {
      "id": 203429,
      "primary_message": "Trim and discard ends of the green beans; transfer to one half of the baking sheet, in a single layer.",
      "secondary_message": null
    },
    {
      "id": 203430,
      "primary_message": "Peel and mince garlic and ginger; sprinkle both over the green beans. Set aside. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 203431,
      "primary_message": "Place coconut and almond flour in a medium bowl; whisk to combine.",
      "secondary_message": "1 cup shredded unsweetened coconut\n½ cup almond meal/flour"
    },
    {
      "id": 203432,
      "primary_message": "Whisk eggs in a second medium bowl.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 203433,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces; season with salt and pepper. ",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 203434,
      "primary_message": "Toss chicken in the egg to coat. Working in batches, transfer chicken to the coconut mixture and turn to coat, pressing gently to adhere. Place chicken on the other half of the baking sheet, in a single layer.",
      "secondary_message": null
    },
    {
      "id": 203435,
      "primary_message": "Drizzle oil over the beans and chicken. Place in the oven and bake until chicken is golden brown and cooked through, and beans are fork-tender, about 15 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 203436,
      "primary_message": "Meanwhile, juice oranges into a medium saucepan. Add ketchup, oil, soy sauce, vinegar, and sugar; whisk to combine. Bring to a simmer over medium heat.",
      "secondary_message": "2 tbsp ketchup\n1 tbsp extra virgin olive oil\n1 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp brown sugar"
    },
    {
      "id": 203437,
      "primary_message": "In a small bowl, make a slurry by whisking water with cornstarch until smooth.",
      "secondary_message": "2 tbsp water\n2 tsp cornstarch"
    },
    {
      "id": 203438,
      "primary_message": "Add cornstarch slurry to the saucepan in a steady stream while whisking quickly. Cook, whisking often, until sweet and sour sauce thickens, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 203439,
      "primary_message": "Drizzle sweet and sour sauce over the baked chicken and gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 203440,
      "primary_message": "To serve, divide chicken and beans between plates. Sprinkle chicken with sesame seeds and enjoy! ",
      "secondary_message": "½ tsp sesame seeds"
    }
  ],
