  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a medium saucepan of water to a boil over high heat. Working in batches if necessary, place mushrooms in a fine mesh strainer and lower into boiling water for 15 seconds. Lift, shake of excess moisture, and transfer to a large mixing bowl. Repeat until all mushrooms are blanched.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add shallots, 1 tablespoon fish sauce, and 1 tablespoon lime juice. Taste to see if more fish sauce and/or lime juice is needed. Salad should be predominantly sour. Add red pepper to taste. Add toasted rice powder and chopped culantro. Serve immediately.",
      "secondary_message": null
    }
  ],
