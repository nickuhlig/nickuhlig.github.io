  "instructions": [
    {
      "id": 1,
      "primary_message": "Place sausage in a medium saucepan over medium-high heat. Cook sausage, breaking apart with a wooden spoon, until browned and cooked through. Using a slotted spoon, transfer sausage to a plate, leaving drippings in pan. If less than 3 tablespoons of drippings remain, melt enough butter in pan to equal about 3 tablespoons.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk flour into sausage drippings and cook, stirring constantly, until mixture turns light brown, about 1 minute. Slowly whisk in milk and bring to a boil. Reduce to a simmer and cook until slightly thickened, about 4 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in sausage, sage (if using), and crushed red pepper (if using). Remove from heat and season with salt and pepper to taste. Use immediately.",
      "secondary_message": null
    }
  ],
