  "instructions": [
    {
      "id": 183057,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and rinse pasta in a colander and set aside.",
      "secondary_message": "2 tsp salt\n227 g spaghetti pasta"
    },
    {
      "id": 183058,
      "primary_message": "Wash and dry tomatoes; cut in half crosswise. Peel and thinly slice garlic. Peel and thinly slice shallots into rings. ",
      "secondary_message": "2 small pkgs grape tomatoes\n4 cloves garlic\n2 shallots"
    },
    {
      "id": 183059,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 183060,
      "primary_message": "Halve the olives lengthwise.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 183061,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes, garlic, shallots, olives, capers, and spices. Cook, stirring often, until tomatoes begin to soften and make a chunky sauce, 5-6 minutes. Transfer to a serving bowl and cover with foil. Reserve skillet for the frittata.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp capers\n½ tsp Italian seasoning\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 183062,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 183063,
      "primary_message": "Wash and dry remaining fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 183064,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 183065,
      "primary_message": "Finely grate Parmesan; add to the bowl with the parsley along with the eggs, salt, and pepper; whisk to combine.",
      "secondary_message": "57 g Parmesan cheese\n10 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 183066,
      "primary_message": "Return skillet (it doesn't have to be wiped clean) to medium heat.",
      "secondary_message": null
    },
    {
      "id": 183067,
      "primary_message": "Transfer pasta to the bowl with the eggs and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 183068,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 183069,
      "primary_message": "Pour the egg-pasta mixture into the skillet and smooth out in an even layer. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 183070,
      "primary_message": "Meanwhile, zest and juice lemon into a medium bowl. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 183071,
      "primary_message": "Place skillet in the oven and cook until top is set and golden brown, 3-4 minutes. Remove from the oven and slice into wedges.",
      "secondary_message": null
    },
    {
      "id": 183072,
      "primary_message": "Pick basil leaves off the stems; discard the stems and thinly slice the leaves into ribbons. Add basil and arugula to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 183073,
      "primary_message": "Divide frittata and salad between plates and serve with warm puttanesca sauce. Enjoy!",
      "secondary_message": null
    }
  ],
