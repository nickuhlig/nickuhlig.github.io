  "instructions": [
    {
      "id": 194921,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 tomato\n½ jalapeño pepper\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 194922,
      "primary_message": "Peel and mince shallot. Small dice tomato; transfer both to a medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 194923,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the shallot. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 194924,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 194925,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 194926,
      "primary_message": "While the skillet heats up, add spices to the bowl and stir to combine the veggie mix.",
      "secondary_message": "½ tsp turmeric\n¼ tsp salt\n¼ tsp chili powder"
    },
    {
      "id": 194927,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the veggie mix and cook, stirring often, until the veggies begin to soften, 3-4 minutes.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 194928,
      "primary_message": "Meanwhile, place eggs in the bowl used for the veggies and whisk to combine.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 194929,
      "primary_message": "Grate the cheese.",
      "secondary_message": "⅛ (227 g) block mozzarella cheese"
    },
    {
      "id": 194930,
      "primary_message": "Pour eggs into the skillet and stir to combine with the veggies. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 194931,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 194932,
      "primary_message": "Place tortillas on a flat surface. Divide cheese, egg scramble, and avocado between them. Roll tightly to close and cut in half. Enjoy!",
      "secondary_message": "2 large flour tortillas"
    }
  ],
