  "instructions": [
    {
      "id": 194897,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n1 jalapeño pepper\n1 small bunch cilantro\n1 avocado"
    },
    {
      "id": 194898,
      "primary_message": "Peel and mince onion. Small dice tomatoes; transfer both to a large bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 194899,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the onion. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 194900,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 194901,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 194902,
      "primary_message": "While the skillet heats up, add spices to the bowl and stir to combine the veggie mix.",
      "secondary_message": "1 tsp turmeric\n½ tsp salt\n½ tsp chili powder"
    },
    {
      "id": 194903,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the veggie mix and cook, stirring often, until the veggies begin to soften, about 4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 194904,
      "primary_message": "Meanwhile, place eggs in the bowl used for the veggies and whisk to combine.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 194905,
      "primary_message": "Grate the cheese.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 194906,
      "primary_message": "Pour eggs into the skillet and stir to combine with the veggies. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 194907,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 194908,
      "primary_message": "Place tortillas on a flat surface. Divide cheese, egg scramble, and avocado between them. Roll tightly to close and cut in half. Enjoy!",
      "secondary_message": "4 large flour tortillas"
    }
  ],
