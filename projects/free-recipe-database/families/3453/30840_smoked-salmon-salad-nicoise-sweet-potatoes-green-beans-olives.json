  "instructions": [
    {
      "id": 489207,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 489208,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 489209,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 ¼ lb sweet potatoes\n3 pints grape tomatoes\n1 ½ lb green beans\n3 lemons\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 489210,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two baking sheet pans along with tomatoes. Drizzle with oil and season with salt; stir to coat and spread out in an even layer. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 489211,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is fork-tender and tomatoes are burst and browned in spots, about 25 minutes. Remove from oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 489212,
      "primary_message": "Meanwhile, trim green beans.",
      "secondary_message": null
    },
    {
      "id": 489213,
      "primary_message": "Once the water in the pot is boiling, add green beans; cook until tender-crisp, 2-3 minutes. Using a slotted spoon, transfer green beans to the colander, and add ice or run under cold water to cool; set aside. (Reserve pot of boiling water for the next step.)",
      "secondary_message": null
    },
    {
      "id": 489214,
      "primary_message": "Add eggs to the pot of boiling water, then reduce heat to a simmer and cook for 10 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "9 eggs"
    },
    {
      "id": 489215,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a small bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 489216,
      "primary_message": "Juice lemons into the bowl with the shallot. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. Transfer half of the dressing to a large bowl. (Reserve remaining dressing for serving.)",
      "secondary_message": "½ cup extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 489217,
      "primary_message": "Add mixed greens to the large bowl with the dressing. Gently toss to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 489218,
      "primary_message": "Halve olives lengthwise. Transfer to a large plate.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 489219,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces. Add to the plate with the olives.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 489220,
      "primary_message": "Peel and quarter eggs. Add to the plate and season with salt. ",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 489221,
      "primary_message": "To serve, divide salad between plates or bowls. Top with sweet potato, tomatoes, green beans, eggs, smoked salmon, olives, and capers. Drizzle with reserved dressing and enjoy!",
      "secondary_message": "3 tbsp capers"
    }
  ],
