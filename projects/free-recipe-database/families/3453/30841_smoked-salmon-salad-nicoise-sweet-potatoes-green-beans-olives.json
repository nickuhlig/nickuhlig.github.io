  "instructions": [
    {
      "id": 489222,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 489223,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 489224,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "⅓ kg sweet potato\n1 small pkg grape tomatoes\n0.23 kg green beans\n1 lemon\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 489225,
      "primary_message": "Peel and medium dice sweet potato. Transfer to a baking sheet pan along with tomatoes. Drizzle with oil and season with salt; stir to coat and spread out in an even layer. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 489226,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is fork-tender and tomatoes are burst and browned in spots, 20-25 minutes. Remove from oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 489227,
      "primary_message": "Meanwhile, trim green beans.",
      "secondary_message": null
    },
    {
      "id": 489228,
      "primary_message": "Once the water in the pan is boiling, add green beans; cook until tender-crisp, 2-3 minutes. Using a slotted spoon, transfer green beans to the colander, and add ice or run under cold water to cool; set aside. (Reserve pan of boiling water for the next step.)",
      "secondary_message": null
    },
    {
      "id": 489229,
      "primary_message": "Add eggs to the pan of boiling water, then reduce heat to a simmer and cook for 10 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 489230,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a small bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 489231,
      "primary_message": "Juice lemon into the bowl with the shallot. Add oil, Dijon, honey, salt, and pepper, then whisk to combine the dressing. Transfer half of the dressing to a medium bowl. (Reserve remaining dressing for serving.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 489232,
      "primary_message": "Add mixed greens to the medium bowl with the dressing. Gently toss to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 489233,
      "primary_message": "Halve olives lengthwise. Transfer to a plate.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 489234,
      "primary_message": "Chop or tear smoked salmon into bite-sized pieces. Add to the plate with the olives.",
      "secondary_message": "1 (113 g) pkg smoked salmon"
    },
    {
      "id": 489235,
      "primary_message": "Peel and quarter eggs. Add to the plate and season with salt. ",
      "secondary_message": "1 pinch salt"
    },
    {
      "id": 489236,
      "primary_message": "To serve, divide salad between plates or bowls. Top with sweet potato, tomatoes, green beans, eggs, smoked salmon, olives, and capers. Drizzle with reserved dressing and enjoy!",
      "secondary_message": "1 tbsp capers"
    }
  ],
