  "instructions": [
    {
      "primary_message": "Prepare biscuits in the oven according to package directions.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, in a medium bowl whisk to combine eggs, salt and pepper.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spray a sauté pan with nonstick cooking spray and preheat over medium heat. Add egg mixture and cook until set, stirring occasionally. Move eggs to one side of the pan and top with 4 slices of the Kraft® American Cheese Singles. Add Canadian bacon slices to the side opposite of the eggs, just to warm through.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once biscuits are out of the oven, split in half and place a half slice of remaining cheese on the bottom piece of each biscuit. Top with Canadian bacon, cheesy eggs and remaining biscuit. Return to the oven for 4-5 minutes, just to warm through. Serve.\n",
      "secondary_message": null
    }
  ],
