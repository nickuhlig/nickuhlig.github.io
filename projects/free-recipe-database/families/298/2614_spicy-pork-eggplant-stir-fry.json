  "instructions": [
    {
      "id": 25327,
      "primary_message": "In a small bowl, create a slurry by whisking together water with arrowroot. Then add chili-garlic sauce, coconut aminos, vinegar, and sesame oil and whisk together. Set aside.",
      "secondary_message": "2 tbsp cold water\r\n1 tsp arrowroot starch/powder\r\n1 tbsp chili-garlic sauce\r\n2 tbsp coconut aminos\r\n½ tbsp rice vinegar\r\n1 tsp toasted sesame oil"
    },
    {
      "id": 25328,
      "primary_message": "Wash and dry the eggplant and green onions. Medium dice the eggplant; transfer to a bowl. Trim ends and cut the onions on an angle into ½ pieces; transfer to another bowl.",
      "secondary_message": "1 medium eggplant\r\n½ small bunch green onions (scallions)"
    },
    {
      "id": 25329,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Transfer both to a small bowl.",
      "secondary_message": "2 cloves garlic\r\n1 (1 inch) piece ginger root"
    },
    {
      "id": 25330,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 25331,
      "primary_message": "Thinly slice the pork chops into bite-sized strips and season with salt.",
      "secondary_message": "2 pork chops, boneless\r\n⅛ tsp salt"
    },
    {
      "id": 25332,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the pork and stir-fry until browned, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 25333,
      "primary_message": "Once pork has been removed, add more oil to the skillet. Add the eggplant and stir-fry until lightly browned and softened, 4-5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 25334,
      "primary_message": "Add the garlic and ginger to the skillet. Stir fry with the eggplant for 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 25335,
      "primary_message": "Return pork to the skillet and add the green onions and sauce. Toss until the ingredients are well combined and sauce is thickened, about 1 minute.",
      "secondary_message": ""
    },
    {
      "id": 25336,
      "primary_message": "Cut the lime into wedges for serving.",
      "secondary_message": "½ lime\r\n"
    },
    {
      "id": 25337,
      "primary_message": "Serve stir fry in a bowl, squeeze lime juice over top, and enjoy!",
      "secondary_message": ""
    }
  ],
