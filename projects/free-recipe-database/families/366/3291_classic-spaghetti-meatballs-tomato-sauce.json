  "instructions": [
    {
      "id": 33982,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": "\n"
    },
    {
      "id": 33983,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (142 g) pkg baby spinach\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 33984,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and mince the leaves. Transfer half of the parsley to a medium bowl and the other half to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 33985,
      "primary_message": "Peel and mince the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 33986,
      "primary_message": "Peel and mince the garlic; transfer half of the onion and garlic to the medium bowl with the parsley and the other half to another small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 33987,
      "primary_message": "Add the ground beef, bread crumbs, and spices to the medium bowl with the parsley, onion and garlic mixture. Mix with your hands until well combined.",
      "secondary_message": "0.34 kg lean ground beef\n⅛ cup panko bread crumbs\n¼ tsp salt\n¼ tsp black pepper\n½ tsp Italian seasoning\n⅛ tsp crushed red pepper"
    },
    {
      "id": 33988,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 33989,
      "primary_message": "Using a tablespoon measure, form the meat mixture into rounded meatballs.",
      "secondary_message": null
    },
    {
      "id": 33990,
      "primary_message": "Add olive oil to the pan and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 33991,
      "primary_message": "Once the water is boiling, season with salt and add the pasta. Cook the pasta until desired firmness, 8 to 10 minutes. Once done, drain in a colander.",
      "secondary_message": "1 tbsp salt\n142 g (1 quarter coin = 57 g) spaghetti pasta"
    },
    {
      "id": 33992,
      "primary_message": "Place the meatballs in the pan and cook, stirring occasionally, until they are browned on all sides and almost cooked through, 4 to 5 minutes total. Once done, transfer to a bowl or plate.",
      "secondary_message": null
    },
    {
      "id": 33993,
      "primary_message": "Once the meatballs have been transferred, add more olive oil to the pan, followed by the remaining onion and garlic. Cook, stirring frequently, until the onion is softened, 3 to 4 minutes.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 33994,
      "primary_message": "Add the diced tomatoes, tomato sauce, and spices to the pan. Return the meatballs to the pan, reduce the heat to medium-low and cook until the meatballs are cooked through and the sauce is slightly thickened, 6 to 8 minutes.",
      "secondary_message": "½ (398 ml) can diced tomatoes\n1 (213 ml) can tomato sauce\n¼ tsp salt\n¼ tsp black pepper\n½ tsp Italian seasoning"
    },
    {
      "id": 33995,
      "primary_message": "Finely grate ¼ cup of Parmesan.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 33996,
      "primary_message": "Add the spinach to the sauce and fold in until it is wilted. Remove pan from the heat.",
      "secondary_message": null
    },
    {
      "id": 33997,
      "primary_message": "To serve, divide pasta between bowls, spoon the sauce and meatballs over top, and sprinkle with the remaining parsley and grated Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
