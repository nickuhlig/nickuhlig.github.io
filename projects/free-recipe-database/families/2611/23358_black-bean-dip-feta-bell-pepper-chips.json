  "instructions": [
    {
      "id": 393599,
      "primary_message": "This recipe will make about 4 cups of bean dip. Work in batches to best fit your blender or food processor.",
      "secondary_message": null
    },
    {
      "id": 393600,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ jalapeño peppers\n1 ½ limes\n1 small bunch cilantro\n5 red bell peppers"
    },
    {
      "id": 393601,
      "primary_message": "Peel, halve, and mince onion. Peel and mince garlic. Place both in a small bowl.",
      "secondary_message": "½ medium red onion\n6 cloves garlic"
    },
    {
      "id": 393602,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 393603,
      "primary_message": "While the skillet heats up, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the onion and garlic. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 393604,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and jalapeño; cook, stirring occasionally, until softened, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 393605,
      "primary_message": "Meanwhile, juice limes into a blender.",
      "secondary_message": null
    },
    {
      "id": 393606,
      "primary_message": "Drain and rinse beans. Add to the blender along with water and spices.",
      "secondary_message": "3 (398 ml) cans black beans\n⅓ cup water\n1 ½ tsp cumin, ground\n¾ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 393607,
      "primary_message": "When the sautéed veggies are soft, add to the blender. Blend on high until semi-smooth, adding more water, 1-2 tablespoons at a time, if needed.",
      "secondary_message": null
    },
    {
      "id": 393608,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the blender and process once more until just combined. Set aside.",
      "secondary_message": null
    },
    {
      "id": 393609,
      "primary_message": "Cut bell peppers lengthwise into quarters; remove and discard the seeds and white membrane. Slice each quarter crosswise into 3-4 pieces to make the \"chips.\"",
      "secondary_message": null
    },
    {
      "id": 393610,
      "primary_message": "Divide black bean dip between plates and sprinkle with feta. Serve with bell pepper \"chips\" on the side.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
