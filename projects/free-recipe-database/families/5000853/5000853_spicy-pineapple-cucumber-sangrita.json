  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, combine pineapple juice, lime juice, cucumber juice, sugar, and chile powder. Stir until sugar is completely dissolved. Season very lightly with salt. Taste and adjust ingredients as desired. Chill in the refrigerator or by stirring with ice briefly and then straining. Serve in a shot glass alongside a good-quality silver tequila.",
      "secondary_message": null
    }
