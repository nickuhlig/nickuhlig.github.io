  "instructions": [
    {
      "id": 355982,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small butternut squash\n1 stick celery\n1 green bell pepper\n0.23 kg white mushrooms"
    },
    {
      "id": 355983,
      "primary_message": "Trim ends and peel squash. Halve lengthwise, scrape out seeds, and small dice the flesh; transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 355984,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355985,
      "primary_message": "While the pan heats up, peel and small dice onion. Trim and small dice celery.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 355986,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add onion and celery; cook, stirring occasionally, until veggies are softened, about 5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 355987,
      "primary_message": "Meanwhile, peel and mince garlic. Trim, seed, and small dice bell pepper.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 355988,
      "primary_message": "Add garlic and bell pepper to the pan; stir until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 355989,
      "primary_message": "Add diced squash, broth, tomatoes, and spices to the pan. Bring to a boil over high heat, stirring occasionally.",
      "secondary_message": "237 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n2 tsp paprika\n1 tsp chili powder\n1 tsp cumin, ground\n½ tsp nutmeg, ground\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 355990,
      "primary_message": "While the chili comes to a boil, thinly slice mushrooms; add to the pan.",
      "secondary_message": null
    },
    {
      "id": 355991,
      "primary_message": "Once the chili is boiling, reduce heat and simmer, stirring occasionally, until the squash is almost tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 355992,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355993,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and cook, stirring occasionally, until browned and cooked through, about 7 minutes. Remove from heat and set aside.",
      "secondary_message": "1 tbsp virgin coconut oil\n⅓ kg ground turkey"
    },
    {
      "id": 355994,
      "primary_message": "When the squash is almost tender, stir cooked turkey and any accumulated juices into the pan; continue to cook until squash is tender and the chili is heated through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 355995,
      "primary_message": "To serve, divide chili between bowls and enjoy!",
      "secondary_message": null
    }
  ],
