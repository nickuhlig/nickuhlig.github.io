  "instructions": [
    {
      "id": 356052,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n3 sticks celery\n3 green bell peppers\n0.68 kg white mushrooms"
    },
    {
      "id": 356053,
      "primary_message": "Trim ends and peel each squash; halve lengthwise, scrape out the seeds, and small dice the flesh. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 356054,
      "primary_message": "Trim and small dice celery. Peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 356055,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356056,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add celery and onion; cook, stirring occasionally, until veggies are soft, about 6 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 356057,
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 356058,
      "primary_message": "Add bell pepper and garlic to the pot. Continue to cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 356059,
      "primary_message": "Add diced squash, tomatoes, broth, tahini, and spices to the pot. Bring to a boil over high heat, stirring occasionally.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n710 ml chicken or vegetable broth\n3 tbsp tahini\n2 tbsp paprika\n1 tbsp chili powder\n1 tbsp cumin, ground\n1 ½ tsp nutmeg, ground\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 356060,
      "primary_message": "While the chili comes to a boil, thinly slice mushrooms and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 356061,
      "primary_message": "Once the chili is boiling, reduce heat and simmer, stirring occasionally, until the squash is almost tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 356062,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356063,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, stirring often, until browned and crumbly, 5-6 minutes. Remove from heat and set aside.",
      "secondary_message": "3 tbsp virgin coconut oil\n680 g veggie ground, plant based"
    },
    {
      "id": 356064,
      "primary_message": "When the squash is almost tender, add the cooked veggie ground to the pot and stir to combine. Continue to simmer until squash is tender and the chili is heated through, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 356065,
      "primary_message": "To serve, divide chili between bowls and enjoy!",
      "secondary_message": null
    }
  ],
