  "instructions": [
    {
      "id": 355996,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n2 sticks celery\n2 green bell peppers\n0.45 kg white mushrooms"
    },
    {
      "id": 355997,
      "primary_message": "Trim ends and peel squash. Halve lengthwise, scrape out seeds, and small dice the flesh; transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 355998,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355999,
      "primary_message": "While the pot heats up, peel and small dice onion. Trim and small dice celery.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 356000,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and celery; cook, stirring occasionally, until veggies are softened, about 5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 356001,
      "primary_message": "Meanwhile, peel and mince garlic. Trim, seed, and small dice bell peppers.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 356002,
      "primary_message": "Add garlic and bell pepper to the pot; stir until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 356003,
      "primary_message": "Add diced squash, broth, tomatoes, and spices to the pot. Bring to a boil over high heat, stirring occasionally.",
      "secondary_message": "473 ml chicken or vegetable broth\n2 (398 ml) cans diced tomatoes\n4 tsp paprika\n2 tsp chili powder\n2 tsp cumin, ground\n1 tsp nutmeg, ground\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356004,
      "primary_message": "While the chili comes to a boil, thinly slice mushrooms; add to the pot.",
      "secondary_message": null
    },
    {
      "id": 356005,
      "primary_message": "Once the chili is boiling, reduce heat and simmer, stirring occasionally, until the squash is almost tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 356006,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356007,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and cook, stirring occasionally, until browned and cooked through, about 7 minutes. Remove from heat and set aside.",
      "secondary_message": "2 tbsp virgin coconut oil\n0.68 kg ground turkey"
    },
    {
      "id": 356008,
      "primary_message": "When the squash is almost tender, stir cooked turkey and any accumulated juices into the pot; continue to cook until squash is tender and the chili is heated through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 356009,
      "primary_message": "To serve, divide chili between bowls and enjoy!",
      "secondary_message": null
    }
  ],
