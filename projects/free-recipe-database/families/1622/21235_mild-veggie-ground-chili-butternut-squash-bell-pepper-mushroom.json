  "instructions": [
    {
      "id": 355940,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small butternut squash\n1 stick celery\n1 green bell pepper\n½ lb white mushrooms"
    },
    {
      "id": 355941,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and small dice the flesh. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 355942,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355943,
      "primary_message": "While the pan heats up, trim and small dice celery. Peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 355944,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add celery and onion; cook, stirring occasionally, until veggies are soft, about 5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 355945,
      "primary_message": "Meanwhile, trim, seed, and small dice bell pepper. Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 355946,
      "primary_message": "Add bell pepper and garlic to the pan. Continue to cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 355947,
      "primary_message": "Add diced squash, tomatoes, broth, tahini, and spices to the pan. Bring to a boil over high heat, stirring occasionally.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth\n1 tbsp tahini\n2 tsp paprika\n1 tsp chili powder\n1 tsp cumin, ground\n½ tsp nutmeg, ground\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 355948,
      "primary_message": "While the chili comes to a boil, thinly slice mushrooms and add to the pan.",
      "secondary_message": null
    },
    {
      "id": 355949,
      "primary_message": "Once the chili is boiling, reduce heat and simmer, stirring occasionally, until the squash is almost tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 355950,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355951,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, stirring often, until browned and crumbly, 4-5 minutes. Remove from heat and set aside.",
      "secondary_message": "1 tbsp virgin coconut oil\n8 oz veggie ground, plant based"
    },
    {
      "id": 355952,
      "primary_message": "When the squash is almost tender, add the cooked veggie ground to the pan and stir to combine. Continue to simmer until squash is tender and the chili is heated through, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 355953,
      "primary_message": "To serve, divide chili between bowls and enjoy!",
      "secondary_message": null
    }
  ],
