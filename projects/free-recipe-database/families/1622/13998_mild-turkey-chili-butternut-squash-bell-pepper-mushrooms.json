  "instructions": [
    {
      "id": 355926,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n3 sticks celery\n3 green bell peppers\n1 ½ lb white mushrooms"
    },
    {
      "id": 355927,
      "primary_message": "Trim ends and peel each squash. Halve lengthwise, scrape out seeds, and small dice the flesh; transfer to a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 355928,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355929,
      "primary_message": "While the pot heats up, peel and small dice onions. Trim and small dice celery.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 355930,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and celery; cook, stirring occasionally, until veggies are softened, 5-6 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 355931,
      "primary_message": "Meanwhile, peel and mince garlic. Trim, seed, and small dice bell peppers.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 355932,
      "primary_message": "Add garlic and bell pepper to the pot; stir until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 355933,
      "primary_message": "Add diced squash, broth, tomatoes, and spices to the pot. Bring to a boil over high heat, stirring occasionally.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes\n2 tbsp paprika\n1 tbsp chili powder\n1 tbsp cumin, ground\n1 ½ tsp nutmeg, ground\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 355934,
      "primary_message": "While the chili comes to a boil, thinly slice mushrooms; add to the pot.",
      "secondary_message": null
    },
    {
      "id": 355935,
      "primary_message": "Once the chili is boiling, reduce heat and simmer, stirring occasionally, until the squash is almost tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 355936,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355937,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and cook, stirring occasionally, until browned and cooked through, about 8 minutes. Remove from heat and set aside.",
      "secondary_message": "3 tbsp virgin coconut oil\n2 ¼ lb ground turkey"
    },
    {
      "id": 355938,
      "primary_message": "When the squash is almost tender, stir cooked turkey and any accumulated juices into the pot; continue to cook until squash is tender and the chili is heated through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 355939,
      "primary_message": "To serve, divide chili between bowls and enjoy!",
      "secondary_message": null
    }
  ],
