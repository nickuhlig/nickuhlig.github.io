  "instructions": [
    {
      "id": 356038,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n2 sticks celery\n2 green bell peppers\n0.45 kg white mushrooms"
    },
    {
      "id": 356039,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds, and small dice the flesh. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 356040,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356041,
      "primary_message": "While the pot heats up, trim and small dice celery. Peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 356042,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add celery and onion; cook, stirring occasionally, until veggies are soft, about 5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 356043,
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 356044,
      "primary_message": "Add bell pepper and garlic to the pot. Continue to cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 356045,
      "primary_message": "Add diced squash, tomatoes, broth, tahini, and spices to the pot. Bring to a boil over high heat, stirring occasionally.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n473 ml chicken or vegetable broth\n2 tbsp tahini\n4 tsp paprika\n2 tsp chili powder\n2 tsp cumin, ground\n1 tsp nutmeg, ground\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 356046,
      "primary_message": "While the chili comes to a boil, thinly slice mushrooms and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 356047,
      "primary_message": "Once the chili is boiling, reduce heat and simmer, stirring occasionally, until the squash is almost tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 356048,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 356049,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, stirring often, until browned and crumbly, 4-5 minutes. Remove from heat and set aside.",
      "secondary_message": "2 tbsp virgin coconut oil\n454 g veggie ground, plant based"
    },
    {
      "id": 356050,
      "primary_message": "When the squash is almost tender, add the cooked veggie ground to the pot and stir to combine. Continue to simmer until squash is tender and the chili is heated through, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 356051,
      "primary_message": "To serve, divide chili between bowls and enjoy!",
      "secondary_message": null
    }
  ],
