  "instructions": [
    {
      "primary_message": "Roughly chop cranberries. Place half in a small bowl; transfer the other half to a plate and set aside.",
      "secondary_message": "⅓ cup dried cranberries"
    },
    {
      "primary_message": "Add goat cheese, cream cheese, and spices to the bowl with the cranberries. Use a fork to mash and combine the cheese mixture. ",
      "secondary_message": "1 (4 oz) log goat cheese\n½ (8 oz) block cream cheese\n⅛ tsp thyme, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Cut a 12-inch square of plastic wrap and place on a flat surface. ",
      "secondary_message": null
    },
    {
      "primary_message": "Using a silicone spatula, transfer cheese mixture to the center of the plastic wrap; bring the sides of the wrap up and around the mixture, shaping it into a ball using your hands. (Twist the ends of the plastic wrap to secure the ball.)",
      "secondary_message": null
    },
    {
      "primary_message": "Place cheese ball in the refrigerator to chill and firm up, about 30 minutes (or overnight if preparing ahead of time).",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, roughly chop pistachios. Add to the plate with the cranberries and stir to combine.",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "primary_message": "When the cheese ball is firm, unwrap and transfer to the plate with the cranberries and pistachios; roll to coat, gently pressing cranberries and pistachios into the ball. ",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer cheese ball to a serving dish, arranging the crackers around it. Enjoy!",
      "secondary_message": "1 (4.25 oz) pkg water crackers"
    }
  ],
