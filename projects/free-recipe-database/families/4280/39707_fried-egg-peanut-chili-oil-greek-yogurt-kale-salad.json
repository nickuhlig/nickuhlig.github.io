  "instructions": [
    {
      "id": 616173,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 616174,
      "primary_message": "While the pan heats up, roughly chop peanuts.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 616175,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add peanuts and cook, stirring occasionally, until golden brown, 4-5 minutes.",
      "secondary_message": "⅓ cup extra virgin olive oil"
    },
    {
      "id": 616176,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 616177,
      "primary_message": "When the peanuts are done, add garlic, honey, and spices to the pan, then stir to combine the peanut-chili oil. Remove from heat and cover to keep warm.",
      "secondary_message": "1 tbsp honey\n1 tbsp chili powder\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 616178,
      "primary_message": "Peel and mince shallot. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 616179,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": "1 ½ bunches kale"
    },
    {
      "id": 616180,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 616181,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 616182,
      "primary_message": "To serve, divide salad and yogurt between plates. Top yogurt with eggs and drizzle with peanut-chili oil. Enjoy!",
      "secondary_message": "2 cups plain Greek yogurt"
    }
  ],
