  "instructions": [
    {
      "primary_message": "Wash and dry grapes. Place in a blender. ",
      "secondary_message": "1 ½ lb green grapes"
    },
    {
      "primary_message": "Wash, dry, and juice lemon into the blender. Blend on high speed for several minutes until smooth.\n\n",
      "secondary_message": "½ lemon"
    },
    {
      "primary_message": "Pour grape purée into a strainer placed over a medium bowl. Using a silicone spatula, press pureé through the strainer to remove skins; discard skins.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide strained grape purée between 6 ice pop molds. Insert sticks and place in the freezer. Let chill until completely frozen, about 6 hours (or overnight).",
      "secondary_message": null
    },
    {
      "primary_message": "Once the ice pops are completely frozen, remove from the freezer. Let stand for 5 minutes before unmolding and serving. Enjoy!",
      "secondary_message": null
    }
