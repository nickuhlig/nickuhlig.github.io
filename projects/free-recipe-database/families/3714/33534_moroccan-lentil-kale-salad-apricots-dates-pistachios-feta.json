  "instructions": [
    {
      "id": 529305,
      "primary_message": "Using a strainer, rinse lentils under cold water, then drain and transfer to a medium saucepan; add water and salt. Cover and bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes. Drain, rinse under cold water to cool, and set aside.",
      "secondary_message": "1 ½ cups green lentils, dried\n6 cup water\n¾ tsp salt"
    },
    {
      "id": 529306,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ oranges\n3 bunches kale\n9 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 529307,
      "primary_message": "Juice oranges into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 529308,
      "primary_message": "Peel and mince garlic and shallots. Add both to the bowl with the orange juice along with oil, vinegar, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 shallots\n¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n1 tbsp pure maple syrup\n1 ½ tsp cumin, ground\n¾ tsp cinnamon, ground\n¾ tsp salt\n¾ tsp black pepper\n½ tsp cloves, ground"
    },
    {
      "id": 529309,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 529310,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 529311,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 529312,
      "primary_message": "Roughly chop pistachios, dates, and apricots. Add all three to the bowl.",
      "secondary_message": "1 cup pistachios, unsalted\n¾ cup medjool dates, pitted\n18 dried apricots"
    },
    {
      "id": 529313,
      "primary_message": "When the lentils are done, add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 529314,
      "primary_message": "To serve, divide salad between plates or bowls. Top with feta and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
