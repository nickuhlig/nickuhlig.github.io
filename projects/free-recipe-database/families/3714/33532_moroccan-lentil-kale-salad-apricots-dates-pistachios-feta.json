  "instructions": [
    {
      "id": 529285,
      "primary_message": "Using a strainer, rinse lentils under cold water, then drain and transfer to a small saucepan; add water and salt. Cover and bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes. Drain, rinse under cold water to cool, and set aside.",
      "secondary_message": "½ cup green lentils, dried\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 529286,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ orange\n1 bunch kale\n3 sticks celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 529287,
      "primary_message": "Juice orange into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 529288,
      "primary_message": "Peel and mince garlic and shallot. Add both to the bowl with the orange juice along with oil, vinegar, maple syrup, and spices. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n½ shallot\n1 ½ tbsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp pure maple syrup\n½ tsp cumin, ground\n¼ tsp cinnamon, ground\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp cloves, ground"
    },
    {
      "id": 529289,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 529290,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 529291,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 529292,
      "primary_message": "Roughly chop pistachios, dates, and apricots. Add all three to the bowl.",
      "secondary_message": "⅓ cup pistachios, unsalted\n¼ cup medjool dates, pitted\n6 dried apricots"
    },
    {
      "id": 529293,
      "primary_message": "When the lentils are done, add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 529294,
      "primary_message": "To serve, divide salad between plates or bowls. Top with feta and enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
