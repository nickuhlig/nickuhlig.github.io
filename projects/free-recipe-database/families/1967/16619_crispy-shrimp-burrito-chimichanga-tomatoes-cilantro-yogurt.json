  "instructions": [
    {
      "id": 271359,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 jalapeño pepper\n½ small bunch cilantro\n2 tomatoes"
    },
    {
      "id": 271360,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 271361,
      "primary_message": "Trim, seed, and slice bell pepper into thin strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 271362,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 271363,
      "primary_message": "Peel and mince garlic; peel, halve, and small dice onion. Add both to the bowl.",
      "secondary_message": "2 cloves garlic\n½ medium yellow onion"
    },
    {
      "id": 271364,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 271365,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, jalapeño, garlic, and onion; cook, stirring occasionally, until veggies soften, 4-5 minutes. (Reserve bowl for next step.)",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 271366,
      "primary_message": "Meanwhile, coarsely grate cheddar; cut cream cheese into small pieces. Place cheeses in the reserved bowl and set aside.",
      "secondary_message": "¼ (8 oz) block cheddar cheese\n¼ (8 oz) block cream cheese"
    },
    {
      "id": 271367,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 271368,
      "primary_message": "Add shrimp, half of the cilantro (reserve remaining cilantro for garnish), and spices to the skillet; cook until shrimp are opaque, 1-2 minutes per side.",
      "secondary_message": "½ tsp chili powder\n¼ tsp cumin, ground\n¼ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 271369,
      "primary_message": "Reduce heat to low and add the cheeses. Continue to cook, stirring occasionally, until cheeses melt and combine, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271370,
      "primary_message": "Place tortillas on a flat surface and divide shrimp filling down the center of each one. Fold in sides of tortillas and roll tightly to complete.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 271371,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271372,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Lay burritos, seam-side down, and cook, rotating every 2-3 minutes, until golden brown and crispy on all sides. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 271373,
      "primary_message": "Meanwhile, medium dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 271374,
      "primary_message": "To serve, cut burritos in half and divide between plates. Top with tomatoes, reserved cilantro, and yogurt. Enjoy!",
      "secondary_message": "⅛ cup plain Greek yogurt"
    }
  ],
