  "instructions": [
    {
      "id": 271391,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 jalapeño peppers\n1 small bunch cilantro\n6 tomatoes"
    },
    {
      "id": 271392,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 271393,
      "primary_message": "Trim, seed, and slice bell peppers into thin strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 271394,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 271395,
      "primary_message": "Peel and mince garlic; peel and small dice onions. Add both to the bowl.",
      "secondary_message": "6 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 271396,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 271397,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, jalapeño, garlic, and onion; cook, stirring occasionally, until veggies soften, 5-6 minutes. (Reserve bowl for next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 271398,
      "primary_message": "Meanwhile, coarsely grate cheddar; cut cream cheese into small pieces. Place cheeses in the reserved bowl and set aside.",
      "secondary_message": "¾ (8 oz) block cheddar cheese\n¾ (8 oz) block cream cheese"
    },
    {
      "id": 271399,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 271400,
      "primary_message": "Add shrimp, half of the cilantro (reserve remaining cilantro for garnish), and spices to the pot; cook, stirring often, until shrimp are opaque, about 4 minutes.",
      "secondary_message": "1 ½ tsp chili powder\n¾ tsp cumin, ground\n¾ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 271401,
      "primary_message": "Reduce heat to low and add the cheeses. Continue to cook, stirring occasionally, until cheeses melt and combine, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 271402,
      "primary_message": "Place tortillas on a flat surface and divide shrimp filling down the center of each one. Fold in sides of tortillas and roll tightly to complete.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 271403,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 271404,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, lay burritos, seam-side down, and cook, rotating every 2-3 minutes, until golden brown and crispy on all sides. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 271405,
      "primary_message": "Meanwhile, medium dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 271406,
      "primary_message": "To serve, cut burritos in half and divide between plates. Top with tomatoes, reserved cilantro, and yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
