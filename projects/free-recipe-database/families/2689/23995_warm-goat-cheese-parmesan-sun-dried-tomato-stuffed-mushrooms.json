  "instructions": [
    {
      "id": 428302,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 428303,
      "primary_message": "Wash and dry mushrooms; remove stems and set aside for the next step. Transfer mushroom caps to a baking sheet pan, drizzle with oil, and turn to coat. Arrange mushrooms, top-side down, and set aside.",
      "secondary_message": "½ lb cremini mushrooms\n1 tsp extra virgin olive oil"
    },
    {
      "id": 428304,
      "primary_message": "Mince mushroom stems. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 428305,
      "primary_message": "Peel and mince garlic. Add to the bowl with the minced mushroom stems.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 428306,
      "primary_message": "Mince sun-dried tomatoes. Add to the bowl.",
      "secondary_message": "2 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 428307,
      "primary_message": "Crumble goat cheese into the bowl.",
      "secondary_message": "½ (4 oz) log goat cheese"
    },
    {
      "id": 428308,
      "primary_message": "Add Parmesan and spices to the bowl. Mash with a fork or the back of a spoon to combine. Divide the filling between mushroom caps, gently pressing it into each cavity.",
      "secondary_message": "¼ cup Parmesan cheese, shredded\n¼ tsp Italian seasoning\n⅛ tsp crushed red pepper\n1 pinch salt"
    },
    {
      "id": 428309,
      "primary_message": "Place mushrooms in the oven; bake until tender and cheese filling is warm and golden on top, 15-20 minutes depending on size of the mushrooms. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 428310,
      "primary_message": "To serve, divide warm stuffed mushrooms between plates and enjoy!",
      "secondary_message": null
    }
  ],
