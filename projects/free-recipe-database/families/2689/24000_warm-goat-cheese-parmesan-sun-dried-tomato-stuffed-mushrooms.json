  "instructions": [
    {
      "id": 428347,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 428348,
      "primary_message": "Wash and dry mushrooms; remove stems and set aside for the next step. Transfer mushroom caps to a large baking sheet pan, drizzle with oil, and turn to coat. Arrange mushrooms, top-side down, and set aside.",
      "secondary_message": "0.68 kg cremini mushrooms\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 428349,
      "primary_message": "Mince mushroom stems. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 428350,
      "primary_message": "Peel and mince garlic. Add to the bowl with the minced mushroom stems.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 428351,
      "primary_message": "Mince sun-dried tomatoes. Add to the bowl.",
      "secondary_message": "6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 428352,
      "primary_message": "Crumble goat cheese into the bowl.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 428353,
      "primary_message": "Add Parmesan and spices to the bowl. Mash with a fork or the back of a spoon to combine. Divide the filling between mushroom caps, gently pressing it into each cavity.",
      "secondary_message": "½ cup Parmesan cheese, shredded\n¾ tsp Italian seasoning\n¼ tsp crushed red pepper\n3 pinch salt"
    },
    {
      "id": 428354,
      "primary_message": "Place mushrooms in the oven; bake until tender and cheese filling is warm and golden on top, 15-20 minutes depending on size of the mushrooms. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 428355,
      "primary_message": "To serve, divide warm stuffed mushrooms between plates and enjoy!",
      "secondary_message": null
    }
  ],
