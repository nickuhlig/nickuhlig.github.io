  "instructions": [
    {
      "id": 467579,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467580,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 467581,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 467582,
      "primary_message": "Meanwhile wash, dry, zest, and juice half of the lemon into a medium bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 467583,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 467584,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the dressing.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 467585,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 467586,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and gently toss to combine the salad.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 467587,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 467588,
      "primary_message": "Divide steak and salad between plates or bowls. Serve with lemon wedges for squeezing over the steak. Enjoy!",
      "secondary_message": null
    }
  ],
