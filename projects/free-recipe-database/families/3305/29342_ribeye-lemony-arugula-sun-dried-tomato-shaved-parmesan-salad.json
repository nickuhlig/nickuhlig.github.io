  "instructions": [
    {
      "id": 467559,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 467560,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 467561,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 467562,
      "primary_message": "Meanwhile wash, dry, zest, and juice one lemon into a medium bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": "2 lemons"
    },
    {
      "id": 467563,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 467564,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the bowl with the dressing.",
      "secondary_message": "8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 467565,
      "primary_message": "Wash and dry arugula (skip this step if it came pre-washed). Add to the bowl.",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 467566,
      "primary_message": "Using a peeler, shave Parmesan into curls. Add to the bowl and gently toss to combine the salad.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 467567,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 467568,
      "primary_message": "Divide steak and salad between plates or bowls. Serve with lemon wedges for squeezing over the steak. Enjoy!",
      "secondary_message": null
    }
  ],
