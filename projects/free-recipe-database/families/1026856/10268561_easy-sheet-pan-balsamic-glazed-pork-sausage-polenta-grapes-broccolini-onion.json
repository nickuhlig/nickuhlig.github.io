  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "907 g red grapes\n3 small bunch broccolini\n1 small pkg fresh rosemary"
    },
    {
      "primary_message": "Halve polenta lengthwise, then cut crosswise into 1/2-inch thick half-moons. Separate grapes into small clusters. Divide both between two large baking sheet pans along with the broccolini.",
      "secondary_message": "2 (510 g) tube polenta, pre-cooked"
    },
    {
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Add to the baking sheets with the polenta. ",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and slice onions lengthwise into 1/2-inch thick strips. Peel and thinly slice garlic. Add both to the baking sheets, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 clove garlic\n¼ cup extra virgin olive oil\n2 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Cut several shallow slits into each sausage, then add to the baking sheets, nestling them into the polenta, grapes, and broccolini.",
      "secondary_message": null
    },
    {
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until grapes are starting to burst and sausages are cooked through, 45-50 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide polenta, grapes, broccolini, and sausages between plates. Drizzle with balsamic glaze and enjoy!",
      "secondary_message": "⅓ cup balsamic glaze"
    }
  ],
