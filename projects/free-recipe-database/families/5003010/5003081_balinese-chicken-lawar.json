  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and quarter the shallot. Peel the garlic. Chop the fresh turmeric. Chop the lemongrass. Cut the green beans into 1-inch pieces. Lightly beat the eggs. Finely slice the makrut lime leaves.",
      "secondary_message": "1 medium shallot\n2 medium cloves garlic\n1 (1 ½ cm) piece fresh turmeric\n1 (1 ½ cm) piece lemongrass\n227 g green beans\n2 large eggs\n2 makrut lime leaves"
    },
    {
      "id": 1,
      "primary_message": "For the sambal: Place all the ingredients for the sambal in a food processor and process until mixture forms a paste, about 30 seconds; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the lawar: In medium saucepan, bring 4 cups water to boil. Cook beans to crisp tender, about 5 minutes. Transfer to large bowl to cool.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat 2 teaspoons oil in 30-cm nonstick skillet over medium heat until shimmering. Pour in beaten eggs and swirl to coat entire bottom of pan with a thin layer of egg. Cover and cook until just cooked through (top won't look wet), 30 seconds to a minute. Slide the egg omelette onto cutting board. When cool, roll up into a log. Cut the log in half lengthwise, then cut into 2.5-cm strips.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In same skillet, heat remaining oil over medium heat until shimmering. Add sambal and makrut lime leaves and cook until fragrant, about 1 minute. Add chicken and cook, breaking up into small pieces, until almost cooked through, about 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour in chicken broth, coconut milk, and salt. Simmer until liquid is slightly thickened and gently coats chicken. Transfer to large bowl with the cooked green beans and gently toss with the egg and coconut.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Transfer to serving bowl, top with crispy shallots, and serve with steamed rice.",
      "secondary_message": null
    }
  ],
