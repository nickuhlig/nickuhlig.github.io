  "instructions": [
    {
      "id": 549213,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 549214,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n0.23 kg cremini mushrooms\n½ lime"
    },
    {
      "id": 549215,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. Transfer to a plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tsp neutral vegetable oil\n227 g veggie ground, plant based\n¼ tsp coriander, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 549216,
      "primary_message": "Meanwhile, fill a medium saucepan about halfway with hot water (from the tap), cover, and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 549217,
      "primary_message": "While the water comes to a boil, trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 549218,
      "primary_message": "Once the water is boiling, add soba noodles and cook until tender, about 5 minutes (or cook according to package instructions). Drain and rinse in a colander; set aside.",
      "secondary_message": "142 g soba (buckwheat) noodles"
    },
    {
      "id": 549219,
      "primary_message": "Meanwhile, thinly slice mushrooms. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 549220,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat, add more oil, and swirl to coat the bottom. Add cabbage and mushrooms; cook, stirring occasionally, until vegetables are tender, 6-7 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 549221,
      "primary_message": "While the vegetables are cooking, juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 549222,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with soy sauce, honey, pepper, and salt. Whisk to combine the sauce.",
      "secondary_message": "2 cloves garlic\n1 tbsp soy sauce\n1 tbsp honey\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 549223,
      "primary_message": "When the vegetables are tender, return veggie ground to the skillet along with drained noodles and sauce. Continue to cook, tossing occasionally, until noodles are warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 549224,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
