  "instructions": [
    {
      "id": 549273,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 549274,
      "primary_message": "While the pot heats up, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n0.68 kg cremini mushrooms\n1 ½ limes"
    },
    {
      "id": 549275,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. Transfer to a plate. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "2 tbsp neutral vegetable oil\n680 g veggie ground, plant based\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 549276,
      "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 549277,
      "primary_message": "While the water comes to a boil, trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 549278,
      "primary_message": "Once the water is boiling, add soba noodles and cook until tender, about 5 minutes (or cook according to package instructions). Drain and rinse in a colander; set aside.",
      "secondary_message": "425 g soba (buckwheat) noodles"
    },
    {
      "id": 549279,
      "primary_message": "Meanwhile, thinly slice mushrooms. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 549280,
      "primary_message": "Return pot (with cooking juices) to medium-high heat, add more oil, and swirl to coat the bottom. Add cabbage and mushrooms; cook, stirring occasionally, until vegetables are tender, 7-8 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 549281,
      "primary_message": "While the vegetables are cooking, juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 549282,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with soy sauce, maple syrup, pepper, and salt. Whisk to combine the sauce.",
      "secondary_message": "6 cloves garlic\n3 tbsp soy sauce\n3 tbsp pure maple syrup\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 549283,
      "primary_message": "When the vegetables are tender, return veggie ground to the pot along with drained noodles and sauce. Continue to cook, tossing occasionally, until noodles are warmed through, about 3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 549284,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
