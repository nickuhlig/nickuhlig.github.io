  "instructions": [
    {
      "id": 548973,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 548974,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n1 lb cremini mushrooms\n1 lime"
    },
    {
      "id": 548975,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. Transfer to a plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "4 tsp neutral vegetable oil\n1 ½ lb ground turkey\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 548976,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 548977,
      "primary_message": "While the water comes to a boil, trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 548978,
      "primary_message": "Once the water is boiling, add soba noodles and cook until tender, about 5 minutes (or cook according to package instructions). Drain and rinse in a colander; set aside.",
      "secondary_message": "10 oz soba (buckwheat) noodles"
    },
    {
      "id": 548979,
      "primary_message": "Meanwhile, thinly slice mushrooms. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 548980,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat, add more oil, and swirl to coat the bottom. Add cabbage and mushrooms; cook, stirring occasionally, until veggies are tender, 6-7 minutes.",
      "secondary_message": "4 tsp neutral vegetable oil"
    },
    {
      "id": 548981,
      "primary_message": "While the veggies are cooking, juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 548982,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with soy sauce, honey, pepper, and salt. Whisk to combine the sauce.",
      "secondary_message": "4 cloves garlic\n2 tbsp soy sauce\n2 tbsp honey\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 548983,
      "primary_message": "When the veggies are tender, return turkey to the skillet along with drained noodles and sauce. Continue to cook, tossing occasionally, until noodles are warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 548984,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "4 tsp sesame seeds"
    }
  ],
