  "instructions": [
    {
      "id": 549201,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 549202,
      "primary_message": "While the pot heats up, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n0.68 kg cremini mushrooms\n1 ½ limes"
    },
    {
      "id": 549203,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. Transfer to a plate. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "2 tbsp neutral vegetable oil\n1.02 kg ground turkey\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 549204,
      "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap), cover, and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 549205,
      "primary_message": "While the water comes to a boil, trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 549206,
      "primary_message": "Once the water is boiling, add soba noodles and cook until tender, about 5 minutes (or cook according to package instructions). Drain and rinse in a colander; set aside.",
      "secondary_message": "425 g soba (buckwheat) noodles"
    },
    {
      "id": 549207,
      "primary_message": "Meanwhile, thinly slice mushrooms. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 549208,
      "primary_message": "Return pot (with cooking juices) to medium-high heat, add more oil, and swirl to coat the bottom. Add cabbage and mushrooms; cook, stirring occasionally, until veggies are tender, 7-8 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 549209,
      "primary_message": "While the veggies are cooking, juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 549210,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime juice along with soy sauce, honey, pepper, and salt. Whisk to combine the sauce.",
      "secondary_message": "6 cloves garlic\n3 tbsp soy sauce\n3 tbsp honey\n¾ tsp black pepper\n½ tsp salt"
    },
    {
      "id": 549211,
      "primary_message": "When the veggies are tender, return turkey to the pot along with drained noodles and sauce. Continue to cook, tossing occasionally, until noodles are warmed through, about 3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 549212,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
