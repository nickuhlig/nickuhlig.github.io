  "instructions": [
    {
      "id": 139210,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 jalapeño pepper\n1 red bell pepper\n1 avocado\n½ small bunch cilantro"
    },
    {
      "id": 139211,
      "primary_message": "Heat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 139212,
      "primary_message": "Peel and mince the garlic and shallot. Peel and mince or grate the ginger. ",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 139213,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 139214,
      "primary_message": "Add the garlic, shallot, and ginger to the pot and cook, stirring occasionally, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 139215,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 139216,
      "primary_message": "Small dice the bell pepper. Add the jalapeño, bell pepper, curry powder, and salt to the pot. Cook, stirring occasionally, 2-3 minutes. ",
      "secondary_message": "½ tsp curry powder\n½ tsp salt"
    },
    {
      "id": 139217,
      "primary_message": "Add the diced tomatoes, coconut milk, and broth to the pot. Stir and bring to a boil over high heat, then add the red lentils. Reduce heat to medium-low and cook, stirring occasionally, until lentils are tender, 22-25 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n½ (398 ml) can coconut milk\n237 ml chicken or vegetable broth\n½ cup red lentils"
    },
    {
      "id": 139218,
      "primary_message": "Meanwhile, halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 139219,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 139220,
      "primary_message": "To serve, divide the lentil curry between bowls; top with sliced avocado and minced cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
