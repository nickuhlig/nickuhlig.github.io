  "instructions": [
    {
      "id": 423150,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 423151,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and spices; cook, stirring occasionally, until the mushrooms soften, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 (227g ) pkg sliced white mushrooms\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 423152,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in a medium bowl; whisk to combine and set aside.",
      "secondary_message": "6 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 423153,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise.",
      "secondary_message": "½ small pkg grape tomatoes"
    },
    {
      "id": 423154,
      "primary_message": "When the mushrooms are soft, add tomatoes and peas to the skillet. Continue to cook, stirring occasionally, until tomatoes soften and peas are warmed through, 1-2 minutes more.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 423155,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 423156,
      "primary_message": "Reduce heat to medium-low and pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 423157,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": "½ cup shredded cheese, Italian blend"
    },
    {
      "id": 423158,
      "primary_message": "Meanwhile, wash and dry the spinach (skip this step if it came pre-washed).",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 423159,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Add spinach to the plate, drizzle with dressing, and top with cranberries. Enjoy!",
      "secondary_message": "3 tbsp honey mustard dressing\n⅛ cup dried cranberries"
    }
  ],
