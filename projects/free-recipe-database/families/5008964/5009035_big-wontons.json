  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the ginger. Mince the chives.",
      "secondary_message": "1 tsp ginger\n1 bunch chives, about 2 cups"
    },
    {
      "id": 1,
      "primary_message": "Mix all the ingredients for the filling in a bowl. Using your hands or a wooden spoon, vigorously stir the mixture around in the bowl and let sit for 1 hour to allow the flavors to sink in and the meat to bind.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fill each wonton wrapper with about a 1 teaspoon of the filling. Leftover filling may be frozen and put to use in more wontons, or stir-fried.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To boil wontons, bring a pot of water to boil and cook the wontons for 3 to 4 minutes, until the skins are just beginning to turn translucent. Serve in soup or with dipping sauce. To pan-fry wontons, boil the wontons for 2 minutes. Bring a heavy skillet to medium heat and add a tablespoon of oil. Pan-fry on one or two sides. Refrain from moving the wontons around in the pan, so as to give the surface of the wontons a chance to brown.",
      "secondary_message": null
    }
  ],
