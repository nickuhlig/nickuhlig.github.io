  "instructions": [
    {
      "id": 627202,
      "primary_message": "Wash, dry, and thinly slice mushrooms. Place in a medium bowl and set aside.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 627203,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 627204,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 627205,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp thyme, dried\n¾ tsp smoked paprika\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 627206,
      "primary_message": "When the onion is softened, add mushrooms to the pot. Cook, stirring occasionally, until mushrooms are tender, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 627207,
      "primary_message": "While the mushrooms are cooking, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 627208,
      "primary_message": "When the mushrooms are tender, add tomato paste to the pot. Continue to cook, stirring frequently, until fragrant, 2-3 minutes more.",
      "secondary_message": "3 tbsp tomato paste"
    },
    {
      "id": 627209,
      "primary_message": "Add beans, tomatoes, broth, and cream to the pot. Stir to combine bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until sauce has thickened, 5-6 minutes. Remove from heat.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth\n12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 627210,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 627211,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until lightly toasted, 1-2 minutes. Remove from oven and cut in half. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices sourdough bread"
    },
    {
      "id": 627212,
      "primary_message": "Divide sauté between plates or bowls. Serve with toast on the side and enjoy!",
      "secondary_message": null
    }
  ],
