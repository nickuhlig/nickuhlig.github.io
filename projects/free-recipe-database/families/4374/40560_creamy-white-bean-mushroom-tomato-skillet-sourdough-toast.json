  "instructions": [
    {
      "id": 627213,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 627214,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 627215,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp thyme, dried\n¼ tsp smoked paprika\n¼ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 627216,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms.",
      "secondary_message": "0.23 kg cremini mushrooms"
    },
    {
      "id": 627217,
      "primary_message": "When the onion is softened, add mushrooms to the skillet. Cook, stirring occasionally, until mushrooms are tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 627218,
      "primary_message": "While the mushrooms are cooking, drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 627219,
      "primary_message": "When the mushrooms are tender, add tomato paste to the skillet. Continue to cook, stirring frequently, until fragrant, 1-2 minutes more.",
      "secondary_message": "1 tbsp tomato paste"
    },
    {
      "id": 627220,
      "primary_message": "Add beans, tomatoes, broth, and cream to the skillet. Stir to combine bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until sauce has thickened, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n118 ml (½ cup) chicken or vegetable broth\n118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 627221,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 627222,
      "primary_message": "Arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until lightly toasted, 1-2 minutes. Remove from oven and cut in half. (Alternatively, you can use a toaster.)",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 627223,
      "primary_message": "Divide skillet between plates or bowls. Serve with toast on the side and enjoy!",
      "secondary_message": null
    }
  ],
