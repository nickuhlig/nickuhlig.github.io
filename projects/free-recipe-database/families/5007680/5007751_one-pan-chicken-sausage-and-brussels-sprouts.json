  "instructions": [
    {
      "id": 1,
      "primary_message": "Position rack in lower third of oven and preheat to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a 30-cm cast iron skillet, combine Brussels sprouts, shallots, and lemon with 2 tablespoons oil. (Alternatively, you can use a rimmed baking sheet.) Season to taste with salt and pepper and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, combine garlic, mustard, honey, Worcestershire sauce, rosemary, and remaining 1 tablespoon oil. Season with salt and pepper and stir to form a paste. Rub paste all over chicken. Nestle chicken and sausage pieces on top of Brussels sprouts.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Roast on lower rack until Brussels sprouts are browned and tender and an instant-read thermometer inserted into coolest part of the chicken registers at least 74°C, 25 to 30 minutes. (If chicken and sausage are done before sprouts have browned enough, you can transfer the meat to a plate and let the vegetables finish in the oven; recombine before serving.) Serve.",
      "secondary_message": null
    }
  ],
