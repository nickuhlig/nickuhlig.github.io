  "instructions": [
    {
      "id": 149827,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 149828,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 medium zucchini squash\n½ crown broccoli\n½ lemon\n½ small pkg fresh thyme"
    },
    {
      "id": 149829,
      "primary_message": "Seed and slice bell pepper crosswise into rounds; add to a baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 149830,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into half rounds; add to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 149831,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; add to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 149832,
      "primary_message": "Peel and slice onion into rings; add to the baking sheet. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 149833,
      "primary_message": "Heat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 149834,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 149835,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 149836,
      "primary_message": "Add chicken to the skillet and cook on one side until golden brown, about 5 minutes. Flip and cook for an additional 1 minute then remove from heat (the chicken will not be cooked all the way through). ",
      "secondary_message": null
    },
    {
      "id": 149837,
      "primary_message": "Meanwhile, zest and juice lemon over the vegetables. Slide thyme leaves off the stems; discard the stems and sprinkle the leaves over the vegetables.",
      "secondary_message": null
    },
    {
      "id": 149838,
      "primary_message": "Peel and mince the garlic. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 149839,
      "primary_message": "Transfer chicken to the baking sheet with the vegetables; arrange chicken, golden brown-side facing up, over the vegetables; set aside.",
      "secondary_message": null
    },
    {
      "id": 149840,
      "primary_message": "Return the skillet to medium heat, deglaze by adding water and scraping up any browned bits from the bottom of the skillet. Add garlic, salt, and pepper to the skillet and stir to combine.",
      "secondary_message": "2 tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 149841,
      "primary_message": "Pour the skillet sauce over the chicken and vegetables, then place in the oven. Bake, tossing the chicken and vegetables halfway through, until tender and cooked through, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 149842,
      "primary_message": "To serve, divide chicken and roasted vegetables between plates and enjoy! ",
      "secondary_message": null
    }
  ],
