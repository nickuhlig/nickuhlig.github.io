  "instructions": [
    {
      "id": 149891,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 149892,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 medium zucchini squash\n1 crown broccoli\n1 lemon\n1 small pkg fresh thyme"
    },
    {
      "id": 149893,
      "primary_message": "Seed and slice bell peppers crosswise into rounds; divide between two baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 149894,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into half rounds; add to the baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 149895,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces; add to the baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 149896,
      "primary_message": "Peel and slice onion into rings; add to the baking sheets. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 149897,
      "primary_message": "Heat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 149898,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 149899,
      "primary_message": "Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 149900,
      "primary_message": "Add chicken to the skillet and cook on one side until golden brown, about 5 minutes. Flip and cook for an additional 1 minute then remove from heat (the chicken will not be cooked all the way through). ",
      "secondary_message": null
    },
    {
      "id": 149901,
      "primary_message": "Meanwhile, zest and juice lemon over the vegetables. Slide thyme leaves off the stems; discard the stems and sprinkle the leaves over the vegetables.",
      "secondary_message": null
    },
    {
      "id": 149902,
      "primary_message": "Peel and mince the garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 149903,
      "primary_message": "Transfer chicken to the baking sheets with the vegetables; arrange chicken, golden brown-side facing up, over the vegetables on both baking sheets; set aside.",
      "secondary_message": null
    },
    {
      "id": 149904,
      "primary_message": "Return the skillet to medium heat, deglaze by adding water and scraping up any browned bits from the bottom of the skillet. Add garlic, salt, and pepper to the skillet and stir to combine.",
      "secondary_message": "¼ cup water\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 149905,
      "primary_message": "Pour the skillet sauce over the chicken and vegetables, then place in the oven. Bake, tossing the chicken and vegetables halfway through, until tender and cooked through, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 149906,
      "primary_message": "To serve, divide chicken and roasted vegetables between plates and enjoy! ",
      "secondary_message": null
    }
  ],
