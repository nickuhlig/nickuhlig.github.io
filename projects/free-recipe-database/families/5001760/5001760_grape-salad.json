  "instructions": [
    {
      "id": 1,
      "primary_message": "In a medium skillet, toast almonds over medium heat, stirring often, until aromatic and just starting to brown, 3 to 5 minutes. Transfer to a bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, vigorously whisk and beat the cream cheese, yogurt, granulated sugar, and vanilla extract until smooth and combined, scraping down sides of bowl as needed, about 3 minutes. (Alternatively, use a handheld electric mixer to beat the ingredients.)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Gently fold in grapes, 1 cup almonds, and 1/4 cup of the mint until evenly incorporated.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer grape salad to a platter. Garnish with brown sugar, remaining 1/4 cup almonds, and remaining 1/4 cup mint.",
      "secondary_message": null
    }
  ],
