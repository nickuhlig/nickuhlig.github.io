  "instructions": [
    {
      "id": 500059,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons\n3 tomatoes\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 500060,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between a large and a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 500061,
      "primary_message": "Peel and mince garlic. Divide between the bowls. (Set the medium bowl aside for later use.)",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 500062,
      "primary_message": "Zest lemons into the large bowl (reserve lemons for later use). Add pork, eggs, almond flour, capers, salt, and pepper to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "2 ¼ lb lean ground pork\n3 eggs\n½ cup almond meal/flour\n6 tbsp capers\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 500063,
      "primary_message": "Using a ¼-cup measure, form the pork mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 500064,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 500065,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 500066,
      "primary_message": "Meanwhile, juice the reserved lemons into the medium bowl with the parsley and garlic. Add yogurt, salt, and pepper, then stir to combine the yogurt sauce.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 500067,
      "primary_message": "Transfer ⅓ of the yogurt sauce to a clean large bowl, add oil, and whisk to combine the dressing. (Reserve remaining yogurt sauce for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 500068,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 500069,
      "primary_message": "Divide fritters and salad between plates. Serve with remaining yogurt sauce on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
