  "instructions": [
    {
      "id": 500081,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n1 lemon\n2 tomatoes\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 500082,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Divide between a medium and a small bowl.",
      "secondary_message": null
    },
    {
      "id": 500083,
      "primary_message": "Peel and mince garlic. Divide between the bowls. (Set the small bowl aside for later use.)",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 500084,
      "primary_message": "Zest lemon into the medium bowl (reserve lemon for later use). Add pork, eggs, almond flour, capers, salt, and pepper to the bowl. Using your hands, mix well to combine.",
      "secondary_message": "0.68 kg lean ground pork\n2 eggs\n⅓ cup almond meal/flour\n4 tbsp capers\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 500085,
      "primary_message": "Using a ¼-cup measure, form the pork mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 500086,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 500087,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 500088,
      "primary_message": "Meanwhile, juice the reserved lemon into the small bowl with the parsley and garlic. Add yogurt, salt, and pepper, then stir to combine the yogurt sauce.",
      "secondary_message": "1 cup plain Greek yogurt\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 500089,
      "primary_message": "Transfer ⅓ of the yogurt sauce to a clean medium bowl, add oil, and whisk to combine the dressing. (Reserve remaining yogurt sauce for serving.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 500090,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl with the dressing, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 500091,
      "primary_message": "Divide fritters and salad between plates. Serve with remaining yogurt sauce on the side for dipping and enjoy!",
      "secondary_message": null
    }
  ],
