  "instructions": [
    {
      "id": 79513,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 ½ English cucumbers\n3 lemons\n1 ½ small bunches Italian (flat-leaf) parsley"
    },
    {
      "id": 79514,
      "primary_message": "Cut the tomatoes and cucumbers into ¼-inch cubes and transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 79515,
      "primary_message": "Shave leaves off the parsley stems; discard the stems and mince the leaves. Add to the salad bowl with the cucumber and tomatoes to make the salad.",
      "secondary_message": null
    },
    {
      "id": 79516,
      "primary_message": "Juice the lemon, add half of the juice to the salad and put the other half aside in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 79517,
      "primary_message": "Add oil, salt, and pepper to the salad; stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 79518,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 79519,
      "primary_message": "Combine oil, cumin, paprika, salt, pepper, crushed red pepper, and two thirds of the garlic in an another medium bowl to make the marinade.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp cumin\n1 tbsp paprika\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 79520,
      "primary_message": "Peel and small dice the onion; transfer to the marinade bowl with the oil and spices.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 79521,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 79522,
      "primary_message": "While the pan heats up, pat the beef dry with paper towels, then cut into 1-inch chunks. Add to the bowl with the marinade; stir until well combined.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 79523,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add beef mixture. Cook, stirring occasionally, until onions are soft and beef is cooked through, 4-6 minutes. Cook in batches if necessary.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 79524,
      "primary_message": "Toast pita bread if desired.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 79525,
      "primary_message": "To the remaining lemon juice, add yogurt, salt, and one-third of the garlic. Whisk to make the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 ½ tsp salt"
    },
    {
      "id": 79526,
      "primary_message": "To serve, place pita bread on a plate and top with beef, salad, and yogurt dressing. Enjoy!",
      "secondary_message": null
    }
  ],
