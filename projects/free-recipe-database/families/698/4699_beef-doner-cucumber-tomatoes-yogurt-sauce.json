  "instructions": [
    {
      "id": 79499,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 tomatoes\n1 English cucumber\n2 lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 79500,
      "primary_message": "Cut the tomatoes and cucumbers into ¼-inch cubes and transfer to a medium salad bowl.",
      "secondary_message": null
    },
    {
      "id": 79501,
      "primary_message": "Shave leaves off the parsley stems; discard the stems and mince the leaves. Add to the medium salad bowl with the cucumber and tomatoes to make the salad.",
      "secondary_message": null
    },
    {
      "id": 79502,
      "primary_message": "Juice the lemon, add half of the juice to the salad and put the other half aside in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 79503,
      "primary_message": "Add oil, salt, and pepper to the salad; stir to combine.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 79504,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 79505,
      "primary_message": "Combine oil, cumin, paprika, salt, pepper, crushed red pepper, and two thirds of the garlic in an another medium bowl to make the marinade.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp cumin\n2 tsp paprika\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 79506,
      "primary_message": "Peel and small dice the onion; transfer to the marinade bowl with the oil and spices.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 79507,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 79508,
      "primary_message": "While the pan heats up, pat the beef dry with paper towels, then cut into 1-inch chunks. Add to the bowl with the marinade; stir until well combined.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak"
    },
    {
      "id": 79509,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add beef mixture. Cook, stirring occasionally, until onions are soft and beef is cooked through, 4-6 minutes.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 79510,
      "primary_message": "Toast pita bread if desired.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 79511,
      "primary_message": "To the remaining lemon juice, add yogurt, salt, and one-third of the garlic. Whisk to make the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tsp salt"
    },
    {
      "id": 79512,
      "primary_message": "To serve, place pita bread on a plate and top with beef, salad, and yogurt dressing. Enjoy!",
      "secondary_message": null
    }
  ],
