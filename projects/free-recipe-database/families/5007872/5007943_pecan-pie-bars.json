  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 190°C (375°F). Line a 13 by 23 cm baking pan with foil. Grease foil with butter.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium bowl, whisk together flour, baking powder, and salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat together butter and sugar until fluffy and light in color, about 4-5 minutes. Beat in egg, then vanilla. Beat in the flour mixture in two additions, scraping down the sides of the bowl each time.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Lightly flour your hands, then press dough evenly into the bottom of the greased baking pan. Let chill in refrigerator for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake crust for until golden brown, 30 minutes. Take out crust, but keep oven on. Let crust cool completely. While crust is cooling, make filling.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Place sugar in a large heavy sauce pan over medium high heat. Let the sugar begin to melt. When you see that the bottom layer has turned brown and is caramelizing, start to mix with a spoon. Mix occasionally until sugar has completely melted into a golden caramel. Pour in heavy cream. The sugar is going to immediately steam and harden into a lump. Do not panic. Turn the heat down to medium and continuously stir caramel until it is completely melted again, about 5 minutes. Stir in butter, vanilla, and salt, and mix until butter has melted completely. Take caramel off the heat and stir in pecans.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Pour filling onto crust and bake for 15 minutes. Let bars rest so that the filling can continue to set, at least 2 hours. Use a sharp knife to cut into squares.",
      "secondary_message": null
    }
  ],
