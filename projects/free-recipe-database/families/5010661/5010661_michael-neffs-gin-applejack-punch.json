  "instructions": [
    {
      "id": 1,
      "primary_message": "8 hours in advance, make a large ice block (or extra-large ice cubes) for serving.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, a few hours before serving, cut oranges into slices and muddle a few at a time in shaker. Strain and discard pulp and orange peel. When you have 2 ounces of juice, add Angostura bitters. Pour into resealable 750-milliliter bottle (using funnel if desired.)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add gin, applejack, lime juice, simple syrup, and water. Seal bottle and shake to blend. Refrigerate until completely chilled. Serve in a punch bowl over ice, garnishing with lime slices.",
      "secondary_message": null
    }
  ],
