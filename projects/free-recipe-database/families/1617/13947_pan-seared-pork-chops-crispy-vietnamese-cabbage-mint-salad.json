  "instructions": [
    {
      "id": 231228,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ medium heads napa cabbage\n1 ½ English cucumbers\n3 medium carrots\n1 small pkg fresh mint"
    },
    {
      "id": 231229,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231230,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 231231,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add pork chops and sear until golden and cooked through, 3-4 minutes per side. Remove from heat and transfer to a plate. Cover loosely with aluminum foil and set aside.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 231232,
      "primary_message": "Meanwhile, place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 231233,
      "primary_message": "Juice limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 231234,
      "primary_message": "Add fish sauce, oil, sugar, and, chili-garlic sauce to the bowl with the lime juice; whisk to combine the dressing.",
      "secondary_message": "⅓ cup fish sauce\n3 tbsp toasted sesame oil\n1 tbsp brown sugar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 231235,
      "primary_message": "Peel, halve, and thinly slice the onion into half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 231236,
      "primary_message": "Trim off and discard the root end of the cabbages; halve each cabbage lengthwise, then thinly slice crosswise into shreds. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231237,
      "primary_message": "Trim cucumbers, halve lengthwise, and thinly slice crosswise; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231238,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231239,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the edamame and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 231240,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 231241,
      "primary_message": "To serve, divide salad and pork chops between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
