  "instructions": [
    {
      "id": 231242,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ medium head napa cabbage\n½ English cucumber\n1 medium carrot\n½ small pkg fresh mint"
    },
    {
      "id": 231243,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "¾ cup edamame, shelled"
    },
    {
      "id": 231244,
      "primary_message": "Juice lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 231245,
      "primary_message": "Add soy sauce, oil, sugar, and chili-garlic sauce to the bowl with the lime juice; whisk to combine the dressing.",
      "secondary_message": "1 tbsp soy sauce\n1 tbsp toasted sesame oil\n2 tsp brown sugar\n1 tsp chili-garlic sauce"
    },
    {
      "id": 231246,
      "primary_message": "Peel, halve, and thinly slice the shallot into half-moons; add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 231247,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise into shreds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 231248,
      "primary_message": "Trim cucumber, halve lengthwise, and thinly slice crosswise; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 231249,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231250,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate.",
      "secondary_message": "1 tbsp toasted sesame oil\n2 pre-cooked vegan sausage"
    },
    {
      "id": 231251,
      "primary_message": "While the sausages are cooking, peel, trim, and coarsely grate carrot; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 231252,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the edamame and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 231253,
      "primary_message": "Thinly slice sausages.",
      "secondary_message": null
    },
    {
      "id": 231254,
      "primary_message": "To serve, divide salad and sausage slices between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
