  "instructions": [
    {
      "id": 231268,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ medium heads napa cabbage\n1 ½ English cucumbers\n3 medium carrots\n1 ½ small pkgs fresh mint"
    },
    {
      "id": 231269,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "2 ¼ cups edamame"
    },
    {
      "id": 231270,
      "primary_message": "Juice limes into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 231271,
      "primary_message": "Add soy sauce, oil, sugar, and chili-garlic sauce to the bowl with the lime juice; whisk to combine the dressing.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp toasted sesame oil\n2 tbsp brown sugar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 231272,
      "primary_message": "Peel, halve, and thinly slice the onion into half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 231273,
      "primary_message": "Trim off and discard the root end of the cabbages; halve each cabbage lengthwise, then thinly slice crosswise into shreds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 231274,
      "primary_message": "Trim cucumbers, halve lengthwise, and thinly slice crosswise; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 231275,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231276,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until warmed through, about 5 minutes (or cook sausages according to package instructions). Remove to a plate.",
      "secondary_message": "3 tbsp toasted sesame oil\n6 pre-cooked vegan sausage"
    },
    {
      "id": 231277,
      "primary_message": "While the sausages are cooking, peel, trim, and coarsely grate carrots; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 231278,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the edamame and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 231279,
      "primary_message": "Thinly slice sausages.",
      "secondary_message": null
    },
    {
      "id": 231280,
      "primary_message": "To serve, divide salad and sausage slices between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
