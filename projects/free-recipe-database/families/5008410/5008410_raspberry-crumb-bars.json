  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon. Dice the cold unsalted butter.",
      "secondary_message": "½ lemon\n16 tbsp cold unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 375°F. Grease baking pan with butter.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Filling: In a medium bowl, combine raspberries, sugar, tapioca, and lemon juice; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For Shortbread: In the bowl of a food processor, combine flour, sugar, baking powder, and salt; pulse 5 times to combine. Add butter and pulse until it is the size of peas, 5-10 pulses. Add egg and heavy cream and pulse until dough just comes together (it will be crumbly but should cohere when pressed down lightly by your fingertips.)",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Press enough of dough in pan to form a 1/4 inch layer, which should use just over 1/2 the dough. Cover with raspberries. Dot raspberries with chunks of remaining dough. Bake until top is golden and berries are bubbling, about 50 minutes. Let cool 20 minutes before cutting.",
      "secondary_message": null
    }
  ],
