  "instructions": [
    {
      "primary_message": "This recipe utilizes 2 medium food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce. \n\n",
      "secondary_message": "2 large leaf green leaf lettuce\n1 tomato"
    },
    {
      "primary_message": "Halve tomato lengthwise, then slice crosswise into thin half-moons. Using a paper towel, pat tomato slices on both sides to remove excess liquid (this will help keep the wraps from getting soggy). Season with pepper.\n\n",
      "secondary_message": "1 pinch black pepper"
    },
    {
      "primary_message": "Place tortillas on a flat surface and spread with a layer of mayo. Divide lettuce, tomato, turkey, and prosciutto between wraps. Roll tightly to close, then cut in half.\n\n",
      "secondary_message": "4 tsp mayonnaise\n6 oz oven roasted turkey breast, sliced\n4 slice prosciutto"
    },
    {
      "primary_message": "Place wraps in the storage containers, cover, and refrigerate until ready to eat. Enjoy wraps with a pear!",
      "secondary_message": null
    }
  ],
