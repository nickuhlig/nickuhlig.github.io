  "instructions": [
    {
      "id": 455290,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 455291,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.45 kg cremini mushrooms\n2 limes\n2 red chili peppers\n1 small pkg fresh mint\n1 small bunch cilantro\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 455292,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455293,
      "primary_message": "While the rice is cooking, roughly chop mushrooms. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 455294,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455295,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil\n454 g veggie ground, plant based"
    },
    {
      "id": 455296,
      "primary_message": "Meanwhile, juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 455297,
      "primary_message": "Thinly slice chili peppers into rings and add to the bowl with the lime juice. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 455298,
      "primary_message": "Peel and mince shallots. Add to the bowl, along with soy sauce and sugar, then stir to combine the sauce. Set aside.",
      "secondary_message": "2 shallots\n3 tbsp soy sauce\n1 tbsp brown sugar"
    },
    {
      "id": 455299,
      "primary_message": "When the veggie ground is done, add mushrooms and more oil to the skillet. Continue to cook, stirring occasionally, until mushrooms start to brown, 5-7 minutes more.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 455300,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Add half of the herbs to the bowl with the sauce. (Set remainder aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 455301,
      "primary_message": "When the mushrooms are done, add sauce to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 455302,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 455303,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
