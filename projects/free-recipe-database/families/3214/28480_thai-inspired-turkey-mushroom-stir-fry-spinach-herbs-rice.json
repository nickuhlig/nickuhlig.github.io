  "instructions": [
    {
      "id": 455108,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 455109,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lb cremini mushrooms\n1 lime\n1 red chili pepper\n½ small pkg fresh mint\n½ small bunch cilantro\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 455110,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455111,
      "primary_message": "While the rice is cooking, roughly chop mushrooms. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 455112,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455113,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add turkey and salt; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil\n¾ lb ground turkey\n1 pinch salt"
    },
    {
      "id": 455114,
      "primary_message": "Meanwhile, juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 455115,
      "primary_message": "Thinly slice chili pepper into rings and add to the bowl with the lime juice. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 455116,
      "primary_message": "Peel and mince shallot. Add to the bowl, along with fish sauce and sugar, then stir to combine the sauce. Set aside.",
      "secondary_message": "1 shallot\n2 tbsp fish sauce\n1 ½ tsp brown sugar"
    },
    {
      "id": 455117,
      "primary_message": "When the turkey is done, add mushrooms to the skillet. Continue to cook, stirring occasionally, until mushrooms start to brown, 5-7 minutes more.",
      "secondary_message": null
    },
    {
      "id": 455118,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Add half of the herbs to the bowl with the sauce. (Set remainder aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 455119,
      "primary_message": "When the mushrooms are done, add sauce to the skillet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 455120,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 455121,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
