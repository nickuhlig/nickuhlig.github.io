  "instructions": [
    {
      "id": 455304,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 455305,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg cremini mushrooms\n3 limes\n3 red chili peppers\n2 small pkgs fresh mint\n1 small bunch cilantro\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 455306,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 455307,
      "primary_message": "While the rice is cooking, roughly chop mushrooms. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 455308,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455309,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp neutral vegetable oil\n680 g veggie ground, plant based"
    },
    {
      "id": 455310,
      "primary_message": "Meanwhile, juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 455311,
      "primary_message": "Thinly slice chili peppers into rings and add to the bowl with the lime juice. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 455312,
      "primary_message": "Peel, halve, and mince onion. Add to the bowl, along with soy sauce and sugar, then stir to combine the sauce. Set aside.",
      "secondary_message": "½ medium red onion\n¼ cup soy sauce\n1 ½ tbsp brown sugar"
    },
    {
      "id": 455313,
      "primary_message": "When the veggie ground is done, add mushrooms and more oil to the pot. Continue to cook, stirring occasionally, until mushrooms start to brown, 6-8 minutes more.",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 455314,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Add half of the herbs to the bowl with the sauce. (Set remainder aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 455315,
      "primary_message": "When the mushrooms are done, add sauce to the pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 455316,
      "primary_message": "Add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 455317,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Top with reserved herbs and enjoy!",
      "secondary_message": null
    }
  ],
