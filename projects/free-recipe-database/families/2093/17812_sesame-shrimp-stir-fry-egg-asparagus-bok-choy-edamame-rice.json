  "instructions": [
    {
      "id": 288311,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 288312,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 288313,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 small bunches asparagus\n9 baby bok choy\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 288314,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 288315,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 288316,
      "primary_message": "Snap or cut off woody ends of the asparagus; cut into 1-inch pieces and add to the bowl with the green onion.",
      "secondary_message": null
    },
    {
      "id": 288317,
      "primary_message": "Trim bok choy and cut crosswise into 1-inch strips; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 288318,
      "primary_message": "Peel and mince ginger; set aside.",
      "secondary_message": null
    },
    {
      "id": 288319,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 288320,
      "primary_message": "While the pot heats up, place eggs, salt, and pepper in a medium bowl; whisk to combine.",
      "secondary_message": "6 eggs\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 288321,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Pour eggs into the pot; scramble using a combination of stirring and folding. Cook until eggs are no longer runny, about 3 minutes. Remove eggs to a plate and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 288322,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add ginger and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 288323,
      "primary_message": "Add shrimp, veggies, and edamame to the pot; cook, stirring occasionally, until veggies are tender and shrimp are cooked through, 7-8 minutes.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 288324,
      "primary_message": "Return eggs to the pot. Add soy sauce and sesame seeds; stir to combine and remove from heat.",
      "secondary_message": "¼ cup soy sauce\n3 tbsp sesame seeds"
    },
    {
      "id": 288325,
      "primary_message": "To serve, divide rice and shrimp stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
