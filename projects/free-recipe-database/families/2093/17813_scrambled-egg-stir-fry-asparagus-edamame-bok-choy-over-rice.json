  "instructions": [
    {
      "id": 288326,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 288327,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 288328,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 small bunch asparagus\n3 baby bok choy\n1 (1 inch) piece ginger root"
    },
    {
      "id": 288329,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 288330,
      "primary_message": "Snap or cut off woody ends of the asparagus; cut into 1-inch pieces and add to the bowl with the green onion.",
      "secondary_message": null
    },
    {
      "id": 288331,
      "primary_message": "Trim bok choy and cut crosswise into 1-inch strips; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 288332,
      "primary_message": "Peel and mince ginger; set aside.",
      "secondary_message": null
    },
    {
      "id": 288333,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 288334,
      "primary_message": "While the skillet heats up, place eggs, salt, and pepper in another medium bowl; whisk to combine.",
      "secondary_message": "4 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 288335,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour eggs into the skillet; scramble using a combination of stirring and folding. Cook until eggs are no longer runny, 2-3 minutes. Remove eggs to a plate and set aside.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 288336,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add ginger and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 288337,
      "primary_message": "Add veggies and edamame to the skillet; cook, stirring occasionally, until veggies are tender, about 5 minutes.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 288338,
      "primary_message": "Return eggs to the skillet. Add soy sauce and sesame seeds; stir to combine and remove from heat.",
      "secondary_message": "1 ½ tbsp soy sauce\n1 tbsp sesame seeds"
    },
    {
      "id": 288339,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
