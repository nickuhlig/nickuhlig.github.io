  "instructions": [
    {
      "id": 9492,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": ""
    },
    {
      "id": 9493,
      "primary_message": "Wash zucchini, tomatoes, and lemons. Trim ends and halve the zucchini crosswise; cut each ½ into 6-8 wedges. Cut the tomatoes and 1 of the lemons (save the other for the topping) into wedges. Transfer to a sheet pan.",
      "secondary_message": "4 zucchini\r\n4 tomatoes\r\n2 lemons"
    },
    {
      "id": 9494,
      "primary_message": "Peel, mince, and add garlic to the vegetables. Drizzle with oil and season with parsley flakes, salt, and pepper. Toss to coat.",
      "secondary_message": "2 cloves garlic\r\n4 tbsp extra virgin olive oil\r\n½ tsp parsley flakes\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 9495,
      "primary_message": "Place fish on top of vegetables and season with salt and pepper.",
      "secondary_message": "0.68 kg cod fillet\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 9496,
      "primary_message": "Grate zest from remaining lemon. In a medium bowl, prepare topping by mixing together zest, bread crumbs, oil, dill, salt, and pepper. Spoon topping over top fish.",
      "secondary_message": "4 tbsp panko bread crumbs\r\n2 tbsp extra virgin olive oil\r\n½ tsp dill\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 9497,
      "primary_message": "Place in the oven and bake until fish is white and flaky, 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 9498,
      "primary_message": "To serve, place on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
