  "instructions": [
    {
      "id": 216286,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 216287,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n½ eggplant\n2 tomatoes"
    },
    {
      "id": 216288,
      "primary_message": "Slice potatoes into thin wedges and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 216289,
      "primary_message": "Peel and mince garlic. Add to the bowl with the potatoes, along with oil, rosemary, and salt; toss to combine and spread out in a single layer on the baking sheet.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n1 tsp rosemary\n¼ tsp salt"
    },
    {
      "id": 216290,
      "primary_message": "Place potatoes in the oven and bake, tossing once, until tender and golden, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 216291,
      "primary_message": "Meanwhile, trim, halve, and cut eggplant into ¼-inch-thick slices. Transfer to the bowl used for the potatoes.",
      "secondary_message": null
    },
    {
      "id": 216292,
      "primary_message": "Add oil, vinegar, and salt to the bowl; toss to combine.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp balsamic vinegar\n¼ tsp salt"
    },
    {
      "id": 216293,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 216294,
      "primary_message": "Once the grill pan is hot, add eggplant and grill until tender, flipping once, 3-4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 216295,
      "primary_message": "Meanwhile, place goat cheese, oil, and Italian seasoning in a small bowl. Stir to combine and set aside.",
      "secondary_message": "1 (113 g) log goat cheese\n1 tbsp extra virgin olive oil\n1 tsp Italian seasoning"
    },
    {
      "id": 216296,
      "primary_message": "Thinly slice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 216297,
      "primary_message": "If desired, place buns, cut-side down, on the grill pan to toast, 1-2 minutes.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 216298,
      "primary_message": "Spread buns evenly with goat cheese. Top the bottom halves with eggplant and tomato, closing with the top half of the bun.",
      "secondary_message": null
    },
    {
      "id": 216299,
      "primary_message": "To serve, divide sandwiches and potato wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
