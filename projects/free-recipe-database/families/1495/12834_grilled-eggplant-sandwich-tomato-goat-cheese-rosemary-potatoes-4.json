  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Line two baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n1 ½ eggplants\n6 tomatoes"
    },
    {
      "primary_message": "Slice potatoes into thin wedges and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. Add to the bowl with the potatoes, along with oil, rosemary, and salt; toss to combine and spread out in a single layer on the baking sheet.",
      "secondary_message": "6 cloves garlic\nextra virgin olive oil\nsalt"
    },
    {
      "primary_message": "Place potatoes in the oven and bake, tossing once, until tender and golden, about 30 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, trim, halve, and cut eggplants into ¼-inch-thick slices. Transfer to the bowl used for the potatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "Add oil, vinegar, and salt to the bowl; toss to combine.",
      "secondary_message": "extra virgin olive oil\n1 tbsp balsamic vinegar\nsalt"
    },
    {
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the grill pan is hot, add eggplant and grill until tender, flipping once, 3-4 minutes per side. Work in batches if necessary.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place goat cheese, oil, and Italian seasoning in a medium bowl. Stir to combine and set aside.",
      "secondary_message": "3 (113 g) logs goat cheese\nextra virgin olive oil\n1 tbsp Italian seasoning"
    },
    {
      "primary_message": "Thinly slice tomatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "If desired, place buns, cut-side down, on the grill pan to toast, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Spread buns evenly with goat cheese. Top the bottom halves with eggplant and tomato, closing with the top half of the bun.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide sandwiches and potato wedges between plates. Enjoy!",
      "secondary_message": null
    }
  ],
