  "instructions": [
    {
      "id": 402258,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add pasta and salt, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "15 oz fettuccine pasta\n1 ½ tsp salt"
    },
    {
      "id": 402259,
      "primary_message": "Meanwhile, preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 402260,
      "primary_message": "While the pot heats up, tear smoked salmon into bite-sized pieces.",
      "secondary_message": "3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 402261,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add salmon and cook, stirring often, until crispy, about 5 minutes. Use a slotted spoon to transfer to a paper towel-lined plate and set aside. (Reserve pot with cooking juices for the next step.)",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 402262,
      "primary_message": "Return pot (with cooking juices) to medium heat. Add peas and cook, stirring often, until tender, 2-3 minutes.",
      "secondary_message": "2 ¼ cups frozen peas"
    },
    {
      "id": 402263,
      "primary_message": "Add Alfredo sauce to the pot with the peas. Bring to a simmer, stirring occasionally, then remove from heat and cover to keep warm.",
      "secondary_message": "1 ½ (16 oz) jars Alfredo sauce"
    },
    {
      "id": 402264,
      "primary_message": "Meanwhile, wash and dry the arugula (skip this step if it came pre-washed). Place in a large bowl along with dressing and additional salt; toss to coat.",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula\n⅓ cup honey mustard dressing\n¼ tsp salt"
    },
    {
      "id": 402265,
      "primary_message": "When the pasta is done, drain and add to the pot with the sauce; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 402266,
      "primary_message": "To serve, divide pasta and arugula between plates; top pasta with crispy salmon. Enjoy!",
      "secondary_message": null
    }
  ],
