  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Mince the onion. Finely chop the onion. Mince the jalapeños. Mince the garlic. Finely chop the American cheese. Shred the sharp cheddar.",
      "secondary_message": "2 medium cloves garlic\n1 medium onion\n1 medium onion\n2 jalapeños\n2 medium cloves garlic\n4 oz American cheese\n½ cup sharp cheddar"
    },
    {
      "id": 1,
      "primary_message": "For the Sauce: Heat oil in a large saucepan over medium heat. Add garlic and onion and sauté until starting to soften, 3 to 4 minutes. Add oregano, chile powder, cocoa powder, cumin, and beer. Bring to a boil, then lower heat and simmer for 1 minute. Add tomatoes and season with salt and pepper. Continue to simmer until sauce has thickened slightly, about 15 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Peppers: Meanwhile, adjust oven rack to lower-middle position and preheat oven to 350°F. Heat oil in a large skillet over medium-high heat until shimmering. Add beef and cook, breaking it up into little bits, until cooked through. Add onion and jalapeños, stir to combine, and continue cooking until vegetables are slightly softened, about 4 minutes. Stir in garlic and cook for 1 minute. Add cumin, chile powder, rice, tomatoes, Worcestershire sauce, sour cream, and both cheeses and mix well. Season with salt and pepper and bring to a simmer. Continue cooking until cheese is melted and filling is creamy, about 5 minutes longer. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Arrange peppers in an 8- by 8-inch baking dish standing upright like cups.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Generously mound filling inside peppers and ladle sauce all over. Cover with foil and bake, basting with sauce every 15 minutes, until peppers are tender, about 1 hour, removing foil during the last 15 minutes of cooking. Let peppers rest 10 minutes, then serve.",
      "secondary_message": null
    }
  ],
