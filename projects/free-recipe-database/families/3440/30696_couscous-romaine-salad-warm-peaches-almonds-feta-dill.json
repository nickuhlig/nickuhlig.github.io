  "instructions": [
    {
      "id": 487093,
      "primary_message": "In a medium saucepan, bring water and salt to a boil over high heat. Once boiling, remove from heat, add couscous, and stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "3 cup water\n½ tsp salt\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 487094,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ English cucumbers\n3 heads romaine lettuce\n1 small bunch fresh dill\n6 peaches"
    },
    {
      "id": 487095,
      "primary_message": "Juice lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 487096,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with oil, Dijon, sugar, and spices; whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp Dijon mustard\n2 tbsp brown sugar\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 487097,
      "primary_message": "Trim and small dice cucumbers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 487098,
      "primary_message": "Halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 487099,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add half to the bowl and set the salad aside. (Reserve remaining dill for serving.)",
      "secondary_message": null
    },
    {
      "id": 487100,
      "primary_message": "When the couscous is done, transfer to a large baking sheet pan. Spread out in an even layer and let cool slightly. ",
      "secondary_message": null
    },
    {
      "id": 487101,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Slice each quarter into ½-inch thick wedges.",
      "secondary_message": null
    },
    {
      "id": 487102,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 487103,
      "primary_message": "While the skillet heats up, roughly chop almonds.",
      "secondary_message": "1 cup almonds"
    },
    {
      "id": 487104,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peaches, almonds, sugar, salt, and pepper; cook, stirring occasionally, until peaches are golden brown and fork-tender, 4-5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp brown sugar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 487105,
      "primary_message": "Add cooled couscous to the bowl with the salad and gently toss to combine.",
      "secondary_message": null
    },
    {
      "id": 487106,
      "primary_message": "To serve, divide salad between plates or bowls; top with warm peaches, almonds, feta, and reserved dill. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
