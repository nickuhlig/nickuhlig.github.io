  "instructions": [
    {
      "id": 162463,
      "primary_message": "Place milk and salt in a large pot, cover, and bring to a boil over high heat. ",
      "secondary_message": "42 fl oz (5 ¼ cups) almond milk, unsweetened\n3 pinch salt"
    },
    {
      "id": 162464,
      "primary_message": "Once boiling, stir in oats and maple syrup. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency. ",
      "secondary_message": "3 cup oats, quick cooking\n2 tbsp pure maple syrup"
    },
    {
      "id": 162465,
      "primary_message": "Meanwhile, wash, halve and pit peaches, then medium dice.",
      "secondary_message": "3 peaches"
    },
    {
      "id": 162466,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "1 cup pecans, dry roasted"
    },
    {
      "id": 162467,
      "primary_message": "To serve, divide oats between bowls and top with peaches, pecans, and maple syrup. Serve with milk and enjoy!",
      "secondary_message": "2 tbsp pure maple syrup\n12 fl oz (1 ½ cups) almond milk, unsweetened"
    }
  ],
