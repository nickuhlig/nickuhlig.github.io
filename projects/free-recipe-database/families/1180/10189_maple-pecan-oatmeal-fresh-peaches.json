  "instructions": [
    {
      "id": 162473,
      "primary_message": "Place water and salt in a medium saucepan, cover, and bring to a boil over high heat. ",
      "secondary_message": "3 ½ cup water\n⅛ tsp salt"
    },
    {
      "id": 162474,
      "primary_message": "Once boiling, stir in oats and maple syrup. Cover and let simmer, on low, 3-5 minutes, or until oats reach desired consistency. ",
      "secondary_message": "2 cup oats, quick cooking\n4 tsp pure maple syrup"
    },
    {
      "id": 162475,
      "primary_message": "Meanwhile, wash, halve and pit peaches, then medium dice.",
      "secondary_message": "2 peaches"
    },
    {
      "id": 162476,
      "primary_message": "Roughly chop pecans.",
      "secondary_message": "⅔ cup pecans, dry roasted"
    },
    {
      "id": 162477,
      "primary_message": "To serve, divide oats between bowls and top with peaches, pecans, and maple syrup. Serve with milk and enjoy!",
      "secondary_message": "4 tsp pure maple syrup\n237 ml whole milk"
    }
  ],
