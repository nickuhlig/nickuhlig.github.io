  "instructions": [
    {
      "id": 466467,
      "primary_message": "Preheat oven to 220°C (425°F). ",
      "secondary_message": null
    },
    {
      "id": 466468,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 466469,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 466470,
      "primary_message": "Meanwhile, mince pecans. Place in a small bowl along with coconut and crushed red pepper, then stir to combine the topping.",
      "secondary_message": "¼ cup pecan halves\n¼ cup shredded unsweetened coconut\n½ tsp crushed red pepper"
    },
    {
      "id": 466471,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 466472,
      "primary_message": "While the rice is cooking, cut tofu planks in half crosswise, then season both sides with salt and pepper. Wipe baking sheet dry with paper towels and coat with a thin layer of oil.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 466473,
      "primary_message": "Return tofu to the baking sheet and spread top-side with mayo. Sprinkle evenly with the topping, pressing gently to adhere.",
      "secondary_message": "3 tbsp mayonnaise"
    },
    {
      "id": 466474,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake until golden and warmed through, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 466475,
      "primary_message": "Meanwhile, place oil, vinegar, maple syrup, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 466476,
      "primary_message": "Peel, halve, and slice shallot lengthwise into thin strips. Add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 466477,
      "primary_message": "Wash and dry fennel; trim off root end and dark green stalks, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "2 fennel bulbs"
    },
    {
      "id": 466478,
      "primary_message": "Wash, dry, and peel oranges; separate into segments and cut into bite-sized pieces. Add to the bowl, along with cranberries, and stir to combine the salad.",
      "secondary_message": "2 oranges\n¼ cup dried cranberries"
    },
    {
      "id": 466479,
      "primary_message": "To serve, divide tofu, rice, and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
