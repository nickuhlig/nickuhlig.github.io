  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Beat the egg.",
      "secondary_message": "1 egg"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position, and preheat to 190°C (375°F). Line a muffin tin with paper muffin tin liners. In a large bowl combine 1 3/4 cups flour, baking powder, baking soda, and sugar and whisk to combine. In a separate bowl combine milk, vegetable oil, and egg and whisk until well combined. Slowly whisk the milk-oil-egg mixture into the dry ingredients. Fold in chocolate chunks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add remaining 3 tablespoons butter, flour, oats, brown sugar, and cocoa nibs to a separate bowl. Using your fingers gently incorporate all the ingredients together until there are no loger any lumps of butter.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Divide batter between muffin cups, then top with streusel. Bake until muffins are brown and a toothpick inserted into center comes out clean, about 18 minutes. Remove from oven, let cool 5 minutes, and serve warm.",
      "secondary_message": null
    }
  ],
