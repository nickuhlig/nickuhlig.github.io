  "instructions": [
    {
      "id": 406793,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 406794,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 orange\n1 (142 g) pkg baby spinach\n½ small pkg fresh basil\n1 (170 g) pkg raspberries"
    },
    {
      "id": 406795,
      "primary_message": "Peel orange, separate into segments, and roughly chop the flesh. Place in a medium bowl along with the spinach.",
      "secondary_message": null
    },
    {
      "id": 406796,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl with the orange and spinach.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 406797,
      "primary_message": "Pick basil leaves off the stems. Roll half of the basil leaves up crosswise, thinly slice into ribbons, and add to the bowl. Place remaining (whole) basil leaves in a blender.",
      "secondary_message": null
    },
    {
      "id": 406798,
      "primary_message": "Add half of the raspberries to the bowl and set aside. Add remaining raspberries to the blender with the basil along with oil, vinegar, water, Dijon, honey, salt, and pepper. Blend on high until smooth, then set dressing aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n1 tbsp water\n1 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 406799,
      "primary_message": "Transfer the cooked quinoa to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 406800,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "⅓ cup pecan halves"
    },
    {
      "id": 406801,
      "primary_message": "Once the quinoa is cool, add to the bowl, along with the pecans, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406802,
      "primary_message": "To serve, divide salad between plates or bowls. Crumble goat cheese over top and drizzle with dressing. Enjoy!",
      "secondary_message": "½ (113 g) log goat cheese"
    }
  ],
