  "instructions": [
    {
      "id": 406750,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 406751,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 oranges\n3 (5 oz) pkgs baby spinach\n1 small pkg fresh basil\n3 (6 oz) pkgs raspberries"
    },
    {
      "id": 406752,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Place in a large bowl along with the spinach.",
      "secondary_message": null
    },
    {
      "id": 406753,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the orange and spinach.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 406754,
      "primary_message": "Pick basil leaves off the stems. Roll half of the basil leaves up crosswise, thinly slice into ribbons, and add to the bowl. Place remaining (whole) basil leaves in a blender.",
      "secondary_message": null
    },
    {
      "id": 406755,
      "primary_message": "Add half of the raspberries to the bowl and set aside. Add remaining raspberries to the blender with the basil along with oil, vinegar, water, Dijon, honey, salt, and pepper. Blend on high until smooth, then set dressing aside.",
      "secondary_message": "⅓ cup extra virgin olive oil\n¼ cup red wine vinegar\n3 tbsp water\n1 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 406756,
      "primary_message": "Transfer the cooked quinoa to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 406757,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "1 cup pecan halves"
    },
    {
      "id": 406758,
      "primary_message": "Once the quinoa is cool, add to the bowl, along with the pecans, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406759,
      "primary_message": "To serve, divide salad between plates or bowls. Crumble goat cheese over top and drizzle with dressing. Enjoy!",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    }
  ],
