  "instructions": [
    {
      "id": 406771,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 cup quinoa\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 406772,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 oranges\n2 (5 oz) pkgs baby spinach\n2 avocados\n1 small pkg fresh basil\n2 (6 oz) pkgs raspberries"
    },
    {
      "id": 406773,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Place in a large bowl along with the spinach.",
      "secondary_message": null
    },
    {
      "id": 406774,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl with the orange and spinach.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 406775,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 406776,
      "primary_message": "Pick basil leaves off the stems. Roll half of the basil leaves up crosswise, thinly slice into ribbons, and add to the bowl. Place remaining (whole) basil leaves in a blender.",
      "secondary_message": null
    },
    {
      "id": 406777,
      "primary_message": "Add half of the raspberries to the bowl and set aside. Add remaining raspberries to the blender with the basil along with oil, vinegar, water, Dijon, maple syrup, salt, and pepper. Blend on high until smooth, then set dressing aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n3 tbsp water\n2 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 406778,
      "primary_message": "Transfer the cooked quinoa to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 406779,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "⅔ cup pecan halves"
    },
    {
      "id": 406780,
      "primary_message": "Once the quinoa is cool, add to the bowl, along with the pecans, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406781,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
