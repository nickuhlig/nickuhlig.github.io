  "instructions": [
    {
      "id": 406760,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 406761,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 orange\n1 (5 oz) pkg baby spinach\n1 avocado\n½ small pkg fresh basil\n1 (6 oz) pkg raspberries"
    },
    {
      "id": 406762,
      "primary_message": "Peel orange, separate into segments, and roughly chop the flesh. Place in a medium bowl along with the spinach.",
      "secondary_message": null
    },
    {
      "id": 406763,
      "primary_message": "Peel, halve, and slice shallot crosswise into thin half-moons. Add to the bowl with the orange and spinach.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 406764,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 406765,
      "primary_message": "Pick basil leaves off the stems. Roll half of the basil leaves up crosswise, thinly slice into ribbons, and add to the bowl. Place remaining (whole) basil leaves in a blender.",
      "secondary_message": null
    },
    {
      "id": 406766,
      "primary_message": "Add half of the raspberries to the bowl and set aside. Add remaining raspberries to the blender with the basil along with oil, vinegar, water, Dijon, maple syrup, salt, and pepper. Blend on high until smooth, then set dressing aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n1 ½ tbsp water\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 406767,
      "primary_message": "Transfer the cooked quinoa to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 406768,
      "primary_message": "Meanwhile, roughly chop pecans.",
      "secondary_message": "⅓ cup pecan halves"
    },
    {
      "id": 406769,
      "primary_message": "Once the quinoa is cool, add to the bowl, along with the pecans, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 406770,
      "primary_message": "To serve, divide salad between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
