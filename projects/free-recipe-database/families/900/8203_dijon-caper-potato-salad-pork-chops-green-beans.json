  "instructions": [
    {
      "id": 174366,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 174367,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.23 kg green beans\n0.23 kg new potatoes\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 174368,
      "primary_message": "Trim ends from the green beans; cut potatoes in half.",
      "secondary_message": null
    },
    {
      "id": 174369,
      "primary_message": "Add beans to the boiling water and cook until tender-crisp, 1-2 minutes. Using tongs, remove the beans and transfer to a colander, leaving water on the heat. Rinse under cold water and set aside.",
      "secondary_message": null
    },
    {
      "id": 174370,
      "primary_message": "Add potatoes to the boiling water and cook until fork-tender, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 174371,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 174372,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 174373,
      "primary_message": "When the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 174374,
      "primary_message": "Add chops to the skillet and cook, flipping once, until browned on both sides and cooked through, 6-7 minutes. When done, transfer to a plate and cover with aluminum foil; set aside to rest.",
      "secondary_message": null
    },
    {
      "id": 174375,
      "primary_message": "Meanwhile, peel and mince the garlic; rinse and roughly chop the capers. Place both in a medium bowl.",
      "secondary_message": "1 clove garlic\n1 tbsp capers"
    },
    {
      "id": 174376,
      "primary_message": "Add oil, vinegar, Dijon, honey, salt, and pepper to the bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n2 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 174377,
      "primary_message": "Drain potatoes and rinse under cold water to cool. Add potatoes and green beans to the bowl with the dressing and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 174378,
      "primary_message": "Thinly slice the pork chops crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 174379,
      "primary_message": "To serve, divide arugula between plates, top with potato-bean salad and sliced pork. Enjoy!",
      "secondary_message": null
    }
  ],
