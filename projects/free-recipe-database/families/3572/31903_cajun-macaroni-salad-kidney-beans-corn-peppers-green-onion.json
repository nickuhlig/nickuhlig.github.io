  "instructions": [
    {
      "id": 504429,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "½ tsp salt\n142 g macaroni (elbow) pasta"
    },
    {
      "id": 504430,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch green onions (scallions)\n1 red bell pepper\n1 green bell pepper"
    },
    {
      "id": 504431,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can kidney beans"
    },
    {
      "id": 504432,
      "primary_message": "Juice lemon into a medium bowl. Add yogurt, mayo, sugar, and spices, then whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 ½ tsp brown sugar\n1 tsp Cajun seasoning\n½ tsp salt\n¼ tsp black pepper\n¼ tsp smoked paprika"
    },
    {
      "id": 504433,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 504434,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl along with the beans.",
      "secondary_message": null
    },
    {
      "id": 504435,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 504436,
      "primary_message": "Add cooled pasta to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 504437,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
