  "instructions": [
    {
      "id": 504474,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": "1 ½ tsp salt\n425 g macaroni (elbow) pasta"
    },
    {
      "id": 504475,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch green onions (scallions)\n3 red bell peppers\n3 green bell peppers"
    },
    {
      "id": 504476,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans kidney beans"
    },
    {
      "id": 504477,
      "primary_message": "Juice lemons into a large bowl. Add mayo, water, sugar, and spices, then whisk to combine the dressing.",
      "secondary_message": "¾ cup vegan mayonnaise\n⅓ cup water\n1 ½ tbsp brown sugar\n1 tbsp Cajun seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp smoked paprika"
    },
    {
      "id": 504478,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 504479,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl along with the beans.",
      "secondary_message": null
    },
    {
      "id": 504480,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 504481,
      "primary_message": "Add cooled pasta to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 504482,
      "primary_message": "To serve, divide pasta salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
