  "instructions": [
    {
      "id": 627520,
      "primary_message": "Roughly chop sun-dried tomatoes. Place in a medium bowl, along with eggs and spices, then whisk to combine.",
      "secondary_message": "4 sun-dried tomatoes, oil-packed\n6 eggs\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 627521,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 627522,
      "primary_message": "While the skillet heats up, roughly chop spinach, add to the bowl with the egg mixture, and stir to combine.",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "id": 627523,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour egg mixture into the skillet; scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the skillet. Cook until spinach is wilted and eggs are no longer runny. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 627524,
      "primary_message": "Meanwhile, wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 627525,
      "primary_message": "To serve, divide scrambled eggs and avocado between plates. Enjoy!",
      "secondary_message": null
    }
  ],
