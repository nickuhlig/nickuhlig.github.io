  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine vinegar, water, sugar, and salt in a medium saucepan and bring to a boil over high heat. Remove from heat. Add cucumber slices and stir. Cover with a clean kitchen towel or a double layer of heavy duty paper towels, pressing down until towel is saturated with liquid and in direct contact with the cucumbers. Let rest 10 minutes, then transfer cucumbers to a sealable container. Top up with liquid and discard the rest. Store in the refrigerator for up to 1 month.",
      "secondary_message": null
    }
