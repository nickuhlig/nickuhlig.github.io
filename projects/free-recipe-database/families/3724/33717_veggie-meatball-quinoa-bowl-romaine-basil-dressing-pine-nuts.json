  "instructions": [
    {
      "id": 533349,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 533350,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "⅓ cup pine nuts"
    },
    {
      "id": 533351,
      "primary_message": "In a medium saucepan, combine water, quinoa, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "3 cup water\n1 ½ cups quinoa\n¾ tsp salt"
    },
    {
      "id": 533352,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 small pkgs fresh basil\n1 ½ heads romaine lettuce\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 533353,
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Divide between a large and another small bowl. (Set small bowl aside for the dressing.)",
      "secondary_message": null
    },
    {
      "id": 533354,
      "primary_message": "Add veggie ground, bread crumbs, and spices to the large bowl with the basil. Using your hands, mix well to combine. Use a tablespoon measure to form the veggie ground mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": "680 g veggie ground, plant based\n⅓ cup panko bread crumbs\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 533355,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 533356,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until browned on all sides and cooked through, 6-8 minutes. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 533357,
      "primary_message": "Meanwhile, peel and mince garlic and shallot. Add both to the small bowl with the basil along with oil, vinegar, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "3 cloves garlic\n1 shallot\n⅓ cup extra virgin olive oil\n¼ cup red wine vinegar\n¾ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 533358,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 533359,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the lettuce and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 533360,
      "primary_message": "To serve, divide quinoa, meatballs, lettuce, and tomatoes between bowls. Drizzle with dressing, sprinkle with pine nuts, and enjoy!",
      "secondary_message": null
    }
  ],
