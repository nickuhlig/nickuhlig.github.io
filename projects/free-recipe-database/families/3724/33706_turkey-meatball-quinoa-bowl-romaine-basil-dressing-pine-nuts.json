  "instructions": [
    {
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "primary_message": "In a small saucepan, combine water, quinoa, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\nsalt"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh basil\n½ head romaine lettuce\n½ pint grape tomatoes"
    },
    {
      "primary_message": "Pick basil leaves off the stems; discard stems and mince the leaves. Divide between a medium and another small bowl. (Set small bowl aside for the dressing.)",
      "secondary_message": null
    },
    {
      "primary_message": "Add turkey, bread crumbs, and spices to the medium bowl with the basil. Using your hands, mix well to combine. Use a tablespoon measure to form the turkey mixture into rounded meatballs and place on a plate.",
      "secondary_message": "¾ lb ground turkey\n½ tsp Italian seasoning\ncrushed red pepper\nsalt"
    },
    {
      "primary_message": "Return the skillet to medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning occasionally, until browned on all sides and cooked through, 6-8 minutes. Transfer to a clean plate.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, peel and mince garlic and shallot. Add both to the small bowl with the basil along with oil, vinegar, and spices. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 clove garlic\n½ shallot\nextra virgin olive oil\n1 ½ tbsp red wine vinegar\nsalt\n⅛ tsp black pepper\ncrushed red pepper"
    },
    {
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the bowl with the lettuce and toss to combine. ",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide quinoa, meatballs, lettuce, and tomatoes between bowls. Drizzle with dressing, sprinkle with pine nuts, and enjoy!",
      "secondary_message": null
    }
  ],
