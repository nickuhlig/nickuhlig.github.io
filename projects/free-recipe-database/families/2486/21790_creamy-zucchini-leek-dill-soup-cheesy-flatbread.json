  "instructions": [
    {
      "id": 366448,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 leek\n½ small bunch fresh dill"
    },
    {
      "id": 366449,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into bite-sized pieces. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 366450,
      "primary_message": "Trim off the root end and dark green top of the leek, leaving only the white and pale green part. Cut the leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 366451,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 366452,
      "primary_message": "While the pan heats up, peel and mince garlic. Add to the bowl with the zucchini and leek.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 366453,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, about 6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 366454,
      "primary_message": "When the veggies are soft, add broth and bring to a simmer. Once simmering, reduce heat to medium and continue to cook until veggies are very tender, 5-6 minutes more. Remove from heat.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 366455,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 366456,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 366457,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 366458,
      "primary_message": "Place flatbreads on a baking sheet pan, then sprinkle with mozzarella and Italian seasoning. Place in the oven and broil until cheese is melted, 4-5 minutes. Remove from oven and cut into wedges.",
      "secondary_message": "2 flatbreads or naan\n⅛ tsp Italian seasoning"
    },
    {
      "id": 366459,
      "primary_message": "When the soup is done, use a hand blender to purée the soup until smooth. Alternatively, use a potato masher to crush the veggies (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 366460,
      "primary_message": "Add dill and yogurt to the soup, then stir to combine.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 366461,
      "primary_message": "Divide soup between bowls and serve with cheesy flatbread on the side. Enjoy!",
      "secondary_message": null
    }
  ],
