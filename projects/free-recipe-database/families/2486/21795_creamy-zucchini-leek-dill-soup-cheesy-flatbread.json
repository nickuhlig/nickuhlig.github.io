  "instructions": [
    {
      "id": 366518,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 leeks\n1 small bunch fresh dill"
    },
    {
      "id": 366519,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into bite-sized pieces. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 366520,
      "primary_message": "Trim off the root ends and dark green tops of the leeks, leaving only the white and pale green parts. Cut the leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the bowl with the zucchini.",
      "secondary_message": null
    },
    {
      "id": 366521,
      "primary_message": "Peel and mince garlic; add to the bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 366522,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 366523,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, about 8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 366524,
      "primary_message": "When the veggies are soft, add broth and bring to a simmer. Once simmering, reduce heat to medium and continue to cook until veggies are very tender, 6-7 minutes more. Remove from heat.",
      "secondary_message": "2129 ml chicken or vegetable broth"
    },
    {
      "id": 366525,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 366526,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 366527,
      "primary_message": "Coarsely grate mozzarella.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 366528,
      "primary_message": "Divide flatbreads between two large baking sheet pans, then sprinkle with mozzarella and Italian seasoning. Working in batches, place in the oven and broil until cheese is melted, 4-5 minutes. Remove from oven and cut into wedges.",
      "secondary_message": "6 flatbreads or naan\n½ tsp Italian seasoning"
    },
    {
      "id": 366529,
      "primary_message": "When the soup is done, use a hand blender to purée the soup until smooth. Alternatively, use a potato masher to crush the veggies (the soup will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 366530,
      "primary_message": "Add dill and yogurt to the soup, then stir to combine.",
      "secondary_message": "1 ½ cups plain Greek yogurt"
    },
    {
      "id": 366531,
      "primary_message": "Divide soup between bowls and serve with cheesy flatbread on the side. Enjoy!",
      "secondary_message": null
    }
  ],
