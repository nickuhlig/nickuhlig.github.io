  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a small saucepan with a ½-cup hot water (from the tap); cover and bring to a boil over high heat. Once boiling, add edamame, cover, and reduce heat to medium-high. Simmer until tender, 6-8 minutes. Drain in a colander and rinse under cold water to cool; set aside.",
      "secondary_message": "1 cup edamame in the pod"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and place tomatoes in the first small compartment of the bento box.",
      "secondary_message": "⅓ cup grape tomatoes"
    },
    {
      "primary_message": "Wash, dry, peel, and separate mandarin into segments (if desired). Place in the second small compartment of the bento box.",
      "secondary_message": "1 mandarin"
    },
    {
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a small bowl.",
      "secondary_message": "½ stick celery"
    },
    {
      "primary_message": "Peel and mince shallot. Mince capers. Add both to the bowl along with yogurt, mayo, and spices. Stir to combine the dressing.",
      "secondary_message": "½ shallot\n½ tbsp capers\n2 tbsp plain Greek yogurt\n2 tbsp mayonnaise\n¼ tsp dill, dried\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork. Stir to combine the tuna salad.",
      "secondary_message": "1 (120 g) can chunk light tuna in water"
    },
    {
      "primary_message": "Spread tuna salad over one slice of bread. Close with the second slice of bread, then cut in half. Place sandwich in the large compartment of the bento box.",
      "secondary_message": "2 slice white bread"
    },
    {
      "primary_message": "Place cooled edamame in the medium compartment of the bento box. Season with salt if desired.",
      "secondary_message": null
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
