  "instructions": [
    {
      "id": 321665,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 321666,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 321667,
      "primary_message": "Meanwhile, place vinegar, oil, soy sauce, and chili-garlic sauce in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp rice vinegar\n1 ½ tbsp toasted sesame oil\n1 tbsp soy sauce\n1 tsp chili-garlic sauce"
    },
    {
      "id": 321668,
      "primary_message": "Wash, dry, trim, and seed bell pepper. Halve crosswise, then slice into thin strips and add to the bowl with the dressing.",
      "secondary_message": "½ red bell pepper"
    },
    {
      "id": 321669,
      "primary_message": "Wash, dry, peel, and coarsely grate carrot; add to the bowl along with the broccoli slaw. Toss to combine and set aside.",
      "secondary_message": "1 medium carrot\n½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 321670,
      "primary_message": "Peel and mince garlic; place in a small bowl along with cold water (from the tap) and cornstarch. Whisk to combine.",
      "secondary_message": "2 cloves garlic\n1 tbsp water\n½ tsp cornstarch"
    },
    {
      "id": 321671,
      "primary_message": "Add ketchup, soy sauce, honey, and chili-garlic sauce to the bowl with the cornstarch mixture. Whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "2 tbsp ketchup\n1 ½ tbsp soy sauce\n1 tbsp honey\n1 tsp chili-garlic sauce"
    },
    {
      "id": 321672,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321673,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels, then cut into bite-sized pieces.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 321674,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper to the skillet; stir-fry until chicken is just cooked through, about 5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 321675,
      "primary_message": "When the chicken is done, add the stir-fry sauce, and stir to combine. Reduce heat to low and let simmer, stirring occasionally, until the sauce thickens and coats the chicken, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 321676,
      "primary_message": "To serve, divide rice, dressed slaw, and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
