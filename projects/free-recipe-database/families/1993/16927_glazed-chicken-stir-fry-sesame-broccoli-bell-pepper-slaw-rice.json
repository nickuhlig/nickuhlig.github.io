  "instructions": [
    {
      "id": 321761,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 321762,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 321763,
      "primary_message": "Meanwhile, place vinegar, oil, soy sauce, and chili-garlic sauce in a large bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup rice vinegar\n¼ cup toasted sesame oil\n3 tbsp soy sauce\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 321764,
      "primary_message": "Wash, dry, trim, and seed bell peppers. Halve crosswise, then slice into thin strips and add to the bowl with the dressing.",
      "secondary_message": "1 ½ red bell peppers"
    },
    {
      "id": 321765,
      "primary_message": "Wash, dry, peel, and coarsely grate carrots; add to the bowl along with the broccoli slaw. Toss to combine and set aside.",
      "secondary_message": "3 medium carrots\n1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 321766,
      "primary_message": "Peel and mince garlic; place in a small bowl along with cold water (from the tap) and cornstarch. Whisk to combine.",
      "secondary_message": "6 cloves garlic\n3 tbsp water\n1 ½ tsp cornstarch"
    },
    {
      "id": 321767,
      "primary_message": "Add ketchup, soy sauce, honey, and chili-garlic sauce to the bowl with the cornstarch mixture. Whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "⅓ cup ketchup\n¼ cup soy sauce\n3 tbsp honey\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 321768,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321769,
      "primary_message": "While the pot heats up, pat the chicken dry with paper towels, then cut into bite-sized pieces.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 321770,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper to the pot; stir-fry until chicken is just cooked through, 6-7 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 321771,
      "primary_message": "When the chicken is done, add the stir-fry sauce, and stir to combine. Reduce heat to low and let simmer, stirring occasionally, until the sauce thickens and coats the chicken, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 321772,
      "primary_message": "To serve, divide rice, dressed slaw, and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
