  "instructions": [
    {
      "id": 321749,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 321750,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 321751,
      "primary_message": "Meanwhile, place vinegar, oil, soy sauce, and chili-garlic sauce in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup rice vinegar\n3 tbsp toasted sesame oil\n2 tbsp soy sauce\n2 tsp chili-garlic sauce"
    },
    {
      "id": 321752,
      "primary_message": "Wash, dry, trim, and seed bell pepper. Halve crosswise, then slice into thin strips and add to the bowl with the dressing.",
      "secondary_message": "1 red bell pepper"
    },
    {
      "id": 321753,
      "primary_message": "Wash, dry, peel, and coarsely grate carrots; add to the bowl along with the broccoli slaw. Toss to combine and set aside.",
      "secondary_message": "2 medium carrots\n1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 321754,
      "primary_message": "Peel and mince garlic; place in a small bowl along with cold water (from the tap) and cornstarch. Whisk to combine.",
      "secondary_message": "4 cloves garlic\n2 tbsp water\n1 tsp cornstarch"
    },
    {
      "id": 321755,
      "primary_message": "Add ketchup, soy sauce, honey, and chili-garlic sauce to the bowl with the cornstarch mixture. Whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "¼ cup ketchup\n3 tbsp soy sauce\n2 tbsp honey\n2 tsp chili-garlic sauce"
    },
    {
      "id": 321756,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321757,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels, then cut into bite-sized pieces.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 321758,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper to the skillet; stir-fry until chicken is just cooked through, about 5 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 321759,
      "primary_message": "When the chicken is done, add the stir-fry sauce, and stir to combine. Reduce heat to low and let simmer, stirring occasionally, until the sauce thickens and coats the chicken, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 321760,
      "primary_message": "To serve, divide rice, dressed slaw, and chicken between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
