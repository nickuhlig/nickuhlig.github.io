  "instructions": [
    {
      "primary_message": "Small dice butter. Transfer to the bowl of a food processor and set aside to soften, about 30 minutes.",
      "secondary_message": "8 oz butter, salted"
    },
    {
      "primary_message": "Once the butter has softened, wash and dry the fresh produce. (Note: if Fuyu persimmon is unavailable, please substitute with a different crunchy fall fruit such as Asian pear or an apple.)",
      "secondary_message": "1 orange\n1 Fuyu persimmon\n¼ small pkg fresh thyme"
    },
    {
      "primary_message": "Zest orange into the food processor bowl (reserve orange for another use). Add cranberries and process, scraping down sides of the bowl as needed, until the butter is light pink in color and flecked with small pieces of cranberry.",
      "secondary_message": "⅓ cup dried cranberries"
    },
    {
      "primary_message": "Scoop the cranberry-orange butter out onto a serving dish. Using a butter knife, spread the butter out in an even layer, leaving a ½ to 1-inch border around the edge of the dish.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and small dice persimmon; sprinkle over the butter in a single layer.",
      "secondary_message": null
    },
    {
      "primary_message": "Coarsely chop pecans, then sprinkle over the butter along with additional cranberries.",
      "secondary_message": "½ cup candied pecans\n⅓ cup dried cranberries"
    },
    {
      "primary_message": "Slide thyme leaves off the stems; discard the stems. Sprinkle leaves over the butter board, then drizzle with honey. Set aside.",
      "secondary_message": "2 tbsp honey"
    },
    {
      "primary_message": "Cut bread into 1/2-inch thick slices, then cut each slice into 3-4 pieces.",
      "secondary_message": "1 (24 oz) loaf rustic bread loaf"
    },
    {
      "primary_message": "Serve butter board with bread slices for dipping and scooping. Enjoy!",
      "secondary_message": null
    }
  ],
