  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small pot, melt the butter over medium-high heat. Add the sweet rice flour and whisk until a paste forms, about 30 seconds. Continue whisking until paste turns light beige, 2 to 3 minutes. In a slow and steady stream, whisk in stock. Continue to whisk until gravy has thickened and begins to bubble, about 6 minutes. If the gravy is too thick, add more stock, one tablespoon at a time, until desired consistency is reached. Serve.",
      "secondary_message": null
    }
