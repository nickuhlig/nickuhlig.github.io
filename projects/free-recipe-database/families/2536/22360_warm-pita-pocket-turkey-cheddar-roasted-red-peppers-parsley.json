  "instructions": [
    {
      "id": 373676,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 373677,
      "primary_message": "Place mayo, Dijon, and pepper in a medium bowl. Stir to combine.",
      "secondary_message": "2 tsp mayonnaise\n½ tsp Dijon mustard\n1 pinch black pepper"
    },
    {
      "id": 373678,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the mayo mixture.",
      "secondary_message": "¼ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 373679,
      "primary_message": "Pat roasted peppers dry with paper towels, then roughly chop into small pieces. Add to the bowl.",
      "secondary_message": "½ (12 oz) jar roasted red bell peppers"
    },
    {
      "id": 373680,
      "primary_message": "Roughly chop turkey into small pieces. Add to the bowl.",
      "secondary_message": "4 oz oven roasted turkey breast, sliced"
    },
    {
      "id": 373681,
      "primary_message": "Coarsely grate cheese. Add to the bowl and stir to combine the filling.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 373682,
      "primary_message": "Cut pita in half and carefully open the pockets. Divide filling between pockets, then place the filled pitas on a baking sheet pan.",
      "secondary_message": "1 whole grain pita"
    },
    {
      "id": 373683,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping once, until the outside of the pita is crisp and the filling is hot and bubbly, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 373684,
      "primary_message": "To serve, divide pita pockets between plates and enjoy!",
      "secondary_message": null
    }
  ],
