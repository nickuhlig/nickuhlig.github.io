  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position. Preheat oven to 177°C (350°F). Grease 12-cup bundt pan with nonstick cooking spray.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk together white rice flour, corn flour, baking powder, and salt in small bowl. Fit bowl of stand mixer with whisk attachment. Whip eggs on medium speed until combined. In a slow and steady stream, add granulated sugar. Increase mixer speed to high. Whip egg mixture until pale yellow and thick and fluffy, about five minutes. Reduce mixer speed to medium. With mixer running, add dry ingredients. Mix until dry ingredients are combined, about one minute. Add oil in slow and steady steam. Batter will deflate. Increase mixer speed to high. Whip batter until oil is incorporated and batter thickens, about two minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spoon batter into prepared pan. Bake until a cake tester inserted into the center of the cake comes out clean, about 35 minutes. Cool cake in the pan for ten minutes. Invert onto a rack and cool. If desired, sprinkle with confectioners’ sugar before serving.",
      "secondary_message": null
    }
  ],
