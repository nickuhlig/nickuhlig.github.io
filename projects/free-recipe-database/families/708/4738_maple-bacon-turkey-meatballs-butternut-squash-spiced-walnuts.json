  "instructions": [
    {
      "id": 190150,
      "primary_message": "Preheat the oven to 425°F and position rack in the center. Line a baking sheet with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 190151,
      "primary_message": "Wash the butternut squash. Trim off and discard the ends of the squash; halve the squash lengthwise and scrape out the seeds from each half. Peel and cut into ½-inch cubes, about 4 cups.",
      "secondary_message": "1 small butternut squash"
    },
    {
      "id": 190152,
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
      "secondary_message": "¼ small pkg fresh thyme"
    },
    {
      "id": 190153,
      "primary_message": "In a small saucepan, melt the coconut oil over medium heat. Add maple syrup, cinnamon, thyme and salt. Stir to combine then remove from the heat and add to a medium bowl. ",
      "secondary_message": "1 tbsp virgin coconut oil\n2 tbsp pure maple syrup\n⅛ tsp cinnamon\n⅛ tsp salt"
    },
    {
      "id": 190154,
      "primary_message": "Roughly chop walnuts and add to bowl with the coconut oil and spices.",
      "secondary_message": "¼ cup walnuts"
    },
    {
      "id": 190155,
      "primary_message": "Add butternut squash pieces to bowl. Toss to coat and spread out in a single layer on a baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 190156,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add to a medium bowl.",
      "secondary_message": "2 cloves garlic\n1 (1 inch) piece ginger root"
    },
    {
      "id": 190157,
      "primary_message": "Add ground turkey to the bowl with the garlic and ginger.",
      "secondary_message": "¾ lb ground turkey"
    },
    {
      "id": 190158,
      "primary_message": "Mince bacon and add to ground turkey.",
      "secondary_message": "3 slices bacon"
    },
    {
      "id": 190159,
      "primary_message": "Season turkey and bacon with cumin, salt and pepper and stir to combine.",
      "secondary_message": "¼ tsp cumin\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 190160,
      "primary_message": "Form meat mixture into 2-inch size meatballs and place on top of squash.",
      "secondary_message": null
    },
    {
      "id": 190161,
      "primary_message": "Bake for 15-20 minutes, until meatballs are golden brown and cooked through and squash is soft.",
      "secondary_message": null
    },
    {
      "id": 190162,
      "primary_message": "To serve, divide squash, spiced walnuts and meatballs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
