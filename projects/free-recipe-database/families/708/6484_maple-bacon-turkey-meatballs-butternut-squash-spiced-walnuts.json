  "instructions": [
    {
      "id": 190176,
      "primary_message": "Preheat the oven to 425°F and position rack in the center and lower half of the oven. Line 2 large baking sheets with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 190177,
      "primary_message": "Wash the butternut squash. Trim off and discard the ends of the squash; halve the squash lengthwise and scrape out the seeds from each half. Peel and cut into ½-inch cubes, about 2 cups per person.",
      "secondary_message": "3 small butternut squash"
    },
    {
      "id": 190178,
      "primary_message": "Wash and dry thyme. Slide leaves off the stems; discard the stems.",
      "secondary_message": "¾ small pkg fresh thyme"
    },
    {
      "id": 190179,
      "primary_message": "In a small saucepan, melt the coconut oil over medium heat. Add maple syrup, cinnamon, thyme and salt. Stir to combine then remove from the heat and add to a large bowl. ",
      "secondary_message": "3 tbsp virgin coconut oil\n⅓ cup pure maple syrup\n⅜ tsp cinnamon\n⅜ tsp salt"
    },
    {
      "id": 190180,
      "primary_message": "Roughly chop walnuts and add to bowl with the coconut oil and spices.",
      "secondary_message": "¾ cup walnuts"
    },
    {
      "id": 190181,
      "primary_message": "Add butternut squash pieces to bowl. Toss to coat and spread out in a single layer on a baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 190182,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add to a large bowl.",
      "secondary_message": "6 cloves garlic\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 190183,
      "primary_message": "Add ground turkey to the bowl with the garlic and ginger.",
      "secondary_message": "2 ¼ lb ground turkey"
    },
    {
      "id": 190184,
      "primary_message": "Mince bacon and add to ground turkey.",
      "secondary_message": "9 slices bacon"
    },
    {
      "id": 190185,
      "primary_message": "Season turkey and bacon with cumin, salt and pepper and stir to combine.",
      "secondary_message": "¾ tsp cumin\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 190186,
      "primary_message": "Form meat mixture into 2-inch size meatballs and place on top of squash.",
      "secondary_message": null
    },
    {
      "id": 190187,
      "primary_message": "Bake for 15-20 minutes, until meatballs are golden brown and cooked through and squash is soft.",
      "secondary_message": null
    },
    {
      "id": 190188,
      "primary_message": "To serve, divide squash, spiced walnuts and meatballs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
