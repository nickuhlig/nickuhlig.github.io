  "instructions": [
    {
      "id": 327287,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 327288,
      "primary_message": "Pat steak dry with paper towels, cut into 1-inch cubes, and season with salt; thread onto skewers, place on a plate, and drizzle with vinaigrette. (If you don't have skewers, you can cook the steak directly on the grill pan.)",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n1 ½ tbsp balsamic vinaigrette"
    },
    {
      "id": 327289,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 327290,
      "primary_message": "Once the grill pan is hot, coat with oil; add the skewers and cook, turning occasionally, until the steak is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 327291,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 yellow bell pepper\n½ pint grape tomatoes"
    },
    {
      "id": 327292,
      "primary_message": "Using a clean cutting board, trim and medium dice cucumber; trim, seed, and medium dice bell pepper. Place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 327293,
      "primary_message": "Halve tomatoes and add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 327294,
      "primary_message": "Thinly slice olives and add to the bowl.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 327295,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl along with the feta and vinaigrette. Stir to combine the salad.",
      "secondary_message": "½ shallot\n½ (4 oz) pkg crumbled feta cheese\n1 ½ tbsp balsamic vinaigrette"
    },
    {
      "id": 327296,
      "primary_message": "To serve, divide skewers, salad, and tzatziki between plates. Enjoy!",
      "secondary_message": "½ cup tzatziki sauce"
    }
  ],
