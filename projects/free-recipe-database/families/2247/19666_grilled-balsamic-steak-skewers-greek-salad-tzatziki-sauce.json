  "instructions": [
    {
      "id": 327337,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 327338,
      "primary_message": "Pat steak dry with paper towels, cut into 1-inch cubes, and season with salt; thread onto skewers, place on a plate, and drizzle with vinaigrette. (If you don't have skewers, you can cook the steak directly on the grill pan.)",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¼ cup balsamic vinaigrette"
    },
    {
      "id": 327339,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 327340,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add the skewers and cook, turning occasionally, until the steak is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 327341,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 yellow bell peppers\n1 ½ small pkgs grape tomatoes"
    },
    {
      "id": 327342,
      "primary_message": "Using a clean cutting board, trim and medium dice cucumbers; trim, seed, and medium dice bell peppers. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 327343,
      "primary_message": "Halve tomatoes and add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 327344,
      "primary_message": "Thinly slice olives and add to the bowl.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 327345,
      "primary_message": "Peel, halve, and slice shallots into thin half-moons; add to the bowl along with the feta and vinaigrette. Stir to combine the salad.",
      "secondary_message": "2 shallots\n1 ½ (113 g) pkg crumbled feta cheese\n¼ cup balsamic vinaigrette"
    },
    {
      "id": 327346,
      "primary_message": "To serve, divide skewers, salad, and tzatziki between plates. Enjoy!",
      "secondary_message": "1 ½ cups tzatziki sauce"
    }
  ],
