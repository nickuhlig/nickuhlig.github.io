  "instructions": [
    {
      "id": 186342,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n425 g rotini pasta"
    },
    {
      "id": 186343,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 English cucumbers\n3 small pkgs fresh basil\n3 small pkgs chives"
    },
    {
      "id": 186344,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 186345,
      "primary_message": "Add mayo, pine nuts, salt, and pepper to the bowl; stir to combine the dressing.",
      "secondary_message": "½ cup vegan mayonnaise\n⅓ cup pine nuts\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 186346,
      "primary_message": "Trim and small dice cucumbers; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 186347,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186348,
      "primary_message": "Chop chives into small pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186349,
      "primary_message": "Add corn to the pot with the pasta during the last 3 minutes of cooking.",
      "secondary_message": "6 cups frozen corn"
    },
    {
      "id": 186350,
      "primary_message": "When the pasta and corn are done, drain and rinse under cold water; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 186351,
      "primary_message": "To serve, divide pasta salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
