  "instructions": [
    {
      "id": 186322,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n142 g rotini pasta"
    },
    {
      "id": 186323,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 English cucumber\n1 small pkg fresh basil\n1 small pkg chives"
    },
    {
      "id": 186324,
      "primary_message": "Juice lemon into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 186325,
      "primary_message": "Add mayo, pine nuts, salt, and pepper to the bowl; stir to combine the dressing.",
      "secondary_message": "3 tbsp vegan mayonnaise\n⅛ cup pine nuts\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 186326,
      "primary_message": "Trim and small dice cucumber; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 186327,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186328,
      "primary_message": "Chop chives into small pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 186329,
      "primary_message": "Add corn to the pot with the pasta during the last 3 minutes of cooking.",
      "secondary_message": "2 cups frozen corn"
    },
    {
      "id": 186330,
      "primary_message": "When the pasta and corn are done, drain and rinse under cold water; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 186331,
      "primary_message": "To serve, divide pasta salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
