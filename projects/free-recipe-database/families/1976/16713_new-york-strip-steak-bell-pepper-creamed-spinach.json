  "instructions": [
    {
      "id": 272689,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 272690,
      "primary_message": "While the water is heating, finely grate Parmesan; cut cream cheese into small pieces. Place both in a medium bowl and set aside.",
      "secondary_message": "57 g Parmesan cheese\n½ (227 g) block cream cheese"
    },
    {
      "id": 272691,
      "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 272692,
      "primary_message": "Wash the spinach (skip this step if it came pre-washed).",
      "secondary_message": "4 (142 g) pkg baby spinach"
    },
    {
      "id": 272693,
      "primary_message": "Once the water in the pot is boiling, uncover. Working in batches if necessary, add salt and spinach, stirring until wilted, about 1 minute. Drain in a colander and rinse with cold water to cool. (Reserve pot for next step.)",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 272694,
      "primary_message": "Return pot to medium heat. Once the pot is hot, add butter and swirl to coat the bottom. Add onion, garlic, salt, and pepper to the pot; cook, stirring occasionally, until onion is soft, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 272695,
      "primary_message": "Meanwhile, using your hands, squeeze as much water from the spinach as you can. Add spinach to the bowl with the Parmesan and cream cheese.",
      "secondary_message": null
    },
    {
      "id": 272696,
      "primary_message": "Once the onion is soft, add Parmesan, cream cheese, spinach, and milk to the pot. Cook, stirring frequently, until cheeses melt and combine, 3-4 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "237 ml whole milk"
    },
    {
      "id": 272697,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 272698,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 272699,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 272700,
      "primary_message": "Meanwhile, wash and dry bell peppers; trim, seed, and slice into thin strips.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 272701,
      "primary_message": "Return skillet to medium heat; add more butter and swirl to coat the bottom. Add bell pepper and cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 272702,
      "primary_message": "While the pepper is cooking, reheat the spinach, if necessary. (Return the pot to low heat and cook, stirring occasionally, until warmed through, 2-3 minutes.)",
      "secondary_message": null
    },
    {
      "id": 272703,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 272704,
      "primary_message": "Divide steak between plates and top with peppers; serve with spinach on the side. Enjoy!",
      "secondary_message": null
    }
  ],
