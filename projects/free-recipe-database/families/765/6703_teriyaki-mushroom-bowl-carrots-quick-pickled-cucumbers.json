  "instructions": [
    {
      "id": 108006,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "¾ cup jasmine rice\n1 ½ cup water"
    },
    {
      "id": 108007,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "id": 108008,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 caps portobello mushrooms\n½ English cucumber\n1 medium carrot\n¼ small bunch green onions (scallions)\n1 (1 inch) piece ginger root"
    },
    {
      "id": 108009,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 108010,
      "primary_message": "In a medium bowl, combine vinegar, sugar, and salt. Thinly slice the cucumber, add to the bowl, and toss to coat.",
      "secondary_message": "3 tbsp rice vinegar\n1 tbsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 108011,
      "primary_message": "Peel and mince the garlic and the ginger; place in a small bowl. Add soy sauce, brown sugar, and sesame oil to make the teriyaki sauce.",
      "secondary_message": "3 cloves garlic\n2 tbsp soy sauce\n1 tbsp brown sugar\n1 tbsp toasted sesame oil"
    },
    {
      "id": 108012,
      "primary_message": "Remove the stems of the portobello mushrooms; scrape out the gills using a spoon. Cut mushrooms in half and then slice crosswise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 108013,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 108014,
      "primary_message": "Peel and thinly slice onion into half rings.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 108015,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the yellow onions and cook for about 2 minutes. Add the mushrooms and continue cooking until the mushrooms have started to soften, about 6 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 108016,
      "primary_message": "Add beans and teriyaki sauce to the skillet and cook 3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 108017,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 108018,
      "primary_message": "Peel and coarsely grate the carrot.",
      "secondary_message": null
    },
    {
      "id": 108019,
      "primary_message": "Uncover the rice and fluff with a fork, and drizzle with sesame oil and sprinkle with sesame seeds. Fold the oil and seeds into the rice.",
      "secondary_message": "1 tbsp toasted sesame oil\n1 tbsp sesame seeds"
    },
    {
      "id": 108020,
      "primary_message": "To serve, divide rice between bowls and top with mushrooms, cucumbers, carrots, and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
