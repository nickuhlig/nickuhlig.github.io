  "instructions": [
    {
      "id": 502599,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 502600,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 502601,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb new potatoes\n3 medium carrots\n1 lime\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 502602,
      "primary_message": "Halve new potatoes and transfer to another baking sheet.",
      "secondary_message": null
    },
    {
      "id": 502603,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Add to the baking sheet with the potatoes. Season veggies with spices, toss to coat, and spread out in an even layer.",
      "secondary_message": "2 tsp Cajun seasoning\n½ tsp salt\n¼ tsp coriander, ground"
    },
    {
      "id": 502604,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies. Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the veggies start to soften, about 10 minutes. ",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 502605,
      "primary_message": "When the veggies have started to soften, remove baking sheet from the oven, stir, and spread back out into an even layer. Return baking sheet to the oven and continue to roast until fork-tender and golden, 10-15 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 502606,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 502607,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise. Place in a medium bowl, along with cornstarch, salt, and pepper. Toss to coat.",
      "secondary_message": "1 tbsp cornstarch\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 502608,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the tofu and cook until golden, 2-3 minutes per side. Remove to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 502609,
      "primary_message": "While the tofu is cooking, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 502610,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 502611,
      "primary_message": "Zest and juice lime into the bowl.",
      "secondary_message": null
    },
    {
      "id": 502612,
      "primary_message": "When the tofu is done, return the skillet to medium heat, add more butter, and swirl to coat the bottom. Add garlic, cilantro, and lime; cook, stirring constantly, until fragrant, about 30 seconds. Remove from heat and set aside.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 502613,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 502614,
      "primary_message": "To serve, divide roasted veggies and tofu between plates. Top tofu with avocado and cilantro butter. Enjoy!",
      "secondary_message": null
    }
  ],
