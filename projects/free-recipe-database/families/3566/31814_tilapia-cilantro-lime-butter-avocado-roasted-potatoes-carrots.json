  "instructions": [
    {
      "id": 502663,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 502664,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n6 medium carrots\n1 small bunch cilantro\n2 limes\n1 avocado"
    },
    {
      "id": 502665,
      "primary_message": "Halve new potatoes and transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 502666,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Add to the baking sheet with the potatoes. Season veggies with spices, toss to coat, and spread out in an even layer.",
      "secondary_message": "4 tsp Cajun seasoning\n½ tsp salt\n½ tsp coriander, ground"
    },
    {
      "id": 502667,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 502668,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the veggies start to soften, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 502669,
      "primary_message": "When the veggies have started to soften, remove baking sheet from the oven, stir, and spread back out into an even layer. Return baking sheet to the oven and continue to roast until fork-tender and golden, 10-15 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 502670,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 502671,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg tilapia fillet\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 502672,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes. Remove to a clean plate. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 502673,
      "primary_message": "While the fish is cooking, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 502674,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 502675,
      "primary_message": "Zest and juice limes into the bowl.",
      "secondary_message": null
    },
    {
      "id": 502676,
      "primary_message": "When the fish is done, return the skillet to medium heat, add more butter, and swirl to coat the bottom. Add garlic, cilantro, and lime; cook, stirring constantly, until fragrant, about 30 seconds. Remove from heat and set aside.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 502677,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 502678,
      "primary_message": "To serve, divide roasted veggies and tilapia between plates. Top fish with avocado and cilantro butter. Enjoy!",
      "secondary_message": null
    }
  ],
