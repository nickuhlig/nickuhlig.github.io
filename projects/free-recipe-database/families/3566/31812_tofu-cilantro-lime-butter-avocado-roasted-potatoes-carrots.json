  "instructions": [
    {
      "id": 502631,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 502632,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 502633,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n9 medium carrots\n3 limes\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 502634,
      "primary_message": "Halve new potatoes and divide between two additional baking sheets.",
      "secondary_message": null
    },
    {
      "id": 502635,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Add to the baking sheets with the potatoes. Season veggies with spices, toss to coat, and spread out in an even layer.",
      "secondary_message": "2 tbsp Cajun seasoning\n1 ½ tsp salt\n¾ tsp coriander, ground"
    },
    {
      "id": 502636,
      "primary_message": "Cut butter into small pieces and sprinkle over the veggies. Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until the veggies start to soften, about 15 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 502637,
      "primary_message": "When the veggies have started to soften, remove baking sheets from the oven, stir, and spread back out into an even layer. Return baking sheets to the oven and continue to roast until fork-tender and golden, 10-15 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 502638,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 502639,
      "primary_message": "While the skillet heats up, cut the tofu planks in half crosswise. Place in a medium bowl, along with cornstarch, salt, and pepper. Toss to coat.",
      "secondary_message": "3 tbsp cornstarch\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 502640,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add the tofu and cook until golden, 2-3 minutes per side. Remove to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 502641,
      "primary_message": "While the tofu is cooking, peel and mince garlic. Place in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 502642,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 502643,
      "primary_message": "Zest and juice limes into the bowl.",
      "secondary_message": null
    },
    {
      "id": 502644,
      "primary_message": "When the tofu is done, return the skillet to medium heat, add more butter, and swirl to coat the bottom. Add garlic, cilantro, and lime; cook, stirring constantly, until fragrant, about 1 minute. Remove from heat and set aside.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 502645,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 502646,
      "primary_message": "To serve, divide roasted veggies and tofu between plates. Top tofu with avocado and cilantro butter. Enjoy!",
      "secondary_message": null
    }
  ],
