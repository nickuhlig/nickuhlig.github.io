  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the cilantro leaves and tender stems from the thick stems and coarsely chop them. Juice the limes. Peel the garlic. Cut the skinless boneless chicken thighs into 1 1/2-inch cubes.",
      "secondary_message": "½ cup packed cilantro leaves, tender stems\n3 limes\n4 medium cloves garlic\n0.91 kg skinless boneless chicken thighs"
    },
    {
      "id": 1,
      "primary_message": "Place cilantro, lime juice, olive oil, garlic, brown sugar, salt, cumin, and crushed red pepper in the jar of blender. Pureé until smooth. Place chicken cubes in a large resealable plastic bag. Pour in marinade and seal bag, removing as much air as possible. Place in refrigerator and marinate for at least 1 and up to 5 hours.\nIf using wooden skewers, soak in water 30 minutes prior to grilling.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Thread chicken onto skewers, alternating with pepper and onion squares.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all charcoal is lit and covered with gray ash, pour out and spread coals evenly over entire surface of coal grate. Alternatively, set all burners of a gas grill to high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil grilling grate. Grill skewers until well browned on all sides and center of chicken registers between 160-74°C (71°-74°C) on an instant read thermometer, 3-4 minutes per side. Transfer skewers to platter and let rest for 5 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
