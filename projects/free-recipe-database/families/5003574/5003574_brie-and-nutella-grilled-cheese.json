  "instructions": [
    {
      "id": 1,
      "primary_message": "Melt one-third of butter in a large nonstick skillet over medium heat until foaming subsides. Add bread slices and cook, swirling occasionally, until pale golden brown on bottom sides, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer bread to a cutting board, toasted side up. Top 2 slices of bread with sliced Brie. Spread Nutella evenly between 2 remaining slices. Close sandwiches, with both toasted sides facing inward.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Melt additional one-third of butter in skillet and reduce heat to medium-low. Add sandwiches and cook, swirling occasionally, until deep, even golden brown on one side, about 5 minutes. Remove sandwiches, using a flexible metal spatula. Add remaining butter. Return sandwiches to skillet, cooked side up. Cook, swirling occasionally, until second side is deep, even golden brown and cheese is thoroughly melted, about 5 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
