  "ingredients": [
    {
      "ingredient_id": 115,
      "name": "butter",
      "quantity": "2 tbsp"
    },
    {
      "ingredient_id": 1174,
      "name": "crusty French bread",
      "quantity": "4 slices"
    },
    {
      "ingredient_id": 1200,
      "name": "Brie, rind removed",
      "quantity": "2 to 3 oz"
    },
