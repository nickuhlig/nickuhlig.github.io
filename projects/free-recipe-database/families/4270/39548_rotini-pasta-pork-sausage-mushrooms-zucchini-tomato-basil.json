  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ½-cup pasta water before draining.)",
      "secondary_message": "salt\n15 oz rotini pasta"
    },
    {
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "primary_message": "Preheat another large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pot is hot, add onion, garlic, sausage, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 ½ lb ground pork sausage\nsalt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 ½ lb white mushrooms\n1 small pkg fresh basil"
    },
    {
      "primary_message": "Trim and medium dice zucchini. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "primary_message": "When the sausage is done, add zucchini and mushrooms to the pot. Cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "When the veggies are done, add tomato sauce to the pot, then stir to combine. Cook, stirring occasionally, until sauce thickens slightly, 3-4 minutes. ",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "primary_message": "Meanwhile, pick basil leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "primary_message": "Add drained pasta, reserved pasta water, and basil to the pot. Continue to cook, stirring frequently, until heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
