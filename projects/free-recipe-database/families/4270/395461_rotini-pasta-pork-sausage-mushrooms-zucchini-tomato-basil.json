  "instructions": [
    {
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ¼-cup pasta water before draining.)",
      "secondary_message": "salt\n142 g rotini pasta"
    },
    {
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add onion, garlic, sausage, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "227 g ground pork sausage\nsalt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n227 g white mushrooms\n½ small pkg fresh basil"
    },
    {
      "primary_message": "Trim and medium dice zucchini. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "primary_message": "When the sausage is done, add zucchini and mushrooms to the skillet. Cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "When the veggies are done, add tomato sauce to the skillet, then stir to combine. Cook, stirring occasionally, until sauce thickens slightly, 2-3 minutes. ",
      "secondary_message": "1 (221 g) can tomato sauce"
    },
    {
      "primary_message": "Meanwhile, pick basil leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "primary_message": "Add drained pasta, reserved pasta water, and basil to the skillet. Continue to cook, stirring frequently, until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
