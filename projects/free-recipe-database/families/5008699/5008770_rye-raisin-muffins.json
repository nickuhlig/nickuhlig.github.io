  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 205°C (400°F). Line 12 muffin cups with paper liners or grease with butter. In a medium bowl, whisk together rye flour, whole wheat flour, baking powder, baking soda, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk eggs until lightly beaten. Whisk in milk, oil, and molasses. Add dry ingredients and stir until just combined. Stir in raisins. Spoon batter into prepared muffin tins. Sprinkle top of each muffin with sugar. Bake until puffed and golden and a cake tester inserted into the middle of a muffin comes out clean, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Let cool 10 minutes in pan then transfer to a wire rack to finish cooling. Muffins will keep in an airtight container for up to three days.",
      "secondary_message": null
    }
  ],
