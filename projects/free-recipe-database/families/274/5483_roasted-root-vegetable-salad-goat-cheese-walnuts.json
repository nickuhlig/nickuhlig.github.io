  "instructions": [
    {
      "id": 65776,
      "primary_message": "Preheat oven to 250°C (475°F) and position rack in the centre. Place a baking sheet pan in the oven to warm up.",
      "secondary_message": ""
    },
    {
      "id": 65775,
      "primary_message": "Peel, cut into thin wedges, and transfer onion to a large bowl.",
      "secondary_message": "1 ½ medium red onion"
    },
    {
      "id": 65774,
      "primary_message": "Wash and dry beets, carrots, celery, potatoes, and thyme.",
      "secondary_message": "6 medium beets\n6 medium carrots\n3 sticks celery\n3 medium yellow potatoes\n1 ½ small pkg fresh thyme"
    },
    {
      "id": 65773,
      "primary_message": "Peel and cut beets into thin wedges; add to bowl with onion. Peel and cut carrots diagonally into ⅔ cm thick rounds; add to bowl. Cut celery crosswise into ⅔ cm thick pieces; add to bowl. Cut potatoes into thin wedges; add to bowl. Slide leaves off most of the thyme stems (saving a couple stems for garnishing); add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 65772,
      "primary_message": "Drizzle vegetables with olive oil and season with salt, and pepper; toss to coat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 65771,
      "primary_message": "Remove sheet from oven and, using a paper towel, rub with a little olive oil. Place vegetables on sheet and spread out. Place in the oven and roast until vegetables are tender, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 65770,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 65769,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "1 ½ cups walnuts"
    },
    {
      "id": 65768,
      "primary_message": "Add walnuts to skillet and, stirring constantly, cook until toasted, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 65767,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, olive oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "6 cloves garlic\n9 tbsp extra virgin olive oil\n3 tbsp balsamic vinegar\n¾ tsp Dijon mustard\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 65766,
      "primary_message": "Serve salad on a plate or in a bowl, sprinkle with walnuts, crumble goat cheese over top, drizzle with dressing, and garnish with remaining thyme. Enjoy!",
      "secondary_message": "1 ½ (114 g) log goat cheese"
    }
  ],
