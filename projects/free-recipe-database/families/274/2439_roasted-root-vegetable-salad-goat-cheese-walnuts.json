  "instructions": [
    {
      "id": 23532,
      "primary_message": "Preheat oven to 475°F and position rack in the centre. Place a baking sheet pan in the oven to warm up.",
      "secondary_message": ""
    },
    {
      "id": 23533,
      "primary_message": "Peel, cut into thin wedges, and transfer onion to a large bowl.",
      "secondary_message": "½ medium red onion\r\n"
    },
    {
      "id": 23534,
      "primary_message": "Wash and dry beets, carrots, celery, potato, and thyme.",
      "secondary_message": "2 medium beets\r\n2 medium carrots\r\n1 stick celery\r\n1 medium yellow potato\r\n½ small pkg fresh thyme"
    },
    {
      "id": 23535,
      "primary_message": "Peel and cut beets into thin wedges; add to bowl with onion. Peel and cut carrots diagonally into ¼ inch thick rounds; add to bowl. Cut celery crosswise into ¼ inch thick pieces; add to bowl. Cut potato into thin wedges; add to bowl. Slide leaves off most of the thyme stems (saving a couple stems for garnishing); add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 23536,
      "primary_message": "Drizzle vegetables with olive oil and season with salt, and pepper; toss to coat.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n¼ tsp salt\r\n⅛ tsp black pepper "
    },
    {
      "id": 23537,
      "primary_message": "Remove sheet from oven and, using a paper towel, rub with a little olive oil. Place vegetables on sheet and spread out. Place in the oven and roast until vegetables are tender, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23539,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 23540,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "½ cup walnuts\r\n"
    },
    {
      "id": 23541,
      "primary_message": "Add walnuts to skillet and, stirring constantly, cook until toasted, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 23542,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, olive oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "2 cloves garlic\r\n3 tbsp extra virgin olive oil\r\n1 tbsp balsamic vinegar\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 23543,
      "primary_message": "Serve salad on a plate or in a bowl, sprinkle with walnuts, crumble goat cheese over top, drizzle with dressing, and garnish with remaining thyme. Enjoy!",
      "secondary_message": "½ (4 oz) log goat cheese\r\n"
    }
  ],
