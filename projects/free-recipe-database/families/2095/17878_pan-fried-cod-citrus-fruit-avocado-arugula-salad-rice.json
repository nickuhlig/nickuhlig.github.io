  "instructions": [
    {
      "id": 289412,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 289413,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and spread it out on a large baking sheet pan to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 289414,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 oranges\n1 ½ limes\n3 grapefruits\n1 ½ English cucumbers\n1 ½ avocados\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 289415,
      "primary_message": "Zest and juice half of the oranges into a large bowl. (Set remaining oranges aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 289416,
      "primary_message": "Juice limes into the bowl with the orange zest and juice. Add oil, honey, and salt; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp honey\n¾ tsp salt"
    },
    {
      "id": 289417,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons; peel and mince garlic. Add both to the bowl with the dressing. ",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 289418,
      "primary_message": "Cut off skin and white pith from the remaining oranges and the grapefruits; slice into thin rounds. Add both to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 289419,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 289420,
      "primary_message": "While the skillet heats up, pat the cod dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb cod fillet\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 289421,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add fish and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 289422,
      "primary_message": "Meanwhile, trim, halve, and slice cucumbers crosswise into thin half-moons; add to the bowl with the dressing and citrus fruit.",
      "secondary_message": null
    },
    {
      "id": 289423,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 289424,
      "primary_message": "Once the cod is done, use your fingers to flake the fish into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 289425,
      "primary_message": "Add arugula to the bowl and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 289426,
      "primary_message": "To serve, divide cooled rice between bowls and top with cod and citrus salad. Enjoy!",
      "secondary_message": null
    }
  ],
