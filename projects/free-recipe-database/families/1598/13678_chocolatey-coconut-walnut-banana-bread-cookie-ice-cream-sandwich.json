  "instructions": [
    {
      "id": 227570,
      "primary_message": "Preheat oven to 175°C (350°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 227571,
      "primary_message": "Peel banana, break into chunks, and place in a medium bowl.",
      "secondary_message": "½ banana"
    },
    {
      "id": 227572,
      "primary_message": "Add sugar, oil, and vanilla to the bowl with the banana. Crush with a fork or potato masher until smooth.",
      "secondary_message": "¼ cup brown sugar\n1 tbsp virgin coconut oil\n½ tsp vanilla extract"
    },
    {
      "id": 227573,
      "primary_message": "Roughly chop walnuts. Add to the bowl along with the coconut; stir to combine.",
      "secondary_message": "⅓ cup walnuts\n⅓ cup shredded unsweetened coconut"
    },
    {
      "id": 227574,
      "primary_message": "Place flour, cocoa powder, cornstarch, baking powder, baking soda, and salt in a small bowl; stir to combine.",
      "secondary_message": "¼ cup all-purpose flour\n1 tbsp cocoa powder\n¼ tsp cornstarch\n⅛ tsp baking powder\n⅛ tsp baking soda\n1 pinch salt"
    },
    {
      "id": 227575,
      "primary_message": "Add flour mixture to the bowl with the banana and stir to combine the cookie batter.",
      "secondary_message": null
    },
    {
      "id": 227576,
      "primary_message": "Using a scant ¼-cup measure, divide batter into 4 portions and place on the baking sheet. Using a rubber spatula or the back of a spoon, spread each cookie into a 2-inch circle.",
      "secondary_message": null
    },
    {
      "id": 227577,
      "primary_message": "Place baking sheet in the oven and bake until cookies are slightly firm around the edges, about 15 minutes. Remove from oven and let cool to room temperature.",
      "secondary_message": null
    },
    {
      "id": 227578,
      "primary_message": "Once cool, arrange half the cookies on a flat surface, bottom-side facing up. Place a scoop of ice cream on top of each, then cover with remaining cookies. Gently press cookies into the ice cream to secure the sandwiches.",
      "secondary_message": "177 ml vanilla ice cream"
    },
    {
      "id": 227579,
      "primary_message": "To serve, divide ice cream sandwiches between plates and enjoy!",
      "secondary_message": null
    }
  ],
