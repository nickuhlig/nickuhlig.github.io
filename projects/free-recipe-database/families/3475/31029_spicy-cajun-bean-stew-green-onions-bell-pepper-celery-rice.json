  "instructions": [
    {
      "id": 501991,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 501992,
      "primary_message": "While the water is heating, wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n6 sticks celery\n1 small bunch green onions (scallions)"
    },
    {
      "id": 501993,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 501994,
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 501995,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 501996,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 501997,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Set remaining green onions aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 501998,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until tender, 4-5 minutes.",
      "secondary_message": "¼ cup butter, unsalted\n2 tbsp Cajun seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 501999,
      "primary_message": "Meanwhile, drain tomatoes in a colander. Set aside to drain further.",
      "secondary_message": "1 ½ (14.5 oz) cans diced tomatoes"
    },
    {
      "id": 502000,
      "primary_message": "When the veggies are tender, add flour to the pot. Cook, stirring frequently, until golden brown, about 2 minutes.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 502001,
      "primary_message": "Add tomatoes, broth, soy sauce, and hot sauce to the pan, then stir to combine the stew. Cook, stirring occasionally, until thickened, 6-7 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 tbsp soy sauce\n1 tbsp hot sauce"
    },
    {
      "id": 502002,
      "primary_message": "Meanwhile, drain and rinse beans in a colander.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 502003,
      "primary_message": "When the stew has thickened, add beans and cream to the pot, then stir to combine. Reduce heat to low and cook, stirring occasionally, until beans are warmed through, 7-8 minutes. Remove from heat.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 502004,
      "primary_message": "To serve, divide the bean stew between bowls. Place a scoop of rice in the center of each bowl and top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
