  "instructions": [
    {
      "id": 502103,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 502104,
      "primary_message": "While the water is heating, wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n4 sticks celery\n1 small bunch green onions (scallions)"
    },
    {
      "id": 502105,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 502106,
      "primary_message": "Meanwhile, trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 502107,
      "primary_message": "Trim and small dice celery. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 502108,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 502109,
      "primary_message": "While the pot heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl. (Set remaining green onions aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 502110,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until tender, 3-4 minutes.",
      "secondary_message": "¼ cup butter, unsalted\n4 tsp Cajun seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 502111,
      "primary_message": "Meanwhile, drain tomatoes in a colander. Set aside to drain further.",
      "secondary_message": "1 (398 ml) can diced tomatoes"
    },
    {
      "id": 502112,
      "primary_message": "When the veggies are tender, add flour to the pot. Cook, stirring frequently, until golden brown, 1-2 minutes.",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 502113,
      "primary_message": "Add tomatoes, broth, Worcestershire, and hot sauce to the pot, then stir to combine the stew. Cook, stirring occasionally, until thickened, 5-6 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n4 tsp Worcestershire sauce\n2 tsp hot sauce"
    },
    {
      "id": 502114,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 502115,
      "primary_message": "When the stew has thickened, add shrimp and cream to the pot, then stir to combine. Reduce heat to low and cook, stirring occasionally, until shrimp are cooked through, 6-7 minutes. Remove from heat.",
      "secondary_message": "237 ml heavy whipping cream"
    },
    {
      "id": 502116,
      "primary_message": "To serve, divide the shrimp stew between bowls. Place a scoop of rice in the center of each bowl and top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
