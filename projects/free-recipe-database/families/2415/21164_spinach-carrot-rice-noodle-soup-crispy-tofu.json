  "instructions": [
    {
      "id": 438113,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 438114,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "4 medium carrots\n2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 438115,
      "primary_message": "Peel and trim carrots, then slice crosswise into thin rounds. Place in a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 438116,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 438117,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in a medium bowl, sprinkle with salt and cornstarch, then gently toss to coat.",
      "secondary_message": "1 tsp salt\n2 tbsp cornstarch"
    },
    {
      "id": 438118,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning occasionally, until browned and crispy, 5-7 minutes. Return crispy tofu to the bowl.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 438119,
      "primary_message": "Meanwhile, peel and mince ginger and garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 438120,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 438121,
      "primary_message": "Once the pot is hot, add additional oil and swirl to coat the bottom. Add ginger and garlic; cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 438122,
      "primary_message": "Add broth to the pot and bring to a boil over medium-high heat.",
      "secondary_message": "1893 ml chicken or vegetable broth"
    },
    {
      "id": 438123,
      "primary_message": "Once the broth is boiling, add carrots, noodles, and soy sauce; stir to combine the soup. Bring to a simmer over medium heat and continue to cook until noodles are tender, 8-10 minutes more.",
      "secondary_message": "283 g flat rice (pad thai) noodles\n3 tbsp soy sauce"
    },
    {
      "id": 438124,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces; add to the soup and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 438125,
      "primary_message": "Add spinach to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 438126,
      "primary_message": "To serve, divide soup between bowls. Top with crispy tofu and enjoy!",
      "secondary_message": null
    }
  ],
