  "instructions": [
    {
      "id": 123376,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n1 small bunch asparagus\n½ small pkg fresh sage\n½ small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 123377,
      "primary_message": "Small dice potatoes; transfer to a large pot, cover with water and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 123378,
      "primary_message": "Set aside one sage leaf per serving as garnish; mince the remaining leaves. ",
      "secondary_message": null
    },
    {
      "id": 123379,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper. Sprinkle one side of each fillet with the minced sage, pressing to adhere. ",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 123380,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 123381,
      "primary_message": "Wrap the prosciutto around the chicken fillets, pressing to adhere.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 123382,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken fillets to the skillet and cook for 3-5 minutes per side, until chicken is cooked through. Transfer chicken to a plate and cover with foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 123383,
      "primary_message": "Peel and mince the shallot. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 123384,
      "primary_message": "Return the skillet to medium heat. Add the shallot to the skillet and cook, stirring occasionally, until softened, about 2 minutes. Whisk in the flour and cook for 1 additional minute. ",
      "secondary_message": "1 ½ tsp all-purpose flour"
    },
    {
      "id": 123385,
      "primary_message": "Whisk in the broth, scraping up the brown bits from the bottom of the skillet. Bring to a simmer, then cook, stirring often, for 2-3 minutes until the sauce is thickened.",
      "secondary_message": "177 ml chicken or vegetable broth"
    },
    {
      "id": 123386,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves; add to the skillet and stir to combine, reserving some for garnish. ",
      "secondary_message": null
    },
    {
      "id": 123387,
      "primary_message": "Juice the lemon into the skillet and whisk to combine. Return the chicken to the skillet and simmer for 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 123388,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Add asparagus to the pot with the potatoes during the last 3 minutes of cooking.",
      "secondary_message": null
    },
    {
      "id": 123389,
      "primary_message": "When the asparagus is done, remove with tongs and set aside on a plate. Drain the potatoes and add back to the pot along with the butter and salt; stir to combine. ",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 123390,
      "primary_message": "To serve, divide the potatoes, asparagus, and chicken between plates. Spoon the sauce over the top of the chicken and veggies. Garnish with fresh sage leaves and minced parsley. Enjoy! ",
      "secondary_message": null
    }
  ],
