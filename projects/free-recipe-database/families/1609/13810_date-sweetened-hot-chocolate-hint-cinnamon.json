  "instructions": [
    {
      "id": 229466,
      "primary_message": "Place milk and dates in a medium saucepan and bring to a boil over medium-high heat. (Watch the milk carefully, so it does not boil over.) Remove from heat and allow to cool slightly, about 5 minutes.",
      "secondary_message": "24 fl oz (3 cups) whole milk\n⅓ cup medjool dates, pitted"
    },
    {
      "id": 229467,
      "primary_message": "Transfer cooled date-milk to a blender. Add cocoa powder, vanilla, cinnamon, and salt; blend on high until very smooth, about 2 minutes.",
      "secondary_message": "2 tbsp cocoa powder\n¼ tsp vanilla extract\n⅛ tsp cinnamon, ground\n1 pinch salt"
    },
    {
      "id": 229468,
      "primary_message": "Return hot chocolate mixture to the saucepan and reheat over medium-high heat to preferred temperature.",
      "secondary_message": null
    },
    {
      "id": 229469,
      "primary_message": "To serve, divide hot chocolate between mugs and enjoy!",
      "secondary_message": null
    }
