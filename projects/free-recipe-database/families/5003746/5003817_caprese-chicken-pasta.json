  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the skinless boneless chicken breast of visible fat. Tear the lightly packed basil leaves. Halve the cherry tomatoes. Cut the fresh mozzarella into 1/2-inch pieces. Pick the basil leaves from the stems and roughly chop them.",
      "secondary_message": "0.57 kg skinless boneless chicken breast\n¼ cup lightly packed basil leaves\n946 ml cherry tomatoes\n340 g fresh mozzarella\n1 cup lightly packed basil leaves"
    },
    {
      "id": 1,
      "primary_message": "Place chicken breasts in saucepan with chicken broth, basil, 2 teaspoons kosher salt, peppercorns, and zest. If needed, add water to just cover chicken. Heat over medium heat until broth comes to simmer. Reduce heat to low and gently simmer until chicken reads 68°C on instant read thermometer, about 10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place chicken on cutting board and when cool enough to handle, use 2 forks to shred chicken into chunky bite-size pieces. Return chicken to broth off heat until ready to use.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In medium bowl, slowly whisk olive oil into balsamic vinegar until combined. Add red pepper flakes, season to taste with salt and pepper, and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cook pasta in salted water according to package directions. Drain. Using slotted spoon, remove chicken from broth. Reserve broth for another use.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Return pasta to pot and toss with chicken, tomatoes, mozzarella, basil, and balsamic dressing. Season to taste with salt and pepper and serve.",
      "secondary_message": null
    }
  ],
