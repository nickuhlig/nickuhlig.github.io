  "instructions": [
    {
      "primary_message": "Stir the soup, chiles, beans, ½ teaspoon chili powder, garlic powder, broth and picante sauce in a medium bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Season the chicken as desired, then sprinkle with the remaining chili powder. Heat the oil in a 12-inch skillet over medium-high heat. Add the chicken and cook for 6 minutes or until the chicken is well browned on both sides (to prevent sticking, make sure the skillet and oil are hot before adding the chicken). Remove the chicken from the skillet.",
      "secondary_message": null
    },
    {
      "primary_message": "Add the rice to the skillet and cook over medium-high heat for 2 minutes or until lightly browned, stirring often. Stir in the soup mixture and heat to a boil. Reduce the heat to low. Cover and cook for 10 minutes, stirring occasionally.",
      "secondary_message": null
    },
    {
      "primary_message": "Return the chicken to the skillet. Cover and cook for 10 minutes or until the chicken is cooked through and the rice is tender. Season to taste and serve hot.",
      "secondary_message": null
    }
  ],
