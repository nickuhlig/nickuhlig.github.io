  "instructions": [
    {
      "id": 188548,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ½ cup of pasta cooking water before draining.)",
      "secondary_message": "1 tsp salt\n4 oz linguine pasta"
    },
    {
      "id": 188549,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188550,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 188551,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 188552,
      "primary_message": "Add chicken to the skillet and cook until golden brown, about 2 minutes per side (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 188553,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 188554,
      "primary_message": "Wash and dry lemons. Zest and juice 1 lemon into a small bowl. Slice remaining half a lemon into rounds and set aside for garnish.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 188555,
      "primary_message": "Reduce heat to low, then add garlic, lemon zest and juice, and water to the skillet with the chicken. Stir to combine.",
      "secondary_message": "2 tbsp water"
    },
    {
      "id": 188556,
      "primary_message": "Cover skillet and cook, turning chicken once and basting occasionally, until it's cooked through, about 10 minutes. Remove chicken to a plate and cover loosely with foil.",
      "secondary_message": null
    },
    {
      "id": 188557,
      "primary_message": "Return skillet (with leftover cooking juices) to medium heat. Add ricotta and reserved pasta cooking water. Whisk until smooth.",
      "secondary_message": "½ (15 oz) pkg ricotta cheese"
    },
    {
      "id": 188558,
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). While stirring, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 188559,
      "primary_message": "Add pasta to the skillet with spinach-ricotta sauce; toss to combine and cook until heated through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 188560,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 188561,
      "primary_message": "To serve, divide pasta and chicken between bowls and garnish with lemon rounds. Enjoy!",
      "secondary_message": null
    }
  ],
