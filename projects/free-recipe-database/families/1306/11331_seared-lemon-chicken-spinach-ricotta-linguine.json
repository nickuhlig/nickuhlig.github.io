  "instructions": [
    {
      "id": 188660,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1½ cups of pasta cooking water before draining.)",
      "secondary_message": "1 tbsp salt\n340 g linguine pasta"
    },
    {
      "id": 188661,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 188662,
      "primary_message": "Preheat a second large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188663,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 188664,
      "primary_message": "Working in batches if necessary, add chicken to the pot and cook until golden brown, about 2 minutes per side. If working in batches, transfer chicken to a plate and cover with foil (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 188665,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 188666,
      "primary_message": "Wash and dry lemons. Zest and juice 3 lemons into a small bowl. Slice remaining lemon into rounds and set aside for garnish.",
      "secondary_message": "4 lemons"
    },
    {
      "id": 188667,
      "primary_message": "Reduce heat to low and return chicken to the pot (if necessary). Add garlic, lemon zest and juice, and water to the pot; stir to combine.",
      "secondary_message": "⅓ cup water"
    },
    {
      "id": 188668,
      "primary_message": "Cover the pot and cook, turning chicken once and basting occasionally, until it's cooked through, about 15 minutes. Remove chicken to a plate and cover with foil.",
      "secondary_message": null
    },
    {
      "id": 188669,
      "primary_message": "Return pot (with leftover cooking juices) to medium heat. Add ricotta and reserved pasta cooking water. Whisk until smooth.",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese"
    },
    {
      "id": 188670,
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). While stirring, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 188671,
      "primary_message": "Add pasta to the pot with spinach-ricotta sauce; toss to combine and cook until heated through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 188672,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 188673,
      "primary_message": "To serve, divide pasta and chicken between bowls and garnish with lemon rounds. Enjoy!",
      "secondary_message": null
    }
  ],
