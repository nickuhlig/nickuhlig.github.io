  "instructions": [
    {
      "id": 188646,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "2 tsp salt\n227 g linguine pasta"
    },
    {
      "id": 188647,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 188648,
      "primary_message": "Meanwhile, holding a knife parallel to the cutting board, cut chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 188649,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 188650,
      "primary_message": "Add chicken to the skillet and cook until golden brown, about 2 minutes per side (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 188651,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 188652,
      "primary_message": "Wash and dry lemons. Zest and juice 2 lemons into a small bowl. Slice remaining lemon into rounds and set aside for garnish.",
      "secondary_message": "3 lemons"
    },
    {
      "id": 188653,
      "primary_message": "Reduce heat to low, then add garlic, lemon zest and juice, and water to the skillet with the chicken. Stir to combine.",
      "secondary_message": "¼ cup water"
    },
    {
      "id": 188654,
      "primary_message": "Cover skillet and cook, turning chicken once and basting occasionally, until it's cooked through, 12-15 minutes. Remove chicken to a plate and cover with foil.",
      "secondary_message": null
    },
    {
      "id": 188655,
      "primary_message": "Return skillet (with leftover cooking juices) to medium heat. Add ricotta and reserved pasta cooking water. Whisk until smooth.",
      "secondary_message": "1 (425 g) pkg ricotta cheese"
    },
    {
      "id": 188656,
      "primary_message": "Wash and dry the spinach (skip if it came pre-washed). While stirring, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 188657,
      "primary_message": "Add pasta to the skillet with spinach-ricotta sauce; toss to combine and cook until heated through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 188658,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 188659,
      "primary_message": "To serve, divide pasta and chicken between bowls and garnish with lemon rounds. Enjoy!",
      "secondary_message": null
    }
  ],
