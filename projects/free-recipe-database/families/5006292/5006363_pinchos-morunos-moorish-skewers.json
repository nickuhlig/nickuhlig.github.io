  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the pork tenderloin of silverskin and excess fat. Mince the garlic.",
      "secondary_message": "0.91 kg pork tenderloin\n4 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "To make the brine, whisk salt and sugar in cold water until completely dissolved. Place tenderloin in brine and place in refrigerator for 1 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While pork is brining, mix together olive oil, garlic, lemon juice, paprika, cumin, coriander, oregano, turmeric, salt, thyme, and black pepper in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove tenderloin from brine. Pat dry with paper towel and cut into 4 cm cubes. Place pork in a large resealable bag and pour in spice mixture. Seal bag and toss to thoroughly coat pork in marinade. Place in the refrigerator and marinate for 1 to 2 hours. Meanwhile, soak wooden skewers in cold water.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove pork from refrigerator and thread onto pre-soaked wooden skewers. Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over entire surface of coal grate. Alternatively, set all the burners of a gas grill to high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Grill skewers over high heat, turning occasionally, until browned on all sides and an instant read thermometer inserted into thickest portion of pork registers 60°C (60ºC), 10 to 15 minutes total.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Remove to a platter, let rest for 5 minutes, then serve with lemon wedges.",
      "secondary_message": null
    }
  ],
