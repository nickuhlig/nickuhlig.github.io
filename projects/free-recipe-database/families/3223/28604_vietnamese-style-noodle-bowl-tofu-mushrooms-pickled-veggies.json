  "instructions": [
    {
      "id": 456995,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 456996,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 456997,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 bunch radish\n1 lb cremini mushrooms\n2 limes\n1 small pkg fresh mint"
    },
    {
      "id": 456998,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup rice vinegar\n2 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 456999,
      "primary_message": "Peel, trim, and cut carrots crosswise into thin rounds. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 457000,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 457001,
      "primary_message": "Place fish sauce, soy sauce, oil, sugar, and crushed red pepper in another medium bowl. Whisk to combine the marinade.",
      "secondary_message": "¼ cup fish sauce\n2 tbsp soy sauce\n2 tbsp neutral vegetable oil\n4 tsp brown sugar\n½ tsp crushed red pepper"
    },
    {
      "id": 457002,
      "primary_message": "Medium dice tofu and add to the bowl with the marinade. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 457003,
      "primary_message": "Quarter mushrooms, add to the bowl with the tofu, and gently stir to combine. Transfer tofu and mushrooms to the reserved baking sheet and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 457004,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until mushrooms are tender and tofu is golden, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 457005,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "10 oz flat rice (pad thai) noodles"
    },
    {
      "id": 457006,
      "primary_message": "While the noodles are soaking, juice limes into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 457007,
      "primary_message": "Peel and mince shallot and garlic. Add both to the bowl with the lime juice along with fish sauce, sugar, and crushed red pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 shallot\n2 cloves garlic\n¼ cup fish sauce\n2 tsp brown sugar\n1 tsp crushed red pepper"
    },
    {
      "id": 457008,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. When the tofu and mushrooms are done, add half of the mint to the baking sheet, then stir to combine. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 457009,
      "primary_message": "Divide noodles between bowls; top with tofu, mushrooms, pickled veggies, and reserved mint. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
