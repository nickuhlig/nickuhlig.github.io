  "instructions": [
    {
      "id": 457429,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 457430,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 457431,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n1 ½ bunches radish\n0.68 kg cremini mushrooms\n3 limes\n1 small pkg fresh mint"
    },
    {
      "id": 457432,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "¾ cup rice vinegar\n1 tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 457433,
      "primary_message": "Peel, trim, and cut carrots crosswise into thin rounds. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 457434,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 457435,
      "primary_message": "Place soy sauce, oil, sugar, and crushed red pepper in a large bowl. Whisk to combine the marinade.",
      "secondary_message": "½ cup soy sauce\n3 tbsp neutral vegetable oil\n1 ½ tbsp brown sugar\n¾ tsp crushed red pepper"
    },
    {
      "id": 457436,
      "primary_message": "Medium dice tofu and add to the bowl with the marinade. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 457437,
      "primary_message": "Quarter mushrooms, add to the bowl with the tofu, and gently stir to combine. Divide tofu and mushrooms between the reserved baking sheet and another large baking sheet; spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 457438,
      "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until mushrooms are tender and tofu is golden, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 457439,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 457440,
      "primary_message": "While the noodles are soaking, juice limes into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 457441,
      "primary_message": "Peel and mince shallot and garlic. Add both to the bowl with the lime juice along with soy sauce, sugar, and crushed red pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 shallot\n3 cloves garlic\n⅓ cup soy sauce\n2 ½ tsp brown sugar\n1 ½ tsp crushed red pepper"
    },
    {
      "id": 457442,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. When the tofu and mushrooms are done, add half of the mint to the baking sheets, then stir to combine. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 457443,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 457444,
      "primary_message": "Divide noodles between bowls; top with tofu, mushrooms, pickled veggies, reserved mint, and peanuts. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
