  "instructions": [
    {
      "id": 457025,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 457026,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 457027,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n½ bunch radish\n½ lb cremini mushrooms\n1 lime\n½ small pkg fresh mint"
    },
    {
      "id": 457028,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "¼ cup rice vinegar\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 457029,
      "primary_message": "Peel, trim, and cut carrot crosswise into thin rounds. Add to the bowl with the pickling liquid.",
      "secondary_message": null
    },
    {
      "id": 457030,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 457031,
      "primary_message": "Place soy sauce, oil, sugar, and crushed red pepper in a medium bowl. Whisk to combine the marinade.",
      "secondary_message": "3 tbsp soy sauce\n1 tbsp neutral vegetable oil\n1 ½ tsp brown sugar\n¼ tsp crushed red pepper"
    },
    {
      "id": 457032,
      "primary_message": "Medium dice tofu and add to the bowl with the marinade. (Wipe baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": null
    },
    {
      "id": 457033,
      "primary_message": "Quarter mushrooms, add to the bowl with the tofu, and gently stir to combine. Transfer tofu and mushrooms to the reserved baking sheet and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 457034,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until mushrooms are tender and tofu is golden, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 457035,
      "primary_message": "Meanwhile, fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "5 oz flat rice (pad thai) noodles"
    },
    {
      "id": 457036,
      "primary_message": "While the noodles are soaking, juice lime into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 457037,
      "primary_message": "Peel and mince shallot and garlic. Add both to the bowl with the lime juice along with soy sauce, sugar, and crushed red pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ shallot\n1 clove garlic\n2 tbsp soy sauce\n¾ tsp brown sugar\n½ tsp crushed red pepper"
    },
    {
      "id": 457038,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. When the tofu and mushrooms are done, add half of the mint to the baking sheet, then stir to combine. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 457039,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 457040,
      "primary_message": "Divide noodles between bowls; top with tofu, mushrooms, pickled veggies, reserved mint, and peanuts. Serve with dressing on the side and enjoy!",
      "secondary_message": null
    }
  ],
