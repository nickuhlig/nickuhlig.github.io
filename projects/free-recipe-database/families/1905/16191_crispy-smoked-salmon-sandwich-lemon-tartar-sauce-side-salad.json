  "instructions": [
    {
      "id": 265367,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 bunch radish\n2 tomatoes\n2 avocados\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 265368,
      "primary_message": "Zest lemon into a small bowl (reserve lemon for later use).",
      "secondary_message": null
    },
    {
      "id": 265369,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon zest.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 265370,
      "primary_message": "Mince capers; add to the bowl along with mayo, vinegar, Dijon, and pepper. Whisk to combine the tartar sauce and set aside.",
      "secondary_message": "1 tbsp capers\n⅓ cup mayonnaise\n2 tsp white wine vinegar\n2 tsp Dijon mustard\n⅛ tsp black pepper"
    },
    {
      "id": 265371,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 265372,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add smoked salmon slices to the skillet in a single layer; cook, flipping once, until crispy, about 4 minutes. Remove to a paper towel-lined plate and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 (113 g) pkg smoked salmon"
    },
    {
      "id": 265373,
      "primary_message": "Meanwhile, juice reserved lemon into a large bowl; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 265374,
      "primary_message": "Peel, halve, and thinly slice shallot; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 265375,
      "primary_message": "Trim and thinly slice radishes; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 265376,
      "primary_message": "Small dice one tomato and add to the bowl. Thinly slice remaining tomato and place on a plate for serving.",
      "secondary_message": null
    },
    {
      "id": 265377,
      "primary_message": "Halve avocados and remove pits; scoop out the flesh. Medium dice one avocado and add to the bowl. Thinly slice remaining avocado and add to the plate with the sliced tomato; set aside.",
      "secondary_message": null
    },
    {
      "id": 265378,
      "primary_message": "Separate the lettuce leaves. Set aside 2 leaves per sandwich and chop or tear remaining leaves into bite-sized pieces. Add chopped lettuce to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 265379,
      "primary_message": "Toast buns or rolls (if desired).",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 265380,
      "primary_message": "Place the bottom half of a roll on each plate. Layer with tartar sauce, lettuce, tomato, crispy smoked salmon, and avocado; close with the top half of each roll. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
