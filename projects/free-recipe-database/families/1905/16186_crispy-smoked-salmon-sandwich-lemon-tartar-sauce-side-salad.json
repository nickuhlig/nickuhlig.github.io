  "instructions": [
    {
      "id": 265297,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 ½ bunches radish\n3 tomatoes\n3 avocados\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 265298,
      "primary_message": "Zest lemons into a small bowl (reserve lemons for later use).",
      "secondary_message": null
    },
    {
      "id": 265299,
      "primary_message": "Peel and mince garlic; add to the bowl with the lemon zest.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 265300,
      "primary_message": "Mince capers; add to the bowl along with mayo, vinegar, Dijon, and pepper. Whisk to combine the tartar sauce and set aside.",
      "secondary_message": "1 ½ tbsp capers\n½ cup mayonnaise\n1 tbsp white wine vinegar\n1 tbsp Dijon mustard\n3 pinch black pepper"
    },
    {
      "id": 265301,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 265302,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add smoked salmon slices to the skillet in a single layer; cook, flipping once, until crispy, about 4 minutes. Remove to a paper towel-lined plate and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 265303,
      "primary_message": "Meanwhile, juice reserved lemons into a large bowl; add oil, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 tbsp honey\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 265304,
      "primary_message": "Peel, halve, and thinly slice shallots; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 265305,
      "primary_message": "Trim and thinly slice radishes; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 265306,
      "primary_message": "Small dice half the tomatoes and add to the bowl. Thinly slice remaining tomatoes and place on a plate for serving.",
      "secondary_message": null
    },
    {
      "id": 265307,
      "primary_message": "Halve avocados and remove pits; scoop out the flesh. Medium dice half the avocados and add to the bowl. Thinly slice remaining avocados and add to the plate with the sliced tomato; set aside.",
      "secondary_message": null
    },
    {
      "id": 265308,
      "primary_message": "Separate the lettuce leaves. Set aside 2 leaves per sandwich and chop or tear remaining leaves into bite-sized pieces. Add chopped lettuce to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 265309,
      "primary_message": "Toast buns or rolls (if desired).",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 265310,
      "primary_message": "Place the bottom half of a roll on each plate. Layer with tartar sauce, lettuce, tomato, crispy smoked salmon, and avocado; close with the top half of each roll. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
