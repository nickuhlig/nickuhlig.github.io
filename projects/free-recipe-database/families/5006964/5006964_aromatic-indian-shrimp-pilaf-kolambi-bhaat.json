  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lime. Split the serrano chiles lengthwise. Pick the cilantro leaves and tender stems from the thick stems and chop them. Grate the ginger. Finely chop the onion. Rinse and drain the Basmati rice.",
      "secondary_message": "½ lime\n3 serrano chiles\n2 tbsp fresh cilantro leaves, tender stems\n½ inch piece ginger\n1 cup onion\n2 cups Basmati rice"
    },
    {
      "id": 1,
      "primary_message": "Combine shrimp, turmeric, and lime juice in a bowl and toss to combine. Cover and refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine coconut, chiles, cilantro, garlic, ginger, and 2 tablespoons water in a blender and blend on high speed until smooth, about 1 minute. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil over medium-high heat in a heavy-bottomed saucepan until shimmering. Add the cloves, cinnamon, cardamom, bay leaves and star anise. Cook, stirring, until fragrant, about 1 minute. Add the onions and cook, stirring, until softened and just beginning to brown, about 3 minutes. Add the marinated shrimp and cook, stirring, until fragrant, about 1 minute. Add the ground spice paste and mix through with the shrimp and onion mixture. Stir vigorously until well blended and oil starts separating from the mixture-about 2 minutes. Add rice. Stir gently until the spice mixture coats the grains well. Add 3 cups hot water, 1 cup coconut water, and a teaspoon of salt. Cover and bring to a boil over high heat. Reduce heat to medium-low, remove lid, and let cook without stirring until rice is cooked and water has dried up, about 15 minutes. Serve immediately with papadums and raita.",
      "secondary_message": null
    }
  ],
