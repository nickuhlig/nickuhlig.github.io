  "instructions": [
    {
      "id": 365922,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 tsp salt\n10 oz fettuccine pasta"
    },
    {
      "id": 365923,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "2 medium zucchini squash\n2 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 365924,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 365925,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 365926,
      "primary_message": "Peel, halve, and small dice onion. Add to the bowl. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 365927,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365928,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 365929,
      "primary_message": "While the veggies are cooking, drain and rinse lentils. Set aside to drain further. ",
      "secondary_message": "2 (15 oz) cans lentils"
    },
    {
      "id": 365930,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 365931,
      "primary_message": "When the veggies are soft, add lentils, parsley, Alfredo sauce, and spices to the skillet; stir to combine. Continue to cook, stirring occasionally, until sauce and lentils are warm, about 2 minutes. ",
      "secondary_message": "1 (16 oz) jar alfredo sauce\n1 tsp garlic powder\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 365932,
      "primary_message": "Transfer drained pasta to the skillet and toss to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 365933,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
