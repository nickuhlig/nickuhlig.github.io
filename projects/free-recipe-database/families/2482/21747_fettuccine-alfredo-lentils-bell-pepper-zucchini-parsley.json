  "instructions": [
    {
      "id": 365934,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz fettuccine pasta"
    },
    {
      "id": 365935,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 365936,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 365937,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 365938,
      "primary_message": "Peel, halve, and small dice onions. Add to the bowl. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 365939,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365940,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 5-6 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 365941,
      "primary_message": "While the veggies are cooking, drain and rinse lentils. Set aside to drain further. ",
      "secondary_message": "3 (15 oz) cans lentils"
    },
    {
      "id": 365942,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 365943,
      "primary_message": "When the veggies are soft, add lentils, parsley, Alfredo sauce, and spices to the pot; stir to combine. Continue to cook, stirring occasionally, until sauce and lentils are warm, about 3 minutes. ",
      "secondary_message": "1 ½ (16 oz) jars alfredo sauce\n1 ½ tsp garlic powder\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 365944,
      "primary_message": "Transfer drained pasta to the pot with the sauce and toss to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 365945,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
