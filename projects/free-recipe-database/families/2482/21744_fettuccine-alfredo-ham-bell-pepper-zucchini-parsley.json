  "instructions": [
    {
      "id": 365898,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside. ",
      "secondary_message": "1 ½ tsp salt\n15 oz fettuccine pasta"
    },
    {
      "id": 365899,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 365900,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 365901,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 365902,
      "primary_message": "Peel, halve, and small dice onions; add to the bowl. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 365903,
      "primary_message": "Small dice ham and add to the bowl with the veggies. ",
      "secondary_message": "24 oz ham steak, boneless"
    },
    {
      "id": 365904,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365905,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies and ham; cook, stirring occasionally, until veggies soften, about 6 minutes. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 365906,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 365907,
      "primary_message": "When the veggies are soft, add parsley, Alfredo sauce, and spices to the pot; stir to combine. Continue to cook, stirring occasionally, until sauce is warmed through, about 3 minutes. ",
      "secondary_message": "1 ½ (16 oz) jars alfredo sauce\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 365908,
      "primary_message": "Transfer drained pasta to the pot with the sauce and toss to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 365909,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
