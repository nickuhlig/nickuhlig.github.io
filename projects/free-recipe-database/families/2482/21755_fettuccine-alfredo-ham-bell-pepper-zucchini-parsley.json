  "instructions": [
    {
      "id": 366030,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside. ",
      "secondary_message": "1 tsp salt\n283 g fettuccine pasta"
    },
    {
      "id": 366031,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "2 medium zucchini squash\n2 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 366032,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 366033,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the zucchini. ",
      "secondary_message": null
    },
    {
      "id": 366034,
      "primary_message": "Peel, halve, and small dice onion; add to the bowl. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 366035,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 366036,
      "primary_message": "While the skillet heats up, small dice ham and add to the bowl with the veggies. ",
      "secondary_message": "454 g ham steak, boneless"
    },
    {
      "id": 366037,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies and ham; cook, stirring occasionally, until veggies soften, about 5 minutes. ",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 366038,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 366039,
      "primary_message": "When the veggies are soft, add parsley, Alfredo sauce, and spices to the skillet; stir to combine. Continue to cook, stirring occasionally, until sauce is warmed through, about 2 minutes. ",
      "secondary_message": "1 (454 g) jar alfredo sauce\n1 tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 366040,
      "primary_message": "Transfer drained pasta to the skillet and toss to combine. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 366041,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
