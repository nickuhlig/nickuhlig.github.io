  "instructions": [
    {
      "id": 319189,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions.",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 319190,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 red bell peppers\n4 medium carrots\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 319191,
      "primary_message": "Trim, halve, and small dice zucchini; trim, seed, and small dice bell peppers. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 319192,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 319193,
      "primary_message": "While the skillet heats up, peel and mince shallots and garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 319194,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies, turkey, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp toasted sesame oil\n0.68 kg ground turkey\n¼ tsp black pepper"
    },
    {
      "id": 319195,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrots; place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 319196,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the carrot and set aside.",
      "secondary_message": null
    },
    {
      "id": 319197,
      "primary_message": "When the turkey is done, add soy sauce, honey, and chili-garlic sauce to the skillet; stir to combine. Continue to cook until veggies are tender and sauce thickens, 3-4 minutes more; remove from heat.",
      "secondary_message": "¼ cup soy sauce\n2 tbsp honey\n2 tsp chili-garlic sauce"
    },
    {
      "id": 319198,
      "primary_message": "When the noodles are done, drain and rinse under cool water. Add to the bowl with the carrot and cilantro.",
      "secondary_message": null
    },
    {
      "id": 319199,
      "primary_message": "Juice lime into the bowl, add oil, and toss to combine.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 319200,
      "primary_message": "To serve, divide noodles and turkey vegetable stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
