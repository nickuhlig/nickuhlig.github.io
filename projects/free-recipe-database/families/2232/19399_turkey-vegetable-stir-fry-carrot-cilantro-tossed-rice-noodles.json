  "instructions": [
    {
      "id": 319057,
      "primary_message": "Fill a large pot halfway with hot water (from the tap) and bring to a boil. Remove from heat and add rice noodles. Soak for 10 minutes or according to package directions.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 319058,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 red bell peppers\n6 medium carrots\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 319059,
      "primary_message": "Trim, halve, and small dice zucchini; trim, seed, and small dice bell peppers. Place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 319060,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 319061,
      "primary_message": "While the pot heats up, peel and mince onion and garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 319062,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies, turkey, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp toasted sesame oil\n2 ¼ lb ground turkey\n½ tsp black pepper"
    },
    {
      "id": 319063,
      "primary_message": "Meanwhile, peel, trim, and coarsely grate carrots; place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 319064,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the carrot and set aside.",
      "secondary_message": null
    },
    {
      "id": 319065,
      "primary_message": "When the turkey is done, add soy sauce, honey, and chili-garlic sauce to the pot; stir to combine. Continue to cook until veggies are tender and sauce thickens, 4-5 minutes more; remove from heat.",
      "secondary_message": "⅓ cup soy sauce\n3 tbsp honey\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 319066,
      "primary_message": "When the noodles are done, drain and rinse under cool water. Add to the bowl with the carrot and cilantro.",
      "secondary_message": null
    },
    {
      "id": 319067,
      "primary_message": "Juice limes into the bowl, add oil, and toss to combine.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 319068,
      "primary_message": "To serve, divide noodles and turkey vegetable stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
