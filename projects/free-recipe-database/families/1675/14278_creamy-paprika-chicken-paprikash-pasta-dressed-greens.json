  "instructions": [
    {
      "id": 237290,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 237291,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, salt, and pepper in a medium bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp apple cider vinegar\n½ tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 237292,
      "primary_message": "Place spices in a small bowl and stir to combine the spice mix. ",
      "secondary_message": "1 ½ tsp paprika\n1 tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n⅛ tsp black pepper"
    },
    {
      "id": 237293,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237294,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and medium dice. Season chicken with half the spice mix. (Set aside remaining spice mix for the sauce.)",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 237295,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and stir-fry until cooked through and golden brown, 4-5 minutes. Transfer to a clean plate and loosely cover with aluminum foil. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 237296,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince onion and garlic. ",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 237297,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add onion and garlic; cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 237298,
      "primary_message": "Sprinkle remaining spice mix over onion and garlic, stir to coat, and continue to cook until fragrant, 1 minute more. ",
      "secondary_message": null
    },
    {
      "id": 237299,
      "primary_message": "Add tomatoes and sugar to the skillet, stir to combine, and bring to a simmer. ",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 tsp brown sugar"
    },
    {
      "id": 237300,
      "primary_message": "Return chicken to the skillet, stir to combine, and simmer until heated through, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 237301,
      "primary_message": "Add yogurt to the skillet, stir to combine, and remove from heat.",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 237302,
      "primary_message": "Once the pasta is done, drain in a colander.",
      "secondary_message": null
    },
    {
      "id": 237303,
      "primary_message": "Wash spring mix (skip this step if it came pre-washed) and add to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 237304,
      "primary_message": "To serve, divide pasta, paprika chicken, and salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
