  "instructions": [
    {
      "id": 237437,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 237438,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, salt, and pepper in a large bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n¾ tsp brown sugar\n¼ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 237439,
      "primary_message": "Place spices in a small bowl and stir to combine the spice mix. ",
      "secondary_message": "2 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp garlic powder\n¾ tsp onion powder\n3 pinch black pepper"
    },
    {
      "id": 237440,
      "primary_message": "Pat the chicken dry with paper towels and medium dice. Season chicken with half the spice mix. (Set aside remaining spice mix for the sauce.)",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 237441,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237442,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chicken and stir-fry until cooked through and golden brown, 5-6 minutes. Transfer to a clean plate and loosely cover with aluminum foil. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 237443,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince onions and garlic. ",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 237444,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom. Add onion and garlic; cook, stirring frequently, until fragrant, 1-2 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 237445,
      "primary_message": "Sprinkle remaining spice mix over onion and garlic, stir to coat, and continue to cook until fragrant, 1 minute more. ",
      "secondary_message": null
    },
    {
      "id": 237446,
      "primary_message": "Add tomatoes and sugar to the pot, stir to combine, and bring to a simmer. ",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n1 ½ tsp brown sugar"
    },
    {
      "id": 237447,
      "primary_message": "Return chicken to the pot, stir to combine, and simmer until heated through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 237448,
      "primary_message": "Add yogurt to the pot, stir to combine, and remove from heat.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 237449,
      "primary_message": "Once the pasta is done, drain in a colander.",
      "secondary_message": null
    },
    {
      "id": 237450,
      "primary_message": "Wash spring mix (skip this step if it came pre-washed) and add to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 237451,
      "primary_message": "To serve, divide pasta, paprika chicken, and salad between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
