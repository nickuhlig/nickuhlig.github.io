  "instructions": [
    {
      "id": 245471,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 pints grape tomatoes\n4 medium red potatoes\n1 lemon"
    },
    {
      "id": 245472,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245473,
      "primary_message": "Peel and mince garlic and shallot. Add both to the bowl with the dressing.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 245474,
      "primary_message": "Peel, trim, and halve cucumber lengthwise; slice crosswise into half-moons. Halve tomatoes. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 245475,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 245476,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 245477,
      "primary_message": "Meanwhile, peel and chop potatoes into ½-inch cubes. Add to the pot and cook until very tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 245478,
      "primary_message": "While the potatoes are cooking, pat chicken dry with paper towels and place on a large baking sheet pan.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 245479,
      "primary_message": "Drizzle chicken with oil and season with spices on both sides; arrange in a single layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245480,
      "primary_message": "Place baking sheet in the oven and broil the chicken for 5 minutes (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 245481,
      "primary_message": "Meanwhile, trim and thinly slice lemon. ",
      "secondary_message": null
    },
    {
      "id": 245482,
      "primary_message": "Remove baking sheet from the oven. Using tongs, flip the chicken and place a lemon slice on top of each thigh. Return to the oven and continue to broil until chicken is golden brown and cooked through, 5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 245483,
      "primary_message": "When the potatoes are tender, drain in a colander and return to the pot. Add feta, milk, oil, and spices; blend or mash until smooth.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese\n4 fl oz (½ cup) whole milk\n4 tsp extra virgin olive oil\n½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245484,
      "primary_message": "To serve, divide chicken, salad, and mashed potatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
