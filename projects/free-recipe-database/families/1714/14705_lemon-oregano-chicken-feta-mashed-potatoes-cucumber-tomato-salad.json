  "instructions": [
    {
      "id": 245569,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 small pkgs grape tomatoes\n6 medium red potatoes\n1 ½ lemons"
    },
    {
      "id": 245570,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245571,
      "primary_message": "Peel and mince garlic and shallots. Add both to the bowl with the dressing.",
      "secondary_message": "3 cloves garlic\n2 shallots"
    },
    {
      "id": 245572,
      "primary_message": "Peel, trim, and halve cucumbers lengthwise; slice crosswise into half-moons. Halve tomatoes. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 245573,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 245574,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 245575,
      "primary_message": "Meanwhile, peel and chop potatoes into ½-inch cubes. Add to the pot and cook until very tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 245576,
      "primary_message": "While the potatoes are cooking, pat chicken dry with paper towels and place on a large baking sheet pan.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 245577,
      "primary_message": "Drizzle chicken with oil and season with spices on both sides; arrange in a single layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245578,
      "primary_message": "Place baking sheet in the oven and broil the chicken for 5 minutes (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 245579,
      "primary_message": "Meanwhile, trim and thinly slice lemons. ",
      "secondary_message": null
    },
    {
      "id": 245580,
      "primary_message": "Remove baking sheet from the oven. Using tongs, flip the chicken and place a lemon slice on top of each thigh. Return to the oven and continue to broil until chicken is golden brown and cooked through, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 245581,
      "primary_message": "When the potatoes are tender, drain in a colander and return to the pot. Add feta, milk, oil, and spices; blend or mash until smooth.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n177 ml whole milk\n2 tbsp extra virgin olive oil\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245582,
      "primary_message": "To serve, divide chicken, salad, and mashed potatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
