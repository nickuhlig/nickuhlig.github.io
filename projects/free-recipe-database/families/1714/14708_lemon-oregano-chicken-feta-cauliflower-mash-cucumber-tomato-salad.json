  "instructions": [
    {
      "id": 245611,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 small pkgs grape tomatoes\n1 ½ medium heads cauliflower\n1 ½ lemons"
    },
    {
      "id": 245612,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245613,
      "primary_message": "Peel and mince garlic and shallots. Add both to the bowl with the dressing.",
      "secondary_message": "3 cloves garlic\n2 shallots"
    },
    {
      "id": 245614,
      "primary_message": "Peel, trim, and halve cucumbers lengthwise; slice crosswise into half-moons. Halve tomatoes. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 245615,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 245616,
      "primary_message": "Fill a large pot with about 1-inch of hot water (from the tap); cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 245617,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Roughly chop into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 245618,
      "primary_message": "Once the water in the pot is boiling, add cauliflower, reduce heat to medium, cover, and cook until tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 245619,
      "primary_message": "While the cauliflower is cooking, pat chicken dry with paper towels and place on a large baking sheet pan. Drizzle chicken with oil and season with spices on both sides; arrange in a single layer.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 ½ tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245620,
      "primary_message": "Place baking sheet in the oven and broil the chicken for 5 minutes (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 245621,
      "primary_message": "Meanwhile, trim and thinly slice lemons. ",
      "secondary_message": null
    },
    {
      "id": 245622,
      "primary_message": "Remove baking sheet from the oven. Using tongs, flip the chicken and place a lemon slice on top of each thigh. Return to the oven and continue to broil until chicken is golden brown and cooked through, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 245623,
      "primary_message": "When the cauliflower is tender, drain in a colander. Working in batches if necessary, place cauliflower, feta, cream, oil, and spices in a blender; purée until smooth.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n177 ml heavy whipping cream\n2 tbsp extra virgin olive oil\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 245624,
      "primary_message": "To serve, divide chicken, salad, and cauliflower mash between plates. Enjoy!",
      "secondary_message": null
    }
  ],
