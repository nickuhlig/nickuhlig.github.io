  "instructions": [
    {
      "id": 245597,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 small pkgs grape tomatoes\n1 medium head cauliflower\n1 lemon"
    },
    {
      "id": 245598,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245599,
      "primary_message": "Peel and mince garlic and shallot. Add both to the bowl with the dressing.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 245600,
      "primary_message": "Peel, trim, and halve cucumber lengthwise; slice crosswise into half-moons. Halve tomatoes. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 245601,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 245602,
      "primary_message": "Fill a large pot with about 1-inch of hot water (from the tap); cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 245603,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Roughly chop into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 245604,
      "primary_message": "Once the water in the pot is boiling, add cauliflower, reduce heat to medium, cover, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 245605,
      "primary_message": "While the cauliflower is cooking, pat chicken dry with paper towels and place on a large baking sheet pan. Drizzle chicken with oil and season with spices on both sides; arrange in a single layer.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n1 tbsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245606,
      "primary_message": "Place baking sheet in the oven and broil the chicken for 5 minutes (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 245607,
      "primary_message": "Meanwhile, trim and thinly slice lemon. ",
      "secondary_message": null
    },
    {
      "id": 245608,
      "primary_message": "Remove baking sheet from the oven. Using tongs, flip the chicken and place a lemon slice on top of each thigh. Return to the oven and continue to broil until chicken is golden brown and cooked through, 5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 245609,
      "primary_message": "When the cauliflower is tender, drain in a colander. Working in batches if necessary, place cauliflower, feta, cream, oil, and spices in a blender; purée until smooth.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n118 ml (½ cup) heavy whipping cream\n4 tsp extra virgin olive oil\n½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 245610,
      "primary_message": "To serve, divide chicken, salad, and cauliflower mash between plates. Enjoy!",
      "secondary_message": null
    }
  ],
