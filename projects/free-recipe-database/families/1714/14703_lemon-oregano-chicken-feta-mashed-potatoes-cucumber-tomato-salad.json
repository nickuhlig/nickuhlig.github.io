  "instructions": [
    {
      "id": 245541,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 small pkg grape tomatoes\n2 medium red potatoes\n½ lemon"
    },
    {
      "id": 245542,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245543,
      "primary_message": "Peel and mince garlic and shallot. Add both to the bowl with the dressing.",
      "secondary_message": "1 clove garlic\n½ shallot"
    },
    {
      "id": 245544,
      "primary_message": "Peel, trim, and halve cucumber lengthwise; slice crosswise into half-moons. Halve tomatoes. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 245545,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 245546,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); add salt, cover with a lid, and bring to a boil over high heat.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 245547,
      "primary_message": "Meanwhile, peel and chop potatoes into ½-inch cubes. Add to the saucepan and cook until very tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 245548,
      "primary_message": "While the potatoes are cooking, pat chicken dry with paper towels and place on a baking sheet pan.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 245549,
      "primary_message": "Drizzle chicken with oil and season with spices on both sides; arrange in a single layer.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245550,
      "primary_message": "Place baking sheet in the oven and broil the chicken for 5 minutes (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 245551,
      "primary_message": "Meanwhile, trim and thinly slice lemon. ",
      "secondary_message": null
    },
    {
      "id": 245552,
      "primary_message": "Remove baking sheet from the oven. Using tongs, flip the chicken and place a lemon slice on top of each thigh. Return to the oven and continue to broil until chicken is golden brown and cooked through, 5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 245553,
      "primary_message": "When the potatoes are tender, drain in a colander and return to the pan. Add feta, milk, oil, and spices; blend or mash until smooth.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n59 ml (¼ cup) whole milk\n2 tsp extra virgin olive oil\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245554,
      "primary_message": "To serve, divide chicken, salad, and mashed potatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
