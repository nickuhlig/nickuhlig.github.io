  "instructions": [
    {
      "id": 245583,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 small pkg grape tomatoes\n½ medium head cauliflower\n½ lemon"
    },
    {
      "id": 245584,
      "primary_message": "Place oil, vinegar, salt, and pepper in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245585,
      "primary_message": "Peel and mince garlic and shallot. Add both to the bowl with the dressing.",
      "secondary_message": "1 clove garlic\n½ shallot"
    },
    {
      "id": 245586,
      "primary_message": "Peel, trim, and halve cucumber lengthwise; slice crosswise into half-moons. Halve tomatoes. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 245587,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 245588,
      "primary_message": "Fill a medium saucepan with about 1-inch of hot water (from the tap); cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 245589,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Roughly chop into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 245590,
      "primary_message": "Once the water in the saucepan is boiling, add cauliflower, reduce heat to medium, cover, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 245591,
      "primary_message": "While the cauliflower is cooking, pat chicken dry with paper towels and place on a baking sheet pan. Drizzle chicken with oil and season with spices on both sides; arrange in a single layer.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n1 ½ tsp extra virgin olive oil\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245592,
      "primary_message": "Place baking sheet in the oven and broil the chicken for 5 minutes (the chicken will not be cooked all the way through).",
      "secondary_message": null
    },
    {
      "id": 245593,
      "primary_message": "Meanwhile, trim and thinly slice lemon. ",
      "secondary_message": null
    },
    {
      "id": 245594,
      "primary_message": "Remove baking sheet from the oven. Using tongs, flip the chicken and place a lemon slice on top of each thigh. Return to the oven and continue to broil until chicken is golden brown and cooked through, 5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 245595,
      "primary_message": "When the cauliflower is tender, drain and transfer to a blender. Add feta, cream, oil, and spices; purée until smooth.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n59 ml (¼ cup) heavy whipping cream\n2 tsp extra virgin olive oil\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 245596,
      "primary_message": "To serve, divide chicken, salad, and cauliflower mash between plates. Enjoy!",
      "secondary_message": null
    }
  ],
