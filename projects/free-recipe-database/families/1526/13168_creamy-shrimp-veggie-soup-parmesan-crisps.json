  "instructions": [
    {
      "id": 220661,
      "primary_message": "Preheat oven to 205°C (400°F). Line a baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 220662,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Set aside to drain.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 220663,
      "primary_message": "Wash, dry, peel, and small dice carrot. Peel and small dice onion; transfer both to a medium bowl.",
      "secondary_message": "1 medium carrot\n½ medium yellow onion"
    },
    {
      "id": 220664,
      "primary_message": "Wash, dry, trim, and small dice celery; add to the bowl with the veggies.",
      "secondary_message": "1 stick celery"
    },
    {
      "id": 220665,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 220666,
      "primary_message": "While the pan heats up, peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 220667,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and thyme to the pan; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp thyme"
    },
    {
      "id": 220668,
      "primary_message": "Meanwhile, finely grate cheese. To make the crisps, measure out 1 tbsp of grated cheese and place in a pile on the baking sheet. Repeat with remaining cheese, keeping the piles a few inches apart.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 220669,
      "primary_message": "Place baking sheet in the oven and bake until cheese is lightly browned and crisp, 5-7 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 220670,
      "primary_message": "While the crisps are cooking, add broth, salt, and pepper to the pan with the veggies. Bring to a boil over high heat, then reduce heat to a simmer; cook, stirring occasionally, until veggies are tender, about 5 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 220671,
      "primary_message": "Meanwhile, roughly chop the shrimp; add to the soup and continue to simmer until cooked through, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 220672,
      "primary_message": "Cut cream cheese into small pieces and add to the pan; continue to cook, stirring constantly, until the cheese is melted and combined, about 3 minutes.",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "id": 220673,
      "primary_message": "Divide soup between bowls and serve with cheese crisps on the side. Enjoy!",
      "secondary_message": null
    }
  ],
