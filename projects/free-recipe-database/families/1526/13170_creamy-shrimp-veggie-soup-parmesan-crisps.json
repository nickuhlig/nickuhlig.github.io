  "instructions": [
    {
      "id": 220687,
      "primary_message": "Preheat oven to 205°C (400°F). Line two large baking sheet pans with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 220688,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Set aside to drain.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 220689,
      "primary_message": "Wash, dry, peel, and small dice carrots. Peel and small dice onions; transfer both to a medium bowl.",
      "secondary_message": "3 medium carrots\n1 ½ medium yellow onions"
    },
    {
      "id": 220690,
      "primary_message": "Wash, dry, trim, and small dice celery; add to the bowl with the veggies.",
      "secondary_message": "3 sticks celery"
    },
    {
      "id": 220691,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 220692,
      "primary_message": "While the pot heats up, peel and mince garlic; add to the bowl with the veggies.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 220693,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and thyme to the pot; cook, stirring occasionally, until starting to soften, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp thyme"
    },
    {
      "id": 220694,
      "primary_message": "Meanwhile, finely grate cheese. To make the crisps, measure out 1 tbsp of grated cheese and place in a pile on the prepared baking sheets. Repeat with remaining cheese, keeping the piles a few inches apart.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 220695,
      "primary_message": "Place baking sheets in the oven and bake until cheese is lightly browned and crisp, 6-8 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 220696,
      "primary_message": "While the crisps are cooking, add broth, salt, and pepper to the pot with the veggies. Bring to a boil over high heat, then reduce heat to a simmer; cook, stirring occasionally, until veggies are tender, about 5 minutes.",
      "secondary_message": "2129 ml chicken or vegetable broth\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 220697,
      "primary_message": "Meanwhile, roughly chop the shrimp; add to the soup and continue to simmer until cooked through, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 220698,
      "primary_message": "Cut cream cheese into small pieces and add to the pot; continue to cook, stirring constantly, until the cheese is melted and combined, about 5 minutes.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 220699,
      "primary_message": "Divide soup between bowls and serve with cheese crisps on the side. Enjoy!",
      "secondary_message": null
    }
  ],
