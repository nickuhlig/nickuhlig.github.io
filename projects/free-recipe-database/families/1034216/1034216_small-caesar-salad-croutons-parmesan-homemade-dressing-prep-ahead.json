  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium and 4 mini food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and juice lemon into a small bowl. \n\n",
      "secondary_message": "½ lemon"
    },
    {
      "primary_message": "Peel and mince garlic; mince anchovy fillets. Add both to the bowl with the lemon juice along with mayo, water, Dijon, Worcestershire, salt, and pepper. Whisk to combine. \n\n",
      "secondary_message": "1 clove garlic\n⅓ cup mayonnaise\n2 tsp water\n½ tsp Dijon mustard\n½ tsp Worcestershire sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Finely grate Parmesan. Add to the bowl with the mayo mixture and whisk once more to combine the Caesar dressing. Divide between the mini food storage containers, cover with lids, and set aside.\n\n",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "primary_message": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces. Divide lettuce between the medium food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Using a peeler, shave additional Parmesan into curls. Sprinkle Parmesan and croutons over lettuce. Add dressing to each container, then cover and refrigerate.\n\n",
      "secondary_message": "1 oz Parmesan cheese\n1 cup croutons"
    },
    {
      "primary_message": "When ready to eat, drizzle dressing over salad, stir to combine, and enjoy!",
      "secondary_message": null
    }
  ],
