  "instructions": [
    {
      "primary_message": "Spread 1 tablespoon of Nutella® over Quakers® chocolate rice cake.\t\t\t\t\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place the pretzels on the top left and right corner of the rice cake as the ears. Add the white chocolate chips in between the ears as the eyes. Add the raspberry or cranberry in the center as the nose. Repeat with second rice cake. Enjoy!\t\t\t\t\n",
      "secondary_message": null
    },
    {
      "primary_message": "CHEF'S TIP: As an alternative to using white chocolate chips for the reindeer eyes, try placing two small banana slices with a blueberry in the center of each to create a fun and fruity look!\n",
      "secondary_message": null
    }
  ],
