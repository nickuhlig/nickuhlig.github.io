  "instructions": [
    {
      "id": 442513,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 442514,
      "primary_message": "Once the water is boiling, remove from heat and add the rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside. ",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 442515,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 baby bok choy\n1 red bell pepper\n4 sticks celery"
    },
    {
      "id": 442516,
      "primary_message": "Trim and cut bok choy crosswise into thin (shred-like) strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 442517,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips. Add to the bowl with the bok choy. ",
      "secondary_message": null
    },
    {
      "id": 442518,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 442519,
      "primary_message": "While the skillet heats up, trim and slice celery crosswise into thin pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 442520,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, chicken, miso paste, and spices. Cook, breaking the meat apart with a spoon, until cooked through and the veggies are tender, 4-5 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n0.45 kg ground chicken\n2 tbsp miso paste, red\n1 tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 442521,
      "primary_message": "Add drained noodles and hoisin sauce to the skillet. Continue to cook, tossing occasionally, until noodles and sauce are warmed through, 1-2 minutes more. Remove from heat. ",
      "secondary_message": "½ cup hoisin sauce"
    },
    {
      "id": 442522,
      "primary_message": "To serve, divide saucy noodles, chicken, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
