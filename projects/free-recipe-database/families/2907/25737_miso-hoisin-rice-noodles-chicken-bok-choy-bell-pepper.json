  "instructions": [
    {
      "id": 442463,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 442464,
      "primary_message": "Once the water is boiling, remove from heat and add the rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside. ",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 442465,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "9 baby bok choy\n1 ½ red bell peppers\n6 sticks celery"
    },
    {
      "id": 442466,
      "primary_message": "Trim and cut bok choy crosswise into thin (shred-like) strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 442467,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the bowl with the bok choy. ",
      "secondary_message": null
    },
    {
      "id": 442468,
      "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 442469,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 442470,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, chicken, miso paste, and spices. Cook, breaking the meat apart with a spoon, until cooked through and the veggies are tender, 5-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 ½ lb ground chicken\n3 tbsp miso paste, red\n1 ½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 442471,
      "primary_message": "Add drained noodles and hoisin sauce to the pot. Continue to cook, tossing occasionally, until noodles and sauce are warmed through, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "¾ cup hoisin sauce"
    },
    {
      "id": 442472,
      "primary_message": "To serve, divide saucy noodles, chicken, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
