  "instructions": [
    {
      "id": 218780,
      "primary_message": "Preheat oven to broil on high and position rack in the middle of the oven. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 218781,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.36 kg sweet potatoes\n2 jalapeño peppers\n1 mango\n1 red bell pepper\n1 small bunch cilantro\n2 limes\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 218782,
      "primary_message": "Trim off and discard ends of sweet potatoes; peel and slice lengthwise into ½-inch thick pieces. Discard any small, outer slices, then place remaining slices on the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 218783,
      "primary_message": "Drizzle sweet potato slices with oil and season with spices on both sides.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp chili powder\n½ tsp cumin"
    },
    {
      "id": 218784,
      "primary_message": "Place sweet potatoes in the oven and broil, flipping halfway through, until fork-tender, 8-12 minutes. (Keep a close watch on the sweet potatoes to avoid burning.)",
      "secondary_message": null
    },
    {
      "id": 218785,
      "primary_message": "Meanwhile, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and place in a medium bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 218786,
      "primary_message": "Peel and mince garlic and shallots. Add both to the bowl with the jalapeños.",
      "secondary_message": "2 cloves garlic\n2 shallots"
    },
    {
      "id": 218787,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides. Small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 218788,
      "primary_message": "Seed and small dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 218789,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 218790,
      "primary_message": "Juice one lime (reserving the other for the salad) into the bowl; add salt and stir to combine the mango salsa. Set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 218791,
      "primary_message": "Drain and rinse beans. Divide beans between sweet potato slices, spreading them out in an even layer; season with salt. Return sweet potatoes to the oven and broil until beans are heated through, about 2 minutes. Remove from oven.",
      "secondary_message": "2 (398 ml) cans black beans\n⅛ tsp salt"
    },
    {
      "id": 218792,
      "primary_message": "Meanwhile, peel and mince additional garlic; place in a large bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 218793,
      "primary_message": "Juice remaining lime into the bowl with the garlic. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing. Add arugula and toss to combine the salad.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 218794,
      "primary_message": "Divide sweet potato \"tostadas\" between plates and top with mango salsa. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
