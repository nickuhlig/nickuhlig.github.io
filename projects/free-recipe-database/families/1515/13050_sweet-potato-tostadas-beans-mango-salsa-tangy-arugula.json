  "instructions": [
    {
      "id": 218795,
      "primary_message": "Preheat oven to broil on high and position rack in the middle of the oven. Line two baking sheet pans with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 218796,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2.04 kg sweet potatoes\n3 jalapeño peppers\n1 ½ mangoes\n1 ½ red bell peppers\n1 small bunch cilantro\n3 limes\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 218797,
      "primary_message": "Trim off and discard ends of sweet potatoes; peel and slice lengthwise into ½-inch thick pieces. Discard any small, outer slices, then divide remaining slices between baking sheets.",
      "secondary_message": null
    },
    {
      "id": 218798,
      "primary_message": "Drizzle sweet potato slices with oil and season with spices on both sides.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp chili powder\n¾ tsp cumin"
    },
    {
      "id": 218799,
      "primary_message": "Place one baking sheet in the oven and broil, flipping sweet potatoes halfway through, until fork-tender, 8-12 minutes. (Keep a close watch on the sweet potatoes to avoid burning.) Repeat with 2nd baking sheet.",
      "secondary_message": null
    },
    {
      "id": 218800,
      "primary_message": "Meanwhile, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and place in a medium bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 218801,
      "primary_message": "Peel and mince garlic and onion. Add both to the bowl with the jalapeños.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 218802,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides. Small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 218803,
      "primary_message": "Seed and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 218804,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 218805,
      "primary_message": "Juice half the limes (reserving the rest for the salad) into the bowl; add salt and stir to combine the mango salsa. Set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 218806,
      "primary_message": "Drain and rinse beans. Divide beans between sweet potato slices, spreading them out in an even layer; season with salt. Working in batches, return sweet potatoes to the oven and broil until beans are heated through, about 2 minutes. Remove from oven.",
      "secondary_message": "3 (398 ml) cans black beans\n3 pinch salt"
    },
    {
      "id": 218807,
      "primary_message": "Meanwhile, peel and mince additional garlic; place in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 218808,
      "primary_message": "Juice remaining limes into the bowl with the garlic. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing. Add arugula and toss to combine the salad.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 218809,
      "primary_message": "Divide sweet potato \"tostadas\" between plates and top with mango salsa. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
