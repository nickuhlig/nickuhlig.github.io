  "instructions": [
    {
      "id": 1,
      "primary_message": "In the bowl of an electric mixer, combine cream, rose water, and sugar. Whip on high speed until cream holds stiff peaks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Line the bottom of a deep baking dish, about 10 by 20 cm, with tea biscuits. Spread on one quarter of cream. Toss on one quarter of blackerries and pistachios, and finish with a drizzle of pomegranate molasses. Repeat for four layers.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cover and chill in refrigerator for at least 6 hours before serving.",
      "secondary_message": null
    }
  ],
