  "instructions": [
    {
      "id": 555265,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 555266,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.45 kg sweet potato\n2 small bunches asparagus\n1 lemon\n2 (170 g) pkgs blackberries"
    },
    {
      "id": 555267,
      "primary_message": "Peel and medium dice sweet potatoes. Transfer to a large baking sheet pan, drizzle with oil, then season with spices. Toss to coat and spread out in an even layer. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp thyme, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 555268,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until sweet potato starts to soften, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 555269,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 555270,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "4 pork chops, boneless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 555271,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 555272,
      "primary_message": "Meanwhile, snap (or cut) off woody ends of the asparagus; cut spears in half crosswise. Place in a medium bowl along with oil, salt, and pepper. Toss to coat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 555273,
      "primary_message": "Once the sweet potato is softened, remove baking sheet from the oven. Add asparagus, toss to combine, and spread back out into an even layer. Return baking sheet to the oven and continue to roast until veggies are fork-tender, 7-8 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 555274,
      "primary_message": "While the veggies are roasting, return skillet (with cooking juices) to medium heat. Zest and juice lemon into the skillet, then add blackberries, water, honey, pepper, and salt. Cook, stirring occasionally, until blackberries, soften, 2-3 minutes. ",
      "secondary_message": "⅓ cup water\n2 tsp honey\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 555275,
      "primary_message": "Meanwhile, roughly chop pistachios. Set aside. ",
      "secondary_message": "½ cup pistachios, unsalted"
    },
    {
      "id": 555276,
      "primary_message": "Once the blackberries are soft, use a potato masher (or fork) to crush the blackberries and combine the sauce. Continue to cook, stirring occasionally, until sauce thickens, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 555277,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 555278,
      "primary_message": "To serve, divide veggies and pork between plates. Top pork with sauce and sprinkle veggies with pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
