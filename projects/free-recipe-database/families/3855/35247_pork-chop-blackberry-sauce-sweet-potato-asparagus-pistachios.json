  "instructions": [
    {
      "id": 555237,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 555238,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n3 small bunches asparagus\n1 ½ lemons\n3 (6 oz) pkgs blackberries"
    },
    {
      "id": 555239,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two large baking sheet pans, drizzle with oil, then season with spices. Toss to coat and spread out in an even layer. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 555240,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until sweet potato starts to soften, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 555241,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 555242,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, boneless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 555243,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 555244,
      "primary_message": "Meanwhile, snap (or cut) off woody ends of the asparagus; cut spears in half crosswise. Place in a large bowl along with oil, salt, and pepper. Toss to coat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 555245,
      "primary_message": "Once the sweet potato is softened, remove baking sheets from the oven. Add asparagus, toss to combine, and spread back out into an even layer. Return baking sheets to the oven and continue to roast until veggies are fork-tender, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 555246,
      "primary_message": "While the veggies are roasting, return skillet (with cooking juices) to medium heat. Zest and juice lemons into the skillet, then add blackberries, water, honey, pepper, and salt. Cook, stirring occasionally, until blackberries, soften, 3-4 minutes. ",
      "secondary_message": "½ cup water\n1 tbsp honey\n¼ tsp black pepper\n3 pinch salt"
    },
    {
      "id": 555247,
      "primary_message": "Meanwhile, roughly chop pistachios. Set aside. ",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 555248,
      "primary_message": "Once the blackberries are soft, use a potato masher (or fork) to crush the blackberries and combine the sauce. Continue to cook, stirring occasionally, until sauce thickens, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 555249,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 555250,
      "primary_message": "To serve, divide veggies and pork between plates. Top pork with sauce and sprinkle veggies with pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
