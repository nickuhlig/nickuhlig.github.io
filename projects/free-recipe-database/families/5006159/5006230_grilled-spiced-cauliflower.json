  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Spice Mixture: In a small bowl, mix together all of the ingredients.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Cauliflower: Generously brush cauliflower all over with olive oil and season evenly with spice mixture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Alternatively, set all the burners of a gas grill to high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Place cauliflower on hot side of grill and cook, turning, until it is charred in spots on both sides, about 3 minutes per side. Move cauliflower to cool side of the grill, cover, and continue to cook until tender throughout, 10-15 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer cauliflower to a plate, sprinkle with cilantro, drizzle with fresh olive oil, and serve.",
      "secondary_message": null
    }
  ],
