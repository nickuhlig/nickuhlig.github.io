  "instructions": [
    {
      "id": 365323,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n0.23 kg cremini mushrooms\n½ small bunch green onions (scallions)\n1 (2 ½ cm) piece ginger root\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 365324,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365325,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 365326,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 365327,
      "primary_message": "Using a clean cutting board, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 365328,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 365329,
      "primary_message": "Return skillet (with drippings) to medium-high heat. Add mushrooms and cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 365330,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the cauliflower and set the other half aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 365331,
      "primary_message": "When the mushrooms are soft, add cauliflower, green onion, and oil to the skillet. Cook, stirring occasionally, until cauliflower is soft and beginning to brown, about 5 minutes. ",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 365332,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl along with coconut aminos and maple syrup; whisk to combine the sauce.",
      "secondary_message": "2 cloves garlic\n4 tsp coconut aminos\n1 tsp pure maple syrup"
    },
    {
      "id": 365333,
      "primary_message": "When the cauliflower is done, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add sauce, stir to combine, and continue to cook until heated through, about 30 seconds. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 365334,
      "primary_message": "Preheat another skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365335,
      "primary_message": "Once the skillet is hot, add additional oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tsp toasted sesame oil\n4 eggs\n⅛ tsp salt"
    },
    {
      "id": 365336,
      "primary_message": "To serve, divide cauliflower rice and eggs between plates. Garnish rice with crispy bacon, reserved green onion, and sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
