  "instructions": [
    {
      "id": 365284,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ medium head cauliflower\n0.23 kg cremini mushrooms\n½ small bunch green onions (scallions)\n1 (2 ½ cm) piece ginger root\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 365285,
      "primary_message": "Cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a medium bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 365286,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365287,
      "primary_message": "While the skillet heats up, thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 365288,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 365289,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the cauliflower and set the other half aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 365290,
      "primary_message": "When the mushrooms are soft, add cauliflower, green onion, and more oil to the skillet. Cook, stirring occasionally, until cauliflower is soft and beginning to brown, about 5 minutes. ",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 365291,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce and maple syrup; whisk to combine the sauce.",
      "secondary_message": "2 cloves garlic\n2 tbsp soy sauce\n1 tsp pure maple syrup"
    },
    {
      "id": 365292,
      "primary_message": "When the cauliflower is done, add edamame to the skillet. Cook, stirring occasionally, until just warmed through, about 1 minute.",
      "secondary_message": "1 ½ cups edamame"
    },
    {
      "id": 365293,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add sauce, stir to combine, and continue to cook until heated through, about 30 seconds. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 365294,
      "primary_message": "Preheat another skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365295,
      "primary_message": "Once the skillet is hot, add additional oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tsp virgin coconut oil\n4 eggs\n⅛ tsp salt"
    },
    {
      "id": 365296,
      "primary_message": "To serve, divide cauliflower rice and eggs between plates. Garnish rice with reserved green onion and sesame seeds. Enjoy!",
      "secondary_message": "2 tbsp sesame seeds"
    }
  ],
