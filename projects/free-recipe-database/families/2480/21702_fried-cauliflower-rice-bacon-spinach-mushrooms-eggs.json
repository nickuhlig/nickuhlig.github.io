  "instructions": [
    {
      "id": 365147,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lb cremini mushrooms\n1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 365148,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 365149,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365150,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve pot with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 365151,
      "primary_message": "Using a clean cutting board, cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a large bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 365152,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 365153,
      "primary_message": "Return pot (with drippings) to medium-high heat. Add mushrooms and cook, stirring occasionally, until softened, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 365154,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the cauliflower and set the other half aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 365155,
      "primary_message": "When the mushrooms are soft, add cauliflower, green onion, and oil to the pot. Cook, stirring occasionally, until cauliflower is soft and beginning to brown, about 6 minutes. ",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 365156,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl along with coconut aminos and maple syrup; whisk to combine the sauce.",
      "secondary_message": "6 cloves garlic\n¼ cup coconut aminos\n1 tbsp pure maple syrup"
    },
    {
      "id": 365157,
      "primary_message": "When the cauliflower is done, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add sauce, stir to combine, and continue to cook until heated through, about 30 seconds. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 365158,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365159,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tbsp toasted sesame oil\n12 eggs\n½ tsp salt"
    },
    {
      "id": 365160,
      "primary_message": "To serve, divide cauliflower rice and eggs between plates. Garnish rice with crispy bacon, reserved green onion, and sesame seeds. Enjoy!",
      "secondary_message": "⅓ cup sesame seeds"
    }
  ],
