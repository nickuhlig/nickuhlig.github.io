  "instructions": [
    {
      "id": 365106,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lb cremini mushrooms\n1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 365107,
      "primary_message": "Cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and place in a large bowl; set aside.",
      "secondary_message": null
    },
    {
      "id": 365108,
      "primary_message": "Thinly slice mushrooms.",
      "secondary_message": null
    },
    {
      "id": 365109,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365110,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until softened, about 6 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 365111,
      "primary_message": "Meanwhile, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the cauliflower and set the other half aside for garnish.",
      "secondary_message": null
    },
    {
      "id": 365112,
      "primary_message": "When the mushrooms are soft, add cauliflower, green onion, and more oil to the pot. Cook, stirring occasionally, until cauliflower is soft and beginning to brown, about 6 minutes. ",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 365113,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Place both in a small bowl along with soy sauce and maple syrup; whisk to combine the sauce.",
      "secondary_message": "6 cloves garlic\n⅓ cup soy sauce\n1 tbsp pure maple syrup"
    },
    {
      "id": 365114,
      "primary_message": "When the cauliflower is done, add edamame to the pot. Cook, stirring occasionally, until just warmed through, about 1 minute.",
      "secondary_message": "4 ½ cups edamame"
    },
    {
      "id": 365115,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add sauce, stir to combine, and continue to cook until heated through, about 30 seconds. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 365116,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 365117,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt.",
      "secondary_message": "2 tbsp virgin coconut oil\n12 eggs\n½ tsp salt"
    },
    {
      "id": 365118,
      "primary_message": "To serve, divide cauliflower rice and eggs between plates. Garnish rice with reserved green onion and sesame seeds. Enjoy!",
      "secondary_message": "⅓ cup sesame seeds"
    }
  ],
