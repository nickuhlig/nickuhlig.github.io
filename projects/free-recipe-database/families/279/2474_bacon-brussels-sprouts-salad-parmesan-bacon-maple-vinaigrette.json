  "instructions": [
    {
      "id": 23944,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 23945,
      "primary_message": "Chop bacon into smaller pieces.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 23946,
      "primary_message": "Add bacon to skillet and cook, stirring occasionally, until crispy, 4-5 minutes. Transfer the bacon to a large bowl and pour ¼ cup of the fat from the skillet into a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 23947,
      "primary_message": "Peel and mince garlic. To prepare the dressing, add the minced garlic, vinegar, maple syrup, salt, and pepper to reserved bacon fat. Whisk together until well combined. Set aside.",
      "secondary_message": "2 cloves garlic\r\n4 tbsp apple cider vinegar\r\n2 tsp pure maple syrup\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 23948,
      "primary_message": "Wash brussels sprouts and trim rough ends. Shred by slicing thinly or using a mandoline slicer; add to bowl with bacon.",
      "secondary_message": "2 lb brussels sprouts\r\n"
    },
    {
      "id": 23949,
      "primary_message": "Roughly chop almonds and add to bowl.",
      "secondary_message": "½ cup almonds\r\n"
    },
    {
      "id": 23950,
      "primary_message": "Grate ½ cup of Parmesan and add to bowl.",
      "secondary_message": "2 oz Parmesan cheese\r\n"
    },
    {
      "id": 23951,
      "primary_message": "Add dressing to salad and toss until well combined.",
      "secondary_message": ""
    },
    {
      "id": 23952,
      "primary_message": "Serve on a plate or in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
