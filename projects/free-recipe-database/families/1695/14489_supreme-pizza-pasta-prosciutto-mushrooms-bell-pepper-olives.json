  "instructions": [
    {
      "id": 240143,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n15 oz spaghetti pasta"
    },
    {
      "id": 240144,
      "primary_message": "Meanwhile, wash, dry, and thinly slice mushrooms; transfer to a large bowl.",
      "secondary_message": "1 ½ lb cremini mushrooms"
    },
    {
      "id": 240145,
      "primary_message": "Wash, dry, trim, seed, and medium dice bell peppers; add to the bowl with the mushrooms.",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 240146,
      "primary_message": "Peel and mince onions and garlic; add both to the bowl along with the spices. Set aside.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 240147,
      "primary_message": "Use the tip of a knife to slice down the length of each sausage. Peel off casings and discard. ",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 240148,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 240149,
      "primary_message": "Once the pot is hot, working in batches if necessary, add the prosciutto and cook until crispy, about 1 minute per side. Remove prosciutto to a plate and set aside.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 240150,
      "primary_message": "Return the pot to medium-high heat. Add sausage meat and cook, breaking apart with a wooden spoon, until browned and cooked through, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 240151,
      "primary_message": "Add veggies and spices to the pot with the sausage. Continue to cook, stirring occasionally, until veggies are tender, 6-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 240152,
      "primary_message": "Meanwhile, using a clean cutting board, thinly slice olives.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 240153,
      "primary_message": "Add olives and tomato sauce to the skillet, stir to combine, and bring to a boil; reduce heat and simmer 5 minutes more.",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 240154,
      "primary_message": "Crumble or chop the prosciutto into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 240155,
      "primary_message": "Drain pasta in a colander and return to the pot.",
      "secondary_message": null
    },
    {
      "id": 240156,
      "primary_message": "Add the \"Supreme Pizza\" sauce to the pot with the pasta and stir gently to combine.",
      "secondary_message": null
    },
    {
      "id": 240157,
      "primary_message": "To serve, divide pasta between bowls and top with crumbled prosciutto. Enjoy!",
      "secondary_message": null
    }
  ],
