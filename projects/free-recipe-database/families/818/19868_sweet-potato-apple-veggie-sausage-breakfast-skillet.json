  "instructions": [
    {
      "id": 331670,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.23 kg sweet potato\n1 Granny Smith apple\n½ (142 g) pkg baby spinach\n½ lemon"
    },
    {
      "id": 331671,
      "primary_message": "Peel and small dice sweet potato; place in a small saucepan, cover with hot water (from the tap), and bring to a boil over high heat. Once boiling, reduce heat and simmer, stirring occasionally, until tender 6-8 minutes; drain and set aside. ",
      "secondary_message": null
    },
    {
      "id": 331672,
      "primary_message": "Meanwhile, peel and small dice onion; place in a small bowl. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 331673,
      "primary_message": "Slice sausages crosswise into ½-inch thick rounds and add to the bowl with the onion.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 331674,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 331675,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and sausage. Cook, stirring occasionally, until onion is soft and sausage is warmed through, 4-5 minutes (or cook sausages according to package instructions).",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 331676,
      "primary_message": "Meanwhile, quarter, core, and small dice apple. ",
      "secondary_message": null
    },
    {
      "id": 331677,
      "primary_message": "When the sausage is done, reduce heat to medium, then add sweet potato and apple to the skillet; cook, stirring occasionally, until the apple has softened, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331678,
      "primary_message": "When the apple is soft, add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 331679,
      "primary_message": "Juice lemon into the skillet, season with salt, and stir to combine; remove from heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 331680,
      "primary_message": "To serve, divide sausage and veggies between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
