  "instructions": [
    {
      "id": 331637,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.23 kg sweet potato\n1 Granny Smith apple\n½ (142 g) pkg baby spinach\n½ lemon"
    },
    {
      "id": 331638,
      "primary_message": "Peel and small dice the potato (cut into ¼-inch cubes). Transfer to a medium saucepan and cover with hot water (from the tap). Bring to a boil over high heat; reduce heat and simmer, covered, for 7 minutes. Once finished, drain the potatoes and set aside. ",
      "secondary_message": null
    },
    {
      "id": 331639,
      "primary_message": "Slice the sausage into ½-inch thick rounds.",
      "secondary_message": "1 pork sausage"
    },
    {
      "id": 331640,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 ½ tsp butter, unsalted"
    },
    {
      "id": 331641,
      "primary_message": "Add the sausage to the skillet and cook, stirring occasionally, until browned on all sides and cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 331642,
      "primary_message": "Peel and small dice onion. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 331643,
      "primary_message": "Turn the heat to medium and add the potatoes and onion. Cook, stirring occasionally, until the onion has softened, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331644,
      "primary_message": "Core and small dice the apple. ",
      "secondary_message": null
    },
    {
      "id": 331645,
      "primary_message": "Turn the heat to low. Stir in the apples and spinach and cook, stirring occasionally until the spinach has wilted, 2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331646,
      "primary_message": "Remove the skillet from the heat. Juice the lemon into the skillet and stir to combine; season with salt. ",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 331647,
      "primary_message": "Divide the veggies and sausage between plates and enjoy! ",
      "secondary_message": null
    }
  ],
