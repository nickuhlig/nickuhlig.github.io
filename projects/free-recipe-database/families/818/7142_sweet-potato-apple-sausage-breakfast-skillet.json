  "instructions": [
    {
      "id": 331659,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg sweet potato\n3 Granny Smith apples\n1 ½ (142 g) pkg baby spinach\n1 ½ lemons"
    },
    {
      "id": 331660,
      "primary_message": "Peel and small dice the potatoes (cut into ¼-inch cubes). Transfer to a medium saucepan and cover with hot water (from the tap). Bring to a boil over high heat; reduce heat and simmer, covered, for 7 minutes. Once finished, drain the potatoes and set aside. ",
      "secondary_message": null
    },
    {
      "id": 331661,
      "primary_message": "Slice sausages into ½-inch thick rounds.",
      "secondary_message": "3 pork sausages"
    },
    {
      "id": 331662,
      "primary_message": "Preheat a large pot over medium-high heat. Once the pot is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 331663,
      "primary_message": "Add sausages to the pot and cook, stirring occasionally, until browned on all sides and cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 331664,
      "primary_message": "Peel and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 331665,
      "primary_message": "Turn the heat to medium and add the potatoes and onions. Cook, stirring occasionally, until the onions have softened, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331666,
      "primary_message": "Core and small dice the apples. ",
      "secondary_message": null
    },
    {
      "id": 331667,
      "primary_message": "Turn the heat to low. Stir in the apples and spinach and cook, stirring occasionally, until the spinach has wilted, 4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331668,
      "primary_message": "Remove the pot from the heat. Juice the lemon into the skillet and stir to combine; season with salt. ",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 331669,
      "primary_message": "Divide the veggies and sausage between plates and enjoy! ",
      "secondary_message": null
    }
  ],
