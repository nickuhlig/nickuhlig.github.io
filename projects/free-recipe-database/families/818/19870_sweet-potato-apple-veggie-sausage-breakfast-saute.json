  "instructions": [
    {
      "id": 331692,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg sweet potato\n3 Granny Smith apples\n1 ½ (142 g) pkg baby spinach\n1 ½ lemons"
    },
    {
      "id": 331693,
      "primary_message": "Peel and small dice sweet potatoes; place in a medium saucepan, cover with hot water (from the tap), and bring to a boil over high heat. Once boiling, reduce heat and simmer, stirring occasionally, until tender 6-8 minutes; drain and set aside. ",
      "secondary_message": null
    },
    {
      "id": 331694,
      "primary_message": "Meanwhile, peel and small dice onions; place in a medium bowl. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 331695,
      "primary_message": "Slice sausages crosswise into ½-inch thick rounds and add to the bowl with the onion.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 331696,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 331697,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add onion and sausage. Cook, stirring occasionally, until onion is soft and sausage is warmed through, 5-6 minutes (or cook sausages according to package instructions).",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 331698,
      "primary_message": "Meanwhile, quarter, core, and small dice apples. ",
      "secondary_message": null
    },
    {
      "id": 331699,
      "primary_message": "When the sausage is done, reduce heat to medium, then add sweet potato and apple to the pot; cook, stirring occasionally, until the apple has softened, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 331700,
      "primary_message": "When the apple is soft, add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 331701,
      "primary_message": "Juice lemons into the pot, season with salt, and stir to combine; remove from heat.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 331702,
      "primary_message": "To serve, divide sausage and veggies between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
