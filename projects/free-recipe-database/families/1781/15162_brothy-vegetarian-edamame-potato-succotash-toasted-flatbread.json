  "instructions": [
    {
      "id": 250164,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n1 red bell pepper\n2 sticks celery\n½ pint grape tomatoes\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 250165,
      "primary_message": "Peel and small dice potato; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 250166,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl with the potato.",
      "secondary_message": null
    },
    {
      "id": 250167,
      "primary_message": "Trim and cut celery crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 250168,
      "primary_message": "Peel and mince garlic; add to the bowl and set aside.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 250169,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250170,
      "primary_message": "While the pan heats up, peel, halve, and thinly slice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 250171,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add the onion and spices to the pan; cook, stirring often, until starting to soften, 2-3 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper\n¼ tsp thyme, dried"
    },
    {
      "id": 250172,
      "primary_message": "Add veggies, broth, edamame, corn, and sugar to the pan with the onion. Stir to combine the succotash and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies are tender, about 8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n1 cup edamame, shelled\n½ cup frozen corn\n½ tsp brown sugar"
    },
    {
      "id": 250173,
      "primary_message": "While the succotash is cooking, halve tomatoes and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 250174,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 250175,
      "primary_message": "Toast flatbread if desired (optional), then slice into wedges.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "id": 250176,
      "primary_message": "When the succotash is done, add tomatoes, parsley, and cream to the pan; stir to combine and remove from heat.",
      "secondary_message": "2 fl oz (¼ cup) heavy whipping cream"
    },
    {
      "id": 250177,
      "primary_message": "To serve, divide succotash between bowls and enjoy with warm flatbread on the side!",
      "secondary_message": null
    }
  ],
