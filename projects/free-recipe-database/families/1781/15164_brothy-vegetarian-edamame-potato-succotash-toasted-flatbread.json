  "instructions": [
    {
      "id": 250192,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n3 red bell peppers\n6 sticks celery\n1 ½ pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 250193,
      "primary_message": "Peel and small dice potatoes; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 250194,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl with the potato.",
      "secondary_message": null
    },
    {
      "id": 250195,
      "primary_message": "Trim and cut celery crosswise into ¼-inch thick pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 250196,
      "primary_message": "Peel and mince garlic; add to the bowl and set aside.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 250197,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 250198,
      "primary_message": "While the pot heats up, peel, halve, and thinly slice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 250199,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add the onion and spices to the pot; cook, stirring often, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n1 ½ tsp paprika\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp thyme, dried"
    },
    {
      "id": 250200,
      "primary_message": "Add veggies, broth, edamame, corn, and sugar to the pot with the onion. Stir to combine the succotash and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer, stirring occasionally, until veggies are tender, about 10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "36 fl oz (4 ½ cups) chicken or vegetable broth\n3 cups edamame\n1 ½ cups frozen corn\n1 ½ tsp brown sugar"
    },
    {
      "id": 250201,
      "primary_message": "While the succotash is cooking, halve tomatoes and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 250202,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 250203,
      "primary_message": "Toast flatbread if desired (optional), then slice into wedges.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 250204,
      "primary_message": "When the succotash is done, add tomatoes, parsley, and cream to the pot; stir to combine and remove from heat.",
      "secondary_message": "6 fl oz (¾ cup) heavy whipping cream"
    },
    {
      "id": 250205,
      "primary_message": "To serve, divide succotash between bowls and enjoy with warm flatbread on the side!",
      "secondary_message": null
    }
  ],
