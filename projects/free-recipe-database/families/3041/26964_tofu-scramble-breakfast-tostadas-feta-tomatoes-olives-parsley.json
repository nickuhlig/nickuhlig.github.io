  "instructions": [
    {
      "id": 435517,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 435518,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 435519,
      "primary_message": "Divide tortillas between two additional baking sheets. Drizzle with oil on both sides, then season with salt.",
      "secondary_message": "12 small corn tortillas\n1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 435520,
      "primary_message": "Place tortillas in the oven (it doesn't have to be fully heated) and bake until starting to crisp, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 435521,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 435522,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Crumble tofu into large pieces with your fingers and add to the pot along with spices. Cook, stirring occasionally, until tofu is golden brown, 8-10 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp oregano, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 435523,
      "primary_message": "While the tofu is cooking, wash, dry, and medium dice tomatoes. Place in a medium bowl. ",
      "secondary_message": "6 tomatoes"
    },
    {
      "id": 435524,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes. ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 435525,
      "primary_message": "Roughly chop olives and add to the bowl. ",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 435526,
      "primary_message": "When the tofu is done, remove from the heat. Add tomatoes, parsley, and olives, then stir to combine the scramble. ",
      "secondary_message": null
    },
    {
      "id": 435527,
      "primary_message": "To serve, divide tortillas between plates; top with tofu scramble and feta. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
