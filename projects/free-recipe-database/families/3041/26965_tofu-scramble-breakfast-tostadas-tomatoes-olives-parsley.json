  "instructions": [
    {
      "id": 435528,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 435529,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 435530,
      "primary_message": "Arrange tortillas on another baking sheet. Drizzle with oil on both sides, then season with salt.",
      "secondary_message": "4 small corn tortillas\n1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 435531,
      "primary_message": "Place tortillas in the oven (it doesn't have to be fully heated) and bake until starting to crisp, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 435532,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 435533,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble tofu into large pieces with your fingers and add to the skillet along with spices. Cook, stirring occasionally, until tofu is golden brown, 6-8 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp oregano, dried\n½ tsp garlic powder\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 435534,
      "primary_message": "While the tofu is cooking, wash, dry, and medium dice tomatoes. Place in a small bowl. ",
      "secondary_message": "2 tomatoes"
    },
    {
      "id": 435535,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the tomatoes. ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 435536,
      "primary_message": "Roughly chop olives and add to the bowl. ",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 435537,
      "primary_message": "When the tofu is done, remove from the heat. Add tomatoes, parsley, and olives, then stir to combine the scramble. ",
      "secondary_message": null
    },
    {
      "id": 435538,
      "primary_message": "To serve, divide tortillas between plates and top with tofu scramble. Enjoy!",
      "secondary_message": null
    }
  ],
