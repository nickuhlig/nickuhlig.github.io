  "instructions": [
    {
      "primary_message": "This recipe utilizes 2 (two-compartment) food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce. \n\n",
      "secondary_message": "½ lemon\n¼ small bunch Italian (flat-leaf) parsley\n1 stick celery\n½ jalapeño pepper\n4 small leaf butter (Boston) lettuce\n2 (170 g) pkg raspberries"
    },
    {
      "primary_message": "Zest and juice lemon into a medium bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. Add to the bowl along with tahini, mayo, honey, salt, and pepper, then whisk to combine the dressing.\n\n",
      "secondary_message": "1 clove garlic\n2 tbsp tahini\n1 tbsp mayonnaise\n1 tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then small dice. Add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop dates. Add to the bowl.\n\n",
      "secondary_message": "¼ cup medjool dates, pitted"
    },
    {
      "primary_message": "Roughly chop chicken. Add to the bowl and stir to combine the chicken salad. \n\n",
      "secondary_message": "1 ½ cups cooked chicken (shredded)"
    },
    {
      "primary_message": "Layer the bottom half of each bun with lettuce and chicken salad, then close with the top half of each bun. Wrap sandwiches tightly with plastic wrap and place in one compartment of the containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide raspberries between the second compartments, cover, and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
