  "instructions": [
    {
      "id": 490797,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; drain and place in a medium bowl.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 490798,
      "primary_message": "Peel, halve, and mince onion. Peel and mince garlic. Add both to the bowl with the edamame.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 490799,
      "primary_message": "Add flour, eggs, salt, pepper to the bowl, then using a fork, stir until well combined. (The batter will be soft and sticky.)",
      "secondary_message": "½ cup all-purpose flour\n2 eggs\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 490800,
      "primary_message": "Place bread crumbs and sesame seeds on a plate. Stir to combine, then spread out in an even layer.",
      "secondary_message": "½ cup panko bread crumbs\n1 tbsp sesame seeds"
    },
    {
      "id": 490801,
      "primary_message": "Using a ¼-cup measure, drop edamame batter onto the plate with the bread crumbs. Gently roll each scoop of batter in the crumbs to coat.",
      "secondary_message": null
    },
    {
      "id": 490802,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 490803,
      "primary_message": "Using a spatula, transfer batter to the skillet, spacing the scoops a few inches apart. Use the spatula to press down on the batter to form round fritters. Cook, flipping once, until golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 490804,
      "primary_message": "Meanwhile, place mayo and chili-garlic sauce in a clean small bowl. Whisk to combine the spicy mayo and set aside.",
      "secondary_message": "3 tbsp mayonnaise\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 490805,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 red bell pepper\n½ English cucumber\n1 head butter (Boston) lettuce"
    },
    {
      "id": 490806,
      "primary_message": "Peel and mince ginger; place in a clean medium bowl. Add tahini, vinegar, soy sauce, oil, and chili-garlic sauce. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp tahini\n1 tbsp rice vinegar\n1 tbsp soy sauce\n1 tsp neutral vegetable oil\n½ tsp chili-garlic sauce"
    },
    {
      "id": 490807,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 490808,
      "primary_message": "Trim and small dice cucumber and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 490809,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 490810,
      "primary_message": "To serve, divide salad between plates or bowls. Top with edamame fritters and drizzle with spicy mayo. Enjoy!",
      "secondary_message": null
    }
  ],
