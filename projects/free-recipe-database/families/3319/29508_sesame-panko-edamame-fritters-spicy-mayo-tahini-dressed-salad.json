  "instructions": [
    {
      "id": 490867,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; drain and place in a large bowl.",
      "secondary_message": "3 cups edamame"
    },
    {
      "id": 490868,
      "primary_message": "Peel, halve, and mince onions. Peel and mince garlic. Add both to the bowl with the edamame.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 490869,
      "primary_message": "Add flour, eggs, salt, pepper to the bowl, then using a fork, stir until well combined. (The batter will be soft and sticky.)",
      "secondary_message": "1 ½ cup all-purpose flour\n6 eggs\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 490870,
      "primary_message": "Place bread crumbs and sesame seeds on a large baking sheet pan. Stir to combine, then spread out in an even layer.",
      "secondary_message": "1 ½ cup panko bread crumbs\n3 tbsp sesame seeds"
    },
    {
      "id": 490871,
      "primary_message": "Using a ¼-cup measure, drop edamame batter onto the baking sheet with the bread crumbs. Gently roll each scoop of batter in the crumbs to coat.",
      "secondary_message": null
    },
    {
      "id": 490872,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 490873,
      "primary_message": "Working in batches, using a spatula, transfer batter to the skillet, spacing the scoops a few inches apart. Use the spatula to press down on the batter to form round fritters. Cook, flipping once, until golden brown, 3-5 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 490874,
      "primary_message": "Meanwhile, place mayo and chili-garlic sauce in a clean small bowl. Whisk to combine the spicy mayo and set aside.",
      "secondary_message": "½ cup mayonnaise\n1 ½ tbsp chili-garlic sauce"
    },
    {
      "id": 490875,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 red bell peppers\n1 ½ English cucumbers\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 490876,
      "primary_message": "Peel and mince ginger; place in a clean large bowl. Add tahini, vinegar, soy sauce, oil, and chili-garlic sauce. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp tahini\n3 tbsp rice vinegar\n3 tbsp soy sauce\n1 tbsp neutral vegetable oil\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 490877,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 490878,
      "primary_message": "Trim and small dice cucumbers and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 490879,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 490880,
      "primary_message": "To serve, divide salad between plates or bowls. Top with edamame fritters and drizzle with spicy mayo. Enjoy!",
      "secondary_message": null
    }
  ],
