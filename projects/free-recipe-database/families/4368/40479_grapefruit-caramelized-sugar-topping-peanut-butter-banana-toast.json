  "instructions": [
    {
      "id": 626490,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. ",
      "secondary_message": null
    },
    {
      "id": 626491,
      "primary_message": "Wash, dry, and cut grapefruit in half crosswise. (To make eating the grapefruit easier, score the grapefruit, separating the segments from the membrane, using a sharp knife.) Transfer grapefruit to a baking sheet pan, cut-side up, and sprinkle tops evenly with sugar.",
      "secondary_message": "1 grapefruit\n1 tbsp brown sugar"
    },
    {
      "id": 626492,
      "primary_message": "Place baking sheet in the oven and broil until sugar is caramelized, 2-3 minutes. Remove from oven and set grapefruit aside. (Reserve baking sheet for the next step.)",
      "secondary_message": null
    },
    {
      "id": 626493,
      "primary_message": "Arrange bread on the reserved baking sheet. Place in the oven and broil, flipping halfway through, until toasted, 1-2 minutes. Remove from oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 626494,
      "primary_message": "Meanwhile, peel and thinly slice banana.",
      "secondary_message": "1 banana"
    },
    {
      "id": 626495,
      "primary_message": "Spread peanut butter over each slice of toast, then top with banana slices.",
      "secondary_message": "3 tbsp natural peanut butter"
    },
    {
      "id": 626496,
      "primary_message": "To serve, divide grapefruit and peanut butter-banana toast between plates. Enjoy!",
      "secondary_message": null
    }
  ],
