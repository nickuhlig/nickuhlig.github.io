  "instructions": [
    {
      "id": 280393,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 bunch radish\n2 limes\n1 mango\n1 English cucumber\n2 jalapeño peppers\n1 small bunch cilantro\n1 head romaine lettuce"
    },
    {
      "id": 280394,
      "primary_message": "Place vinegar, water, sugar, and salt in a medium saucepan; stir to combine. Bring the pickling liquid to a boil over high heat.",
      "secondary_message": "½ cup rice vinegar\n½ cup water\n4 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 280395,
      "primary_message": "Meanwhile, peel, trim, and cut carrots into thin matchsticks. Trim and thinly slice radishes.",
      "secondary_message": null
    },
    {
      "id": 280396,
      "primary_message": "Once the pickling liquid has come to a boil, add carrots and radishes; stir to combine, remove from heat, and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 280397,
      "primary_message": "Peel and mince garlic. Place half the garlic in a small bowl (reserving the rest for the next step); add mayo and stir to combine the garlic aioli. Set aside.",
      "secondary_message": "4 cloves garlic\n⅓ cup mayonnaise"
    },
    {
      "id": 280398,
      "primary_message": "Juice limes into a large bowl; add remaining garlic, oil, sugar, soy sauce, and pepper. Whisk to combine the salad dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp brown sugar\n1 tbsp soy sauce\n¼ tsp black pepper"
    },
    {
      "id": 280399,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides. Roughly chop and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 280400,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 280401,
      "primary_message": "Thinly slice the jalapeño peppers into rounds; add to the plate with the cucumber. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 280402,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the mango; place the other half on the plate with the veggies. Set aside.",
      "secondary_message": null
    },
    {
      "id": 280403,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 280404,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n8 eggs"
    },
    {
      "id": 280405,
      "primary_message": "While the eggs are cooking, chop or tear romaine into bite-sized pieces and add to the bowl with the mango and cilantro. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 280406,
      "primary_message": "Split rolls in half; working in batches if necessary, toast, cut-side down, in another skillet over medium-high heat or in a toaster (optional).",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 280407,
      "primary_message": "Divide toasted rolls between plates; spread each half with a layer of garlic aioli, then top with cucumber, pickled carrots and radish, eggs, jalapeños, and cilantro. Drizzle with soy sauce and season with pepper. Serve with salad on the side and enjoy!",
      "secondary_message": "2 tsp soy sauce\n⅛ tsp black pepper"
    }
  ],
