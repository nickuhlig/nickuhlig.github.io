  "instructions": [
    {
      "id": 280378,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n½ bunch radish\n1 lime\n½ mango\n½ English cucumber\n1 jalapeño pepper\n½ small bunch cilantro\n½ head romaine lettuce"
    },
    {
      "id": 280379,
      "primary_message": "Place vinegar, water, sugar, and salt in a small saucepan; stir to combine. Bring the pickling liquid to a boil over high heat.",
      "secondary_message": "¼ cup rice vinegar\n¼ cup water\n2 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 280380,
      "primary_message": "Meanwhile, peel, trim, and cut carrot into thin matchsticks. Trim and thinly slice radishes.",
      "secondary_message": null
    },
    {
      "id": 280381,
      "primary_message": "Once the pickling liquid has come to a boil, add carrots and radishes; stir to combine, remove from heat, and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 280382,
      "primary_message": "Peel and mince garlic. Place half the garlic in a small bowl (reserving the rest for the next step); add mayo and stir to combine the garlic aioli. Set aside.",
      "secondary_message": "2 cloves garlic\n3 tbsp mayonnaise"
    },
    {
      "id": 280383,
      "primary_message": "Juice lime into a medium bowl; add remaining garlic, oil, sugar, soy sauce, and pepper. Whisk to combine the salad dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp brown sugar\n1 ½ tsp soy sauce\n⅛ tsp black pepper"
    },
    {
      "id": 280384,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides. Roughly chop and add to the bowl with the dressing; set aside.",
      "secondary_message": null
    },
    {
      "id": 280385,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 280386,
      "primary_message": "Thinly slice the jalapeño pepper into rounds; add to the plate with the cucumber. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 280387,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the mango; place the other half on the plate with the veggies. Set aside.",
      "secondary_message": null
    },
    {
      "id": 280388,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 280389,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs"
    },
    {
      "id": 280390,
      "primary_message": "While the eggs are cooking, chop or tear romaine into bite-sized pieces and add to the bowl with the mango and cilantro. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 280391,
      "primary_message": "Split rolls in half and toast, cut-side down, in another skillet over medium-high heat or in a toaster (optional).",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 280392,
      "primary_message": "Divide toasted rolls between plates; spread each half with a layer of garlic aioli, then top with cucumber, pickled carrots and radish, eggs, jalapeños, and cilantro. Drizzle with soy sauce and season with pepper. Serve with salad on the side and enjoy!",
      "secondary_message": "1 tsp soy sauce\n1 pinch black pepper"
    }
  ],
