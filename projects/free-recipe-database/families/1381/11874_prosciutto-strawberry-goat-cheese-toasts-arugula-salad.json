  "instructions": [
    {
      "id": 200791,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 200792,
      "primary_message": "Crumble goat cheese into a medium bowl and set aside to soften.",
      "secondary_message": "3 (4 oz) logs goat cheese"
    },
    {
      "id": 200793,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n3 (16 oz) pkg strawberries\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 200794,
      "primary_message": "Divide bread slices between two baking sheet pans. Place one baking sheet in the oven and broil, flipping halfway through, until toasted, 1-2 minutes. Remove toast from the oven and set aside. Repeat with the remaining baking sheet. (Keep the broiler on.)",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 200795,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Transfer to a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 200796,
      "primary_message": "Add vinegar, oil, honey, and spices to the bowl with the basil; whisk to combine the marinade. ",
      "secondary_message": "⅓ cup rice vinegar\n¼ cup extra virgin olive oil\n2 tbsp honey\n¾ tsp salt\n¼ tsp black pepper\n3 pinch cinnamon"
    },
    {
      "id": 200797,
      "primary_message": "Trim and thinly slice strawberries. Add to the bowl with the marinade, toss to combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 200798,
      "primary_message": "Peel and mince garlic; add to the bowl with the goat cheese and mash with a fork to combine. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 200799,
      "primary_message": "Spread goat cheese mixture evenly over the toast. Return one baking sheet to the oven, and broil until the cheese browns slightly, 1-2 minutes. Remove from the oven and repeat with the second baking sheet.",
      "secondary_message": null
    },
    {
      "id": 200800,
      "primary_message": "Using a slotted spoon, remove strawberries from the marinade and arrange on top of the toast. (Reserve leftover marinade for the salad.)",
      "secondary_message": null
    },
    {
      "id": 200801,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces and place on top of toast. ",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 200802,
      "primary_message": "Add arugula to the bowl with the reserved marinade and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 200803,
      "primary_message": "To serve, divide toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
