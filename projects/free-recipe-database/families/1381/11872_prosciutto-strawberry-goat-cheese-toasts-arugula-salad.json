  "instructions": [
    {
      "id": 200765,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 200766,
      "primary_message": "Crumble goat cheese into a small bowl and set aside to soften.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 200767,
      "primary_message": "Meanwhile wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small pkg fresh basil\n1 (16 oz) pkg strawberries\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 200768,
      "primary_message": "Arrange bread slices on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, 1-2 minutes. Remove toast from the oven and set aside. (Keep the broiler on.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 200769,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Transfer to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 200770,
      "primary_message": "Add vinegar, oil, honey, and spices to the bowl with the basil; whisk to combine the marinade. ",
      "secondary_message": "2 tbsp rice vinegar\n1 ½ tbsp extra virgin olive oil\n2 tsp honey\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch cinnamon"
    },
    {
      "id": 200771,
      "primary_message": "Trim and thinly slice strawberries. Add to the bowl with the marinade, toss to combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 200772,
      "primary_message": "Peel and mince garlic; add to the bowl with the goat cheese and mash with a fork to combine. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 200773,
      "primary_message": "Spread goat cheese mixture evenly over the toast. Return baking sheet to the oven and broil until the cheese browns slightly, 1-2 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 200774,
      "primary_message": "Using a slotted spoon, remove strawberries from the marinade and arrange on top of the toast. (Reserve leftover marinade for the salad.)",
      "secondary_message": null
    },
    {
      "id": 200775,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces and place on top of toast. ",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 200776,
      "primary_message": "Add arugula to the bowl with the reserved marinade and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 200777,
      "primary_message": "To serve, divide toasts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
