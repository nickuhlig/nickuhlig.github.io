  "instructions": [
    {
      "id": 438408,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 438409,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ lime\n1 tomato\n½ green bell pepper\n½ jalapeño pepper"
    },
    {
      "id": 438410,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 438411,
      "primary_message": "Add oil, salt, and pepper to the bowl with the cauliflower, then stir to combine. Transfer cauliflower rice to a baking sheet pan and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 438412,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until the rice is golden and tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 438413,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 438414,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb ribeye steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 438415,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 438416,
      "primary_message": "Meanwhile, peel and mince shallot and garlic. Place both in the reserved bowl.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 438417,
      "primary_message": "Juice lime into the bowl with the shallot, then add oil, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 438418,
      "primary_message": "Small dice tomato. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 438419,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 438420,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl, stir to combine the salsa, and set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 438421,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 438422,
      "primary_message": "To serve, divide steak and cauliflower rice between plates; top steak with salsa. Enjoy!",
      "secondary_message": null
    }
  ],
