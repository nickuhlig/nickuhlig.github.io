  "instructions": [
    {
      "id": 438528,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 438529,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ limes\n3 tomatoes\n1 ½ green bell peppers\n1 ½ jalapeño peppers"
    },
    {
      "id": 438530,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 438531,
      "primary_message": "Add oil, salt, and pepper to the bowl with the cauliflower, then stir to combine. Divide cauliflower rice between two baking sheet pans and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 438532,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until the rice is golden and tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 438533,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 438534,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 438535,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 438536,
      "primary_message": "Meanwhile, peel, halve, and mince onion; peel and mince garlic. Place both in the reserved bowl.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 438537,
      "primary_message": "Juice limes into the bowl with the onion, then add oil, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 438538,
      "primary_message": "Small dice tomatoes. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 438539,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 438540,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level, then mince. Add to the bowl, stir to combine the salsa, and set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 438541,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 438542,
      "primary_message": "To serve, divide steak and cauliflower rice between plates; top steak with salsa. Enjoy!",
      "secondary_message": null
    }
  ],
