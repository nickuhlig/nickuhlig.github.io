  "instructions": [
    {
      "id": 612001,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 612002,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "⅓ kg ribeye steak\n½ tsp salt\n¼ tsp black pepper\n¼ tsp coriander, ground"
    },
    {
      "id": 612003,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp toasted sesame oil"
    },
    {
      "id": 612004,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "½ lime\n½ medium head napa cabbage\n2 medium carrots\n½ English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 612005,
      "primary_message": "Zest and juice lime into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 612006,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime, along with mayo, coconut aminos, oil, chili-garlic sauce, and spices, then whisk to combine the dressing. ",
      "secondary_message": "1 clove garlic\n1 tbsp avocado oil mayonnaise\n2 tsp coconut aminos\n1 tsp toasted sesame oil\n½ tsp chili-garlic sauce\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 612007,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 612008,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 612009,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 612010,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 612011,
      "primary_message": "Drain and roughly chop water chestnuts. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "57 g water chestnuts"
    },
    {
      "id": 612012,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 612013,
      "primary_message": "To serve, divide salad and steak between plates or bowls, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
