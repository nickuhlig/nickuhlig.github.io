  "instructions": [
    {
      "id": 611871,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 611872,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp coriander, ground"
    },
    {
      "id": 611873,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 611874,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 ½ limes\n1 ½ medium heads napa cabbage\n6 medium carrots\n1 ½ English cucumbers\n1 small bunch cilantro"
    },
    {
      "id": 611875,
      "primary_message": "Zest and juice limes into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 611876,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lime, along with mayo, soy sauce, honey, oil, chili-garlic sauce, and spices, then whisk to combine the dressing. ",
      "secondary_message": "3 cloves garlic\n3 tbsp mayonnaise\n2 tbsp soy sauce\n2 tbsp honey\n1 tbsp toasted sesame oil\n1 ½ tsp chili-garlic sauce\n1 ½ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 611877,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 611878,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 611879,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 611880,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 611881,
      "primary_message": "Drain and roughly chop water chestnuts. Add to the bowl, toss to combine the salad, and set aside.",
      "secondary_message": "6 oz water chestnuts"
    },
    {
      "id": 611882,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 611883,
      "primary_message": "To serve, divide salad and steak between plates or bowls, then sprinkle with sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
