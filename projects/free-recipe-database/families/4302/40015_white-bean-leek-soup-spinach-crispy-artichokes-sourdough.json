  "instructions": [
    {
      "id": 620652,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 leeks\n1 small pkg fresh thyme\n2 (5 oz) pkgs baby spinach\n1 lemon"
    },
    {
      "id": 620653,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620654,
      "primary_message": "Slide thyme leaves off the stems; discard stems and mince the leaves. Add to the bowl with the leek. ",
      "secondary_message": null
    },
    {
      "id": 620655,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620656,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 620657,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leek, thyme, onion, garlic, nutritional yeast, and spices; cook, stirring occasionally, until veggies are tender, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ cup nutritional yeast flakes\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 620658,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 620659,
      "primary_message": "When the veggies are tender, add beans and broth to the pot; stir to combine and bring to a boil. Once boiling, reduce to a simmer and cook, stirring occasionally, until veggies and beans are very soft, 8-10 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 620660,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620661,
      "primary_message": "While the skillet heats up, drain and roughly chop artichokes.",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 620662,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add artichokes, nutritional yeast, pepper, and salt; cook, turning occasionally, until golden and crispy, 4-6 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ cup nutritional yeast flakes\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 620663,
      "primary_message": "Meanwhile, roughly chop spinach.",
      "secondary_message": null
    },
    {
      "id": 620664,
      "primary_message": "When the soup is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat, juice lemon into the pot, and stir to combine the soup.",
      "secondary_message": null
    },
    {
      "id": 620665,
      "primary_message": "Toast bread (if desired), then cut in half.",
      "secondary_message": "4 slices sourdough bread"
    },
    {
      "id": 620666,
      "primary_message": "Divide soup between bowls and top with crispy artichokes. Serve with bread and enjoy!",
      "secondary_message": null
    }
  ],
