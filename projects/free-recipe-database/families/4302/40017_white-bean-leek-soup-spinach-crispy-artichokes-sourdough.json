  "instructions": [
    {
      "id": 620682,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 leek\n½ small pkg fresh thyme\n1 (142 g) pkg baby spinach\n½ lemon"
    },
    {
      "id": 620683,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620684,
      "primary_message": "Slide thyme leaves off the stems; discard stems and mince the leaves. Add to the bowl with the leek. ",
      "secondary_message": null
    },
    {
      "id": 620685,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620686,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 620687,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add leek, thyme, onion, garlic, nutritional yeast, and spices; cook, stirring occasionally, until veggies are tender, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ cup nutritional yeast flakes\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 620688,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 620689,
      "primary_message": "When the veggies are tender, add beans and broth to the pan; stir to combine and bring to a boil. Once boiling, reduce to a simmer and cook, stirring occasionally, until veggies and beans are very soft, 8-10 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 620690,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620691,
      "primary_message": "While the skillet heats up, drain and roughly chop artichokes.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 620692,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add artichokes, nutritional yeast, pepper, and salt; cook, turning occasionally, until golden and crispy, 4-6 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ cup nutritional yeast flakes\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 620693,
      "primary_message": "Meanwhile, roughly chop spinach.",
      "secondary_message": null
    },
    {
      "id": 620694,
      "primary_message": "When the soup is done, add spinach to the pan in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat, juice lemon into the pan, and stir to combine the soup.",
      "secondary_message": null
    },
    {
      "id": 620695,
      "primary_message": "Toast bread (if desired), then cut in half.",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 620696,
      "primary_message": "Divide soup between bowls and top with crispy artichokes. Serve with bread and enjoy!",
      "secondary_message": null
    }
  ],
