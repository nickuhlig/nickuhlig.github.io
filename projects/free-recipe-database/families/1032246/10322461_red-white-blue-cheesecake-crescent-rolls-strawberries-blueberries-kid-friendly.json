  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to 375°F. Coat a baking sheet pan with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Grate cream cheese into a small bowl. Add sugar and vanilla, then mash with the back of a spoon to combine. Set aside.\n\n",
      "secondary_message": "½ (227 g) block cream cheese\n3 tbsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "primary_message": "Wash, dry, trim, and thinly slice strawberries. Place on a plate.\n\n",
      "secondary_message": "¼ (454 g) pkg strawberries"
    },
    {
      "primary_message": "Wash and dry blueberries. Add to the plate with the strawberries and set aside.\n\n",
      "secondary_message": "½ (170 g) pkg blueberries"
    },
    {
      "primary_message": "Open the crescent roll package and unroll the dough onto a flat surface. Separate into 8 triangles along the perforated lines. \n\n",
      "secondary_message": "1 (228 g) tube crescent roll dough"
    },
    {
      "primary_message": "Spread an even layer of cream cheese at the base of each triangle (about 1 tablespoon), then top with a small handful of berries. Working from the base, roll the pastry around the berries and cream cheese.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange rolls on the baking sheet, spacing them at least 1 inch apart.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place rolls in the oven and bake until golden, about 12 minutes. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange rolls on a platter, share, and enjoy!",
      "secondary_message": null
    }
  ],
