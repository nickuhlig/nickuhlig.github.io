  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cube the unsalted butter. Chop the walnuts.",
      "secondary_message": "10 tbsp (5 oz) unsalted butter\n½ cup walnuts"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 175°C (350°F). Grease a 9- by 23-cm baking pan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In large bowl, stir butter with sugar and salt until creamy. Stir in egg and vanilla.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add flour, cocoa, and baking soda to bowl and stir to combine. Stir in 1/2 white chocolate chips, bittersweet chocolate chocolate chips, nuts, and cherries (if using).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spread into pan and smooth top. Bake until center is just set, 20 to 25 minutes. Let cool in pan 30 minutes. Cut into squares.",
      "secondary_message": null
    }
