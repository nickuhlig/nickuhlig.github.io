  "instructions": [
    {
      "id": 234987,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 234988,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 234989,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n1 small bunch fresh dill\n1 ½ English cucumbers\n3 red bell peppers"
    },
    {
      "id": 234990,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "2 ½ cups edamame"
    },
    {
      "id": 234991,
      "primary_message": "Place pita on a flat surface. Holding a knife parallel to the cutting board, cut each pita in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and divide between two baking sheet pans.",
      "secondary_message": "3 whole grain pitas"
    },
    {
      "id": 234992,
      "primary_message": "Zest lemons into a large bowl. Add oil and spices to the bowl, then stir to combine the herb oil. (Reserve lemons for the salad.)",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch basil, dried\n3 pinch oregano, dried"
    },
    {
      "id": 234993,
      "primary_message": "Spoon herb oil over the pita. Toss pita with your hands, then spread out in an even layer. Transfer to the oven and bake, flipping halfway through, until the pita chips are crisp, 6-8 minutes. Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 234994,
      "primary_message": "Meanwhile, juice lemons into the bowl used for the herb oil.",
      "secondary_message": null
    },
    {
      "id": 234995,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice along with mayo, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¾ cup vegan mayonnaise\n1 tbsp red wine vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 234996,
      "primary_message": "Thinly slice olives and add to the bowl with the dressing.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 234997,
      "primary_message": "Peel and small dice red onion; add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 234998,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 234999,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl, along with the edamame, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 235000,
      "primary_message": "To serve, divide quinoa, edamame salad, and pita chips between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
