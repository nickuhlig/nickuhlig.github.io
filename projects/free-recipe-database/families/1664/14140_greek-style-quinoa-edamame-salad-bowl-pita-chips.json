  "instructions": [
    {
      "id": 234959,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 234960,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 234961,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ small bunch fresh dill\n½ English cucumber\n1 red bell pepper"
    },
    {
      "id": 234962,
      "primary_message": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "¾ cup edamame, shelled"
    },
    {
      "id": 234963,
      "primary_message": "Place pita on a flat surface. Holding a knife parallel to the cutting board, cut the pita in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and place on a baking sheet pan.",
      "secondary_message": "1 whole grain pita"
    },
    {
      "id": 234964,
      "primary_message": "Zest lemon into a medium bowl. Add oil and spices to the bowl, then stir to combine the herb oil. (Reserve lemon for the salad.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ tsp salt\n1 pinch basil, dried\n1 pinch oregano, dried"
    },
    {
      "id": 234965,
      "primary_message": "Spoon herb oil over the pita. Toss pita with your hands, then spread out in an even layer. Transfer to the oven and bake, flipping halfway through, until the pita chips are crisp, 6-8 minutes. Remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 234966,
      "primary_message": "Meanwhile, juice lemon into the bowl used for the herb oil.",
      "secondary_message": null
    },
    {
      "id": 234967,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice along with mayo, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup vegan mayonnaise\n1 tsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 234968,
      "primary_message": "Thinly slice olives and add to the bowl with the dressing.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 234969,
      "primary_message": "Peel and small dice shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 234970,
      "primary_message": "Trim and medium dice cucumber; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 234971,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl, along with the edamame, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 234972,
      "primary_message": "To serve, divide quinoa, edamame salad, and pita chips between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
