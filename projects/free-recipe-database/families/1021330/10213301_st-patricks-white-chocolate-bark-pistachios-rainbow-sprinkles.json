  "instructions": [
    {
      "primary_message": "Line the bottom of a small baking dish with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Uncover the pan and place a medium, heat-proof, bowl over the simmering water, allowing it to sit on the rim. Add chocolate and oil to the bowl; using a silicone spatula, stir continuously, until melted.",
      "secondary_message": "1 cup white chocolate chips\n1 tsp virgin coconut oil"
    },
    {
      "primary_message": "Remove bowl from the heat. Add salt and food coloring, then stir until chocolate is smooth and bright green in color.",
      "secondary_message": "⅛ tsp salt\n8 drop green food coloring"
    },
    {
      "primary_message": "Pour chocolate mixture into the baking dish. Using the silicone spatula, spread out to a thickness of ¼-inch.",
      "secondary_message": null
    },
    {
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "primary_message": "Scatter pistachios and sprinkles over the chocolate. Place baking dish in the refrigerator and chill until bark is firm, 10-15 minutes.",
      "secondary_message": "1 tbsp candy sprinkles"
    },
    {
      "primary_message": "Remove bark from the refrigerator, transfer to a cutting board, and chop into large pieces. Store in the refrigerator until ready to serve.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange chocolate bark on a platter. Enjoy!",
      "secondary_message": null
    }
  ],
