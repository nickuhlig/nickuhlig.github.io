  "instructions": [
    {
      "primary_message": "Pat Scallops dry of any excess moisture on each side.",
      "secondary_message": "454 g sea scallops"
    },
    {
      "primary_message": "Season scallops with Salt + Pepper.",
      "secondary_message": "½ tsp kosher salt\n¼ tsp cracked black pepper"
    },
    {
      "primary_message": "Heat oil in Sauté pan on medium high heat until hot, but not smoking.",
      "secondary_message": "2 tbsp canola oil"
    },
    {
      "primary_message": "Add scallops. Scallops should sizzle when placed in pan. Do not overcrowd pan. Once in the pan, do not move scallops.",
      "secondary_message": null
    },
    {
      "primary_message": "Allow to sear for 3-4 minutes. Scallops should have a layer of caramelization.",
      "secondary_message": null
    },
    {
      "primary_message": "Flip scallops and cook for an additional 1-2 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove scallops and reserve warm.",
      "secondary_message": null
    },
    {
      "primary_message": "Turn heat down to low. Add about ¼ cup dry white wine to hot pan and simmer until reduced by half.",
      "secondary_message": "¼ cup dry white wine (such as Sauvignon Blanc)"
    },
    {
      "primary_message": "Add butter and “swirl” pan to melt and create a sauce. Do not boil!",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "primary_message": "Add chives and fresh squeezed lemon juice.",
      "secondary_message": null
    },
    {
      "primary_message": "Generously coat scallops with sauce, top with lemon zest, and serve.",
      "secondary_message": null
    }
  ],
