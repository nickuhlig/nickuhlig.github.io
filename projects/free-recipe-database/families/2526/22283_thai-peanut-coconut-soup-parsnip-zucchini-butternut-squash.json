  "instructions": [
    {
      "id": 372933,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "4 medium parsnips\n2 medium zucchini squash\n1 small bunch cilantro\n1 lime"
    },
    {
      "id": 372934,
      "primary_message": "Place broth, coconut milk, peanut sauce, chili-garlic sauce, salt, and pepper in a large pot. Stir to combine the broth and bring to a boil over high heat. ",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk\n1 cup peanut sauce\n2 tsp chili-garlic sauce\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 372935,
      "primary_message": "Meanwhile, peel, trim, and small dice parsnips. Add to the pot with the broth. ",
      "secondary_message": null
    },
    {
      "id": 372936,
      "primary_message": "Trim and medium dice zucchini. Add to the pot. ",
      "secondary_message": null
    },
    {
      "id": 372937,
      "primary_message": "Once the soup is boiling, reduce heat to low and add butternut squash. Continue to cook, stirring occasionally, until veggies are fork-tender, 8-10 minutes.",
      "secondary_message": "4 cup frozen butternut squash, pieces"
    },
    {
      "id": 372938,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 372939,
      "primary_message": "Cut lime into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 372940,
      "primary_message": "When the soup is done, remove from heat. Add cilantro and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 372941,
      "primary_message": "Divide soup between bowls and serve with lime wedges for squeezing over. Enjoy!",
      "secondary_message": null
    }
  ],
