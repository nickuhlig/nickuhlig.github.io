  "instructions": [
    {
      "id": 372969,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "6 medium parsnips\n3 medium zucchini squash\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 372970,
      "primary_message": "Peel, trim, and small dice parsnips. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 372971,
      "primary_message": "Place broth, coconut milk, peanut sauce, chili-garlic sauce, salt, and pepper in a large pot. Stir to combine the broth and bring to a boil over high heat. ",
      "secondary_message": "2129 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk\n1 ½ cup peanut sauce\n1 tbsp chili-garlic sauce\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 372972,
      "primary_message": "Meanwhile, trim and medium dice zucchini. Add to the pot along with parsnips. ",
      "secondary_message": null
    },
    {
      "id": 372973,
      "primary_message": "Once the soup is boiling, reduce heat to low and add butternut squash. Continue to cook, stirring occasionally, until veggies are fork-tender, 8-10 minutes.",
      "secondary_message": "6 cup frozen butternut squash, pieces"
    },
    {
      "id": 372974,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 372975,
      "primary_message": "Cut limes into wedges and set aside for serving. ",
      "secondary_message": null
    },
    {
      "id": 372976,
      "primary_message": "When the soup is done, remove from heat. Add cilantro and stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 372977,
      "primary_message": "Divide soup between bowls and serve with lime wedges for squeezing over. Enjoy!",
      "secondary_message": null
    }
  ],
