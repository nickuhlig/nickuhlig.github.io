  "instructions": [
    {
      "id": 301005,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium yellow potatoes\n2 medium carrots\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 301006,
      "primary_message": "Peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "id": 301007,
      "primary_message": "Place potatoes in a medium saucepan and cover with hot water (from the tap). Bring to a boil, then reduce heat and simmer until potatoes are fork-tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 301008,
      "primary_message": "Meanwhile, peel and mince onion; peel, trim, and small dice carrots. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 301009,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 301010,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add the onion and carrot. Cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 301011,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 301012,
      "primary_message": "When the veggies are soft, add veggie ground to the skillet, along with half of the parsley and spices (reserving remaining parsley for garnish). Cook, breaking the veggie ground apart with a spoon, until crumbly and cooked through, about 5 minutes.",
      "secondary_message": "454 g veggie ground, plant based\n1 tsp rosemary, dried\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301013,
      "primary_message": "While the veggie ground is cooking, preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 301014,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 301015,
      "primary_message": "When the veggie ground is done, add garlic and soy sauce to the skillet. Cook, stirring occasionally, for 1 minute. ",
      "secondary_message": "4 tsp soy sauce"
    },
    {
      "id": 301016,
      "primary_message": "Add flour and tomato paste to the skillet; stir well, then add broth, peas, and corn. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until thickened, about 5 minutes. ",
      "secondary_message": "2 tbsp all-purpose flour\n2 tbsp tomato paste\n473 ml chicken or vegetable broth\n½ cup frozen peas\n½ cup frozen corn"
    },
    {
      "id": 301017,
      "primary_message": "When the potatoes are done, drain and return to the saucepan. Add broth, oil, garlic powder, and salt; mash with a potato masher until smooth.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n4 tsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 301018,
      "primary_message": "Transfer the veggie ground mixture to a baking dish and spread evenly; top with mashed potatoes. Place in the oven and broil for 2-3 minutes, until the potatoes begin to brown.",
      "secondary_message": null
    },
    {
      "id": 301019,
      "primary_message": "To serve, divide the Shepherd's pie between plates and garnish with remaining parsley. Enjoy! ",
      "secondary_message": null
    }
  ],
