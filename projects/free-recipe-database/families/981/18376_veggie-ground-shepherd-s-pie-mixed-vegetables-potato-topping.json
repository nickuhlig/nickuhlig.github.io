  "instructions": [
    {
      "id": 300927,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium yellow potatoes\n3 medium carrots\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 300928,
      "primary_message": "Peel and small dice potatoes.",
      "secondary_message": null
    },
    {
      "id": 300929,
      "primary_message": "Place potatoes in a large pot and cover with hot water (from the tap). Bring to a boil, then reduce heat and simmer until potatoes are fork-tender, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 300930,
      "primary_message": "Meanwhile, peel and mince onions; peel, trim, and small dice carrots. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 300931,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 300932,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add the onion and carrot. Cook, stirring frequently, until softened, 4-5 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 300933,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 300934,
      "primary_message": "When the veggies are soft, add veggie ground to the skillet, along with half of the parsley and spices (reserving remaining parsley for garnish). Cook, breaking the veggie ground apart with a spoon, until crumbly and cooked through, 5-6 minutes.",
      "secondary_message": "24 oz veggie ground, plant based\n1 ½ tsp rosemary, dried\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 300935,
      "primary_message": "While the veggie ground is cooking, preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 300936,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 300937,
      "primary_message": "When the veggie ground is done, add garlic and soy sauce to the skillet. Cook, stirring occasionally, for 1-2 minutes. ",
      "secondary_message": "2 tbsp soy sauce"
    },
    {
      "id": 300938,
      "primary_message": "Add flour and tomato paste to the skillet; stir well, then add broth, peas, and corn. Bring to a boil over high heat, then reduce heat to low and simmer, stirring occasionally, until thickened, about 5 minutes. ",
      "secondary_message": "3 tbsp all-purpose flour\n3 tbsp tomato paste\n24 fl oz (3 cups) chicken or vegetable broth\n¾ cup frozen peas\n¾ cup frozen corn"
    },
    {
      "id": 300939,
      "primary_message": "When the potatoes are done, drain and return to the pot. Add broth, oil, garlic powder, and salt; mash with a potato masher until smooth.",
      "secondary_message": "6 fl oz (¾ cup) chicken or vegetable broth\n2 tbsp extra virgin olive oil\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 300940,
      "primary_message": "Transfer the veggie ground mixture to a large baking dish and spread evenly; top with mashed potatoes. Place in the oven and broil for 2-3 minutes, until the potatoes begin to brown.",
      "secondary_message": null
    },
    {
      "id": 300941,
      "primary_message": "To serve, divide the Shepherd's pie between plates and garnish with remaining parsley. Enjoy! ",
      "secondary_message": null
    }
  ],
