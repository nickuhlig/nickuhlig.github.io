  "instructions": [
    {
      "id": 300942,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n1 medium carrot\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 300943,
      "primary_message": "Peel and small dice the potatoes.",
      "secondary_message": null
    },
    {
      "id": 300944,
      "primary_message": "Add the potatoes to a medium saucepan and cover with hot water (from the tap). Bring to a boil; reduce heat and simmer, 10-12 minutes, until potatoes are fork-tender.",
      "secondary_message": null
    },
    {
      "id": 300945,
      "primary_message": "Peel and mince the onion. Peel and small dice the carrot. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 300946,
      "primary_message": "Heat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 300947,
      "primary_message": "Add the carrot and onion to the skillet; cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 300948,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 300949,
      "primary_message": "Add the ground turkey to the skillet and break it apart with a spatula. Add half of the minced parsley and the spices. Cook, stirring occasionally, until the meat is browned, 6-8 minutes. ",
      "secondary_message": "⅓ kg ground turkey\n½ tsp rosemary, dried\n½ tsp thyme, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 300950,
      "primary_message": "Preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 300951,
      "primary_message": "Peel and mince the garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 300952,
      "primary_message": "Add the Worcestershire sauce and garlic to the skillet. Cook, stirring occasionally, for 1 minute. ",
      "secondary_message": "2 tsp Worcestershire sauce"
    },
    {
      "id": 300953,
      "primary_message": "Add the flour and tomato paste to the skillet. Stir well, then add the broth, peas, and corn. Bring to a boil over high heat, then reduce heat to low and simmer for 5 minutes, stirring occasionally. ",
      "secondary_message": "1 tbsp all-purpose flour\n1 tbsp tomato paste\n237 ml chicken or vegetable broth\n¼ cup frozen peas\n¼ cup frozen corn"
    },
    {
      "id": 300954,
      "primary_message": "Once the potatoes are done, drain and return to the saucepan. Add the butter, broth, garlic powder, and salt; mash with a potato masher until smooth.",
      "secondary_message": "1 tbsp butter, unsalted\n59 ml (¼ cup) chicken or vegetable broth\n¼ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 300955,
      "primary_message": "Finely grate the Parmesan.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 300956,
      "primary_message": "Transfer the turkey mixture to a small baking dish and spread evenly. Top with mashed potatoes and Parmesan. Place in the oven and broil for 2-3 minutes, until the cheese begins to brown.",
      "secondary_message": null
    },
    {
      "id": 300957,
      "primary_message": "To serve, divide the Shepherd's pie between plates and garnish with remaining parsley. Enjoy! ",
      "secondary_message": null
    }
  ],
