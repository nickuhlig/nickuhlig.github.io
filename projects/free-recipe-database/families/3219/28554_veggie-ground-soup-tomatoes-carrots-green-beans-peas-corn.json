  "instructions": [
    {
      "id": 456440,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456441,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 456442,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and veggie ground to the pot; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based"
    },
    {
      "id": 456443,
      "primary_message": "Add broth, frozen veggies, tomatoes, soy sauce, and spices to the pot, then stir to combine the soup. Cover and bring to a boil over high heat. Once boiling, reduce heat to low and simmer until the veggies are soft, about 10 minutes. Remove from heat.",
      "secondary_message": "2839 ml chicken or vegetable broth\n7 ½ cups frozen mixed vegetables (carrots, corn, green beans, peas)\n3 (398 ml) cans diced tomatoes\n2 tbsp soy sauce\n2 tsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 456444,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 456445,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
