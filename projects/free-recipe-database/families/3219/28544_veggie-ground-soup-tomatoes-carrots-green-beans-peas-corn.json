  "instructions": [
    {
      "id": 456380,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456381,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 456382,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and veggie ground to the pot; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based"
    },
    {
      "id": 456383,
      "primary_message": "Add broth, frozen veggies, tomatoes, soy sauce, and spices to the pot, then stir to combine the soup. Cover and bring to a boil over high heat. Once boiling, reduce heat to low and simmer until the veggies are soft, about 10 minutes. Remove from heat.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n5 cups frozen mixed vegetables (carrots, corn, green beans, peas)\n2 (14.5 oz) cans diced tomatoes\n4 tsp soy sauce\n1 ½ tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 456384,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 456385,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
