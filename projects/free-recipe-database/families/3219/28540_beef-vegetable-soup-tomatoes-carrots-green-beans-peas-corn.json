  "instructions": [
    {
      "id": 456356,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456357,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 456358,
      "primary_message": "Once the pan is hot, add onion and beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "id": 456359,
      "primary_message": "Add broth, frozen veggies, tomatoes, Worcestershire, and spices to the pan, then stir to combine the soup. Cover and bring to a boil over high heat. Once boiling, reduce heat to low and simmer until the veggies are soft, about 10 minutes. Remove from heat.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 ½ cups frozen mixed vegetables (carrots, corn, green beans, peas)\n1 (14.5 oz) can diced tomatoes\n2 tsp Worcestershire sauce\n¾ tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 456360,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.) ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 456361,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
