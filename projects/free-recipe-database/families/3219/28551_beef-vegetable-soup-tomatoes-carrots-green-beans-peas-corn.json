  "instructions": [
    {
      "id": 456422,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 456423,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 456424,
      "primary_message": "Once the pot is hot, add onion and beef; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1.02 kg lean ground beef"
    },
    {
      "id": 456425,
      "primary_message": "Add broth, frozen veggies, tomatoes, Worcestershire, and spices to the pot, then stir to combine the soup. Cover and bring to a boil over high heat. Once boiling, reduce heat to low and simmer until the veggies are soft, about 10 minutes. Remove from heat.",
      "secondary_message": "2839 ml chicken or vegetable broth\n7 ½ cups frozen mixed vegetables (carrots, corn, green beans, peas)\n3 (398 ml) cans diced tomatoes\n2 tbsp Worcestershire sauce\n2 tsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 456426,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add half to the soup and stir to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 456427,
      "primary_message": "To serve, divide soup between bowls and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
