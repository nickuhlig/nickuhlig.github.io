  "instructions": [
    {
      "id": 250776,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 250777,
      "primary_message": "Wash, dry, trim, and seed bell peppers. Cut into ½-inch thick strips and transfer to a baking sheet pan.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 250778,
      "primary_message": "Wash, dry, and halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Slice into thin strips and add to the baking sheet with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": "1 jalapeño pepper"
    },
    {
      "id": 250779,
      "primary_message": "Drizzle the mixed peppers with oil and season with spices; toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 250780,
      "primary_message": "Place baking sheet in the oven and roast, tossing halfway, until peppers are soft and begin to brown, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 250781,
      "primary_message": "Meanwhile, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 250782,
      "primary_message": "While the skillet heats up, peel, halve, and thinly slice onion into half-moons.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 250783,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 250784,
      "primary_message": "Meanwhile, place corn in a colander and run under hot water (from the tap) to thaw; set aside to drain.",
      "secondary_message": "¾ cup frozen corn"
    },
    {
      "id": 250785,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "¼ (8 oz) block cream cheese"
    },
    {
      "id": 250786,
      "primary_message": "Add cream cheese, yogurt, cream, and broth to the skillet with the onion; cook, stirring frequently, until the sauce is smooth, 1-2 minutes.",
      "secondary_message": "½ cup plain Greek yogurt\n4 fl oz (½ cup) heavy whipping cream\n4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 250787,
      "primary_message": "When the peppers are done, add them to the skillet along with the corn; continue to cook, stirring occasionally, until heated through, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 250788,
      "primary_message": "Meanwhile, warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 250789,
      "primary_message": "Divide creamy veggie sauté between bowls; serve with warm tortillas on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
