  "instructions": [
    {
      "id": 250888,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 250889,
      "primary_message": "Wash, dry, trim, and seed bell peppers. Cut into ½-inch thick strips and divide between two baking sheet pans.",
      "secondary_message": "6 green bell peppers"
    },
    {
      "id": 250890,
      "primary_message": "Wash, dry, and halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Slice into thin strips and add to the baking sheets with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": "3 jalapeño peppers"
    },
    {
      "id": 250891,
      "primary_message": "Drizzle the mixed peppers with oil and season with spices; toss to coat, then spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 250892,
      "primary_message": "Place baking sheets in the oven and roast, tossing halfway, until peppers are soft and begin to brown, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 250893,
      "primary_message": "Meanwhile, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 250894,
      "primary_message": "While the pot heats up, peel, halve, and thinly slice onions into half-moons.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 250895,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 250896,
      "primary_message": "Meanwhile, place corn in a colander and run under hot water (from the tap) to thaw; set aside to drain.",
      "secondary_message": "2 ¼ cups frozen corn"
    },
    {
      "id": 250897,
      "primary_message": "Cut cream cheese into small pieces.",
      "secondary_message": "¾ (227 g) block cream cheese"
    },
    {
      "id": 250898,
      "primary_message": "Add cream cheese, yogurt, cream, and broth to the pot with the onion; cook, stirring frequently, until the sauce is smooth, 2-3 minutes.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n355 ml heavy whipping cream\n355 ml chicken or vegetable broth"
    },
    {
      "id": 250899,
      "primary_message": "When the peppers are done, add them to the pot along with the corn; continue to cook, stirring occasionally, until heated through, 4-5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 250900,
      "primary_message": "Meanwhile, warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 250901,
      "primary_message": "Divide creamy veggie sauté between bowls; serve with warm tortillas on the side for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
