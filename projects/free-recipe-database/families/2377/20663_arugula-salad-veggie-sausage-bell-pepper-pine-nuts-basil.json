  "instructions": [
    {
      "id": 346676,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n2 red bell peppers\n1 English cucumber\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 346677,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 346678,
      "primary_message": "Add nutritional yeast, oil, vinegar, and spices to the bowl with the basil; whisk to combine the dressing and set aside. ",
      "secondary_message": "¼ cup nutritional yeast flakes\n3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n1 tsp oregano, dried\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 346679,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346680,
      "primary_message": "While the skillet heats up, slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 346681,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, turning occasionally, until golden brown and crispy, 4-5 minutes (or cook sausages according to package instructions). Remove from heat. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 346682,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 346683,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 346684,
      "primary_message": "Thinly slice sun-dried tomatoes and add to the bowl. ",
      "secondary_message": "8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 346685,
      "primary_message": "Add arugula and pine nuts to the bowl; toss to combine the salad. ",
      "secondary_message": "½ cup pine nuts"
    },
    {
      "id": 346686,
      "primary_message": "To serve, divide salad between plates or bowls and top with crispy sausage. Enjoy!",
      "secondary_message": null
    }
  ],
