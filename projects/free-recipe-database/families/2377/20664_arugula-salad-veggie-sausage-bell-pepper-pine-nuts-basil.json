  "instructions": [
    {
      "id": 346687,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n3 red bell peppers\n1 ½ English cucumbers\n3 (142 g) pkg baby arugula"
    },
    {
      "id": 346688,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 346689,
      "primary_message": "Add nutritional yeast, oil, vinegar, and spices to the bowl with the basil; whisk to combine the dressing and set aside. ",
      "secondary_message": "⅓ cup nutritional yeast flakes\n¼ cup extra virgin olive oil\n¼ cup red wine vinegar\n1 ½ tsp oregano, dried\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 346690,
      "primary_message": "Slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 346691,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 346692,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, turning occasionally, until golden brown and crispy, 5-6 minutes (or cook sausages according to package instructions). Remove from heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 346693,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 346694,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 346695,
      "primary_message": "Thinly slice sun-dried tomatoes and add to the bowl. ",
      "secondary_message": "12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 346696,
      "primary_message": "Add arugula and pine nuts to the bowl; toss to combine the salad. ",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 346697,
      "primary_message": "To serve, divide salad between plates or bowls and top with crispy sausage. Enjoy!",
      "secondary_message": null
    }
  ],
