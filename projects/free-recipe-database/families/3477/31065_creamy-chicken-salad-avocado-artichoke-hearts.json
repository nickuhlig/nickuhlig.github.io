  "instructions": [
    {
      "id": 491750,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 491751,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 491752,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper; cook stirring occasionally, until golden and cooked through, about 4 minutes. Remove to a plate and set aside to cool, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 491753,
      "primary_message": "Meanwhile, wash, dry, zest and juice lemons into a large bowl. Add mayo, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "1 ½ lemons\n¼ cup avocado oil mayonnaise\n2 tbsp Dijon mustard\n1 ½ tsp oregano, dried\n¾ tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 491754,
      "primary_message": "Drain artichoke hearts. Using a clean cutting board, roughly chop artichokes and add to the bowl with the dressing.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 491755,
      "primary_message": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with the cooled chicken, and stir to combine the chicken salad.",
      "secondary_message": "1 ½ avocados"
    },
    {
      "id": 491756,
      "primary_message": "To serve, divide chicken salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
