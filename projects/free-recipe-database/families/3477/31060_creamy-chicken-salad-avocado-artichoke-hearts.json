  "instructions": [
    {
      "id": 491715,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 491716,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "0.23 kg chicken breasts, boneless skinless"
    },
    {
      "id": 491717,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper; cook stirring occasionally, until golden and cooked through, 3-4 minutes. Remove to a plate and set aside to cool, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 491718,
      "primary_message": "Meanwhile, wash, dry, zest and juice lemon into a medium bowl. Add mayo, Dijon, and spices, then whisk to combine the dressing.",
      "secondary_message": "½ lemon\n1 ½ tbsp mayonnaise\n2 tsp Dijon mustard\n½ tsp oregano, dried\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 491719,
      "primary_message": "Drain artichoke hearts. Using a clean cutting board, roughly chop artichokes and add to the bowl with the dressing.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 491720,
      "primary_message": "Wash, dry, halve, and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with the cooled chicken, and stir to combine the chicken salad.",
      "secondary_message": "½ avocado"
    },
    {
      "id": 491721,
      "primary_message": "To serve, divide chicken salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
