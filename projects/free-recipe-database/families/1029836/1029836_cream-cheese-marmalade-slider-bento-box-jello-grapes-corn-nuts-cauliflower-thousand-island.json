  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Place cauliflower in the medium compartment of the bento box.",
      "secondary_message": "½ cup cauliflower florets"
    },
    {
      "primary_message": "Wash and dry grapes. Place grapes and corn nuts in the small compartments of the bento box. ",
      "secondary_message": "⅓ cup red grapes\n⅓ cup corn nuts"
    },
    {
      "primary_message": "Place dressing in a small container with a lid. Place dressing and gelatin snack cup in the large compartment of the bento box.",
      "secondary_message": "2 tbsp Thousand Island dressing\n1 (3.3 oz) gelatin snack cup"
    },
    {
      "primary_message": "Place rolls on a flat surface, then slice crosswise to separate into halves. Spread the bottom half of each with cream cheese and marmalade, then close with the top halves of the rolls. Add sliders to the large compartment of the bento box.",
      "secondary_message": "2 Hawaiian sweet rolls\n3 tbsp whipped cream cheese spread\n2 tbsp orange marmalade"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
