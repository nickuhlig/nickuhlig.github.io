  "instructions": [
    {
      "id": 19279,
      "primary_message": "Wash and dry bell peppers. Seed, slice into thin strips, and transfer to a bowl.",
      "secondary_message": "2 red bell peppers\r\n2 yellow bell peppers"
    },
    {
      "id": 19280,
      "primary_message": "Peel, thinly slice into half rings, and add onion to bowl with peppers. Peel and mince garlic; add ½ to bowl with vegetables and place the other ½ into a medium bowl for preparing guacamole.",
      "secondary_message": "1 medium red onion\r\n4 cloves garlic"
    },
    {
      "id": 19281,
      "primary_message": "Halve avocados and remove pit; scoop out the flesh into bowl with garlic.",
      "secondary_message": "2 avocados"
    },
    {
      "id": 19282,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves. Add ½ to bowl with avocado and save the rest for garnishing.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 19283,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 19284,
      "primary_message": "Add lime juice, salt, and pepper to avocado. Mash with a fork until smooth. Set aside.",
      "secondary_message": "juice of 1 lime\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19285,
      "primary_message": "Slice chicken in half horizontally to form thin fillets, then thinly slice fillets crosswise into strips. Season with salt and pepper.",
      "secondary_message": "0.454 kg chicken breasts, boneless skinless\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19286,
      "primary_message": "Coat bottom of skillet with oil. Add chicken strips and cook until no longer pink, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 19287,
      "primary_message": "Return skillet to stove and add more oil. Add peppers, onion, and garlic from bowl. Stirring frequently, cook until peppers are tender-crisp, 4-5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 19288,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "8 small flour tortillas"
    },
    {
      "id": 19289,
      "primary_message": "Cut remaining ½ lime into wedges.",
      "secondary_message": ""
    },
    {
      "id": 19290,
      "primary_message": "Add chicken and any juices to skillet. Season with chili powder, cumin, salt, and pepper. Stir to combine and cook for 1-2 minutes.",
      "secondary_message": "1 tsp chili powder\r\n1 tsp cumin\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 19291,
      "primary_message": "To serve, place tortillas on a plate and fill with fajita filling. Garnish with guacamole, remaining cilantro, and lime wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
