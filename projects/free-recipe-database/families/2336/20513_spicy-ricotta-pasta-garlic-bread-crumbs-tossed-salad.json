  "instructions": [
    {
      "id": 342104,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 342105,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 342106,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 342107,
      "primary_message": "Add bread crumbs and stir to combine; cook, stirring occasionally, until the garlic bread crumbs are golden and toasted, 4-5 minutes. Remove from heat and transfer to a small bowl to keep the bread crumbs from burning.",
      "secondary_message": "⅔ cup panko bread crumbs"
    },
    {
      "id": 342108,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil over medium-high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a 1-cup cooking water before draining.)",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 342109,
      "primary_message": "While the pasta is cooking, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n2 medium carrots\n1 English cucumber\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 342110,
      "primary_message": "Zest lemon into another small bowl; add ricotta, eggs, and spices. Whisk to combine and set aside. (Reserve lemon for the next step.)",
      "secondary_message": "1 (15 oz) pkg ricotta cheese\n2 eggs\n1 tsp crushed red pepper\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 342111,
      "primary_message": "Juice lemon into a medium bowl; add oil, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Dijon mustard\n1 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 342112,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 342113,
      "primary_message": "Trim and medium dice cucumber; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 342114,
      "primary_message": "When the pasta is done, drain and return to the pot. Add the ricotta mixture and half of the cooking water, then stir to coat the pasta; add additional cooking water, a few tablespoons at a time, if necessary, to coat the noodles in sauce.",
      "secondary_message": null
    },
    {
      "id": 342115,
      "primary_message": "Add mixed greens to the bowl with the dressing and veggies; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 342116,
      "primary_message": "To serve, divide pasta and salad between plates; sprinkle pasta with bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
