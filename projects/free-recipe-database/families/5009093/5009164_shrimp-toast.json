  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely slice the scallions. Grate the garlic on a microplane grater. Remove the crusts from the sandwich bread, then split it into 16 triangles.",
      "secondary_message": "4 scallions\n1 clove garlic\n8 slices sandwich bread"
    },
    {
      "id": 1,
      "primary_message": "Combine shrimp, egg, soy sauce, scallions, cornstarch, cilantro, sesame oil, and garlic in the bowl of a food processor. Pulse until extremely finely minced. Alternatively, chop shrimp by hand with a knife until extremely finely minced, then fold in remaining ingredients in a medium mixing bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spread mixture evenly over one side of each piece of bread. Dip shrimp side into sesame seeds to coat if desired.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil in a wok or Dutch oven to 165°C (325°F). Carefully transfer half of toasts to the oil, shrimp side-down. Cook until golden brown, about 2 minutes, adjusting flame as necessary to maintain heat, then carefully flip toast and cook until second side is golden brown, about 1 minute longer. Transfer to paper towel-lined plate and repeat with remaining toasts. Season with salt and serve immediately.",
      "secondary_message": null
    }
  ],
