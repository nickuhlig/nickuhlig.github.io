  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large bowl, beat together peanut butter and brown sugar until creamy.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add baking soda and salt and beat until combined. Beat in vanilla extract and 1 egg.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Mix in flour just until dough has formed. Cover dough with plastic wrap and let chill for 20 minutes in refrigerator.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Preheat oven to 350°F. Line a baking sheet with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Place egg white in a shallow bowl and lightly beat until loose. Place coconut flakes in a separate shallow bowl.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Roll dough into 1 inch balls. Dip the top of each ball in the egg white, then in coconut flakes. Place on baking sheet.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Press one chocolate button into the center of each ball. Gently reshape cookie into a tight circle if it flattens out.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Bake cookies until golden brown, about 12 minutes. Let cool completely on baking sheet before moving.",
      "secondary_message": null
    }
  ],
