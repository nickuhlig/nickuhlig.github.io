  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the jalapeño pepper crosswise into thin rounds.",
      "secondary_message": "1 jalapeño pepper"
    },
    {
      "id": 1,
      "primary_message": "Fill a small, shallow dish with a thin layer of Tajín or salt. Run lime wedge around the outer rims of 2 rocks glasses and dip rims in Tajín or salt. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a cocktail shaker, muddle roughly 3 to 6 rounds of jalapeño until well crushed and juices have been expressed (how many slices of jalapeño you use will depend on the heat of your jalapeño and your personal spice preference; you can add more than 6 for an even hotter drink, if you like). Add tequila, Cointreau, and lime juice. Fill with ice and shake until thoroughly chilled, about 15 seconds (the bottom of a metal shaker should frost over).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fill glasses with fresh ice and strain margarita into both glasses. Garnish with lime wheels and any remaining jalapeño rounds and serve.",
      "secondary_message": null
    }
  ],
