  "instructions": [
    {
      "id": 497985,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 497986,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "⅓ cup almonds, sliced"
    },
    {
      "id": 497987,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n6 plums\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 497988,
      "primary_message": "Zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 497989,
      "primary_message": "Peel and mince shallots. Add half to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing and set aside. (Reserve remaining shallot for later use.)",
      "secondary_message": "2 shallots\n3 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 497990,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497991,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, bone-in\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 497992,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate and set aside to rest. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 497993,
      "primary_message": "Meanwhile, halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ½-inch thick slices.",
      "secondary_message": null
    },
    {
      "id": 497994,
      "primary_message": "Return skillet (with drippings) to medium heat. Add reserved shallot, plums, water, salt, and pepper. Cook, stirring occasionally, until plums are tender, about 5 minutes. Remove from heat.",
      "secondary_message": "3 tbsp water\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 497995,
      "primary_message": "Meanwhile, add arugula and toasted almonds to the bowl with the dressing. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 497996,
      "primary_message": "To serve, divide pork chops and salad between plates. Top pork chops with sautéed plums and enjoy!",
      "secondary_message": null
    }
  ],
