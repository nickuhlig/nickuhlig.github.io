  "instructions": [
    {
      "id": 585068,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 585069,
      "primary_message": "While the pot heats up, wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 jalapeño peppers\n1 ½ pints grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 585070,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat. (Reserve pot with drippings for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n6 pork sausages"
    },
    {
      "id": 585071,
      "primary_message": "Meanwhile, trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 585072,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 585073,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 585074,
      "primary_message": "Place edamame and corn in the colander and rinse under hot, running water (from the tap) to defrost. Add both to the bowl and set aside.",
      "secondary_message": "3 cups frozen corn\n1 ½ cups edamame"
    },
    {
      "id": 585075,
      "primary_message": "Peel, halve, and medium dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 585076,
      "primary_message": "Return pot (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add onion and cook, stirring occasionally, until golden and softened, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 585077,
      "primary_message": "Add veggies, garlic, salt, and pepper to the pot. Continue to cook, stirring occasionally, until veggies are warmed through and fork-tender, 5-6 minutes more. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 585078,
      "primary_message": "Meanwhile, halve grape tomatoes. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 585079,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 585080,
      "primary_message": "When the veggies are fork-tender, add tomatoes, basil, and vinegar to the pot, then stir to combine the succotash. Remove from heat.",
      "secondary_message": "3 tbsp apple cider vinegar"
    },
    {
      "id": 585081,
      "primary_message": "To serve, divide sausages and succotash between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
