  "instructions": [
    {
      "id": 585096,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 585097,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 jalapeño peppers\n1 small pkg grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 585098,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat. (Reserve skillet with drippings for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n4 pork sausages"
    },
    {
      "id": 585099,
      "primary_message": "Meanwhile, trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 585100,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 585101,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 585102,
      "primary_message": "Place edamame and corn in the colander and rinse under hot, running water (from the tap) to defrost. Add both to the bowl and set aside.",
      "secondary_message": "2 cups frozen corn\n1 cup edamame, shelled"
    },
    {
      "id": 585103,
      "primary_message": "Peel, halve, and medium dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 585104,
      "primary_message": "Return skillet (with drippings) to medium-high heat, add more oil, and swirl to coat the bottom. Add onion and cook, stirring occasionally, until golden and softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 585105,
      "primary_message": "Add veggies, garlic, salt, and pepper to the skillet. Continue to cook, stirring occasionally, until veggies are warmed through and fork-tender, 4-5 minutes more. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 585106,
      "primary_message": "Meanwhile, halve grape tomatoes. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 585107,
      "primary_message": "Pick basil leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 585108,
      "primary_message": "When the veggies are fork-tender, add tomatoes, basil, and vinegar to the skillet, then stir to combine the succotash. Remove from heat.",
      "secondary_message": "2 tbsp apple cider vinegar"
    },
    {
      "id": 585109,
      "primary_message": "To serve, divide sausages and succotash between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
