  "instructions": [
    {
      "id": 631399,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a large bowl.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 631400,
      "primary_message": "Add chicken, bread crumbs, eggs, chili-garlic sauce, oil, and spices to the bowl with the green onion. Using your hands, mix well to combine. Use a ¼-cup measure to form the chicken mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "0.68 kg ground chicken\n¾ cup panko bread crumbs\n3 eggs\n3 tbsp chili-garlic sauce\n2 tbsp toasted sesame oil\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 631401,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 631402,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 631403,
      "primary_message": "Meanwhile, place water, additional chili-garlic sauce, vinegar, sugar, soy sauce, oil, and cornstarch in a medium saucepan. Whisk to combine the sweet 'n' sour sauce.",
      "secondary_message": "¾ cup water\n3 tbsp chili-garlic sauce\n3 tbsp apple cider vinegar\n3 tbsp brown sugar\n2 tbsp soy sauce\n2 tbsp toasted sesame oil\n1 tbsp cornstarch"
    },
    {
      "id": 631404,
      "primary_message": "Set pan over medium-high heat and bring sauce to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 631405,
      "primary_message": "While the sauce is cooking, wash, dry, trim, and cut bok choy in half lengthwise.",
      "secondary_message": "12 baby bok choy"
    },
    {
      "id": 631406,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Working in batches, add bok choy, cut-side down, then drizzle with soy sauce; cover and cook, flipping once, until tender and charred, 3-5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil\n⅓ cup soy sauce"
    },
    {
      "id": 631407,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 631408,
      "primary_message": "To serve, divide fritters, sauce, and bok choy between plates. Top bok choy with peanuts and sesame seeds. Enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
