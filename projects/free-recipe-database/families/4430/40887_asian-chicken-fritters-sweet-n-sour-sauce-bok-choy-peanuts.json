  "instructions": [
    {
      "id": 631379,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 631380,
      "primary_message": "Add chicken, bread crumbs, egg, chili-garlic sauce, oil, and spices to the bowl with the green onion. Using your hands, mix well to combine. Use a ¼-cup measure to form the chicken mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "0.23 kg ground chicken\n¼ cup panko bread crumbs\n1 egg\n1 tbsp chili-garlic sauce\n2 tsp toasted sesame oil\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 631381,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 631382,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 631383,
      "primary_message": "Meanwhile, place water, additional chili-garlic sauce, vinegar, sugar, soy sauce, oil, and cornstarch in a small saucepan. Whisk to combine the sweet 'n' sour sauce.",
      "secondary_message": "¼ cup water\n1 tbsp chili-garlic sauce\n1 tbsp apple cider vinegar\n1 tbsp brown sugar\n2 tsp soy sauce\n2 tsp toasted sesame oil\n1 tsp cornstarch"
    },
    {
      "id": 631384,
      "primary_message": "Set pan over medium-high heat and bring sauce to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 631385,
      "primary_message": "While the sauce is cooking, wash, dry, trim, and cut bok choy in half lengthwise.",
      "secondary_message": "4 baby bok choy"
    },
    {
      "id": 631386,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add bok choy, cut-side down, then drizzle with soy sauce; cover and cook, flipping once, until tender and charred, 3-5 minutes. Remove from heat.",
      "secondary_message": "2 tsp toasted sesame oil\n2 tbsp soy sauce"
    },
    {
      "id": 631387,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 631388,
      "primary_message": "To serve, divide fritters, sauce, and bok choy between plates. Top bok choy with peanuts and sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
