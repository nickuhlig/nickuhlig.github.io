  "instructions": [
    {
      "id": 631419,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 631420,
      "primary_message": "Add veggie ground, bread crumbs, eggs, chili-garlic sauce, oil, and spices to the bowl with the green onion. Using your hands, mix well to combine. Use a ¼-cup measure to form the veggie ground mixture into ½-inch thick fritters and place on a plate.",
      "secondary_message": "454 g veggie ground, plant based\n½ cup panko bread crumbs\n2 eggs\n2 tbsp chili-garlic sauce\n4 tsp toasted sesame oil\n½ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 631421,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 631422,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add fritters and pan-fry until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate. (Reserve skillet for later use.)",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 631423,
      "primary_message": "Meanwhile, place water, additional chili-garlic sauce, vinegar, sugar, soy sauce, oil, and cornstarch in a small saucepan. Whisk to combine the sweet 'n' sour sauce.",
      "secondary_message": "½ cup water\n2 tbsp chili-garlic sauce\n2 tbsp apple cider vinegar\n2 tbsp brown sugar\n4 tsp soy sauce\n4 tsp toasted sesame oil\n2 tsp cornstarch"
    },
    {
      "id": 631424,
      "primary_message": "Set pan over medium-high heat and bring sauce to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 631425,
      "primary_message": "While the sauce is cooking, wash, dry, trim, and cut bok choy in half lengthwise.",
      "secondary_message": "8 baby bok choy"
    },
    {
      "id": 631426,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Working in batches if necessary, add bok choy, cut-side down, then drizzle with soy sauce; cover and cook, flipping once, until tender and charred, 3-5 minutes. Remove from heat.",
      "secondary_message": "4 tsp toasted sesame oil\n¼ cup soy sauce"
    },
    {
      "id": 631427,
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 631428,
      "primary_message": "To serve, divide fritters, sauce, and bok choy between plates. Top bok choy with peanuts and sesame seeds. Enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
