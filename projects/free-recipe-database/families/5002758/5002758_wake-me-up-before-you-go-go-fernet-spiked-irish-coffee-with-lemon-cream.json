  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine hot coffee, fernet, and simple syrup in a prewarmed mug. (You can prewarm it by pouring hot water into it, letting it stand for 1 minute, then draining.) Using a spoon, dollop chantilly on top of coffee and top with lemon zest, if using. Serve right away. (You may have more whipped cream than the mug can accommodate; feel free to add more as you drink, or use some for the next round.)",
      "secondary_message": null
    }
