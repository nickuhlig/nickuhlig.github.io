  "instructions": [
    {
      "id": 485411,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 485412,
      "primary_message": "Wash, dry, and trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons. Divide between two baking sheet pans, drizzle with oil, and season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "9 medium zucchini squash\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 485413,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 485414,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half in a large bowl (reserve remaining parsley for serving). ",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 485415,
      "primary_message": "Add turkey, bread crumbs, eggs, and spices to the bowl with the parsley; use your hands to combine. Using a tablespoon measure, form the mixture into rounded meatballs and place on a plate.",
      "secondary_message": "1.02 kg ground turkey\n1 ½ cup panko bread crumbs\n3 eggs\n1 ½ tsp salt\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp oregano, dried\n½ tsp nutmeg, ground\n½ tsp cloves, ground\n½ tsp black pepper"
    },
    {
      "id": 485416,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485417,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Transfer meatballs to a large baking dish. (Reserve skillet with drippings for next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 485418,
      "primary_message": "Return skillet (with drippings) to medium heat. Add broth, cream, Worcestershire, Dijon, and salt. Whisk to combine the sauce and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until sauce has thickened, 5-6 minutes.",
      "secondary_message": "355 ml chicken or vegetable broth\n355 ml heavy whipping cream\n1 tbsp Worcestershire sauce\n1 ½ tsp Dijon mustard\n1 ½ tsp salt"
    },
    {
      "id": 485419,
      "primary_message": "Transfer sauce to the baking dish with the meatballs. Gently stir to cover meatballs with sauce.",
      "secondary_message": null
    },
    {
      "id": 485420,
      "primary_message": "Place baking dish in the oven and bake until meatballs are cooked through, 7-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 485421,
      "primary_message": "To serve, divide zucchini noodles, meatballs, and sauce between plates. Top with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
