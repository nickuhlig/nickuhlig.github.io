  "instructions": [
    {
      "id": 485422,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 485423,
      "primary_message": "Wash, dry, and trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons. Transfer to a baking sheet pan, drizzle with oil, and season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "3 medium zucchini squash\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 485424,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and bake, tossing halfway through, until zucchini is tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 485425,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl (reserve remaining parsley for serving). ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 485426,
      "primary_message": "Add veggie ground, bread crumbs, egg, and spices to the bowl with the parsley; use your hands to combine. Using a tablespoon measure, form the mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": "227 g veggie ground, plant based\n½ cup panko bread crumbs\n1 egg\n¼ tsp salt\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp oregano, dried\n⅛ tsp nutmeg, ground\n⅛ tsp cloves, ground\n⅛ tsp black pepper"
    },
    {
      "id": 485427,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485428,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until browned on all sides, 3-4 minutes (the meatballs will not be cooked all the way through). Transfer meatballs to a clean plate. (Reserve skillet with drippings for next step.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 485429,
      "primary_message": "Return skillet (with drippings) to medium heat. Add broth, cream, soy sauce, Dijon, and salt. Whisk to combine the sauce and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until sauce has thickened, 4-5 minutes.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n118 ml (½ cup) heavy whipping cream\n1 tsp soy sauce\n½ tsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 485430,
      "primary_message": "Return meatballs to the skillet along with any juices from the plate. Gently stir to cover with sauce. ",
      "secondary_message": null
    },
    {
      "id": 485431,
      "primary_message": "Place skillet in the oven and bake until meatballs are cooked through, 5-7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 485432,
      "primary_message": "To serve, divide zucchini noodles, meatballs, and sauce between plates. Top with remaining parsley and enjoy!",
      "secondary_message": null
    }
  ],
