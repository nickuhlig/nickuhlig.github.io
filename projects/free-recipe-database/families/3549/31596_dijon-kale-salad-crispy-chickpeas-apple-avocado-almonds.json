  "instructions": [
    {
      "id": 498694,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 498695,
      "primary_message": "Drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n3 tbsp extra virgin olive oil\n1 ½ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 498696,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 18-20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 498697,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 ½ lemons\n3 bunches kale\n3 Gala apples\n1 ½ avocados"
    },
    {
      "id": 498698,
      "primary_message": "Juice lemons into a large bowl. Add mayo, Dijon, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "¼ cup vegan mayonnaise\n2 tbsp Dijon mustard\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 498699,
      "primary_message": "Peel and mince shallot. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 498700,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 498701,
      "primary_message": "Quarter, core, and slice apples into thin wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 498702,
      "primary_message": "Add almonds to the bowl and toss to combine the salad.",
      "secondary_message": "1 cup almonds, sliced"
    },
    {
      "id": 498703,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 498704,
      "primary_message": "To serve, divide salad between plates or bowls; top with crispy chickpeas and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
