  "instructions": [
    {
      "id": 498749,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 498750,
      "primary_message": "Drain and rinse chickpeas. Transfer to a large baking sheet pan and pat dry with paper towels. Drizzle with oil and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 498751,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring chickpeas halfway through, until crispy and golden, 15-18 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 498752,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 lemon\n2 bunches kale\n2 Gala apples\n1 avocado"
    },
    {
      "id": 498753,
      "primary_message": "Juice lemon into a large bowl. Add mayo, Dijon, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp vegan mayonnaise\n4 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 498754,
      "primary_message": "Peel and mince shallot. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 498755,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 498756,
      "primary_message": "Quarter, core, and slice apples into thin wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 498757,
      "primary_message": "Add almonds to the bowl and toss to combine the salad.",
      "secondary_message": "⅔ cup almonds, sliced"
    },
    {
      "id": 498758,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 498759,
      "primary_message": "To serve, divide salad between plates or bowls; top with crispy chickpeas and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
