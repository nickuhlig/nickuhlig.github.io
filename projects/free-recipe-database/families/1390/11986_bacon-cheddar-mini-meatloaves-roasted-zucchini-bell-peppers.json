  "instructions": [
    {
      "id": 202445,
      "primary_message": "Preheat oven to 425°F. Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 202446,
      "primary_message": "Preheat a skillet over medium-high heat. Place bacon in the skillet and cook until crispy, about 3 minutes per side.",
      "secondary_message": "2 slices bacon"
    },
    {
      "id": 202447,
      "primary_message": "Meanwhile, place beef, ketchup, and spices in a medium bowl; mix with your hands until well combined.",
      "secondary_message": "¾ lb lean ground beef\n1 tbsp ketchup\n½ tsp onion powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 202448,
      "primary_message": "Using a ¼ cup measure, divide meatloaf mixture between 6 muffin cups and top with additional ketchup. Place in the oven (it doesn't have to be fully heated) and bake until almost cooked through, about 15 minutes.",
      "secondary_message": "1 tbsp ketchup"
    },
    {
      "id": 202449,
      "primary_message": "Once the bacon is done, remove to a paper towel-lined plate, reserving drippings in the skillet.",
      "secondary_message": null
    },
    {
      "id": 202450,
      "primary_message": "Wash, dry, trim, and thinly slice zucchini into rounds; place on a baking sheet pan.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 202451,
      "primary_message": "Wash, dry, seed, and slice bell pepper into thin strips. Add to the baking sheet with the zucchini.",
      "secondary_message": "½ orange bell pepper"
    },
    {
      "id": 202452,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies. Drizzle reserved bacon fat over the veggies and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "1 clove garlic\n½ tsp Italian seasoning\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 202453,
      "primary_message": "Place veggies in the oven and bake, tossing halfway through, until fork-tender, about 15 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 202454,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 202455,
      "primary_message": "When the meatloaves are almost cooked through, carefully remove from the oven and sprinkle with cheese.",
      "secondary_message": null
    },
    {
      "id": 202456,
      "primary_message": "Return meatloaves to the oven and cook until cheese is melted and loaves are cooked through, 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 202457,
      "primary_message": "Crumble or chop bacon into small pieces. ",
      "secondary_message": null
    },
    {
      "id": 202458,
      "primary_message": "To serve, divide meatloaves and roasted veggies between plates. Top meatloaves with bacon and enjoy!",
      "secondary_message": null
    }
  ],
