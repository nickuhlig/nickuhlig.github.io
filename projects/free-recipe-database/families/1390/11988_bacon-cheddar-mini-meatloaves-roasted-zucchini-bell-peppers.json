  "instructions": [
    {
      "id": 202473,
      "primary_message": "Preheat oven to 425°F. Position racks in the upper, middle, and lower part of the oven.",
      "secondary_message": null
    },
    {
      "id": 202474,
      "primary_message": "Preheat a large skillet over medium-high heat. Working in batches if necessary, place bacon in the skillet and cook until crispy, about 3 minutes per side.",
      "secondary_message": "6 slices bacon"
    },
    {
      "id": 202475,
      "primary_message": "Meanwhile, place beef, ketchup, and spices in a large bowl; mix with your hands until well combined.",
      "secondary_message": "2 ¼ lb lean ground beef\n3 tbsp ketchup\n1 ½ tsp onion powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 202476,
      "primary_message": "Using a ¼ cup measure, divide meatloaf mixture between 18 muffin cups and top with additional ketchup. Place in the oven (it doesn't have to be fully heated) and bake until almost cooked through, about 18 minutes.",
      "secondary_message": "3 tbsp ketchup"
    },
    {
      "id": 202477,
      "primary_message": "Once the bacon is done, remove to a paper towel-lined plate, reserving drippings in the skillet.",
      "secondary_message": null
    },
    {
      "id": 202478,
      "primary_message": "Wash, dry, trim, and thinly slice zucchini into rounds; place on a large baking sheet pan.",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 202479,
      "primary_message": "Wash, dry, seed, and slice bell peppers into thin strips. Add to the baking sheet with the zucchini.",
      "secondary_message": "2 orange bell peppers"
    },
    {
      "id": 202480,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies. Drizzle reserved bacon fat over the veggies and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "3 cloves garlic\n1 ½ tsp Italian seasoning\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 202481,
      "primary_message": "Place veggies in the oven and bake, tossing halfway through, until fork-tender, 15-18 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 202482,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 202483,
      "primary_message": "When the meatloaves are almost cooked through, carefully remove from the oven and sprinkle with cheese.",
      "secondary_message": null
    },
    {
      "id": 202484,
      "primary_message": "Return meatloaves to the oven and cook until cheese is melted and loaves are cooked through, 5-7 minutes more.",
      "secondary_message": null
    },
    {
      "id": 202485,
      "primary_message": "Crumble or chop bacon into small pieces. ",
      "secondary_message": null
    },
    {
      "id": 202486,
      "primary_message": "To serve, divide meatloaves and roasted veggies between plates. Top meatloaves with bacon and enjoy!",
      "secondary_message": null
    }
  ],
