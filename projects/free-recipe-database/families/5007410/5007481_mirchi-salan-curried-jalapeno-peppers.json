  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat 2 tablespoons oil over medium heat in a heavy bottomed lidded saucepan until shimmering. Slide in the peppers and fry until skin is lightly charred, about 5 minutes. Transfer to a paper towel-lined plate. Do not wipe out saucepan.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine cumin, mustard, fenugreek, peanuts, sesame seeds, chile powder, turmeric, garlic, ginger, tamarind, and coconut flesh in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Return pan to medium heat and add remaining oil. Heat until shimmering. Add the curry leaves and stir as they splutter, immediately add the onions and cook, stirring frequently, until translucent, about 5 minutes. Add spice paste and cook, stirring frequently until fragrant and oil separates from the spice paste, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add water, salt and sugar to the mix. Stir and close the lid. Reduce to a simmer and cook for 10 minutes. Add the peppers and allow to cook without the lid for another 5 minutes until the flavor of the gravy infuses into the peppers. Serve hot with any Indian meal.",
      "secondary_message": null
    }
  ],
