  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a large pot of salted water to boil and add the broccoli florets. Cook until tender, then remove with a slotted spoon. Add the pasta and cook until al dente, reserving 1/2 cup cooking water before draining.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large, heavy skillet, heat olive oil over medium heat until shimmering. Add garlic and red chile flakes and cook until fragrant, about 1 minute, then add broccoli and toss well in the oil, cooking until completely tender, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add pasta to the pan with the broccoli and toss well to coat. Add half the Parmesan and reserved pasta cooking water little by little until it creates a sauce that clings to the noodles. Season to taste with salt and pepper. Serve immediately with remaining Parmesan.",
      "secondary_message": null
    }
  ],
