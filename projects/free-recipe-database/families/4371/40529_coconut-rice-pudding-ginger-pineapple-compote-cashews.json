  "instructions": [
    {
      "id": 626975,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add coconut milk, water, sugar, vanilla, salt, and cinnamon. Set over medium heat and bring to a simmer, stirring frequently.",
      "secondary_message": "1 ½ cups jasmine rice\n1 ½ (398 ml) cans coconut milk\n266 ml water\n⅓ cup brown sugar\n1 tbsp vanilla extract\n½ tsp salt\n¼ tsp cinnamon, ground"
    },
    {
      "id": 626976,
      "primary_message": "Once the liquid comes to a simmer, cover the saucepan, and reduce heat to low. Cook rice, undisturbed, until liquid is fully absorbed, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 626977,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pineapples\n1 ½ lemons\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 626978,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and medium dice the flesh. Place in a large pot.",
      "secondary_message": null
    },
    {
      "id": 626979,
      "primary_message": "Zest and juice lemons into the pot with the pineapple.",
      "secondary_message": null
    },
    {
      "id": 626980,
      "primary_message": "Peel and mince ginger. Add to the pot, along with sugar and water, then stir to combine. Cook over medium heat, stirring occasionally, until pineapple is soft and juicy, 5-6 minutes.",
      "secondary_message": "¼ cup brown sugar\n44 ml water"
    },
    {
      "id": 626981,
      "primary_message": "Once the pineapple is soft, crush with a fork or potato masher; continue to cook, stirring occasionally, until compote thickens, 4-5 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 626982,
      "primary_message": "When the rice is done, remove from heat. Add milk to the pan, stir to combine, and let it stand, still covered, for 5 minutes.",
      "secondary_message": "355 ml whole milk"
    },
    {
      "id": 626983,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 626984,
      "primary_message": "To serve, divide rice pudding between bowls, then top with pineapple compote and cashews. Enjoy!",
      "secondary_message": null
    }
  ],
