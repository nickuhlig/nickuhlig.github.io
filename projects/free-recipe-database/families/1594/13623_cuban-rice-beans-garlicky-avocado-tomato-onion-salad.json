  "instructions": [
    {
      "id": 226891,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ green bell peppers\n3 limes\n1 ½ oranges\n6 tomatoes\n3 avocados\n1 small bunch cilantro"
    },
    {
      "id": 226892,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 226893,
      "primary_message": "Trim, seed and small dice bell peppers. Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 226894,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 226895,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, garlic, rice, and spices; cook, stirring constantly, until bell pepper is soft and rice is golden and toasted (you should hear a slight sizzle and pop from the rice), about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ cups basmati rice\n¾ tsp cumin, ground\n¾ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 226896,
      "primary_message": "Add beans, broth, and water to the pot, then bring to a boil over high heat. Once the liquid comes to a boil, stir, cover, and reduce the heat to low. Cook the rice until liquid is fully absorbed, about 20 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n⅓ cup water"
    },
    {
      "id": 226897,
      "primary_message": "Meanwhile, juice the citrus into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 226898,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the citrus juice along with oil and spices; whisk to combine the dressing.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 226899,
      "primary_message": "Peel, halve, and thinly slice onions. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 226900,
      "primary_message": "Cut tomatoes into wedges and add to the bowl with the onions.",
      "secondary_message": null
    },
    {
      "id": 226901,
      "primary_message": "Halve and pit the avocados. Scoop halves out with a spoon and cut into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 226902,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 226903,
      "primary_message": "To serve, divide rice and beans between plates; use a slotted spoon to portion salad, then drizzle leftover dressing over the rice and beans. Enjoy!",
      "secondary_message": null
    }
  ],
