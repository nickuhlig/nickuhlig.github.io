  "instructions": [
    {
      "id": 226841,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n1 orange\n4 tomatoes\n2 avocados\n1 small bunch cilantro"
    },
    {
      "id": 226842,
      "primary_message": "Juice the citrus into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 226843,
      "primary_message": "Peel and mince garlic. Add to the bowl with the citrus juice along with oil and spices; whisk to combine the dressing.",
      "secondary_message": "4 cloves garlic\n2 tbsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 226844,
      "primary_message": "Peel, halve, and thinly slice onion. Add to the bowl with the dressing and toss to coat; set aside to marinate.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 226845,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 226846,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp cumin, ground\n½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 226847,
      "primary_message": "Once the skillet is hot add oil and swirl to coat the bottom. Add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 226848,
      "primary_message": "While the steak is cooking, cut tomatoes into wedges and add to the bowl with the onions.",
      "secondary_message": null
    },
    {
      "id": 226849,
      "primary_message": "Halve and pit the avocados. Scoop halves out with a spoon and cut into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 226850,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 226851,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 226852,
      "primary_message": "To serve, divide steak between plates; use a slotted spoon to portion salad, then drizzle steak with leftover dressing. Enjoy!",
      "secondary_message": null
    }
  ],
