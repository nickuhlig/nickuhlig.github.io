  "instructions": [
    {
      "id": 226790,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ green bell pepper\n1 lime\n½ orange\n2 tomatoes\n1 avocado\n½ small bunch cilantro"
    },
    {
      "id": 226791,
      "primary_message": "Drain and rinse the beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 226792,
      "primary_message": "Trim, seed and small dice bell pepper. Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 226793,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 226794,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add bell pepper, garlic, rice, and spices; cook, stirring constantly, until bell pepper is soft and rice is golden and toasted (you should hear a slight sizzle and pop from the rice), about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ cup basmati rice\n¼ tsp cumin, ground\n¼ tsp oregano, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 226795,
      "primary_message": "Add beans, broth, and water to the saucepan, then bring to a boil over high heat. Once the liquid comes to a boil, stir, cover, and reduce the heat to low. Cook the rice until liquid is fully absorbed, 18-20 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n2 tbsp water"
    },
    {
      "id": 226796,
      "primary_message": "Meanwhile, juice the citrus into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 226797,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the citrus juice along with oil and spices; whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil\n¼ tsp cumin, ground\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 226798,
      "primary_message": "Peel, halve, and thinly slice onion. Add to the bowl with the dressing and toss to coat.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 226799,
      "primary_message": "Cut tomatoes into wedges and add to the bowl with the onions.",
      "secondary_message": null
    },
    {
      "id": 226800,
      "primary_message": "Halve and pit the avocado. Scoop halves out with a spoon and cut into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 226801,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 226802,
      "primary_message": "To serve, divide rice and beans between plates; use a slotted spoon to portion salad, then drizzle leftover dressing over the rice and beans. Enjoy!",
      "secondary_message": null
    }
  ],
