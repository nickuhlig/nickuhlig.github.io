  "instructions": [
    {
      "id": 226778,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ oranges\n6 tomatoes\n3 avocados\n1 small bunch cilantro"
    },
    {
      "id": 226779,
      "primary_message": "Juice the citrus into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 226780,
      "primary_message": "Peel and mince garlic. Add to the bowl with the citrus juice along with oil and spices; whisk to combine the dressing.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 226781,
      "primary_message": "Peel, halve, and thinly slice onions. Add to the bowl with the dressing and toss to coat; set aside to marinate.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 226782,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 226783,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp cumin, ground\n¾ tsp oregano, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 226784,
      "primary_message": "Once the skillet is hot add oil and swirl to coat the bottom. Working in batches if necessary, add steak to the skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 226785,
      "primary_message": "While the steak is cooking, cut tomatoes into wedges and add to the bowl with the onions.",
      "secondary_message": null
    },
    {
      "id": 226786,
      "primary_message": "Halve and pit the avocados. Scoop halves out with a spoon and cut into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 226787,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 226788,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 226789,
      "primary_message": "To serve, divide steak between plates; use a slotted spoon to portion salad, then drizzle steak with leftover dressing. Enjoy!",
      "secondary_message": null
    }
  ],
