  "instructions": [
    {
      "id": 38063,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 Granny Smith apples\n2 medium carrots\n2 medium beets\n1 small bunch green onions (scallions)\n1 lemon"
    },
    {
      "id": 38064,
      "primary_message": "Quarter the apples, then cut out the core and stem from each section; using a box grater, coarsely grate the sections and transfer to a large salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 38065,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Coarsely grate the carrots and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 38066,
      "primary_message": "Trim off and discard the ends of the beets; peel and coarsely grate the beets. (To avoid staining, line your cutting board with paper towels before handling the beets.) Add the beets to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 38067,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle and transfer to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 38068,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 38069,
      "primary_message": "While the skillet heats up, pat the salmon dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg salmon fillet\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 38070,
      "primary_message": "When the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 38071,
      "primary_message": "Place the salmon, skin-side down, in the skillet; cook the salmon until it is cooked through and flaky, 3 to 5 minutes per side. Once done, remove the skillet from the heat.",
      "secondary_message": null
    },
    {
      "id": 38072,
      "primary_message": "While the salmon cooks, roughly chop the walnuts and add to the salad bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 38073,
      "primary_message": "Juice the lemon and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 38074,
      "primary_message": "Add olive oil, honey, salt, and pepper to the salad bowl; mix the ingredients until well combined.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp honey\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 38075,
      "primary_message": "To serve, spoon the carrot, beet and apple slaw onto a plate and place the salmon over top. Enjoy!",
      "secondary_message": null
    }
  ],
