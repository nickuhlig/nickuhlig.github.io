  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a large pot of salted water to a boil. Toss in the broccolini and cook until bright green. About 5 minutes. Drain in a colander when done.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat the oil in a medium hot pan. When ready, toss in the garlic and red pepper flakes. Cook for one minute and then add the broccolini to the pan. Cook for about 2 minutes, season with salt and pepper, and then serve up.",
