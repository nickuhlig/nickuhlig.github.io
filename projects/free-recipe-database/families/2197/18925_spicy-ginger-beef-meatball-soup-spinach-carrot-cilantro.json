  "instructions": [
    {
      "id": 311367,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 medium carrots\n3 (5 oz) pkgs baby spinach\n1 small bunch cilantro"
    },
    {
      "id": 311368,
      "primary_message": "Peel and mince ginger and garlic; place both in a large bowl. Add beef, eggs, bread crumbs, chili-garlic sauce, salt, and pepper; using your hands, mix well to combine.",
      "secondary_message": "3 cloves garlic\n2 ¼ lb lean ground beef\n3 eggs\n¾ cup panko bread crumbs\n2 tbsp chili-garlic sauce\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 311369,
      "primary_message": "Using a scant ¼-cup measure, form the beef mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 311370,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 311371,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning often, until just browned on all sides, 4-5 minutes (the meatballs will not be cooked all the way through). Once done, transfer to a clean plate. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 311372,
      "primary_message": "Meanwhile, peel, halve, and slice onions into thin half-moons; peel and mince additional garlic. Place both in a clean large bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 311373,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 311374,
      "primary_message": "Return pot to medium heat. Add onion, garlic, and carrot; cook, stirring occasionally, until fragrant, about 3 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 311375,
      "primary_message": "Add meatballs (and any accumulated juices), broth, soy sauce, and vinegar to the pot; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until meatballs are cooked through, about 5 minutes. ",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n3 tbsp soy sauce\n3 tbsp rice vinegar"
    },
    {
      "id": 311376,
      "primary_message": "Meanwhile, roughly chop spinach; place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 311377,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach. ",
      "secondary_message": null
    },
    {
      "id": 311378,
      "primary_message": "When the meatballs are done, add spinach and cilantro to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 311379,
      "primary_message": "To serve, divide soup between bowls; drizzle with additional oil and chili-garlic sauce. Enjoy!",
      "secondary_message": "1 tbsp toasted sesame oil\n1 tbsp chili-garlic sauce"
    }
  ],
