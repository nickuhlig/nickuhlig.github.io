  "instructions": [
    {
      "id": 311341,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 medium carrot\n1 (5 oz) pkg baby spinach\n½ small bunch cilantro"
    },
    {
      "id": 311342,
      "primary_message": "Peel and mince ginger and garlic; place both in a medium bowl. Add beef, egg, bread crumbs, chili-garlic sauce, salt, and pepper; using your hands, mix well to combine.",
      "secondary_message": "1 clove garlic\n¾ lb lean ground beef\n1 egg\n¼ cup panko bread crumbs\n2 tsp chili-garlic sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 311343,
      "primary_message": "Using a scant ¼-cup measure, form the beef mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 311344,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 311345,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until just browned on all sides, 4-5 minutes (the meatballs will not be cooked all the way through). Once done, transfer to a clean plate. (Reserve pan for later use.)",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 311346,
      "primary_message": "Meanwhile, peel, halve, and slice onion into thin half-moons; peel and mince additional garlic. Place both in a clean medium bowl. ",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 311347,
      "primary_message": "Peel, trim, and slice carrot crosswise into thin rounds; add to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 311348,
      "primary_message": "Return saucepan to medium heat. Add onion, garlic, and carrot; cook, stirring occasionally, until fragrant, about 2 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 311349,
      "primary_message": "Add meatballs (and any accumulated juices), broth, soy sauce, and vinegar to the pan; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until meatballs are cooked through, about 5 minutes. ",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n1 tbsp soy sauce\n1 tbsp rice vinegar"
    },
    {
      "id": 311350,
      "primary_message": "Meanwhile, roughly chop spinach; place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 311351,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach. ",
      "secondary_message": null
    },
    {
      "id": 311352,
      "primary_message": "When the meatballs are done, add spinach and cilantro to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 311353,
      "primary_message": "To serve, divide soup between bowls; drizzle with additional oil and chili-garlic sauce. Enjoy!",
      "secondary_message": "1 tsp toasted sesame oil\n1 tsp chili-garlic sauce"
    }
  ],
