  "instructions": [
    {
      "id": 311549,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 medium carrots\n2 (142 g) pkg baby spinach\n1 small bunch cilantro"
    },
    {
      "id": 311550,
      "primary_message": "Peel and mince ginger and garlic; place both in a medium bowl. Add veggie ground, eggs, bread crumbs, chili-garlic sauce, salt, and pepper; using your hands, mix well to combine.",
      "secondary_message": "2 cloves garlic\n454 g veggie ground, plant based\n2 eggs\n½ cup panko bread crumbs\n4 tsp chili-garlic sauce\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 311551,
      "primary_message": "Using a scant ¼-cup measure, form the veggie ground mixture into rounded \"meatballs\" and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 311552,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 311553,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning often, until browned on all sides, 4-5 minutes (the meatballs will not be cooked all the way through). Once done, transfer to a clean plate. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 311554,
      "primary_message": "Meanwhile, peel, halve, and slice onion into thin half-moons; peel and mince additional garlic. Place both in a clean medium bowl. ",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 311555,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 311556,
      "primary_message": "Return pot to medium heat, add more oil, and swirl to coat the bottom. Add onion, garlic, and carrot to the pot; cook, stirring occasionally, until fragrant, about 2 minutes. (Reserve bowl for later use.)",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 311557,
      "primary_message": "Add meatballs, broth, soy sauce, and vinegar to the pot; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until meatballs are cooked through, about 5 minutes. ",
      "secondary_message": "1893 ml chicken or vegetable broth\n2 tbsp soy sauce\n2 tbsp rice vinegar"
    },
    {
      "id": 311558,
      "primary_message": "Meanwhile, roughly chop spinach; place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 311559,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the spinach. ",
      "secondary_message": null
    },
    {
      "id": 311560,
      "primary_message": "When the meatballs are done, add spinach and cilantro to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 311561,
      "primary_message": "To serve, divide soup between bowls; drizzle with additional oil and chili-garlic sauce. Enjoy!",
      "secondary_message": "2 tsp toasted sesame oil\n2 tsp chili-garlic sauce"
    }
  ],
