  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring a pot of water to boil. Gently add the block of silken tofu to the water and simmer until the tofu is warmed through, 3 to 5 minutes. Drain the tofu.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Scooping up rough slabs of the block with a spoon, divide the tofu evenly between 2 bowls, or among 4 if you are serving as an appetizer. Drizzle each portion of tofu with 1 teaspoon soy sauce, 1/2 teaspoon chili oil, and 1/4 teaspoon sesame oil. Top with minced zha cai, scallions, and cilantro. Serve immediately.",
      "secondary_message": null
    }
  ],
