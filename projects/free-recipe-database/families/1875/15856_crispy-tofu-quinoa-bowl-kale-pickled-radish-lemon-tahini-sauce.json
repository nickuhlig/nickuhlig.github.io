  "instructions": [
    {
      "id": 260253,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 260254,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 260255,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 260256,
      "primary_message": "Meanwhile, large dice tofu and place in a large bowl; drizzle with oil and soy sauce. Gently toss to coat, then sprinkle with cornstarch. Toss once more, until no dry spots remain. (Wipe the baking sheet dry with paper towels and reserve for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp soy sauce\n3 tbsp cornstarch"
    },
    {
      "id": 260257,
      "primary_message": "Line the baking sheet with parchment paper; add tofu and spread out in an even layer. Place in the oven and bake, tossing halfway through, until the tofu is crispy and golden, about 18 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 260258,
      "primary_message": "While the tofu bakes, wash and dry the fresh produce.",
      "secondary_message": "1 ½ bunches radish\n1 ½ lemons\n3 medium carrots\n1 ½ bunches kale"
    },
    {
      "id": 260259,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; whisk to combine the pickling liquid.",
      "secondary_message": "2 tbsp apple cider vinegar\n1 ½ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 260260,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the pickling liquid, toss to combine, and set aside to marinate.",
      "secondary_message": null
    },
    {
      "id": 260261,
      "primary_message": "Peel and mince garlic; place in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 260262,
      "primary_message": "Zest and juice lemons into the bowl with the garlic; add tahini, water, oil, and salt. Whisk to combine the sauce and set aside.",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n1 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 260263,
      "primary_message": "Peel, trim, and coarsely grate carrots; transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 260264,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the plate with the carrot.",
      "secondary_message": null
    },
    {
      "id": 260265,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 260266,
      "primary_message": "To serve, divide quinoa between bowls; top with tofu, carrots, kale, pickled radish, and pistachios. Drizzle with tahini-lemon sauce and enjoy!",
      "secondary_message": null
    }
  ],
