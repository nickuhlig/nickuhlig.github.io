  "instructions": [
    {
      "id": 260211,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 260212,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ bunches radish\n1 ½ lemons\n3 medium carrots\n1 ½ bunches kale"
    },
    {
      "id": 260213,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl; whisk to combine the pickling liquid.",
      "secondary_message": "2 tbsp apple cider vinegar\n1 ½ tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 260214,
      "primary_message": "Trim and thinly slice radishes; add to the bowl with the pickling liquid, toss to combine, and set aside to marinate.",
      "secondary_message": null
    },
    {
      "id": 260215,
      "primary_message": "Peel and mince garlic; place in a small bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 260216,
      "primary_message": "Zest and juice lemons into the bowl with the garlic; add tahini, water, oil, and salt. Whisk to combine the sauce and set aside.",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n1 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 260217,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 260218,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 260219,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the skillet and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 260220,
      "primary_message": "Meanwhile, using a clean cutting board, peel, trim, and coarsely grate carrots; transfer to a large plate.",
      "secondary_message": null
    },
    {
      "id": 260221,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and add to the plate with the carrot.",
      "secondary_message": null
    },
    {
      "id": 260222,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 260223,
      "primary_message": "Slice chicken into thin strips.",
      "secondary_message": null
    },
    {
      "id": 260224,
      "primary_message": "To serve, divide quinoa between bowls; top with chicken, carrots, kale, pickled radish, and pistachios. Drizzle with lemon-tahini sauce and enjoy!",
      "secondary_message": null
    }
  ],
