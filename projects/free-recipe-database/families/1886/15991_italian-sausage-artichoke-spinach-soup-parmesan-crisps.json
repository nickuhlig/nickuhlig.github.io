  "instructions": [
    {
      "id": 329237,
      "primary_message": "Preheat oven to 205°C (400°F). Line two baking sheet pans with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 329238,
      "primary_message": "Quarter artichokes, place in a small bowl, and set aside.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 329239,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329240,
      "primary_message": "While the pot heats up, use the tip of a knife to slice down the length of each sausage; peel off casings and discard. ",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 329241,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add sausage and cook, breaking the meat apart with a spoon, until brown and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 329242,
      "primary_message": "Meanwhile, finely grate Parmesan. To make the crisps, measure out 1 tbsp of grated Parmesan and place in a pile on the baking sheets. Repeat with remaining Parmesan, keeping the piles a few inches apart.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 329243,
      "primary_message": "Place baking sheets in the oven and bake until Parmesan is lightly browned and crisp, 6-8 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 329244,
      "primary_message": "When the sausage is done, add artichokes, broth, tomatoes, and spices to the pot. Stir to combine and bring to a boil.",
      "secondary_message": "1420 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 329245,
      "primary_message": "Once the soup is boiling, reduce heat, and simmer for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 329246,
      "primary_message": "While the soup is simmering, wash and dry the spinach (skip this step if the spinach came pre-washed), then roughly chop.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 329247,
      "primary_message": "Add spinach to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 329248,
      "primary_message": "Divide soup between bowls and serve with Parmesan crisps on the side. Enjoy!",
      "secondary_message": null
    }
  ],
