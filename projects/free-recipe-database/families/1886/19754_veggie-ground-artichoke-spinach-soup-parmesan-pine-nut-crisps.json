  "instructions": [
    {
      "id": 329249,
      "primary_message": "Preheat oven to 205°C (400°F). Line a baking sheet pan with parchment paper and set aside.",
      "secondary_message": null
    },
    {
      "id": 329250,
      "primary_message": "Quarter artichokes, place in a small bowl, and set aside.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 329251,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329252,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until brown and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g veggie ground, plant based"
    },
    {
      "id": 329253,
      "primary_message": "Meanwhile, finely grate Parmesan. To make the crisps, measure out 1 tbsp of grated Parmesan and place in a pile on the baking sheet. Repeat with remaining Parmesan, keeping the piles a few inches apart.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 329254,
      "primary_message": "Sprinkle pine nuts over each pile of Parmesan.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 329255,
      "primary_message": "Place baking sheet in the oven and bake until Parmesan is lightly browned and crisp, 5-7 minutes. (Watch carefully because they can burn quickly.) Once done, remove from the oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 329256,
      "primary_message": "When the veggie ground is done, add artichokes, broth, tomatoes, and spices to the pan; stir to combine and bring to a boil.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 329257,
      "primary_message": "Once the soup is boiling, reduce heat, and simmer for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 329258,
      "primary_message": "While the soup is simmering, wash and dry the spinach (skip this step if the spinach came pre-washed), then roughly chop.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 329259,
      "primary_message": "Add spinach to the soup in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 329260,
      "primary_message": "Divide soup between bowls and serve with Parmesan crisps on the side. Enjoy!",
      "secondary_message": null
    }
  ],
