  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Coat a large (9 x 13-inch) baking dish with butter.  ",
      "secondary_message": "butter, unsalted"
    },
    {
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, coarsely grate cheeses. Place in a medium bowl, along with spices, and set aside.  ",
      "secondary_message": "1 (227 g) block cheddar cheese\n1 (227 g) block mozzarella cheese\n1 tbsp salt\n1 ½ tsp paprika\n1 tsp garlic powder\n½ tsp black pepper"
    },
    {
      "primary_message": "Once the water in the pot is boiling, uncover, and add pasta and salt; stir for a few seconds. Cook until pasta reaches desired firmness, 8-10 minutes. When the pasta is done, drain in a colander, and return to the pot.  ",
      "secondary_message": "454 g macaroni (elbow) pasta\n1 tbsp salt"
    },
    {
      "primary_message": "Meanwhile, preheat a medium saucepan over medium-high heat.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add flour and cook, whisking frequently, for 1 minute. ",
      "secondary_message": "⅓ cup butter, unsalted\n⅓ cup all-purpose flour"
    },
    {
      "primary_message": "Slowly pour milk into the pot, whisking constantly. Continue to cook, whisking frequently, until sauce thickens, about 5 minutes. ",
      "secondary_message": "946 ml whole milk"
    },
    {
      "primary_message": "Add cheese and spices to the pot in handfuls, waiting for the cheese to melt before adding the next handful. Whisk until cheese melts and sauce is smooth, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer cheese sauce to the pot with the pasta. Using a silicone spatula, stir to combine the mac & cheese.   ",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer mac & cheese to the baking dish; evenly scatter bread crumbs on top.  ",
      "secondary_message": "1 cup panko bread crumbs"
    },
    {
      "primary_message": "Place baking dish in the oven and bake until sauce is bubbling at the edges, about 20 minutes. Remove from oven and let stand 5-10 minutes.  ",
      "secondary_message": null
    }
  ],
