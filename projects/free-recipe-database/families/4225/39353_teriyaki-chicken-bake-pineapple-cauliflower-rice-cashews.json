  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ small pineapples\n3 green bell peppers\n1 ½ medium heads cauliflower"
    },
    {
      "primary_message": "Peel and mince ginger. Place in a large bowl along with water, soy sauce, honey, cornstarch, oil, and spices. Whisk to combine the teriyaki marinade. ",
      "secondary_message": "3 tbsp honey\n3 tbsp cornstarch\ntoasted sesame oil\n1 ½ tsp garlic powder\nsalt\nblack pepper"
    },
    {
      "primary_message": "Cut off skin from each pineapple; quarter, core, and medium dice the flesh. Add to the bowl with the marinade.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, halve, and medium dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "primary_message": "Pat chicken dry with paper towels, then medium dice. Add to the bowl and stir to combine. Divide pineapple, veggies, and chicken between two large baking sheet pans, then spread out in an even layer.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until chicken is cooked through and veggies are fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, using a clean cutting board, cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Place in a clean large bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "When the chicken and veggies have about 10 minutes left, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add cauliflower rice, water, and spices; cook, stirring occasionally, until cauliflower is golden and tender, 6-7 minutes. Remove from heat.",
      "secondary_message": "toasted sesame oil\nsalt\nblack pepper\n½ tsp crushed red pepper"
    },
    {
      "primary_message": "Meanwhile, roughly chop cashews.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "primary_message": "To serve, divide cauliflower rice and teriyaki chicken bake between plates or bowls. Top with cashews and enjoy!",
      "secondary_message": null
    }
  ],
