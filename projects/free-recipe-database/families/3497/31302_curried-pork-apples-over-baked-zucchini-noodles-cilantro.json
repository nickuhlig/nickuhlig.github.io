  "instructions": [
    {
      "id": 494845,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 494846,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium zucchini squash\n3 Granny Smith apples\n1 small bunch cilantro"
    },
    {
      "id": 494847,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; divide between two large baking sheet pans. Drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp neutral vegetable oil\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 494848,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until zucchini noodles are tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 494849,
      "primary_message": "Meanwhile, quarter, core, and small dice apples. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 494850,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494851,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the apple.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 494852,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add apple, garlic, pork, and spices; cook, breaking the meat apart with a spoon, until apple is tender and meat is browned, 5-6 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil\n2 ¼ lb lean ground pork\n1 ½ tbsp curry powder\n¾ tsp turmeric, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 494853,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 494854,
      "primary_message": "When the pork is done, add half of the cilantro to the skillet and stir to combine. Cover and remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 494855,
      "primary_message": "To serve, divide zucchini noodles and curried pork between plates or bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
