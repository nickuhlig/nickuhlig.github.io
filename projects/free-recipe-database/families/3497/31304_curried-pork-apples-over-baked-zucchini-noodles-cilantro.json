  "instructions": [
    {
      "id": 494867,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 494868,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n2 Granny Smith apples\n1 small bunch cilantro"
    },
    {
      "id": 494869,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles; transfer to a large baking sheet pan. Drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp neutral vegetable oil\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 494870,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, tossing halfway through, until zucchini noodles are tender, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 494871,
      "primary_message": "Meanwhile, quarter, core, and small dice apples. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 494872,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 494873,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the apple.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 494874,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add apple, garlic, pork, and spices; cook, breaking the meat apart with a spoon, until apple is tender and meat is browned, 4-5 minutes.",
      "secondary_message": "2 tsp neutral vegetable oil\n0.68 kg lean ground pork\n1 tbsp curry powder\n½ tsp turmeric, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 494875,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 494876,
      "primary_message": "When the pork is done, add half of the cilantro to the skillet and stir to combine. Cover and remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 494877,
      "primary_message": "To serve, divide zucchini noodles and curried pork between plates or bowls. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
