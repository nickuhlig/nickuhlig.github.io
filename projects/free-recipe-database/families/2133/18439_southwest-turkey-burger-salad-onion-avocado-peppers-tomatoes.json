  "instructions": [
    {
      "id": 301961,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n1 ½ jalapeño peppers\n3 red bell peppers\n1 ½ pints grape tomatoes\n1 ½ avocados\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 301962,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 301963,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the cilantro. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 301964,
      "primary_message": "Add turkey, bread crumbs, and spices to the bowl; mix with your hands until well combined. Form the turkey mixture into 6 equal-sized patties, place on a plate, and set aside. ",
      "secondary_message": "2 ¼ lb ground turkey\n¾ cup panko bread crumbs\n1 tbsp paprika\n1 tbsp chili powder\n1 tbsp garlic powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 301965,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301966,
      "primary_message": "While the grill pan heats up, place mayo and additional spices in a small bowl; stir to combine the aioli and set aside. ",
      "secondary_message": "¼ cup avocado oil mayonnaise\n½ tsp garlic powder\n½ tsp paprika\n3 pinch black pepper"
    },
    {
      "id": 301967,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 301968,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, and salt in another large bowl. Whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 ½ tsp honey\n½ tsp salt"
    },
    {
      "id": 301969,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; halve tomatoes. Add both to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 301970,
      "primary_message": "Peel and slice onions crosswise into thin rings.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 301971,
      "primary_message": "Halve and pit avocados; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 301972,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and veggies; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 301973,
      "primary_message": "To serve, divide salad and burgers between plates or bowls; spread burgers with aioli, then layer with onion and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
