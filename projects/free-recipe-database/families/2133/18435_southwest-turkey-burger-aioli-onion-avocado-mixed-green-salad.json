  "instructions": [
    {
      "id": 301907,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n1 jalapeño pepper\n2 red bell peppers\n1 pint grape tomatoes\n1 avocado\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 301908,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 301909,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the cilantro. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 301910,
      "primary_message": "Add turkey, bread crumbs, and spices to the bowl; mix with your hands until well combined. Form the turkey mixture into 4 equal-sized patties, place on a plate, and set aside. ",
      "secondary_message": "1 ½ lb ground turkey\n½ cup panko bread crumbs\n2 tsp paprika\n2 tsp chili powder\n2 tsp garlic powder\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 301911,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301912,
      "primary_message": "While the grill pan heats up, place mayo and additional spices in a small bowl; stir to combine the aioli and set aside. ",
      "secondary_message": "3 tbsp mayonnaise\n¼ tsp garlic powder\n¼ tsp paprika\n⅛ tsp black pepper"
    },
    {
      "id": 301913,
      "primary_message": "Once the grill pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 301914,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, and salt in another medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp honey\n¼ tsp salt"
    },
    {
      "id": 301915,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; halve tomatoes. Add both to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 301916,
      "primary_message": "Peel and slice onion crosswise into thin rings.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 301917,
      "primary_message": "Halve and pit avocado; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 301918,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 301919,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and veggies; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 301920,
      "primary_message": "Place bottom half of each bun on a plate; spread with aioli, then layer with burger patties, onion, and avocado. Close with the top half of each bun and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
