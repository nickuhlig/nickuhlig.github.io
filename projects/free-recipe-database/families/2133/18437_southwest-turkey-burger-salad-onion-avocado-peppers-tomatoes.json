  "instructions": [
    {
      "id": 301935,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small bunch cilantro\n½ jalapeño pepper\n1 red bell pepper\n½ pint grape tomatoes\n½ avocado\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 301936,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 301937,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the cilantro. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 301938,
      "primary_message": "Add turkey, bread crumbs, and spices to the bowl; mix with your hands until well combined. Form the turkey mixture into 2 equal-sized patties, place on a plate, and set aside. ",
      "secondary_message": "¾ lb ground turkey\n¼ cup panko bread crumbs\n1 tsp paprika\n1 tsp chili powder\n1 tsp garlic powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 301939,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 301940,
      "primary_message": "While the grill pan heats up, place mayo and additional spices in a small bowl; stir to combine the aioli and set aside. ",
      "secondary_message": "1 ½ tbsp avocado oil mayonnaise\n⅛ tsp garlic powder\n⅛ tsp paprika\n1 pinch black pepper"
    },
    {
      "id": 301941,
      "primary_message": "Once the grill pan is hot, coat with oil. Add burger patties and cook, undisturbed, for 5 minutes; flip patties, and cook an additional 5-7 minutes, until cooked through. Once done, transfer to a clean plate. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 301942,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, and salt in another medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp Dijon mustard\n½ tsp honey\n⅛ tsp salt"
    },
    {
      "id": 301943,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips; halve tomatoes. Add both to the bowl with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 301944,
      "primary_message": "Peel and slice onion crosswise into thin rings.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 301945,
      "primary_message": "Halve and pit avocado; slice crosswise while still in the skin and scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 301946,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and veggies; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 301947,
      "primary_message": "To serve, divide salad and burgers between plates or bowls; spread burgers with aioli, then layer with onion and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
