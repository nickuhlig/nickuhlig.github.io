  "instructions": [
    {
      "id": 280535,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n6 tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 280536,
      "primary_message": "Trim and slice eggplants lengthwise into ½-inch thick planks; transfer to a large plate, drizzle with oil, and sprinkle with salt.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 280537,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 280538,
      "primary_message": "Once the pan is hot, working in batches if necessary, add eggplant and grill, flipping once, until tender, 3-4 minutes per side. Return to the plate and loosely cover with aluminum foil. (Reserve pan for later use.)",
      "secondary_message": null
    },
    {
      "id": 280539,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 280540,
      "primary_message": "Add yogurt, water, and spices to the bowl with the garlic; whisk to combine the sauce and set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n⅓ cup water\n1 ½ tsp dill, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 280541,
      "primary_message": "Pat salmon dry with paper towels, place on another plate, and season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb salmon fillet\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 280542,
      "primary_message": "Once the eggplant is done, coat the pan with oil; working in batches if necessary, add salmon and grill until flakey and cooked through, 4-5 minutes per side. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 280543,
      "primary_message": "While the salmon is cooking, thinly slice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 280544,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 280545,
      "primary_message": "To serve, divide salmon, eggplant, and tomato slices between plates. Top veggies with yogurt sauce and pine nuts, then sprinkle basil over top. Enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
