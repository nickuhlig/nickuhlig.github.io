  "instructions": [
    {
      "id": 620381,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n1 small bunch cilantro\n1 ½ limes\n6 tomatoes\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 620382,
      "primary_message": "Place vinegar, sugar, and salt in a medium bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n1 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 620383,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into 2-inch long pieces. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 620384,
      "primary_message": "Halve bacon crosswise and place on a plate. Sprinkle with sugar on both sides.",
      "secondary_message": "24 slices bacon\n2 tbsp brown sugar"
    },
    {
      "id": 620385,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620386,
      "primary_message": "Once the skillet is hot, working in batches, add bacon and cook, flipping halfway through, until golden brown and crispy, 6-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 620387,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 620388,
      "primary_message": "Zest and juice limes into the bowl with the cilantro. Add mayo and spices, then whisk to combine the lime aioli. Set aside.",
      "secondary_message": "⅓ cup mayonnaise\n¾ tsp salt\n½ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 620389,
      "primary_message": "Slice tomatoes crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 620390,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; top with tomatoes and bacon. Drizzle with lime aioli and serve with pickled cucumbers on the side. Enjoy!",
      "secondary_message": null
    }
  ],
