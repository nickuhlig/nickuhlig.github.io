  "instructions": [
    {
      "id": 620391,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n½ small bunch cilantro\n½ lime\n2 tomatoes\n½ head butter (Boston) lettuce"
    },
    {
      "id": 620392,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl. Whisk to combine the pickling liquid.",
      "secondary_message": "2 tbsp white wine vinegar\n1 tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 620393,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into 2-inch long pieces. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 620394,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620395,
      "primary_message": "While the skillet heats up, halve bacon crosswise and place on a plate. Sprinkle with sugar on both sides.",
      "secondary_message": "8 slices bacon\n2 tsp brown sugar"
    },
    {
      "id": 620396,
      "primary_message": "Once the skillet is hot, add bacon and cook, flipping halfway through, until golden brown and crispy, 6-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 620397,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in another small bowl.",
      "secondary_message": null
    },
    {
      "id": 620398,
      "primary_message": "Zest and juice lime into the bowl with the cilantro. Add mayo and spices, then whisk to combine the lime aioli. Set aside.",
      "secondary_message": "2 tbsp mayonnaise\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 620399,
      "primary_message": "Slice tomatoes crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 620400,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; top with tomatoes and bacon. Drizzle with lime aioli and serve with pickled cucumbers on the side. Enjoy!",
      "secondary_message": null
    }
  ],
