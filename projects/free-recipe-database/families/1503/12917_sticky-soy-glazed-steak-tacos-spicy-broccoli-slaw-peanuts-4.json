  "instructions": [
    {
      "primary_message": "Wash, dry, peel and mince ginger; peel and mince garlic.",
      "secondary_message": "2 (1 inch) pieces ginger root\n4 cloves garlic"
    },
    {
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add ginger and garlic to the pan and cook, stirring occasionally, about 1 minute. ",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Add soy sauce, sugar, and crushed red pepper to the pan and cook, stirring frequently, until thickened and reduced by half, 4-5 minutes. Remove glaze from the heat and set aside.",
      "secondary_message": "3 tbsp brown sugar\n½ tsp crushed red pepper"
    },
    {
      "primary_message": "Meanwhile, place vinegar, chili-garlic sauce, and salt in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup rice vinegar\n2 tsp chili-garlic sauce\nsalt"
    },
    {
      "primary_message": "Wash, dry, peel, and grate carrots. Add to the bowl with the dressing, along with the broccoli slaw; toss to combine and set aside.",
      "secondary_message": "2 medium carrots\n1 (12 oz) pkg broccoli slaw"
    },
    {
      "primary_message": "Preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the grill pan heats up, pat steak dry with paper towels and place on a plate; season with salt and pepper on both sides. ",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\nsalt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Once the pan is hot, coat with oil. Add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate along with half the glaze, and turn to coat. Loosely cover with foil.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "primary_message": "Warm tortillas in the grill pan, oven, or microwave (optional), 15-30 seconds.",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide tortillas between plates; top with steak, remaining glaze, slaw, and peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
