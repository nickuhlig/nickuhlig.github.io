  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry apples. Cut apples crosswise into 1/2-inch thick rounds (you should get 6 rounds per apple). Use an apple corer or small cookie cutter to remove cores.",
      "secondary_message": "1 Gala apple\n1 Granny Smith apple"
    },
    {
      "primary_message": "Place almond butter in a small bowl.",
      "secondary_message": "½ cup natural almond butter"
    },
    {
      "primary_message": "Place granola on a plate.",
      "secondary_message": "1 cup granola"
    },
    {
      "primary_message": "Have the kids help spread almond butter on each apple slice. Dip the almond butter-covered side in the granola, pressing gently to adhere. Place apple rings on a platter.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide apple rings between plates and enjoy!",
      "secondary_message": null
    }
  ],
