  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Hull and quarter the fresh strawberries lengthwise. Pick the mint leaves from the stems and thinly slice them. Thinly slice the fresh Thai basil leaves. Zest the lime. Juice the lime.",
      "secondary_message": "1 lb fresh strawberries\n12 fresh mint\n12 fresh Thai basil leaves\n1 lime\n1 lime"
    },
    {
      "id": 1,
      "primary_message": "For the Strawberry Compote: In a medium mixing bowl, combine strawberries with mint, Thai basil, and sugar.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using a zester, zest the peel of 1 lime directly over the strawberries (this will ensure volatile oils from the lime peel get into the strawberries and won't be lost on your cutting board).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add lime juice to the strawberries, mix well, then let stand for at least 5 and up to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For Serving: When ready to serve, crumble the meringues into bite-size pieces and divide among 4 serving bowls. Top each with the strawberry compote and serve immediately.",
      "secondary_message": null
    }
  ],
