  "instructions": [
    {
      "id": 30251,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 30252,
      "primary_message": "Wash broccoli, carrot, and apple; set aside.",
      "secondary_message": "2 crowns broccoli\n1 medium carrot\n1 Gala apple"
    },
    {
      "id": 30253,
      "primary_message": "Place bacon in skillet and cook until crispy and golden, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "4 strips bacon"
    },
    {
      "id": 30254,
      "primary_message": "Peel and mince garlic. In a large bowl, prepare salad dressing by whisking together garlic, lemon juice, mayo, honey, salt, and pepper.",
      "secondary_message": "1 clove garlic\njuice of ½ lemon\n4 tbsp avocado oil mayonnaise\n½ tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 30255,
      "primary_message": "Separate broccoli into bite-sized florets and cut stem into smaller pieces; add to bowl with dressing. Trim, peel, and coarsely grate carrot; add to bowl. Core and medium dice apple; add to bowl.",
      "secondary_message": ""
    },
    {
      "id": 30256,
      "primary_message": "Add cranberries to bowl. Roughly chop walnuts and add to bowl.",
      "secondary_message": "⅛ cup dried cranberries\r\n½ cup walnuts"
    },
    {
      "id": 30257,
      "primary_message": "Chop bacon into small pieces and add to salad. Toss salad until well coated with dressing.",
      "secondary_message": ""
    },
    {
      "id": 30258,
      "primary_message": "Serve in a bowl and enjoy!",
      "secondary_message": ""
    }
  ],
