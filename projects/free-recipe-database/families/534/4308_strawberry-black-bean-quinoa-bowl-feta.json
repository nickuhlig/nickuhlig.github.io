  "instructions": [
    {
      "id": 48561,
      "primary_message": "In a small saucepan, combine the quinoa and broth; bring to a boil over high heat.",
      "secondary_message": "½ cup quinoa\n236 ml (1 cup) chicken or vegetable broth"
    },
    {
      "id": 48562,
      "primary_message": "Drain and rinse the black beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 48563,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 48564,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (454 g) pkg strawberries\n1 jalapeño pepper\n½ lime"
    },
    {
      "id": 48565,
      "primary_message": "Juice the lime into a medium bowl (that will be used to mix the strawberries and jalapeño pepper).",
      "secondary_message": null
    },
    {
      "id": 48566,
      "primary_message": "To the lime juice, add olive oil, honey, salt, and pepper; whisk together.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48567,
      "primary_message": "Trim off and discard the stem ends of the strawberries; medium dice the strawberries and add to the bowl with the dressing.",
      "secondary_message": ""
    },
    {
      "id": 48568,
      "primary_message": "Quarter the jalapeño pepper lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the pepper and add to the strawberries; toss with the dressing.",
      "secondary_message": null
    },
    {
      "id": 48569,
      "primary_message": "Uncover the quinoa and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 48570,
      "primary_message": "To serve, arrange the quinoa, black beans, strawberry- jalapeño mixture, and feta in a bowl. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
