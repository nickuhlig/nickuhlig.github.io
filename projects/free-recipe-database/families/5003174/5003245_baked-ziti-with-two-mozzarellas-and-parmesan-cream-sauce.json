  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 200°C (400°F) and position rack in center. Boil pasta in a medium pot of salted boiling water until about halfway cooked (about 6 1/2 minutes for pasta that will be al dente in 9 minutes). Reserve 1/2 cup pasta-cooking water, then drain pasta.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large mixing bowl, combine pasta with 2 1/2 cups tomato sauce, reserved 1/2 cup pasta-cooking water, low-moisture mozzarella, and 1 cup fresh mozzarella. Season with salt and pepper and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Scrape into baking dish and press into an even layer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Drizzle remaining 1 1/2 cups tomato sauce all over top of pasta.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Scatter remaining 1 cup mozzarella all over, cover with aluminum foil, and bake for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Meanwhile, in a medium saucepan, gently simmer cream over medium-low heat, stirring frequently, until reduced to 1 1/2 cups, about 20 minutes. Sprinkle in Parmigiano-Reggiano into cream and whisk until completely melted and sauce is smooth. Season with salt. Keep warm.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Increase oven to 230°C (450°F), uncover baked ziti, and cook until just starting to brown on top, about 10 minutes. Let stand for 10 minutes. Top with basil leaves, spoon onto plates, and drizzle with Parmesan cream. Serve immediately.",
      "secondary_message": null
    }
  ],
