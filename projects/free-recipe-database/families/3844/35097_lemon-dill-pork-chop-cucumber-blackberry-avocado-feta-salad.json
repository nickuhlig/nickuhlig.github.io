  "instructions": [
    {
      "id": 553211,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch fresh dill\n1 ½ lemons\n3 English cucumbers\n3 avocados\n3 (6 oz) pkgs blackberries"
    },
    {
      "id": 553212,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Divide between a small and large bowl. (Set large bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 553213,
      "primary_message": "Zest lemons into the small bowl with the dill. (Reserve lemons for later use.)",
      "secondary_message": null
    },
    {
      "id": 553214,
      "primary_message": "Peel and mince garlic. Add to the small bowl with the dill along with oil, salt, and pepper, then stir to combine.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 553215,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 553216,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate. Using your hands, rub with the dill oil on both sides.",
      "secondary_message": "6 pork chops, boneless"
    },
    {
      "id": 553217,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 553218,
      "primary_message": "Meanwhile, juice reserved lemons into the large bowl with the dill, then add oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 553219,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 553220,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with blackberries and feta, then gently stir to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 553221,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 553222,
      "primary_message": "To serve, divide chops and salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
