  "instructions": [
    {
      "id": 553187,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch fresh dill\n½ lemon\n1 English cucumber\n1 avocado\n1 (6 oz) pkg blackberries"
    },
    {
      "id": 553188,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Divide between a small and medium bowl. (Set medium bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 553189,
      "primary_message": "Zest lemon into the small bowl with the dill. (Reserve lemon for later use.)",
      "secondary_message": null
    },
    {
      "id": 553190,
      "primary_message": "Peel and mince garlic. Add to the small bowl with the dill along with oil, salt, and pepper, then stir to combine.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 553191,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 553192,
      "primary_message": "While the skillet heats up, pat pork chops dry with paper towels and place on a plate. Using your hands, rub with the dill oil on both sides.",
      "secondary_message": "2 pork chops, boneless"
    },
    {
      "id": 553193,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 553194,
      "primary_message": "Meanwhile, juice reserved lemon into the medium bowl with the dill, then add oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 553195,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 553196,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with blackberries and feta, then gently stir to combine the salad.",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 553197,
      "primary_message": "Thinly slice pork chops.",
      "secondary_message": null
    },
    {
      "id": 553198,
      "primary_message": "To serve, divide chops and salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
