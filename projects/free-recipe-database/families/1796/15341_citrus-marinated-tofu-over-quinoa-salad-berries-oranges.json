  "instructions": [
    {
      "id": 252778,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 252779,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 252780,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 orange\n½ lime\n1 lemon\n1 stick celery\n½ small bunch green onions (scallions)\n½ (454 g) pkg strawberries\n1 (170 g) pkg blueberries\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 252781,
      "primary_message": "Zest orange into a medium bowl (set orange aside for later use). Juice lime into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 252782,
      "primary_message": "Peel and mince garlic; add to the bowl with the lime juice, along with soy sauce, oil, and spices. Whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n1 tbsp soy sauce\n2 tsp extra virgin olive oil\n¼ tsp cumin, ground\n¼ tsp oregano, dried\n¼ tsp black pepper"
    },
    {
      "id": 252783,
      "primary_message": "Meanwhile, cut the tofu planks in half and then cut each half into 4 triangles. Place tofu in the bowl with the marinade and gently toss to coat; set aside. (Reserve baking sheet for later use.)",
      "secondary_message": null
    },
    {
      "id": 252784,
      "primary_message": "Juice lemon into another medium bowl; add oil, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 252785,
      "primary_message": "Trim and cut celery and green onions crosswise into ¼-inch pieces; add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 252786,
      "primary_message": "Trim and thinly slice strawberries; add to the bowl along with the blueberries.",
      "secondary_message": null
    },
    {
      "id": 252787,
      "primary_message": "Remove peel from the zested orange; halve lengthwise, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 252788,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 252789,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 252790,
      "primary_message": "Meanwhile, transfer the cooked quinoa to the baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 252791,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the tofu and marinade; cook the tofu until golden brown, 2-3 minutes per side. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 252792,
      "primary_message": "Add cooled quinoa to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 252793,
      "primary_message": "To serve, divide quinoa salad and tofu between plates. Enjoy!",
      "secondary_message": null
    }
  ],
