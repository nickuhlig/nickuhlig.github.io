  "instructions": [
    {
      "id": 252810,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 252811,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 252812,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 oranges\n1 ½ limes\n3 lemons\n3 sticks celery\n1 small bunch green onions (scallions)\n1 ½ (454 g) pkgs strawberries\n2 (170 g) pkg blueberries\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 252813,
      "primary_message": "Zest oranges into a large bowl (set oranges aside for later use). Juice limes into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 252814,
      "primary_message": "Peel and mince garlic; add to the bowl with the lime juice, along with soy sauce, oil, and spices. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp soy sauce\n2 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp oregano, dried\n¾ tsp black pepper"
    },
    {
      "id": 252815,
      "primary_message": "Meanwhile, cut the tofu planks in half and then cut each half into 4 triangles. Place tofu in the bowl with the marinade and gently toss to coat; set aside. (Reserve baking sheet for later use.)",
      "secondary_message": null
    },
    {
      "id": 252816,
      "primary_message": "Juice lemons into another large bowl; add oil, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 252817,
      "primary_message": "Trim and cut celery and green onions crosswise into ¼-inch pieces; add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 252818,
      "primary_message": "Trim and thinly slice strawberries; add to the bowl along with the blueberries.",
      "secondary_message": null
    },
    {
      "id": 252819,
      "primary_message": "Remove peel from the zested oranges; halve lengthwise, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 252820,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 252821,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 252822,
      "primary_message": "Meanwhile, transfer the cooked quinoa to the baking sheet. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 252823,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the tofu and marinade; cook the tofu until golden brown, 2-3 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 252824,
      "primary_message": "Add cooled quinoa to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 252825,
      "primary_message": "To serve, divide quinoa salad and tofu between plates. Enjoy!",
      "secondary_message": null
    }
  ],
