  "instructions": [
    {
      "id": 252570,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 252571,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 oranges\n1 ½ limes\n3 lemons\n3 sticks celery\n1 small bunch green onions (scallions)\n2 (16 oz) pkg strawberries\n2 (6 oz) pkgs blueberries\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 252572,
      "primary_message": "Zest oranges into a large bowl (set oranges aside for later use). Juice limes into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 252573,
      "primary_message": "Peel and mince garlic; add to the bowl with the lime juice, along with soy sauce, oil, and spices. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp soy sauce\n2 tbsp extra virgin olive oil\n¾ tsp cumin, ground\n¾ tsp oregano, dried\n¾ tsp black pepper"
    },
    {
      "id": 252574,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Place chicken in the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 252575,
      "primary_message": "Juice lemons into another large bowl; add oil, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 252576,
      "primary_message": "Using a clean cutting board, trim and cut celery and green onions crosswise into ¼-inch pieces; add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 252577,
      "primary_message": "Trim and thinly slice strawberries; add to the bowl along with the blueberries.",
      "secondary_message": null
    },
    {
      "id": 252578,
      "primary_message": "Remove peel from the zested oranges; halve lengthwise, then slice crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 252579,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": null
    },
    {
      "id": 252580,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 252581,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and marinade to the skillet; pan-fry until the chicken is golden and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 252582,
      "primary_message": "Meanwhile, transfer the cooked quinoa to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 252583,
      "primary_message": "Add cooled quinoa to the bowl with the salad and gently stir to combine.",
      "secondary_message": null
    },
    {
      "id": 252584,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 252585,
      "primary_message": "To serve, divide quinoa salad and chicken between plates. Enjoy!",
      "secondary_message": null
    }
  ],
