  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the ends of the string beans. Finely mince the garlic.",
      "secondary_message": "340 g string beans\n4 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Place pork in a large bowl. Add 1/4 teaspoon salt, sugar, ground white pepper, Shaoxing wine, soy sauce, 1 teaspoon oil, and cornstarch. Mix well and transfer to refrigerator for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, bring 4 cups of salted water to a boil in a wok over high heat. Add string beans and cook for 1 minute. Remove strained beans to a colander and rinse under cold running water until cooled. Allow excess water to drain while pork marinates. Dry wok with paper towels.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When ready to cook, heat 2 tablespoons oil in the wok over high heat until smoking. Add ginger. Cook for 30 seconds and then remove and discard ginger. Add pork and spread it out in a single layer. Cook without moving until lightly browned, about 1 minute. Continue to cook, stirring, until almost cooked through, about 2 minutes. Transfer to a bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat remaining tablespoon oil over high heat until smoking. Shake off any excess water from string beans and add them to wok. Season lightly with salt and cook, stirring, until tender, about 1 minute.\nReturn pork to wok and add minced garlic. Cook, stirring, until fragrant, about 1 minute. Transfer to a serving platter immediately and serve with white rice.",
      "secondary_message": null
    }
  ],
