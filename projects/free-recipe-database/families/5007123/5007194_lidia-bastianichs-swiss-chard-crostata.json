  "instructions": [
    {
      "id": 1,
      "primary_message": "Make dough with flour, oil, salt and water (as needed). Once the dough obtains a smooth consistency, cover it with saran wrap and allow it to rest for approximately 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Braise leeks in olive oil. Add Swiss chard, scallions, salt, pepper and marjoram. Simmer at low temperature for approximately 20 minutes until most water has evaporated, drain and let cool.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a mixer put eggs, ricotta, Parmigiano Reggiano, cream, salt and pepper. Blend and add braised vegetables and mix together well.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Preheat the oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Roll out a thin piece of dough into a rectangle about 56-cm by 41-cm and set in a buttered 18\" x 12\" low baking dish. (The dough should overlap about 5 cm around the dish). Pour in the Swiss chard mix, make it level; fold over the overlapping dough. Brush lightly with olive oil or egg yolk and bake for 45 minutes. Allow it to cool and serve warm.",
      "secondary_message": null
    }
  ],
