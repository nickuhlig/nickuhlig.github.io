  "instructions": [
    {
      "id": 1,
      "primary_message": "Grill shrimp: Preheat a gas grill or ridged grill pan over medium high heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Divide shrimp among skewers. Brush each side with olive oil and season with salt and pepper. Grill until pink on the outside and just cooked through on the inside, about 4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Make charmoula: Heat a small skillet over medium heat. Add cumin and coriander and toast until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Transfer cumin and coriander to a large mortar and add garlic. Mash until a paste forms. Pound in paprika, cayenne, lemon zest, and lemon juice.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stir in olive oil until emulsified. Stir in cilantro.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Divide grilled shrimp among four plates. Top each shrimp with charmoula.",
      "secondary_message": null
    }
  ],
