  "instructions": [
    {
      "id": 402119,
      "primary_message": "Preheat oven to 230°C (450°F). Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 402120,
      "primary_message": "Pat the chicken thighs dry with paper towels and place on a plate; spread the top side with pesto, then wrap with prosciutto. Transfer to a large baking dish and drizzle with oil. ",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 cup sun-dried tomato pesto\n15 slices prosciutto\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 402121,
      "primary_message": "Place baking dish on the upper rack of the oven (it doesn't have to be fully heated) and roast until prosciutto is golden brown and chicken is cooked through, 20-25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 402122,
      "primary_message": "Meanwhile, wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into ½-inch thick half-moons. Divide between two baking sheet pans. ",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 402123,
      "primary_message": "Add mushrooms to the baking sheets with the zucchini. Drizzle veggies with additional oil and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "3 (227g ) pkg sliced white mushrooms\n3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 402124,
      "primary_message": "Place baking sheets on the middle and lower racks of the oven and roast, tossing halfway through, until veggies are fork-tender, 12-15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 402125,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
