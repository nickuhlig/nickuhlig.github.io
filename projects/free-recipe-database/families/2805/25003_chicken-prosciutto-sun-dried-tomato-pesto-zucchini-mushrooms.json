  "instructions": [
    {
      "id": 402105,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 402106,
      "primary_message": "Pat the chicken thighs dry with paper towels and place on a plate; spread the top side with pesto, then wrap with prosciutto. Transfer to a small baking dish and drizzle with oil. ",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n⅓ cup sun-dried tomato pesto\n5 slices prosciutto\n1 tsp extra virgin olive oil"
    },
    {
      "id": 402107,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast until prosciutto is golden brown and chicken is cooked through, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 402108,
      "primary_message": "Meanwhile, wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into ½-inch thick half-moons. Transfer to a baking sheet pan. ",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 402109,
      "primary_message": "Add mushrooms to the baking sheet with the zucchini. Drizzle veggies with additional oil and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "1 (227g ) pkg sliced white mushrooms\n1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 402110,
      "primary_message": "Add baking sheet to the oven and roast, tossing halfway through, until veggies are fork-tender, 10-12 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 402111,
      "primary_message": "To serve, divide chicken and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
