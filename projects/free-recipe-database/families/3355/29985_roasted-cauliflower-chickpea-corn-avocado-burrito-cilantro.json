  "instructions": [
    {
      "id": 477305,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 477306,
      "primary_message": "Place spices in a small bowl and stir to combine. Set aside.",
      "secondary_message": "2 tbsp chili powder\n¾ tsp garlic powder\n¾ tsp cayenne pepper\n1 ½ tsp salt"
    },
    {
      "id": 477307,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch cilantro\n3 tomatoes\n1 ½ avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 477308,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a large baking sheet pan, drizzle with oil, and sprinkle with half of the spice mix; stir to coat and spread out in a single layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 477309,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is golden and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 477310,
      "primary_message": "Meanwhile, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 477311,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 477312,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring frequently, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 477313,
      "primary_message": "While the onion is cooking, drain and rinse chickpeas in a colander.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 477314,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 477315,
      "primary_message": "When the onion is soft, add chickpeas, cilantro, corn, and reserved spice mix to the pot. Continue to cook, stirring frequently, until corn and beans are warmed through, 4-5 minutes more. Remove from heat.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 477316,
      "primary_message": "Meanwhile, small dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 477317,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 477318,
      "primary_message": "Separate lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 477319,
      "primary_message": "Place tortillas on a flat surface and divide roasted cauliflower and bean-corn filling down the center of each one. Top with tomatoes, avocado slices, and lettuce. Fold in sides of tortillas and roll tightly to close the burritos.",
      "secondary_message": "6 large flour tortillas"
    },
    {
      "id": 477320,
      "primary_message": "To serve, cut burritos in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
