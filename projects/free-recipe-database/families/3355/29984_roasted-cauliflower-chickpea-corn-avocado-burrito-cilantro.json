  "instructions": [
    {
      "id": 477289,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 477290,
      "primary_message": "Place spices in a small bowl and stir to combine. Set aside.",
      "secondary_message": "4 tsp chili powder\n½ tsp garlic powder\n½ tsp cayenne pepper\n1 tsp salt"
    },
    {
      "id": 477291,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 small bunch cilantro\n2 tomatoes\n1 avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 477292,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, and sprinkle with half of the spice mix; stir to coat and spread out in a single layer. (Reserve remaining spice mix for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 477293,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until cauliflower is golden and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 477294,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 477295,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 477296,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the onion and cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 477297,
      "primary_message": "While the onion is cooking, drain and rinse chickpeas in a colander.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 477298,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 477299,
      "primary_message": "When the onion is soft, add chickpeas, cilantro, corn, and reserved spice mix to the skillet. Continue to cook, stirring frequently, until corn and beans are warmed through, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 477300,
      "primary_message": "Meanwhile, small dice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 477301,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 477302,
      "primary_message": "Separate lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 477303,
      "primary_message": "Place tortillas on a flat surface and divide roasted cauliflower and bean-corn filling down the center of each one. Top with tomatoes, avocado slices, and lettuce. Fold in sides of tortillas and roll tightly to close the burritos.",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 477304,
      "primary_message": "To serve, cut burritos in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
