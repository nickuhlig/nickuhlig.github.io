  "instructions": [
    {
      "id": 333137,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 333138,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 333139,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 333140,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 small bunch asparagus\n0.23 kg white mushrooms\n1 head romaine lettuce"
    },
    {
      "id": 333141,
      "primary_message": "Finely grate Parmesan into a medium bowl.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 333142,
      "primary_message": "Using a clean cutting board, peel and mince garlic; mince anchovy fillets. Add both to the bowl with the Parmesan.",
      "secondary_message": "2 cloves garlic\n2 anchovy fillets, packed in oil"
    },
    {
      "id": 333143,
      "primary_message": "Juice lemon into the bowl, then add mayo, oil, Worcestershire, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp extra virgin olive oil\n½ tsp Worcestershire sauce\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 333144,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 333145,
      "primary_message": "Return skillet with drippings to medium-high heat; add asparagus and cook, stirring occasionally, until tender-crisp, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 333146,
      "primary_message": "While the asparagus is cooking, thinly slice mushrooms and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 333147,
      "primary_message": "Chop or tear lettuce into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 333148,
      "primary_message": "When the asparagus is done, remove from heat, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 333149,
      "primary_message": "To serve, divide salad between plates or bowls and top with crispy bacon. Enjoy!",
      "secondary_message": null
    }
  ],
