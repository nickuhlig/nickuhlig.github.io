  "instructions": [
    {
      "id": 333124,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 333125,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 333126,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve pot with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 333127,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n3 small bunches asparagus\n1 ½ lb white mushrooms\n3 heads romaine lettuce"
    },
    {
      "id": 333128,
      "primary_message": "Finely grate Parmesan into a large bowl.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 333129,
      "primary_message": "Using a clean cutting board, peel and mince garlic; mince anchovy fillets. Add both to the bowl with the Parmesan.",
      "secondary_message": "6 cloves garlic\n6 anchovy fillets, packed in oil"
    },
    {
      "id": 333130,
      "primary_message": "Juice lemons into the bowl, then add mayo, oil, Worcestershire, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "¾ cup mayonnaise\n3 tbsp extra virgin olive oil\n1 ½ tsp Worcestershire sauce\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 333131,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 333132,
      "primary_message": "Return pot with drippings to medium-high heat; add asparagus and cook, stirring occasionally, until tender-crisp, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 333133,
      "primary_message": "While the asparagus is cooking, thinly slice mushrooms and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 333134,
      "primary_message": "Chop or tear lettuce into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 333135,
      "primary_message": "When the asparagus is done, remove from heat, add to the bowl, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 333136,
      "primary_message": "To serve, divide salad between plates or bowls and top with crispy bacon. Enjoy!",
      "secondary_message": null
    }
  ],
