  "instructions": [
    {
      "id": 455101,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455102,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, curry paste, and soy sauce; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil\n680 g veggie ground, plant based\n3 tbsp Thai curry paste, green\n1 tbsp soy sauce"
    },
    {
      "id": 455103,
      "primary_message": "Meanwhile, place dressing and miso paste in a large bowl. Whisk to combine.",
      "secondary_message": "¾ cup sesame ginger dressing\n3 tbsp miso paste, white"
    },
    {
      "id": 455104,
      "primary_message": "Wash, dry, trim, and small dice cucumbers. Add to the bowl with the dressing along with the shredded cabbage. Stir to combine the salad and set aside.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ (397 g) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 455105,
      "primary_message": "Wash, dry, and cut limes into wedges; set aside for serving.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 455106,
      "primary_message": "Warm taco shells in the microwave if desired.",
      "secondary_message": "18 hard taco shells"
    },
    {
      "id": 455107,
      "primary_message": "Divide taco shells between plates, then fill with a small portion of the salad and veggie ground. Serve with remaining salad and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
