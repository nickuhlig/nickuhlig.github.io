  "instructions": [
    {
      "id": 455030,
      "primary_message": "Place curry paste, oil, and fish sauce in a medium bowl. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp Thai curry paste, red\n1 tbsp toasted sesame oil\n1 tbsp fish sauce"
    },
    {
      "id": 455031,
      "primary_message": "Slice chicken into ½-inch thick strips. Add to the bowl with the marinade, stir to coat, and set aside for 10 minutes.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 455032,
      "primary_message": "When the chicken is done marinating, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 455033,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken strips and marinade; cook, stirring occasionally, until cooked through, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 455034,
      "primary_message": "Meanwhile, place dressing and miso paste in a large bowl. Whisk to combine.",
      "secondary_message": "¾ cup sesame ginger dressing\n3 tbsp miso paste, white"
    },
    {
      "id": 455035,
      "primary_message": "Wash and dry cucumbers; using a clean cutting board, trim and small dice. Add to the bowl with the dressing along with the shredded cabbage. Stir to combine the salad and set aside.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ (14 oz) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 455036,
      "primary_message": "Wash, dry, and cut limes into wedges; set aside for serving.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 455037,
      "primary_message": "Warm taco shells in the microwave if desired.",
      "secondary_message": "18 hard taco shells"
    },
    {
      "id": 455038,
      "primary_message": "Divide taco shells between plates, then fill with a small portion of the salad and chicken. Serve with remaining salad and lime wedges for squeezing. Enjoy!",
      "secondary_message": null
    }
  ],
