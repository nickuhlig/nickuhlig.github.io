  "instructions": [
    {
      "id": 478116,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 478117,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n½ lemon\n½ bunch kale"
    },
    {
      "id": 478118,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 478119,
      "primary_message": "Peel, halve, and slice onion lengthwise into ½-inch thick wedges. Add to the baking sheet with the carrots, drizzle with oil, and season with salt. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 478120,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden brown and tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 478121,
      "primary_message": "While the veggies are roasting, in a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 478122,
      "primary_message": "Meanwhile, juice lemon into a small bowl. Add tahini, water, honey, and spices, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp tahini\n2 tbsp water\n1 tsp honey\n½ tsp turmeric, ground\n¼ tsp garlic powder\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 478123,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a medium bowl and sprinkle with salt.",
      "secondary_message": "1 pinch salt"
    },
    {
      "id": 478124,
      "primary_message": "Add half of the dressing to the bowl with the kale and, using your hands, massage kale with the dressing until wilted, 1-2 minutes. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 478125,
      "primary_message": "Roughly chop dates. Transfer to a plate.",
      "secondary_message": "⅛ cup medjool dates, pitted"
    },
    {
      "id": 478126,
      "primary_message": "Roughly chop pistachios. Add to the plate with the dates.",
      "secondary_message": "¼ cup pistachios, unsalted"
    },
    {
      "id": 478127,
      "primary_message": "Crumble goat cheese onto the plate.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 478128,
      "primary_message": "To serve, divide couscous between bowls; top with kale, roasted veggies, dates, pistachios, and goat cheese. Drizzle with reserved dressing and enjoy!",
      "secondary_message": null
    }
  ],
