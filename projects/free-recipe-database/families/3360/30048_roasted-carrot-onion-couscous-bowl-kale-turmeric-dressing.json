  "instructions": [
    {
      "id": 478142,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 478143,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium carrots\n1 ½ lemons\n1 ½ bunches kale"
    },
    {
      "id": 478144,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 478145,
      "primary_message": "Peel, halve, and slice onions lengthwise into ½-inch thick wedges. Add to the baking sheets with the carrots, drizzle with oil, and season with salt. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 478146,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden brown and tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 478147,
      "primary_message": "While the veggies are roasting, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 478148,
      "primary_message": "Meanwhile, juice lemons into a small bowl. Add tahini, water, honey, and spices, then whisk to combine the dressing. ",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n1 tbsp honey\n1 ½ tsp turmeric, ground\n¾ tsp garlic powder\n¾ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 478149,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces. Place in a large bowl and sprinkle with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 478150,
      "primary_message": "Add half of the dressing to the bowl with the kale and, using your hands, massage kale with the dressing until wilted, 1-2 minutes. (Reserve remaining dressing for serving.)",
      "secondary_message": null
    },
    {
      "id": 478151,
      "primary_message": "Roughly chop dates. Transfer to a plate.",
      "secondary_message": "⅓ cup medjool dates, pitted"
    },
    {
      "id": 478152,
      "primary_message": "Roughly chop pistachios. Add to the plate with the dates.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 478153,
      "primary_message": "Crumble goat cheese onto the plate.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 478154,
      "primary_message": "To serve, divide couscous between bowls; top with kale, roasted veggies, dates, pistachios, and goat cheese. Drizzle with reserved dressing and enjoy!",
      "secondary_message": null
    }
  ],
