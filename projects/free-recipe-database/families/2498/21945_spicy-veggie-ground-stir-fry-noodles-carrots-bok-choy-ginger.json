  "instructions": [
    {
      "id": 368513,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g spaghetti pasta"
    },
    {
      "id": 368514,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onions lengthwise. Peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 368515,
      "primary_message": "Wash, dry, and mince ginger.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 368516,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 368517,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, ginger, and veggie ground; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n680 g veggie ground, plant based"
    },
    {
      "id": 368518,
      "primary_message": "Meanwhile, wash, dry, and trim bok choy. Cut crosswise into strips.",
      "secondary_message": "9 baby bok choy"
    },
    {
      "id": 368519,
      "primary_message": "When the veggie ground is done, add bok choy, carrots, stir-fry sauce, and chili-garlic sauce to the pot. Cook, stirring occasionally, until the vegetables have softened, 4-5 minutes.",
      "secondary_message": "1 ½ (283 g) bags shredded carrots\n1 cup stir-fry sauce\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 368520,
      "primary_message": "When the pasta is done, drain in a colander. Add to the pot with the veggie ground and vegetables, then stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 368521,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
