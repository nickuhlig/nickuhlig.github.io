  "instructions": [
    {
      "primary_message": "Preheat oven to 350°. Using a serrated knife, crosshatch round loaf, making slices every inch in both directions and making sure to not to slice all the way through the bottom of loaf.",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, stir together melted butter, garlic, parsley, and rosemary.",
      "secondary_message": null
    },
    {
      "primary_message": "Brush loaf with melted butter mixture, making sure to get inside crosshatches. Stuff crosshatches with mozzarella and parmesan cheeses and wrap bread completely in foil.",
      "secondary_message": null
    },
    {
      "primary_message": "Bake until cheese is melted and bread is warm and toasty, approximately 20 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Let cool for 5 minutes, then serve with marinara or ranch dressing!",
      "secondary_message": null
    }
  ],
