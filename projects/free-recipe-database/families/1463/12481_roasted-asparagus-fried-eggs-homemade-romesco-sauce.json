  "instructions": [
    {
      "id": 209934,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 209935,
      "primary_message": "Wash, dry, and snap or cut off woody ends of the asparagus and transfer to a baking sheet pan. ",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 209936,
      "primary_message": "Wash, dry, trim, seed, and thinly slice bell pepper; add to the baking sheet with the asparagus. Drizzle veggies with oil, season with salt and pepper, and toss to coat. ",
      "secondary_message": "1 red bell pepper\n2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 209937,
      "primary_message": "Place veggies in the oven and roast until slightly charred and fork-tender, 10-12 minutes. Remove from the oven and set aside. ",
      "secondary_message": null
    },
    {
      "id": 209938,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209939,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but yolks are still runny, about 4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 209940,
      "primary_message": "While the eggs are cooking, peel and mince garlic; transfer to a blender. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 209941,
      "primary_message": "Add roasted peppers, sun-dried tomatoes, almonds, oil, vinegar, and paprika to the blender. Blend until smooth. ",
      "secondary_message": "3 sun-dried tomatoes, oil-packed\n⅛ cup almonds\n3 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp paprika"
    },
    {
      "id": 209942,
      "primary_message": "To serve, divide asparagus, eggs, and Romesco sauce between plates. Top with feta and enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
