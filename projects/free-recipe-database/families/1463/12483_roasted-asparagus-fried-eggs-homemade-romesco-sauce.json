  "instructions": [
    {
      "id": 209952,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 209953,
      "primary_message": "Wash, dry, trim, seed, and thinly slice bell peppers; transfer to a baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to coat. Place peppers in the oven and roast until slightly charred and fork-tender, about 12 minutes. Remove from the oven and set aside. ",
      "secondary_message": "3 red bell peppers\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 209954,
      "primary_message": "Meanwhile, wash, dry, and snap or cut off woody ends of the asparagus; transfer to another baking sheet. Drizzle with oil, season with salt and pepper, and toss to coat. Add asparagus to the oven and roast until fork-tender, about 12 minutes. Remove from the oven and set aside. ",
      "secondary_message": "3 small bunches asparagus\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 209955,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209956,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and season with salt and pepper. Cook until the tops of the whites are set but yolks are still runny, about 4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 209957,
      "primary_message": "While the eggs are cooking, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 209958,
      "primary_message": "Working in batches if necessary, add garlic, roasted peppers, sun-dried tomatoes, almonds, oil, vinegar, and paprika to the blender. Blend until smooth. ",
      "secondary_message": "9 sun-dried tomatoes, oil-packed\n½ cup almonds\n½ cup extra virgin olive oil\n3 tbsp red wine vinegar\n¾ tsp paprika"
    },
    {
      "id": 209959,
      "primary_message": "To serve, divide asparagus, eggs, and Romesco sauce between plates. Top with feta and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
