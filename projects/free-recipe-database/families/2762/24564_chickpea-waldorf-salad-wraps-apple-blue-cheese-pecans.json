  "instructions": [
    {
      "id": 396961,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 396962,
      "primary_message": "Transfer pecans to a baking sheet pan. Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until pecans are golden and fragrant, 8-10 minutes. Remove from oven and set aside to cool slightly.",
      "secondary_message": "¾ cup pecan halves"
    },
    {
      "id": 396963,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n9 sticks celery\n3 Granny Smith apples\n1 small bunch Italian (flat-leaf) parsley\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 396964,
      "primary_message": "Juice lemons into a large bowl. Add yogurt, mayo, honey, vinegar, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n½ cup mayonnaise\n1 ½ tbsp honey\n1 ½ tbsp rice vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 396965,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry; season with additional salt. Add to bowl with dressing.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n¾ tsp salt"
    },
    {
      "id": 396966,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 396967,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 396968,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl. (Set remaining parsley aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 396969,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 396970,
      "primary_message": "Roughly chop the cooled pecans. Add to the bowl, along with the blue cheese, and gently stir to combine the \"Waldorf\" salad.",
      "secondary_message": "1 ½ (113 g) pkg crumbled blue cheese"
    },
    {
      "id": 396971,
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates. Fill each wrap with Walford salad and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
