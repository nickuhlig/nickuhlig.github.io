  "instructions": [
    {
      "id": 396875,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 396876,
      "primary_message": "Transfer pecans to a baking sheet pan. Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until pecans are golden and fragrant, 8-10 minutes. Remove from oven and set aside to cool.",
      "secondary_message": "¾ cup pecan halves"
    },
    {
      "id": 396877,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n9 sticks celery\n3 Granny Smith apples\n1 small bunch Italian (flat-leaf) parsley\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 396878,
      "primary_message": "Zest lemons into a small bowl. Add salt and pepper, then stir to combine. (Reserve lemon for later use.)",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 396879,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 396880,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Sprinkle with the lemon seasoning on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 396881,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden and cooked through, 3-4 minutes per side. Remove to a plate and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 396882,
      "primary_message": "Meanwhile, juice the reserved lemons into a large bowl. Add yogurt, mayo, additional salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup avocado oil mayonnaise\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 396883,
      "primary_message": "Using a clean cutting board, trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 396884,
      "primary_message": "Quarter, core, and small dice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 396885,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl. (Set remaining parsley aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 396886,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 396887,
      "primary_message": "Roughly chop the cooled pecans. Add to the bowl, along with the blue cheese, and gently stir to combine the \"Waldorf\" salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    },
    {
      "id": 396888,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Divide between plates.",
      "secondary_message": null
    },
    {
      "id": 396889,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 396890,
      "primary_message": "To serve, top lettuce with Waldorf salad and divide chicken between plates. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
