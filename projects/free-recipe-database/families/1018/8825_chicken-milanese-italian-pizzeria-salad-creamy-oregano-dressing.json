  "instructions": [
    {
      "id": 137425,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 137426,
      "primary_message": "Place flour and bread crumbs onto two separate plates. Season each plate with salt and pepper. ",
      "secondary_message": "2 tbsp all-purpose flour\n½ cup panko bread crumbs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 137427,
      "primary_message": "In a small bowl, whisk the egg.",
      "secondary_message": "1 egg"
    },
    {
      "id": 137428,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 137429,
      "primary_message": "Dredge chicken fillets in flour, shake off excess, then dip into the bowl with the egg. Let the egg drip off, then dredge the chicken fillets in the bread crumbs, pressing to adhere. Set aside on a plate. ",
      "secondary_message": null
    },
    {
      "id": 137430,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 137431,
      "primary_message": "Add chicken to the skillet; cook until it is cooked through and golden brown, 3-4 minutes per side. Once chicken is done, remove from skillet and place on a paper-towel lined plate. ",
      "secondary_message": null
    },
    {
      "id": 137432,
      "primary_message": "Meanwhile, in a large bowl, prepare dressing by whisking together mayonnaise, vinegar, oil, and oregano. ",
      "secondary_message": "2 tbsp mayonnaise\n2 tbsp red wine vinegar\n1 tbsp extra virgin olive oil\n1 tsp oregano"
    },
    {
      "id": 137433,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head romaine lettuce\n1 red bell pepper\n½ English cucumber"
    },
    {
      "id": 137434,
      "primary_message": "Chop or tear the lettuce into bite-sized pieces and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 137435,
      "primary_message": "Small dice the bell pepper and add to the salad bowl. ",
      "secondary_message": null
    },
    {
      "id": 137436,
      "primary_message": "Trim the ends of the cucumber; halve lengthwise, then thinly slice into half-moons. Add cucumbers to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 137437,
      "primary_message": "Halve the olives lengthwise and add to the salad bowl. Toss to combine the salad.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 137438,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 137439,
      "primary_message": "To serve, divide the chicken and salad between plates. Top with grated Parmesan and enjoy! ",
      "secondary_message": null
    }
  ],
