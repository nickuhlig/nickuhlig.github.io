  "instructions": [
    {
      "id": 1,
      "primary_message": "Season duck generously with salt and pepper. For best results, place on a plate and refrigerate uncovered overnight before proceeding.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Seal duck in vacuum bags. Place in 54°C water bath for at least 45 minutes and up to 4 hours. Remove from bags and dry thoroughly with paper towels.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place breasts skin side-down in a heavy-bottomed 30-cm non-stick or cast iron skillet and set over high heat until sizzling, about 2 minutes. Reduce heat to medium and cook, moving and pressing breasts to ensure good contact between skin and pan until golden brown and crisp, about 5 minutes. Flip and cook second side until barely colored, about 30 seconds. Transfer to paper towel-lined plate and allow to rest for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Slice breasts crosswise into 1.5-cm strips and serve.",
      "secondary_message": null
    }
  ],
