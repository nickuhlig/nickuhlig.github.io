  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and thinly slice the ginger into rounds. Peel the garlic cloves. Stem and halve the fresh Thai red chiles.",
      "secondary_message": "1 (1 inch) piece ginger root\n12 to 15 medium garlic cloves\n1 to 2 fresh Thai red chiles"
    },
    {
      "id": 1,
      "primary_message": "Heat sesame oil in a large skillet or wok over medium-high heat until shimmering. Add ginger, garlic, and chiles and cook until very fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add chicken pieces to the skillet in a single layer and cook, tilting the pan if necessary to submerge all pieces in the oil, for 1 minute. Flip chicken pieces and cook for 1 minute longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add rice wine, soy sauce, and sugar and bring to a boil, stirring to dissolve the sugar. Reduce heat to a simmer. Partially cover the skillet to prevent splashes of oil and cook, turning the chicken pieces every few minutes, until the chicken is cooked through, about 15 minutes. Stir in Thai basil and remove from heat. Serve immediately with rice.",
      "secondary_message": null
    }
  ],
