  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 400 degrees. Line a baking sheet with aluminum foil. Remove the leafy stems and roots of the beets and peel each one with a vegetable peeler. Cut the beets in 1 1/2-inch chunks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place the cut beets on the prepared baking sheet and toss with the olive oil and salt. Roast for until the beets are tender when pierced with a thin-bladed knife, 35 to 40 minutes, tossing once with a spatula midway through.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, combine the vinegar and maple syrup in a small skillet. Cook over medium heat until the liquid is reduced by about half (if shoul lightly coat the back of a metal spoon). Pay close attention and be sure not to over-reduce it; it goes from sweet and syrupy to burnt and hard very quickly.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Toss the glaze with the roasted beets and chill until ready to serve.",
      "secondary_message": null
    }
  ],
