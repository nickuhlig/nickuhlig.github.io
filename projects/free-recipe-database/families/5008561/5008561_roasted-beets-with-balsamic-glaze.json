  "ingredients": [
    {
      "ingredient_id": 13,
      "name": "beets",
      "quantity": "6 medium"
    },
    {
      "ingredient_id": 88,
      "name": "kosher salt",
      "quantity": "1 tsp"
    },
    {
      "ingredient_id": 47,
      "name": "extra-virgin olive oil",
      "quantity": "2 tbsp"
    },
    {
      "ingredient_id": 131,
      "name": "inexpensive balsamic vinegar",
      "quantity": "⅓ cup"
    },
