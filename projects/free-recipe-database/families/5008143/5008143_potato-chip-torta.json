  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the scallions.",
      "secondary_message": "1 tbsp scallions"
    },
    {
      "id": 1,
      "primary_message": "Beat eggs and scallions in a large bowl. Gently fold potato chips into eggs, trying to break as few as possible. Season with salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat pan over medium high heat and add butter; when foam subsides, add egg/chip mixture and turn heat to medium low. Using a rubber spatula, gently pull eggs away from sides of pan while the eggs set.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When eggs have begun to set, use a oven mitt and a plate to flip over torta. Place plate over pan, and securing the pan to the plate with an oven mitt, flip pan over so torta lands on the plate, then gently slip torta back into pan to finish cooking.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Slice into segments and serve with more sliced scallions, cracked black pepper, and Greek yogurt.",
      "secondary_message": null
    }
  ],
