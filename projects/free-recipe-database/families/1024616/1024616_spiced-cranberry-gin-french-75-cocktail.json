  "instructions": [
    {
      "primary_message": "FOR THE SPICED CRANBERRY SYRUP: Wash, dry, and place cranberries in a small saucepan (reserving a few for garnish).",
      "secondary_message": "⅔ cup fresh cranberries"
    },
    {
      "primary_message": "Using your hands (or the back of a knife), break cinnamon sticks into pieces. Add to the saucepan with the cranberries along with cloves, sugar, and water. Stir to combine and bring to a boil. Reduce heat to medium and simmer, stirring occasionally, until sugar is dissolved and cranberries have burst, 3-4 minutes. ",
      "secondary_message": "½ cup granulated sugar"
    },
    {
      "primary_message": "Remove pan from heat and gently crush cranberries with a fork. Let syrup cool completely before straining and using, making sure to press on the solids to extract as much liquid as possible. (NOTE: this recipe makes about 3/4-cup spiced cranberry syrup. Transfer leftover syrup to a small jar and refrigerate for up to one month.)",
      "secondary_message": null
    },
    {
      "primary_message": "FOR THE COCKTAIL: Wash, dry, and juice lemon into a small bowl. Measure out a 1/2 fl oz (1 tbsp) juice and place in a cocktail shaker. (Reserve remaining lemon juice for another use.)",
      "secondary_message": "½ lemon"
    },
    {
      "primary_message": "Add 3/4 fl oz (1 1/2 tbsp) cooled spiced cranberry syrup, 2 fl oz (1/4 cup) cranberry juice, and 1 fl oz (2 tbsp) gin to the shaker. Add ice, then shake until well chilled, about 15 seconds. Strain into a coupe or glass of choice. ",
      "secondary_message": "2 fl oz cranberry juice\n1 fl oz gin\n½ cup ice cube"
    },
    {
      "primary_message": "Top the glass off with 2 fl oz (1/4 cup) chilled brut-style prosecco or champagne, then stir gently. Thread reserved cranberries onto a mini skewer or toothpick. Carefully arrange over the rim and enjoy!",
      "secondary_message": "2 fl oz prosecco (brut-style)"
    }
  ],
