  "instructions": [
    {
      "id": 324471,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 324472,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 324473,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 (2 ½ cm) piece ginger root\n2 medium carrots\n½ English cucumber\n1 avocado"
    },
    {
      "id": 324474,
      "primary_message": "Trim green onions and cut crosswise into thin pieces; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 324475,
      "primary_message": "Peel and mince ginger; add to the bowl with the green onion along with oil, vinegar, soy sauce, and chili-garlic sauce. Stir to combine the sauce and set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp rice vinegar\n1 tbsp soy sauce\n1 tsp chili-garlic sauce"
    },
    {
      "id": 324476,
      "primary_message": "Place additional vinegar, water, sugar, and salt in another small bowl; stir to combine the pickling liquid.",
      "secondary_message": "1 tbsp rice vinegar\n1 tbsp water\n½ tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 324477,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 324478,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 324479,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs"
    },
    {
      "id": 324480,
      "primary_message": "Meanwhile, trim and thinly slice cucumber crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 324481,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 324482,
      "primary_message": "To serve, divide the rice, eggs, pickled carrots, cucumber, and avocado between bowls. Top with ginger-green onion sauce and enjoy!",
      "secondary_message": null
    }
  ],
