  "instructions": [
    {
      "id": 324407,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 324408,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 324409,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root\n6 medium carrots\n1 ½ English cucumbers\n3 avocados"
    },
    {
      "id": 324410,
      "primary_message": "Trim green onions and cut crosswise into thin pieces; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 324411,
      "primary_message": "Peel and mince ginger; add to the bowl with the green onion along with oil, vinegar, soy sauce, and chili-garlic sauce. Stir to combine the sauce and set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n¼ cup rice vinegar\n3 tbsp soy sauce\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 324412,
      "primary_message": "Place additional vinegar, water, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp rice vinegar\n3 tbsp water\n1 ½ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 324413,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 324414,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 324415,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs"
    },
    {
      "id": 324416,
      "primary_message": "Meanwhile, trim and thinly slice cucumbers crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 324417,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 324418,
      "primary_message": "To serve, divide the rice, eggs, pickled carrots, cucumber, and avocado between bowls. Top with ginger-green onion sauce and enjoy!",
      "secondary_message": null
    }
  ],
