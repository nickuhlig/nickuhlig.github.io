  "instructions": [
    {
      "id": 324395,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 324396,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 324397,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n2 (1 inch) pieces ginger root\n4 medium carrots\n1 English cucumber\n2 avocados"
    },
    {
      "id": 324398,
      "primary_message": "Trim green onions and cut crosswise into thin pieces; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 324399,
      "primary_message": "Peel and mince ginger; add to the bowl with the green onion along with oil, vinegar, soy sauce, and chili-garlic sauce. Stir to combine the sauce and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp rice vinegar\n2 tbsp soy sauce\n2 tsp chili-garlic sauce"
    },
    {
      "id": 324400,
      "primary_message": "Place additional vinegar, water, sugar, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "2 tbsp rice vinegar\n2 tbsp water\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 324401,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 324402,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 324403,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n8 eggs"
    },
    {
      "id": 324404,
      "primary_message": "Meanwhile, trim and thinly slice cucumber crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 324405,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 324406,
      "primary_message": "To serve, divide the rice, eggs, pickled carrots, cucumber, and avocado between bowls. Top with ginger-green onion sauce and enjoy!",
      "secondary_message": null
    }
  ],
