  "instructions": [
    {
      "id": 10884,
      "primary_message": "Preheat oven to 200°C (400°F).",
      "secondary_message": ""
    },
    {
      "id": 10885,
      "primary_message": "Peel and mince garlic. In a small bowl, mix together garlic and oil.",
      "secondary_message": "2 cloves garlic\r\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 10886,
      "primary_message": "Wash and dry tomatoes and basil. Slice one tomato into rounds and the other into wedges. Pick basil leaves off the stems; discard the stems.",
      "secondary_message": "2 tomatoes\r\n½ small pkg fresh basil"
    },
    {
      "id": 10887,
      "primary_message": "Grate 1 cup of mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 10888,
      "primary_message": "Place pitas on a flat surface. Spoon olive oil and garlic mixture over top, add tomato slices (save the wedges for the salad), and sprinkle with mozzarella.",
      "secondary_message": "2 whole grain pita breads"
    },
    {
      "id": 10889,
      "primary_message": "Place in the oven, directly on the rack, and bake until cheese melts and crust is crispy, 8-10 minutes. Then add basil leaves and broil until cheese begins to brown, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 10890,
      "primary_message": "In a medium bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\r\n½ tbsp red wine vinegar\r\n⅛ tsp Dijon mustard\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 10891,
      "primary_message": "Wash and dry baby spinach. Add spinach and remaining tomato to bowl with dressing and toss.",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 10892,
      "primary_message": "To serve, place pizza wedges on a plate and have with salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
