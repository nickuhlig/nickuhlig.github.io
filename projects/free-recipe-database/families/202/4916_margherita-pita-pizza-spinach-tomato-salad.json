  "instructions": [
    {
      "id": 59783,
      "primary_message": "Preheat oven to 200°C (400°F).",
      "secondary_message": ""
    },
    {
      "id": 59782,
      "primary_message": "Peel and mince garlic. In a small bowl, mix together garlic and oil.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 59781,
      "primary_message": "Wash and dry tomatoes and basil. Slice three tomatoes into rounds and the other three into wedges. Pick basil leaves off the stems; discard the stems.",
      "secondary_message": "6 tomatoes\n1 ½ small pkg fresh basil"
    },
    {
      "id": 59780,
      "primary_message": "Grate 3 cups of mozzarella.",
      "secondary_message": "1 ½ (227 g) block mozzarella cheese"
    },
    {
      "id": 59779,
      "primary_message": "Place pitas on a flat surface. Spoon olive oil and garlic mixture over top, add tomato slices (save the wedges for the salad), and sprinkle with mozzarella.",
      "secondary_message": "6 whole grain pita breads"
    },
    {
      "id": 59778,
      "primary_message": "Place in the oven, directly on the rack, and bake until cheese melts and crust is crispy, 8-10 minutes. Then add basil leaves and broil until cheese begins to brown, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 59777,
      "primary_message": "In a large bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper.",
      "secondary_message": "4 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n⅜ tsp Dijon mustard\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 59776,
      "primary_message": "Wash and dry baby spinach. Add spinach and remaining tomatoes to bowl with dressing and toss.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 59775,
      "primary_message": "To serve, place pizza wedges on a plate and have with salad on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
