  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Place coconut, sprinkles, and cereal each on their own small plate. Set toppings aside. ",
      "secondary_message": "⅓ cup shredded unsweetened coconut\n⅓ cup rainbow sprinkles\n⅓ cup crispy rice cereal, cocoa flavor"
    },
    {
      "primary_message": "Peel bananas and cut in half crosswise. Place on another plate.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spread peanut butter over each banana half, then roll in topping of choice. (To make things a little easier, insert a small fork or skewer in the cut end of each banana half and hold onto that while spreading with peanut butter.) Place coated bananas on a cutting board. ",
      "secondary_message": "⅓ cup peanut butter, creamy"
    },
    {
      "primary_message": "Cut each banana half crosswise into 4 pieces of \"sushi\" and arrange on a platter. Share and enjoy!",
      "secondary_message": null
    }
  ],
