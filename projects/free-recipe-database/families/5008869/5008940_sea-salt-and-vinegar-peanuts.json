  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the parsley leaves from the stems and chop them.",
      "secondary_message": "1 tbsp parsley"
    },
    {
      "id": 1,
      "primary_message": "Combine the 3/4 cup vinegar with the peanuts in a medium bowl. Soak the peanuts for 1 hour, stirring occasionally. Drain the peanuts, then dry the peanuts by spreading them onto a sheet pan lined with paper towels.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat the oil in a large cast-iron pan over moderately high heat until shimmering. Add half of the peanuts to the pan and cook, stirring, until golden, 3 to 5 minutes. Using a slotted spoon, transfer the peanuts to another sheet pan lined with paper towels. Season with sea salt. Repeat with the remaining peanuts.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While still warm, transfer the fried peanuts to a large bowl, then drizzle in the remaining tablespoon of vinegar and the chopped parsley. Toss to combine. Season with additional sea salt and serve immediately.",
      "secondary_message": null
    }
  ],
