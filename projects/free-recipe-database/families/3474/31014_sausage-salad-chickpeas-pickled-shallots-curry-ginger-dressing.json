  "instructions": [
    {
      "id": 491065,
      "primary_message": "Place vinegar, sugar, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup white wine vinegar\n1 ½ tsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 491066,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 491067,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 491068,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausages and cook, turning occasionally, until cooked through, 12-15 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 pork sausages"
    },
    {
      "id": 491069,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ lemons\n1 ½ yellow bell peppers\n1 ½ English cucumbers\n3 tomatoes\n1 ½ heads romaine lettuce"
    },
    {
      "id": 491070,
      "primary_message": "Peel and mince ginger and garlic. Place both in a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 491071,
      "primary_message": "Juice lemons into the bowl with the ginger and garlic. Add tahini, water, curry powder, sugar, and salt, then whisk to combine the dressing.",
      "secondary_message": "⅓ cup tahini\n3 tbsp water\n1 ½ tbsp curry powder\n1 tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 491072,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the dressing and stir to coat.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 491073,
      "primary_message": "Trim, seed, and cut bell peppers into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 491074,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 491075,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 491076,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 491077,
      "primary_message": "Slice the sausages into bite-sized rounds.",
      "secondary_message": null
    },
    {
      "id": 491078,
      "primary_message": "To serve, divide salad between plates or bowls, then top with sausage and pickled shallots. Enjoy!",
      "secondary_message": null
    }
  ],
