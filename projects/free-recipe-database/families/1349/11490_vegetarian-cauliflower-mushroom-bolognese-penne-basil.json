  "instructions": [
    {
      "id": 206312,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 3 cups of pasta cooking water before draining.)",
      "secondary_message": "1 tbsp salt\n15 oz penne pasta"
    },
    {
      "id": 206313,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb cremini mushrooms\n1 ½ medium heads cauliflower\n1 small pkg fresh basil"
    },
    {
      "id": 206314,
      "primary_message": "Mince mushrooms and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 206315,
      "primary_message": "Peel and small dice onions.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 206316,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 206317,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add mushrooms, onion, and salt to the pot; cook, stirring often, until veggies brown and soften, about 10 minutes.",
      "secondary_message": "⅓ cup butter, unsalted\n2 ½ tsp salt"
    },
    {
      "id": 206318,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate each cauliflower and transfer to the bowl used for the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 206319,
      "primary_message": "Peel and mince garlic; add to the bowl with the cauliflower.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 206320,
      "primary_message": "Add tomato paste, rosemary, and crushed red pepper to the bowl.",
      "secondary_message": "18 tbsp tomato paste\n1 tbsp rosemary\n½ tsp crushed red pepper"
    },
    {
      "id": 206321,
      "primary_message": "Add cauliflower mixture to the pot with the mushrooms and stir to combine. Reduce heat to medium and continue to cook, stirring often, until cauliflower is soft and tomato paste becomes fragrant, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 206322,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "4 ½ oz Parmesan cheese"
    },
    {
      "id": 206323,
      "primary_message": "Add pasta, reserved cooking water, and Parmesan to the pot with the veggies (reserving some cheese for garnish); stir to combine. Continue to cook, stirring often, until the sauce thickens, 4-5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 206324,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Stir basil into the pasta (reserving some for garnish).",
      "secondary_message": null
    },
    {
      "id": 206325,
      "primary_message": "To serve, divide pasta between bowls or plates; garnish with reserved Parmesan and basil. Enjoy!",
      "secondary_message": null
    }
  ],
