  "instructions": [
    {
      "id": 206508,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 2 cups of pasta cooking water before draining.)",
      "secondary_message": "2 tsp salt\n283 g penne pasta"
    },
    {
      "id": 206509,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.45 kg cremini mushrooms\n1 medium head cauliflower\n1 small pkg fresh basil"
    },
    {
      "id": 206510,
      "primary_message": "Mince mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 206511,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 206512,
      "primary_message": "While the skillet heats up, peel and small dice onion.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 206513,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, onion, and salt to the skillet; cook, stirring often, until veggies brown and soften, 8-10 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 206514,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to the bowl used for the mushrooms.",
      "secondary_message": null
    },
    {
      "id": 206515,
      "primary_message": "Peel and mince garlic; add to the bowl with the cauliflower.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 206516,
      "primary_message": "Add tomato paste, rosemary, and crushed red pepper to the bowl.",
      "secondary_message": "12 tbsp tomato paste\n2 tsp rosemary\n¼ tsp crushed red pepper"
    },
    {
      "id": 206517,
      "primary_message": "Add cauliflower mixture to the skillet with the mushrooms and stir to combine. Reduce heat to medium and continue to cook, stirring often, until cauliflower is soft and tomato paste becomes fragrant, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 206518,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 206519,
      "primary_message": "Add pasta, reserved cooking water, and beans to the skillet; stir to combine. Continue to cook, stirring often, until the sauce thickens, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 206520,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Stir basil into the pasta (reserving some for garnish).",
      "secondary_message": null
    },
    {
      "id": 206521,
      "primary_message": "To serve, divide pasta between bowls or plates and garnish with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
