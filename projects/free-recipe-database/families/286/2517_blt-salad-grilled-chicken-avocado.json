  "instructions": [
    {
      "id": 24402,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 24403,
      "primary_message": "Slice the chicken in half horizontally to form thin fillets. Rub both sides with olive oil and season with salt and pepper.",
      "secondary_message": "0.34 kg chicken breasts, boneless skinless\n1 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 24404,
      "primary_message": "Place the chicken and bacon on the grill or skillet. Cook until chicken is golden brown and cooked through and bacon is crispy, 3-4 minutes per side.",
      "secondary_message": "4 slices bacon\r\n"
    },
    {
      "id": 24405,
      "primary_message": "Peel and mince the garlic. In a small bowl, prepare the dressing by whisking together the minced garlic, lemon juice, mayo, olive oil, salt, and pepper. Set aside.",
      "secondary_message": "1 clove garlic\r\njuice of ½ lemon\r\n1 tbsp mayonnaise\r\n2 tbsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 24406,
      "primary_message": "Wash the fresh produce.",
      "secondary_message": "1 avocado\n½ small pkg grape tomatoes\n½ head romaine lettuce"
    },
    {
      "id": 24407,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Halve the tomatoes. Chop the lettuce crosswise into 2 ½ cm strips.",
      "secondary_message": ""
    },
    {
      "id": 24408,
      "primary_message": "Slice the chicken into strips and chop or crumble the bacon.",
      "secondary_message": ""
    },
    {
      "id": 24409,
      "primary_message": "To serve, arrange a bed of lettuce on a plate, top with tomatoes, avocado slices, chicken, and bacon. Drizzle with dressing and enjoy!",
      "secondary_message": ""
    }
  ],
