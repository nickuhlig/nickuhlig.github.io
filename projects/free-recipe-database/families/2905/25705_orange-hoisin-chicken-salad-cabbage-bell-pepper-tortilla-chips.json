  "instructions": [
    {
      "id": 411116,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)\n1 red bell pepper\n2 oranges"
    },
    {
      "id": 411117,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with stir-fry and hoisin sauces. Whisk to combine the dressing.",
      "secondary_message": "¼ cup stir-fry sauce\n1 tbsp hoisin sauce"
    },
    {
      "id": 411118,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 411119,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 411120,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl along with the shredded cabbage.",
      "secondary_message": "½ (14 oz) bag shredded cabbage (coleslaw mix)"
    },
    {
      "id": 411121,
      "primary_message": "Place chicken on the cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Add to the bowl.",
      "secondary_message": "½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 411122,
      "primary_message": "Crush tortilla chips into small pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": "2 oz tortilla chips"
    },
    {
      "id": 411123,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
