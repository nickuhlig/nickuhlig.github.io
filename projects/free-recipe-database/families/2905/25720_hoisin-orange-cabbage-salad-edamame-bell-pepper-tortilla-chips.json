  "instructions": [
    {
      "id": 411188,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ small bunch green onions (scallions)\n1 red bell pepper\n2 oranges"
    },
    {
      "id": 411189,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with stir-fry and hoisin sauces. Whisk to combine the dressing.",
      "secondary_message": "¼ cup stir-fry sauce\n2 tbsp hoisin sauce"
    },
    {
      "id": 411190,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 411191,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 411192,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 411193,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl along with the shredded cabbage.",
      "secondary_message": "2 cups edamame\n½ (397 g) bag shredded cabbage (coleslaw mix)"
    },
    {
      "id": 411194,
      "primary_message": "Crush tortilla chips into small pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": "57 g tortilla chips"
    },
    {
      "id": 411195,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
