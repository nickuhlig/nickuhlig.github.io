  "instructions": [
    {
      "id": 411132,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n3 red bell peppers\n6 oranges"
    },
    {
      "id": 411133,
      "primary_message": "Peel and mince ginger. Place in a large bowl along with stir-fry and hoisin sauces. Whisk to combine the dressing.",
      "secondary_message": "¾ cup stir-fry sauce\n3 tbsp hoisin sauce"
    },
    {
      "id": 411134,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 411135,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 411136,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl along with the shredded cabbage.",
      "secondary_message": "1 ½ (14 oz) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 411137,
      "primary_message": "Place chickens on the cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Add to the bowl.",
      "secondary_message": "1 ½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 411138,
      "primary_message": "Crush tortilla chips into small pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": "6 oz tortilla chips"
    },
    {
      "id": 411139,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
