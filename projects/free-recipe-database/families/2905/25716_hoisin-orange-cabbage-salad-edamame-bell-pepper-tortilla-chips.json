  "instructions": [
    {
      "id": 411108,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)\n3 red bell peppers\n6 oranges"
    },
    {
      "id": 411109,
      "primary_message": "Peel and mince ginger. Place in a large bowl along with stir-fry and hoisin sauces. Whisk to combine the dressing.",
      "secondary_message": "¾ cup stir-fry sauce\n⅓ cup hoisin sauce"
    },
    {
      "id": 411110,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 411111,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 411112,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 411113,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl along with the shredded cabbage.",
      "secondary_message": "6 cups edamame\n1 ½ (397 g) bags shredded cabbage (coleslaw mix)"
    },
    {
      "id": 411114,
      "primary_message": "Crush tortilla chips into small pieces. Add to the bowl and toss to combine the salad.",
      "secondary_message": "170 g tortilla chips"
    },
    {
      "id": 411115,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
