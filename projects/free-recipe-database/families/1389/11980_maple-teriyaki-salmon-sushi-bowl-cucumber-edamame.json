  "instructions": [
    {
      "id": 502809,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 502810,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 502811,
      "primary_message": "Place maple syrup, soy sauce, oil, vinegar, and garlic powder in a medium bowl; whisk to combine the marinade.",
      "secondary_message": "2 tbsp pure maple syrup\n4 tsp soy sauce\n2 tsp toasted sesame oil\n2 tsp rice vinegar\n¼ tsp garlic powder"
    },
    {
      "id": 502812,
      "primary_message": "If using salmon with skin, place the fillet, skin-side down, on a cutting board. Holding the tail end firmly, use a knife to cut between the flesh and skin; continue to cut through the length of the fillet (take care not to cut through the skin); discard the skin. If you don’t have a tail end, start at one corner of the fillet and work your way in until the knife is between the skin and flesh.",
      "secondary_message": "⅓ kg salmon fillet"
    },
    {
      "id": 502813,
      "primary_message": "Cut salmon into bite-size pieces. Add to the bowl with the marinade and gently toss to coat. Set aside for 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 502814,
      "primary_message": "Meanwhile, wash and dry cucumber. Trim and cut into thin sticks.",
      "secondary_message": "½ English cucumber"
    },
    {
      "id": 502815,
      "primary_message": "Place edamame in a colander and rinse under hot water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "½ cup edamame, shelled"
    },
    {
      "id": 502816,
      "primary_message": "When the salmon is done marinating, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 502817,
      "primary_message": "Once the skillet is hot, add salmon and all of the marinade. Cook, stirring occasionally, until sauce thickens and salmon is opaque and flaky, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 502818,
      "primary_message": "Place vinegar, maple syrup, and salt in a small bowl; whisk to combine. When the rice is done, pour the mixture over it and stir to combine.",
      "secondary_message": "1 tbsp rice vinegar\n½ tsp pure maple syrup\n¼ tsp salt"
    },
    {
      "id": 502819,
      "primary_message": "To serve, divide rice between bowls and top with cucumber, edamame, and salmon. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "2 tsp sesame seeds"
    }
  ],
