  "instructions": [
    {
      "id": 200945,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and milk; bring the mixture to a simmer over medium-high heat.",
      "secondary_message": "1 ½ cups basmati rice\n18 fl oz (2 ¼ cups) chicken or vegetable broth\n12 fl oz (1 ½ cups) whole milk"
    },
    {
      "id": 200946,
      "primary_message": "Meanwhile, coarsely grate cheese, transfer to a medium bowl, and set aside.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 200947,
      "primary_message": "Once the liquid comes to a simmer, stir the mixture, cover the saucepan, and reduce heat to low. Cook until liquid is partially absorbed and the rice is tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 200948,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and set aside.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 200949,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 200950,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 200951,
      "primary_message": "Once the pot is hot, add butter, honey, and chili-garlic sauce; whisk to combine.",
      "secondary_message": "⅓ cup butter, unsalted\n3 tbsp honey\n3 tbsp chili-garlic sauce"
    },
    {
      "id": 200952,
      "primary_message": "Working in batches if necessary, add shrimp to the pot and cook until opaque, 1-2 minutes per side. Once done, transfer shrimp and butter sauce to a large bowl; cover with foil. ",
      "secondary_message": null
    },
    {
      "id": 200953,
      "primary_message": "When the rice is tender, with some liquid remaining, add the cheese and stir to combine. Remove from the heat and let stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 200954,
      "primary_message": "Return the pot to medium-high heat, add more butter, and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 200955,
      "primary_message": "Add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Season with salt and pepper; cook, stirring often, until soft, 5-6 minutes.",
      "secondary_message": "¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 200956,
      "primary_message": "To serve, divide rice, kale, and shrimp between bowls. Drizzle with honey butter and enjoy!",
      "secondary_message": null
    }
  ],
