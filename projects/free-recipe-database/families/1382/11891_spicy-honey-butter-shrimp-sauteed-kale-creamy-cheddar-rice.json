  "instructions": [
    {
      "id": 201008,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and milk; bring the mixture to a simmer over medium-high heat.",
      "secondary_message": "1 cup basmati rice\n355 ml chicken or vegetable broth\n237 ml whole milk"
    },
    {
      "id": 201009,
      "primary_message": "Meanwhile, coarsely grate cheese, transfer to a small bowl, and set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 201010,
      "primary_message": "Once the liquid comes to a simmer, stir the mixture, cover the saucepan, and reduce heat to low. Cook until liquid is partially absorbed and the rice is tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 201011,
      "primary_message": "Meanwhile, wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and set aside.",
      "secondary_message": "2 bunches kale"
    },
    {
      "id": 201012,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 201013,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 201014,
      "primary_message": "Once the skillet is hot, add butter, honey, and chili-garlic sauce; whisk to combine.",
      "secondary_message": "¼ cup butter, unsalted\n2 tbsp honey\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 201015,
      "primary_message": "Working in batches if necessary, add shrimp to the skillet and cook until opaque, 1-2 minutes per side. Once done, transfer shrimp and butter sauce to a medium bowl; cover with foil. ",
      "secondary_message": null
    },
    {
      "id": 201016,
      "primary_message": "When the rice is tender, with some liquid remaining, add the cheese and stir to combine. Remove from the heat and let stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 201017,
      "primary_message": "Return the skillet to medium-high heat, add more butter, and swirl to coat the bottom. ",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 201018,
      "primary_message": "Add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Season with salt and pepper; cook, stirring often, until soft, 4-5 minutes.",
      "secondary_message": "½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 201019,
      "primary_message": "To serve, divide rice, kale, and shrimp between bowls. Drizzle with honey butter and enjoy!",
      "secondary_message": null
    }
  ],
