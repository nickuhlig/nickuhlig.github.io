  "instructions": [
    {
      "id": 1,
      "primary_message": "Set rack in middle level of the oven and preheat to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a bowl, combine flour, baking powder, and salt; stir well to mix.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In another bowl, whisk eggs by hand until well mixed. Add sugar and whisk until smooth. Whisk in extract and oil.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Fold flour mixture into egg mixture until all flour is absorbed. Fold in nuts, raisins, and chocolate chips.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "On a lightly floured surface, press dough together. Divide dough in half and roll each half into a log the length of your pan (36 to 46 cm). Place each log on pan and flatten slightly. Bake until well-risen and firm, about 25-30 minutes. Cool the logs on the pans and racks.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Reset racks in upper and lower thirds of oven. Using sharp serrated knife, slice baked logs diagonally about every 1.5 cm. Place cinnamon-sugar mixture in a shallow dish and turn the cut cookies in it. Return biscotti to the pans, cut side down, and bake until dry and crisp, up to 20 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Store cooled cookies between sheets of parchment or wax paper in tin or plastic container with tight-fitting container.",
      "secondary_message": null
    }
  ],
