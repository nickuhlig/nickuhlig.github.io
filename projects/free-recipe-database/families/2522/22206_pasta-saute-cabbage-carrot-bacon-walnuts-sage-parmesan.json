  "instructions": [
    {
      "id": 372004,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ¾-cup cooking water before draining and set aside.)",
      "secondary_message": "1 ½ tsp salt\n15 oz rotini pasta"
    },
    {
      "id": 372005,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small heads red cabbage\n3 medium carrots\n1 small pkg fresh sage"
    },
    {
      "id": 372006,
      "primary_message": "Halve each cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 372007,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl with the cabbage and set aside.",
      "secondary_message": null
    },
    {
      "id": 372008,
      "primary_message": "Small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 372009,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 372010,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, remove bacon to a paper towel-lined plate. (Reserve pot with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 372011,
      "primary_message": "While the bacon is cooking, using a clean cutting board, peel, halve and mince onion. Peel and mince garlic.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 372012,
      "primary_message": "Return the pot (with drippings) to medium heat, add oil, and swirl to coat the bottom. Add cabbage, carrot, onion, and garlic; cook, stirring occasionally, until cabbage is tender, about 6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 372013,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 372014,
      "primary_message": "Pick sage leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 372015,
      "primary_message": "When the cabbage is done, add pasta, reserved pasta water, Parmesan, sage, vinegar, salt, and pepper to the pot. Continue to cook, stirring occasionally, until water has evaporated and Parmesan has melted, about 3 minutes. Remove from heat. ",
      "secondary_message": "3 tbsp apple cider vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 372016,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "id": 372017,
      "primary_message": "To serve, divide pasta between plates or bowls; top with crispy bacon and walnuts. Enjoy!",
      "secondary_message": null
    }
  ],
