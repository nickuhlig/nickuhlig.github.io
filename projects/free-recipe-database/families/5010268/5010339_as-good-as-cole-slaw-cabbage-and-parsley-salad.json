  "instructions": [
    {
      "id": 1,
      "primary_message": "Core the cabbage and slice into 6 wedges. Feed through the food processor, fitted with the thin slicing disk. Feed the parsley in after it.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk together the crème fraîche, mustard, anchovy paste, olive oil, vinegar, chives, and capers until combined. Season liberally with salt and pepper. Add the shredded cabbage and parsley, and toss to thoroughly combine. Cover with plastic wrap and refrigerate for 1 hour. Serve.",
      "secondary_message": null
    }
