  "instructions": [
    {
      "id": 1,
      "primary_message": "Cut the chicken 1/2 cubes. Mix with the marinade ingredients and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat wok over high heat. Add 1/3 cup oil and place all of the chicken into the oil, stirring gently to fry the meat. Cook until chicken is lightly browned, then remove the chicken from the oil and set aside. Pour off a few tablespoons of the oil; leave about 3 tablespoons left in the wok.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat the wok over high heat until it's almost smoking. When the oil is hot but not smoking, add the chiles and Sichuan pepper and stir-fry for a few seconds until they are fragrant, taking care not to burn them.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add the green bell peppers to the wok and stir-fry until they are tender-crisp.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add the chicken back to the wok and continue to stir-fry for 30 seconds, until the ingredients are well-combined. Serve immediately.",
      "secondary_message": null
    }
  ],
