  "instructions": [
    {
      "id": 447645,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 447646,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb Brussels sprouts\n1 orange\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 447647,
      "primary_message": "Trim and halve sprouts lengthwise. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper; toss to coat and spread out in a single layer. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 447648,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sprouts are golden and fork-tender, 15-18 minutes. Remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 447649,
      "primary_message": "Meanwhile, cut off skin and white pith from the orange; slice between the membranes to release segments. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 447650,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the orange and set aside.",
      "secondary_message": null
    },
    {
      "id": 447651,
      "primary_message": "Place bread crumbs and spices in a small bowl; stir to combine and set aside.",
      "secondary_message": "½ cup panko bread crumbs\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 447652,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. ",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 447653,
      "primary_message": "Transfer chicken to a plate, spread half of the mayo over the top side, and sprinkle with half of the bread crumbs (pressing gently to adhere). Carefully flip chicken and repeat with remaining mayo and bread crumbs. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp mayonnaise"
    },
    {
      "id": 447654,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 447655,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a clean plate, loosely cover with aluminum foil, and set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 447656,
      "primary_message": "Meanwhile, place yogurt, mayo, water, and spices in the reserved bowl. Stir to combine the sauce and set aside. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tbsp water\n¼ tsp garlic powder\n¼ tsp smoked paprika\n⅛ tsp salt"
    },
    {
      "id": 447657,
      "primary_message": "Add cooled sprouts and vinegar to the bowl with the orange and parsley. Stir to combine the salad. ",
      "secondary_message": "1 tbsp balsamic vinegar"
    },
    {
      "id": 447658,
      "primary_message": "To serve, divide salad and yogurt sauce between plates; top sauce with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
