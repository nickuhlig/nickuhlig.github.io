  "instructions": [
    {
      "id": 447827,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 447828,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 447829,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg Brussels sprouts\n2 oranges\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 447830,
      "primary_message": "Trim and halve sprouts lengthwise. Transfer to another baking sheet, drizzle with oil, then season with salt and pepper; toss to coat and spread out in a single layer. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 447831,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sprouts are golden and fork-tender, 15-18 minutes. Remove from oven and let cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 447832,
      "primary_message": "Meanwhile, cut off skin and white pith from the oranges; slice between the membranes to release segments. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 447833,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the orange and set aside.",
      "secondary_message": null
    },
    {
      "id": 447834,
      "primary_message": "Place bread crumbs and spices in a small bowl; stir to combine and set aside.",
      "secondary_message": "1 cup panko bread crumbs\n2 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 447835,
      "primary_message": "Cut the tofu planks in half crosswise and return to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 447836,
      "primary_message": "Spread half of the mayo over the top side of the tofu and sprinkle with half of the bread crumbs (pressing gently to adhere). Carefully flip tofu and repeat with remaining mayo and bread crumbs. Drizzle with oil. (Reserve bowl for later use.)",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 447837,
      "primary_message": "Add baking sheet to the oven and roast until breading is golden brown and tofu is warmed through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 447838,
      "primary_message": "Meanwhile, place yogurt, mayo, water, and spices in the reserved bowl. Stir to combine the sauce and set aside. ",
      "secondary_message": "⅔ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tbsp water\n½ tsp garlic powder\n½ tsp smoked paprika\n¼ tsp salt"
    },
    {
      "id": 447839,
      "primary_message": "Add cooled sprouts and vinegar to the bowl with the orange and parsley. Stir to combine the salad.",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 447840,
      "primary_message": "To serve, divide salad and yogurt sauce between plates; top sauce with tofu. Enjoy!",
      "secondary_message": null
    }
  ],
