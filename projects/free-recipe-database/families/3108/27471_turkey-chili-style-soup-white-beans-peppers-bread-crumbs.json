  "instructions": [
    {
      "id": 441777,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 red bell peppers\n3 sticks celery\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 441778,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 441779,
      "primary_message": "Small dice celery. Add to the bowl with the bell peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 441780,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 441781,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 ¼ lb ground turkey\n2 tbsp chili powder\n2 ½ tsp garlic powder\n2 tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 441782,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 441783,
      "primary_message": "When the turkey is done, add veggies to the pot; cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 441784,
      "primary_message": "Add beans, broth, tomatoes, and hot sauce to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n3 (14.5 oz) cans diced tomatoes\n2 tbsp hot sauce"
    },
    {
      "id": 441785,
      "primary_message": "While the soup is cooking, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 441786,
      "primary_message": "While the skillet heats up, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 441787,
      "primary_message": "Once the skillet is hot, add bread crumbs and cook, stirring frequently, until golden brown, about 4 minutes. Transfer toasted bread crumbs to the bowl with the parsley and stir to combine.",
      "secondary_message": "1 cup panko bread crumbs"
    },
    {
      "id": 441788,
      "primary_message": "To serve, divide soup between bowls and top with parsley bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
