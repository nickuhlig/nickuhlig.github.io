  "instructions": [
    {
      "id": 441933,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 red bell pepper\n1 stick celery\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 441934,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 441935,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 441936,
      "primary_message": "While the pan heats up, small dice celery. Add to the bowl with the bell peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 441937,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g veggie ground, plant based\n2 tsp chili powder\n¾ tsp garlic powder\n¾ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 441938,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 441939,
      "primary_message": "When the veggie ground is done, add vegetables to the pan; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 441940,
      "primary_message": "Add beans, broth, tomatoes, and hot sauce to the pan; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until beans are tender, about 10 minutes. Remove from heat.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n2 tsp hot sauce"
    },
    {
      "id": 441941,
      "primary_message": "While the soup is cooking, preheat a skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 441942,
      "primary_message": "While the skillet heats up, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 441943,
      "primary_message": "Once the skillet is hot, add bread crumbs and cook, stirring frequently, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to the bowl with the parsley and stir to combine.",
      "secondary_message": "⅓ cup panko bread crumbs"
    },
    {
      "id": 441944,
      "primary_message": "To serve, divide soup between bowls and top with parsley bread crumbs. Enjoy!",
      "secondary_message": null
    }
  ],
