  "instructions": [
    {
      "primary_message": "Add salmon to a food processor bowl and pulse 10-12 times until broken down into ⅛-inch pieces. Transfer to a bowl and stir to combine with the egg, bread crumbs, Kinder's® seasoning, 1 tablespoon ranch dressing, lime zest and green onions.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide mixture into 4 patties and place on a parchment lined plate. Cover and refrigerate for 10-15 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Heat oil in a large skillet over medium heat. Add the salmon patties, cooking until golden brown about 3 minutes on each side.",
      "secondary_message": null
    },
    {
      "primary_message": "Fill each bun with lettuce, tomato, and salmon patties, then top with 1 tablespoon ranch dressing and red onion. Serve with remaining ranch dressing on the side. ",
      "secondary_message": null
    }
  ],
