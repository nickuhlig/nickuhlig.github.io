  "instructions": [
    {
      "id": 362882,
      "primary_message": "Preheat oven to 450°F. Coat a large baking dish with a thin layer of oil and set aside. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 362883,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 red bell peppers\n1 ½ English cucumbers\n1 small bunch green onions (scallions)"
    },
    {
      "id": 362884,
      "primary_message": "Peel and mince ginger; place in a large bowl along with miso, dressing, water, and oil. Whisk to combine the glaze. ",
      "secondary_message": "⅓ cup miso paste, white\n⅓ cup honey mustard dressing\n⅓ cup water\n1 tbsp toasted sesame oil"
    },
    {
      "id": 362885,
      "primary_message": "Pat salmon dry with paper towels, place in the baking dish, and drizzle with half of the glaze. (Reserve bowl with remaining glaze for later use.)",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 362886,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 362887,
      "primary_message": "Meanwhile, add additional dressing and oil to the bowl with the remaining glaze; whisk to combine.",
      "secondary_message": "⅓ cup honey mustard dressing\n1 tbsp toasted sesame oil"
    },
    {
      "id": 362888,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 362889,
      "primary_message": "Trim and medium dice cucumbers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 362890,
      "primary_message": "Trim and cut green onions crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 362891,
      "primary_message": "Add broccoli slaw and almonds to the bowl, then toss to combine.",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw\n⅓ cup almonds, sliced"
    },
    {
      "id": 362892,
      "primary_message": "To serve, divide salmon and slaw between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
