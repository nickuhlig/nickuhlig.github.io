  "instructions": [
    {
      "id": 448063,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 448064,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n3 red bell peppers\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 448065,
      "primary_message": "Halve grape tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 448066,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 448067,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448068,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 448069,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tomatoes, bell pepper, garlic, and spices to the skillet. Cook, stirring occasionally, until tomatoes are starting to burst, 8-10 minutes. (Reserve bowl for later use.)",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp smoked paprika\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 448070,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 448071,
      "primary_message": "Halve olives lengthwise.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 448072,
      "primary_message": "When the veggies are done, add beans, olives, broth, and vinegar to the skillet, then stir to combine. Place skillet in the oven and bake until beans are tender and sauce has thickened slightly, 20-25 minutes. Remove from oven.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 tbsp rice vinegar"
    },
    {
      "id": 448073,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 448074,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the parsley along with oil, vinegar, oregano, and salt. Stir to combine the chimichurri and set aside.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n1 tbsp rice vinegar\n¾ tsp oregano, dried\n¾ tsp salt"
    },
    {
      "id": 448075,
      "primary_message": "When the beans have about 5 minutes left, cut flatbread into wedges and arrange on a large baking sheet pan. Add to the oven and bake until warmed through and slightly golden, 4-5 minutes. Remove from oven.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 448076,
      "primary_message": "To serve, divide beans and flatbread wedges between plates or bowls. Drizzle beans with chimichurri and enjoy!",
      "secondary_message": null
    }
  ],
