  "instructions": [
    {
      "id": 383896,
      "primary_message": "Preheat oven to 230°C (450°F). Line two large baking sheet pans with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 383897,
      "primary_message": "Wash, dry, and halve potatoes; transfer to one baking sheet. Drizzle with oil, then season with salt and pepper. Toss to coat and spread out on the baking sheet.",
      "secondary_message": "0.68 kg new potatoes\n1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 383898,
      "primary_message": "Coat the other baking sheet with a thin layer of oil. Arrange chicken on the baking sheet and drizzle with barbecue sauce.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1.7 kg chicken drumsticks\n¾ cup barbecue sauce"
    },
    {
      "id": 383899,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing potatoes and flipping chicken halfway through, until potatoes are fork-tender and chicken is cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 383900,
      "primary_message": "When the chicken is almost done, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 383901,
      "primary_message": "Once the skillet is hot, add additional oil and swirl to coat the bottom. Add broccoli and salt to the skillet; cook, stirring occasionally, until tender-crisp, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ (510 g) bags broccoli florets\n¾ tsp salt"
    },
    {
      "id": 383902,
      "primary_message": "To serve, divide chicken, potatoes, and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
