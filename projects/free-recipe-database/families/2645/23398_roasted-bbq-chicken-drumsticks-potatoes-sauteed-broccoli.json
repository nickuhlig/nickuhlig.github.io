  "instructions": [
    {
      "id": 383882,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make clean-up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 383883,
      "primary_message": "Wash, dry, and halve potatoes; transfer to the baking sheet. Drizzle with oil, then season with salt and pepper. Toss to coat and spread out on one half of the baking sheet.",
      "secondary_message": "0.23 kg new potatoes\n1 ½ tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 383884,
      "primary_message": "Coat the other half of the baking sheet with a thin layer of oil. Arrange chicken on the oiled half of the baking sheet and drizzle with barbecue sauce.",
      "secondary_message": "½ tsp extra virgin olive oil\n0.57 kg chicken drumsticks\n¼ cup barbecue sauce"
    },
    {
      "id": 383885,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing potatoes and flipping chicken halfway through, until potatoes are fork-tender and chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 383886,
      "primary_message": "When the chicken is almost done, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 383887,
      "primary_message": "Once the skillet is hot, add additional oil and swirl to coat the bottom. Add broccoli and salt to the skillet; cook, stirring occasionally, until tender-crisp, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ (510 g) bag broccoli florets\n¼ tsp salt"
    },
    {
      "id": 383888,
      "primary_message": "To serve, divide chicken, potatoes, and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
