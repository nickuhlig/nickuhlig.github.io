  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In medium bowl, combine shortbread crumbs, 1/4 cup brown sugar, almonds, butter, and 1/4 teaspoon salt. Press into bottom and up sides of tart pan. Bake until light golden, about 15 minutes. Transfer to cooling rack and cool completely, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, bring 3/4 cup cherries, 1/2 cup Amaretto, sugar, and 1/8 teaspoon salt to boil in small saucepan over high heat. Reduce heat to medium and simmer until thick and syrupy, 8 to 10 minutes. Transfer to large bowl and cool slightly, about 5 minutes. Add remaining fresh cherries and toss to coat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Combine water and gelatin in small bowl. Microwave until gelatin dissolves, about 20 seconds. Cool to room temperature, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "In medium bowl, whisk together mascarpone, remaining 2 tablespoons brown sugar, remaining 1/4 cup Amaretto, vanilla, remaining 1/8 teaspoon salt, and cooled gelatin mixture until smooth.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Spread mascarpone mixture in cooled tart shell and top with cherry mixture.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Chill at least 30 minutes before serving.",
      "secondary_message": null
    }
  ],
