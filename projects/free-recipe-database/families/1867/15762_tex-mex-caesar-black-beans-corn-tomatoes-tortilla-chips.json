  "instructions": [
    {
      "id": 258874,
      "primary_message": "Preheat oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 258875,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 pint grape tomatoes\n2 heads romaine lettuce"
    },
    {
      "id": 258876,
      "primary_message": "Place corn in a colander. Drain beans in the colander with the corn, rinse under hot water (from the tap) to thaw, and set aside to drain further.",
      "secondary_message": "1 cup frozen corn\n2 (15 oz) cans black beans"
    },
    {
      "id": 258877,
      "primary_message": "Meanwhile, cut each tortilla into bite-sized strips and place on a large baking sheet pan. Drizzle with oil, season with chili powder and salt, and toss to coat; spread out in a single layer. Place in the oven and bake, flipping once, until golden and crispy, 10-12 minutes. Remove from oven.",
      "secondary_message": "8 small corn tortillas\n4 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 258878,
      "primary_message": "While the tortilla chips are baking, finely grate Parmesan and place in a large bowl.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 258879,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 258880,
      "primary_message": "Juice lime into the bowl; add yogurt, oil, soy sauce, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n2 tsp soy sauce\n1 tsp Dijon mustard\n½ tsp oregano, dried\n½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 258881,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258882,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 258883,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 258884,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl along with the corn and beans. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258885,
      "primary_message": "To serve, divide salad between plates or bowls. Top with tortilla chips and enjoy!",
      "secondary_message": null
    }
  ],
