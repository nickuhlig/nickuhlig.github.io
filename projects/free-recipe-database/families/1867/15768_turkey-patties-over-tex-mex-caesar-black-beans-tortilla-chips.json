  "instructions": [
    {
      "id": 258949,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 258950,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 lime\n1 small pkg grape tomatoes\n2 heads romaine lettuce"
    },
    {
      "id": 258951,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Trim and mince green onions; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 258952,
      "primary_message": "Peel and mince garlic; add to the bowl with the herbs along with turkey and spices. Mix with your hands until well combined.",
      "secondary_message": "2 cloves garlic\n0.68 kg ground turkey\n1 tsp chili powder\n½ tsp salt\n½ tsp oregano, dried"
    },
    {
      "id": 258953,
      "primary_message": "Using a ⅓-cup measure, form turkey mixture into ½-inch thick patties. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 258954,
      "primary_message": "Preheat a grill pan or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258955,
      "primary_message": "While the grill pan heats up, place corn in a colander. Drain beans in the colander with the corn, rinse under hot water (from the tap) to thaw, and set aside to drain further.",
      "secondary_message": "⅔ cup frozen corn\n1 (398 ml) can black beans"
    },
    {
      "id": 258956,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add turkey patties to the pan and cook, flipping once, until golden and cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 258957,
      "primary_message": "Meanwhile, cut each tortilla into bite-sized strips and place on a baking sheet pan. Drizzle with oil, season with chili powder and salt, and toss to coat; spread out in a single layer. Place in the oven and bake, flipping once, until golden and crispy, 10-12 minutes. Remove from oven and set aside.",
      "secondary_message": "4 small corn tortillas\n2 tsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 258958,
      "primary_message": "While the tortilla chips are baking, finely grate Parmesan; place in a large bowl.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 258959,
      "primary_message": "Peel and mince additional garlic; add to bowl with the Parmesan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 258960,
      "primary_message": "Juice lime into the bowl; add yogurt, oil, Worcestershire, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tbsp extra virgin olive oil\n2 tsp Worcestershire sauce\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 258961,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258962,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl along with the corn and beans. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258963,
      "primary_message": "To serve, divide salad between plates or bowls; top with turkey patties and tortilla chips. Enjoy!",
      "secondary_message": null
    }
  ],
