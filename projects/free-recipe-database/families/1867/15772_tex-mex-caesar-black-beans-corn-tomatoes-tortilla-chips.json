  "instructions": [
    {
      "id": 259003,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 259004,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 ½ small pkgs grape tomatoes\n3 heads romaine lettuce"
    },
    {
      "id": 259005,
      "primary_message": "Place corn in a colander. Drain beans in the colander with the corn, rinse under hot water (from the tap) to thaw, and set aside to drain further.",
      "secondary_message": "1 ½ cups frozen corn\n3 (398 ml) cans black beans"
    },
    {
      "id": 259006,
      "primary_message": "Meanwhile, cut each tortilla into bite-sized strips and divide between two baking sheet pans. Drizzle with oil, season with chili powder and salt, and toss to coat; spread out in a single layer. Place in the oven and bake, flipping once, until golden and crispy, 12-15 minutes. Remove from oven.",
      "secondary_message": "12 small corn tortillas\n2 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp salt"
    },
    {
      "id": 259007,
      "primary_message": "While the tortilla chips are baking, finely grate Parmesan and place in a large bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 259008,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 259009,
      "primary_message": "Juice limes into the bowl; add yogurt, oil, soy sauce, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n1 tbsp soy sauce\n1 ½ tsp Dijon mustard\n¾ tsp oregano, dried\n¾ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 259010,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 259011,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259012,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 259013,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl along with the corn and beans. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 259014,
      "primary_message": "To serve, divide salad between plates or bowls. Top with tortilla chips and enjoy!",
      "secondary_message": null
    }
  ],
