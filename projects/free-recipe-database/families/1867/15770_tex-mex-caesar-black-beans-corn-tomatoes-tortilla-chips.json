  "instructions": [
    {
      "id": 258979,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 258980,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ small bunch cilantro\n½ small bunch green onions (scallions)\n½ small pkg grape tomatoes\n1 head romaine lettuce"
    },
    {
      "id": 258981,
      "primary_message": "Place corn in a colander. Drain beans in the colander with the corn, rinse under hot water (from the tap) to thaw, and set aside to drain further.",
      "secondary_message": "½ cup frozen corn\n1 (398 ml) can black beans"
    },
    {
      "id": 258982,
      "primary_message": "Meanwhile, cut each tortilla into bite-sized strips and place on a baking sheet pan. Drizzle with oil, season with chili powder and salt, and toss to coat; spread out in a single layer. Place in the oven and bake, flipping once, until golden and crispy, 10-12 minutes. Remove from oven and set aside.",
      "secondary_message": "4 small corn tortillas\n2 tsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 258983,
      "primary_message": "While the tortilla chips are baking, finely grate Parmesan and place in a medium bowl.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 258984,
      "primary_message": "Peel and mince garlic; add to bowl with the Parmesan.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 258985,
      "primary_message": "Juice lime into the bowl; add yogurt, oil, soy sauce, Dijon, and spices. Whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tbsp extra virgin olive oil\n1 tsp soy sauce\n½ tsp Dijon mustard\n¼ tsp oregano, dried\n¼ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 258986,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258987,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces at an angle; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 258988,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 258989,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl along with the corn and beans. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258990,
      "primary_message": "To serve, divide salad between plates or bowls. Top with tortilla chips and enjoy!",
      "secondary_message": null
    }
  ],
