  "instructions": [
    {
      "id": 258964,
      "primary_message": "Preheat oven to 175°C (350°F).",
      "secondary_message": null
    },
    {
      "id": 258965,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 ½ limes\n1 ½ small pkgs grape tomatoes\n3 heads romaine lettuce"
    },
    {
      "id": 258966,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Trim and mince green onions; place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 258967,
      "primary_message": "Peel and mince garlic; add to the bowl with the herbs along with turkey and spices. Mix with your hands until well combined.",
      "secondary_message": "3 cloves garlic\n1.02 kg ground turkey\n1 ½ tsp chili powder\n¾ tsp salt\n¾ tsp oregano, dried"
    },
    {
      "id": 258968,
      "primary_message": "Using a ⅓-cup measure, form turkey mixture into ½-inch thick patties. Place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 258969,
      "primary_message": "Preheat a grill pan or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 258970,
      "primary_message": "While the grill pan heats up, place corn in a colander. Drain beans in the colander with the corn, rinse under hot water (from the tap) to thaw, and set aside to drain further.",
      "secondary_message": "1 cup frozen corn\n1 ½ (398 ml) cans black beans"
    },
    {
      "id": 258971,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add turkey patties to the pan and cook, flipping once, until golden and cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 258972,
      "primary_message": "Meanwhile, cut each tortilla into bite-sized strips and place on a large baking sheet pan. Drizzle with oil, season with chili powder and salt, and toss to coat; spread out in a single layer. Place in the oven and bake, flipping once, until golden and crispy, 10-12 minutes. Remove from oven.",
      "secondary_message": "6 small corn tortillas\n1 tbsp extra virgin olive oil\n¾ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 258973,
      "primary_message": "While the tortilla chips are baking, finely grate Parmesan; place in another large bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 258974,
      "primary_message": "Peel and mince additional garlic; add to bowl with the Parmesan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 258975,
      "primary_message": "Juice limes into the bowl; add yogurt, oil, Worcestershire, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp extra virgin olive oil\n1 tbsp Worcestershire sauce\n1 ½ tsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 258976,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 258977,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl along with the corn and beans. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 258978,
      "primary_message": "To serve, divide salad between plates or bowls; top with turkey patties and tortilla chips. Enjoy!",
      "secondary_message": null
    }
  ],
