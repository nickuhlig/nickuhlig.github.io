  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry lemon and arugula. (Skip the arugula if it came pre-washed.) Zest and juice half of the lemon into a large bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": "1 lemon\n1 (142 g) pkg baby arugula"
    },
    {
      "primary_message": "Drain potatoes, then add to the bowl with the lemon along with olives, 1 1/2 tbsp oil, garlic, and seasoning mix. Stir to combine, then transfer to a large baking sheet pan and spread out in an even layer. Pat salmon dry with paper towels, then nestle into the potatoes. Season with salt and pepper, then drizzle with an additional 1/2 tbsp oil. (Reserve bowl for the next step.)",
      "secondary_message": "2 (425 g) can boiled potatoes, canned\n½ cup Kalamata olives, pitted\n2 tbsp extra virgin olive oil\n1 tsp minced garlic\n1 ½ tbsp Greek seasoning\n680 g salmon fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until salmon is cooked through and potatoes are warm, 12-15 minutes. Once done, remove from oven and transfer salmon to a plate. Return potatoes, olives, and any cooking juices to the bowl; add arugula and toss until slightly wilted.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide potato-arugula mixture and salmon between plates or bowls. Top with feta, squeeze lemon over top, and enjoy!",
      "secondary_message": "1 (170 g) pkg crumbled feta cheese"
    }
  ],
