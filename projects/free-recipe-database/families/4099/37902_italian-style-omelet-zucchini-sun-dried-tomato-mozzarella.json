  "instructions": [
    {
      "id": 627508,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a medium bowl (setting aside a small handful for serving).",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 627509,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the parsley, stir to combine, and set aside.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 627510,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Place in a large bowl.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 627511,
      "primary_message": "Peel, halve, and small dice onions; drain and roughly chop sun-dried tomatoes. Add both to the bowl with the zucchini. ",
      "secondary_message": "1 ½ medium red onions\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 627512,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 627513,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 5-6 minutes. Transfer to a plate and set aside. (Reserve bowl for the next step and skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 627514,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl and whisk to combine.",
      "secondary_message": "18 eggs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 627515,
      "primary_message": "Wipe the skillet clean with paper towels; return to medium-low heat, add more oil, and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 627516,
      "primary_message": "Add ⅓ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull cooked edges towards center of the pan. Then tilt the pan, allowing uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 627517,
      "primary_message": "Arrange ⅓ of the veggies and cheese mixture over one side of the omelet. Fold the omelet in half and continue to cook until filling is warmed through and cheese starts to melt, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 627518,
      "primary_message": "Add more oil to the skillet (2 tsp per omelet), then repeat twice more with remaining eggs and veggies.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 627519,
      "primary_message": "To serve, cut each omelet in half and divide between plates. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
