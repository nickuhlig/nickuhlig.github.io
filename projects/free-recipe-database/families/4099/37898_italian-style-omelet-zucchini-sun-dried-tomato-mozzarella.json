  "instructions": [
    {
      "id": 627461,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl (setting aside a small handful for serving).",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 627462,
      "primary_message": "Coarsely grate cheese. Add to the bowl with the parsley, stir to combine, and set aside.",
      "secondary_message": "⅔ (8 oz) block mozzarella cheese"
    },
    {
      "id": 627463,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Place in a medium bowl.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 627464,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 627465,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; drain and roughly chop sun-dried tomatoes. Add both to the bowl with the zucchini. ",
      "secondary_message": "1 medium red onion\n8 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 627466,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes. Transfer to a plate and set aside. (Reserve bowl for the next step and skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 627467,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl and whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 627468,
      "primary_message": "Wipe the skillet clean with paper towels; return to medium-low heat, add more oil, and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 627469,
      "primary_message": "Add ½ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull cooked edges towards center of the pan. Then tilt the pan, allowing uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 627470,
      "primary_message": "Arrange ½ of the veggies and cheese mixture over one side of the omelet. Fold the omelet in half and continue to cook until filling is warmed through and cheese starts to melt, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 627471,
      "primary_message": "Add more oil to the skillet, then repeat with remaining eggs and veggies.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 627472,
      "primary_message": "To serve, cut each omelet in half and divide between plates. Top with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
