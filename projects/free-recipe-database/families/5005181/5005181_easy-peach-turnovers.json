  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the peaches. Juice the lemon. Lightly beat the egg with 1 teaspoon water.",
      "secondary_message": "2 cups peaches, from about 2 large peaches\n½ lemon\n1 egg"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven racks to upper and lower middle positions. Preheat oven to 375°F. Line 2 baking sheets with parchment paper. In a medium bowl, combine diced peaches, brown sugar, 2 teaspoons sugar, tapioca, salt, cinnamon, and lemon juice. Let stand 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Unfold puff pastry sheets onto a clean work surface. Cut each sheet of pastry into four rectangles.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Top one half of each rectangle with peach filling. Fold the pastry over the filling to form a triangle, pressing out excess air. Use your fingers or a fork to press and seal the pastry together. Transfer to a lined baking sheet and repeat with remaining squares. Brush each turnover with egg wash and then sprinkle with remaining sugar. Use a knife to make three 1-inch slits on the top of each pastry. Bake turnovers until golden, about 15 minutes. Serve warm.",
      "secondary_message": null
    }
  ],
