  "instructions": [
    {
      "id": 440953,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 440954,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh rosemary\n4 medium zucchini squash\n0.45 kg red grapes"
    },
    {
      "id": 440955,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Place leaves in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 440956,
      "primary_message": "Peel and mince garlic. Add to the bowl with the rosemary along with vinegar, oil, maple syrup, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "3 tbsp balsamic vinegar\n2 tbsp extra virgin olive oil\n4 tsp pure maple syrup\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 440957,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the marinade.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 440958,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the bowl, along with the grapes, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 440959,
      "primary_message": "Divide chickpeas, zucchini, grapes, and marinade between two large baking dishes.",
      "secondary_message": null
    },
    {
      "id": 440960,
      "primary_message": "Place baking dishes in the oven and roast, stirring halfway through, until zucchini is tender, grapes are bursting, and chickpeas are golden, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 440961,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "473 ml chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 440962,
      "primary_message": "To serve, divide chickpeas, zucchini, grapes, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
