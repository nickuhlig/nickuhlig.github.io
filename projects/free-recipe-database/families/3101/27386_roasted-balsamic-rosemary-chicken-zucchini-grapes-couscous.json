  "instructions": [
    {
      "id": 440863,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 440864,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh rosemary\n4 medium zucchini squash\n1 lb red grapes"
    },
    {
      "id": 440865,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Place leaves in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 440866,
      "primary_message": "Peel and mince garlic. Add to the bowl with the rosemary along with vinegar, oil, maple syrup, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n3 tbsp balsamic vinegar\n2 tbsp extra virgin olive oil\n4 tsp pure maple syrup\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 440867,
      "primary_message": "Add chicken to the marinade, turn to coat, and set aside.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 440868,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Divide between two large baking dishes along with the grapes.",
      "secondary_message": null
    },
    {
      "id": 440869,
      "primary_message": "Using tongs, add chicken to the baking dishes, nestling it into the zucchini and grapes. Drizzle any marinade in the bowl over the dishes.",
      "secondary_message": null
    },
    {
      "id": 440870,
      "primary_message": "Place baking dishes in the oven and roast, stirring zucchini and grapes and flipping chicken halfway through, until grapes are bursting and chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 440871,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 440872,
      "primary_message": "To serve, divide chicken, zucchini, grapes, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
