  "instructions": [
    {
      "id": 440873,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 440874,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh rosemary\n6 medium zucchini squash\n1 ½ lb red grapes"
    },
    {
      "id": 440875,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Place leaves in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 440876,
      "primary_message": "Peel and mince garlic. Add to the bowl with the rosemary along with vinegar, oil, maple syrup, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n¼ cup balsamic vinegar\n3 tbsp extra virgin olive oil\n2 tbsp pure maple syrup\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 440877,
      "primary_message": "Add chicken to the marinade, turn to coat, and set aside.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 440878,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Divide between two large baking sheet pans along with the grapes.",
      "secondary_message": null
    },
    {
      "id": 440879,
      "primary_message": "Using tongs, add chicken to the baking sheets, nestling it into the zucchini and grapes. Drizzle any marinade in the bowl over the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 440880,
      "primary_message": "Place baking sheets in the oven and roast, stirring zucchini and grapes and flipping chicken halfway through, until grapes are bursting and chicken is cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 440881,
      "primary_message": "Meanwhile, in a medium saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 440882,
      "primary_message": "To serve, divide chicken, zucchini, grapes, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
