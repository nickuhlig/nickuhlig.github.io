  "instructions": [
    {
      "id": 440853,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 440854,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh rosemary\n2 medium zucchini squash\n½ lb red grapes"
    },
    {
      "id": 440855,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Place leaves in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 440856,
      "primary_message": "Peel and mince garlic. Add to the bowl with the rosemary along with vinegar, oil, maple syrup, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n1 ½ tbsp balsamic vinegar\n1 tbsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 440857,
      "primary_message": "Add chicken to the marinade, turn to coat, and set aside.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 440858,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Transfer to a large baking dish along with the grapes.",
      "secondary_message": null
    },
    {
      "id": 440859,
      "primary_message": "Using tongs, add chicken to the baking dish, nestling it into the zucchini and grapes. Drizzle any marinade in the bowl over the dish.",
      "secondary_message": null
    },
    {
      "id": 440860,
      "primary_message": "Place baking dish in the oven and roast, stirring zucchini and grapes and flipping chicken halfway through, until grapes are bursting and chicken is cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 440861,
      "primary_message": "Meanwhile, in a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 440862,
      "primary_message": "To serve, divide chicken, zucchini, grapes, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
