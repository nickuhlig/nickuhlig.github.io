  "instructions": [
    {
      "id": 440943,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 440944,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh rosemary\n2 medium zucchini squash\n0.23 kg red grapes"
    },
    {
      "id": 440945,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Place leaves in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 440946,
      "primary_message": "Peel and mince garlic. Add to the bowl with the rosemary along with vinegar, oil, maple syrup, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "1 ½ tbsp balsamic vinegar\n1 tbsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 440947,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the marinade.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 440948,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Add to the bowl, along with the grapes, and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 440949,
      "primary_message": "Transfer chickpeas, zucchini, grapes, and marinade to a large baking dish.",
      "secondary_message": null
    },
    {
      "id": 440950,
      "primary_message": "Place baking dish in the oven and roast, stirring halfway through, until zucchini is tender, grapes are bursting, and chickpeas are golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 440951,
      "primary_message": "Meanwhile, in a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup whole wheat couscous"
    },
    {
      "id": 440952,
      "primary_message": "To serve, divide chickpeas, zucchini, grapes, and couscous between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
