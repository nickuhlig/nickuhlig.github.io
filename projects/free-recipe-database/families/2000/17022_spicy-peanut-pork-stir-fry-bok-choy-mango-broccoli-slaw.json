  "instructions": [
    {
      "id": 351938,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 351939,
      "primary_message": "Add soy sauce, oil, and crushed red pepper to the bowl with the garlic; whisk to combine the marinade.",
      "secondary_message": "4 tsp soy sauce\n2 tsp toasted sesame oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 351940,
      "primary_message": "Slice pork chops crosswise into ½-inch thick strips, add to the bowl with the marinade, toss to coat, and set aside.",
      "secondary_message": "4 pork chops, boneless"
    },
    {
      "id": 351941,
      "primary_message": "While the pork marinates, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 lime\n6 baby bok choy\n2 mangoes"
    },
    {
      "id": 351942,
      "primary_message": "Using a clean cutting board, peel and mince ginger; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 351943,
      "primary_message": "Juice lime into the bowl with the ginger; add peanut butter, fish sauce, water, honey, and spices. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp fish sauce\n2 tbsp water\n4 tsp honey\n½ tsp turmeric, ground\n¼ tsp curry powder\n¼ tsp coriander, ground"
    },
    {
      "id": 351944,
      "primary_message": "Place oil, soy sauce, vinegar, honey, and chili-garlic sauce in a large bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil\n4 tsp soy sauce\n2 tsp rice vinegar\n2 tsp honey\n1 tsp chili-garlic sauce"
    },
    {
      "id": 351945,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 351946,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pork strips and marinade; stir-fry until browned and cooked through, 4-5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 351947,
      "primary_message": "Meanwhile, trim and thinly slice bok choy crosswise into shred-like strips; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 351948,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; large dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 351949,
      "primary_message": "Add broccoli slaw to the bowl and toss to combine.",
      "secondary_message": "1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 351950,
      "primary_message": "When the pork is done, add peanut sauce, stir to combine, and cook until sauce is warmed through and pork is coated, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 351951,
      "primary_message": "To serve, divide pork stir-fry and slaw between plates. Sprinkle pork with additional crushed red pepper and enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
