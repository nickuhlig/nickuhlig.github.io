  "instructions": [
    {
      "id": 351996,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 351997,
      "primary_message": "Meanwhile, peel and mince garlic; place in a large bowl along with soy sauce, oil, and crushed red pepper. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n2 tbsp soy sauce\n1 tbsp toasted sesame oil\n½ tsp crushed red pepper"
    },
    {
      "id": 351998,
      "primary_message": "Medium dice tofu, add to the bowl with the marinade, toss to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 351999,
      "primary_message": "While the tofu marinates, wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 ½ limes\n9 baby bok choy\n3 mangoes"
    },
    {
      "id": 352000,
      "primary_message": "Peel and mince ginger; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 352001,
      "primary_message": "Juice limes into the bowl with the ginger; add peanut butter, soy sauce, water, maple syrup, and spices. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "⅓ cup natural peanut butter\n3 tbsp soy sauce\n3 tbsp water\n2 tbsp pure maple syrup\n¾ tsp turmeric, ground\n½ tsp curry powder\n½ tsp coriander, ground"
    },
    {
      "id": 352002,
      "primary_message": "Place oil, soy sauce, vinegar, maple syrup, and chili-garlic sauce in another large bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp toasted sesame oil\n2 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp pure maple syrup\n1 ½ tsp chili-garlic sauce"
    },
    {
      "id": 352003,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 352004,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and marinade; stir-fry until browned on all sides, about 10 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 352005,
      "primary_message": "Meanwhile, trim and thinly slice bok choy crosswise into shred-like strips; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 352006,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; large dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 352007,
      "primary_message": "Add broccoli slaw to the bowl and toss to combine.",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 352008,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "⅓ cup peanuts, roasted unsalted"
    },
    {
      "id": 352009,
      "primary_message": "When the tofu is done, add peanut sauce, stir to combine, and cook until sauce is warmed through and tofu is coated, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 352010,
      "primary_message": "To serve, divide tofu stir-fry and slaw between plates. Sprinkle tofu with peanuts and additional crushed red pepper. Enjoy!",
      "secondary_message": "3 pinch crushed red pepper"
    }
  ],
