  "instructions": [
    {
      "id": 351807,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 351808,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl along with soy sauce, oil, and crushed red pepper. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n4 tsp soy sauce\n2 tsp toasted sesame oil\n¼ tsp crushed red pepper"
    },
    {
      "id": 351809,
      "primary_message": "Medium dice tofu, add to the bowl with the marinade, toss to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 351810,
      "primary_message": "While the tofu marinates, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 lime\n6 baby bok choy\n2 mangoes"
    },
    {
      "id": 351811,
      "primary_message": "Peel and mince ginger; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 351812,
      "primary_message": "Juice lime into the bowl with the ginger; add peanut butter, soy sauce, water, maple syrup, and spices. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "¼ cup natural peanut butter\n2 tbsp soy sauce\n2 tbsp water\n4 tsp pure maple syrup\n½ tsp turmeric, ground\n¼ tsp curry powder\n¼ tsp coriander, ground"
    },
    {
      "id": 351813,
      "primary_message": "Place oil, soy sauce, vinegar, maple syrup, and chili-garlic sauce in a large bowl; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp toasted sesame oil\n4 tsp soy sauce\n2 tsp rice vinegar\n2 tsp pure maple syrup\n1 tsp chili-garlic sauce"
    },
    {
      "id": 351814,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 351815,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and marinade; stir-fry until browned on all sides, 6-7 minutes.",
      "secondary_message": "4 tsp toasted sesame oil"
    },
    {
      "id": 351816,
      "primary_message": "Meanwhile, trim and thinly slice bok choy crosswise into shred-like strips; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 351817,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; large dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 351818,
      "primary_message": "Add broccoli slaw to the bowl and toss to combine.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 351819,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 351820,
      "primary_message": "When the tofu is done, add peanut sauce, stir to combine, and cook until sauce is warmed through and tofu is coated, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 351821,
      "primary_message": "To serve, divide tofu stir-fry and slaw between plates. Sprinkle tofu with peanuts and additional crushed red pepper. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
