  "instructions": [
    {
      "id": 129008,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 129009,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 129010,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 129011,
      "primary_message": "Wash broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "2 crowns broccoli"
    },
    {
      "id": 129012,
      "primary_message": "In a large bowl, whisk together the mayonnaise, garlic powder, chili-garlic sauce, and honey. Set the sauce aside. ",
      "secondary_message": "½ cup mayonnaise\n¼ tsp garlic powder\n½ tsp chili-garlic sauce\n4 tsp honey"
    },
    {
      "id": 129013,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 129014,
      "primary_message": "Roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 129015,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 129016,
      "primary_message": "Add broccoli and walnuts to the skillet and stir-fry until the broccoli is bright green and tender-crisp, 5-6 minutes. Remove from skillet and place in the bowl with the sauce. ",
      "secondary_message": null
    },
    {
      "id": 129017,
      "primary_message": "Return the skillet to medium heat.",
      "secondary_message": null
    },
    {
      "id": 129018,
      "primary_message": "Cooking in batches if necessary, add the shrimp to the skillet; cook until opaque, 1-2 minutes per side. Once done, transfer shrimp to the bowl with the broccoli and sauce. Stir to combine. ",
      "secondary_message": null
    },
    {
      "id": 129019,
      "primary_message": "To serve, divide the rice, shrimp, and broccoli between bowls and garnish with crushed red pepper. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
