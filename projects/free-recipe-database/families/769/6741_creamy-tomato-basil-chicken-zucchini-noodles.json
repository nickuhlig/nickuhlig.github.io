  "instructions": [
    {
      "id": 106250,
      "primary_message": "Wash and dry the fresh produce (skip the spinach if it came pre-washed).",
      "secondary_message": "6 medium zucchini squash\n1 ½ (5 oz) pkgs baby spinach\n1 ½ small pkgs fresh basil"
    },
    {
      "id": 106251,
      "primary_message": "Use a spiralizer, julienne (or regular) peeler to make zucchini noodles; set aside.",
      "secondary_message": null
    },
    {
      "id": 106252,
      "primary_message": "Grate Parmesan into a small bowl.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 106253,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 106254,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 106255,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 106256,
      "primary_message": "When the skillet is hot, add oil, and swirl to coat. Add chicken and cook until golden brown and cooked through, 3-4 minutes on each side; remove chicken and set aside on a plate. Cook in batches if necessary.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 106257,
      "primary_message": "After setting the chicken aside, keep the pan on the heat and reduce to medium. Add the garlic, cream, broth, Italian seasoning, and Parmesan; cook, stirring occasionally until the sauce starts to thicken, 3-4 minutes.",
      "secondary_message": "18 fl oz (2 ¼ cups) heavy cream\n12 fl oz (1 ½ cups) chicken or vegetable broth\n1 ½ tsp Italian seasoning"
    },
    {
      "id": 106258,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 106259,
      "primary_message": "Drain and thinly slice the sun-dried tomatoes.",
      "secondary_message": "24 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 106260,
      "primary_message": "Add the spinach, basil, and sun-dried tomatoes to the skillet and let it simmer until the spinach starts to wilt, 2-3 minutes; stir in any accumulated juices from the plate with the cooked chicken. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 106261,
      "primary_message": "Add the zucchini noodles to the sauce and gently toss until well coated.",
      "secondary_message": null
    },
    {
      "id": 106262,
      "primary_message": "Slice the chicken crosswise into strips.",
      "secondary_message": null
    },
    {
      "id": 106263,
      "primary_message": "To serve, divide the zucchini noodles between bowls. Top with chicken and cream sauce; enjoy!",
      "secondary_message": null
    }
  ],
