  "instructions": [
    {
      "id": 1,
      "primary_message": "In a large saucepan, bring tomatoes bring to a simmer over medium-high heat, stirring occasionally, about 5 minutes. Reduce heat to medium and continue to cook, stirring occasionally, until much of the excess liquid has cooked off but the tomatoes aren’t totally dry, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer tomatoes and any juices a fine-mesh strainer or a food mill set with the finest strainer. over a large bowl. Strain the tomatoes of seeds and skin, pushing all the pulp and juices through; if straining by hand, use a wooden spoon and a scraping motion to pass the tomato flesh through into a bowl below. For an even smoother texture, pass the coulis once more through an even finer strainer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Season with salt to taste. Use the tomato purée in any recipe calling for a tomato purée, or freeze for up to 6 months.",
      "secondary_message": null
    }
  ],
