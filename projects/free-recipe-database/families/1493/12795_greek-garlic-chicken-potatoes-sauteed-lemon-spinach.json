  "instructions": [
    {
      "id": 215254,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 215255,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "9 medium yellow potatoes\n2 lemons\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 215256,
      "primary_message": "Slice potatoes into ¼-inch thick rounds; divide between two baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 215257,
      "primary_message": "Peel and mince garlic. Add to the baking sheets with the potatoes along with oil and spices; toss to combine, then spread out in an even layer.",
      "secondary_message": "9 cloves garlic\n¼ cup extra virgin olive oil\n1 ½ tsp oregano\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 215258,
      "primary_message": "Place potatoes in the oven (it doesn't have to be fully heated) and bake for 8-10 minutes while you prepare the chicken.",
      "secondary_message": null
    },
    {
      "id": 215259,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 215260,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 215261,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the pot; cook until golden brown, about 2 minutes per side (the chicken will not be cooked all the way through).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 215262,
      "primary_message": "Remove baking sheets from the oven and place seared chicken on top of the potatoes. Juice one of the lemons over the chicken and potatoes. Return to the oven and continue to bake until potatoes are tender and chicken is cooked through, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 215263,
      "primary_message": "When there are 5 minutes left on the potatoes and chicken, return the pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 215264,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 215265,
      "primary_message": "Juice remaining lemon into the pot and season with salt and pepper; stir to combine. ",
      "secondary_message": "¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 215266,
      "primary_message": "To serve, divide potatoes, chicken, and spinach between plates. Enjoy!",
      "secondary_message": null
    }
  ],
