  "instructions": [
    {
      "id": 343712,
      "primary_message": "Preheat the oven to 500°F and place the rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional). ",
      "secondary_message": null
    },
    {
      "id": 343713,
      "primary_message": "Meanwhile, wash, dry, and trim ends of each squash; halve squash lengthwise and scrape out the seeds from each half.",
      "secondary_message": "2 medium spaghetti squash"
    },
    {
      "id": 343714,
      "primary_message": "Rub the inside of the squash with oil and season with salt and pepper. Arrange the squash halves cut-side-down on the baking sheet.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 343715,
      "primary_message": "Place squash halves in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 343716,
      "primary_message": "Meanwhile, wash, dry, and cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces. Transfer to a large pot, season with salt, and cover with hot water (from the tap).",
      "secondary_message": "2 medium heads cauliflower\n1 tsp salt"
    },
    {
      "id": 343717,
      "primary_message": "Place pot with the cauliflower over high heat, cover, and bring to a boil. Reduce to a simmer and cook until fork-tender, 4-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 343718,
      "primary_message": "While the cauliflower cooks, peel and roughly chop garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 343719,
      "primary_message": "Add milk, nutritional yeast, oil, salt, and pepper to the bowl with the garlic; stir to combine and set aside for the sauce.",
      "secondary_message": "8 fl oz (1 cup) whole milk\n¼ cup nutritional yeast flakes\n2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 343720,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 343721,
      "primary_message": "Place peas in a colander. When the cauliflower is done, pour over the peas into the colander to drain.",
      "secondary_message": "2 cups frozen peas"
    },
    {
      "id": 343722,
      "primary_message": "Transfer half the cauliflower to a medium bowl and reserve for the sauce. Return remaining cauliflower and peas to the pot, cover, and set aside to keep warm.",
      "secondary_message": null
    },
    {
      "id": 343723,
      "primary_message": "Working in batches to best fit your blender, combine reserved cauliflower and garlic-milk mixture in a blender and blend on high until smooth. Add water, 1 tablespoon at a time, if necessary, to reach a sauce-like consistency.",
      "secondary_message": null
    },
    {
      "id": 343724,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 343725,
      "primary_message": "To serve, divide squash between plates. Top with sauce, remaining cauliflower, peas, Parmesan, and pumpkin seeds. Enjoy!",
      "secondary_message": "½ cup pumpkin seeds"
    }
  ],
