  "instructions": [
    {
      "id": 343778,
      "primary_message": "Preheat the oven to 260°C (500°F) and place the rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional). ",
      "secondary_message": null
    },
    {
      "id": 343779,
      "primary_message": "Meanwhile, wash, dry, and trim ends of the squash; halve squash lengthwise and scrape out the seeds from each half.",
      "secondary_message": "1 medium spaghetti squash"
    },
    {
      "id": 343780,
      "primary_message": "Rub the inside of the squash with oil and season with salt and pepper. Arrange the squash halves cut-side-down on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 343781,
      "primary_message": "Place squash halves in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 343782,
      "primary_message": "Meanwhile, wash, dry, and cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into bite-sized pieces. Transfer to a medium saucepan, season with salt, and cover with hot water (from the tap).",
      "secondary_message": "1 medium head cauliflower\n½ tsp salt"
    },
    {
      "id": 343783,
      "primary_message": "Place saucepan with the cauliflower over high heat, cover, and bring to a boil. Reduce to a simmer and cook until fork-tender, 4-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 343784,
      "primary_message": "While the cauliflower cooks, peel garlic and place in a blender.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 343785,
      "primary_message": "Add milk, nutritional yeast, oil, salt, and pepper to the blender.",
      "secondary_message": "118 ml (½ cup) whole milk\n⅛ cup nutritional yeast flakes\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 343786,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 343787,
      "primary_message": "Place peas in a colander. When the cauliflower is done, pour over the peas into the colander to drain.",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 343788,
      "primary_message": "Transfer half the cauliflower to the blender and blend on high until smooth; add water, 1 tablespoon at a time, if necessary, to reach a sauce-like consistency.",
      "secondary_message": null
    },
    {
      "id": 343789,
      "primary_message": "Remove squash from the oven and allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 343790,
      "primary_message": "To serve, divide squash between plates. Top with sauce, remaining cauliflower, peas, Parmesan, and pumpkin seeds. Enjoy!",
      "secondary_message": "¼ cup pumpkin seeds"
    }
  ],
