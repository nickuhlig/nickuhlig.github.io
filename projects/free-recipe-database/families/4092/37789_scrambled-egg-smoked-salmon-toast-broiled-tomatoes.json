  "instructions": [
    {
      "id": 590843,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 590844,
      "primary_message": "Wash, dry, and cut tomatoes in half crosswise; transfer to the baking sheet, arranging them cut-side up. Drizzle with oil and season with spices.",
      "secondary_message": "2 tomatoes\n1 tsp extra virgin olive oil\n¼ tsp dill, dried\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 590845,
      "primary_message": "Place baking sheet in the oven and broil, flipping tomatoes halfway through, until tender and golden at the edges, 6-8 minutes. Transfer to a plate. (Reserve baking sheet for later use.) ",
      "secondary_message": null
    },
    {
      "id": 590846,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a medium bowl.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 590847,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 590848,
      "primary_message": "While the skillet heats up, add eggs, salt, and pepper to the bowl with the green onions. Whisk to combine.",
      "secondary_message": "4 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 590849,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the skillet. Cook until the eggs are no longer runny. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 590850,
      "primary_message": "While the eggs are cooking, arrange bread on the reserved baking sheet. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven.",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 590851,
      "primary_message": "Chop or tear salmon into bite-sized pieces.",
      "secondary_message": "½ (113 g) pkg smoked salmon"
    },
    {
      "id": 590852,
      "primary_message": "To serve, divide tomatoes and toast between plates; top toast with scrambled eggs and salmon. Enjoy!",
      "secondary_message": null
    }
  ],
