  "instructions": [
    {
      "id": 435782,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 435783,
      "primary_message": "While the skillet heats up, line a large plate with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 435784,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add pecans, sugar, cinnamon, and salt; cook, stirring occasionally, until pecans are fragrant and caramelized, 3-4 minutes. Transfer pecans to the plate and set aside to cool (they will continue to harden as they cool). ",
      "secondary_message": "2 tbsp butter, unsalted\n1 cup pecan halves\n3 tbsp granulated sugar\n½ tsp cinnamon, ground\n3 pinch salt"
    },
    {
      "id": 435785,
      "primary_message": "Wash and dry raspberries and blackberries. Place both in a large pot along with additional sugar, water, and vanilla.",
      "secondary_message": "3 (170 g) pkgs raspberries\n3 (170 g) pkgs blackberries\n⅓ cup granulated sugar\n44 ml water\n¾ tsp vanilla extract"
    },
    {
      "id": 435786,
      "primary_message": "Set the pot over medium-high heat and cook, stirring occasionally, until berries soften and release their juices, 5-7 minutes. Remove from heat and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 435787,
      "primary_message": "Transfer cooled pecans to a cutting board and roughly chop. ",
      "secondary_message": null
    },
    {
      "id": 435788,
      "primary_message": "To serve, divide yogurt and warm berry compote between bowls; top with candied pecans. Enjoy!",
      "secondary_message": "4 ½ cups plain Greek yogurt"
    }
  ],
