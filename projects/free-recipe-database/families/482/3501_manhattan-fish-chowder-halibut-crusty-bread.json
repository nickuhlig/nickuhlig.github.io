  "instructions": [
    {
      "id": 37123,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n1 medium carrot\n1 stick celery\n½ lemon\n½ small pkg fresh thyme"
    },
    {
      "id": 37124,
      "primary_message": "Peel the carrot, then trim off the ends; discard the peels and trimmings. Halve the carrot lengthwise, then thinly slice crosswise into 3-mm-thick half-rounds and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 37125,
      "primary_message": "Trim off and discard the ends of the celery; slice it crosswise into 3-mm-thick pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 37126,
      "primary_message": "Preheat a saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 37127,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and add to the bowl with the carrots and celery.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 37128,
      "primary_message": "Once the saucepan is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 37129,
      "primary_message": "Add the carrots, celery, and onion to the saucepan; season with salt and pepper. Cook, stirring occasionally, until the vegetables are softened, 5 to 6 minutes.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 37130,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the saucepan.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 37131,
      "primary_message": "Peel and medium dice the potato.",
      "secondary_message": null
    },
    {
      "id": 37132,
      "primary_message": "Grate all the zest from the lemon into a small bowl, then juice the lemon into the same bowl.",
      "secondary_message": null
    },
    {
      "id": 37133,
      "primary_message": "Add the diced potatoes, diced tomatoes, broth, lemon zest and juice to the saucepan. Bring the mixture to a boil, then reduce the heat to low and simmer, stirring occasionally, until the potatoes are tender, 10 to 12 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n473 ml (2 cups) chicken or vegetable broth"
    },
    {
      "id": 37134,
      "primary_message": "One by one, holding a sprig of thyme at its top, run your fingers down it to remove the leaves. Discard the sprigs and chop the leaves; add to the saucepan.",
      "secondary_message": ""
    },
    {
      "id": 37135,
      "primary_message": "Cut the fish into 2 ½-cm pieces.",
      "secondary_message": "0.34 kg halibut fillet"
    },
    {
      "id": 37136,
      "primary_message": "Add the fish to the soup and season with additional salt and pepper. Cook until the fish is opaque and cooked through, another 4 to 5 minutes.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 37137,
      "primary_message": "Slice the buns in half and toast if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 37138,
      "primary_message": "To serve, divide the soup between bowls and serve with the bun on the side. Enjoy!",
      "secondary_message": null
    }
  ],
