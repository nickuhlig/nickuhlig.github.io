  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small heatproof bowl, add dates and cover with hot water. Soak until softened, about 10 minutes. Drain well.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine soaked dates, frozen banana, milk, yogurt, cold brew, hemp hearts, cinnamon, cardamom, and salt in a blender.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Blend on high speed until smooth and creamy, about 60 seconds. Pour into 1 or 2 glasses and serve.",
      "secondary_message": null
    }
