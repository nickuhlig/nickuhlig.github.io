  "instructions": [
    {
      "id": 168624,
      "primary_message": "Preheat oven to 400°F. Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 168625,
      "primary_message": "Wash, dry, and roughly chop mushrooms.",
      "secondary_message": "1 lb white mushrooms"
    },
    {
      "id": 168626,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 168627,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring often, until soft and moisture has evaporated, about 4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 168628,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the skillet along with tomato sauce and spices; stir to combine and remove from heat.",
      "secondary_message": "2 cloves garlic\n1 (8 oz) can tomato sauce\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 168629,
      "primary_message": "Grate the cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 168630,
      "primary_message": "Cut pitas in half and carefully open them.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 168631,
      "primary_message": "Spread a layer of ricotta cheese inside the bottom half of each pita. Layer with mushroom mixture and grated cheese. Place filled pitas on the baking sheet, ricotta-side facing down.",
      "secondary_message": "1 (15 oz) pkg ricotta cheese"
    },
    {
      "id": 168632,
      "primary_message": "Place calzones in the oven and bake until the outside is crisp and the inside is hot and bubbly, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 168633,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp Italian seasoning"
    },
    {
      "id": 168634,
      "primary_message": "Wash and dry the lettuce. Chop or tear into bite-sized pieces and transfer to the bowl with the dressing. Toss to combine the salad.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 168635,
      "primary_message": "To serve, divide calzones and salad between plates and enjoy!",
      "secondary_message": null
    }
  ],
