  "instructions": [
    {
      "id": 168660,
      "primary_message": "Preheat oven to 205°C (400°F). Line a large baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 168661,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 168662,
      "primary_message": "Use the tip of a knife to slice down the length of the sausages. Peel off the casings and discard. Add sausage meat to the skillet and break apart with a spoon until crumbly. Cook, stirring often, until browned and almost cooked through, 3-4 minutes.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 168663,
      "primary_message": "Meanwhile, wash, dry, and roughly chop mushrooms. Add to the skillet and cook, stirring often, until mushrooms are soft and sausage is cooked through, 3-4 minutes more.",
      "secondary_message": "0.23 kg white mushrooms"
    },
    {
      "id": 168664,
      "primary_message": "Peel and mince garlic. Add to the skillet along with tomato sauce and spices; stir to combine and remove from heat.",
      "secondary_message": "2 cloves garlic\n1 (213 ml) can tomato sauce\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 168665,
      "primary_message": "Grate the cheese.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 168666,
      "primary_message": "Cut pitas in half and carefully open them.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 168667,
      "primary_message": "Spread a layer of ricotta cheese inside the bottom half of each pita. Layer with sausage mixture and grated cheese. Place filled pitas on the baking sheet, ricotta-side facing down.",
      "secondary_message": "1 (425 g) pkg ricotta cheese"
    },
    {
      "id": 168668,
      "primary_message": "Place calzones in the oven and bake until the outside is crisp and the inside is hot and bubbly, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 168669,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp Italian seasoning"
    },
    {
      "id": 168670,
      "primary_message": "Wash and dry the lettuce. Chop or tear into bite-sized pieces and transfer to the bowl with the dressing. Toss to combine the salad.",
      "secondary_message": "1 head butter (Boston) lettuce"
    },
    {
      "id": 168671,
      "primary_message": "To serve, divide calzones and salad between plates and enjoy!",
      "secondary_message": null
    }
  ],
