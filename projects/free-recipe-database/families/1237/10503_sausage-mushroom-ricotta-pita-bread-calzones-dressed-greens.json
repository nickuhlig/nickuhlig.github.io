  "instructions": [
    {
      "id": 168672,
      "primary_message": "Preheat oven to 205°C (400°F). Line two baking sheet pans with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 168673,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 168674,
      "primary_message": "Use the tip of a knife to slice down the length of the sausages. Peel off the casings and discard. Add sausage meat to the skillet and break apart with a spoon until crumbly. Cook, stirring often, until browned and almost cooked through, 4-5 minutes.",
      "secondary_message": "3 pork sausages"
    },
    {
      "id": 168675,
      "primary_message": "Meanwhile, wash, dry, and roughly chop mushrooms. Add to the skillet and cook, stirring often, until mushrooms are soft and sausage is cooked through, 4-5 minutes more.",
      "secondary_message": "⅓ kg white mushrooms"
    },
    {
      "id": 168676,
      "primary_message": "Peel and mince garlic. Add to the skillet along with tomato sauce and spices; stir to combine and remove from heat.",
      "secondary_message": "3 cloves garlic\n1 ½ (213 ml) cans tomato sauce\n¾ tsp Italian seasoning\n¼ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 168677,
      "primary_message": "Grate the cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 168678,
      "primary_message": "Cut pitas in half and carefully open them.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 168679,
      "primary_message": "Spread a layer of ricotta cheese inside the bottom half of each pita. Layer with sausage mixture and grated cheese. Divide filled pitas between baking sheets, placing them ricotta-side facing down.",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese"
    },
    {
      "id": 168680,
      "primary_message": "Place calzones in the oven and bake until the outside is crisp and the inside is hot and bubbly, 7-9 minutes. ",
      "secondary_message": null
    },
    {
      "id": 168681,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n½ tsp salt\n3 pinch black pepper\n3 pinch Italian seasoning"
    },
    {
      "id": 168682,
      "primary_message": "Wash and dry the lettuce. Chop or tear into bite-sized pieces and transfer to the bowl with the dressing. Toss to combine the salad.",
      "secondary_message": "1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 168683,
      "primary_message": "To serve, divide calzones and salad between plates and enjoy!",
      "secondary_message": null
    }
  ],
