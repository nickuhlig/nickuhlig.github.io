  "instructions": [
    {
      "id": 168684,
      "primary_message": "Preheat oven to 205°C (400°F). Line a baking sheet pan with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 168685,
      "primary_message": "Wash, dry, and roughly chop mushrooms.",
      "secondary_message": "0.23 kg white mushrooms"
    },
    {
      "id": 168686,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 168687,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring often, until soft and moisture has evaporated, about 3 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 168688,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the skillet along with tomato sauce and spices; stir to combine and remove from heat.",
      "secondary_message": "1 clove garlic\n½ (213 ml) can tomato sauce\n¼ tsp Italian seasoning\n⅛ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 168689,
      "primary_message": "Grate the cheese.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 168690,
      "primary_message": "Cut pitas in half and carefully open them.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 168691,
      "primary_message": "Spread a layer of ricotta cheese inside the bottom half of each pita. Layer with mushroom mixture and grated cheese. Place filled pitas on the baking sheet, ricotta-side facing down.",
      "secondary_message": "½ (425 g) pkg ricotta cheese"
    },
    {
      "id": 168692,
      "primary_message": "Place calzones in the oven and bake until the outside is crisp and the inside is hot and bubbly, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 168693,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n⅛ tsp salt\n1 pinch black pepper\n1 pinch Italian seasoning"
    },
    {
      "id": 168694,
      "primary_message": "Wash and dry the lettuce. Chop or tear into bite-sized pieces and transfer to the bowl with the dressing. Toss to combine the salad.",
      "secondary_message": "½ head butter (Boston) lettuce"
    },
    {
      "id": 168695,
      "primary_message": "To serve, divide calzones and salad between plates and enjoy!",
      "secondary_message": null
    }
  ],
