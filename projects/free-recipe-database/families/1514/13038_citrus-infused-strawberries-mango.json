  "instructions": [
    {
      "id": 218623,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ (454 g) pkgs strawberries\n3 mangoes\n3 oranges\n1 ½ lemons"
    },
    {
      "id": 218624,
      "primary_message": "Trim and quarter strawberries; transfer to a large baking dish. ",
      "secondary_message": null
    },
    {
      "id": 218625,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides. Medium dice, add to the baking dish, and stir to combine. Spread fruit out in a single layer and set aside.",
      "secondary_message": null
    },
    {
      "id": 218626,
      "primary_message": "Zest and juice oranges and lemons into a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 218627,
      "primary_message": "Add sugar to the saucepan; place over high heat and cook, stirring occasionally, until sugar dissolves. Bring to a boil, then remove from heat.",
      "secondary_message": "1 ½ cup granulated sugar"
    },
    {
      "id": 218628,
      "primary_message": "Pour hot citrus syrup over the fruit, stir to coat, and set aside to cool, 7-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 218629,
      "primary_message": "Once the fruit has cooled, divide between bowls, drizzle with citrus syrup, and enjoy!",
      "secondary_message": null
    }
  ],
