  "instructions": [
    {
      "id": 218591,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 218592,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (454 g) pkgs strawberries\n2 oranges\n1 lemon"
    },
    {
      "id": 218593,
      "primary_message": "Trim and quarter strawberries; transfer to a medium baking dish and spread out in a single layer. Set aside.",
      "secondary_message": null
    },
    {
      "id": 218594,
      "primary_message": "Zest and juice oranges and lemon into a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 218595,
      "primary_message": "Add sugar to the saucepan; place over high heat and cook, stirring occasionally, until sugar dissolves. Bring to a boil, then remove from heat.",
      "secondary_message": "1 cup granulated sugar"
    },
    {
      "id": 218596,
      "primary_message": "Pour hot citrus syrup over the strawberries, stir to coat, and set aside to cool, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 218597,
      "primary_message": "Meanwhile, remove bowl from the freezer. Pour cold cream, sugar, and vanilla, into the bowl.",
      "secondary_message": "237 ml heavy cream\n2 tsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 218598,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 218599,
      "primary_message": "Once the strawberries have cooled completely, divide between bowls, drizzle with citrus syrup, and top with whipped cream. Enjoy!",
      "secondary_message": null
    }
  ],
