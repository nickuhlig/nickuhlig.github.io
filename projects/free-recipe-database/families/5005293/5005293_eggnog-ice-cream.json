  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Freshly grate the nutmeg.",
      "secondary_message": "¾ tsp nutmeg"
    },
    {
      "id": 1,
      "primary_message": "In a heavy medium saucepan, whisk egg yolks and sugar together until well combined. Slowly whisk in cream, then milk. Cook, whisking frequently, over medium heat, until a custard forms on the back of a spoon and a finger swiped across the back leaves a clean line.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove from heat and stir in nutmeg, salt, and bourbon. Pour through a strainer into an airtight container and chill overnight.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "The next day, churn according to manufacturer's instructions. Return to airtight container and chill in freezer for at least 3 hours before serving.",
      "secondary_message": null
    }
  ],
