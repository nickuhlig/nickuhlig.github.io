  "instructions": [
    {
      "primary_message": "Place milk, cream, and spices in a medium saucepan and stir to combine. Bring to a gentle simmer over medium heat. Remove from heat. ",
      "secondary_message": "3 cups whole milk\n1 cup heavy whipping cream\n¼ tsp nutmeg, ground\n¼ tsp allspice, ground\n⅛ tsp salt"
    },
    {
      "primary_message": "Meanwhile, separate eggs, placing yolks in a medium heatproof bowl and whites in a small bowl. (Reserve egg whites for another use.)",
      "secondary_message": null
    },
    {
      "primary_message": "Add sugar and salt to the bowl with the egg yolks. Whisk until mixture is thick, pale, and sugar is fully dissolved, 2-3 minutes. ",
      "secondary_message": "½ cup granulated sugar\n⅛ tsp salt"
    },
    {
      "primary_message": "Using a ladle, gradually add warm milk mixture to the bowl with the egg yolks, whisking constantly. Return mixture to the pan and cook over medium heat, stirring constantly, until eggnog thickens and reaches 160°F-165°F on a thermometer, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Immediately pour eggnog through a fine mesh strainer into a clean medium bowl. Add pumpkin and vanilla, then whisk to combine. Cover and chill until cold, about 4 hours. ",
      "secondary_message": "½ (15 oz) can pure pumpkin purée\n1 tsp vanilla extract"
    },
    {
      "primary_message": "Whisk eggnog once more right before serving, then divide between glasses and sprinkle with nutmeg. Enjoy!",
      "secondary_message": "¼ tsp nutmeg, ground"
    }
  ],
