  "instructions": [
    {
      "id": 208413,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 208414,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh rosemary\n2 small bunches asparagus\n4 caps portobello mushrooms"
    },
    {
      "id": 208415,
      "primary_message": "Peel and mince garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 208416,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Add to the bowl with the garlic, along with oil, salt, and pepper; stir to combine.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 208417,
      "primary_message": "Pat lamb chops dry with paper towels, place on a plate, and coat both sides with half the garlic-rosemary oil; set aside.",
      "secondary_message": "8 lamb loin chops"
    },
    {
      "id": 208418,
      "primary_message": "Snap or cut off woody ends of the asparagus. Transfer spears to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 208419,
      "primary_message": "Remove stems and slice mushrooms into ¼-inch pieces; add to the baking sheet with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 208420,
      "primary_message": "Drizzle remaining garlic-rosemary oil over the veggies, toss to coat, and place in the oven. Bake, tossing once, until fork-tender, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 208421,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208422,
      "primary_message": "Once the skillet is hot, add chops and cook, flipping once, until desired doneness, 4-5 minutes for medium-rare. Transfer to a clean plate and cover loosely with foil.",
      "secondary_message": null
    },
    {
      "id": 208423,
      "primary_message": "To serve, divide veggies and lamb chops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
