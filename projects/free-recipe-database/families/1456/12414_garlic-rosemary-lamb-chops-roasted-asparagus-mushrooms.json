  "instructions": [
    {
      "id": 208457,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 208458,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh rosemary\n3 small bunches asparagus\n6 caps portobello mushrooms"
    },
    {
      "id": 208459,
      "primary_message": "Peel and mince garlic; transfer to a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 208460,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Add to the bowl with the garlic, along with oil, salt, and pepper; stir to combine.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 208461,
      "primary_message": "Pat lamb chops dry with paper towels, place in a baking dish, and coat both sides with half the garlic-rosemary oil; set aside.",
      "secondary_message": "12 lamb loin chops"
    },
    {
      "id": 208462,
      "primary_message": "Snap or cut off woody ends of the asparagus. Divide spears between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 208463,
      "primary_message": "Remove stems and slice mushrooms into ¼-inch pieces; add to the baking sheets with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 208464,
      "primary_message": "Drizzle remaining garlic-rosemary oil over the veggies, toss to coat, and place in the oven. Bake, tossing once, until fork-tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 208465,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 208466,
      "primary_message": "Once the skillet is hot, add chops and cook, flipping once, until desired doneness, 4-5 minutes for medium-rare. Work in batches if necessary. Transfer to a large plate and cover loosely with foil.",
      "secondary_message": null
    },
    {
      "id": 208467,
      "primary_message": "To serve, divide veggies and lamb chops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
