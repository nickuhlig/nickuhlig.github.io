  "instructions": [
    {
      "id": 323665,
      "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 323666,
      "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a small saucepan. Add water and salt, cover, then bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes. ",
      "secondary_message": "1 cup green lentils, dried\n4 cup water\n1 tsp salt"
    },
    {
      "id": 323667,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 medium carrots\n2 sticks celery\n1 small pkg fresh mint\n2 avocados\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 323668,
      "primary_message": "Peel, trim, and slice carrots crosswise into ½-inch thick pieces. Transfer to the baking sheet, drizzle with oil, and sprinkle with spices. Toss to coat, then spread out in an even layer. ",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp coriander, ground\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 323669,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast carrots, stirring halfway through, until golden brown and fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 323670,
      "primary_message": "While the carrots are roasting, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 323671,
      "primary_message": "Peel, halve, and thinly slice shallot into half-moons; peel and mince garlic. Add both to the bowl with the dressing. ",
      "secondary_message": "1 shallot\n2 cloves garlic"
    },
    {
      "id": 323672,
      "primary_message": "Trim and slice celery crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 323673,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 323674,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 323675,
      "primary_message": "When the lentils are done, drain in a colander, rinse with cold water, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 323676,
      "primary_message": "Just before serving, add roasted carrots, arugula, and pumpkin seeds to the bowl; toss to combine the salad.",
      "secondary_message": "½ cup pumpkin seeds"
    },
    {
      "id": 323677,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
