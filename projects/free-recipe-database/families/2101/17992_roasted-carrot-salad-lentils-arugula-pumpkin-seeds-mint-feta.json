  "instructions": [
    {
      "id": 323762,
      "primary_message": "Preheat oven to 220°C (425°F). Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 323763,
      "primary_message": "Using a strainer, rinse lentils under cold water; drain and transfer to a medium saucepan. Add water and salt, cover, then bring to a boil over high heat. Once boiling, remove lid, reduce heat to a simmer, and cook until tender, 15-20 minutes. ",
      "secondary_message": "1 ½ cups green lentils, dried\n6 cup water\n1 ½ tsp salt"
    },
    {
      "id": 323764,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "9 medium carrots\n3 sticks celery\n1 small pkg fresh mint\n1 ½ avocados\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 323765,
      "primary_message": "Peel, trim, and slice carrots crosswise into ½-inch thick pieces. Divide between the baking sheets, drizzle with oil, and sprinkle with spices. Toss to coat, then spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp coriander, ground\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper\n3 pinch cinnamon, ground"
    },
    {
      "id": 323766,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast carrots, stirring halfway through, until golden brown and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 323767,
      "primary_message": "While the carrots are roasting, place oil, vinegar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp apple cider vinegar\n¾ tsp cumin, ground\n¾ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper\n3 pinch cinnamon, ground"
    },
    {
      "id": 323768,
      "primary_message": "Peel, halve, and thinly slice shallots into half-moons; peel and mince garlic. Add both to the bowl with the dressing. ",
      "secondary_message": "2 shallots\n3 cloves garlic"
    },
    {
      "id": 323769,
      "primary_message": "Trim and slice celery crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 323770,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 323771,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 323772,
      "primary_message": "When the lentils are done, drain in a colander, rinse with cold water, and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 323773,
      "primary_message": "Just before serving, add roasted carrots, arugula, and pumpkin seeds to the bowl; toss to combine the salad.",
      "secondary_message": "¾ cup pumpkin seeds"
    },
    {
      "id": 323774,
      "primary_message": "To serve, divide salad between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
