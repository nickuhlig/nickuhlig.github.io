  "instructions": [
    {
      "id": 378460,
      "primary_message": "This recipe will make about 4 cups of hummus. Work in batches to best fit your blender or food processor.",
      "secondary_message": null
    },
    {
      "id": 378461,
      "primary_message": "Wash and dry snap peas. Set aside.",
      "secondary_message": "3 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 378462,
      "primary_message": "Wash, dry, and juice lemons into a blender. (Alternatively, the hummus can be prepared in a food processor.)",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 378463,
      "primary_message": "Drain and rinse chickpeas. Add to the blender.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 378464,
      "primary_message": "Peel and roughly chop garlic. Add to the blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 378465,
      "primary_message": "Roughly chop sun-dried tomatoes. Add to the blender along with water, tahini, oil, and spices. Blend on high for several minutes until smooth. Add more water to the hummus, one tablespoon at a time, if needed, to reach desired consistency.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n¾ cup water\n3 tbsp tahini\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp cumin, ground\n½ tsp paprika"
    },
    {
      "id": 378466,
      "primary_message": "To serve, divide hummus and snap peas between plates. Enjoy!",
      "secondary_message": null
    }
  ],
