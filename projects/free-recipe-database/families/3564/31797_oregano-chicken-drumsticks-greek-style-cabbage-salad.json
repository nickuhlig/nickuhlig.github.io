  "instructions": [
    {
      "id": 502439,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 502440,
      "primary_message": "Pat chicken dry with paper towels and place in a large bowl. Drizzle with oil, season with spices, and toss to coat. Transfer chicken to the baking sheet and spread it out in an even layer.",
      "secondary_message": "3 ¾ lb chicken drumsticks\n1 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 502441,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway, until chicken is golden and cooked through, about 30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 502442,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n3 tomatoes\n1 ½ green bell peppers"
    },
    {
      "id": 502443,
      "primary_message": "Peel and mince shallots and garlic. Place both in a clean large bowl, along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n3 cloves garlic\n3 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tbsp dill, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 502444,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 502445,
      "primary_message": "Small dice tomatoes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 502446,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 502447,
      "primary_message": "Drain and roughly chop olives. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 502448,
      "primary_message": "To serve, divide drumsticks and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
