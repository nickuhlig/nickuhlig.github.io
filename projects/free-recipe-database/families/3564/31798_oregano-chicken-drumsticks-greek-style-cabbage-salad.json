  "instructions": [
    {
      "id": 502449,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 502450,
      "primary_message": "Pat chicken dry with paper towels and place in a medium bowl. Drizzle with oil, season with spices, and toss to coat. Transfer chicken to the baking sheet and spread it out in an even layer.",
      "secondary_message": "0.57 kg chicken drumsticks\n1 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 502451,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning halfway, until chicken is golden and cooked through, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 502452,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 tomato\n½ green bell pepper"
    },
    {
      "id": 502453,
      "primary_message": "Peel and mince shallot and garlic. Place both in a clean medium bowl, along with oil, vinegar, and spices. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 clove garlic\n1 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp dill, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 502454,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 502455,
      "primary_message": "Small dice tomato. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 502456,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 502457,
      "primary_message": "Drain and roughly chop olives. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 502458,
      "primary_message": "To serve, divide drumsticks and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
