  "instructions": [
    {
      "id": 603368,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 603369,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 603370,
      "primary_message": "While the skillet heats up, trim, seed, and medium dice bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 603371,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, taco seasoning, and salt; cook, stirring occasionally, until softened, 2-3 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tbsp taco seasoning\n⅛ tsp salt"
    },
    {
      "id": 603372,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "1 (15 oz) can black beans"
    },
    {
      "id": 603373,
      "primary_message": "When the bell pepper is softened, add beans to the skillet. Continue to cook, stirring occasionally, until warmed through, 1-2 minutes more. Transfer to a medium bowl and set aside. (Wipe skillet clean with paper towels and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 603374,
      "primary_message": "While the beans are cooking, place eggs, salt and pepper in another medium bowl. Whisk to combine.",
      "secondary_message": "4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 603375,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are set, then remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 603376,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the beans, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 603377,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 603378,
      "primary_message": "To serve, divide beans, eggs, salsa, avocado, and cheese between bowls. Enjoy!",
      "secondary_message": "½ cup salsa\n½ cup shredded cheese, Mexican blend"
    }
  ],
