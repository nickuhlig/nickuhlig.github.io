  "instructions": [
    {
      "id": 603390,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 yellow bell peppers\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 603391,
      "primary_message": "Trim, seed, and medium dice bell peppers. ",
      "secondary_message": null
    },
    {
      "id": 603392,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 603393,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, taco seasoning, and salt; cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ cup taco seasoning\n½ tsp salt"
    },
    {
      "id": 603394,
      "primary_message": "Meanwhile, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 603395,
      "primary_message": "When the bell pepper is softened, add beans to the skillet. Continue to cook, stirring occasionally, until warmed through, 2-3 minutes more. Transfer to a medium bowl and set aside. (Wipe skillet clean with paper towels and reserve for later use.)",
      "secondary_message": null
    },
    {
      "id": 603396,
      "primary_message": "While the beans are cooking, place eggs, salt and pepper in a large bowl. Whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 603397,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are set, then remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 603398,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the beans, stir to combine, and set aside.",
      "secondary_message": null
    },
    {
      "id": 603399,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 603400,
      "primary_message": "To serve, divide beans, eggs, salsa, avocado, and cheese between bowls. Enjoy!",
      "secondary_message": "1 ½ cup salsa\n1 ½ cups shredded cheese, Mexican blend"
    }
  ],
