  "instructions": [
    {
      "primary_message": "Wash, dry, and juice lemon into a small saucepan. \n\n\n\n",
      "secondary_message": "½ lemon"
    },
    {
      "primary_message": "Wash and dry blueberries. Add to the pan with the lemon juice, along with sugar, then stir to combine. \n\n",
      "secondary_message": "1 (6 oz) pkg blueberries\ngranulated sugar"
    },
    {
      "primary_message": "Set the pan over medium-high heat and cook, stirring occasionally, until berries soften and release their juices, 5-7 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place water and cornstarch in a small bowl, then whisk to combine the slurry.\n\n",
      "secondary_message": "1 tbsp water\n½ tbsp cornstarch"
    },
    {
      "primary_message": "When the berries have released their juices, add slurry to the pan and stir to combine. Continue to cook, stirring occasionally, until compote is thickened and glossy, 1 minute more. Remove from heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Spread each bread slice with 1 tbsp of buttercream on both sides, then sprinkle with 1 tsp sugar on both sides. Repeat with remaining bread, buttercream, and sugar. \n\n",
      "secondary_message": "4 slice sourdough bread\n½ cup buttercream frosting\ngranulated sugar"
    },
    {
      "primary_message": "Preheat a large skillet over medium heat. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the skillet is hot, working in batches, place bread in the skillet and cook, turning halfway through, until golden brown, about 5 minutes. Remove to a cutting board, then cut in half. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Serve bread dippers with blueberry compote on the side and enjoy!",
      "secondary_message": null
    }
  ],
