  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Coat 12 muffin cups with cooking spray. (Alternatively, line a muffin pan with paper liners.) \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Wash, dry, quarter, and core apple; small dice. Set aside.\n\n",
      "secondary_message": "1 Gala apple"
    },
    {
      "primary_message": "Place applesauce, buttermilk, sugar, oil, egg, and vanilla in a medium bowl, then whisk to combine the wet ingredients. \n\n",
      "secondary_message": "1 cup applesauce\n½ cup reduced-fat buttermilk\n½ cup brown sugar\n2 tbsp neutral vegetable oil\n1 egg\n½ tsp vanilla extract"
    },
    {
      "primary_message": "Place oats, flour, baking powder, baking soda, cinnamon, and salt in another medium bowl, then stir to combine. Add apple and wet ingredients to the bowl, then stir once more until batter is just combined.\n\n",
      "secondary_message": "oats, old fashioned\n1 ¼ cups all-purpose flour\n1 tsp baking powder\n½ tsp baking soda\n½ tsp cinnamon, ground\n¼ tsp salt"
    },
    {
      "primary_message": "Divide batter between muffin cups (about a ⅓-cup each), then sprinkle with additional oats (if desired). Place in the preheated oven and bake until golden and a toothpick inserted in the center comes out clean, about 20 minutes. Remove from oven and set aside to cool, 15 minutes. \n\n",
      "secondary_message": "oats, old fashioned"
    },
    {
      "primary_message": "To serve, arrange muffins on a platter or pack in a lunch and enjoy!",
      "secondary_message": null
    }
  ],
