  "instructions": [
    {
      "id": 1,
      "primary_message": "Lay pork belly on cutting board and roll up lengthwise, with skin facing out.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using butchers twine, tightly secure pork belly at 2-cm intervals.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat oven to 135°C (275°F). Heat 1 cup water, soy sauce, sake, mirin, sugar, scallions, garlic, ginger, and shallot in a medium saucepan over high heat until boiling. Add pork belly (it won't be submerged). Cover with a lid left slightly ajar. Transfer to oven and cook, turning pork occasionally, until pork is fully tender and a cake tester or thin knife inserted into its center meets little resistance, 3 to 4 hours. Transfer contents to a sealed container and refrigerate until completely cool.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When ready to serve, remove pork belly and strain broth. Reserve broth for another use (like making ajitsuke tamago). Slice pork belly into thin rounds (it might help to cut it in half lengthwise first).",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Reheat pork belly slices in soup broth with noodles and other garnishes. Alternatively, heat a small amount of reserved broth in a skillet and heat pork slices in broth until hot or reheat with a blowtorch, charring its surface. Serve.",
      "secondary_message": null
    }
  ],
