  "instructions": [
    {
      "id": 374269,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 374270,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n6 medium parsnips\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 374271,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 374272,
      "primary_message": "Peel, trim, and medium dice parsnips. Add to the baking sheets with the cauliflower. Drizzle veggies with oil and season with salt; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 374273,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the veggies are golden and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 374274,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 374275,
      "primary_message": "Mince anchovy fillets. Add to the bowl with the parsley.",
      "secondary_message": "3 anchovy fillets, packed in oil"
    },
    {
      "id": 374276,
      "primary_message": "Mince capers. Add to the bowl along with oil, vinegar, and pepper. Stir to combine the salsa verde and set aside.",
      "secondary_message": "3 tbsp capers\n2 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n¾ tsp black pepper"
    },
    {
      "id": 374277,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 374278,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 374279,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 374280,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 374281,
      "primary_message": "To serve, divide steak and veggies between plates; top steak with salsa verde. Enjoy!",
      "secondary_message": null
    }
  ],
