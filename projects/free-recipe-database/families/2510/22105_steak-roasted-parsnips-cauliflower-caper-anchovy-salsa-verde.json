  "instructions": [
    {
      "id": 374243,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 374244,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n2 medium parsnips\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 374245,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 374246,
      "primary_message": "Peel, trim, and medium dice parsnips. Add to the baking sheet with the cauliflower. Drizzle veggies with oil and season with salt; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 374247,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the veggies are golden and fork-tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 374248,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 374249,
      "primary_message": "Mince anchovy fillet. Add to the bowl with the parsley.",
      "secondary_message": "1 anchovy fillet, packed in oil"
    },
    {
      "id": 374250,
      "primary_message": "Mince capers. Add to the bowl along with oil, vinegar, and pepper. Stir to combine the salsa verde and set aside.",
      "secondary_message": "1 tbsp capers\n2 tsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n¼ tsp black pepper"
    },
    {
      "id": 374251,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 374252,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 374253,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 374254,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 374255,
      "primary_message": "To serve, divide steak and veggies between plates; top steak with salsa verde. Enjoy!",
      "secondary_message": null
    }
  ],
