  "instructions": [
    {
      "id": 266113,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 266114,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n½ small bunch Italian (flat-leaf) parsley\n½ bunch kale"
    },
    {
      "id": 266115,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 266116,
      "primary_message": "Medium dice tomatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 266117,
      "primary_message": "Thinly slice olives crosswise and add to the bowl with the tomatoes.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 266118,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266119,
      "primary_message": "Add vinegar, capers, salt, and pepper to the bowl; stir to combine and set aside.",
      "secondary_message": "1 ½ tbsp balsamic vinegar\n1 tbsp capers\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 266120,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, place in another medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 266121,
      "primary_message": "Preheat a skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 266122,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 266123,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and cook, stirring frequently, until fragrant, about 30 seconds.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 266124,
      "primary_message": "Add chickpeas to the skillet, season with spices, and stir to combine. Cook, stirring occasionally, until the chickpeas are warmed through, about 2 minutes.",
      "secondary_message": "½ tsp basil, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 266125,
      "primary_message": "When the chickpeas are warm, add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Stir to combine, then transfer to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 266126,
      "primary_message": "When the pasta is done, drain and add to the bowl; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 266127,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    }
  ],
