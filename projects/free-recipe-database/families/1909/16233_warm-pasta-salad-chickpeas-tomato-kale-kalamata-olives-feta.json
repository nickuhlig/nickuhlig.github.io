  "instructions": [
    {
      "id": 265948,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n10 oz rotini pasta"
    },
    {
      "id": 265949,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 bunch kale"
    },
    {
      "id": 265950,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 265951,
      "primary_message": "Medium dice tomatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 265952,
      "primary_message": "Thinly slice olives crosswise and add to the bowl with the tomatoes.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 265953,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 265954,
      "primary_message": "Add vinegar, capers, salt, and pepper to the bowl; stir to combine and set aside.",
      "secondary_message": "3 tbsp balsamic vinegar\n2 tbsp capers\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 265955,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 265956,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 265957,
      "primary_message": "Preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 265958,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and cook, stirring frequently, until fragrant, about 30 seconds.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 265959,
      "primary_message": "Add chickpeas to the skillet, season with spices, and stir to combine. Cook, stirring occasionally, until the chickpeas are warmed through, about 2 minutes.",
      "secondary_message": "1 tsp basil, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 265960,
      "primary_message": "When the chickpeas are warm, add kale to the skillet in handfuls, waiting for the kale to wilt slightly before adding the next handful. Stir to combine, then transfer to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 265961,
      "primary_message": "When the pasta is done, drain and add to the bowl; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 265962,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    }
  ],
