  "instructions": [
    {
      "id": 266143,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 266144,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "9 tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 ½ bunches kale"
    },
    {
      "id": 266145,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 266146,
      "primary_message": "Medium dice tomatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 266147,
      "primary_message": "Thinly slice olives crosswise and add to the bowl with the tomatoes.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 266148,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 266149,
      "primary_message": "Add vinegar, capers, salt, and pepper to the bowl; stir to combine and set aside.",
      "secondary_message": "¼ cup balsamic vinegar\n3 tbsp capers\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 266150,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces, place in a medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 266151,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 266152,
      "primary_message": "Preheat another large pot over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 266153,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and cook, stirring frequently, until fragrant, about 30 seconds.",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 266154,
      "primary_message": "Add chickpeas to the pot, season with spices, and stir to combine. Cook, stirring occasionally, until the chickpeas are warmed through, 3-4 minutes.",
      "secondary_message": "1 ½ tsp basil, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 266155,
      "primary_message": "When the chickpeas are warm, add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Stir to combine, then transfer to the bowl with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 266156,
      "primary_message": "When the pasta is done, drain and add to the bowl; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 266157,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
