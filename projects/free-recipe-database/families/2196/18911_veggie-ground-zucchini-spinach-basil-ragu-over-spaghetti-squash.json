  "instructions": [
    {
      "id": 433230,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 433231,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium spaghetti squash\n1 medium zucchini squash\n1 tomato\n½ (5 oz) pkg baby spinach\n½ small pkg fresh basil"
    },
    {
      "id": 433232,
      "primary_message": "Trim squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 433233,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 433234,
      "primary_message": "While the squash roasts, preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 433235,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n8 oz veggie ground, plant based"
    },
    {
      "id": 433236,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 433237,
      "primary_message": "Trim and medium dice zucchini; small dice tomato. Add both to the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 433238,
      "primary_message": "Once the veggie ground is browned, add veggies and spices to the pan; cook, stirring occasionally, until veggies soften, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 ½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 433239,
      "primary_message": "Add tomato sauce to the pan; stir to combine the sauce and continue to cook until slightly thickened, 3-4 minutes more. ",
      "secondary_message": "1 (8 oz) can tomato sauce"
    },
    {
      "id": 433240,
      "primary_message": "Meanwhile, roughly chop spinach; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place both in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 433241,
      "primary_message": "When the sauce is done, add spinach and basil to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine, remove from heat, and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 433242,
      "primary_message": "Remove squash from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 433243,
      "primary_message": "To serve, divide squash and ragù between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
