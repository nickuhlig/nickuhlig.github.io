  "instructions": [
    {
      "id": 433258,
      "primary_message": "Preheat oven to 500°F and place rack in the center position. Line two baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 433259,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium spaghetti squash\n3 medium zucchini squash\n3 tomatoes\n1 ½ (5 oz) pkgs baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 433260,
      "primary_message": "Trim each squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheets.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 433261,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 433262,
      "primary_message": "While the squash roasts, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 433263,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 433264,
      "primary_message": "Meanwhile, peel and mince garlic; place in a large bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 433265,
      "primary_message": "Trim and medium dice zucchini; small dice tomatoes. Add both to the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 433266,
      "primary_message": "Once the veggie ground is browned, add veggies and spices to the pot; cook, stirring occasionally, until veggies soften, 4-5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 ½ tbsp oregano, dried\n1 ½ tsp salt\n1 ½ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 433267,
      "primary_message": "Add tomato sauce to the pot; stir to combine the sauce and continue to cook until slightly thickened, 4-5 minutes more. ",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 433268,
      "primary_message": "Meanwhile, roughly chop spinach; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place both in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 433269,
      "primary_message": "When the sauce is done, add spinach and basil to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine, remove from heat, and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 433270,
      "primary_message": "Remove squash from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 433271,
      "primary_message": "To serve, divide squash and ragù between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
