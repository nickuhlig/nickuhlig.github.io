  "instructions": [
    {
      "id": 433287,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 433288,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 medium spaghetti squash\n2 medium zucchini squash\n2 tomatoes\n1 (142 g) pkg baby spinach\n1 small pkg fresh basil"
    },
    {
      "id": 433289,
      "primary_message": "Trim each squash, halve lengthwise, and scrape out the seeds. Rub the inside of the squash with oil and season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 433290,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 433291,
      "primary_message": "While the squash roasts, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 433292,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add the sausage and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n0.45 kg ground pork sausage"
    },
    {
      "id": 433293,
      "primary_message": "Meanwhile, peel and mince garlic; place in a medium bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 433294,
      "primary_message": "Trim and medium dice zucchini; small dice tomatoes. Add both to the bowl with the garlic. ",
      "secondary_message": null
    },
    {
      "id": 433295,
      "primary_message": "Once the pork is browned, add veggies and spices to the pot; cook, stirring occasionally, until veggies soften, 2-3 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp oregano, dried\n1 ½ tsp salt\n1 tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 433296,
      "primary_message": "Add tomato sauce to the pot; stir to combine the sauce and continue to cook until slightly thickened, 3-4 minutes more. ",
      "secondary_message": "2 (213 ml) cans tomato sauce"
    },
    {
      "id": 433297,
      "primary_message": "Meanwhile, roughly chop spinach; pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place both in the reserved bowl. ",
      "secondary_message": null
    },
    {
      "id": 433298,
      "primary_message": "When the sauce is done, add spinach and basil to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine, remove from heat, and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 433299,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 433300,
      "primary_message": "Remove squash from the oven; allow to cool slightly, about 5 minutes. Scrape the inside of the squash with a fork to separate into spaghetti-like strands. (Use an oven mitt or towel to hold it with your other hand.)",
      "secondary_message": null
    },
    {
      "id": 433301,
      "primary_message": "To serve, divide squash and ragù between plates or bowls; top with Parmesan and enjoy! ",
      "secondary_message": null
    }
  ],
