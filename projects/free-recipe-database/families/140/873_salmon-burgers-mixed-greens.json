  "instructions": [
    {
      "id": 16254,
      "primary_message": "Wash and dry green onions. Trim and discard root ends, chop, and transfer to a medium bowl.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 16255,
      "primary_message": "Small dice salmon and add to bowl with onions.",
      "secondary_message": "0.34 kg salmon fillet"
    },
    {
      "id": 16256,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 16257,
      "primary_message": "Add bread crumbs, lemon juice, Dijon, salt, and pepper to bowl with salmon and onions. Mix well and shape into 2 patties.",
      "secondary_message": "⅛ cup panko bread crumbs\r\njuice of ¼ lemon\r\n1 tsp Dijon mustard\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 16258,
      "primary_message": "Coat grill or bottom of skillet with oil. Add salmon patties and grill until cooked through, 3-4 minutes per side.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 16259,
      "primary_message": "Wash and dry greens and tomato. Slice tomato into rounds.",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)\r\n1 tomato"
    },
    {
      "id": 16260,
      "primary_message": "In a small bowl, prepare salad dressing by whisking together lemon juice, olive oil, Dijon, salt, and pepper.",
      "secondary_message": "juice of ¼ lemon\r\n1 ½ tbsp extra virgin olive oil\r\n⅛ tsp Dijon mustard\r\n1 pinch salt\r\n1 pinch black pepper"
    },
    {
      "id": 16261,
      "primary_message": "Toast buns or rolls on the grill or skillet. Spread the inside with mayo.",
      "secondary_message": "2 whole grain buns or rolls\r\n1 tbsp mayonnaise"
    },
    {
      "id": 16262,
      "primary_message": "To serve, place a few greens and salmon patties on the bottom of the buns, top with tomato rounds, and close the burgers. Place remaining mixed greens on the side and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
