  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Crush the cardamom pods to release seeds. Finely chop the bittersweet chocolate. Melt the unsalted butter and let it cool. Chop the pistachios.",
      "secondary_message": "5 cardamom pods\n57 g bittersweet chocolate\n1 ½ tbsp unsalted butter\n¼ cup pistachios"
    },
    {
      "id": 1,
      "primary_message": "In large saucepan over medium heat, combine sugar, water, honey, saffron, and cardamom. Heat, stirring to dissolve sugar, until mixture just comes to boil. Turn off heat and keep warm.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In medium bowl, combine milk powder, flour, baking soda, and salt. Stir in chocolate, butter, and milk until mixture forms a medium stiff dough. Roll into large gumball sized balls (you should get approximately 16). Place in single layer on plate and cover with damp towel until ready to fry.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In large dutch oven or heavy duty pot, heat oil to 170°C (340°F). Test one ball by dropping it in the oil. It should start to turn golden in 20 seconds. Carefully drop the dough balls in the oil and fry, stirring and turning, until an even deep brown color, 1 to 2 minutes. Remove from oil and briefly drain on a paper towel lined plate.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Immerse the gulab jamun in the syrup and let soak for 2 to 3 hours before serving. Sprinkle pistachios and serve.",
      "secondary_message": null
    }
  ],
