  "instructions": [
    {
      "id": 220728,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 sticks celery\n3 medium zucchini squash"
    },
    {
      "id": 220729,
      "primary_message": "Peel and small dice onions. Peel, trim, and small dice carrots. Transfer both to a medium bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 220730,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 220731,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 220732,
      "primary_message": "While the pot heats up, peel and mince garlic. Place half in a small bowl and set aside.",
      "secondary_message": "9 cloves garlic"
    },
    {
      "id": 220733,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 220734,
      "primary_message": "Add veggies, remaining garlic, and spices to the pot. Cook, stirring occasionally, until veggies are soft, 6-7 minutes.",
      "secondary_message": "¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 220735,
      "primary_message": "Meanwhile, drain and rinse chickpeas; working in batches if necessary, transfer to a blender, along with broth, and blend until smooth. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 220736,
      "primary_message": "Trim and medium dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 220737,
      "primary_message": "Add chickpea mixture, additional broth, and zucchini to the pot, stir to combine, and bring soup to a simmer. Cook, stirring occasionally, until veggies are tender, 5-7 minutes. ",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth"
    },
    {
      "id": 220738,
      "primary_message": "Meanwhile, preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 220739,
      "primary_message": "Divide pitas between two baking sheet pans, drizzle with oil, and sprinkle with reserved garlic, salt, and rosemary. Working in batches, place in the oven and broil until golden and toasted, 2-3 minutes. Remove from the oven.",
      "secondary_message": "6 whole grain pitas\n1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch rosemary"
    },
    {
      "id": 220740,
      "primary_message": "Cut pitas into quarters.",
      "secondary_message": null
    },
    {
      "id": 220741,
      "primary_message": "Divide soup between bowls and drizzle with oil. Serve with pita on the side and enjoy!",
      "secondary_message": "2 tbsp extra virgin olive oil"
    }
  ],
