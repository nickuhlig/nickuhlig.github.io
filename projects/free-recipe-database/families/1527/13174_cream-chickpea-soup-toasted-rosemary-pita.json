  "instructions": [
    {
      "id": 220742,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n1 medium zucchini squash"
    },
    {
      "id": 220743,
      "primary_message": "Peel and small dice onion. Peel, trim, and small dice carrots. Transfer both to a medium bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 220744,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 220745,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 220746,
      "primary_message": "While the saucepan heats up, peel and mince garlic. Place half in a small bowl and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 220747,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 220748,
      "primary_message": "Add veggies, remaining garlic, and spices to the saucepan. Cook, stirring occasionally, until veggies are soft, 5-6 minutes.",
      "secondary_message": "¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 220749,
      "primary_message": "Meanwhile, drain and rinse chickpeas; transfer to a blender, along with broth, and blend until smooth.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n473 ml chicken or vegetable broth"
    },
    {
      "id": 220750,
      "primary_message": "Trim and medium dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 220751,
      "primary_message": "Add chickpea mixture and zucchini to the saucepan, stir to combine, and bring soup to a simmer. Cook, stirring occasionally, until veggies are tender, 5-7 minutes. ",
      "secondary_message": null
    },
    {
      "id": 220752,
      "primary_message": "Meanwhile, preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 220753,
      "primary_message": "Place pitas on a baking sheet pan, drizzle with oil, and sprinkle with reserved garlic, salt, and rosemary. Place in the oven and broil until golden and toasted, 2-3 minutes. Remove from the oven.",
      "secondary_message": "2 whole grain pitas\n1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch rosemary"
    },
    {
      "id": 220754,
      "primary_message": "Cut pitas into quarters.",
      "secondary_message": null
    },
    {
      "id": 220755,
      "primary_message": "Divide soup between bowls and drizzle with oil. Serve with pita on the side and enjoy!",
      "secondary_message": "2 tsp extra virgin olive oil"
    }
  ],
