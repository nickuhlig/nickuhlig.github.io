  "instructions": [
    {
      "id": 462527,
      "primary_message": "Place spices in a medium bowl and stir to combine.",
      "secondary_message": "1 tsp garam masala\n1 tsp turmeric, ground\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 462528,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462529,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and thinly slice across the grain. Add to the bowl with the spices and toss to coat.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak"
    },
    {
      "id": 462530,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and pan-fry until almost cooked through, 1-2 minutes per side. Remove to a clean plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 462531,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 red bell peppers\n2 medium zucchini squash\n1 lime\n1 small bunch cilantro"
    },
    {
      "id": 462532,
      "primary_message": "Using a clean cutting board, peel and mince ginger. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 462533,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the ginger.",
      "secondary_message": null
    },
    {
      "id": 462534,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 462535,
      "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 462536,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add veggies, chili-garlic sauce, salt, and pepper; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "4 tsp virgin coconut oil\n1 tsp chili-garlic sauce\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 462537,
      "primary_message": "Add coconut milk and stir to combine the curry. Continue to cook, stirring occasionally, until slightly thickened, 4-5 minutes more.",
      "secondary_message": "1 (13.5 fl oz) can coconut milk"
    },
    {
      "id": 462538,
      "primary_message": "Meanwhile, cut lime into wedges. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 462539,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 462540,
      "primary_message": "When the curry has thickened, return steak to the skillet, along with half of the cilantro, and stir to combine. Continue to cook, stirring occasionally, until steak is warmed through, 1-2 minutes more. Remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 462541,
      "primary_message": "Divide steak curry between plates or bowls and top with remaining cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
