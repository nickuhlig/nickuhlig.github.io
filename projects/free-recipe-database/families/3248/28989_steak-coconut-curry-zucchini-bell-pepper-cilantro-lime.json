  "instructions": [
    {
      "id": 462587,
      "primary_message": "Place spices in a large bowl and stir to combine.",
      "secondary_message": "1 ½ tsp garam masala\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 462588,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 462589,
      "primary_message": "While the pot heats up, pat steak dry with paper towels and thinly slice across the grain. Add to the bowl with the spices and toss to coat.",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 462590,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and pan-fry until almost cooked through, 1-2 minutes per side. Remove to a clean plate. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 462591,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 red bell peppers\n3 medium zucchini squash\n1 ½ limes\n1 small bunch cilantro"
    },
    {
      "id": 462592,
      "primary_message": "Using a clean cutting board, peel and mince ginger. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 462593,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl with the ginger.",
      "secondary_message": null
    },
    {
      "id": 462594,
      "primary_message": "Trim and quarter zucchini lengthwise, then cut crosswise into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 462595,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 462596,
      "primary_message": "Return pot to medium heat, add more oil, and swirl to coat the bottom. Add veggies, chili-garlic sauce, salt, and pepper; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n1 ½ tsp chili-garlic sauce\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 462597,
      "primary_message": "Add coconut milk and stir to combine the curry. Continue to cook, stirring occasionally, until slightly thickened, 5-6 minutes more.",
      "secondary_message": "1 ½ (398 ml) cans coconut milk"
    },
    {
      "id": 462598,
      "primary_message": "Meanwhile, cut limes into wedges. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 462599,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 462600,
      "primary_message": "When the curry has thickened, return steak to the pot, along with half of the cilantro, and stir to combine. Continue to cook, stirring occasionally, until steak is warmed through, 2-3 minutes more. Remove from heat. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 462601,
      "primary_message": "Divide steak curry between plates or bowls and top with remaining cilantro. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
