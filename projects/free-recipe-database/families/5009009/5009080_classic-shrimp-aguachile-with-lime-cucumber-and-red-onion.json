  "instructions": [
    {
      "id": 1,
      "primary_message": "Split shrimp in half lengthwise and discard any veins. Transfer to a plate, sprinkle all over with salt, cover with plastic, and refrigerate at least 1 hour and up to 2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a mortar and pestle, combine chilies with a pinch of salt and pulverize thoroughly, then add water and continue to work until chilies are reduced to tiny bits. Alternatively, blend chilies with water in a blender or with an immersion blender until thoroughly blended. Add lime juice and season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a mixing bowl, toss shrimp with chili-lime marinade, onion, and cucumber. Season once more with salt and pepper and serve right away with tostadas and avocado.",
      "secondary_message": null
    }
  ],
