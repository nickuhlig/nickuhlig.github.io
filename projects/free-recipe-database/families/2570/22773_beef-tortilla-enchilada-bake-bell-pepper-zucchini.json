  "instructions": [
    {
      "id": 417794,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 417795,
      "primary_message": "Wash, dry, and trim zucchini. Small dice and place in a medium bowl.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 417796,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 417797,
      "primary_message": "Once the pot is hot, add beef, taco seasoning, and salt. Cook, breaking the meat apart with a spoon, until almost cooked through, about 4 minutes.",
      "secondary_message": "1.02 kg lean ground beef\n¼ cup taco seasoning\n¾ tsp salt"
    },
    {
      "id": 417798,
      "primary_message": "While the beef is cooking, wash, dry, trim, and seed bell peppers. Small dice and add to the bowl with the zucchini.",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 417799,
      "primary_message": "Add zucchini and bell pepper to the pot with the beef. Continue to cook, stirring occasionally, until beef is cooked through and veggies are softened, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 417800,
      "primary_message": "Meanwhile, chop or tear tortillas into 2-inch pieces.",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 417801,
      "primary_message": "When the veggies are done, add tortillas, salsa, and yogurt to the pot; stir to combine. Continue to cook until heated through, 3-4 minutes. Remove from heat.",
      "secondary_message": "3 cup salsa\n¾ cup plain Greek yogurt"
    },
    {
      "id": 417802,
      "primary_message": "Transfer to a large baking dish and top with cheese. Place in the oven and bake until cheese is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 417803,
      "primary_message": "To serve, divide bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
