  "instructions": [
    {
      "id": 417724,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 417725,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 417726,
      "primary_message": "While the skillet heats up, wash, dry, and trim zucchini. Small dice and place in a medium bowl.",
      "secondary_message": "2 medium zucchini squash"
    },
    {
      "id": 417727,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground, taco seasoning, and salt; cook, breaking it apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "16 oz veggie ground, plant based\n4 tsp extra virgin olive oil\n3 tbsp taco seasoning\n½ tsp salt"
    },
    {
      "id": 417728,
      "primary_message": "While the veggie ground is cooking, wash, dry, trim, and seed bell peppers. Small dice and add to the bowl with the zucchini.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 417729,
      "primary_message": "Add zucchini and bell pepper to the skillet with the veggie ground. Continue to cook, stirring occasionally, until veggie ground is cooked through and vegetables are softened, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 417730,
      "primary_message": "Meanwhile, chop or tear tortillas into 2-inch pieces.",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 417731,
      "primary_message": "When the veggies are done, add tortillas, salsa, and yogurt to the skillet; stir to combine. Continue to cook until heated through, about 2 minutes. Remove from heat.",
      "secondary_message": "2 cup salsa\n½ cup plain Greek yogurt"
    },
    {
      "id": 417732,
      "primary_message": "Top skillet with cheese and place in the oven. Bake until cheese is melted and golden, 7-8 minutes. Remove from oven.",
      "secondary_message": "1 cup shredded cheese, Mexican blend"
    },
    {
      "id": 417733,
      "primary_message": "To serve, divide skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
