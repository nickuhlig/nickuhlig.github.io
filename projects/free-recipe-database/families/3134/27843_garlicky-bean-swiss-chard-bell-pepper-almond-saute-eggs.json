  "instructions": [
    {
      "id": 447199,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips.",
      "secondary_message": "6 red bell peppers"
    },
    {
      "id": 447200,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 447201,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add peppers and salt. Cook, stirring occasionally, until tender and starting to brown, 12-14 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 447202,
      "primary_message": "While the peppers are cooking, fill another large pot about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pot is boiling, reduce heat to medium-low.",
      "secondary_message": "2 tbsp red wine vinegar"
    },
    {
      "id": 447203,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a large bowl and stems in a small bowl.",
      "secondary_message": "1 ½ bunches Swiss chard"
    },
    {
      "id": 447204,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the stems and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 447205,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 447206,
      "primary_message": "When the peppers are tender, add chard stems, garlic, smoked paprika, and salt to the pot. Cook, stirring occasionally, until garlic is fragrant, about 1 minute.",
      "secondary_message": "1 tbsp smoked paprika\n¾ tsp salt"
    },
    {
      "id": 447207,
      "primary_message": "Add beans to the pot and continue to cook, stirring occasionally, until warmed through, 1 minute more.",
      "secondary_message": null
    },
    {
      "id": 447208,
      "primary_message": "Add chard leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Add vinegar and stir to combine. Remove from heat and set aside.",
      "secondary_message": "1 ½ tbsp red wine vinegar"
    },
    {
      "id": 447209,
      "primary_message": "Gently crack eggs into additional small bowls (two eggs per bowl).",
      "secondary_message": "12 eggs"
    },
    {
      "id": 447210,
      "primary_message": "Adjust the heat of the pot as necessary so that the water is simmering. Working in batches, gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using the slotted spoon, transfer eggs to a plate, then season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 447211,
      "primary_message": "Meanwhile, roughly chop almonds.",
      "secondary_message": "1 cup almonds"
    },
    {
      "id": 447212,
      "primary_message": "To serve, divide veggies between plates or bowls; top with almonds and poached eggs. Enjoy!",
      "secondary_message": null
    }
  ],
