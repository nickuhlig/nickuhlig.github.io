  "instructions": [
    {
      "id": 447171,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 447172,
      "primary_message": "While the skillet heats up, wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips.",
      "secondary_message": "2 red bell peppers"
    },
    {
      "id": 447173,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers and salt. Cook, stirring occasionally, until tender and starting to brown, about 10 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 447174,
      "primary_message": "While the peppers are cooking, fill a medium saucepan about halfway with hot water (from the tap); add vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pan is boiling, reduce heat to medium-low.",
      "secondary_message": "1 tbsp red wine vinegar"
    },
    {
      "id": 447175,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl and stems in a small bowl.",
      "secondary_message": "½ bunch Swiss chard"
    },
    {
      "id": 447176,
      "primary_message": "Peel and thinly slice garlic. Add to the bowl with the stems and set aside.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 447177,
      "primary_message": "Drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 447178,
      "primary_message": "When the peppers are tender, add chard stems, garlic, smoked paprika, and salt to the skillet. Cook, stirring occasionally, until garlic is fragrant, about 30 seconds.",
      "secondary_message": "1 tsp smoked paprika\n¼ tsp salt"
    },
    {
      "id": 447179,
      "primary_message": "Add beans to the skillet and continue to cook, stirring occasionally, until warmed through, about 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 447180,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Add vinegar and stir to combine. Remove from heat and set aside.",
      "secondary_message": "1 ½ tsp red wine vinegar"
    },
    {
      "id": 447181,
      "primary_message": "Gently crack eggs into two additional small bowls (two eggs per bowl).",
      "secondary_message": "4 eggs"
    },
    {
      "id": 447182,
      "primary_message": "Adjust the heat of the saucepan as necessary so that the water is simmering. Gently tip bowls into the pan, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using the slotted spoon, transfer eggs to a plate, then season with salt and pepper.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 447183,
      "primary_message": "Meanwhile, roughly chop almonds.",
      "secondary_message": "⅓ cup almonds"
    },
    {
      "id": 447184,
      "primary_message": "To serve, divide veggies between plates or bowls; top with almonds and poached eggs. Enjoy!",
      "secondary_message": null
    }
  ],
