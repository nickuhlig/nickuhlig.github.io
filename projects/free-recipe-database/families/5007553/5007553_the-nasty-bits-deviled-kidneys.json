  "instructions": [
    {
      "id": 1,
      "primary_message": "To prep the kidneys: Cut kidneys in half and carefully remove the gristly white centers with a paring knife. For lamb's kidneys, quarter them. For pig's kidneys, cut into bite-size chunks, approximately 1-inch across.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat a little fat in a frying pat and add the kidneys, sauteing for just a brief minute to brown. Add the wine and let it bubble for 30 seconds. Add the vinegar and simmer for 10 to 20 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the jelly, mustard, and cayenne pepper, stirring the kidneys to mix all of the elements together. Add the Worcestershire sauce, and let the liquid simmer for 20 seconds until it is slightly reduced. Taste for balance. Depending on your taste for kidneys, you may want to add more sour or spicy elements.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Finish by taking the pan off the heat and adding in the heavy cream, stirring to mix.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Serve with toast or rice, garnishing with parsley if desired.",
      "secondary_message": null
    }
  ],
