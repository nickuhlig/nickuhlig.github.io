  "instructions": [
    {
      "id": 239631,
      "primary_message": "Wash, dry, peel, and mince ginger; transfer to a large pot.",
      "secondary_message": "3 (1 inch) pieces ginger root"
    },
    {
      "id": 239632,
      "primary_message": "Add both milks and dates to the pot with the ginger; bring to a simmer over medium-high heat. (Watch the milk carefully, so it does not boil over.) Remove from heat and allow to cool slightly, about 5 minutes.",
      "secondary_message": "48 fl oz (6 cups) almond milk, unsweetened\n1 ½ (13.5 fl oz) cans coconut milk\n1 cup medjool dates, pitted"
    },
    {
      "id": 239633,
      "primary_message": "Working in batches if necessary, transfer cooled date-milk to a blender. Add vanilla and spices; blend on high until smooth, 1-2 minutes. (Reserve pot for next step.)",
      "secondary_message": "1 ½ tsp vanilla extract\n1 tbsp turmeric, ground\n¾ tsp cinnamon, ground\n½ tsp cardamom, ground\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 239634,
      "primary_message": "Pour the golden milk through a strainer set over the pot; discard solids. Reheat over medium-high heat to preferred temperature.",
      "secondary_message": null
    },
    {
      "id": 239635,
      "primary_message": "To serve, divide golden milk between mugs and enjoy!",
      "secondary_message": null
    }
  ],
