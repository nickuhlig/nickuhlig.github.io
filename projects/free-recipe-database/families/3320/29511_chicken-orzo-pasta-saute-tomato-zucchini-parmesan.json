  "instructions": [
    {
      "id": 470541,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "1 ½ tsp salt\n15 oz orzo pasta"
    },
    {
      "id": 470542,
      "primary_message": "Meanwhile, preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470543,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 470544,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add chicken and spices; cook, stirring frequently, until chicken is golden and cooked through, 5-7 minutes. Transfer chicken to a plate and set aside. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "2 tbsp butter, unsalted\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 470545,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n6 medium zucchini squash\n1 small pkg fresh basil"
    },
    {
      "id": 470546,
      "primary_message": "Using a clean cutting board, small dice tomatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 470547,
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 470548,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 470549,
      "primary_message": "Return pot (with cooking juices) to medium-high heat, add more butter, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 ½ tsp salt\n¾ tsp crushed red pepper\n½ tsp black pepper"
    },
    {
      "id": 470550,
      "primary_message": "Add cooked orzo, chicken, and broth to the pot with the veggies. Cook, stirring occasionally, until liquid is mostly absorbed, 7-8 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 470551,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 470552,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 470553,
      "primary_message": "When the liquid is mostly absorbed, remove orzo from heat. Add Parmesan and basil, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 470554,
      "primary_message": "To serve, divide orzo sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
