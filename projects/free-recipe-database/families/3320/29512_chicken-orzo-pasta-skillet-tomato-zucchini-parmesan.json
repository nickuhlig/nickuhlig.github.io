  "instructions": [
    {
      "id": 470555,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and orzo, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and set aside.",
      "secondary_message": "½ tsp salt\n142 g orzo pasta"
    },
    {
      "id": 470556,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470557,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 470558,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chicken and spices; cook, stirring frequently, until chicken is golden and cooked through, about 5 minutes. Transfer chicken to a plate and set aside. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tsp butter, unsalted\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 470559,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n2 medium zucchini squash\n½ small pkg fresh basil"
    },
    {
      "id": 470560,
      "primary_message": "Using a clean cutting board, small dice tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 470561,
      "primary_message": "Trim and small dice zucchini. Add to the bowl with the tomato.",
      "secondary_message": null
    },
    {
      "id": 470562,
      "primary_message": "Peel, halve, and small dice onion. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 470563,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat, add more butter, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n½ tsp salt\n¼ tsp crushed red pepper\n⅛ tsp black pepper"
    },
    {
      "id": 470564,
      "primary_message": "Add cooked orzo, chicken, and broth to the skillet. Cook, stirring occasionally, until liquid is mostly absorbed, 7-8 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 470565,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 470566,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 470567,
      "primary_message": "When the orzo skillet is done, remove from heat. Add Parmesan and basil, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 470568,
      "primary_message": "To serve, divide skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
