  "instructions": [
    {
      "primary_message": "If using a frozen turkey, thaw in the fridge for 2-3 days. If using a fresh turkey, skip this step.",
      "secondary_message": "5.44 kg whole turkey, fresh or frozen"
    },
    {
      "primary_message": "About 4 hours before you plan to serve the turkey, set it on the counter and allow to come to room temperature for 1 hour.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the turkey has come to room temperature, preheat oven to 325°F. Place oven rack in the lower position.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry and quarter orange (leaving the peel on).",
      "secondary_message": "1 orange"
    },
    {
      "primary_message": "Wash, dry, trim, and halve celery crosswise. ",
      "secondary_message": "2 stick celery"
    },
    {
      "primary_message": "Peel, trim, and quarter onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "primary_message": "Place spices in a small bowl; stir to combine the spice mix. ",
      "secondary_message": "2 tbsp Italian seasoning\n2 tbsp salt\n1 tbsp black pepper\n1 tbsp paprika\n2 tsp garlic powder\n2 tsp ground mustard"
    },
    {
      "primary_message": "Pat turkey dry with paper towels and place in a roasting pan, breast-side up.  ",
      "secondary_message": null
    },
    {
      "primary_message": "Season inside of turkey with 1 tablespoon of the spice mix, then stuff with the orange, celery, onion, and bay leaves. (Reserve remaining spice mix for the next step.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Brush turkey breast and legs with oil, then sprinkle with remaining spice mix. Pour ½-cup water around turkey, then loosely tent with aluminum foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "primary_message": "Place turkey in the oven and roast for 1 hour, then remove foil (reserve it for later use). Continue to roast until the middle of a thigh or breast reaches 165°F on a thermometer, 2 – 2 ½ hours more, basting with the pan juices every 30 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Remove roasting pan from the oven and transfer turkey to a cutting board. Loosely cover with reserved foil and let rest, 20 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Carve the turkey and serve. ",
      "secondary_message": null
    }
  ],
