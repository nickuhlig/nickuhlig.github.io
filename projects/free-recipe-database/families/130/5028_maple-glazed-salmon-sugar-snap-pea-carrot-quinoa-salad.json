  "instructions": [
    {
      "id": 60977,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": ""
    },
    {
      "id": 60976,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, uncovered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n708 ml (3 cups) chicken or vegetable broth"
    },
    {
      "id": 60975,
      "primary_message": "Place salmon fillets in a baking dish and season with salt and pepper. Place in the oven and broil for 3 minutes.",
      "secondary_message": "1.02 kg salmon fillets\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 60974,
      "primary_message": "In a small bowl, combine soy sauce, maple syrup, Dijon, and pepper.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp pure maple syrup\n3 tsp Dijon mustard\n⅜ tsp black pepper"
    },
    {
      "id": 60973,
      "primary_message": "Take salmon out of the oven and spoon sauce over top. Return to oven and cook until salmon is opaque, another 5-6 minutes.",
      "secondary_message": ""
    },
    {
      "id": 60972,
      "primary_message": "Peel and mince garlic. In large bowl, prepare dressing by whisking together garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n4 ½ tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 60971,
      "primary_message": "Wash peas and carrots. Halve the peas and add to bowl with dressing. Peel, coarsely grate, and add the carrots to bowl.",
      "secondary_message": "3 (227 g) pkg sugar snap peas\n3 medium carrots"
    },
    {
      "id": 60970,
      "primary_message": "Uncover quinoa and fluff with a fork. Add to bowl and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 60969,
      "primary_message": "To serve, place quinoa salad on a plate and add salmon on top. Enjoy!",
      "secondary_message": ""
    }
  ],
