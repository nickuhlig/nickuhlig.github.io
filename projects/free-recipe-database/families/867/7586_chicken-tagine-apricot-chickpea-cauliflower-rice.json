  "instructions": [
    {
      "id": 139111,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 (2 ½ cm) pieces ginger root\n1 medium head cauliflower"
    },
    {
      "id": 139112,
      "primary_message": "Pat the chicken thighs dry with paper towels and place on a plate; season generously with salt and pepper on both sides. ",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 139113,
      "primary_message": "Preheat a large pot over medium-high heat. When the pot is hot add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 139114,
      "primary_message": "Add chicken to the pot and sear, flipping once, until golden brown on both sides, about 6 minutes. Once seared, remove chicken from the pot and set aside on a plate. ",
      "secondary_message": null
    },
    {
      "id": 139115,
      "primary_message": "Meanwhile, peel and small dice the onion and carrots. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 139116,
      "primary_message": "After removing the chicken, add onion and carrot to the pot and cook, stirring occasionally, until softened, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 139117,
      "primary_message": "Peel and mince the garlic and ginger. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 139118,
      "primary_message": "Add garlic to the pot and cook for 30 seconds. Add ginger and spices and cook until fragrant, about 1 minute. ",
      "secondary_message": "2 tsp coriander\n2 tsp cumin\n2 tsp cinnamon\n1 tsp salt"
    },
    {
      "id": 139119,
      "primary_message": "Add broth and scrape any brown bits from the bottom of the pot. Return chicken to the pot, fitting the pieces into a single layer. Increase heat to high and bring liquid to a boil. Reduce heat to low, cover, and simmer until chicken is cooked through, about 8 minutes. ",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 139120,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 139121,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 139122,
      "primary_message": "Small dice apricots.",
      "secondary_message": "12 dried apricots"
    },
    {
      "id": 139123,
      "primary_message": "Using tongs, remove chicken from pot; transfer to a plate and loosely cover with foil.",
      "secondary_message": null
    },
    {
      "id": 139124,
      "primary_message": "Add cauliflower, chickpeas, almonds, and apricots to the pot. Increase the heat to medium-high and cook for 5 minutes. ",
      "secondary_message": "½ cup almonds, sliced"
    },
    {
      "id": 139125,
      "primary_message": "Use a slotted spoon to dish the cauliflower mixture onto plates, leaving any excess liquid in the pot. Top with chicken and enjoy! ",
      "secondary_message": null
    }
  ],
