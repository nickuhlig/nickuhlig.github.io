  "instructions": [
    {
      "id": 139153,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n4 (2 ½ cm) pieces ginger root\n2 medium heads cauliflower"
    },
    {
      "id": 139154,
      "primary_message": "Drain and rinse the chickpeas; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 139155,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 139156,
      "primary_message": "Peel and small dice the onion and carrots. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 139157,
      "primary_message": "Preheat a large pot over medium-high heat. When the pot is hot add oil and swirl to coat the bottom. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 139158,
      "primary_message": "Add onions and carrots to the pot and cook, stirring occasionally, until softened, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 139159,
      "primary_message": "Meanwhile, peel and mince the garlic and ginger. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 139160,
      "primary_message": "Add garlic to the pot and cook for 30 seconds. Add ginger and spices and cook until fragrant, about 1 minute. ",
      "secondary_message": "2 tsp coriander\n2 tsp cumin\n2 tsp cinnamon\n1 tsp salt"
    },
    {
      "id": 139161,
      "primary_message": "Add broth, increase heat to high and bring the liquid to a boil.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 139162,
      "primary_message": "Small dice apricots.",
      "secondary_message": "16 dried apricots"
    },
    {
      "id": 139163,
      "primary_message": "Reduce heat to medium. Add cauliflower, chickpeas, almonds, and apricots to the pot and cook for 5 minutes. ",
      "secondary_message": "1 cup almonds, sliced"
    },
    {
      "id": 139164,
      "primary_message": "Use a slotted spoon to dish the cauliflower mixture into bowls, leaving any excess liquid in the pot. Enjoy! ",
      "secondary_message": null
    }
  ],
