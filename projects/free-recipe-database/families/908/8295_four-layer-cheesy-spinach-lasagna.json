  "instructions": [
    {
      "id": 132532,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 132533,
      "primary_message": "Peel and mince red onion. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 132534,
      "primary_message": "Heat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 132535,
      "primary_message": "Add the onion to the skillet; cook, stirring frequently, until softened, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 132536,
      "primary_message": "Wash (skip if using pre-washed spinach) and roughly chop the spinach. Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Cook, stirring frequently until spinach has wilted, 4-6 minutes. ",
      "secondary_message": "3 (142 g) pkg baby spinach"
    },
    {
      "id": 132537,
      "primary_message": "In a medium bowl, mix together the tomato sauce, Italian seasoning, and salt. ",
      "secondary_message": "4 ½ (213 ml) cans tomato sauce\n1 tbsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 132538,
      "primary_message": "Grate the Parmesan and mozzarella. ",
      "secondary_message": "43 g Parmesan cheese\n1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 132539,
      "primary_message": "In a large bowl, combine the ricotta, eggs, Parmesan, and half of the mozzarella. Add the spinach mixture to the bowl and stir to combine.",
      "secondary_message": "1 ½ (425 g) pkgs ricotta cheese\n3 eggs"
    },
    {
      "id": 132540,
      "primary_message": "Coat the bottom of a large baking dish with tomato sauce. Add three lasagna noodles side-by-side on top of the sauce. Add ¾ cup of sauce, one-third of the spinach mixture, and three noodles side-by-side. Repeat this step twice more until you have formed three layers. Top with three final noodles, the rest of the sauce, and the other half of the mozzarella cheese.",
      "secondary_message": "12 no-boil lasagna noodles"
    },
    {
      "id": 132541,
      "primary_message": "Cover with foil and bake for 20 minutes. Remove the foil and bake for another 5 minutes. Divide between plates and enjoy! ",
      "secondary_message": null
    }
  ],
