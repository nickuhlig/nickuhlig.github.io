  "instructions": [
    {
      "id": 132522,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 132523,
      "primary_message": "Peel and mince shallots. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 132524,
      "primary_message": "Heat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 132525,
      "primary_message": "Add the shallots to the skillet; cook, stirring frequently, until softened, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 132526,
      "primary_message": "Wash (skip if using pre-washed spinach) and roughly chop the spinach. Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Cook, stirring frequently until spinach has wilted, 2-3 minutes. ",
      "secondary_message": "2 (142 g) pkg baby spinach"
    },
    {
      "id": 132527,
      "primary_message": "In a medium bowl, mix together the tomato sauce, Italian seasoning, and salt. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n2 tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 132528,
      "primary_message": "Grate the Parmesan and mozzarella. ",
      "secondary_message": "28 g Parmesan cheese\n1 (227 g) block mozzarella cheese"
    },
    {
      "id": 132529,
      "primary_message": "In a large bowl, combine the ricotta, eggs, Parmesan, and half of the mozzarella. Add the spinach mixture to the bowl and stir to combine.",
      "secondary_message": "1 (425 g) pkg ricotta cheese\n2 eggs"
    },
    {
      "id": 132530,
      "primary_message": "Coat the bottom of a medium baking dish with tomato sauce. Add two lasagna noodles side-by-side on top of the sauce. Add ½ cup of sauce, one-third of the spinach mixture, and two noodles side-by-side. Repeat this step twice more until you have formed three layers. Top with two final noodles, the rest of the sauce, and the other half of the mozzarella cheese. ",
      "secondary_message": "8 no-boil lasagna noodles"
    },
    {
      "id": 132531,
      "primary_message": "Cover with foil and bake for 20 minutes. Remove the foil and bake for another 5 minutes. Divide between plates and enjoy! ",
      "secondary_message": null
    }
  ],
