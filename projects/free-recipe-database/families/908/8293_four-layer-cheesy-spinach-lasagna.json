  "instructions": [
    {
      "id": 132512,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 132513,
      "primary_message": "Peel and mince shallot. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 132514,
      "primary_message": "Heat a large skillet over medium heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 132515,
      "primary_message": "Add the shallot to the skillet; cook, stirring frequently, until softened, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 132516,
      "primary_message": "Wash (skip if using pre-washed spinach) and roughly chop the spinach, add to the skillet with the shallot. Cook, stirring frequently, until spinach has wilted, 2-3 minutes. ",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 132517,
      "primary_message": "In a small bowl, mix together the tomato sauce, Italian seasoning, and salt. ",
      "secondary_message": "1 ½ (213 ml) cans tomato sauce\n1 tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 132518,
      "primary_message": "Grate the Parmesan and mozzarella. ",
      "secondary_message": "14 g Parmesan cheese\n½ (227 g) block mozzarella cheese"
    },
    {
      "id": 132519,
      "primary_message": "In a large bowl, combine the ricotta, egg, Parmesan, and half of the mozzarella. Add the spinach mixture to the bowl and stir to combine.",
      "secondary_message": "½ (425 g) pkg ricotta cheese\n1 egg"
    },
    {
      "id": 132520,
      "primary_message": "Coat the bottom of a small baking dish or loaf pan with tomato sauce. Add one lasagna noodle on top of the sauce. Add ¼ cup of sauce, one-third of the spinach mixture, and a noodle. Repeat this step twice more until you have formed three layers. Top with a final noodle, the rest of the sauce, and the other half of the mozzarella cheese. ",
      "secondary_message": "4 no-boil lasagna noodles"
    },
    {
      "id": 132521,
      "primary_message": "Cover with foil and bake for 20 minutes. Remove the foil and bake for another 5 minutes. Divide between plates and enjoy! ",
      "secondary_message": null
    }
  ],
