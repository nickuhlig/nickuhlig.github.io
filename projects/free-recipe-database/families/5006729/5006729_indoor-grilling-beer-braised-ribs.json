  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Lightly smash the garlic.",
      "secondary_message": "5 cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 300°F. Remove the membrane from the bottom side of the ribs and split the rack into two. Season liberally with salt and pepper. Put oil in a large, deep ovenproof skillet or casserole that can later be covered. Turn heat to medium-high and, when oil shimmers, sear meat on both sides until nicely browned, turning as necessary.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add allspice, cinnamon, ginger, chilies and garlic and stir; add beer. Bring to a boil; cover pan and adjust heat so mixture simmers steadily. Put in oven and cook until meat is tender, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat broiler. Drain meat and sprinkle it with salt and pepper. Broil on both sides until brown and crisp, about 1 to 2 minutes. Meanwhile, skim cooking liquid of fat, bring to a boil, and use as sauce.",
      "secondary_message": null
    }
  ],
