  "instructions": [
    {
      "id": 500881,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 500882,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n6 medium carrots\n1 ½ limes\n1 small pkg fresh basil"
    },
    {
      "id": 500883,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 500884,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel each carrot into noodle-like strips. Add to the baking sheets with the zucchini. Drizzle veggies noodles with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 500885,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini and carrot noodles are tender, about 12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 500886,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 500887,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 500888,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, chicken, salt, and pepper. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil\n0.68 kg ground chicken\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 500889,
      "primary_message": "While the chicken is cooking, zest and juice limes into a small bowl. Add water, peanut butter, chili-garlic sauce, and soy sauce, then whisk to combine the stir-fry sauce.",
      "secondary_message": "¾ cup water\n⅓ cup natural peanut butter\n2 tbsp chili-garlic sauce\n2 tbsp soy sauce"
    },
    {
      "id": 500890,
      "primary_message": "When the chicken is done, add stir-fry sauce to the skillet. Cook, stirring occasionally, until warmed through and thickened slightly, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 500891,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "1 cup cashews, roasted unsalted"
    },
    {
      "id": 500892,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 500893,
      "primary_message": "Add cashews and half of the basil to the skillet. Stir to combine and cover to keep warm. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 500894,
      "primary_message": "To serve, divide zucchini and carrot noodles between plates or bowls. Top with saucy chicken and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
