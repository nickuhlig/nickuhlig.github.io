  "instructions": [
    {
      "id": 500895,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 500896,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 medium carrots\n½ lime\n½ small pkg fresh basil"
    },
    {
      "id": 500897,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 500898,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel each carrot into noodle-like strips. Add to the baking sheet with the zucchini. Drizzle veggie noodles with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp toasted sesame oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 500899,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated), and roast, tossing halfway through, until zucchini and carrot noodles are tender, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 500900,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 500901,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 500902,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, veggie ground, salt, and pepper. Cook, breaking it apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "1 tsp toasted sesame oil\n227 g veggie ground, plant based\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 500903,
      "primary_message": "While the veggie ground is cooking, zest and juice lime into a small bowl. Add water, peanut butter, chili-garlic sauce, and soy sauce, then whisk to combine the stir-fry sauce.",
      "secondary_message": "¼ cup water\n2 tbsp natural peanut butter\n2 tsp chili-garlic sauce\n2 tsp soy sauce"
    },
    {
      "id": 500904,
      "primary_message": "When the veggie ground is done, add stir-fry sauce to the skillet. Cook, stirring occasionally, until warmed through and thickened slightly, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 500905,
      "primary_message": "Meanwhile, roughly chop cashews. ",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 500906,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 500907,
      "primary_message": "Add cashews and half of the basil to the skillet. Stir to combine and cover to keep warm. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 500908,
      "primary_message": "To serve, divide zucchini and carrot noodles between plates or bowls. Top with saucy veggie ground and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
