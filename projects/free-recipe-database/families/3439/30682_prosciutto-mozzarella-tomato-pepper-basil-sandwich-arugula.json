  "instructions": [
    {
      "id": 486933,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ small pkg fresh basil\n½ lemon\n1 tomato\n½ yellow bell pepper\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 486934,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Divide between a medium and small bowl. (Set the medium bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 486935,
      "primary_message": "Zest lemon into the small bowl with the basil, then add mayo and spices. Stir to combine the basil aioli and set aside. (Reserve lemon for later use.)",
      "secondary_message": "3 tbsp mayonnaise\n¼ tsp garlic powder\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 486936,
      "primary_message": "Slice tomato crosswise into thin rounds. Place on a plate and season with salt and pepper.",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 486937,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Add to the plate with the tomato.",
      "secondary_message": null
    },
    {
      "id": 486938,
      "primary_message": "Slice mozzarella into thin rounds. Add to the plate and set aside.",
      "secondary_message": "½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 486939,
      "primary_message": "Juice reserved lemon into the medium bowl with the basil. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 486940,
      "primary_message": "Drain and roughly chop artichoke hearts. Add to the bowl with the dressing, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 486941,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 486942,
      "primary_message": "To assemble the sandwiches, spread each bread slice with basil aioli. Layer half of the slices with tomato, bell pepper, mozzarella, and prosciutto; close with remaining slices and cut in half.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 486943,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
