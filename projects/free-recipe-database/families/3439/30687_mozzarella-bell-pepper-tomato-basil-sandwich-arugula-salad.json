  "instructions": [
    {
      "id": 486988,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 small pkg fresh basil\n1 ½ lemons\n3 tomatoes\n1 ½ yellow bell peppers\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 486989,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Divide between a large and small bowl. (Set the large bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 486990,
      "primary_message": "Zest lemons into the small bowl with the basil, then add mayo and spices. Stir to combine the basil aioli and set aside. (Reserve lemons for later use.)",
      "secondary_message": "¾ cup mayonnaise\n¾ tsp garlic powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 486991,
      "primary_message": "Slice tomatoes crosswise into thin rounds. Place on a large plate and season with salt and pepper.",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 486992,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Add to the plate with the tomato.",
      "secondary_message": null
    },
    {
      "id": 486993,
      "primary_message": "Slice mozzarella into thin rounds. Add to the plate and set aside.",
      "secondary_message": "1 ½ (227 g) pkgs fresh mozzarella cheese"
    },
    {
      "id": 486994,
      "primary_message": "Juice reserved lemons into the large bowl with the basil. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 486995,
      "primary_message": "Drain and roughly chop artichoke hearts. Add to the bowl with the dressing, along with arugula, and toss to combine the salad. Set aside.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 486996,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 486997,
      "primary_message": "To assemble the sandwiches, spread each bread slice with basil aioli. Layer half of the slices with tomato, bell pepper, and mozzarella; close with remaining slices and cut in half.",
      "secondary_message": null
    },
    {
      "id": 486998,
      "primary_message": "To serve, divide sandwiches and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
