  "instructions": [
    {
      "id": 1,
      "primary_message": "Set up an immersion circulator and preheat the water bath to 68°C (155°F).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Season duck all over with salt and pepper. Rub garlic onto the meaty side of each leg and set a thyme sprig on top. Slide duck legs into vacuum bags and seal according to vacuum-sealer manufacturer's instructions. Alternatively, seal duck legs in a zipper-lock bag using the water displacement method,",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add sealed duck to water bath and cook for 36 hours. Make sure to top water up occasionally as it evaporates, and keep bag completely submerged. If bag floats, weigh it down by placing a wet kitchen towel on top of it.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove duck from water bath and transfer to refrigerator to chill. The duck can be kept refrigerated within the sealed bag for up to 1 week.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "When ready to use, remove duck from bag and scrape away thyme sprigs and excess fat and juices. Use duck confit according to any recipe you have; it can be cooked in a 230°C (450°F) oven or broiled until the meat is heated through and the skin is browned and crispy, about 7 minutes.",
      "secondary_message": null
    }
  ],
