  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Cake: Adjust oven rack to middle position and preheat oven to 350°F. Coat a 13- by 9-inch baking pan with baking spray. Combine flour, sugar, brown sugar, and salt in large bowl.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring butter, cocoa powder, and Coca-Cola to boil in small saucepan over medium-high heat, stirring occasionally until mixture is homogeneous, and stir into flour mixture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir baking soda into buttermilk until completely dissolved and add to flour mixture; whisk to combine. Add eggs and vanilla and whisk to combine. Stir in marshmallows.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Scrape batter into prepared pan and bake until tester inserted in center of cake comes out clean, about 45 minutes. Transfer cake to cooling rack and cool 10 minutes, then make icing.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "For the Icing: Bring butter, cocoa powder, and Coca-Cola to boil in large saucepan over medium-high heat, stirring occasionally. Whisk in sugar, vanilla, salt, and (optional) pecans and pour onto cake immediately, spreading and swirling decoratively with back of a soup spoon. Serve warm, or cool to room temperature.",
      "secondary_message": null
    }
  ],
