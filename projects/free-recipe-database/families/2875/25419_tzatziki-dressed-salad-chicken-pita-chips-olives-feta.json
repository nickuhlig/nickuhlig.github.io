  "instructions": [
    {
      "id": 407962,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 407963,
      "primary_message": "Place pitas on a flat surface. Holding a knife parallel to the cutting board, cut the pita in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and divide between two large baking sheet pans.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 407964,
      "primary_message": "Drizzle pita with oil and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 407965,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until the pita chips are crisp, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 407966,
      "primary_message": "Meanwhile, place tzatziki, vinegar, oil, and salt in a large bowl. Stir to combine the dressing and set aside.",
      "secondary_message": "1 ½ cups tzatziki sauce\n2 tbsp red wine vinegar\n1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 407967,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n3 yellow bell peppers\n6 hearts romaine hearts"
    },
    {
      "id": 407968,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 407969,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 407970,
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 407971,
      "primary_message": "Roughly chop olives. Add to the bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 407972,
      "primary_message": "Place chickens on the cutting board and, using your hands, remove meat from the skin and bones; separate the meat into shred-like pieces. Add to the bowl.",
      "secondary_message": "1 ½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 407973,
      "primary_message": "Add pita chips and feta to the bowl. Toss to combine the salad.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 407974,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
