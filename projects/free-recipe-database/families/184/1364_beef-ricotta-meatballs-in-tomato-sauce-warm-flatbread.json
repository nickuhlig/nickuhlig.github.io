  "instructions": [
    {
      "id": 11746,
      "primary_message": "Peel and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\r\n3 cloves garlic"
    },
    {
      "id": 11747,
      "primary_message": "In a medium bowl, combine ½ of the onion and garlic (save the rest for the sauce), beef, bread crumbs, ricotta, Italian seasoning, salt, and pepper. Mix until well combined.",
      "secondary_message": "¾ lb lean ground beef\n⅛ cup panko bread crumbs\n¼ pkg (½ cup) ricotta cheese\n1 tsp Italian seasoning\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 11748,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 11749,
      "primary_message": "Shape beef into meatballs, about 12, and place on a plate.",
      "secondary_message": ""
    },
    {
      "id": 11750,
      "primary_message": "Coat bottom of pan with oil. Add meatballs and, turning frequently, cook until browned, 4-5 minutes. Transfer to a plate.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 11751,
      "primary_message": "Return pan to stove and reduce heat to medium. Add remaining onion and garlic. Stirring frequently, cook until onion is softened, 3-4 minutes.",
      "secondary_message": ""
    },
    {
      "id": 11752,
      "primary_message": "Add tomatoes, Italian seasoning, salt, and pepper; bring to a boil. Reduce heat to medium-low and add meatballs. Cook until meatballs are cooked through and sauce thickens, about 10 minutes.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\r\n1 tsp Italian seasoning\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 11753,
      "primary_message": "Wash and dry basil. Pick leaves off the stems; discard the stems and thinly slice leaves into ribbons. Stir ½ into the sauce while it cooks (save the rest for garnishing).",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 11754,
      "primary_message": "Toast flatbread and cut into wedges.",
      "secondary_message": "1 flatbread or naan"
    },
    {
      "id": 11755,
      "primary_message": "To serve, place meatballs and tomato sauce on a plate, garnish with basil, and have with warm bread on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
