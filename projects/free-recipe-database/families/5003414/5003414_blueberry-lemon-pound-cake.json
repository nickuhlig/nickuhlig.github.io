  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 350°F. Butter and flour an 8 1/2 by 4 1/2-inch loaf pan. In a small bowl, whisk together flour, baking powder, baking soda, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, beat together butter and sugar with a hand mixer or a wooden spoon until light and creamy, about 4 minutes. Beat in eggs, one at a time, then vanilla extract, lemon juice, and lemon zest. Add buttermilk and beat until just combined. Add flour mixture to the bowl and beat until incorporated. Gently fold blueberries into the batter.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour batter into prepared loaf pan and bake until golden and a cake tester inserted into the middle comes out clean, about 50 minutes. Let cool 10 minutes in the pan, then turn out to a wire rack to complete cooling.",
      "secondary_message": null
    }
  ],
