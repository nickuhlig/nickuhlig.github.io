  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Lightly coat a 9 x 5-inch loaf pan with cooking spray. ",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place ketchup, sugar, and Dijon in a small bowl. Stir to combine the glaze.\n\n",
      "secondary_message": "½ cup ketchup\n¼ cup brown sugar\n1 tbsp Dijon mustard"
    },
    {
      "primary_message": "Peel, halve, and small dice onion. Place in a medium bowl along with beef, sausage, eggs, bread crumbs, milk, and spices. Mix with your hands until well combined, then transfer meatloaf mixture to the loaf pan, pressing it into the pan. Spread top of the meatloaf with the glaze. ",
      "secondary_message": "1 medium yellow onion\n1 lb lean ground beef\n½ lb ground pork sausage\n1 cup panko bread crumbs\n¼ cup whole milk\n1 ½ tsp Italian seasoning\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Place meatloaf in the oven (it doesn't have to be fully heated) and bake until cooked through, about 1 hour. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, cut meatloaf into slices, divide between plates, and enjoy!",
      "secondary_message": null
    }
  ],
