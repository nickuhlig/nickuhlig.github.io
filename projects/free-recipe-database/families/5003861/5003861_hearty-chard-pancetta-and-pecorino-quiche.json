  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the pancetta into 1/4-inch cubes. Remove the tough ends from the Swiss chard, then chop the leaves. Coarsely grate the Pecorino Romano.",
      "secondary_message": "2 oz pancetta\n14 oz Swiss chard\n1 cup Pecorino Romano"
    },
    {
      "id": 1,
      "primary_message": "Preheat the oven to 400°F. Line a pie plate with the piecrust. Dock, and bake until golden, 12 to 15 minutes. Remove from oven and allow to cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, add the pancetta to a large straight-sided sauté pan and cook over medium-high heat, stirring occasionally, until fat is rendered and pancetta starts to crisp, about 5 minutes. Add the chard and season with salt, pepper, and a pinch of ground nutmeg. Cook, stirring often, until the chard is wilted and the pan is dry, 5 to 8 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Scatter the chard and pancetta over the crust. In a large bowl, whisk together the eggs, milk, crème fraîche, and Pecorino. Season to taste with salt and pepper. Pour mixture over chard and and return to the oven until quiche is barely set (the center should still jiggle) and a cake tester or toothpick inserted in the center comes out clean, 25 to 30 minutes. Allow to cool slightly. Serve warm or at room temperature.",
      "secondary_message": null
    }
  ],
