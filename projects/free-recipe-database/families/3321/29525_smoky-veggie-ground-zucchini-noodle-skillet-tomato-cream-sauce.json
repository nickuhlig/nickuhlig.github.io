  "instructions": [
    {
      "id": 470667,
      "primary_message": "Wash, dry, and trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons. Place in a medium bowl and set aside.",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 470668,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470669,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 470670,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n1 tsp smoked paprika\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 470671,
      "primary_message": "When the veggie ground is done, add zucchini noodles, tomato sauce, and cream to the skillet. Continue to cook, stirring occasionally, until zucchini noodles are soft and sauce has thickened, 4-5 minutes more. Remove from heat.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n237 ml heavy whipping cream"
    },
    {
      "id": 470672,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 470673,
      "primary_message": "To serve, divide skillet between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
