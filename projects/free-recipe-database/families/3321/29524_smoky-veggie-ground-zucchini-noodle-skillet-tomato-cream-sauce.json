  "instructions": [
    {
      "id": 470660,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470661,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 470662,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp smoked paprika\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 470663,
      "primary_message": "While the veggie ground is cooking, wash, dry, and trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 470664,
      "primary_message": "When the veggie ground is done, add zucchini noodles, tomato sauce, and cream to the skillet. Continue to cook, stirring occasionally, until zucchini noodles are soft and sauce has thickened, 3-4 minutes more. Remove from heat.",
      "secondary_message": "1 (213 ml) can tomato sauce\n118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 470665,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 470666,
      "primary_message": "To serve, divide skillet between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
