  "instructions": [
    {
      "id": 470632,
      "primary_message": "Wash, dry, and trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons. Place in a large bowl and set aside.",
      "secondary_message": "9 medium zucchini squash"
    },
    {
      "id": 470633,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 470634,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470635,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 470636,
      "primary_message": "When the veggie ground is done, add zucchini noodles, tomato sauce, and cream to the pot. Continue to cook, stirring occasionally, until zucchini noodles are soft and sauce has thickened, 5-6 minutes more. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 470637,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 470638,
      "primary_message": "To serve, divide sauté between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
