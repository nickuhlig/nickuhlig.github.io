  "instructions": [
    {
      "id": 470611,
      "primary_message": "Wash, dry, and trim zucchini; run a vegetable peeler along the length of the zucchini to make ribbons. Place in a large bowl and set aside.",
      "secondary_message": "9 medium zucchini squash"
    },
    {
      "id": 470612,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 470613,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470614,
      "primary_message": "Once the pot is hot, add onion, garlic, sausage, and spices. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 ½ lb ground pork sausage\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 470615,
      "primary_message": "When the sausage is done, add zucchini noodles, tomato sauce, and cream to the pot. Continue to cook, stirring occasionally, until zucchini noodles are soft and sauce has thickened, 4-5 minutes more. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 470616,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 470617,
      "primary_message": "To serve, divide sauté between plates or bowls. Top with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
