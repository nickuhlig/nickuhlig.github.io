  "instructions": [
    {
      "id": 199149,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 199150,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ avocados\n3 limes\n3 tomatoes\n1 small bunch cilantro\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 199151,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out into a medium bowl and mash with a fork until smooth.",
      "secondary_message": null
    },
    {
      "id": 199152,
      "primary_message": "Juice half the limes into the bowl with the avocado; cut remaining limes into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 199153,
      "primary_message": "Add yogurt, honey, and spices to the bowl; whisk to combine the dressing and set aside. ",
      "secondary_message": "¾ cup plain Greek yogurt\n1 ½ tsp honey\n¾ tsp cumin\n¾ tsp chili powder\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt"
    },
    {
      "id": 199154,
      "primary_message": "Small dice tomatoes and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 199155,
      "primary_message": "Peel and small dice onions; add to the bowl with the tomatoes. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 199156,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 199157,
      "primary_message": "Place corn in a large colander and run under cold water to thaw. Drain and rinse beans in the colander with the corn; set aside to drain further.",
      "secondary_message": "1 ½ cups frozen corn\n3 (15 oz) cans black beans"
    },
    {
      "id": 199158,
      "primary_message": "Divide pitas between two baking sheet pans and drizzle with oil. Place in the oven and bake until pitas are toasted, 3-4 minutes.",
      "secondary_message": "6 whole grain pitas\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 199159,
      "primary_message": "Meanwhile, add corn, beans, and mixed greens to the bowl with the tomatoes; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 199160,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 199161,
      "primary_message": "To serve, divide pitas between plates, then top with salad, cheese, and dressing. Place lime wedges on the side and enjoy! ",
      "secondary_message": null
    }
  ],
