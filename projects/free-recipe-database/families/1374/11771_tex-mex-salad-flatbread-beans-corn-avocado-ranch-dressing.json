  "instructions": [
    {
      "id": 199136,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 199137,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 avocado\n2 limes\n2 tomatoes\n1 small bunch cilantro\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 199138,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out into a small bowl and mash with a fork until smooth.",
      "secondary_message": null
    },
    {
      "id": 199139,
      "primary_message": "Juice one of the limes into the bowl with the avocado; cut remaining lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 199140,
      "primary_message": "Add yogurt, honey, and spices to the bowl; whisk to combine the dressing and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n1 tsp honey\n½ tsp cumin\n½ tsp chili powder\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp salt"
    },
    {
      "id": 199141,
      "primary_message": "Small dice tomatoes and place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 199142,
      "primary_message": "Peel and small dice onion; add to the bowl with the tomatoes. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 199143,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 199144,
      "primary_message": "Place corn in a colander and run under cold water to thaw. Drain and rinse beans in the colander with the corn; set aside to drain further.",
      "secondary_message": "1 cup frozen corn\n2 (15 oz) cans black beans"
    },
    {
      "id": 199145,
      "primary_message": "Place pitas on a large baking sheet pan and drizzle with oil. Place in the oven and bake until pitas are toasted, 2-3 minutes.",
      "secondary_message": "4 whole grain pitas\n4 tsp extra virgin olive oil"
    },
    {
      "id": 199146,
      "primary_message": "Meanwhile, add corn, beans, and mixed greens to the bowl with the tomatoes; toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 199147,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 199148,
      "primary_message": "To serve, divide pitas between plates, then top with salad, cheese, and dressing. Place lime wedges on the side and enjoy! ",
      "secondary_message": null
    }
  ],
