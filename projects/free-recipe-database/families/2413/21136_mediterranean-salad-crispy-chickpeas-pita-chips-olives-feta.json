  "instructions": [
    {
      "id": 353708,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 353709,
      "primary_message": "Drain and rinse chickpeas, then transfer to baking sheet pan. Drizzle with oil, season with spices, and stir to coat; spread out in an even layer.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n2 tsp extra virgin olive oil\n¼ tsp coriander, ground\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 353710,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chickpeas are golden and crispy, 15-20 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 353711,
      "primary_message": "Meanwhile, place pitas on a flat surface. Holding a knife parallel to the cutting board, cut the pitas in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces and transfer to another baking sheet.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 353712,
      "primary_message": "Drizzle pita with oil and season with salt; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 353713,
      "primary_message": "Add baking sheet to the oven and bake until pita chips are crisp, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 353714,
      "primary_message": "While the pita chips are baking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lemon\n½ small pkg grape tomatoes\n½ English cucumber\n1 yellow bell pepper\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 353715,
      "primary_message": "Juice lemon into a medium bowl. Add vinegar, oil, Dijon, and spices; whisk to combine the dressing.",
      "secondary_message": "2 tbsp red wine vinegar\n1 tbsp extra virgin olive oil\n½ tsp Dijon mustard\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 353716,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 353717,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 353718,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 353719,
      "primary_message": "Halve olives and add to the bowl.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 353720,
      "primary_message": "Add crispy chickpeas, pita chips, spinach, and feta to the bowl. Toss to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 353721,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
