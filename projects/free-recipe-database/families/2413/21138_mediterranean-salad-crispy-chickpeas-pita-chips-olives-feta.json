  "instructions": [
    {
      "id": 353736,
      "primary_message": "Preheat oven to 220°C (425°F). Position racks in the upper, middle, and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 353737,
      "primary_message": "Drain and rinse chickpeas, then divide between two baking sheet pans. Drizzle with oil, season with spices, and stir to coat; spread out in an even layer.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n¾ tsp coriander, ground\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 353738,
      "primary_message": "Place baking sheets on lower racks of the oven (it doesn't have to be fully heated) and roast until chickpeas are golden and crispy, 20-25 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 353739,
      "primary_message": "Meanwhile, place pitas on a flat surface. Holding a knife parallel to the cutting board, cut the pitas in half horizontally to separate the two sides; cut or tear the bread into 2-inch pieces.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 353740,
      "primary_message": "Divide pita between two large baking sheets, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.(Alternately, you can use one baking sheet and toast the pita chips in two batches, removing the chips from the baking sheet after each batch.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 353741,
      "primary_message": "Working in batches, place baking sheets on upper rack of the oven and bake until pita chips are crisp, 6-8 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 353742,
      "primary_message": "While the pita chips are baking, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ small pkgs grape tomatoes\n1 ½ English cucumbers\n3 yellow bell peppers\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 353743,
      "primary_message": "Juice lemons into a large bowl. Add vinegar, oil, Dijon, and spices; whisk to combine the dressing.",
      "secondary_message": "⅓ cup red wine vinegar\n3 tbsp extra virgin olive oil\n1 ½ tsp Dijon mustard\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 353744,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 353745,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 353746,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 353747,
      "primary_message": "Halve olives and add to the bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 353748,
      "primary_message": "Add crispy chickpeas, pita chips, spinach, and feta to the bowl. Toss to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 353749,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
