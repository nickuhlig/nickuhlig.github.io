  "instructions": [
    {
      "id": 273073,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 273074,
      "primary_message": "Place soy sauce, maple syrup, oil, and spices in a small bowl; whisk to combine the marinade.",
      "secondary_message": "½ cup soy sauce\n⅓ cup pure maple syrup\n1 ½ tbsp extra virgin olive oil\n1 tbsp paprika\n1 tbsp onion powder\n1 ½ tsp black pepper\n½ tsp cardamom, ground"
    },
    {
      "id": 273075,
      "primary_message": "Cut tofu into ¼-inch thick planks along the short side; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Place on a rimmed baking sheet pan, in a single layer, and pour the marinade over top; turn to coat and set aside.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 273076,
      "primary_message": "While the tofu bacon marinates, peel and mince garlic. Place in a large bowl along with oil and spices; whisk to combine the garlic oil.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n¾ tsp basil, dried\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 273077,
      "primary_message": "Cut bread into cubes and add to the bowl with the garlic oil. Toss to combine the croutons, divide between two additional baking sheets, and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "9 slices whole grain bread"
    },
    {
      "id": 273078,
      "primary_message": "Place croutons in the oven and bake, tossing halfway through, until golden and crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 273079,
      "primary_message": "Add the tofu to the oven and bake until tofu bacon is firm and marinade has been absorbed, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 273080,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 pints grape tomatoes\n1 ½ avocados\n3 heads romaine lettuce"
    },
    {
      "id": 273081,
      "primary_message": "Place oil, mayo, vinegar, Dijon, salt, and pepper in the reserved bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp vegan mayonnaise\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 273082,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 273083,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 273084,
      "primary_message": "Chop or tear the romaine into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 273085,
      "primary_message": "Right before serving, add croutons to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 273086,
      "primary_message": "To serve, divide salad between plates or bowls, top with tofu bacon, and enjoy!",
      "secondary_message": null
    }
  ],
