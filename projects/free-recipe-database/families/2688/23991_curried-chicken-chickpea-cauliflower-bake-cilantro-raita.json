  "instructions": [
    {
      "id": 390611,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 390612,
      "primary_message": "Place vinegar, honey, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup rice vinegar\n2 tsp honey\n1 ½ tsp salt"
    },
    {
      "id": 390613,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 390614,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ English cucumbers\n3 limes\n1 small bunch cilantro"
    },
    {
      "id": 390615,
      "primary_message": "Drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 390616,
      "primary_message": "Separate each cauliflower head into bite-sized florets and cut stems into smaller pieces. Add to the baking sheets with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 390617,
      "primary_message": "Pat the chicken thighs dry with paper towels and cut into bite-sized pieces. Add to the baking sheets, drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "1.02 kg chicken thighs, boneless skinless\n3 tbsp extra virgin olive oil\n3 tbsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 390618,
      "primary_message": "Place baking sheets in the oven and roast, stirring halfway through, until chickpeas are crisp, cauliflower is fork-tender, and chicken is cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 390619,
      "primary_message": "Meanwhile, using a clean cutting board, peel, trim, and grate cucumbers. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 390620,
      "primary_message": "Juice half of the limes into the bowl with the cucumber. Cut remaining limes into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 390621,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt, additional honey, crushed red pepper, and salt; stir to combine the raita.",
      "secondary_message": "3 cups plain Greek yogurt\n2 tbsp honey\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 390622,
      "primary_message": "Divide chicken bake between plates or bowls; top with pickled onion. Serve with raita on the side and enjoy!",
      "secondary_message": null
    }
  ],
