  "instructions": [
    {
      "id": 390637,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 390638,
      "primary_message": "Place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup rice vinegar\n1 ½ tsp honey\n1 tsp salt"
    },
    {
      "id": 390639,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 390640,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium heads cauliflower\n1 lime\n1 English cucumber\n1 small bunch cilantro"
    },
    {
      "id": 390641,
      "primary_message": "Drain and rinse chickpeas. Transfer to a large baking sheet pan and pat dry with paper towels.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 390642,
      "primary_message": "Separate each cauliflower head into bite-sized florets and cut stems into smaller pieces. Transfer to the baking sheet with the chickpeas. Drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp curry powder\n1 tsp salt"
    },
    {
      "id": 390643,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are crisp and cauliflower is fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 390644,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); add additional vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pot is boiling, reduce heat to medium-low.",
      "secondary_message": "2 tbsp rice vinegar"
    },
    {
      "id": 390645,
      "primary_message": "Gently crack eggs into additional small bowls (two eggs per bowl).",
      "secondary_message": "8 eggs"
    },
    {
      "id": 390646,
      "primary_message": "Adjust the heat of the pot as necessary so that the water is simmering. Gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate. ",
      "secondary_message": null
    },
    {
      "id": 390647,
      "primary_message": "While the eggs are poaching, juice lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 390648,
      "primary_message": "Peel, trim, and grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 390649,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt, additional honey, crushed red pepper, and salt; stir to combine the raita.",
      "secondary_message": "2 cups plain Greek yogurt\n4 tsp honey\n½ tsp crushed red pepper\n½ tsp salt"
    },
    {
      "id": 390650,
      "primary_message": "Divide chickpea bake between plates or bowls; top with pickled onion and poached eggs. Serve with raita on the side and enjoy!",
      "secondary_message": null
    }
  ],
