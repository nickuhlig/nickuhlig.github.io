  "instructions": [
    {
      "id": 390623,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 390624,
      "primary_message": "Place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp rice vinegar\n¾ tsp honey\n½ tsp salt"
    },
    {
      "id": 390625,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 390626,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n½ lime\n½ English cucumber\n½ small bunch cilantro"
    },
    {
      "id": 390627,
      "primary_message": "Drain and rinse chickpeas. Transfer to a baking sheet pan and pat dry with paper towels.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 390628,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to the baking sheet with the chickpeas. Drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp curry powder\n½ tsp salt"
    },
    {
      "id": 390629,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are crisp and cauliflower is fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 390630,
      "primary_message": "Meanwhile, fill a medium saucepan about halfway with hot water (from the tap); add additional vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pan is boiling, reduce heat to medium-low.",
      "secondary_message": "1 tbsp rice vinegar"
    },
    {
      "id": 390631,
      "primary_message": "Gently crack eggs into additional small bowls (two eggs per bowl).",
      "secondary_message": "4 eggs"
    },
    {
      "id": 390632,
      "primary_message": "Adjust the heat of the saucepan as necessary so that the water is simmering. Gently tip bowls into the pan, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate. ",
      "secondary_message": null
    },
    {
      "id": 390633,
      "primary_message": "While the eggs are poaching, juice lime into another small bowl.",
      "secondary_message": null
    },
    {
      "id": 390634,
      "primary_message": "Peel, trim, and grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 390635,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt, additional honey, crushed red pepper, and salt; stir to combine the raita.",
      "secondary_message": "1 cup plain Greek yogurt\n2 tsp honey\n¼ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 390636,
      "primary_message": "Divide chickpea bake between plates or bowls; top with pickled onion and poached eggs. Serve with raita on the side and enjoy!",
      "secondary_message": null
    }
  ],
