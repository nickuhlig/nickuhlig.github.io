  "instructions": [
    {
      "id": 390587,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 390588,
      "primary_message": "Place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "3 tbsp rice vinegar\n¾ tsp honey\n½ tsp salt"
    },
    {
      "id": 390589,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 390590,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ English cucumber\n1 lime\n½ small bunch cilantro"
    },
    {
      "id": 390591,
      "primary_message": "Drain and rinse chickpeas. Transfer to a baking sheet pan and pat dry with paper towels.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 390592,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the baking sheet with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 390593,
      "primary_message": "Pat the chicken thighs dry with paper towels and cut into bite-sized pieces. Add to the baking sheet, drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "⅓ kg chicken thighs, boneless skinless\n1 tbsp extra virgin olive oil\n1 tbsp curry powder\n½ tsp salt"
    },
    {
      "id": 390594,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until chickpeas are crisp, cauliflower is fork-tender, and chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 390595,
      "primary_message": "Meanwhile, using a clean cutting board, peel, trim, and grate cucumber. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Place in another small bowl.",
      "secondary_message": null
    },
    {
      "id": 390596,
      "primary_message": "Juice half of the lime into the bowl with the cucumber. Cut remaining lime into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 390597,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt, additional honey, crushed red pepper, and salt; stir to combine the raita.",
      "secondary_message": "1 cup plain Greek yogurt\n2 tsp honey\n¼ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "id": 390598,
      "primary_message": "Divide chicken bake between plates or bowls; top with pickled onion. Serve with raita on the side and enjoy!",
      "secondary_message": null
    }
  ],
