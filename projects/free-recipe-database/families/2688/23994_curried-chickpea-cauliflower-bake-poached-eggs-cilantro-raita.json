  "instructions": [
    {
      "id": 390651,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 390652,
      "primary_message": "Place vinegar, honey, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup rice vinegar\n2 tsp honey\n1 ½ tsp salt"
    },
    {
      "id": 390653,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to combine, and set aside. ",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 390654,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium heads cauliflower\n1 ½ limes\n1 ½ English cucumbers\n1 small bunch cilantro"
    },
    {
      "id": 390655,
      "primary_message": "Drain and rinse chickpeas. Divide between two baking sheet pans and pat dry with paper towels.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 390656,
      "primary_message": "Separate each cauliflower head into bite-sized florets and cut stems into smaller pieces. Transfer to the baking sheets with the chickpeas. Drizzle with oil, then season with curry powder and salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 390657,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are crisp and cauliflower is fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 390658,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); add additional vinegar, cover with a lid, and bring to a boil over medium-high heat. Once the water in the pot is boiling, reduce heat to medium-low.",
      "secondary_message": "3 tbsp rice vinegar"
    },
    {
      "id": 390659,
      "primary_message": "Gently crack eggs into small bowls (two eggs per bowl).",
      "secondary_message": "12 eggs"
    },
    {
      "id": 390660,
      "primary_message": "Adjust the heat of the pot as necessary so that the water is simmering. Working in batches, gently tip bowls into the pot, sliding the eggs carefully into the water. Cook until whites are set but yolks are still soft, 2½-3 minutes. Using a slotted spoon, transfer eggs to a paper towel-lined plate. ",
      "secondary_message": null
    },
    {
      "id": 390661,
      "primary_message": "While the eggs are poaching, juice limes into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 390662,
      "primary_message": "Peel, trim, and grate cucumbers. Use paper towels or a clean cloth to squeeze excess moisture out of the grated cucumber. Add to the bowl with the lime juice.",
      "secondary_message": null
    },
    {
      "id": 390663,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with yogurt, additional honey, crushed red pepper, and salt; stir to combine the raita.",
      "secondary_message": "3 cups plain Greek yogurt\n2 tbsp honey\n¾ tsp crushed red pepper\n¾ tsp salt"
    },
    {
      "id": 390664,
      "primary_message": "Divide chickpea bake between plates or bowls; top with pickled onion and poached eggs. Serve with raita on the side and enjoy!",
      "secondary_message": null
    }
  ],
