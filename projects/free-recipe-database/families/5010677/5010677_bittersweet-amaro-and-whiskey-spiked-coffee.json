  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Spiked Whipped Cream (optional): Beat cream, Gran Classico, and sugar with a whisk, hand mixer, or stand mixer until stiff peaks begin to form. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Spiked Coffee: Fill two small mugs with boiling water to warm them. In a measuring cup, mix Averna, bourbon, crème de cacao, and Gran Classico. Stir well. When coffee is ready, dump hot water from mugs and divide bourbon mixture evenly between them. Add coffee and stir well. Top with whipped cream, if using, and serve.",
      "secondary_message": null
    }
  ],
