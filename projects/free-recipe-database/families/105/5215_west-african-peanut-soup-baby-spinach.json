  "instructions": [
    {
      "id": 62798,
      "primary_message": "Wash, peel, and medium dice potatoes. Wash and medium dice tomatoes.",
      "secondary_message": "0.681 kg sweet potatoes\n6 tomatoes"
    },
    {
      "id": 62797,
      "primary_message": "Heat a large saucepan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 62796,
      "primary_message": "Peel and small dice onion. Peel and mince garlic and ginger.",
      "secondary_message": "1 ½ medium yellow onion\n6 cloves garlic\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 62795,
      "primary_message": "Coat bottom of saucepan with oil. Add onion and stirring frequently, cook until softened, 3-4 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 62794,
      "primary_message": "Add garlic and ginger. Cook until fragrant, 15-30 seconds.",
      "secondary_message": ""
    },
    {
      "id": 62787,
      "primary_message": "Add broth, coconut milk, potatoes, tomatoes, salt, and pepper. Bring to a boil. Reduce heat to medium-low and, stirring occasionally, simmer until potatoes are tender, 10-12 minutes.",
      "secondary_message": "1062 ml (4 ½ cups) chicken or vegetable broth\n1 ½ (398 ml) can coconut milk\n¾ tsp salt\n⅜ tsp cayenne pepper"
    },
    {
      "id": 62793,
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 62792,
      "primary_message": "Remove 1 ½ cup of the soup liquid from saucepan and pour into a medium bowl. Add peanut butter and whisk until smooth.",
      "secondary_message": "¾ cup natural peanut butter"
    },
    {
      "id": 62791,
      "primary_message": "Add peanut butter mixture and spinach to saucepan. Stir and cook for an additional 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 62790,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ small bunches cilantro"
    },
    {
      "id": 62789,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 62788,
      "primary_message": "To serve, pour soup into a bowl and garnish with cilantro and peanuts. Enjoy!",
      "secondary_message": ""
    }
  ],
