  "instructions": [
    {
      "id": 52351,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "7 cups water\n1 tbsp salt\n6 oz (1 quarter coin = 2 oz) spaghetti pasta"
    },
    {
      "id": 52352,
      "primary_message": "Peel and mince the garlic. To prepare the sauce, in a small bowl, combine and whisk together the garlic, water, peanut butter, vinegar, soy sauce, maple syrup, oil, and crushed red pepper.",
      "secondary_message": "1 clove garlic\n2 tbsp warm water\n4 tbsp natural peanut butter\n1 tbsp rice vinegar\n1 tbsp soy sauce\n½ tbsp pure maple syrup\n½ tbsp toasted sesame oil\n⅛ tsp crushed red pepper"
    },
    {
      "id": 52353,
      "primary_message": "Toss the broccoli slaw into a large bowl. Wash and dry the cilantro. Shave the leaves off the stems; discard the stems and mince the leaves. Add to the bowl with the broccoli slaw.",
      "secondary_message": "½ (12 oz) pkg broccoli slaw\r\n½ small bunch cilantro"
    },
    {
      "id": 52354,
      "primary_message": "Wash and cut the lime into wedges. Roughly chop the peanuts.",
      "secondary_message": "½ lime\r\n¼ cup peanuts, roasted unsalted "
    },
    {
      "id": 52355,
      "primary_message": "Drain the pasta in a colander and rinse under cold water. Shake to drain excess liquid, then add to the bowl with the broccoli slaw.",
      "secondary_message": ""
    },
    {
      "id": 52356,
      "primary_message": "Pour the peanut sauce over top and toss to coat.",
      "secondary_message": ""
    },
    {
      "id": 52357,
      "primary_message": "To serve, divide the noodles between bowls (or containers) and garnish with peanuts and lime wedges. Enjoy!",
      "secondary_message": ""
    }
  ],
