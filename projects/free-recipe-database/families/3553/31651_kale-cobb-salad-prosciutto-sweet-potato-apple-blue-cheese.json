  "instructions": [
    {
      "id": 499974,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 499975,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 499976,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n1 bunch kale\n1 Gala apple"
    },
    {
      "id": 499977,
      "primary_message": "Peel and medium dice sweet potato. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 499978,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is golden and fork-tender, 20-25 minutes. Remove from oven and set aside to cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 499979,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 ½ tbsp extra virgin olive oil\n1 ½ tsp balsamic vinegar\n½ tsp Dijon mustard\n½ tsp honey\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 499980,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing and, using your hands, massage kale until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 499981,
      "primary_message": "Peel and quarter eggs, then season with salt and pepper. Place on a plate. ",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 499982,
      "primary_message": "Chop or tear prosciutto into bite-sized pieces. Add to the plate with the eggs.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 499983,
      "primary_message": "Quarter, core, and medium dice apple. Add to the plate.",
      "secondary_message": null
    },
    {
      "id": 499984,
      "primary_message": "To serve, divide kale between plates or bowls. Top with prosciutto, eggs, sweet potato, apple, and blue cheese. Enjoy!",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese"
    }
  ],
