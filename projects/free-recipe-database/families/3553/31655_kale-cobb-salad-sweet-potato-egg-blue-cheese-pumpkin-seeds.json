  "instructions": [
    {
      "id": 500017,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 500018,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 500019,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n2 bunches kale\n2 Gala apples"
    },
    {
      "id": 500020,
      "primary_message": "Peel and medium dice sweet potatoes. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 500021,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is golden and fork-tender, 20-25 minutes. Remove from oven and set aside to cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 500022,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 500023,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing and, using your hands, massage kale until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 500024,
      "primary_message": "Peel and quarter eggs, then season with salt and pepper. Place on a plate. ",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 500025,
      "primary_message": "Quarter, core, and medium dice apples. Add to the plate with the eggs.",
      "secondary_message": null
    },
    {
      "id": 500026,
      "primary_message": "To serve, divide kale between plates or bowls. Top with eggs, sweet potato, apple, blue cheese, and pumpkin seeds. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled blue cheese\n½ cup pumpkin seeds"
    }
  ],
