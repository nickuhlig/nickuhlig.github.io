  "instructions": [
    {
      "id": 499964,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 499965,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool; set aside.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 499966,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n3 bunches kale\n3 Gala apples"
    },
    {
      "id": 499967,
      "primary_message": "Peel and medium dice sweet potatoes. Transfer to a large baking sheet pan, drizzle with oil, and season with salt. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 499968,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is golden and fork-tender, 20-25 minutes. Remove from oven and set aside to cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 499969,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n¼ cup extra virgin olive oil\n1 ½ tbsp balsamic vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 499970,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing and, using your hands, massage kale until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 499971,
      "primary_message": "Peel and quarter eggs, then season with salt and pepper. Place on a large plate. ",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 499972,
      "primary_message": "Quarter, core, and medium dice apples. Add to the plate with the eggs.",
      "secondary_message": null
    },
    {
      "id": 499973,
      "primary_message": "To serve, divide kale between plates or bowls. Top with eggs, sweet potato, apple, blue cheese, and pumpkin seeds. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese\n¾ cup pumpkin seeds"
    }
  ],
