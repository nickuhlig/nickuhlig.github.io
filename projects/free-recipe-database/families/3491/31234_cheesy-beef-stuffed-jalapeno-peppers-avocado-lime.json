  "instructions": [
    {
      "id": 493995,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 493996,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "5 jalapeño peppers\n¼ small bunch cilantro\n½ avocado\n½ lime"
    },
    {
      "id": 493997,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Transfer to the baking sheet and set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 493998,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 493999,
      "primary_message": "Peel and mince shallot. Add to the bowl with the cilantro along with beef, cheese, sesame seeds, and spices; mix with your hands until well combined.",
      "secondary_message": "1 shallot\n0.11 kg lean ground beef\n⅓ cup shredded cheese, Mexican blend\n1 tbsp sesame seeds\n½ tsp chili powder\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 494000,
      "primary_message": "Stuff jalapeño halves with the beef mixture, pressing firmly into each pepper. Arrange stuffed peppers on the baking sheet, about 1-inch apart.",
      "secondary_message": null
    },
    {
      "id": 494001,
      "primary_message": "Place baking sheet in the oven and bake until jalapeños are tender and beef is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 494002,
      "primary_message": "Meanwhile, halve and pit avocado; using a spoon, scoop out the flesh and slice lengthwise into 10 thin wedges. Cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 494003,
      "primary_message": "Divide stuffed jalapeños between plates; top each with a slice of avocado. Serve with lime wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
