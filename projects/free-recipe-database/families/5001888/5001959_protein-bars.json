  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the bittersweet chocolate.",
      "secondary_message": "170 g bittersweet chocolate, 60% cacao, divided"
    },
    {
      "id": 1,
      "primary_message": "Grease an 8x8-inch baking pan with cooking spray, then line with parchment paper, letting the parchment overhang on 2 sides by at least 2.5 cm.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large microwave-safe bowl, add peanut butter, maple syrup, and 85 g chocolate. Microwave on high in 15-second intervals, stirring between each interval, until melted and smooth, 30 to 45 seconds.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, add 1 1/2 teaspoons chocolate, 1 1/2 teaspoons peanuts, 1 1/2 teaspoons cranberries, and 1 1/2 teaspoons pumpkin seeds; set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add cereal, oats, chia seeds, flax seeds, cinnamon, salt, and remaining chocolate, peanuts, cranberries, and pumpkin seeds to the bowl with peanut butter mixture. Stir until well combined.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Using a flexible rubber spatula, spoon cereal mixture into prepared pan and spread into an even layer. Evenly sprinkle with reserved chocolate mixture. Using a sheet of plastic wrap, very firmly press cereal mixture into a tight, even layer. Chill, uncovered, in freezer until firm, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Using parchment paper as handles, transfer bars to a cutting board. Cut into 16 squares. Serve immediately or store in an airtight container in refrigerator for 1 week.",
      "secondary_message": null
    }
  ],
