  "instructions": [
    {
      "id": 437447,
      "primary_message": "Roughly chop olives and sun-dried tomatoes. Place both in a small bowl and set aside.",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n12 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 437448,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Place in a medium bowl.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 437449,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Add to the bowl with the zucchini.",
      "secondary_message": "1 ½ orange bell peppers"
    },
    {
      "id": 437450,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 437451,
      "primary_message": "While the skillet heats up, peel and mince shallots. Add to the bowl with the veggies.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 437452,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 437453,
      "primary_message": "Meanwhile, crack eggs into the reserved bowl, then season with spices. Whisk until smooth.",
      "secondary_message": "12 eggs\n¾ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 437454,
      "primary_message": "When the veggies are soft, pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 437455,
      "primary_message": "Remove skillet from heat, add olives and sun-dried tomatoes, then gently stir to combine the scramble.",
      "secondary_message": null
    },
    {
      "id": 437456,
      "primary_message": "To serve, divide scramble between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
