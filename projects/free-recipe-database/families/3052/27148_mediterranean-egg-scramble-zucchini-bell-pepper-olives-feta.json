  "instructions": [
    {
      "id": 437427,
      "primary_message": "Roughly chop olives and sun-dried tomatoes. Place both in a small bowl and set aside.",
      "secondary_message": "⅛ cup Kalamata olives, pitted\n4 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 437428,
      "primary_message": "Wash, dry, trim, and small dice zucchini. Place in a medium bowl.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 437429,
      "primary_message": "Wash, dry, trim, and seed bell pepper; small dice. Add to the bowl with the zucchini.",
      "secondary_message": "½ orange bell pepper"
    },
    {
      "id": 437430,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 437431,
      "primary_message": "While the skillet heats up, peel and mince shallot. Add to the bowl with the veggies.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 437432,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until softened, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 437433,
      "primary_message": "Meanwhile, crack eggs into the reserved bowl, then season with spices. Whisk until smooth.",
      "secondary_message": "4 eggs\n¼ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 437434,
      "primary_message": "When the veggies are soft, pour the egg mixture into the skillet and scramble using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 437435,
      "primary_message": "Remove skillet from heat, add olives and sun-dried tomatoes, then gently stir to combine the scramble.",
      "secondary_message": null
    },
    {
      "id": 437436,
      "primary_message": "To serve, divide scramble between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
