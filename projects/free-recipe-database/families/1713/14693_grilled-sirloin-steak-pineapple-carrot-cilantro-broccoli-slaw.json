  "instructions": [
    {
      "id": 243157,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n3 medium carrots\n1 ½ small pineapples\n1 small bunch green onions (scallions)\n1 small bunch cilantro"
    },
    {
      "id": 243158,
      "primary_message": "Juice limes into a large bowl. Add oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp turmeric, ground"
    },
    {
      "id": 243159,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 243160,
      "primary_message": "Cut off skin from pineapples; core and small dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 243161,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 243162,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the broccoli slaw; toss to combine the coleslaw and set aside.",
      "secondary_message": "3 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 243163,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 243164,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 243165,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 243166,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 243167,
      "primary_message": "To serve, divide steak and coleslaw between plates or bowls; enjoy!",
      "secondary_message": null
    }
  ],
