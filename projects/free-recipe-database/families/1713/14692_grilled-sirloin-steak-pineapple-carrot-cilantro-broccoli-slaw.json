  "instructions": [
    {
      "id": 243146,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n2 medium carrots\n1 small pineapple\n1 small bunch green onions (scallions)\n1 small bunch cilantro"
    },
    {
      "id": 243147,
      "primary_message": "Juice limes into a large bowl. Add oil, vinegar, and spices; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper\n½ tsp turmeric, ground"
    },
    {
      "id": 243148,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 243149,
      "primary_message": "Cut off skin from pineapple; core and small dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 243150,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 243151,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with the broccoli slaw; toss to combine the coleslaw and set aside.",
      "secondary_message": "2 (12 oz) pkg broccoli slaw"
    },
    {
      "id": 243152,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 243153,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 243154,
      "primary_message": "Once the grill pan is hot, coat with oil; add steak to the pan and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 243155,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 243156,
      "primary_message": "To serve, divide steak and coleslaw between plates or bowls; enjoy!",
      "secondary_message": null
    }
  ],
