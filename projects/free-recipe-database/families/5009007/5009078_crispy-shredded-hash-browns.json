  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel the russet potatoes.",
      "secondary_message": "2 medium russet potatoes"
    },
    {
      "id": 1,
      "primary_message": "Shred potatoes on the largest holes of a box grater.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Wrap potatoes in a kitchen towel or several layers of cheesecloth and twist to squeeze out as much liquid as possible.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer potatoes to a plate lined with 2 layers of paper towels. Cook in a microwave on high for 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat oil in a large nonstick skillet over medium-high heat. When oil shimmers, add shredded potato. Season with a large pinch of salt and pepper. Using a spatula, press potato into an even layer. Cook until golden brown on the bottom, about 2 minutes. Flip potatoes with spatula and brown on the other side, about 2 minutes longer. Remove and drain on a paper towel–lined plate. Serve immediately.",
      "secondary_message": null
    }
  ],
