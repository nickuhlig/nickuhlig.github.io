  "instructions": [
    {
      "id": 1,
      "primary_message": "In a small bowl, use a fork or small whisk to combine maple syrup, melted butter or oil, vanilla extract, salt, and cinnamon, if using. Add oats and nuts and toss to evenly coat. Transfer to a microwave-safe small plate and, using a spatula or back of a soup spoon, gently press mixture into a flat, even layer. Microwave on high power, stirring every 30 seconds, until oats are golden and fragrant, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Working quickly, in a medium bowl, stir dried fruit into the hot granola. (The granola should still be hot and pliable.) Transfer back to plate, then gently press into an even thin layer, and let cool completely, about 5 minutes. Break cooled granola into pieces of desired size. Serve.",
      "secondary_message": null
    }
  ],
