  "instructions": [
    {
      "id": 321652,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n3 bunches kale\n3 pears"
    },
    {
      "id": 321653,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 321654,
      "primary_message": "Finely grate Parmesan; add ⅔ to the bowl with the lemon juice (reserving the rest for serving).",
      "secondary_message": "128 g Parmesan cheese"
    },
    {
      "id": 321655,
      "primary_message": "Add oil and spices to the bowl; whisk to combine the dressing. ",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp garlic powder\n¾ tsp salt\n½ tsp crushed red pepper\n½ tsp black pepper\n3 pinch cinnamon, ground"
    },
    {
      "id": 321656,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 2-3 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 321657,
      "primary_message": "Place additional spices in a small bowl and stir to combine.",
      "secondary_message": "1 ½ tsp paprika\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp cinnamon, ground\n¾ tsp cardamom, ground\n3 pinch coriander, ground"
    },
    {
      "id": 321658,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place on a plate and season with the spice mixture on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 321659,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321660,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove to a plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 321661,
      "primary_message": "Meanwhile, using a clean cutting board, quarter, core, and thinly slice pears; add to the bowl with the kale. ",
      "secondary_message": null
    },
    {
      "id": 321662,
      "primary_message": "Roughly chop pecans and add to the bowl; toss to combine the salad.",
      "secondary_message": "¾ cup pecans, dry roasted"
    },
    {
      "id": 321663,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 321664,
      "primary_message": "To serve, divide the salad between plates or bowls and top with sliced chicken, cranberries, and reserved Parmesan. Enjoy!",
      "secondary_message": "⅓ cup dried cranberries"
    }
  ],
