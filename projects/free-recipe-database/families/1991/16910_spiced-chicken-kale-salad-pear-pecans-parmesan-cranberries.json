  "instructions": [
    {
      "id": 321626,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 bunch kale\n1 pear"
    },
    {
      "id": 321627,
      "primary_message": "Juice lemon into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 321628,
      "primary_message": "Finely grate Parmesan; add ⅔ to the bowl with the lemon juice (reserving the rest for serving).",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 321629,
      "primary_message": "Add oil and spices to the bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp garlic powder\n¼ tsp salt\n⅛ tsp crushed red pepper\n⅛ tsp black pepper\n1 pinch cinnamon, ground"
    },
    {
      "id": 321630,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 321631,
      "primary_message": "Place additional spices in a small bowl and stir to combine.",
      "secondary_message": "½ tsp paprika\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp cinnamon, ground\n¼ tsp cardamom, ground\n1 pinch coriander, ground"
    },
    {
      "id": 321632,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321633,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place on a plate and season with the spice mixture on both sides.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 321634,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 321635,
      "primary_message": "Meanwhile, using a clean cutting board, quarter, core, and thinly slice pear; add to the bowl with the kale. ",
      "secondary_message": null
    },
    {
      "id": 321636,
      "primary_message": "Roughly chop pecans and add to the bowl; toss to combine the salad.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 321637,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 321638,
      "primary_message": "To serve, divide the salad between plates or bowls and top with sliced chicken, cranberries, and reserved Parmesan. Enjoy!",
      "secondary_message": "⅛ cup dried cranberries"
    }
  ],
