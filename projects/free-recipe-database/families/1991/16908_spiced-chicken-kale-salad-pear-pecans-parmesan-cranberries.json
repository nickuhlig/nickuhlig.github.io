  "instructions": [
    {
      "id": 321600,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n2 bunches kale\n2 pears"
    },
    {
      "id": 321601,
      "primary_message": "Juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 321602,
      "primary_message": "Finely grate Parmesan; add ⅔ to the bowl with the lemon juice (reserving the rest for serving).",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 321603,
      "primary_message": "Add oil and spices to the bowl; whisk to combine the dressing. ",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 321604,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems. Finely chop leaves and add to the bowl with the dressing; using your hands, massage kale with the dressing until wilted, about 2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 321605,
      "primary_message": "Place additional spices in a small bowl and stir to combine.",
      "secondary_message": "1 tsp paprika\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper\n½ tsp cinnamon, ground\n½ tsp cardamom, ground\n⅛ tsp coriander, ground"
    },
    {
      "id": 321606,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 321607,
      "primary_message": "While the skillet heats up, holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place on a plate and season with the spice mixture on both sides.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 321608,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and pan-fry until golden brown and cooked through, 3-4 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 321609,
      "primary_message": "Meanwhile, using a clean cutting board, quarter, core, and thinly slice pears; add to the bowl with the kale. ",
      "secondary_message": null
    },
    {
      "id": 321610,
      "primary_message": "Roughly chop pecans and add to the bowl; toss to combine the salad.",
      "secondary_message": "½ cup pecans, dry roasted"
    },
    {
      "id": 321611,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 321612,
      "primary_message": "To serve, divide the salad between plates or bowls and top with sliced chicken, cranberries, and reserved Parmesan. Enjoy!",
      "secondary_message": "½ cup dried cranberries"
    }
  ],
