  "instructions": [
    {
      "id": 4867,
      "primary_message": "Wash zucchini, bell pepper, and carrots. Slice zucchini diagonally into rounds. Seed and cut pepper into 8 strips. Peel, halve crosswise, then halve or quarter carrots lengthwise.",
      "secondary_message": "1 medium zucchini squash\r\n1 red bell pepper\r\n2 medium carrots"
    },
    {
      "id": 4865,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 4866,
      "primary_message": "Transfer vegetables to a large bowl. Drizzle with oil and season with Italian seasoning, salt, and pepper. Toss to coat.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n¼ tsp Italian seasoning\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 4864,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "0.34 kg ribeye steak\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 15562,
      "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 15563,
      "primary_message": "Add vegetables to grill/skillet and cook until tender and charred, 2-3 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 15564,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Peel and mince garlic. In a small bowl, prepare sauce by whisking together parsley, garlic, oil, vinegar, salt, and pepper.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\r\n1 clove garlic\r\n2 tbsp extra virgin olive oil\r\n1 tbsp red wine vinegar\r\n⅛ tsp salt\r\n⅛ tsp black pepper\r\n1 pinch crushed red pepper"
    },
    {
      "id": 15565,
      "primary_message": "To serve, place steak and vegetables on a plate and drizzle with chimichurri sauce. Enjoy!",
      "secondary_message": ""
    }
  ],
