  "instructions": [
    {
      "id": 34340,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "1 cup jasmine rice\n2 cups water\n¼ tsp salt"
    },
    {
      "id": 34341,
      "primary_message": "While the rice comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n2 jalapeño peppers\n4 limes\n2 small pkg fresh basil"
    },
    {
      "id": 34342,
      "primary_message": "Once the water is boiling, reduce the heat to low, stir, and cover. Cook until the liquid is absorbed, 10 to 15 minutes. Remove from the heat and let it stand, covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 34343,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and transfer the leaves to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 34344,
      "primary_message": "Juice three of the limes into a small bowl and cut the remaining lime into wedges (for serving).",
      "secondary_message": null
    },
    {
      "id": 34345,
      "primary_message": "Trim the stem ends of the carrots and peel; discard the trimmings and julienne or coarsely grate the carrots. Transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 34346,
      "primary_message": "Halve the jalapeños lengthwise and remove and discard the seeds; thinly slice the halves crosswise. Transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 34347,
      "primary_message": "Peel and mince the garlic; add to the bowl of jalapeño.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 34348,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 34349,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 34350,
      "primary_message": "Add the jalapeños and garlic; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": null
    },
    {
      "id": 34351,
      "primary_message": "Add the beef and season with salt and pepper. Cook, breaking apart into smaller pieces, until cooked through and browned, 3 to 5 minutes.",
      "secondary_message": "0.68 kg lean ground beef\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 34352,
      "primary_message": "While the beef cooks, add half of the basil leaves and half of the lime juice to the carrots; toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 34353,
      "primary_message": "Add water and the remaining basil leaves to the beef; cook, stirring, until the basil wilts, 1 to 2 minutes.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 34354,
      "primary_message": "In a small bowl, combine and whisk together soy sauce, fish sauce, honey, and the remaining lime juice.",
      "secondary_message": "2 tbsp soy sauce\n1 tbsp fish sauce\n1 tsp honey"
    },
    {
      "id": 34355,
      "primary_message": "Divide the rice between four bowls (or two bowls and two lunch containers), top with the beef and carrot-basil salad, and drizzle with the soy dressing. Serve lime wedges alongside for squeezing. Enjoy!",
      "secondary_message": ""
    }
  ],
