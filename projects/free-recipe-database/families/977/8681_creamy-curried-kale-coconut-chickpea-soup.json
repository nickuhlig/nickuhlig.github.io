  "instructions": [
    {
      "id": 177082,
      "primary_message": "Peel and mince garlic. Peel and small dice onion.",
      "secondary_message": "2 cloves garlic\n1 medium yellow onion"
    },
    {
      "id": 177083,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 177084,
      "primary_message": "Wash, peel, and small dice carrots.",
      "secondary_message": "2 medium carrots"
    },
    {
      "id": 177085,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and carrot; cook, stirring occasionally, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 177086,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 177087,
      "primary_message": "Wash, peel, and mince ginger. Add to the pot along with the spices. Cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 tsp curry powder\n2 tsp cumin\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 177088,
      "primary_message": "Add broth and coconut milk; stir to combine. Bring to a boil over high heat, then reduce heat and simmer until vegetables are tender, about 10 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 (398 ml) can coconut milk"
    },
    {
      "id": 177089,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into pieces.",
      "secondary_message": "1 bunch kale"
    },
    {
      "id": 177090,
      "primary_message": "Add kale and chickpeas to the soup and cook 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 177091,
      "primary_message": "Toast pita if desired. Cut into wedges.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 177092,
      "primary_message": "Meanwhile, using an immersion (hand) blender, purée the soup until smooth.",
      "secondary_message": null
    },
    {
      "id": 177093,
      "primary_message": "To serve, divide soup between bowls with pita on the side. Enjoy!",
      "secondary_message": null
    }
  ],
