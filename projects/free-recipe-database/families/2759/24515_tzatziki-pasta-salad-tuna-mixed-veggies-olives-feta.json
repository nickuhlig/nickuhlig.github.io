  "instructions": [
    {
      "id": 396470,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n283 g macaroni (elbow) pasta"
    },
    {
      "id": 396471,
      "primary_message": "Meanwhile, place tzatziki, vinaigrette, and spices in a large bowl. Stir to combine the dressing. ",
      "secondary_message": "1 cup tzatziki sauce\n¼ cup balsamic vinaigrette\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 396472,
      "primary_message": "Drain tuna. Add to the bowl with the dressing and flake with a fork.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 396473,
      "primary_message": "Wash, dry, trim, and small dice cucumber. Add to the bowl.",
      "secondary_message": "1 English cucumber"
    },
    {
      "id": 396474,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise. Add to the bowl along with the carrots. ",
      "secondary_message": "1 small pkg grape tomatoes\n1 (283 g) bag shredded carrots"
    },
    {
      "id": 396475,
      "primary_message": "Thinly slice olives. Add to the bowl. ",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 396476,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl with the tuna and veggies, then stir to combine the pasta salad. ",
      "secondary_message": null
    },
    {
      "id": 396477,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
