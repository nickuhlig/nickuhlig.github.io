  "instructions": [
    {
      "id": 396390,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n5 oz macaroni (elbow) pasta"
    },
    {
      "id": 396391,
      "primary_message": "Meanwhile, place tzatziki, vinaigrette, and spices in a medium bowl. Stir to combine the dressing. ",
      "secondary_message": "½ cup tzatziki sauce\n2 tbsp balsamic vinaigrette\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 396392,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the dressing.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 396393,
      "primary_message": "Wash, dry, trim, and small dice cucumber. Add to the bowl.",
      "secondary_message": "½ English cucumber"
    },
    {
      "id": 396394,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise. Add to the bowl along with the carrots. ",
      "secondary_message": "½ pint grape tomatoes\n½ (10 oz) bag shredded carrots"
    },
    {
      "id": 396395,
      "primary_message": "Thinly slice olives. Add to the bowl. ",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 396396,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl with the chickpeas and veggies, then stir to combine the pasta salad. ",
      "secondary_message": null
    },
    {
      "id": 396397,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
