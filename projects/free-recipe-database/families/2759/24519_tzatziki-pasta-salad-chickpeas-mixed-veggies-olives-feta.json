  "instructions": [
    {
      "id": 396502,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g macaroni (elbow) pasta"
    },
    {
      "id": 396503,
      "primary_message": "Meanwhile, place tzatziki, vinaigrette, and spices in a large bowl. Stir to combine the dressing. ",
      "secondary_message": "1 ½ cups tzatziki sauce\n⅓ cup balsamic vinaigrette\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 396504,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the dressing.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 396505,
      "primary_message": "Wash, dry, trim, and small dice cucumbers. Add to the bowl.",
      "secondary_message": "1 ½ English cucumbers"
    },
    {
      "id": 396506,
      "primary_message": "Wash, dry, and halve tomatoes lengthwise. Add to the bowl along with the carrots. ",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 ½ (283 g) bags shredded carrots"
    },
    {
      "id": 396507,
      "primary_message": "Thinly slice olives. Add to the bowl. ",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 396508,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool. Add to the bowl with the chickpeas and veggies, then stir to combine the pasta salad. ",
      "secondary_message": null
    },
    {
      "id": 396509,
      "primary_message": "To serve, divide pasta salad between plates or bowls and top with feta. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
