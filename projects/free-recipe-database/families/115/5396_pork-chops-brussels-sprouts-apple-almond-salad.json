  "instructions": [
    {
      "id": 64836,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": ""
    },
    {
      "id": 64835,
      "primary_message": "Place pork chops in a baking dish. Season with salt and pepper.",
      "secondary_message": "6 pork chops, boneless\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 64834,
      "primary_message": "In a small bowl, whisk together maple syrup, Dijon, and vinegar.",
      "secondary_message": "3 tbsp pure maple syrup\n1 ½ tbsp Dijon mustard\n3 tsp balsamic vinegar"
    },
    {
      "id": 64833,
      "primary_message": "Spoon about ½ of the sauce over the pork chops. Place in the oven and bake for 10 minutes. Then flip pork, spoon remaining sauce over top, and continue to bake until pork is cooked through, another 10-15 minutes.",
      "secondary_message": ""
    },
    {
      "id": 64832,
      "primary_message": "Peel and mince garlic. Wash brussels sprouts, trim root ends, and chop into shred-like pieces.",
      "secondary_message": "3 cloves garlic\n1 ½ lb brussels sprouts"
    },
    {
      "id": 64831,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 64830,
      "primary_message": "Coat bottom of skillet with oil. Add garlic and cook until fragrant, 15-30 seconds. Add brussels sprouts and, stirring occasionally, cook until softened, 2-3 minutes. Remove from heat and set aside to cool.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 64829,
      "primary_message": "In a medium bowl, prepare dressing by whisking together lemon juice, olive oil, salt, and pepper.",
      "secondary_message": "1 ½ lemon\n6 tbsp extra virgin olive oil\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 64828,
      "primary_message": "Wash, core, and cut apple into thin medium pieces. Add to bowl with dressing.",
      "secondary_message": "3 Granny Smith apples"
    },
    {
      "id": 64827,
      "primary_message": "Roughly chop almonds and add to bowl.",
      "secondary_message": "⅜ cup almonds"
    },
    {
      "id": 64826,
      "primary_message": "Add brussels sprouts to bowl and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 64825,
      "primary_message": "To serve, place pork chops and salad on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
