  "instructions": [
    {
      "id": 620049,
      "primary_message": "Preheat oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 620050,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "8 medium carrots\n1 lemon\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 620051,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 2-inch long sticks. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620052,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the carrots, along with mayo and spices, then stir to coat. Transfer to the baking sheet and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "85 g Parmesan cheese\n4 tsp mayonnaise\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 620053,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until carrots are fork-tender and cheese is golden and crispy, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 620054,
      "primary_message": "Meanwhile, zest lemon into a small bowl. Add flour and spices, then stir to combine the coating. (Reserve lemon for later use.)",
      "secondary_message": "2 tbsp all-purpose flour\n1 tsp salt\n½ tsp black pepper\n½ tsp garlic powder\n¼ tsp crushed red pepper"
    },
    {
      "id": 620055,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 620056,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; sprinkle with the coating on both sides.",
      "secondary_message": "4 pork chops, bone-in"
    },
    {
      "id": 620057,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate, cover with aluminum foil, and set aside to rest.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 620058,
      "primary_message": "Meanwhile, juice reserved lemon into the reserved medium bowl. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 620059,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 620060,
      "primary_message": "To serve, divide carrots, chops, and dressed greens between plates. Enjoy!",
      "secondary_message": null
    }
  ],
