  "instructions": [
    {
      "id": 620073,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 620074,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "4 medium carrots\n½ lemon\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 620075,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 2-inch long sticks. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620076,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the carrots, along with mayo and spices, then stir to coat. Transfer to the baking sheet and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "43 g Parmesan cheese\n2 tsp mayonnaise\n½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 620077,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until carrots are starting to soften and cheese is golden and crispy, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 620078,
      "primary_message": "Meanwhile, zest lemon into a small bowl. Add flour and spices, then stir to combine the coating. (Reserve lemon for later use.)",
      "secondary_message": "1 tbsp all-purpose flour\n½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder\n⅛ tsp crushed red pepper"
    },
    {
      "id": 620079,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 620080,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels; holding a knife parallel to the cutting board, cut the halloumi in half horizontally, then cut each half lengthwise into 1-inch thick strips. Place on a plate and sprinkle with the coating on both sides.",
      "secondary_message": "1 (250 g) pkg halloumi cheese"
    },
    {
      "id": 620081,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add halloumi and pan-fry until golden brown on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 620082,
      "primary_message": "Meanwhile, juice reserved lemon into the reserved medium bowl. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 620083,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 620084,
      "primary_message": "To serve, divide carrots, halloumi, and dressed greens between plates. Enjoy!",
      "secondary_message": null
    }
  ],
