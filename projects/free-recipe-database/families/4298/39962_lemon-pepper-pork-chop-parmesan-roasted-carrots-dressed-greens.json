  "instructions": [
    {
      "id": 619917,
      "primary_message": "Preheat oven to 425°F. Line two large baking sheet pans with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 619918,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "12 medium carrots\n1 ½ lemons\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 619919,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 2-inch long sticks. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 619920,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the carrots, along with mayo and spices, then stir to coat. Divide between the baking sheets and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": "4 ½ oz Parmesan cheese\n2 tbsp mayonnaise\n1 ½ tsp oregano, dried\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 619921,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until carrots are fork-tender and cheese is golden and crispy, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 619922,
      "primary_message": "Meanwhile, zest lemons into a small bowl. Add flour and spices, then stir to combine the coating. (Reserve lemons for later use.)",
      "secondary_message": "3 tbsp all-purpose flour\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder\n¼ tsp crushed red pepper"
    },
    {
      "id": 619923,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 619924,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; sprinkle with the coating on both sides.",
      "secondary_message": "6 pork chops, bone-in"
    },
    {
      "id": 619925,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate, cover with aluminum foil, and set aside to rest.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 619926,
      "primary_message": "Meanwhile, juice reserved lemons into the reserved large bowl. Add oil, maple syrup, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 619927,
      "primary_message": "Just before serving, add mixed greens to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 619928,
      "primary_message": "To serve, divide carrots, chops, and dressed greens between plates. Enjoy!",
      "secondary_message": null
    }
  ],
