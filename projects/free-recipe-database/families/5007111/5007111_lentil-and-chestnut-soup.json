  "instructions": [
    {
      "id": 1,
      "primary_message": "Pour the oil into a large Dutch oven set over medium heat. When warm, add the minced onion, leek, carrot, and celery. Cook, stirring occasionally, until the vegetables soften but don't brown.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the lentils, stir well, and then pour in the stock. Bring to a boil over high heat, and then reduce heat to maintain a simmer. Cook until the lentils are very soft, about 40 minutes. Add the chestnuts and simmer for 20 more minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Carefully puree the soup in a blender. (You'll probably have to do this in batches.) When done, return the soup to the pot to warm it back up. Season to taste with salt and pepper. Serve with a sprinkling of parsley and a drizzle of heavy cream.",
      "secondary_message": null
    }
  ],
