  "instructions": [
    {
      "primary_message": "Place hot water (from the tap) in a small bowl along with miso paste, flour, and spices. Whisk until slurry is smooth, then set aside.\n\n",
      "secondary_message": "1 ½ tbsp miso paste, white\nall-purpose flour\n¼ tsp garlic powder\n¼ tsp black pepper\n⅛ tsp salt"
    },
    {
      "primary_message": "Wash and dry rosemary. Set aside.\n\n",
      "secondary_message": "1 sprig fresh rosemary"
    },
    {
      "primary_message": "Melt butter in a medium saucepan set over medium-high heat. Once melted, add additional flour and cook, whisking constantly, until the mixture turns golden brown, 2-3 minutes.\n\n",
      "secondary_message": "¼ cup butter, unsalted\n¼ cup all-purpose flour"
    },
    {
      "primary_message": "Gradually add broth to the pan, whisking constantly, then bring to a boil. Once boiling, add slurry and whole rosemary sprig to the pan. Reduce heat to medium and continue to cook, whisking often, until gravy is thickened and flavors blend, about 5 minutes. \n\n",
      "secondary_message": "3 cups chicken or vegetable broth"
    },
    {
      "primary_message": "Remove gravy from heat, add soy sauce, and whisk once more to combine. (Remove and discard rosemary sprig.)\n\n",
      "secondary_message": "2 tsp soy sauce"
    },
    {
      "primary_message": "Serve immediately and enjoy!",
      "secondary_message": null
    }
  ],
