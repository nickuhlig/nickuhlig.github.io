  "instructions": [
    {
      "id": 212035,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 212036,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 jalapeño peppers\n½ lime\n1 medium carrot\n½ small bunch cilantro\n1 tomato\n½ avocado"
    },
    {
      "id": 212037,
      "primary_message": "Peel, halve, and thinly slice onion. Transfer to a baking sheet pan.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 212038,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Add to the baking sheet with the onions. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 212039,
      "primary_message": "Drizzle onions and jalapeños with oil and season with salt; toss to coat. Place in the oven and broil, tossing once, until veggies are soft and blistered, about 10 minutes. Remove from oven and set aside. (Keep the broiler on.)",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 212040,
      "primary_message": "Meanwhile, juice lime into a medium bowl. Add mayo, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup vegan mayonnaise\n1 tsp pure maple syrup\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 212041,
      "primary_message": "Peel and grate the carrot. Add carrot and broccoli slaw to the bowl with the dressing.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 212042,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and toss to combine the slaw; set aside.",
      "secondary_message": null
    },
    {
      "id": 212043,
      "primary_message": "Drain and rinse beans; transfer to another medium bowl.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 212044,
      "primary_message": "Add spices to the bowl with the beans. Crush with a fork or potato masher until almost smooth, with some texture remaining; set aside.",
      "secondary_message": "¼ tsp chili powder\n¼ tsp cumin\n¼ tsp coriander\n¼ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 212045,
      "primary_message": "Remove broiled veggies to a small bowl. Split rolls in half and place, cut-side up, on the baking sheet; spread bean mash over the bottom halves of the rolls. Place in the oven and broil until buns are lightly toasted, and beans are warmed through, 1-2 minutes. Remove from oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 212046,
      "primary_message": "Meanwhile, thinly slice tomato. Halve and pit the avocado; slice thinly while still in skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 212047,
      "primary_message": "Place the bottom of each roll on a plate. Top with tomato, avocado, onions, and jalapeños; close sandwich with top half of the roll. Serve with broccoli slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
