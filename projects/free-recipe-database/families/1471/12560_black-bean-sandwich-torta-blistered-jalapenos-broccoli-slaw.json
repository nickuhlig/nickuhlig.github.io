  "instructions": [
    {
      "id": 212005,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 212006,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 jalapeño peppers\n1 lime\n2 medium carrots\n1 small bunch cilantro\n2 tomatoes\n1 avocado"
    },
    {
      "id": 212007,
      "primary_message": "Peel, halve, and thinly slice onion. Transfer to a large baking sheet pan.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 212008,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Add to the baking sheet with the onions. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 212009,
      "primary_message": "Drizzle onions and jalapeños with oil and season with salt; toss to coat. Place in the oven and broil, tossing once, until veggies are soft and blistered, about 10 minutes. Remove from oven and set aside. (Keep the broiler on.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 212010,
      "primary_message": "Meanwhile, juice lime into a medium bowl. Add yogurt, mayo, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n¼ cup mayonnaise\n2 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 212011,
      "primary_message": "Peel and grate carrots. Add carrots and broccoli slaw to the bowl with the dressing.",
      "secondary_message": "1 (340 g) pkg broccoli slaw"
    },
    {
      "id": 212012,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and toss to combine the slaw; set aside.",
      "secondary_message": null
    },
    {
      "id": 212013,
      "primary_message": "Drain and rinse beans; transfer to another medium bowl.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 212014,
      "primary_message": "Add spices to the bowl with the beans. Crush with a fork or potato masher until almost smooth, with some texture remaining; set aside.",
      "secondary_message": "½ tsp chili powder\n½ tsp cumin\n½ tsp coriander\n½ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 212015,
      "primary_message": "Grate cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 212016,
      "primary_message": "Remove broiled veggies to a plate. Split rolls in half and place, cut-side up, on the baking sheet. Spread bean mash over the bottom halves of the rolls and top with cheese. Place in the oven and broil until buns are lightly toasted, and cheese is melted, 1-2 minutes. Remove from oven.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 212017,
      "primary_message": "Meanwhile, thinly slice tomatoes. Halve and pit the avocado; slice thinly while still in the skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 212018,
      "primary_message": "Place the bottom of each roll on a plate. Top with tomato, avocado, onions, and jalapeños; close sandwich with top half of the roll. Serve with broccoli slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
