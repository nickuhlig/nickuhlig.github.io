  "instructions": [
    {
      "id": 212061,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 212062,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 jalapeño peppers\n1 ½ limes\n3 medium carrots\n1 small bunch cilantro\n3 tomatoes\n1 ½ avocados"
    },
    {
      "id": 212063,
      "primary_message": "Peel, halve, and thinly slice onions. Transfer to a large baking sheet pan.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 212064,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Add to the baking sheet with the onions. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 212065,
      "primary_message": "Drizzle onions and jalapeños with oil and season with salt; toss to coat. Place in the oven and broil, tossing once, until veggies are soft and blistered, about 10 minutes. Remove from oven and set aside. (Keep the broiler on.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 212066,
      "primary_message": "Meanwhile, juice limes into a large bowl. Add mayo, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¾ cup vegan mayonnaise\n1 tbsp pure maple syrup\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 212067,
      "primary_message": "Peel and grate carrots. Add carrots and broccoli slaw to the bowl with the dressing.",
      "secondary_message": "1 ½ (340 g) pkgs broccoli slaw"
    },
    {
      "id": 212068,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and toss to combine the slaw; set aside.",
      "secondary_message": null
    },
    {
      "id": 212069,
      "primary_message": "Drain and rinse beans; transfer to another large bowl.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 212070,
      "primary_message": "Add spices to the bowl with the beans. Crush with a fork or potato masher until almost smooth, with some texture remaining; set aside.",
      "secondary_message": "¾ tsp chili powder\n¾ tsp cumin\n¾ tsp coriander\n¾ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 212071,
      "primary_message": "Remove broiled veggies to a plate. ",
      "secondary_message": null
    },
    {
      "id": 212072,
      "primary_message": "Split rolls in half. Place the top half of each roll, cut-side up, on the baking sheet used for the veggies. Place in the oven and broil until lightly toasted, 1-2 minutes. Remove from oven and set aside.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 212073,
      "primary_message": "Meanwhile, place the bottom half of each roll, cut-side up, on an additional baking sheet pan. Spread bean mash over the bottom halves and top with cheese. Place in the oven and broil until buns are lightly toasted, and beans are warmed through, 1-2 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 212074,
      "primary_message": "Thinly slice tomatoes. Halve and pit the avocados; slice thinly while still in skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 212075,
      "primary_message": "Place the bottom of each roll on a plate. Top with tomato, avocado, onions, and jalapeños; close sandwich with top half of the roll. Serve with broccoli slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
