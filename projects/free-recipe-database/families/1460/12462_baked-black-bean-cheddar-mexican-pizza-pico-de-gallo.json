  "instructions": [
    {
      "id": 209054,
      "primary_message": "Preheat oven to 220°C (425°F) and coat two baking sheet pans with a thin layer of oil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 209055,
      "primary_message": "Meanwhile, preheat a medium saucepan over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209056,
      "primary_message": "Add broth, tomato paste, and spices to the pan. Bring to a simmer, whisking frequently, and cook until slightly thickened, 3-4 minutes. Remove sauce from the heat and set aside. ",
      "secondary_message": "355 ml chicken or vegetable broth\n4 ½ tbsp tomato paste\n¾ tsp cumin\n¾ tsp garlic powder\n¾ tsp chili powder\n½ tsp salt"
    },
    {
      "id": 209057,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander.",
      "secondary_message": "3 (398 ml) cans black beans"
    },
    {
      "id": 209058,
      "primary_message": "Place beans and spices in a large bowl. Crush with a fork or potato masher until almost smooth, with some texture remaining; set aside.",
      "secondary_message": "1 ½ tsp cumin\n1 ½ tsp chili powder\n1 ½ tsp salt\n¾ tsp garlic powder\n¾ tsp onion powder"
    },
    {
      "id": 209059,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 209060,
      "primary_message": "Divide half the tortillas between baking sheets and spread with bean filling; place remaining tortillas on top, pressing gently to adhere. (Reserve bowl for later use.) ",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 209061,
      "primary_message": "Spoon sauce over the tortillas and top with cheese. Place in the oven and bake until the cheese is melted and bubbly, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209062,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 limes\n6 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 209063,
      "primary_message": "Juice limes into the reserved bowl and add salt. ",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 209064,
      "primary_message": "Small dice tomatoes. Peel and small dice onions; add both to the bowl with the lime.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 209065,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the pico de gallo.",
      "secondary_message": null
    },
    {
      "id": 209066,
      "primary_message": "Remove pizzas from the oven and cut into quarters. ",
      "secondary_message": null
    },
    {
      "id": 209067,
      "primary_message": "Divide pizzas between plates; top with pico de gallo and yogurt. Enjoy! ",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
