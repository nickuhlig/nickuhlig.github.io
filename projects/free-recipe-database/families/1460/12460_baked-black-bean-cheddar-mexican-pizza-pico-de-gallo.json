  "instructions": [
    {
      "id": 209026,
      "primary_message": "Preheat oven to 220°C (425°F) and coat a baking sheet pan with a thin layer of oil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 209027,
      "primary_message": "Meanwhile, preheat a small saucepan over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209028,
      "primary_message": "Add broth, tomato paste, and spices to the pan. Bring to a simmer, whisking frequently, and cook until slightly thickened, 2-3 minutes. Remove sauce from the heat and set aside. ",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n1 ½ tbsp tomato paste\n¼ tsp cumin\n¼ tsp garlic powder\n¼ tsp chili powder\n⅛ tsp salt"
    },
    {
      "id": 209029,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 209030,
      "primary_message": "Place beans and spices in a medium bowl. Crush with a fork or potato masher until almost smooth, with some texture remaining; set aside.",
      "secondary_message": "½ tsp cumin\n½ tsp chili powder\n½ tsp salt\n¼ tsp garlic powder\n¼ tsp onion powder"
    },
    {
      "id": 209031,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 209032,
      "primary_message": "Place half the tortillas on the baking sheet and spread with bean filling; place remaining tortillas on top, pressing gently to adhere. (Reserve bowl for later use.) ",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 209033,
      "primary_message": "Spoon sauce over the tortillas and top with cheese. Place in the oven and bake until the cheese is melted and bubbly, 8-10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209034,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 tomatoes\n½ small bunch cilantro"
    },
    {
      "id": 209035,
      "primary_message": "Juice lime into the reserved bowl and add salt. ",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 209036,
      "primary_message": "Small dice tomatoes. Peel and small dice onion; add both to the bowl with the lime.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 209037,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the pico de gallo.",
      "secondary_message": null
    },
    {
      "id": 209038,
      "primary_message": "Remove pizzas from the oven and cut into quarters. ",
      "secondary_message": null
    },
    {
      "id": 209039,
      "primary_message": "Divide pizzas between plates; top with pico de gallo and yogurt. Enjoy! ",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
