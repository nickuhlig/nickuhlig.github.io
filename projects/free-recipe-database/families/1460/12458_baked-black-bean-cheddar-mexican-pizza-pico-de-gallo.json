  "instructions": [
    {
      "id": 208998,
      "primary_message": "Preheat oven to 425°F and coat a large baking sheet pan with a thin layer of oil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 208999,
      "primary_message": "Meanwhile, preheat a small saucepan over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 209000,
      "primary_message": "Add broth, tomato paste, and spices to the pan. Bring to a simmer, whisking frequently, and cook until slightly thickened, 3-4 minutes. Remove sauce from the heat and set aside. ",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n3 tbsp tomato paste\n½ tsp cumin\n½ tsp garlic powder\n½ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 209001,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 209002,
      "primary_message": "Place beans and spices in a medium bowl. Crush with a fork or potato masher until almost smooth, with some texture remaining; set aside.",
      "secondary_message": "1 tsp cumin\n1 tsp chili powder\n1 tsp salt\n½ tsp garlic powder\n½ tsp onion powder"
    },
    {
      "id": 209003,
      "primary_message": "Coarsely grate cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 209004,
      "primary_message": "Place half the tortillas on the baking sheet and spread with bean filling; place remaining tortillas on top, pressing gently to adhere. (Reserve bowl for later use.) ",
      "secondary_message": "8 small flour tortillas"
    },
    {
      "id": 209005,
      "primary_message": "Spoon sauce over the tortillas and top with cheese. Place in the oven and bake until the cheese is melted and bubbly, 8-10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 209006,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 limes\n4 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 209007,
      "primary_message": "Juice limes into the reserved bowl and add salt. ",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 209008,
      "primary_message": "Small dice tomatoes. Peel and small dice onion; add both to the bowl with the lime.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 209009,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the pico de gallo.",
      "secondary_message": null
    },
    {
      "id": 209010,
      "primary_message": "Remove pizzas from the oven and cut into quarters. ",
      "secondary_message": null
    },
    {
      "id": 209011,
      "primary_message": "Divide pizzas between plates; top with pico de gallo and yogurt. Enjoy! ",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
