  "instructions": [
    {
      "id": 23067,
      "primary_message": "Preheat oven to 450°F and position rack in the centre.",
      "secondary_message": ""
    },
    {
      "id": 23068,
      "primary_message": "Wash squash, trim ends, and peel. Halve lengthwise, scape out seeds, and medium dice the flesh.",
      "secondary_message": "1 small butternut squash\n"
    },
    {
      "id": 23069,
      "primary_message": "Place squash on a baking sheet, drizzle with olive oil, and season with salt, pepper, and cumin; toss to coat. Place in the oven and roast until tender, 15-20 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper\r\n⅛ tsp cumin"
    },
    {
      "id": 23071,
      "primary_message": "Cube bread into 1 inch pieces. Peel and mince garlic.",
      "secondary_message": "1 whole grain bun or roll\r\n2 cloves garlic"
    },
    {
      "id": 23072,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 23073,
      "primary_message": "Finely grate ⅛ cup of Parmesan.",
      "secondary_message": "½ oz Parmesan cheese\r\n"
    },
    {
      "id": 23074,
      "primary_message": "Melt butter in skillet. Add garlic and sage; stir until fragrant. Add bread cubes and toast, tossing often, until they begin to brown, 4-5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\r\n⅛ tsp sage"
    },
    {
      "id": 23075,
      "primary_message": "In a small bowl, prepare dressing by whisking together olive oil, vinegar, maple syrup, salt, and pepper. Set aside.",
      "secondary_message": "4 tbsp extra virgin olive oil\r\n1 ½ tbsp balsamic vinegar\r\n½ tsp pure maple syrup\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 23076,
      "primary_message": "Add Parmesan, pumpkin seeds, salt, and pepper to croutons; continue to toss until bread is golden brown and crispy, 2-3 minutes more. Remove from heat.",
      "secondary_message": "¼ cup pumpkin seeds\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 23077,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to a salad bowl.",
      "secondary_message": "1 bunch kale\r\n"
    },
    {
      "id": 23078,
      "primary_message": "Wash, core, and thinly slice apple; add to salad bowl. Peel and thinly slice shallot; add to salad bowl.",
      "secondary_message": "1 Gala apple\n1 shallot"
    },
    {
      "id": 23079,
      "primary_message": "Add squash, croutons, and pumpkin seeds to salad bowl; toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 23080,
      "primary_message": "To serve, arrange salad on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
