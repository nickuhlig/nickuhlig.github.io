  "instructions": [
    {
      "id": 65606,
      "primary_message": "Preheat oven to 230°C (450°F) and position rack in the centre.",
      "secondary_message": ""
    },
    {
      "id": 65605,
      "primary_message": "Wash squash, trim ends, and peel. Halve lengthwise, scape out seeds, and medium dice the flesh.",
      "secondary_message": "3 small butternut squash"
    },
    {
      "id": 65604,
      "primary_message": "Place squash on a baking sheet, drizzle with olive oil, and season with salt, pepper, and cumin; toss to coat. Place in the oven and roast until tender, 15-20 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅜ tsp salt\n⅜ tsp black pepper\n⅜ tsp cumin"
    },
    {
      "id": 65603,
      "primary_message": "Cube bread into 2 ½ cm pieces. Peel and mince garlic.",
      "secondary_message": "3 whole grain buns or rolls\n6 cloves garlic"
    },
    {
      "id": 65602,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 65595,
      "primary_message": "Melt oil in skillet. Add garlic and sage; stir until fragrant. Add bread cubes and toast, tossing often, until they begin to brown, 4-5 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil\n⅜ tsp sage"
    },
    {
      "id": 65596,
      "primary_message": "In a medium bowl, prepare dressing by whisking together olive oil, vinegar, maple syrup, salt, and pepper. Set aside.",
      "secondary_message": "12 tbsp extra virgin olive oil\n4 ½ tbsp balsamic vinegar\n1 ½ tsp pure maple syrup\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 65597,
      "primary_message": "Add pumpkin seeds, salt, and pepper to croutons; continue to toss until bread is golden brown and crispy, 2-3 minutes more. Remove from heat.",
      "secondary_message": "¾ cup pumpkin seeds\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 65598,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise and slice off the stems. Chop or tear leaves into bite-sized pieces and transfer to a salad bowl.",
      "secondary_message": "3 bunches kale"
    },
    {
      "id": 65601,
      "primary_message": "Wash, core, and thinly slice apples; add to salad bowl. Peel and thinly slice shallots; add to salad bowl.",
      "secondary_message": "3 Gala apples\n3 shallots"
    },
    {
      "id": 65600,
      "primary_message": "Add squash, croutons, and pumpkin seeds to salad bowl; toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 65599,
      "primary_message": "To serve, arrange salad on a plate and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
