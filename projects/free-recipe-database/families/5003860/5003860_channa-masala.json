  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly chop the garlic. Peel and roughly chop the ginger. Roughly chop the green Thai chiles. Juice the lemon. Finely dice the onion. Drain and rinse the chickpeas. Roughly chop the cilantro leaves.",
      "secondary_message": "4 medium cloves garlic\n1 (1 inch) knob ginger root\n1 to 6 green Thai chiles\n1 lemon, divided\n1 large onion\n2 (14 oz) cans chickpeas\n1 cup cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Combine garlic, ginger, chiles, 1 tablespoon lemon juice, and 1/2 teaspoon kosher salt in a mortar and pestle or in the small work bowl of a food processor and pound or process until a fine paste is produced. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil or ghee in a large saucepan or Dutch oven over medium-high heat until shimmering. All at once, add mustard seeds and cumin. They will sputter and spit for a few seconds. As soon as they are aromatic (about 15 seconds), add onion all at once, along with baking soda. Cook, stirring frequently, until onions start to leave a brown coating on bottom of pan, 3 to 4 minutes. Add 1 tablespoon water, scrape up browned bits from pan, and continue cooking. Repeat this process until onions are a deep brown, about 10 minutes total.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Immediately add garlic/ginger/chile paste all at once and stir to combine. Add coriander, black pepper, turmeric, and 1 teaspoon garam masala. Stir until fragrant, about 30 seconds. Add tomatoes and crush them using a whisk or potato masher. Add drained, rinsed chickpeas and cilantro, reserving a little cilantro for garnish. Add 1/2 cup water.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Bring to a simmer, cover with lid slightly cracked, and reduce heat to maintain a gentle bubbling. Cook, stirring occasionally, until liquid has reduced into a thick stew and spices have melded, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Stir in remaining garam masala and lemon juice. Season to taste with salt. Serve with rice and/or naan, sprinkling additional cilantro on top.",
      "secondary_message": null
    }
  ],
