  "instructions": [
    {
      "id": 1,
      "primary_message": "Pour grapefruit juice, rye, lemon juice, and simple syrup in a cocktail shaker. Fill with ice and shake until well chilled, about 15 seconds. Strain into a highball glass filled with ice. Top with Lillet Rouge or Carpano and add 2 dashes grapefruit bitters. Serve.",
      "secondary_message": null
    }
