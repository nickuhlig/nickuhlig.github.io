  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a large baking dish. Add hot water (from the tap) and spices, then stir to combine.\n\n",
      "secondary_message": "1 ½ cups basmati rice\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "Top rice with veggies, spreading them out in an even layer (do not stir).\n\n",
      "secondary_message": "2 (454 g) pkg frozen mixed vegetables (broccoli, cauliflower, carrots)"
    },
    {
      "primary_message": "Cut sausages crosswise into 1/2-inch thick pieces, then arrange over the veggies (do not stir).\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Cover baking dish tightly with aluminum foil and place in the preheated oven. Bake until the rice is tender and veggies and sausages are warmed through, about 60 minutes. Remove from oven and allow to sit for 5 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, uncover casserole, stir to combine, and divide between plates or bowls. Drizzle with pesto and enjoy!\n\n",
      "secondary_message": "½ cup basil pesto"
    }
  ],
