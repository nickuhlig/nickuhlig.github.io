  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the zest from the lemon. Juice the lemons.",
      "secondary_message": "2 tbsp lemon zest\n3 lemons"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together honey, cinnamon, and pectin until thoroughly combined. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a heavy-bottomed, medium saucepan, combine cherries, lemon zest, lemon juice, salt, and 2 cups water. Bring to a boil over medium-high heat, cover, and reduce heat to maintain a simmer. Cook until cherries are tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer cherry mixture and cooking liquid to a blender jar. Remove the blender lid plug (this will allow steam pressure to escape), close lid, and set a folded clean dish towel on top to cover the hole in the blender lid (keep your hand on the towel to hold it in place). Blend cherry mixture until smooth. Return to saucepan and stir in reserved honey mixture. Bring to a boil over high heat and cook at a rapid boil for 1 minute.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove saucepan from heat and let cool. Refrigerate in an airtight container for up to 1 month, or ladle cherry butter into hot, sterilized jars and process in a hot water bath for 10 minutes.",
      "secondary_message": null
    }
  ],
