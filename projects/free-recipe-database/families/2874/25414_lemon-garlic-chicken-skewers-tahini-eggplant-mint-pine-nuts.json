  "instructions": [
    {
      "id": 407891,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 407892,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 407893,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 eggplant\n1 lemon\n½ small pkg fresh mint"
    },
    {
      "id": 407894,
      "primary_message": "Halve eggplant lengthwise, then using the tip of your knife, score the flesh in a crisscross pattern, about 1-inch apart. Arrange halves, scored-side up, on a baking sheet pan; drizzle with oil and season with salt.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 407895,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until eggplant is tender and golden brown, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 407896,
      "primary_message": "Meanwhile, zest half of the lemon into a medium bowl. (Set whole lemon aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 407897,
      "primary_message": "Add mayo and spices to the bowl with the lemon zest. Whisk to combine the marinade.",
      "secondary_message": "2 tbsp mayonnaise\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 407898,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 407899,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 407900,
      "primary_message": "While the pan heats up, thread chicken onto skewers and place on a plate. Alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 407901,
      "primary_message": "Once the pan is hot, add the skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 407902,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems. Using a clean cutting board, mince half of the leaves and place in a small bowl. Roughly chop (or tear) remaining leaves and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 407903,
      "primary_message": "Juice half of the lemon into the bowl with the mint. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 407904,
      "primary_message": "Add tahini, water, and spices to the bowl, then whisk to combine the sauce.",
      "secondary_message": "2 tbsp tahini\n2 tbsp water\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 407905,
      "primary_message": "Divide skewers and eggplant between plates; top eggplant with tahini sauce, pine nuts, and reserved mint. Serve with lemon wedges on the side. Enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
