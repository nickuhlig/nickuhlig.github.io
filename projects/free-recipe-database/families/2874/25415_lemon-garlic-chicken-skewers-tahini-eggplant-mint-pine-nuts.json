  "instructions": [
    {
      "id": 407906,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 407907,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 407908,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n2 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 407909,
      "primary_message": "Halve eggplants lengthwise, then using the tip of your knife, score the flesh in a crisscross pattern, about 1-inch apart. Arrange halves, scored-side up, on a large baking sheet pan; drizzle with oil and season with salt.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 407910,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until eggplant is tender and golden brown, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 407911,
      "primary_message": "Meanwhile, zest one lemon into a medium bowl. (Set lemons aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 407912,
      "primary_message": "Add mayo and spices to the bowl with the lemon zest. Whisk to combine the marinade.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 407913,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 407914,
      "primary_message": "Thread chicken onto skewers and place on a plate. Alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 407915,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 407916,
      "primary_message": "Once the pan is hot, working in batches if necessary, add the skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 407917,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems. Using a clean cutting board, mince half of the leaves and place in a small bowl. Roughly chop (or tear) remaining leaves and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 407918,
      "primary_message": "Juice the zested lemon into the bowl with the mint. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 407919,
      "primary_message": "Add tahini, water, and spices to the bowl, then whisk to combine the sauce.",
      "secondary_message": "¼ cup tahini\n¼ cup water\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 407920,
      "primary_message": "Divide skewers and eggplant between plates; top eggplant with tahini sauce, pine nuts, and reserved mint. Serve with lemon wedges on the side. Enjoy!",
      "secondary_message": "¼ cup pine nuts"
    }
  ],
