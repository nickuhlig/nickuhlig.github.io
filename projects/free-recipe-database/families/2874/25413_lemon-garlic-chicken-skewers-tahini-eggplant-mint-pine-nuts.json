  "instructions": [
    {
      "id": 407876,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 407877,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 407878,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 407879,
      "primary_message": "Halve eggplants lengthwise, then using the tip of your knife, score the flesh in a crisscross pattern, about 1-inch apart. Divide halves, scored-side up, between two baking sheet pans; drizzle with oil and season with salt.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 407880,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until eggplant is tender and golden brown, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 407881,
      "primary_message": "Meanwhile, zest half of the lemons into a large bowl. (Set lemons aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 407882,
      "primary_message": "Add mayo and spices to the bowl with the lemon zest. Whisk to combine the marinade.",
      "secondary_message": "⅓ cup mayonnaise\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 407883,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 407884,
      "primary_message": "Thread chicken onto skewers and place on a plate. Alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 407885,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 407886,
      "primary_message": "Once the pan is hot, working in batches, add the skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 407887,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems. Using a clean cutting board, mince half of the leaves and place in a small bowl. Roughly chop (or tear) remaining leaves and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 407888,
      "primary_message": "Juice half of the lemons into the bowl with the mint. Cut remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 407889,
      "primary_message": "Add tahini, water, and spices to the bowl, then whisk to combine the sauce.",
      "secondary_message": "⅓ cup tahini\n⅓ cup water\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 407890,
      "primary_message": "Divide skewers and eggplant between plates; top eggplant with tahini sauce, pine nuts, and reserved mint. Serve with lemon wedges on the side. Enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
