  "instructions": [
    {
      "id": 497119,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Place half in a medium bowl and set remaining aside for serving.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 497120,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497121,
      "primary_message": "While the skillet heats up, stack roast beef slices one on top of another, then medium dice. Add to the bowl with the green onion.",
      "secondary_message": "454 g deli roast beef"
    },
    {
      "id": 497122,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add green onions, roast beef, shredded cabbage, and spices. Stir to combine, then cover and cook, stirring occasionally, until cabbage is tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp butter, unsalted\n2 (397 g) bags shredded cabbage (coleslaw mix)\n1 tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 497123,
      "primary_message": "Meanwhile, place dressing, ketchup, and hot sauce in the reserved bowl. Stir to combine the special sauce.",
      "secondary_message": "½ cup ranch dressing\n2 tbsp ketchup\n4 tsp hot sauce"
    },
    {
      "id": 497124,
      "primary_message": "When the cabbage is tender, remove skillet from heat, and sprinkle cheese over top. Re-cover and let sit until cheese starts to melt, about 2 minutes.",
      "secondary_message": "2 cups shredded cheese, Italian blend"
    },
    {
      "id": 497125,
      "primary_message": "To serve, divide cheesy cabbage and roast beef between bowls. Drizzle with special sauce and sprinkle with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
