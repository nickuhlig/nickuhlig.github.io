  "instructions": [
    {
      "id": 497072,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497073,
      "primary_message": "While the skillet heats up, medium dice tempeh. Place in a medium bowl, add soy sauce, and stir to coat.",
      "secondary_message": "2 (8 oz) packages tempeh\n2 tbsp soy sauce"
    },
    {
      "id": 497074,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add tempeh and cook, stirring occasionally, until golden, 2-3 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 497075,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Set half aside for serving.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 497076,
      "primary_message": "When the tempeh is golden, add remaining green onions, shredded cabbage, and spices to the skillet. Cover and continue to cook, stirring occasionally, until cabbage is tender, 4-5 minutes more. ",
      "secondary_message": "2 (14 oz) bags shredded cabbage (coleslaw mix)\n1 tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 497077,
      "primary_message": "While the cabbage is cooking, place dressing, ketchup, and hot sauce in the reserved bowl. Stir to combine the special sauce.",
      "secondary_message": "½ cup ranch dressing\n2 tbsp ketchup\n4 tsp hot sauce"
    },
    {
      "id": 497078,
      "primary_message": "When the cabbage is tender, remove skillet from heat, and sprinkle cheese over top. Re-cover and let sit until cheese starts to melt, about 2 minutes.",
      "secondary_message": "2 cups shredded cheese, Italian blend"
    },
    {
      "id": 497079,
      "primary_message": "To serve, divide cheesy cabbage and tempeh between bowls. Drizzle with special sauce and sprinkle with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
