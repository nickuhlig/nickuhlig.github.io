  "instructions": [
    {
      "id": 497080,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497081,
      "primary_message": "While the pot heats up, medium dice tempeh. Place in a medium bowl, add soy sauce, and stir to coat.",
      "secondary_message": "3 (8 oz) packages tempeh\n3 tbsp soy sauce"
    },
    {
      "id": 497082,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add tempeh and cook, stirring occasionally, until golden, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 497083,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Set half aside for serving.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 497084,
      "primary_message": "When the tempeh is golden, add remaining green onions, shredded cabbage, and spices to the pot. Cover and continue to cook, stirring occasionally, until cabbage is tender, 5-6 minutes more. ",
      "secondary_message": "3 (14 oz) bags shredded cabbage (coleslaw mix)\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 497085,
      "primary_message": "While the cabbage is cooking, place dressing, ketchup, and hot sauce in the reserved bowl. Stir to combine the special sauce.",
      "secondary_message": "¾ cup ranch dressing\n3 tbsp ketchup\n2 tbsp hot sauce"
    },
    {
      "id": 497086,
      "primary_message": "When the cabbage is tender, remove pot from heat, and sprinkle cheese over top. Re-cover and let sit until cheese starts to melt, 2-3 minutes.",
      "secondary_message": "3 cups shredded cheese, Italian blend"
    },
    {
      "id": 497087,
      "primary_message": "To serve, divide cheesy cabbage and tempeh between bowls. Drizzle with special sauce and sprinkle with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
