  "instructions": [
    {
      "id": 497057,
      "primary_message": "Wash, dry, trim, and cut green onions crosswise into thin pieces. Place half in a medium bowl and set remaining aside for serving.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 497058,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 497059,
      "primary_message": "While the pot heats up, stack roast beef slices one on top of another, then medium dice. Add to the bowl with the green onion.",
      "secondary_message": "24 oz deli roast beef"
    },
    {
      "id": 497060,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add green onions, roast beef, shredded cabbage, and spices. Stir to combine, then cover and cook, stirring occasionally, until cabbage is tender, 6-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "¼ cup butter, unsalted\n3 (14 oz) bags shredded cabbage (coleslaw mix)\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 497061,
      "primary_message": "Meanwhile, place dressing, ketchup, and hot sauce in the reserved bowl. Stir to combine the special sauce.",
      "secondary_message": "¾ cup ranch dressing\n3 tbsp ketchup\n2 tbsp hot sauce"
    },
    {
      "id": 497062,
      "primary_message": "When the cabbage is tender, remove pot from heat, and sprinkle cheese over top. Re-cover and let sit until cheese starts to melt, 2-3 minutes.",
      "secondary_message": "3 cups shredded cheese, Italian blend"
    },
    {
      "id": 497063,
      "primary_message": "To serve, divide cheesy cabbage and roast beef between bowls. Drizzle with special sauce and sprinkle with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
