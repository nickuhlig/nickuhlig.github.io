  "instructions": [
    {
      "id": 441720,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 441721,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels and cut into portions. Season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 441722,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add steaks and cook until desired doneness, 2-5 minutes per side. Transfer to a plate, cover with aluminum foil, and set aside to rest. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 441723,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and, using a clean cutting board, slice off the stems. Cut leaves into bite-sized pieces and thinly slice the stems, keeping them separate. Place leaves in a medium bowl, reserving stems for the next step.",
      "secondary_message": "1 bunch Swiss chard"
    },
    {
      "id": 441724,
      "primary_message": "Preheat another skillet over medium heat. Once the skillet is hot, add butter and swirl to coat the bottom. Add chard stems, salt, and pepper to the skillet; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 441725,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 441726,
      "primary_message": "Wash, dry, and juice lemon into the skillet with the chard and stir to combine. Cover and remove from heat.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 441727,
      "primary_message": "Peel and slice shallot crosswise into thin rounds.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 441728,
      "primary_message": "Return reserved skillet (with steak drippings) to medium heat, add more butter, and swirl to coat the bottom. Add shallot and cook, stirring occasionally, until softened and lightly browned, 4-5 minutes.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 441729,
      "primary_message": "When the shallots are soft, add water and vinegar to the skillet. Bring to a simmer and cook until sauce is reduced by half, 1-2 minutes. Remove from heat.",
      "secondary_message": "2 tbsp water\n2 tbsp red wine vinegar"
    },
    {
      "id": 441730,
      "primary_message": "To serve, divide steaks and lemony chard between plates. Spoon shallot sauce over steaks and enjoy!",
      "secondary_message": null
    }
  ],
