  "instructions": [
    {
      "id": 1,
      "primary_message": "In a blender, combine Clamato, cilantro, lemon juice, onion, jalapeño, coriander seed, and Worcestershire sauce. Blend at high speed until solids are thoroughly blended into liquid. Season lightly with salt. Chill in the refrigerator or by stirring with ice briefly and then straining. Serve in a shot glass alongside a good-quality silver tequila.",
      "secondary_message": null
