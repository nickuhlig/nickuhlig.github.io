  "instructions": [
    {
      "id": 536501,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 536502,
      "primary_message": "While the pot heats up, pat steak dry with paper towels. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 536503,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until golden brown, about 2 minutes per side (it will not be cooked all the way through). Transfer to a plate. (Reserve pot with drippings for later use.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 536504,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 yellow bell peppers\n1 ½ lb cremini mushrooms\n1 small pkg fresh basil"
    },
    {
      "id": 536505,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 536506,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 536507,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 536508,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 536509,
      "primary_message": "Return pot (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add veggies, basil, and spices; cook, stirring often, until the veggies have softened, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 536510,
      "primary_message": "Add tomatoes, broth, and tomato paste to the pot; stir to combine the sauce. Bring to a simmer, then nestle steak into the sauce and cook, turning once, until sauce has thickened and steak is desired doneness, 7-8 minutes. Remove from heat.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n8 fl oz (1 cup) chicken or vegetable broth\n3 tbsp tomato paste"
    },
    {
      "id": 536511,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 536512,
      "primary_message": "Transfer the steak to a cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 536513,
      "primary_message": "To serve, divide veggies and sauce between plates or bowls. Top with sliced steak, Parmesan, and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
