  "instructions": [
    {
      "id": 536475,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 536476,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels. Season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 536477,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until golden brown, about 2 minutes per side (it will not be cooked all the way through). Transfer to a plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 536478,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 yellow bell pepper\n½ lb cremini mushrooms\n½ small pkg fresh basil"
    },
    {
      "id": 536479,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 536480,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 536481,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 536482,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl (reserving a small handful for serving).",
      "secondary_message": null
    },
    {
      "id": 536483,
      "primary_message": "Return skillet (with drippings) to medium heat, add more oil, and swirl to coat the bottom. Add veggies, basil, and spices; cook, stirring often, until the veggies have softened, 5-6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 536484,
      "primary_message": "Add tomatoes, broth, and tomato paste to the skillet; stir to combine the sauce. Bring to a simmer, then nestle steak into the sauce and cook, turning once, until sauce has thickened and steak is desired doneness, 6-7 minutes. Remove from heat.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n4 fl oz (½ cup) chicken or vegetable broth\n1 tbsp tomato paste"
    },
    {
      "id": 536485,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 536486,
      "primary_message": "Transfer the steak to a cutting board and thinly slice against the grain.",
      "secondary_message": null
    },
    {
      "id": 536487,
      "primary_message": "To serve, divide veggies and sauce between plates or bowls. Top with sliced steak, Parmesan, and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
