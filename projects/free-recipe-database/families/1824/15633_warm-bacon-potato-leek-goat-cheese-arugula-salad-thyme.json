  "instructions": [
    {
      "id": 257129,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 lb new potatoes\n4 leeks\n1 small pkg fresh thyme\n2 (5 oz) pkgs baby arugula"
    },
    {
      "id": 257130,
      "primary_message": "Halve potatoes, transfer to a large pot, cover with hot water (from the tap), and bring to a boil over high heat. Once boiling, reduce heat to medium, and cook until fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 257131,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 257132,
      "primary_message": "While the skillet heats up, small dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 257133,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate. (Set skillet with drippings aside for later use).",
      "secondary_message": null
    },
    {
      "id": 257134,
      "primary_message": "Meanwhile, trim off the root ends and the dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick half-moons.",
      "secondary_message": null
    },
    {
      "id": 257135,
      "primary_message": "Peel and mince shallots.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 257136,
      "primary_message": "Return skillet to medium heat. Add leeks, shallots, salt, and pepper; cook, stirring occasionally, until leeks begin to soften, 3-4 minutes.",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257137,
      "primary_message": "Add vinegar to the skillet; continue to cook, stirring occasionally, until the liquid is reduced by about half, 3-4 minutes. ",
      "secondary_message": "¼ cup apple cider vinegar"
    },
    {
      "id": 257138,
      "primary_message": "Slide thyme leaves off the stems; discard the stems.",
      "secondary_message": null
    },
    {
      "id": 257139,
      "primary_message": "Remove the skillet from the heat and stir in thyme.",
      "secondary_message": null
    },
    {
      "id": 257140,
      "primary_message": "When the potatoes are done, drain and rinse under cold water to cool. Add drained potatoes to the skillet and toss with the warm dressing.",
      "secondary_message": null
    },
    {
      "id": 257141,
      "primary_message": "To serve, divide arugula between plates or bowls; top with potatoes, warm dressing, and bacon. Crumble goat cheese over top and enjoy!",
      "secondary_message": "2 (4 oz) logs goat cheese"
    }
  ],
