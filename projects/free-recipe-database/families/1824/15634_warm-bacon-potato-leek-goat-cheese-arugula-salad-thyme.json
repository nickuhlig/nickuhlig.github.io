  "instructions": [
    {
      "id": 257142,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 lb new potatoes\n6 leeks\n1 small pkg fresh thyme\n3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 257143,
      "primary_message": "Halve potatoes, transfer to a large pot, cover with hot water (from the tap), and bring to a boil over high heat. Once boiling, reduce heat to medium, and cook until fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 257144,
      "primary_message": "Meanwhile, small dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 257145,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 257146,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate. (Set pot with drippings aside for later use).",
      "secondary_message": null
    },
    {
      "id": 257147,
      "primary_message": "Meanwhile, trim off the root ends and the dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick half-moons.",
      "secondary_message": null
    },
    {
      "id": 257148,
      "primary_message": "Peel and mince red onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 257149,
      "primary_message": "Return pot to medium heat. Add leeks, onion, salt, and pepper; cook, stirring occasionally, until leeks begin to soften, 4-5 minutes.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 257150,
      "primary_message": "Add vinegar to the pot; continue to cook, stirring occasionally, until the liquid is reduced by about half, 4-5 minutes. ",
      "secondary_message": "⅓ cup apple cider vinegar"
    },
    {
      "id": 257151,
      "primary_message": "Slide thyme leaves off the stems; discard the stems.",
      "secondary_message": null
    },
    {
      "id": 257152,
      "primary_message": "Remove the pot from the heat and stir in thyme.",
      "secondary_message": null
    },
    {
      "id": 257153,
      "primary_message": "When the potatoes are done, drain and rinse under cold water to cool. Add drained potatoes to the pot and toss with the warm dressing.",
      "secondary_message": null
    },
    {
      "id": 257154,
      "primary_message": "To serve, divide arugula between plates or bowls; top with potatoes, warm dressing, and bacon. Crumble goat cheese over top and enjoy!",
      "secondary_message": "3 (4 oz) logs goat cheese"
    }
  ],
