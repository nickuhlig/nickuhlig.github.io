  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place water in a small saucepan and bring to a boil over high heat. Once boiling, remove from heat, add dried shiitake mushrooms, and set aside to rehydrate, about 10 minutes. \n\n",
      "secondary_message": "1 cup water\n28 g dried shitake mushrooms"
    },
    {
      "primary_message": "Meanwhile, preheat a Dutch oven over medium-high heat. Once hot, add oil and swirl to coat the bottom. Add sliced white mushrooms and salt; cook, stirring occasionally, until softened, 6-7 minutes.\n\n",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 (227 g) pkg sliced white mushrooms\n¼ tsp salt"
    },
    {
      "primary_message": "While the white mushrooms are cooking, drain and rinse beans. Set aside to drain further.\n\n",
      "secondary_message": "1 (258 g) can black beans"
    },
    {
      "primary_message": "When the white mushrooms are softened, add garlic and spices to the pot. Continue to cook, stirring occasionally, until fragrant, about 30 seconds. \n\n",
      "secondary_message": "1 tbsp minced garlic\n3 tbsp chili powder\n1 tbsp cumin, ground\n½ tsp salt"
    },
    {
      "primary_message": "Crumble tempeh into the pot, then add drained beans, tomatoes, broth, frozen pepper strips, and sugar. Stir to combine and bring to a boil over high heat.\n\n",
      "secondary_message": "1 (227 g) pkg tempeh\n2 (411 g) can diced tomatoes\n2 cups mushroom broth\n1 (396 g) bag frozen pepper strips\n1 tbsp brown sugar"
    },
    {
      "primary_message": "Once the shitake mushrooms are rehydrated, drain, reserving the liquid. Roughly chop mushrooms, then add to the pot along with reserved liquid. Stir to combine and cover with a lid.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place chili in the oven (it doesn't need to be boiling) and bake until the flavors have blended, about 1 hour. Remove from oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide chili between bowls, then top with guacamole and shredded cheese. Enjoy! \n\n",
      "secondary_message": "1 cup guacamole\n1 cup vegan shredded cheese"
    }
  ],
