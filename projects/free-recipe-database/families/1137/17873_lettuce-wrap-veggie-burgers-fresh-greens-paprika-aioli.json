  "instructions": [
    {
      "id": 289307,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n1 green bell pepper\n½ small pkg grape tomatoes\n1 head butter (Boston) lettuce"
    },
    {
      "id": 289308,
      "primary_message": "Zest lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 289309,
      "primary_message": "Juice half of the lemon into the bowl with the zest. Add mayo and spices; whisk to combine the aioli and set aside.",
      "secondary_message": "2 tbsp vegan mayonnaise\n½ tsp garlic powder\n½ tsp paprika\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 289310,
      "primary_message": "Juice remaining lemon into a medium salad bowl. Add oil, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 289311,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 289312,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 veggie burger patties, plant-based"
    },
    {
      "id": 289313,
      "primary_message": "Meanwhile, seed and slice the bell pepper into thin strips; add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 289314,
      "primary_message": "Halve the tomatoes and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 289315,
      "primary_message": "Separate the lettuce leaves. Set aside two large leaves per burger; chop or tear remaining leaves into bite-sized pieces and add to the bowl with the dressing. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 289316,
      "primary_message": "Pile leaves, in stacks of two per wrap, onto plates. Top with a burger patty and a spoonful of aioli. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
