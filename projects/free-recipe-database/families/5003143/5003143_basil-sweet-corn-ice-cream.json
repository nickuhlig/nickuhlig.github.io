  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the basil leaves from the stems and wash them.",
      "secondary_message": "1 cup basil leaves"
    },
    {
      "id": 1,
      "primary_message": "In a large saucepan, combine half and half, corn kernels, and corn cobs (cut in half) over medium heat. Cook, stirring occasionally, for 15 minutes. Add basil and cook for another 15 minutes. Meanwhile, combine egg yolks and sugar in a large bowl and whisk until lighter in color and slightly thickened.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer mixture to a blender and blend on high for two minutes or until smooth. Pour through a fine-mesh strainer back into saucepan. Tip: If your blender comes with a plastic stopper insert in the lid, remove it and cover the opening with a few folds of paper towel. This will prevent hot liquids from bursting out the top.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Quickly whisk yolk-sugar mixture into corn-basil base, and cook on medium-low heat, stirring frequently, until mixture coats the back of a spoon and a finger swipe leaves a clean line. Add salt to taste. Strain into in an airtight container and let chill overnight, then churn the next day according to manufacturer's instructions.",
      "secondary_message": null
    }
  ],
