  "instructions": [
    {
      "id": 410674,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 410675,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 410676,
      "primary_message": "Meanwhile, place vinegar, sugar, and salt in a large bowl. Stir to combine the pickling liquid.",
      "secondary_message": "½ cup rice vinegar\n2 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 410677,
      "primary_message": "Wash, dry, trim, and thinly slice radishes. Add to the bowl with the pickling liquid along with the carrots; stir to combine and set aside.",
      "secondary_message": "3 bunches radish\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 410678,
      "primary_message": "Preheat a large skillet over medium heat. ",
      "secondary_message": null
    },
    {
      "id": 410679,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels.",
      "secondary_message": "2 ¼ lb tilapia fillet"
    },
    {
      "id": 410680,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, add the tilapia and cook, flipping once, until fish is crispy and easily flakes with a fork, about 6 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 410681,
      "primary_message": "Meanwhile, wash, dry, trim, and cut green onions crosswise into thin pieces. Place in a small bowl along with water and miso paste. Stir to combine the sauce.",
      "secondary_message": "1 small bunch green onions (scallions)\n⅓ cup water\n3 tbsp miso paste, white"
    },
    {
      "id": 410682,
      "primary_message": "Return skillet to medium heat, add more butter, and swirl to coat the bottom. Add sauce and cook, stirring constantly, until thickened and fragrant, 1-2 minutes. Remove from heat.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "id": 410683,
      "primary_message": "To serve, divide rice, tilapia, and pickled veggies between plates or bowls; top fish with the sauce. Enjoy!",
      "secondary_message": null
    }
  ],
