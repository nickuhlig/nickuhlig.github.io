  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Mince the shallot.",
      "secondary_message": "1 medium clove garlic\n1 medium shallot"
    },
    {
      "id": 1,
      "primary_message": "Combine 2 tablespoon olive oil, tomato paste, garlic, and shallot in a medium skillet and heat over medium heat, stirring constantly, until fragrant and starting to bubble gently, about 2 minutes. Stir in smoked paprika and cook for 30 seconds. Add celery, drained beans, vinegar, and remaining olive oil. Cook until barely warmed through, about 1 minute. Stir in parsley, season to taste with salt and pepper, and serve immediately with crusty bread.",
      "secondary_message": null
    }
