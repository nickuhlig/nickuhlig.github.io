  "instructions": [
    {
      "id": 315541,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 315542,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 315543,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 315544,
      "primary_message": "While the bacon is cooking, pat chicken dry with paper towels and cut into bite-sized pieces.",
      "secondary_message": "0.68 kg chicken thighs, boneless skinless"
    },
    {
      "id": 315545,
      "primary_message": "Return skillet with drippings to medium-high heat; add chicken and spices. Cook, stirring occasionally, until chicken is golden and cooked through, 5-6 minutes.",
      "secondary_message": "1 tsp thyme, dried\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 315546,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic; place in a large bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 315547,
      "primary_message": "Wash and dry cabbage, then trim off and discard root end; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the garlic.",
      "secondary_message": "1 medium head napa cabbage"
    },
    {
      "id": 315548,
      "primary_message": "Wash, dry, and halve mushrooms, then cut crosswise into ¼-inch thick slices; add to the bowl.",
      "secondary_message": "4 caps portobello mushrooms"
    },
    {
      "id": 315549,
      "primary_message": "When the chicken is done, add veggies and additional salt to the skillet; continue to cook, stirring occasionally, until the veggies are fork-tender, 5-6 minutes more.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 315550,
      "primary_message": "Meanwhile, roughly chop walnuts.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 315551,
      "primary_message": "When the veggies are done, drain off any excess cooking liquid from the skillet, then add crispy bacon, walnuts, and vinegar. Stir to combine and remove from heat.",
      "secondary_message": "2 tbsp apple cider vinegar"
    },
    {
      "id": 315552,
      "primary_message": "To serve, divide stir-up between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
