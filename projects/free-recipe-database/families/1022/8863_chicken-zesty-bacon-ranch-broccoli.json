  "instructions": [
    {
      "id": 177132,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 177133,
      "primary_message": "Wash and dry the lemons; then juice into a small bowl.",
      "secondary_message": "1 ½ lemons"
    },
    {
      "id": 177134,
      "primary_message": "Add mayonnaise, yogurt, and spices to the bowl with the lemon juice; whisk to combine the ranch sauce.",
      "secondary_message": "½ cup mayonnaise\n¾ cup plain Greek yogurt\n1 ½ tsp dill\n⅜ tsp parsley flakes\n⅜ tsp garlic powder\n⅜ tsp onion powder\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 177135,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 177136,
      "primary_message": "Once the skillet is hot, add the bacon. Cook until the bacon is crispy, 3-4 minutes per side. Once done, transfer to a plate lined with paper towels. (Cook in batches if necessary.)",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 177137,
      "primary_message": "Wash broccoli crowns. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 177138,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 177139,
      "primary_message": "Pour off all but about 3 tablespoons of bacon fat and return skillet to medium heat. Add cutlets and cook until golden brown, 1-2 minutes per side. (Cook in batches if necessary.)",
      "secondary_message": null
    },
    {
      "id": 177140,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 177141,
      "primary_message": "When chicken is browned, add garlic and cook 30 seconds more. Add ranch sauce to the skillet; when the sauce begins to bubble, remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 177142,
      "primary_message": "Add broccoli to the skillet, cover with aluminum foil, and transfer to the oven; bake until the broccoli is fork-tender and chicken is cooked through, about 20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 177143,
      "primary_message": "Meanwhile, roughly chop the bacon.",
      "secondary_message": null
    },
    {
      "id": 177144,
      "primary_message": "To serve, divide the chicken, broccoli, and sauce between plates. Top with bacon bits and enjoy!",
      "secondary_message": null
    }
  ],
