  "instructions": [
    {
      "id": 177145,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 177146,
      "primary_message": "Wash and dry the lemon; juice it into a small bowl.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 177147,
      "primary_message": "Add mayonnaise, yogurt, and spices to the bowl with the lemon juice; whisk to combine the ranch sauce.",
      "secondary_message": "3 tbsp mayonnaise\n¼ cup plain Greek yogurt\n½ tsp dill\n⅛ tsp parsley flakes\n⅛ tsp garlic powder\n⅛ tsp onion powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 177148,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 177149,
      "primary_message": "Once the skillet is hot, add the bacon. Cook until the bacon is crispy, 3-4 minutes per side. Once done, transfer to a plate lined with paper towels.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 177150,
      "primary_message": "Wash broccoli. Separate into bite-sized florets and cut stems into smaller pieces.",
      "secondary_message": "1 crown broccoli"
    },
    {
      "id": 177151,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 177152,
      "primary_message": "Pour off all but about 1 tablespoon of bacon fat and return skillet to medium heat. Add cutlets and cook until golden brown, 1-2 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 177153,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 177154,
      "primary_message": "When chicken is browned, add garlic and cook 30 seconds more. Add ranch sauce to the skillet; when the sauce begins to bubble, remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 177155,
      "primary_message": "Add broccoli to the skillet, cover with aluminum foil, and transfer to the oven; bake until the broccoli is fork-tender and chicken is cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 177156,
      "primary_message": "Meanwhile, roughly chop the bacon.",
      "secondary_message": null
    },
    {
      "id": 177157,
      "primary_message": "To serve, divide the chicken, broccoli, and sauce between plates. Top with bacon bits and enjoy!",
      "secondary_message": null
    }
  ],
