  "instructions": [
    {
      "id": 1,
      "primary_message": "Mix candied peel with rum and set aside to soak. Toss ground nuts with spices and baking powder and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Beat the eggs on high until pale yellow, about four minutes. Add sugar and salt, and beat on high five minutes more.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "If very wet (though it likely won't be), drain the candied peel. Using a wooden spoon, fold the nut flour mixture and candied peels into the egg mixture until the flour is well incorporated, but do not over mix.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Line a baking sheet with parchment paper. Place rounded spoonfuls of the mixture on the parchment paper, making sure each cookie is at least 2 cm tall and leaving 3 to 4 cm between them. The cookies do not spread much in baking, so if you prefer perfectly smooth lebkuchen rather than craggy ones, it’s best to smooth them out by hand at this point. Optional: if using back-oblaten, form cookies directly on wafers, making sure that each cookie is about 2cm tall. Again, as the cookies don't spread in baking, cover the entire wafer.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Allow the cookies to rest for one hour at room temperature.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Preheat the oven to 302°F. Bake cookies for 15 to 18 minutes, rotating pans halfway through, until the cookies are lightly browned, and spring back to the touch. (It’s better to air on the side of slight undercooking, as you want them to be moist and they dry out quickly.) Remove them from the oven and cool slightly on the baking sheet before transferring to a wire rack.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Store lebkuchen in an air tight container between layers of wax paper in the fridge. Cookies will keep, refrigerated, up to two weeks.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "For an extra treat, dip them in chocolate, or glaze them with a thin sugar icing.",
      "secondary_message": null
    }
  ],
