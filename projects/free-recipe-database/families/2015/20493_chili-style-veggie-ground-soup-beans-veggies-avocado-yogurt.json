  "instructions": [
    {
      "id": 341848,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 red bell peppers\n6 sticks celery\n1 ½ limes\n1 ½ avocados"
    },
    {
      "id": 341849,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 341850,
      "primary_message": "Trim, seed, and small dice bell peppers; trim and thinly slice celery. Add both to the bowl with the green onion. ",
      "secondary_message": null
    },
    {
      "id": 341851,
      "primary_message": "Peel and mince garlic; add to the bowl with the veggies. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 341852,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 341853,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add the veggie ground and cook, breaking it apart with a spoon, until browned and cooked through, 6-7 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based"
    },
    {
      "id": 341854,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further. ",
      "secondary_message": "3 (398 ml) cans pinto beans"
    },
    {
      "id": 341855,
      "primary_message": "When the veggie ground is done, add vegetables and salt to the pot; cook, stirring occasionally, until softened, 4-5 minutes. ",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 341856,
      "primary_message": "When the vegetables are soft, add spices to the pot and cook, stirring frequently, until fragrant, 1-2 minutes.",
      "secondary_message": "2 tbsp chili powder\n2 tbsp cumin, ground\n1 tbsp paprika\n1 ½ tsp salt\n1 ½ tsp black pepper\n1 ½ tsp coriander, ground\n½ tsp cayenne pepper"
    },
    {
      "id": 341857,
      "primary_message": "Add beans, water, and tomato sauce to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender, about 15 minutes. ",
      "secondary_message": "6 cup water\n3 (213 ml) cans tomato sauce"
    },
    {
      "id": 341858,
      "primary_message": "While the soup simmers, cut limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 341859,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 341860,
      "primary_message": "Divide soup between bowls; top with avocado and yogurt. Serve with lime wedges for squeezing over top. Enjoy! ",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
