  "instructions": [
    {
      "id": 341705,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 red bell pepper\n2 sticks celery\n½ lime\n½ avocado"
    },
    {
      "id": 341706,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 341707,
      "primary_message": "Trim, seed, and small dice bell pepper; trim and thinly slice celery. Add both to the bowl with the green onion. ",
      "secondary_message": null
    },
    {
      "id": 341708,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 341709,
      "primary_message": "While the pan heats up, peel and mince garlic; add to the bowl with the veggies. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 341710,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add the veggie ground and cook, breaking it apart with a spoon, until browned and cooked through, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based"
    },
    {
      "id": 341711,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further. ",
      "secondary_message": "1 (15 oz) can pinto beans"
    },
    {
      "id": 341712,
      "primary_message": "When the veggie ground is done, add vegetables and salt to the pan; cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 341713,
      "primary_message": "When the vegetables are soft, add spices to the pan and cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "2 tsp chili powder\n2 tsp cumin, ground\n1 tsp paprika\n½ tsp salt\n½ tsp black pepper\n½ tsp coriander, ground\n⅛ tsp cayenne pepper"
    },
    {
      "id": 341714,
      "primary_message": "Add beans, water, and tomato sauce to the pan; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender, 12-15 minutes. ",
      "secondary_message": "2 cup water\n1 (8 oz) can tomato sauce"
    },
    {
      "id": 341715,
      "primary_message": "While the soup simmers, cut lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 341716,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 341717,
      "primary_message": "Divide soup between bowls; top with avocado and yogurt. Serve with lime wedges for squeezing over top. Enjoy! ",
      "secondary_message": "⅛ cup plain Greek yogurt"
    }
  ],
