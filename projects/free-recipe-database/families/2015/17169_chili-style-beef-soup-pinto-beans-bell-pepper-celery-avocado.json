  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n2 red bell peppers\n4 sticks celery\n1 lime\n1 avocado"
    },
    {
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Trim, seed, and small dice bell peppers; trim and thinly slice celery. Add both to the bowl with the green onion. ",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pot heats up, peel and mince garlic; add to the bowl with the veggies. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "primary_message": "Once the pot is hot, add beef and cook, breaking the meat apart with a spoon, until browned and cooked through, about 5 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further. ",
      "secondary_message": "2 (15 oz) cans pinto beans"
    },
    {
      "primary_message": "When the beef is done, add veggies and salt to the pot; cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "salt"
    },
    {
      "primary_message": "When the veggies are soft, add spices to the pot and cook, stirring frequently, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp chili powder\n4 tsp cumin, ground\n2 tsp paprika\nsalt\n1 tsp black pepper\n1 tsp coriander, ground\n¼ tsp cayenne pepper"
    },
    {
      "primary_message": "Add beans, water, and tomato sauce to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until beans are tender, 12-15 minutes. ",
      "secondary_message": "2 (8 oz) cans tomato sauce"
    },
    {
      "primary_message": "While the soup simmers, cut lime into wedges.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide soup between bowls and top with avocado. Serve with lime wedges for squeezing over top. Enjoy! ",
      "secondary_message": null
    }
  ],
