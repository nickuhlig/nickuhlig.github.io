  "instructions": [
    {
      "id": 197844,
      "primary_message": "Preheat oven to 425°F. Position racks in the upper, center, and lower thirds of the oven. ",
      "secondary_message": null
    },
    {
      "id": 197845,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n2 orange bell peppers\n3 medium zucchini squash\n3 limes\n3 jalapeño peppers\n3 small bunches cilantro"
    },
    {
      "id": 197846,
      "primary_message": "Peel and slice carrots into ½-inch thick rounds. Seed and large dice bell peppers. Transfer both to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 197847,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into ½-inch thick half rounds. Add to the bowl, drizzle with oil, and season with salt and pepper. Toss to coat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 197848,
      "primary_message": "Divide veggies between two large baking sheet pans, arranging them in a single layer. Place on the lower racks of the oven and bake, flipping halfway through, until fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 197849,
      "primary_message": "Meanwhile, zest and juice half the limes into the bowl used for the veggies. Set remaining limes aside.",
      "secondary_message": null
    },
    {
      "id": 197850,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil and spices. Stir to combine the spice paste.",
      "secondary_message": "3 cloves garlic\n1 tbsp extra virgin olive oil\n2 ½ tsp cumin\n¾ tsp oregano\n¾ tsp cayenne pepper\n¾ tsp salt"
    },
    {
      "id": 197851,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 197852,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels and add to the bowl with the spice paste; turn to coat.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 197853,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and cook on one side until golden brown and caramelized, 4-5 minutes. Flip and cook for 1 minute more (the chicken will not be cooked all the way through).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 197854,
      "primary_message": "Transfer chicken, golden-side facing up, to a large baking dish. Place the baking dish on the upper rack of the oven and roast until chicken is cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 197855,
      "primary_message": "Meanwhile, juice remaining limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 197856,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime juice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 197857,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197858,
      "primary_message": "Peel and mince additional garlic. Add to the bowl along with feta, oil, cumin, and salt. Stir to combine the salsa.",
      "secondary_message": "3 cloves garlic\n1 ½ (4 oz) pkgs crumbled feta cheese\n2 tbsp extra virgin olive oil\n1 ½ tsp cumin\n½ tsp salt"
    },
    {
      "id": 197859,
      "primary_message": "To serve, divide veggies and chicken between plates. Spoon salsa over chicken and enjoy!",
      "secondary_message": null
    }
  ],
