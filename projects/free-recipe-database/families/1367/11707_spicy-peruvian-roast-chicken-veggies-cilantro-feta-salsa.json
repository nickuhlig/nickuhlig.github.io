  "instructions": [
    {
      "id": 197812,
      "primary_message": "Preheat oven to 425°F. Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 197813,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n½ orange bell pepper\n1 medium zucchini squash\n1 lime\n1 jalapeño pepper\n1 small bunch cilantro"
    },
    {
      "id": 197814,
      "primary_message": "Peel and slice carrot into ½-inch thick rounds. Seed and large dice bell pepper. Transfer both to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 197815,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into ½-inch thick half rounds. Add to the bowl, drizzle with oil, and season with salt and pepper. Toss to coat. ",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 197816,
      "primary_message": "Arrange veggies on a baking sheet pan in a single layer. Place on the lower rack of the oven and bake, flipping halfway through, until fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 197817,
      "primary_message": "Meanwhile, zest and juice half the lime into the bowl used for the veggies. Set remaining lime aside.",
      "secondary_message": null
    },
    {
      "id": 197818,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil and spices. Stir to combine the spice paste.",
      "secondary_message": "1 clove garlic\n1 tsp extra virgin olive oil\n¾ tsp cumin\n¼ tsp oregano\n¼ tsp cayenne pepper\n¼ tsp salt"
    },
    {
      "id": 197819,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 197820,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels and add to the bowl with the spice paste; turn to coat.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 197821,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook on one side until golden brown, 4-5 minutes. Flip and cook for 1 minute more, then remove from heat (the chicken will not be cooked all the way through).",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 197822,
      "primary_message": "Transfer the skillet to the upper rack of the oven and roast until chicken is cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 197823,
      "primary_message": "Meanwhile, juice remaining lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 197824,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime juice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 197825,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197826,
      "primary_message": "Peel and mince additional garlic. Add to the bowl along with feta, oil, cumin, and salt. Stir to combine the salsa.",
      "secondary_message": "1 clove garlic\n½ (4 oz) pkg crumbled feta cheese\n2 tsp extra virgin olive oil\n½ tsp cumin\n⅛ tsp salt"
    },
    {
      "id": 197827,
      "primary_message": "To serve, divide veggies and chicken between plates. Spoon salsa over chicken and enjoy!",
      "secondary_message": null
    }
  ],
