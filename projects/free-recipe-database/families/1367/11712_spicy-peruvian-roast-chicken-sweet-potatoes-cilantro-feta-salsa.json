  "instructions": [
    {
      "id": 197890,
      "primary_message": "Preheat oven to 220°C (425°F). Position racks in the upper, center, and lower thirds of the oven. Line two baking sheet pans with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 197891,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.36 kg sweet potatoes\n3 limes\n3 jalapeño peppers\n3 small bunches cilantro"
    },
    {
      "id": 197892,
      "primary_message": "Peel and slice sweet potatoes into ½-inch thick rounds. Place in a large bowl, drizzle with oil, and season with salt and pepper. Toss to coat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 197893,
      "primary_message": "Divide sweet potatoes between baking sheets, arranging them in a single layer. Place on the lower racks of the oven and bake, flipping halfway through, until fork-tender, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 197894,
      "primary_message": "Meanwhile, zest and juice half the limes into the bowl used for the sweet potatoes. Set remaining limes aside.",
      "secondary_message": null
    },
    {
      "id": 197895,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil, sugar, and spices. Stir to combine the spice paste.",
      "secondary_message": "3 cloves garlic\n1 tbsp extra virgin olive oil\n2 ½ tsp brown sugar\n2 ½ tsp cumin\n¾ tsp oregano\n¾ tsp cayenne pepper\n¾ tsp salt"
    },
    {
      "id": 197896,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 197897,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels and add to the bowl with the spice paste; turn to coat.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 197898,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and cook on one side until golden brown and caramelized, 4-5 minutes. Flip and cook for 1 minute more (the chicken will not be cooked all the way through). ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 197899,
      "primary_message": "Transfer chicken, caramelized-side facing up, to a large baking dish. Place the baking dish on the upper rack of the oven and roast until chicken is cooked through, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 197900,
      "primary_message": "Meanwhile, juice remaining lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 197901,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime juice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 197902,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197903,
      "primary_message": "Peel and mince additional garlic. Add to the bowl along with feta, oil, sugar, cumin, and salt. Stir to combine the salsa.",
      "secondary_message": "3 cloves garlic\n1 ½ (113 g) pkg crumbled feta cheese\n2 tbsp extra virgin olive oil\n1 ½ tsp brown sugar\n1 ½ tsp cumin\n½ tsp salt"
    },
    {
      "id": 197904,
      "primary_message": "To serve, divide sweet potatoes and chicken between plates. Spoon salsa over chicken and enjoy!",
      "secondary_message": null
    }
  ],
