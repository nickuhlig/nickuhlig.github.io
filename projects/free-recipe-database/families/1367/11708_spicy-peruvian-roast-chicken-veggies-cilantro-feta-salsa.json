  "instructions": [
    {
      "id": 197828,
      "primary_message": "Preheat oven to 425°F. Position racks in the upper and lower thirds of the oven.",
      "secondary_message": null
    },
    {
      "id": 197829,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 orange bell pepper\n2 medium zucchini squash\n2 limes\n2 jalapeño peppers\n2 small bunches cilantro"
    },
    {
      "id": 197830,
      "primary_message": "Peel and slice carrots into ½-inch thick rounds. Seed and large dice bell pepper. Transfer both to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 197831,
      "primary_message": "Halve zucchini lengthwise, then slice crosswise into ½-inch thick half rounds. Add to the bowl, drizzle with oil, and season with salt and pepper. Toss to coat. ",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 197832,
      "primary_message": "Arrange veggies on a large baking sheet pan in a single layer. Place on the lower rack of the oven and bake, flipping halfway through, until fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 197833,
      "primary_message": "Meanwhile, zest and juice one lime into the bowl used for the veggies. Set remaining lime aside.",
      "secondary_message": null
    },
    {
      "id": 197834,
      "primary_message": "Peel and mince garlic. Add to the bowl along with oil and spices. Stir to combine the spice paste.",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n1 ½ tsp cumin\n½ tsp oregano\n½ tsp cayenne pepper\n½ tsp salt"
    },
    {
      "id": 197835,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 197836,
      "primary_message": "While the skillet heats up, pat chicken thighs dry with paper towels and add to the bowl with the spice paste; turn to coat.",
      "secondary_message": "2 lb chicken thighs, boneless skinless"
    },
    {
      "id": 197837,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken in a single layer, and cook on one side until golden brown and caramelized, about 5 minutes. Flip and cook for 1 minute more, then remove from heat (the chicken will not be cooked all the way through).",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 197838,
      "primary_message": "Transfer the skillet to the upper rack of the oven and roast until chicken is cooked through, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 197839,
      "primary_message": "Meanwhile, juice remaining lime into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 197840,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the lime juice. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 197841,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 197842,
      "primary_message": "Peel and mince additional garlic. Add to the bowl along with feta, oil, cumin, and salt. Stir to combine the salsa.",
      "secondary_message": "2 cloves garlic\n1 (4 oz) pkg crumbled feta cheese\n4 tsp extra virgin olive oil\n1 tsp cumin\n¼ tsp salt"
    },
    {
      "id": 197843,
      "primary_message": "To serve, divide veggies and chicken between plates. Spoon salsa over chicken and enjoy!",
      "secondary_message": null
    }
  ],
