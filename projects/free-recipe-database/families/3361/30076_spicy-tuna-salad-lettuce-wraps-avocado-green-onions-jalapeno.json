  "instructions": [
    {
      "id": 478395,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ jalapeño pepper\n1 avocado\n½ head butter (Boston) lettuce"
    },
    {
      "id": 478396,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 478397,
      "primary_message": "Drain tuna, add to the bowl with the green onions, and flake with a fork.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 478398,
      "primary_message": "Add mayo, chili-garlic sauce, soy sauce, oil, and salt to the bowl. Stir to combine and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp chili-garlic sauce\n1 tsp soy sauce\n1 tsp toasted sesame oil\n⅛ tsp salt"
    },
    {
      "id": 478399,
      "primary_message": "Thinly slice jalapeño pepper into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 478400,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Season with salt.",
      "secondary_message": "1 pinch salt"
    },
    {
      "id": 478401,
      "primary_message": "Separate the lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 478402,
      "primary_message": "To serve, pile lettuce leaves, in stacks of two per wrap, onto plates; fill with avocado and tuna salad. Top with reserved green onions and jalapeño. Enjoy!",
      "secondary_message": null
    }
  ],
