  "instructions": [
    {
      "id": 478259,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 jalapeño pepper\n2 avocados\n1 head butter (Boston) lettuce"
    },
    {
      "id": 478260,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 478261,
      "primary_message": "Drain tuna, add to the bowl with the green onions, and flake with a fork.",
      "secondary_message": "4 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 478262,
      "primary_message": "Add mayo, chili-garlic sauce, coconut aminos, oil, and salt to the bowl. Stir to combine and set aside.",
      "secondary_message": "⅔ cup avocado oil mayonnaise\n2 tbsp chili-garlic sauce\n2 tsp coconut aminos\n2 tsp toasted sesame oil\n¼ tsp salt"
    },
    {
      "id": 478263,
      "primary_message": "Thinly slice jalapeño pepper into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 478264,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Season with salt.",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 478265,
      "primary_message": "Separate the lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 478266,
      "primary_message": "To serve, pile lettuce leaves, in stacks of two per wrap, onto plates; fill with avocado and tuna salad. Top with reserved green onions and jalapeño. Enjoy!",
      "secondary_message": null
    }
  ],
