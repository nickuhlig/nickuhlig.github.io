  "instructions": [
    {
      "id": 478243,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ jalapeño peppers\n3 avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 478244,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 478245,
      "primary_message": "Drain tuna, add to the bowl with the green onions, and flake with a fork.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 478246,
      "primary_message": "Add mayo, chili-garlic sauce, soy sauce, oil, and salt to the bowl. Stir to combine and set aside.",
      "secondary_message": "1 cup mayonnaise\n3 tbsp chili-garlic sauce\n1 tbsp soy sauce\n1 tbsp toasted sesame oil\n¼ tsp salt"
    },
    {
      "id": 478247,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 478248,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Season with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 478249,
      "primary_message": "Separate the lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 478250,
      "primary_message": "To serve, pile lettuce leaves, in stacks of two per wrap, onto plates; fill with avocado and tuna salad. Top with reserved green onions and jalapeño. Enjoy!",
      "secondary_message": null
    }
  ],
