  "instructions": [
    {
      "id": 478291,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 478292,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ jalapeño peppers\n3 avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 478293,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Place half in a large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 478294,
      "primary_message": "Add mayo, chili-garlic sauce, soy sauce, oil, and salt to the bowl with the green onions; stir to combine.",
      "secondary_message": "1 cup mayonnaise\n3 tbsp chili-garlic sauce\n1 tbsp soy sauce\n1 tbsp toasted sesame oil\n¼ tsp salt"
    },
    {
      "id": 478295,
      "primary_message": "Crumble tofu with your fingers into the bowl; using a fork, mash to combine the tofu salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 478296,
      "primary_message": "Thinly slice jalapeño peppers into rings; seed and remove ribs with a spoon to reduce spice level. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 478297,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Season with salt.",
      "secondary_message": "3 pinch salt"
    },
    {
      "id": 478298,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with avocado and tofu salad. Top with reserved green onions and jalapeño. Enjoy!",
      "secondary_message": null
    }
  ],
