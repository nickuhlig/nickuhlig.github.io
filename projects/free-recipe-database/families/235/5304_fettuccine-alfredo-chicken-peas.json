  "instructions": [
    {
      "id": 63765,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 9-10 minutes.",
      "secondary_message": "about 21 cups water\n3 tbsp salt\n18 oz (1 quarter coin = 2 oz) fettuccine pasta"
    },
    {
      "id": 63778,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 63777,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season with Italian seasoning.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n3 tsp Italian seasoning"
    },
    {
      "id": 63764,
      "primary_message": "Add butter to skillet and swirl to coat. Add chicken and cook until golden brown and no longer pink inside, 3-5 minutes per side.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 63776,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 63775,
      "primary_message": "Transfer chicken to a plate. Wash and dry pan; return to stove over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 63774,
      "primary_message": "Add butter to pan and swirl to coat. Add garlic and cook until fragrant, 15-30 seconds.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 63773,
      "primary_message": "Sprinkle flour into pan and whisk until combined with the butter.",
      "secondary_message": "4 ½ tbsp all-purpose flour"
    },
    {
      "id": 63763,
      "primary_message": "Add broth and whisk until smooth. Then add milk and stir until sauce is thickened, 4-5 minutes.",
      "secondary_message": "12 fl oz (1 ½ cup) chicken or vegetable broth\n12 fl oz (1 ½ cup) whole milk"
    },
    {
      "id": 63772,
      "primary_message": "Finely grate ¾ cup of Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 63771,
      "primary_message": "Add Parmesan, salt, and pepper to sauce. Stir until smooth, then reduce heat to low until pasta is ready.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 63770,
      "primary_message": "Measure out peas.",
      "secondary_message": "4 ½ cups frozen peas"
    },
    {
      "id": 63769,
      "primary_message": "Slice chicken diagonally into thin strips.",
      "secondary_message": ""
    },
    {
      "id": 63768,
      "primary_message": "Drain pasta in a colander, reserving about 1 ½ cup of the pasta water.",
      "secondary_message": ""
    },
    {
      "id": 63767,
      "primary_message": "Add pasta, chicken, peas, and ½ of the reserved pasta water to sauce. Toss to combine. Add more pasta water to thin out the sauce is desired.",
      "secondary_message": ""
    },
    {
      "id": 63766,
      "primary_message": "Place on a plate, garnish with freshly ground pepper, and enjoy!",
      "secondary_message": ""
    }
  ],
