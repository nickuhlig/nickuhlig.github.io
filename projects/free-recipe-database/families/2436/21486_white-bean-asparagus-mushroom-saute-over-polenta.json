  "instructions": [
    {
      "id": 427962,
      "primary_message": "Medium dice polenta; place in a large pot along with broth, salt, and pepper. Bring to a simmer over medium-high heat.",
      "secondary_message": "3 (510 g) tubes polenta, pre-cooked\n710 ml chicken or vegetable broth\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 427963,
      "primary_message": "Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 3-4 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 427964,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 427965,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 427966,
      "primary_message": "While the pot heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 427967,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add asparagus, garlic, mushrooms, and spices. Cook, stirring occasionally, until veggies are tender, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 (227g ) pkgs sliced white mushrooms\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 427968,
      "primary_message": "Meanwhile, drain and rinse beans in a colander.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 427969,
      "primary_message": "Add beans and vinegar to the pot. Continue to cook, stirring occasionally, until beans are warmed through, 3-4 minutes. Remove from heat.",
      "secondary_message": "⅓ cup balsamic vinegar"
    },
    {
      "id": 427970,
      "primary_message": "Add nutritional yeast and oil to the pot with the polenta; stir to combine.",
      "secondary_message": "⅓ cup nutritional yeast flakes\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 427971,
      "primary_message": "To serve, divide polenta between plates or bowls; top with bean and veggie sauté. Sprinkle with basil and enjoy!",
      "secondary_message": "¾ tsp basil, dried"
    }
  ],
