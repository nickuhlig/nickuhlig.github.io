  "instructions": [
    {
      "id": 427882,
      "primary_message": "Medium dice polenta; place in a medium saucepan along with broth, salt, and pepper. Bring to a simmer over medium-high heat.",
      "secondary_message": "1 (18 oz) tube polenta, pre-cooked\n8 fl oz (1 cup) chicken or vegetable broth\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 427883,
      "primary_message": "Once the broth is simmering, reduce heat to medium. Using a potato masher, mash the polenta until smooth; continue to cook, stirring occasionally, until heated through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 427884,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 427885,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 427886,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 427887,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add asparagus, garlic, mushrooms, and spices. Cook, stirring occasionally, until veggies are tender, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 (8 oz) pkg sliced white mushrooms\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 427888,
      "primary_message": "Meanwhile, drain and rinse beans in a colander.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 427889,
      "primary_message": "Add beans and vinegar to the skillet. Continue to cook, stirring occasionally, until beans are warmed through, 2-3 minutes. Remove from heat.",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 427890,
      "primary_message": "Add nutritional yeast and oil to the pan with the polenta; stir to combine.",
      "secondary_message": "⅛ cup nutritional yeast flakes\n2 tsp extra virgin olive oil"
    },
    {
      "id": 427891,
      "primary_message": "To serve, divide polenta between plates or bowls; top with bean and veggie sauté. Sprinkle with basil and enjoy!",
      "secondary_message": "¼ tsp basil, dried"
    }
  ],
