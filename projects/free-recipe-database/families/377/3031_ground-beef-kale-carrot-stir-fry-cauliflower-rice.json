  "instructions": [
    {
      "id": 30049,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium heads cauliflower\n2 medium carrots\n2 bunches kale\n1 small bunch green onions"
    },
    {
      "id": 30050,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stems. Using a box grater or food processor, coarsely grate the cauliflower and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 30051,
      "primary_message": "Heat a skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 30052,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 30053,
      "primary_message": "Add the grated cauliflower to the skillet and season with salt; cook, stirring occasionally, until tender, 6 to 8 minutes. Once done, return back to the bowl.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 30054,
      "primary_message": "While the cauliflower cooks, fold the kale leaves in half lengthwise and slice off the stems. Roughly chop the leaves and transfer to a large bowl. Cut the stems into ½-inch pieces and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 30055,
      "primary_message": "Trim and discard the ends and peel the carrots; julienne or coarsely grate the carrots and add to the bowl of kale stems.",
      "secondary_message": null
    },
    {
      "id": 30056,
      "primary_message": "Peel and mince the garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 30057,
      "primary_message": "Peel and mince the ginger; add to the bowl.",
      "secondary_message": "2 (1 inch) pieces ginger root"
    },
    {
      "id": 30058,
      "primary_message": "Trim off and discard the ends of the green onions; chop the onions on an angle into ¼-inch pieces. Add all the white parts and about ½ of the greens to the other vegetables and transfer the rest to a small bowl for later.",
      "secondary_message": null
    },
    {
      "id": 30059,
      "primary_message": "Once the cauliflower has been transferred, increase the heat to medium and add more coconut oil to the skillet.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 30060,
      "primary_message": "Add the ground beef and cook, breaking the meat apart with a spoon, until the beef is browned, 3 to 4 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 30061,
      "primary_message": "Add the kale stems, carrots, garlic, and ginger; cook, stirring regularly, until the vegetables soften, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 30062,
      "primary_message": "Add the kale leaves and drizzle with coconut aminos and rice vinegar; continue to cook, stirring occasionally, until the kale is wilted, 2 to 3 minutes.",
      "secondary_message": "4 tbsp coconut aminos\n2 tbsp rice vinegar"
    },
    {
      "id": 30063,
      "primary_message": "Divide the cauliflower rice between four bowls (or two bowls and two lunch containers), top with the stir fry, and sprinkle with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
