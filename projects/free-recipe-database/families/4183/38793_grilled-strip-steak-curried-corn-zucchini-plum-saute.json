  "instructions": [
    {
      "id": 604335,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 604336,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 604337,
      "primary_message": "Once the pan is hot, coat with oil. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 604338,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 plums\n2 medium zucchini squash\n½ jalapeño pepper"
    },
    {
      "id": 604339,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 604340,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the plums.",
      "secondary_message": null
    },
    {
      "id": 604341,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 604342,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 604343,
      "primary_message": "While the skillet heats up, place corn in the colander and rinse under hot water (from the tap) to thaw. Add to the bowl with the plums and other veggies.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 604344,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add plums, veggies, and spices; cook, stirring occasionally, until fork-tender, 6-7 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp curry powder\n½ tsp garam masala\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 604345,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 604346,
      "primary_message": "To serve, divide steak and plum-veggie sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
