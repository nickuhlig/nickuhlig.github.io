  "instructions": [
    {
      "id": 604395,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 604396,
      "primary_message": "While the pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 604397,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 604398,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 plums\n6 medium zucchini squash\n1 ½ jalapeño peppers"
    },
    {
      "id": 604399,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Cut each half into ¼-inch thick slices. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 604400,
      "primary_message": "Trim and halve zucchini lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the plums.",
      "secondary_message": null
    },
    {
      "id": 604401,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 604402,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 604403,
      "primary_message": "While the pot heats up, place corn in the colander and rinse under hot water (from the tap) to thaw. Add to the bowl with the plums and other veggies.",
      "secondary_message": "3 cups frozen corn"
    },
    {
      "id": 604404,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add plums, veggies, and spices; cook, stirring occasionally, until fork-tender, 7-8 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp curry powder\n1 ½ tsp garam masala\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 604405,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 604406,
      "primary_message": "To serve, divide steak and plum-veggie sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
