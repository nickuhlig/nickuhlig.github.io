  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Zest the lemon.",
      "secondary_message": "1 lemon"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 165°C (325°F). Line a rimmed baking sheet with parchment paper. Grease parchment paper with butter.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place 1 cup of pistachios in a food processor. Pulse until finely chopped but not powder, approximately 20 pulses. In a medium bowl, mix flour and salt. Mix pistachios into flour mixture. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a large bowl, beat butter with 1 1/4 cups sugar until it is light and fluffy, about 3 minutes. Beat in eggs. Scrape down sides of bowl, then beat in vanilla and almond extracts and lemon zest.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Beat flour mixture into sugar mixture in two additions. The dough will be soft. Use a spatula to spread the dough evenly across the baking sheet. Roughly chop remaining cup of pistachios and sprinkle them over the dough. Sprinkle remaining two teaspoons of sugar over the dough.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Bake dough for 35 to 40 minutes, or until it turns golden brown at the edges. Allow dough to cool on wire rack for 35 minutes, then cut into wedges.",
      "secondary_message": null
    }
  ],
