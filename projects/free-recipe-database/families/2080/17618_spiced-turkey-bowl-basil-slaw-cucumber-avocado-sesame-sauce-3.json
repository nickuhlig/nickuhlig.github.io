  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 small pkg fresh basil\n1 medium carrot\n½ English cucumber\n½ avocado"
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, turkey, and spices; cook, breaking the turkey apart with a spoon, until browned and crumbly, 4-5 minutes. Remove from heat.",
      "secondary_message": "toasted sesame oil\n¾ lb ground turkey\n½ tsp cumin, ground\n½ tsp turmeric, ground\n¼ tsp coriander, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, peel and mince ginger; place in a small bowl along with tahini, oil, vinegar, water, soy sauce, and maple syrup. Whisk to combine the sauce and set aside. ",
      "secondary_message": "2 tbsp tahini\ntoasted sesame oil\n1 tbsp rice vinegar\n½ tsp pure maple syrup"
    },
    {
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a medium bowl (reserving a small amount for garnish).",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl with the basil, along with broccoli slaw, and toss to combine.",
      "secondary_message": "1 (12 oz) pkg broccoli slaw"
    },
    {
      "primary_message": "Trim and thinly slice cucumber crosswise into rounds.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocado. Slice thinly while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide slaw between bowls; top with turkey, cucumber, avocado, and reserved basil. Drizzle sauce over top and enjoy!",
      "secondary_message": null
    }
  ],
