  "instructions": [
    {
      "id": 285731,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 small pkgs fresh basil\n3 medium carrots\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "id": 285732,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 285733,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 285734,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic, turkey, and spices; cook, breaking the turkey apart with a spoon, until browned and crumbly, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil\n1.02 kg ground turkey\n1 ½ tsp cumin, ground\n1 ½ tsp turmeric, ground\n¾ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 285735,
      "primary_message": "Meanwhile, peel and mince ginger; place in a small bowl along with tahini, oil, vinegar, water, soy sauce, and maple syrup. Whisk to combine the sauce and set aside. ",
      "secondary_message": "⅓ cup tahini\n3 tbsp toasted sesame oil\n3 tbsp rice vinegar\n3 tbsp water\n3 tbsp soy sauce\n1 ½ tsp pure maple syrup"
    },
    {
      "id": 285736,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a large bowl (reserving a small amount for garnish).",
      "secondary_message": null
    },
    {
      "id": 285737,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the basil, along with broccoli slaw, and toss to combine.",
      "secondary_message": "3 (340 g) pkgs broccoli slaw"
    },
    {
      "id": 285738,
      "primary_message": "Trim and thinly slice cucumbers crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 285739,
      "primary_message": "Halve and pit avocados. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 285740,
      "primary_message": "To serve, divide slaw between bowls; top with turkey, cucumber, avocado, and reserved basil. Drizzle sauce over top and enjoy!",
      "secondary_message": null
    }
  ],
