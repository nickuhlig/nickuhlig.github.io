  "instructions": [
    {
      "id": 285752,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 285753,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n2 small pkgs fresh basil\n2 medium carrots\n1 English cucumber\n1 avocado"
    },
    {
      "id": 285754,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 285755,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 285756,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; crumble tofu with your fingers into the skillet. Add garlic and spices; cook, stirring often, until the tofu begins to brown, about 5 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "2 tbsp toasted sesame oil\n1 tsp cumin, ground\n1 tsp turmeric, ground\n½ tsp coriander, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 285757,
      "primary_message": "Meanwhile, peel and mince ginger; place in a small bowl along with tahini, oil, vinegar, water, soy sauce, and maple syrup. Whisk to combine the sauce and set aside. ",
      "secondary_message": "¼ cup tahini\n2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n2 tbsp water\n2 tbsp soy sauce\n1 tsp pure maple syrup"
    },
    {
      "id": 285758,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in a large bowl (reserving a small amount for garnish).",
      "secondary_message": null
    },
    {
      "id": 285759,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the basil, along with broccoli slaw, and toss to combine.",
      "secondary_message": "2 (340 g) pkgs broccoli slaw"
    },
    {
      "id": 285760,
      "primary_message": "Trim and thinly slice cucumber crosswise into rounds.",
      "secondary_message": null
    },
    {
      "id": 285761,
      "primary_message": "Halve and pit avocado. Slice thinly while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 285762,
      "primary_message": "To serve, divide slaw between bowls; top with tofu, cucumber, avocado, and reserved basil. Drizzle sauce over top and enjoy!",
      "secondary_message": null
    }
  ],
