  "instructions": [
    {
      "id": 444550,
      "primary_message": "Preheat oven to 375°F. Coat 4 muffin cups with butter and set aside.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 444551,
      "primary_message": "Melt additional butter in a small saucepan set over medium heat. Remove from heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 444552,
      "primary_message": "Meanwhile, place milk, eggs, sugar, and vanilla in a small bowl, then whisk until sugar has dissolved. ",
      "secondary_message": "3 fl oz (⅜ cup) whole milk\n2 eggs\n¼ cup granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 444553,
      "primary_message": "Add melted butter, flour, and salt to the bowl with the milk mixture. Whisk until batter is just combined (take care not to over-mix it). ",
      "secondary_message": "⅓ cup all-purpose flour\n⅛ tsp salt"
    },
    {
      "id": 444554,
      "primary_message": "Divide batter and frozen cherries between muffin cups.",
      "secondary_message": "1 cup frozen cherries"
    },
    {
      "id": 444555,
      "primary_message": "Place muffin pan in the oven (it doesn't have to be fully heated) and bake until clafoutis are golden, puffed, and a knife or skewer inserted in the center comes out almost clean, 18-20 minutes. Remove from oven and let cool for 5 minutes (the clafoutis will shrink a little as they cool).",
      "secondary_message": null
    },
    {
      "id": 444556,
      "primary_message": "To serve, divide clafoutis and ice cream between bowls; sprinkle with almonds. Enjoy!",
      "secondary_message": "24 fl oz (3 cups) vanilla ice cream\n¼ cup almonds, sliced"
    }
  ],
