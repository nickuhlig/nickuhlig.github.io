  "instructions": [
    {
      "id": 294485,
      "primary_message": "Preheat oven to 220°C (425°F). Line two baking sheet pans with aluminum foil to make cleanup easier (optional). Coat with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 294486,
      "primary_message": "Finely grate Parmesan and place in a medium bowl.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 294487,
      "primary_message": "Add bread crumbs and spices to the bowl with the Parmesan; stir to combine the coating.",
      "secondary_message": "1 ½ cup panko bread crumbs\n1 tbsp rosemary, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 294488,
      "primary_message": "Crack eggs into another medium bowl and beat with a whisk or fork.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 294489,
      "primary_message": "Pat chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Sprinkle flour over both sides to coat.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n3 tbsp all-purpose flour"
    },
    {
      "id": 294490,
      "primary_message": "Dip chicken cutlets, one at a time, into the egg; shake off excess, then dredge in the bread crumb coating, pressing to adhere. Divide between the baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 294491,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until the chicken is golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 294492,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 lemons\n1 ½ English cucumbers\n3 medium carrots\n1 ½ (142 g) pkg baby arugula"
    },
    {
      "id": 294493,
      "primary_message": "Using a clean cutting board, slice half of the lemons into wedges and set aside for serving. Juice remaining lemons into a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 294494,
      "primary_message": "Add oil, Dijon, maple syrup, salt, and pepper to the bowl with the lemon juice; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n1 ½ tsp pure maple syrup\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 294495,
      "primary_message": "Trim, halve, and thinly slice cucumbers crosswise into half-moons; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 294496,
      "primary_message": "Trim, peel, halve, and thinly slice carrots crosswise into half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 294497,
      "primary_message": "Halve olives; add to the bowl along with the arugula and pine nuts. Toss to combine the salad.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n⅓ cup pine nuts"
    },
    {
      "id": 294498,
      "primary_message": "To serve, divide chicken and salad between plates. Squeeze lemon over the chicken and enjoy!",
      "secondary_message": null
    }
  ],
