  "instructions": [
    {
      "id": 436788,
      "primary_message": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 436789,
      "primary_message": "While the eggs are cooking, fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 436790,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.23 kg new potatoes\n0.11 kg green beans\n¼ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 436791,
      "primary_message": "Quarter potatoes. Once the water in the saucepan is boiling, add potatoes and salt. Reduce heat to medium and simmer until starting to soften, about 8 minutes.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 436792,
      "primary_message": "While the potatoes are cooking, trim and cut green beans crosswise into 1-inch pieces. Once the potatoes start to soften, add green beans to the pan and continue to cook until veggies are tender, 2-3 minutes more. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": null
    },
    {
      "id": 436793,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a medium bowl along with oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 436794,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 436795,
      "primary_message": "Halve olives and add to the bowl. ",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 436796,
      "primary_message": "Peel and quarter eggs lengthwise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 436797,
      "primary_message": "Add cooled potatoes and green beans to the bowl, then gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 436798,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
