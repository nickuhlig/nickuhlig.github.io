  "instructions": [
    {
      "id": 436810,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 436811,
      "primary_message": "While the eggs are cooking, fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 436812,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n⅓ kg green beans\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 436813,
      "primary_message": "Quarter potatoes. Once the water in the pot is boiling, add potatoes and salt. Reduce heat to medium and simmer until starting to soften, about 8 minutes.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 436814,
      "primary_message": "While the potatoes are cooking, trim and cut green beans crosswise into 1-inch pieces. Once the potatoes start to soften, add green beans to the pot and continue to cook until veggies are tender, 2-3 minutes more. Drain and rinse under cold water to cool. Set aside.",
      "secondary_message": null
    },
    {
      "id": 436815,
      "primary_message": "Meanwhile, peel and mince shallots. Place in a large bowl along with oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 ½ shallots\n3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 436816,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 436817,
      "primary_message": "Halve olives and add to the bowl. ",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 436818,
      "primary_message": "Peel and quarter eggs lengthwise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 436819,
      "primary_message": "Add cooled potatoes and green beans to the bowl, then gently stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 436820,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
