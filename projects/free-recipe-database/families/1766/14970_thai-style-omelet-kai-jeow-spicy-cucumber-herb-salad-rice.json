  "instructions": [
    {
      "id": 254416,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 254417,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n1 red chili pepper\n½ small bunch cilantro\n½ small pkg fresh mint\n½ small bunch green onions (scallions)"
    },
    {
      "id": 254418,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 254419,
      "primary_message": "Place oil, vinegar, fish sauce, sugar, and salt in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp toasted sesame oil\n2 tsp rice vinegar\n1 tsp fish sauce\n1 tsp brown sugar\n⅛ tsp salt"
    },
    {
      "id": 254420,
      "primary_message": "Peel, trim, and halve cucumber lengthwise; cut crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 254421,
      "primary_message": "Thinly slice the chili pepper into rounds; add to the bowl with the cucumber. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 254422,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl. Stir to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 254423,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Place in another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 254424,
      "primary_message": "Crack eggs into the bowl with the green onions. Add fish sauce and whisk to combine the egg batter.",
      "secondary_message": "6 eggs\n2 tsp fish sauce"
    },
    {
      "id": 254425,
      "primary_message": "Preheat a skillet over medium high heat.",
      "secondary_message": null
    },
    {
      "id": 254426,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 254427,
      "primary_message": "Add half the egg batter (a scant 1 cup per omelet) to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the skillet. Then tilt the skillet, allowing the uncooked egg to move to the edges. Cook until set, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 254428,
      "primary_message": "Fold the omelet in half and remove to a plate; cut in half. Loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 254429,
      "primary_message": "Return skillet to medium heat and add more oil. Repeat with remaining egg batter.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 254430,
      "primary_message": "To serve, divide rice, salad, and omelets between plates. Spoon chili-garlic sauce over the omelets and enjoy!",
      "secondary_message": "2 tsp chili-garlic sauce"
    }
  ],
