  "instructions": [
    {
      "id": 254581,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 254582,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n3 red chili peppers\n2 small bunches cilantro\n1 small pkg fresh mint\n1 small bunch green onions (scallions)"
    },
    {
      "id": 254583,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 254584,
      "primary_message": "Place oil, vinegar, fish sauce, sugar, and salt in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp toasted sesame oil\n2 tbsp rice vinegar\n1 tbsp fish sauce\n1 tbsp brown sugar\n½ tsp salt"
    },
    {
      "id": 254585,
      "primary_message": "Peel, trim, and halve cucumbers lengthwise; cut crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 254586,
      "primary_message": "Thinly slice the chili peppers into rounds; add to the bowl with the cucumber. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 254587,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems, roughly chop the leaves, and add to the bowl. Stir to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 254588,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces. Place in another large bowl.",
      "secondary_message": null
    },
    {
      "id": 254589,
      "primary_message": "Crack eggs into the bowl with the green onions. Add fish sauce and whisk to combine the egg batter.",
      "secondary_message": "18 eggs\n2 tbsp fish sauce"
    },
    {
      "id": 254590,
      "primary_message": "Preheat a skillet over medium high heat.",
      "secondary_message": null
    },
    {
      "id": 254591,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    },
    {
      "id": 254592,
      "primary_message": "Add one-sixth of the egg batter (a scant 1 cup per omelet) to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center. Then tilt the skillet, allowing the uncooked egg to move to the edges. Cook until set, about 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 254593,
      "primary_message": "Fold the omelet in half and remove to a plate; cut in half. Loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 254594,
      "primary_message": "Return skillet to medium heat and add more oil (about 1½ teaspoons per omelet). Repeat with remaining egg batter.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 254595,
      "primary_message": "To serve, divide rice, salad, and omelets between plates. Spoon chili-garlic sauce over the omelets and enjoy!",
      "secondary_message": "2 tbsp chili-garlic sauce"
    }
  ],
