  "instructions": [
    {
      "id": 316743,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 316744,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 (2 ½ cm) pieces ginger root\n3 English cucumbers\n3 red bell peppers\n3 medium carrots"
    },
    {
      "id": 316745,
      "primary_message": "Trim green onions; mince half and place in a large bowl. Slice the other half crosswise into ¼-inch pieces, place in another large bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 316746,
      "primary_message": "Peel and mince ginger and garlic; add to the bowl with the minced green onions, along with vinegar, soy sauce, honey, fish sauce, oil, and chili-garlic sauce. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n½ cup rice vinegar\n⅓ cup soy sauce\n2 tbsp honey\n2 tbsp fish sauce\n1 tbsp toasted sesame oil\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 316747,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch cubes; add to the bowl with the marinade, turn to coat, and set aside.",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 316748,
      "primary_message": "Add soy sauce, oil, vinegar, sesame seeds, honey, chili powder, and cayenne to the bowl with the sliced green onion; whisk to combine the dressing.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp toasted sesame oil\n1 tbsp rice vinegar\n1 tbsp sesame seeds\n1 ½ tsp honey\n1 ½ tsp chili powder\n3 pinch cayenne pepper"
    },
    {
      "id": 316749,
      "primary_message": "Using a clean cutting board, trim and halve cucumbers lengthwise, then slice crosswise into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 316750,
      "primary_message": "Trim, seed, and small dice bell peppers; peel, trim, and coarsely grate carrots. Add both to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 316751,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 316752,
      "primary_message": "While the grill pan heats up, thread steak onto skewers and place on a plate, reserving marinade for later use. (If you don't have skewers, you can cook the steak directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 316753,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add the skewers and cook, turning occasionally, until the steak is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 316754,
      "primary_message": "Meanwhile, pour reserved marinade into a small saucepan. Bring to a simmer over medium-high heat, then reduce heat to low, and simmer until sauce is slightly thickened, 3-4 minutes; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 316755,
      "primary_message": "To serve, divide skewers and salad between plates; drizzle skewers with sauce and enjoy!",
      "secondary_message": null
    }
  ],
