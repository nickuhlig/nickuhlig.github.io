  "instructions": [
    {
      "id": 316756,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 316757,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 316758,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 316759,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 (2 ½ cm) piece ginger root\n½ English cucumber\n½ red bell pepper\n1 medium carrot"
    },
    {
      "id": 316760,
      "primary_message": "Trim green onions; mince half and place in a medium bowl. Slice the other half crosswise into ¼-inch pieces, place in another medium bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 316761,
      "primary_message": "Peel and mince ginger and garlic; add to the bowl with the minced green onions, along with vinegar, soy sauce, oil, maple syrup, and chili-garlic sauce. Whisk to combine the marinade.",
      "secondary_message": "1 clove garlic\n3 tbsp rice vinegar\n3 tbsp soy sauce\n4 tsp toasted sesame oil\n2 tsp pure maple syrup\n1 tsp chili-garlic sauce"
    },
    {
      "id": 316762,
      "primary_message": "Cut tofu into 1-inch cubes, add to the bowl with marinade, and turn to coat; set aside.",
      "secondary_message": null
    },
    {
      "id": 316763,
      "primary_message": "Add soy sauce, oil, sesame seeds, vinegar, maple syrup, chili powder, and cayenne to the bowl with the sliced green onion; whisk to combine the dressing.",
      "secondary_message": "2 tsp soy sauce\n2 tsp toasted sesame oil\n1 tsp sesame seeds\n1 tsp rice vinegar\n½ tsp pure maple syrup\n½ tsp chili powder\n1 pinch cayenne pepper"
    },
    {
      "id": 316764,
      "primary_message": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 316765,
      "primary_message": "Trim, seed, and small dice bell pepper; peel, trim, and coarsely grate carrot. Add both to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 316766,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 316767,
      "primary_message": "Once the skillet is hot, add tofu and marinade; cook, stirring occasionally, until the tofu is warmed through and sauce is reduced, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 316768,
      "primary_message": "To serve, divide rice, tofu, sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
