  "instructions": [
    {
      "id": 316626,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 316627,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 316628,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 316629,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n3 (1 inch) pieces ginger root\n1 ½ English cucumbers\n1 ½ red bell peppers\n3 medium carrots"
    },
    {
      "id": 316630,
      "primary_message": "Trim green onions; mince half and place in a large bowl. Slice the other half crosswise into ¼-inch pieces, place in another large bowl, and set aside.",
      "secondary_message": null
    },
    {
      "id": 316631,
      "primary_message": "Peel and mince ginger and garlic; add to the bowl with the minced green onions, along with vinegar, soy sauce, oil, maple syrup, and chili-garlic sauce. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n½ cup rice vinegar\n½ cup soy sauce\n¼ cup toasted sesame oil\n2 tbsp pure maple syrup\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 316632,
      "primary_message": "Cut tofu into 1-inch cubes, add to the bowl with marinade, and turn to coat; set aside.",
      "secondary_message": null
    },
    {
      "id": 316633,
      "primary_message": "Add soy sauce, oil, sesame seeds, vinegar, maple syrup, chili powder, and cayenne to the bowl with the sliced green onion; whisk to combine the dressing.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp toasted sesame oil\n1 tbsp sesame seeds\n1 tbsp rice vinegar\n1 ½ tsp pure maple syrup\n1 ½ tsp chili powder\n3 pinch cayenne pepper"
    },
    {
      "id": 316634,
      "primary_message": "Trim and halve cucumbers lengthwise, then slice crosswise into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 316635,
      "primary_message": "Trim, seed, and small dice bell peppers; peel, trim, and coarsely grate carrots. Add both to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 316636,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 316637,
      "primary_message": "Once the skillet is hot, add tofu and marinade; cook, stirring occasionally, until the tofu is warmed through and sauce is reduced, 10-12 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 316638,
      "primary_message": "To serve, divide rice, tofu, sauce, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
