  "instructions": [
    {
      "id": 60022,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 60014,
      "primary_message": "Wash, dry, and quarter mushrooms. Peel and mince garlic.",
      "secondary_message": "¾ lb white mushrooms\n3 cloves garlic"
    },
    {
      "id": 60013,
      "primary_message": "Coat bottom of skillet with oil. Season steak generously with salt and pepper. Place in skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 ½ tbsp virgin coconut oil\n2 ¼ lb ribeye steak\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60021,
      "primary_message": "Return skillet to stove and reduce heat to medium. Add more oil, garlic, and mushrooms. Season with salt and pepper. Stirring occasionally, cook until mushrooms are golden, 3-4 minutes. Remove from heat and set aside to cool.",
      "secondary_message": "1 ½ tbsp virgin coconut oil\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 60020,
      "primary_message": "In a small bowl, prepare dressing by whisking together oil, vinegar, Dijon, honey, salt, and pepper.",
      "secondary_message": "9 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n3 tsp Dijon mustard\n¾ tsp honey\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60019,
      "primary_message": "Remove husks and silks from corn. Hold vertically in the middle of a large bowl and slice kernels off the cob.",
      "secondary_message": "3 ears corn"
    },
    {
      "id": 60018,
      "primary_message": "Wash and dry spinach and tomatoes. Halve the tomatoes. Add both to bowl with corn.",
      "secondary_message": "1 ½ (5 oz) pkg baby spinach\n1 ½ small pkg grape tomatoes"
    },
    {
      "id": 60017,
      "primary_message": "Add mushrooms and toss salad.",
      "secondary_message": ""
    },
    {
      "id": 60016,
      "primary_message": "Slice steak against the grain.",
      "secondary_message": ""
    },
    {
      "id": 60015,
      "primary_message": "To serve, arrange salad on a plate, top with steak slices, and drizzle with dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
