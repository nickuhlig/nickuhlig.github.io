  "instructions": [
    {
      "id": 279581,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 279582,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg cremini mushrooms\n3 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 279583,
      "primary_message": "Thinly slice mushrooms and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 279584,
      "primary_message": "Peel and mince ginger and garlic; add both to the bowl with the mushrooms.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 279585,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 279586,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, ginger, and garlic; cook, stirring occasionally, until mushrooms are lightly browned, 6-7 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 279587,
      "primary_message": "Meanwhile, cut tofu into ½-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 279588,
      "primary_message": "When the mushrooms are done, add broth to the pot and bring to a boil over medium-high heat.",
      "secondary_message": "2839 ml chicken or vegetable broth"
    },
    {
      "id": 279589,
      "primary_message": "Once the broth is boiling, add tofu, noodles, edamame, and soy sauce; stir to combine the soup. Bring to a simmer over medium heat and continue to cook until noodles are tender and tofu is warmed through, 5 minutes more. Remove from heat.",
      "secondary_message": "425 g soba (buckwheat) noodles\n2 cups edamame\n⅓ cup soy sauce"
    },
    {
      "id": 279590,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces; add to the soup and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 279591,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
