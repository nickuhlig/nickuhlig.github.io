  "instructions": [
    {
      "id": 279570,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 279571,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n2 (2 ½ cm) pieces ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 279572,
      "primary_message": "Thinly slice mushrooms and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 279573,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 279574,
      "primary_message": "While the pot heats up, peel and mince ginger and garlic; add both to the bowl with the mushrooms.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 279575,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, ginger, and garlic; cook, stirring occasionally, until mushrooms are lightly browned, 5-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 279576,
      "primary_message": "Meanwhile, cut tofu into ½-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 279577,
      "primary_message": "When the mushrooms are done, add broth to the pot and bring to a boil over medium-high heat.",
      "secondary_message": "1893 ml chicken or vegetable broth"
    },
    {
      "id": 279578,
      "primary_message": "Once the broth is boiling, add tofu, noodles, edamame, and soy sauce; stir to combine the soup. Bring to a simmer over medium heat and continue to cook until noodles are tender and tofu is warmed through, 5 minutes more. Remove from heat.",
      "secondary_message": "283 g soba (buckwheat) noodles\n1 ⅓ cups edamame\n¼ cup soy sauce"
    },
    {
      "id": 279579,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into thin pieces; add to the soup and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 279580,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
