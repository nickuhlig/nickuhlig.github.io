  "instructions": [
    {
      "id": 1,
      "primary_message": "Melt 2 tablespoons butter and olive oil in large skillet over medium-high heat. Add shallots and brown sugar and cook, stirring, until softened and beginning to brown, about 5 minutes. Add mushrooms and thyme and cook, stirring, until mushrooms are browned, about 7 minutes. Stir in sherry vinegar and cook an additional 1 minute. Season to taste with salt and pepper. Transfer mushroom mixture to plate and wipe out skillet.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Spread 1 side of each slice of bread with remaining 4 tablespoons butter and flip bread slices over. Distribute cheese evenly over 8 slices bread. Divide mushroom mixture among 4 slices of cheese-topped bread, then, top with remaining 4 slices and press down gently with hands. (Butter should be on exterior of sandwiches).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Cook sandwiches in 2 batches over medium heat until crisp and golden on both sides, pressing down with spatula, about 4 minutes per side. Transfer sandwiches to cutting board and let rest 3 minutes. Cut on the diagonal and serve immediately.",
      "secondary_message": null
    }
  ],
