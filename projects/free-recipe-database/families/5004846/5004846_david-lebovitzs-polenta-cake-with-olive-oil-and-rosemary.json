  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Pick the rosemary leaves from the stems and finely mince them. Bring the eggs to room temperature.",
      "secondary_message": "1 tbsp plus ½ cup unsalted butter\n2 tsp plus 4 tsp fresh rosemary leaves\n5 large eggs"
    },
    {
      "id": 1,
      "primary_message": "Preheat the oven to 350°F.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Smear 1 tablespoon butter all over the inside of a 10-cup (2.5-liter) Bundt cake or tube pan. Sprinkle the 2 teaspoons of rosemary evenly into the pan, then dust with the 2 tablespoons of polenta, tilting the pan to coat the sides.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To make the cake, in a small bowl, sift together the flour, 3/4 cup polenta, baking powder, and salt. Set aside. In a separate bowl, whisk the olive oil, eggs, egg yolks, and almond or vanilla extract.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a stand mixer fitted with the paddle attachment (or in a bowl by hand), beat together 1/2 cup butter and the sugar on medium speed until light and fluffy, 3 to 5 minutes. With the mixer running, slowly dribble in the egg mixture, a little at a time, until completely incorporated. Stir in the flour mixture along with the 4 teaspoons of rosemary until just incorporated. Don't over mix.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Scrape the batter into the prepared cake pan and smooth the top. Bake until a toothpick inserted into the center comes out clean, about 40 minutes. Let cool for about 30 minutes, then invert the cake onto a serving plate.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Storage: The cake will keep at room temperature for up to 4 days, well wrapped. It can be frozen for up to 2 months.",
      "secondary_message": null
    }
  ],
