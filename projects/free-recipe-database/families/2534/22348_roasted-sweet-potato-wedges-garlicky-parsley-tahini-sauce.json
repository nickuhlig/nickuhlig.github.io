  "instructions": [
    {
      "id": 378486,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 378487,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potato\n½ lemon\n¼ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 378488,
      "primary_message": "Peel and cut each sweet potato lengthwise into 6-8 wedges, depending on size, then transfer to a baking sheet pan. Drizzle with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp cumin, ground\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 378489,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until potatoes are golden brown and fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 378490,
      "primary_message": "Meanwhile, juice lemon into a blender. (Alternatively, you can prepare the sauce using a food processor.)",
      "secondary_message": null
    },
    {
      "id": 378491,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 378492,
      "primary_message": "Peel garlic. Add to the blender along with tahini, water, and salt. Blend on high until smooth, adding additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency.",
      "secondary_message": "1 clove garlic\n3 tbsp tahini\n2 tbsp water\n⅛ tsp salt"
    },
    {
      "id": 378493,
      "primary_message": "Divide sweet potato wedges between plates. Serve with tahini sauce for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
