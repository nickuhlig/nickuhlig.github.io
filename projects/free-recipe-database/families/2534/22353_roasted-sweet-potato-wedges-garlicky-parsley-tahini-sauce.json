  "instructions": [
    {
      "id": 378526,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 378527,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n1 ½ lemons\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 378528,
      "primary_message": "Peel and cut each sweet potato lengthwise into 6-8 wedges, depending on size, then divide between two baking sheet pans. Drizzle with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 378529,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until potatoes are golden brown and fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 378530,
      "primary_message": "Meanwhile, juice lemons into a blender. (Alternatively, you can prepare the sauce using a food processor.)",
      "secondary_message": null
    },
    {
      "id": 378531,
      "primary_message": "Shave parsley leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 378532,
      "primary_message": "Peel garlic. Add to the blender along with tahini, water, and salt. Blend on high until smooth, adding additional water, 1 tablespoon at a time, if needed, to reach a drizzling consistency.",
      "secondary_message": "2 cloves garlic\n½ cup tahini\n⅓ cup water\n¼ tsp salt"
    },
    {
      "id": 378533,
      "primary_message": "Divide sweet potato wedges between plates. Serve with tahini sauce for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
