  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 medium food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Small dice ham, place in a medium bowl, and set aside.\n\n",
      "secondary_message": "454 g ham steak, boneless"
    },
    {
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion.\n\n",
      "secondary_message": "1 medium red onion"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and broccoli; cook, stirring occasionally, until softened, 4-5 minutes.\n\n",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 (510 g) bag broccoli florets"
    },
    {
      "primary_message": "Meanwhile, place cottage cheese in a strainer to remove excess liquid. Transfer to another medium bowl, along with eggs and spices, then whisk to combine.\n\n",
      "secondary_message": "1 cup cottage cheese\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "primary_message": "When the broccoli is tender, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny 3-5 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Sprinkle diced ham and shredded cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven and let set, about 5 min.\n\n",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "primary_message": "Cut frittata into wedges and divide between the containers. Set aside to cool, about 15 minutes, then cover and refrigerate until ready to eat. Enjoy at room temperature or warmed in an oven or microwave.",
      "secondary_message": null
    }
  ],
