  "instructions": [
    {
      "id": 604267,
      "primary_message": "Preheat oven to 230°C (450°F). Line a large baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 604268,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n1 lime\n1 small bunch cilantro\n2 mangoes\n2 Granny Smith apples"
    },
    {
      "id": 604269,
      "primary_message": "Peel and slice sweet potatoes into ½-inch thick rounds. Transfer to the baking sheet, drizzle with oil, and season with spices. Stir to coat and arrange in an even layer. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp smoked paprika\n1 tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 604270,
      "primary_message": "Pat chicken dry with paper towels and place on a plate. Drizzle with oil and season with spices. Add to the baking sheet, nestling chicken into the sweet potatoes.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n2 tsp extra virgin olive oil\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 604271,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until sweet potatoes are fork-tender and chicken is cooked through, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 604272,
      "primary_message": "Meanwhile, zest lime into a medium bowl. Add honey and hot sauce, then stir to combine. Set hot honey aside. (Reserve lime for the next step.)",
      "secondary_message": "3 tbsp honey\n4 tsp hot sauce"
    },
    {
      "id": 604273,
      "primary_message": "Juice reserved lime into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 604274,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 604275,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 604276,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 604277,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 604278,
      "primary_message": "When the sweet potatoes and chicken are done, remove from the oven. Transfer chicken to the bowl with the hot honey and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 604279,
      "primary_message": "To serve, divide chicken, sweet potatoes, and salad between plates. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
