  "instructions": [
    {
      "id": 604199,
      "primary_message": "Preheat oven to 450°F. Line two large baking sheet pans with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 604200,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n1 ½ limes\n1 small bunch cilantro\n3 mangoes\n3 Granny Smith apples"
    },
    {
      "id": 604201,
      "primary_message": "Peel and slice sweet potatoes into ½-inch thick rounds. Divide between the baking sheets, drizzle with oil, and season with spices. Stir to coat and arrange in an even layer. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp smoked paprika\n1 ½ tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 604202,
      "primary_message": "Pat chicken dry with paper towels and place on a plate. Drizzle with oil and season with spices. Add to the baking sheets, nestling chicken into the sweet potatoes.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n1 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 604203,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until sweet potatoes are fork-tender and chicken is cooked through, about 25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 604204,
      "primary_message": "Meanwhile, zest limes into a large bowl. Add honey and hot sauce, then stir to combine. Set hot honey aside. (Reserve limes for the next step.)",
      "secondary_message": "¼ cup honey\n2 tbsp hot sauce"
    },
    {
      "id": 604205,
      "primary_message": "Juice reserved limes into another large bowl.",
      "secondary_message": null
    },
    {
      "id": 604206,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 604207,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 604208,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 604209,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl and stir to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 604210,
      "primary_message": "When the sweet potatoes and chicken are done, remove from the oven. Transfer chicken to the bowl with the hot honey and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 604211,
      "primary_message": "To serve, divide chicken, sweet potatoes, and salad between plates. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
