  "instructions": [
    {
      "id": 604240,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 604241,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 604242,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n1 ½ limes\n1 small bunch cilantro\n3 mangoes\n3 Granny Smith apples"
    },
    {
      "id": 604243,
      "primary_message": "Peel and slice sweet potatoes crosswise into ½-inch thick rounds. Transfer to another large baking sheet, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp smoked paprika\n1 ½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 604244,
      "primary_message": "Cut tofu planks in half, then cut each half into two triangles. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet and arrange in a single layer. Drizzle with oil, then season with cornstarch and spices on both sides.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ cup cornstarch\n1 ½ tsp onion powder\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 604245,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until sweet potatoes are fork-tender and tofu is golden brown, about 25 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 604246,
      "primary_message": "Meanwhile, zest limes into a large bowl. Add honey and hot sauce, then stir to combine. Set hot honey aside. (Reserve limes for the next step.)",
      "secondary_message": "¼ cup honey\n2 tbsp hot sauce"
    },
    {
      "id": 604247,
      "primary_message": "Juice reserved limes into another large bowl.",
      "secondary_message": null
    },
    {
      "id": 604248,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 604249,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 604250,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 604251,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 604252,
      "primary_message": "When the sweet potatoes and tofu are done, remove from the oven. Transfer tofu to the bowl with the hot honey and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 604253,
      "primary_message": "To serve, divide the tofu, sweet potatoes, and salad between plates. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
