  "instructions": [
    {
      "id": 604226,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 604227,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 604228,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n1 lime\n1 small bunch cilantro\n2 mangoes\n2 Granny Smith apples"
    },
    {
      "id": 604229,
      "primary_message": "Peel and slice sweet potatoes crosswise into ½-inch thick rounds. Transfer to another baking sheet, drizzle with oil, and season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp smoked paprika\n1 tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 604230,
      "primary_message": "Cut tofu planks in half, then cut each half into two triangles. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet and arrange in a single layer. Drizzle with oil, then season with cornstarch and spices on both sides.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 tbsp cornstarch\n1 tsp onion powder\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 604231,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until sweet potatoes are fork-tender and tofu is golden brown, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 604232,
      "primary_message": "Meanwhile, zest lime into a medium bowl. Add honey and hot sauce, then stir to combine. Set hot honey aside. (Reserve lime for the next step.)",
      "secondary_message": "3 tbsp honey\n4 tsp hot sauce"
    },
    {
      "id": 604233,
      "primary_message": "Juice reserved lime into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 604234,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 604235,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 604236,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 604237,
      "primary_message": "Quarter, core, and medium dice apples. Add to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 604238,
      "primary_message": "When the sweet potatoes and tofu are done, remove from the oven. Transfer tofu to the bowl with the hot honey and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 604239,
      "primary_message": "To serve, divide the tofu, sweet potatoes, and salad between plates. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
