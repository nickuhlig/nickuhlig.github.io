  "instructions": [
    {
      "id": 604293,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 604294,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on another baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 604295,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n½ lime\n½ small bunch cilantro\n1 mango\n1 Granny Smith apple"
    },
    {
      "id": 604296,
      "primary_message": "Peel and slice sweet potato crosswise into ½-inch thick rounds. Transfer to the baking sheet, drizzle with oil, and season with spices. Stir to coat and spread out on one half of the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp smoked paprika\n½ tsp chili powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 604297,
      "primary_message": "Cut tofu planks in half, then cut each half into two triangles. Arrange tofu to the other half of the baking sheet in a single layer. Drizzle with oil, then season with cornstarch and spices on both sides.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 ½ tbsp cornstarch\n½ tsp onion powder\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 604298,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping halfway through, until sweet potatoes are fork-tender and tofu is golden brown, about 20 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 604299,
      "primary_message": "Meanwhile, zest lime into a medium bowl. Add honey and hot sauce, then stir to combine. Set hot honey aside. (Reserve lime for the next step.)",
      "secondary_message": "1 ½ tbsp honey\n2 tsp hot sauce"
    },
    {
      "id": 604300,
      "primary_message": "Juice reserved lime into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 604301,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lime juice along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 604302,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half to the bowl with the dressing. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 604303,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 604304,
      "primary_message": "Quarter, core, and medium dice apple. Add to the bowl and stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 604305,
      "primary_message": "When the sweet potatoes and tofu are done, remove from the oven. Transfer tofu to the bowl with the hot honey and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 604306,
      "primary_message": "To serve, divide the tofu, sweet potatoes, and salad between plates. Top with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
