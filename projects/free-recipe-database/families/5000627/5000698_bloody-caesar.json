  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the tomato juice cold until you use it. Juice the lemon. Cube the chunks of Parmesan cheese.",
      "secondary_message": "3 cups tomato juice\n1 lemon\nChunks of Parmesan cheese"
    },
    {
      "id": 1,
      "primary_message": "For the Bloody Caesar mix: In a large pitcher, whisk tomato juice, bottled clam juice, lemon juice, Worcestershire sauce, fish sauce, sugar, oregano, garlic powder, and MSG, if using, until combined. Season to taste with salt. Cover and refrigerate until chilled, at least 2 hours or up to 2 days.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the cocktail: Fill glasses with ice. Add 3/4 cup (177 ml) Bloody Caesar mix, 3 tablespoons (44 ml) vodka, a dash of Tabasco (if using) and a pinch of black pepper (if using) to each glass and stir to combine. Top with your preferred garnishes as desired. Serve.",
      "secondary_message": null
    }
  ],
