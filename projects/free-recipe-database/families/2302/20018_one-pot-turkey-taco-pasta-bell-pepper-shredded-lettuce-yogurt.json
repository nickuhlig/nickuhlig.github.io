  "instructions": [
    {
      "id": 333924,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 heart romaine hearts\n½ small bunch cilantro"
    },
    {
      "id": 333925,
      "primary_message": "Trim, seed, and small dice bell pepper; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 333926,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 333927,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 333928,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add veggies, turkey, taco seasoning, and salt. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tsp extra virgin olive oil\n¾ lb ground turkey\n3 tbsp taco seasoning\n¼ tsp salt"
    },
    {
      "id": 333929,
      "primary_message": "Meanwhile, cut lettuce crosswise into thin (shred-like) strips. Place in the reserved bowl and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 333930,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 333931,
      "primary_message": "When the turkey is done, add water, salsa, and pasta to the pan; stir to combine, cover, and bring to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until pasta is tender and the liquid is mostly absorbed, 8-10 minutes.",
      "secondary_message": "1 cup water\n1 cup salsa\n5 oz macaroni (elbow) pasta"
    },
    {
      "id": 333932,
      "primary_message": "When the pasta is done, add cilantro, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 333933,
      "primary_message": "To serve, divide taco pasta between plates or bowls; top with shredded lettuce and yogurt. Enjoy!",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
