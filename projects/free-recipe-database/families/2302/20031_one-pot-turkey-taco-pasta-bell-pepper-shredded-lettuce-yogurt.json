  "instructions": [
    {
      "id": 334054,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 hearts romaine hearts\n1 small bunch cilantro"
    },
    {
      "id": 334055,
      "primary_message": "Trim, seed, and small dice bell peppers; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 334056,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334057,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 334058,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies, turkey, taco seasoning, and salt. Cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n0.68 kg ground turkey\n⅓ cup taco seasoning\n½ tsp salt"
    },
    {
      "id": 334059,
      "primary_message": "Meanwhile, cut lettuce crosswise into thin (shred-like) strips. Place in the reserved bowl and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 334060,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 334061,
      "primary_message": "When the turkey is done, add water, salsa, and pasta to the pot; stir to combine, cover, and bring to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until pasta is tender and the liquid is mostly absorbed, 8-10 minutes.",
      "secondary_message": "2 cup water\n2 cup salsa\n283 g macaroni (elbow) pasta"
    },
    {
      "id": 334062,
      "primary_message": "When the pasta is done, add cilantro, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 334063,
      "primary_message": "To serve, divide taco pasta between plates or bowls; top with shredded lettuce and yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
