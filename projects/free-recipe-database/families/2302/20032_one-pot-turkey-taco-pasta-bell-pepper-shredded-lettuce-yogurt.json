  "instructions": [
    {
      "id": 334064,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 hearts romaine hearts\n1 small bunch cilantro"
    },
    {
      "id": 334065,
      "primary_message": "Trim, seed, and small dice bell peppers; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 334066,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the bell pepper.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 334067,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 334068,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies, turkey, taco seasoning, and salt. Cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1.02 kg ground turkey\n½ cup taco seasoning\n¾ tsp salt"
    },
    {
      "id": 334069,
      "primary_message": "Meanwhile, cut lettuce crosswise into thin (shred-like) strips. Place in the reserved bowl and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 334070,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 334071,
      "primary_message": "When the turkey is done, add water, salsa, and pasta to the pot; stir to combine, cover, and bring to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until pasta is tender and the liquid is mostly absorbed, about 10 minutes.",
      "secondary_message": "3 cup water\n3 cup salsa\n425 g macaroni (elbow) pasta"
    },
    {
      "id": 334072,
      "primary_message": "When the pasta is done, add cilantro, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 334073,
      "primary_message": "To serve, divide taco pasta between plates or bowls; top with shredded lettuce and yogurt. Enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
