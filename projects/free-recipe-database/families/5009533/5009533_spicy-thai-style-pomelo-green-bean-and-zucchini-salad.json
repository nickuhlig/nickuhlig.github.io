  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the green Thai chili. Cut the trimmed green beans into 1-inch segments. Thinly slice the shallot.",
      "secondary_message": "1 small green Thai chili\n12 oz trimmed green beans\n1 medium shallot"
    },
    {
      "id": 1,
      "primary_message": "Bring a large pot of salted water to a boil. Meanwhile, Combine garlic, pepper flakes, and Thai chilies in a mortar and pestle and pound into a fine paste (see note). Add sugar, fish sauce, and lime juice, and pound until the sugar is dissolved. Taste dressing and add more sugar, fish sauce, lime juice, or pepper flakes to taste. It should be strongly spicy, sweet, salty, and acidic.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Blanch beans in boiling water until bright green but still extremely crisp, about 1 minute. Drain and run under cold water to chill. Dry well on paper towels or in a salad spinner. Combine beans, zucchini, shallot, pomelo, mint, and dressing in a large bowl and toss to coat. Serve immediately.",
      "secondary_message": null
    }
  ],
