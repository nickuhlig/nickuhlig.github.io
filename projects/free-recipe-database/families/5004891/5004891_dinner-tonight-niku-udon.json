  "instructions": [
    {
      "id": 1,
      "primary_message": "Fill a large pot halfway up with water and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the udon broth: Pour water into a medium-sized saucepan. Add the kombu, and let it soak for 20 minutes. Then turn heat to high. When it comes to a boil, immediately remove the kombu with a pair of tongs, and reduce the heat to low. Add the katsuobushi and stir gently. Simmer for 10 minutes. Turn off the heat, and then strain the liquid through a fine-mesh sieve. Discard the katsuobushi.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour the strained liquid back into the medium-sized pot, and add the soy sauce and mirin. Turn heat to medium and bring to a simmer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "For the niku udon: Using a pair of tongs, dip one slice of the beef into the simmering liquid at a time. Cook until no longer pink, five to ten seconds. Transfer beef to a plate and repeat process with remaining slices. Cover slices to keep warm.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add tofu and scallions to the simmering liquid. Simmer for one minute. Then turn heat to low, and cover.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Cook the udon noodles in the large pot of boiling water according to the directions on the package. Drain in a colander when done and divide the noodles between four bowls.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Divide the broth, tofu, scallions, and beef between the four bowls. Garnish each with watercress.",
      "secondary_message": null
    }
  ],
