  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat the oven to 400°F. Dust the countertop with some flour. Unfold the puff pastry, dock lightly with a fork, and season with a generous pinch of sea salt. Scatter 1 cup of cheese evenly over the top, and use a rolling pin to gently press it into the pastry. Top with half of the piment d’Espelette. Repeat with the second sheet of pastry and the remaining ingredients.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Use a ravioli cutter to slice the pastry in strips about 1-inch by 3 inches. Twist each strip in the middle to form a bowtie.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place strips, spaced out, on a Silpat or parchment-lined baking sheet (you may need to do this in two batches). Bake until puffed and golden, 15 to 20 minutes.",
      "secondary_message": null
    }
  ],
