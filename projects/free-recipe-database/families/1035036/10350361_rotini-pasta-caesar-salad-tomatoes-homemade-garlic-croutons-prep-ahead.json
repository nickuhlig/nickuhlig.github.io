  "instructions": [
    {
      "primary_message": "This recipe utilizes 4 large, 4 small, and 4 mini food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta, rinse under cold water to cool, and set aside.\n\n",
      "secondary_message": "½ tsp salt\n170 g rotini pasta"
    },
    {
      "primary_message": "Meanwhile, preheat a skillet over medium heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, cut bread into ¾-inch cubes.\n\n",
      "secondary_message": "3 slice whole grain bread"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and spices to the skillet; cook, stirring occasionally, until croutons are golden brown, 5-6 minutes. Remove from heat, divide between small containers, and set aside to cool. Once cool, cover and store at room temperature.\n\n",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tsp Italian seasoning\n¼ tsp garlic powder\n¼ tsp salt"
    },
    {
      "primary_message": "Meanwhile, wash and dry the fresh produce.\n\n",
      "secondary_message": "1 lemon\n1 pint grape tomatoes"
    },
    {
      "primary_message": "Juice lemon into a small bowl.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Mince anchovy fillets. Add to the bowl with the lemon juice, along with Parmesan, mayo, oil, Worcestershire, and spices, then whisk to combine the dressing. Divide between the mini containers and set aside.\n\n",
      "secondary_message": "½ cup Parmesan cheese, grated\n⅓ cup mayonnaise\n1 ½ tbsp extra virgin olive oil\n1 tsp Worcestershire sauce\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Divide between the medium containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Halve grape tomatoes. Add to the containers with the lettuce along with cooled pasta and dressing. Cover and refrigerate until ready to eat. Drizzle salad with dressing, top with croutons, and enjoy!",
      "secondary_message": null
    }
  ],
