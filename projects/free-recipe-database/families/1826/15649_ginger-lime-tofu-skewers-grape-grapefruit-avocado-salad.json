  "instructions": [
    {
      "id": 257350,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 257351,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 257352,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 limes\n3 (1 inch) pieces ginger root\n¾ lb red grapes\n3 grapefruits\n1 ½ avocados\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 257353,
      "primary_message": "Zest limes into a large bowl (set limes aside for later use).",
      "secondary_message": null
    },
    {
      "id": 257354,
      "primary_message": "Peel and mince onion; place half in the bowl with the lime zest (set remaining onion aside).",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 257355,
      "primary_message": "Peel and grate or mince ginger. Add to the bowl with the lime zest along with mayo, salt, and pepper; stir to combine the marinade.",
      "secondary_message": "½ cup vegan mayonnaise\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 257356,
      "primary_message": "Cut tofu into bite-sized cubes; transfer to the bowl with the marinade, gently stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 257357,
      "primary_message": "Meanwhile, juice limes into another large bowl. Add remaining onion, oil, soy sauce, sugar, and Dijon; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp soy sauce\n1 tbsp brown sugar\n¾ tsp Dijon mustard"
    },
    {
      "id": 257358,
      "primary_message": "Thread tofu onto skewers and place on a plate; alternatively, you can cook the tofu pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 257359,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257360,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add the skewers and cook, turning occasionally, until tofu is golden, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 257361,
      "primary_message": "While the tofu is cooking, halve grapes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 257362,
      "primary_message": "Cut off skin and white pith from the grapefruits. Slice between the membranes to release segments; cut into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 257363,
      "primary_message": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl along with the mixed greens and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 257364,
      "primary_message": "To serve, divide salad and skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
