  "instructions": [
    {
      "id": 257452,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 257453,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 257454,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lime\n1 (2 ½ cm) piece ginger root\n0.11 kg red grapes\n1 grapefruit\n½ avocado\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 257455,
      "primary_message": "Zest lime into a medium bowl (set lime aside for later use).",
      "secondary_message": null
    },
    {
      "id": 257456,
      "primary_message": "Peel and mince shallot; place half in the bowl with the lime zest (set remaining shallot aside).",
      "secondary_message": "1 shallot"
    },
    {
      "id": 257457,
      "primary_message": "Peel and grate or mince ginger. Add to the bowl with the lime zest along with mayo, salt, and pepper; stir to combine the marinade.",
      "secondary_message": "3 tbsp vegan mayonnaise\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 257458,
      "primary_message": "Cut tofu into bite-sized cubes; transfer to the bowl with the marinade, gently stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 257459,
      "primary_message": "Meanwhile, juice lime into another medium bowl. Add remaining shallot, oil, soy sauce, sugar, and Dijon; whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp soy sauce\n1 tsp brown sugar\n¼ tsp Dijon mustard"
    },
    {
      "id": 257460,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257461,
      "primary_message": "While the grill pan heats up, thread tofu onto skewers and place on a plate; alternatively, you can cook the tofu pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 257462,
      "primary_message": "Once the grill pan is hot, add the skewers and cook, turning occasionally, until tofu is golden, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 257463,
      "primary_message": "While the tofu is cooking, halve grapes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 257464,
      "primary_message": "Cut off skin and white pith from the grapefruit. Slice between the membranes to release segments; cut into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 257465,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl along with the mixed greens and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 257466,
      "primary_message": "To serve, divide salad and skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
