  "instructions": [
    {
      "id": 257410,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 257411,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lime\n1 (2 ½ cm) piece ginger root\n0.11 kg red grapes\n1 grapefruit\n½ avocado\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 257412,
      "primary_message": "Zest lime into a medium bowl (set lime aside for later use).",
      "secondary_message": null
    },
    {
      "id": 257413,
      "primary_message": "Peel and mince shallot; place half in the bowl with the lime zest (set remaining shallot aside).",
      "secondary_message": "1 shallot"
    },
    {
      "id": 257414,
      "primary_message": "Peel and grate or mince ginger. Add to the bowl with the lime zest along with mayo, salt, and pepper; stir to combine the marinade.",
      "secondary_message": "2 tbsp mayonnaise\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 257415,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces; transfer to the bowl with the marinade, stir to coat, and set aside.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless"
    },
    {
      "id": 257416,
      "primary_message": "Meanwhile, juice lime into another medium bowl. Add remaining shallot, oil, fish sauce, sugar, and Dijon; whisk to combine the dressing and set aside.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp fish sauce\n1 tsp brown sugar\n¼ tsp Dijon mustard"
    },
    {
      "id": 257417,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257418,
      "primary_message": "While the grill pan heats up, thread chicken onto skewers and place on a plate; alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 257419,
      "primary_message": "Once the grill pan is hot, add the skewers and cook, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 257420,
      "primary_message": "While the chicken is cooking, using a clean cutting board, halve grapes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 257421,
      "primary_message": "Cut off skin and white pith from the grapefruit. Slice between the membranes to release segments; cut into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 257422,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl along with the mixed greens and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 257423,
      "primary_message": "To serve, divide salad and skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
