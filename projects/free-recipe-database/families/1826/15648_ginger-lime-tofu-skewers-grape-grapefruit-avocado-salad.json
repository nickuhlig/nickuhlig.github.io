  "instructions": [
    {
      "id": 257335,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 257336,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 257337,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 limes\n2 (1 inch) pieces ginger root\n½ lb red grapes\n2 grapefruits\n1 avocado\n2 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 257338,
      "primary_message": "Zest limes into a medium bowl (set limes aside for later use).",
      "secondary_message": null
    },
    {
      "id": 257339,
      "primary_message": "Peel and mince shallots; place half in the bowl with the lime zest (set remaining shallot aside).",
      "secondary_message": "2 shallots"
    },
    {
      "id": 257340,
      "primary_message": "Peel and grate or mince ginger. Add to the bowl with the lime zest along with mayo, salt, and pepper; stir to combine the marinade.",
      "secondary_message": "⅓ cup vegan mayonnaise\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 257341,
      "primary_message": "Cut tofu into bite-sized cubes; transfer to the bowl with the marinade, gently stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 257342,
      "primary_message": "Meanwhile, juice limes into a large bowl. Add remaining shallot, oil, soy sauce, sugar, and Dijon; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp soy sauce\n2 tsp brown sugar\n½ tsp Dijon mustard"
    },
    {
      "id": 257343,
      "primary_message": "Thread tofu onto skewers and place on a plate; alternatively, you can cook the tofu pieces directly on the grill pan without using skewers.",
      "secondary_message": null
    },
    {
      "id": 257344,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 257345,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add the skewers and cook, turning occasionally, until tofu is golden, 8-10 minutes. Return to the plate.",
      "secondary_message": null
    },
    {
      "id": 257346,
      "primary_message": "While the tofu is cooking, halve grapes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 257347,
      "primary_message": "Cut off skin and white pith from the grapefruits. Slice between the membranes to release segments; cut into bite-sized pieces and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 257348,
      "primary_message": "Halve and pit the avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl along with the mixed greens and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 257349,
      "primary_message": "To serve, divide salad and skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
