  "instructions": [
    {
      "id": 1631,
      "primary_message": "Wash cauliflower and tomatoes. Cut the cauliflower into bite-sized florets. Medium dice the tomatoes.",
      "secondary_message": "1 medium head cauliflower\r\n2 tomatoes"
    },
    {
      "id": 1632,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 1633,
      "primary_message": "Peel and mince onion and garlic.",
      "secondary_message": "½ medium yellow onion\r\n2 cloves garlic"
    },
    {
      "id": 1634,
      "primary_message": "Coat bottom of pan with oil. Add onion and cook, stirring frequently, until softened, 3-4 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 1635,
      "primary_message": "Drain and rinse chickpeas.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 1636,
      "primary_message": "Add garlic and curry powder to pan and stir with onion until fragrant, 15-30 seconds.",
      "secondary_message": "1 tbsp curry powder"
    },
    {
      "id": 8008,
      "primary_message": "Add cauliflower and chickpeas and stir until heated through, 1-2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 1637,
      "primary_message": "Add tomatoes, coconut milk, salt, and pepper; bring to a boil. Reduce heat to a simmer and cover. Cook until cauliflower is tender and liquid thickens, about 10 minutes.",
      "secondary_message": "½ (13.5 oz) can coconut milk\r\n¼ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 1638,
      "primary_message": "In a small saucepan, bring broth to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n⅔ cup whole wheat couscous"
    },
    {
      "id": 1639,
      "primary_message": "Wash and dry cilantro. Shave the leaves off the stems; discard the stems and mince the leaves. Stir ½ into the curry (save the rest for garnishing).",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 1640,
      "primary_message": "Uncover couscous and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 1641,
      "primary_message": "To serve, place couscous in a bowl, top with curry and garnish with remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
