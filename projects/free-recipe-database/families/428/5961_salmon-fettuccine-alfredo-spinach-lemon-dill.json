  "instructions": [
    {
      "id": 71886,
      "primary_message": "Fill a large pot (for the pasta) about halfway with water; cover and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 71885,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ (142 g) pkg baby spinach\n1 ½ small bunches fresh dill\n1 ½ lemon"
    },
    {
      "id": 71884,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 71883,
      "primary_message": "While the pan warms up, place the salmon on a plate and season both sides with salt and pepper.",
      "secondary_message": "1.02 kg salmon fillet\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 71882,
      "primary_message": "Add butter to the pan and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 71881,
      "primary_message": "Place the salmon, skin-side down, in the pan; cook until it is cooked through, 3 to 5 minutes per side. Cook in batches if necessary. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 71880,
      "primary_message": "Meanwhile, peel and mince the garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 71879,
      "primary_message": "Once the salmon has been transferred, reduce the heat to medium-low and add more butter to the pan.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 71878,
      "primary_message": "Add the garlic and flour to the pan; whisk until the mixture is smooth, about 1 minute.",
      "secondary_message": "3 tbsp all-purpose flour"
    },
    {
      "id": 71877,
      "primary_message": "Add the broth and whisk until smooth, then add the milk and cook, stirring frequently, until the sauce is thickened, 4 to 5 minutes.",
      "secondary_message": "355 ml (1 ½ cup) chicken or vegetable broth\n355 ml (1 ½ cup) whole milk"
    },
    {
      "id": 71876,
      "primary_message": "Once the water in the saucepan is boiling, season with salt and add the pasta; stir for the few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "3 tbsp salt\n425 g (1 quarter coin = 57 g) fettuccine pasta"
    },
    {
      "id": 71875,
      "primary_message": "While the sauce cooks, pick the tender dill stems off the tough stems; discard the tough stems and finely chop the tender ones.",
      "secondary_message": ""
    },
    {
      "id": 71874,
      "primary_message": "Finely grate ¾ cup of Parmesan.",
      "secondary_message": "42 g Parmesan cheese"
    },
    {
      "id": 71873,
      "primary_message": "Add the Parmesan to the sauce and season with salt and pepper; stir until smooth, then turn off the heat.",
      "secondary_message": "¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 71872,
      "primary_message": "Grate the zest from the lemons and transfer to a small bowl, then juice the lemons into the same bowl.",
      "secondary_message": ""
    },
    {
      "id": 71871,
      "primary_message": "Drain the pasta in a colander, reserving about 1 ½ cup of the pasta water.",
      "secondary_message": ""
    },
    {
      "id": 71870,
      "primary_message": "Using a fork or your hands, flake the salmon into bite-sized pieces.",
      "secondary_message": ""
    },
    {
      "id": 71869,
      "primary_message": "Add the pasta, spinach, ¾ of the dill (save the rest for garnishing), salmon, lemon zest and juice, and ½ of the reserved pasta water to the sauce; toss to combine. Return sauté pan to the stove over medium-low heat; cook for 2-3 minutes or until spinach has wilted, adding more pasta water to thin out the sauce as needed.",
      "secondary_message": ""
    },
    {
      "id": 71868,
      "primary_message": "To serve, divide pasta between dishes, sprinkle with the remaining dill, and season with freshly ground pepper. Enjoy!",
      "secondary_message": ""
    }
  ],
