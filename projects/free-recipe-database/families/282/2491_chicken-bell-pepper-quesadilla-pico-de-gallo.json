  "instructions": [
    {
      "id": 24125,
      "primary_message": "Peel and mince onion. Wash, seed, and small dice bell peppers.",
      "secondary_message": "1 medium red onion\r\n2 red bell peppers"
    },
    {
      "id": 24126,
      "primary_message": "Wash and dry tomatoes, jalapeños, and cilantro. Small dice tomatoes. Seed and mince jalapeños. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "4 tomatoes\r\n2 jalapeño peppers\r\n1 small bunch cilantro"
    },
    {
      "id": 24127,
      "primary_message": "In a small bowl, prepare salsa by mixing together the tomatoes, ½ of the onion, ½ of the jalapeño, ½ of the cilantro, lime juice, salt, and pepper.",
      "secondary_message": "juice of 1 lime\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 24128,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 24129,
      "primary_message": "Slice chicken in half horizontally into thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.454 kg chicken breasts, boneless skinless\r\n½ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 24130,
      "primary_message": "Add oil to skillet and swirl to coat bottom. Add chicken and cook until browned and cooked through, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n"
    },
    {
      "id": 24131,
      "primary_message": "Return skillet to stove. Add more oil, bell pepper, and remaining onion, jalapeño, and cilantro. Season with cumin, salt, and pepper. Stirring frequently, cook until vegetables have softened, 2-3 minutes. Transfer to plate with chicken.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n¼ tsp cumin\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 24132,
      "primary_message": "Slice chicken crosswise into strips.",
      "secondary_message": ""
    },
    {
      "id": 24133,
      "primary_message": "Coarsely grate 2 cups of cheddar.",
      "secondary_message": "1 (227 g) block cheddar cheese.\r\n"
    },
    {
      "id": 24134,
      "primary_message": "Place tortillas on a flat surface. Layer one half of each tortilla with ⅛ of the cheese, ¼ of the chicken and vegetable mixture, and top with another ⅛ of the cheese. Fold tortillas over so they are closed.",
      "secondary_message": "4 large flour tortillas\n"
    },
    {
      "id": 24135,
      "primary_message": "Wipe skillet with paper towel and reduce heat to medium. Add oil and swirl to coat.",
      "secondary_message": "½ tbsp virgin coconut oil\r\n"
    },
    {
      "id": 24136,
      "primary_message": "Place two of the quesadillas in the skillet, straight edges next to each other. Cook until golden brown on both sides and cheese is melted, 2-3 minutes per side. Transfer to a cutting board and cut into wedges. Add more oil and repeat with remaining two quesadillas.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 24137,
      "primary_message": "To serve, place quesadilla on a plate and serve with salsa. Enjoy!",
      "secondary_message": ""
    }
  ],
