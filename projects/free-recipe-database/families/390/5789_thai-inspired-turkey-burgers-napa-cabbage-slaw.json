  "instructions": [
    {
      "id": 69296,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium head napa cabbage\n6 medium carrots\n3 jalapeño peppers\n3 limes\n3 (1 inch) pieces ginger root\n1 ½ small bunches cilantro"
    },
    {
      "id": 69310,
      "primary_message": "Place the ground turkey in a medium bowl.",
      "secondary_message": "2 ¼ lb ground turkey"
    },
    {
      "id": 69309,
      "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the turkey.",
      "secondary_message": ""
    },
    {
      "id": 69308,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add ½ of the cilantro to the turkey mixture and the other ½ to a large salad bowl (that will be used for the slaw).",
      "secondary_message": ""
    },
    {
      "id": 69307,
      "primary_message": "Juice the limes; pour ½ into the bowl with the turkey mixture and the other ½ into the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 69306,
      "primary_message": "Peel and grate or mince the ginger; add to the turkey mixture.",
      "secondary_message": ""
    },
    {
      "id": 69305,
      "primary_message": "Preheat a grill pan or skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 69304,
      "primary_message": "While the pan / skillet heats up, add soy sauce to the turkey mixture and mix the ingredients until well combined. Form the turkey mixture into six patties.",
      "secondary_message": "1 ½ tbsp soy sauce"
    },
    {
      "id": 69303,
      "primary_message": "Once the pan / skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "id": 69302,
      "primary_message": "Place the patties in the pan / skillet; cook until they are cooked through and browned, 3 to 5 minutes per side. Once done, transfer the patties to a plate.",
      "secondary_message": ""
    },
    {
      "id": 69301,
      "primary_message": "Add soy sauce, rice vinegar, sesame oil, and honey to the salad bowl; whisk the dressing.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp rice vinegar\n3 tsp toasted sesame oil\n3 tsp honey"
    },
    {
      "id": 69300,
      "primary_message": "Trim off and discard the root end of the cabbage; quarter the cabbage lengthwise, then thinly slice crosswise and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 69299,
      "primary_message": "Peel the carrots, then trim off the ends; discard the peels and trimmings. Using a box grater, coarsely grate the carrots and add to the salad bowl. Toss the salad until well coated with the dressing.",
      "secondary_message": ""
    },
    {
      "id": 69298,
      "primary_message": "Toast the burger buns (optional).",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 69297,
      "primary_message": "To serve, place the bottom half of a bun on a plate, top with a patty and some of the slaw, and close with the top half of the bun. Serve with the remaining slaw on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
