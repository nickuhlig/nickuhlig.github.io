  "instructions": [
    {
      "primary_message": "Place a large bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and thinly slice strawberries. Place on a plate.\n\n",
      "secondary_message": "½ (16 oz) pkg strawberries"
    },
    {
      "primary_message": "Wash, dry, peel, and trim kiwis; quarter lengthwise, then slice crosswise into bite-sized pieces. Add to the plate with the strawberries and set aside.",
      "secondary_message": "2 kiwifruit"
    },
    {
      "primary_message": "Remove bowl from the freezer. Place mascarpone in the bowl and, using a hand-held mixer, whisk on medium until smooth, about 1 minute.",
      "secondary_message": "⅔ cup mascarpone cheese"
    },
    {
      "primary_message": "Add cream, powdered sugar, vanilla, and salt to the bowl, then continue to beat until medium-soft peaks form, about 3 minutes. (When you pull the beaters out of the bowl, the cream mixture should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "1 ½ cups heavy whipping cream\n3 tbsp powdered sugar\n¼ tsp vanilla extract\n1 pinch salt"
    },
    {
      "primary_message": "Fill dessert cake shells with whipped cream, then decorate with sliced fruit.",
      "secondary_message": "2 (5 oz) pkg mini cake dessert shells"
    },
    {
      "primary_message": "To serve, arrange filled dessert cake shells on a platter and enjoy! If planning ahead, cover dessert cups with plastic wrap and refrigerate until ready to serve.",
      "secondary_message": null
    }
  ],
