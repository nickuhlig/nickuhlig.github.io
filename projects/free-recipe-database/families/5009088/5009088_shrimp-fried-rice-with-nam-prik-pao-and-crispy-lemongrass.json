  "instructions": [
    {
      "id": 1,
      "primary_message": "In an 8-inch skillet or 1-quart saucepan, combine lemongrass slices and oil. Place over low heat and cook, stirring constantly, until lemongrass turns light brown, about 20 minutes. Pour lemongrass mixture through a fine-mesh strainer set over a medium bowl (lemongrass will continue cooking for a brief period after draining, so do not allow them to get too dark). Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a 12-inch skillet or wok, heat 2 tablespoons of the reserved lemongrass oil over high heat until shimmering. Add shrimp and cook, stirring frequently, until shrimp starts to turn opaque, about 2 minutes. Add rice, nam prik pao, and fish sauce and stir until rice is thoroughly coated with nam prik pao. Season rice with additional fish sauce to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To serve, garnish with fried lemongrass and slices of cucumber and lime wedges alongside.",
      "secondary_message": null
    }
  ],
