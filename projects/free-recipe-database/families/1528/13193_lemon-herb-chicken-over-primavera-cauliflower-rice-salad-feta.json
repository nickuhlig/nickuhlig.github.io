  "instructions": [
    {
      "id": 237069,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium heads cauliflower\n2 medium zucchini squash\n1 small bunch asparagus\n1 lemon\n1 small bunch Italian (flat-leaf) parsley\n1 small pkg chives"
    },
    {
      "id": 237070,
      "primary_message": "Cut the cauliflower heads into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 237071,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237072,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add cauliflower, salt, and pepper; sauté, stirring occasionally, until cauliflower is lightly golden and cooked through, 5-7 minutes. Remove from heat and set aside.",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 237073,
      "primary_message": "Meanwhile, trim and small dice zucchini. Snap or cut off woody ends of the asparagus and cut into 1-inch pieces. Transfer both to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 237074,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237075,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 237076,
      "primary_message": "Meanwhile, zest lemon into a medium bowl, then set lemon aside for later use.",
      "secondary_message": null
    },
    {
      "id": 237077,
      "primary_message": "Add peas to the skillet. Continue to cook, stirring occasionally, until peas are warm and veggies are tender-crisp, 2 minutes more. Return veggies to the bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 237078,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Chop chives into small pieces. Add both to the bowl with the lemon zest.",
      "secondary_message": null
    },
    {
      "id": 237079,
      "primary_message": "Peel and mince garlic; add to the bowl and stir to combine the herb mix. Set aside.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 237080,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237081,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels, then cut into bite-sized pieces.",
      "secondary_message": "0.68 kg chicken breasts, boneless skinless"
    },
    {
      "id": 237082,
      "primary_message": "Once the skillet is hot, add more butter and swirl to coat the bottom. Add chicken, half of the herb mix (reserving the rest for the rice), salt, and pepper. Sauté, stirring occasionally, until chicken is cooked through, 5-7 minutes. Remove from heat.",
      "secondary_message": "4 tsp butter, unsalted\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 237083,
      "primary_message": "Meanwhile, transfer cooked cauliflower rice and remaining herb mix to the bowl with the veggies. Juice lemon into the bowl and stir to combine the cauliflower rice salad.",
      "secondary_message": null
    },
    {
      "id": 237084,
      "primary_message": "To serve, divide warm cauliflower rice salad and chicken between plates or bowls. Sprinkle with feta and enjoy! ",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
