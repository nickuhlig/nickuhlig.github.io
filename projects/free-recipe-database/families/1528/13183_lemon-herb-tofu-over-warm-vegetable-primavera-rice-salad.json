  "instructions": [
    {
      "id": 236912,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 236913,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth\n⅛ tsp salt"
    },
    {
      "id": 236914,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 236915,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n½ small bunch asparagus\n½ lemon\n½ small bunch Italian (flat-leaf) parsley\n½ small pkg chives"
    },
    {
      "id": 236916,
      "primary_message": "Trim and small dice zucchini. Snap or cut off woody ends of the asparagus and cut into 1-inch pieces. Transfer both to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 236917,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 236918,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, salt, and pepper; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 236919,
      "primary_message": "Meanwhile, zest lemon into a small bowl, then set lemon aside for later use.",
      "secondary_message": null
    },
    {
      "id": 236920,
      "primary_message": "Add peas to the skillet. Continue to cook, stirring occasionally, until peas are warm and veggies are tender-crisp, 2 minutes more. Return veggies to the bowl and set aside. (Reserve skillet for later use.)",
      "secondary_message": "1 cup frozen peas"
    },
    {
      "id": 236921,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Chop chives into small pieces. Add both to the bowl with the lemon zest.",
      "secondary_message": null
    },
    {
      "id": 236922,
      "primary_message": "Peel and mince garlic; add to the bowl along with salt, and stir to combine the herb mix. Set aside.",
      "secondary_message": "2 cloves garlic\n1 pinch salt"
    },
    {
      "id": 236923,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 236924,
      "primary_message": "While the skillet heats up, medium dice tofu.",
      "secondary_message": null
    },
    {
      "id": 236925,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add tofu, half of the herb mix (reserving the rest for the rice salad), soy sauce, salt, and pepper. Pan-fry, stirring occasionally, until tofu is slightly crispy and golden, 7-8 minutes. Remove from heat.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tsp soy sauce\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 236926,
      "primary_message": "Meanwhile, transfer cooked rice and remaining herb mix to the bowl with the veggies. Juice lemon into the bowl, drizzle with oil, and stir to combine the rice salad.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 236927,
      "primary_message": "To serve, divide warm rice salad and tofu between plates or bowls. Enjoy! ",
      "secondary_message": null
    }
  ],
