  "instructions": [
    {
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "In a medium bowl, prepare marinade by whisking together oil, Italian seasoning, salt, and pepper.",
      "secondary_message": "extra virgin olive oil\n⅜ tsp Italian seasoning\nsalt\nblack pepper"
    },
    {
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Add to bowl with marinade and toss to coat.",
      "secondary_message": "680 g chicken breasts, boneless skinless"
    },
    {
      "primary_message": "Coat grill or bottom of skillet with oil. Add chicken and cook until browned and cooked through, 2-3 minutes per side.",
      "secondary_message": "3 tbsp virgin coconut oil"
    },
    {
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and slice tomatoes into rounds. Halve and pit avocados; thinly slice ½ (save the rest for the salad) while still in skin and scoop out.",
      "secondary_message": "3 tomatoes\n3 avocados"
    },
    {
      "primary_message": "Slice mozzarella into rounds.",
      "secondary_message": "1 ½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "primary_message": "Place buns or rolls, cut side up, on a sheet pan. Top the bottom halves with avocado slices, chicken, tomato slices, and mozzarella. Leave the top halves as is so they get crusty.",
      "secondary_message": "6 gluten-free buns or rolls"
    },
    {
      "primary_message": "Place in the oven and broil until cheese melts, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince garlic. In a large bowl, prepare dressing by combining garlic, oil, vinegar, salt, pepper, and remaining avocado. Mash together until smooth.",
      "secondary_message": "3 cloves garlic\nextra virgin olive oil\n3 tsp red wine vinegar\nsalt\nblack pepper"
    },
    {
      "primary_message": "Wash and dry spinach. Add to bowl with dressing and toss to coat.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "primary_message": "To serve, place sandwiches on a plate and have with spinach salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
