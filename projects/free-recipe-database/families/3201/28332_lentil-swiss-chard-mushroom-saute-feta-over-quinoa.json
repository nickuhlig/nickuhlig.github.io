  "instructions": [
    {
      "id": 472499,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n710 ml chicken or vegetable broth"
    },
    {
      "id": 472500,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces, keeping them separate. Place leaves in a medium bowl and set aside.",
      "secondary_message": "1 ½ bunches Swiss chard"
    },
    {
      "id": 472501,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 472502,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chard stems, mushrooms, and spices. Cook, stirring often, until veggies are tender, 5-6 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 (227g ) pkgs sliced white mushrooms\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 472503,
      "primary_message": "Meanwhile, drain and rinse lentils.",
      "secondary_message": "3 (255 g) cans lentils"
    },
    {
      "id": 472504,
      "primary_message": "When the veggies are tender, add lentils to the pot and continue to cook until warmed through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 472505,
      "primary_message": "Add chard leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Add vinaigrette and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "½ cup French vinaigrette"
    },
    {
      "id": 472506,
      "primary_message": "To serve, divide quinoa and lentil sauté between plates or bowls, then crumble goat cheese over top. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    }
  ],
