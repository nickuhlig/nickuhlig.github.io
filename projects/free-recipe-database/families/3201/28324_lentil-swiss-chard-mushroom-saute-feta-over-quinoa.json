  "instructions": [
    {
      "id": 472435,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 472436,
      "primary_message": "Meanwhile, wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves and stems into bite-sized pieces, keeping them separate. Place leaves in a small bowl and set aside.",
      "secondary_message": "½ bunch Swiss chard"
    },
    {
      "id": 472437,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 472438,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, mushrooms, and spices. Cook, stirring often, until veggies are tender, about 5 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 (8 oz) pkg sliced white mushrooms\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 472439,
      "primary_message": "Meanwhile, drain and rinse lentils.",
      "secondary_message": "1 (15 oz) can lentils"
    },
    {
      "id": 472440,
      "primary_message": "When the veggies are tender, add lentils to the skillet and continue to cook until warmed through, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 472441,
      "primary_message": "Add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. Add vinaigrette and stir to combine. Remove from heat and cover to keep warm.",
      "secondary_message": "3 tbsp French vinaigrette"
    },
    {
      "id": 472442,
      "primary_message": "To serve, divide quinoa and lentil sauté between plates or bowls, then crumble goat cheese over top. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
