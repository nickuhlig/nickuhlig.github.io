  "instructions": [
    {
      "id": 137255,
      "primary_message": "Peel and mince the onion. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 137256,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 137257,
      "primary_message": "Peel and mince the garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 137258,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 137259,
      "primary_message": "Add the onion and garlic to the saucepan; cook, stirring frequently, until slightly softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 137260,
      "primary_message": "Drain and rinse the beans in a colander; add to the saucepan with the onion. Stir to combine.",
      "secondary_message": "½ (398 ml) can black beans"
    },
    {
      "id": 137261,
      "primary_message": "Add the ketchup, vinegar, soy sauce, Dijon, brown sugar, and spices to the saucepan. Reduce heat to low and simmer, stirring occasionally, while you make the slaw.",
      "secondary_message": "¼ cup ketchup\n1 ½ tbsp apple cider vinegar\n1 ½ tsp soy sauce\n½ tsp Dijon mustard\n1 tbsp brown sugar\n¼ tsp paprika\n¼ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 137262,
      "primary_message": "In a large bowl, whisk together the mayonnaise, vinegar, Dijon, maple syrup, and onion powder. Set aside. ",
      "secondary_message": "¼ cup vegan mayonnaise\n1 tbsp apple cider vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp pure maple syrup\n½ tsp onion powder"
    },
    {
      "id": 137263,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n1 medium carrot\n½ small bunch green onions (scallions)"
    },
    {
      "id": 137264,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 137265,
      "primary_message": "Trim and peel the carrot, then julienne or coarsely grate. Add to the bowl with the cabbage.",
      "secondary_message": null
    },
    {
      "id": 137266,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions into ¼-inch pieces and add to the bowl with the cabbage. Stir to combine the veggies with the dressing and set aside. ",
      "secondary_message": null
    },
    {
      "id": 137267,
      "primary_message": "Toast the buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 137268,
      "primary_message": "To serve, place the bottom half of a bun on each plate. Top with bean mixture and some of the slaw; close with top half of the bun. Serve with remaining slaw on the side. Enjoy!",
      "secondary_message": null
    }
  ],
