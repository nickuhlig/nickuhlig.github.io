  "instructions": [
    {
      "id": 29797,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 eggplants\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 29798,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 29799,
      "primary_message": "While the skillet warms up, peel and small dice the onion into ¼-inch pieces; transfer to a small bowl.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 29800,
      "primary_message": "Add the ground beef to the skillet; cook, breaking apart with a spoon, until crumbly and browned, 2 to 4 minutes. Once done, transfer the beef to a bowl and leave the juices in the skillet.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 29801,
      "primary_message": "While the beef cooks, peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 29802,
      "primary_message": "Preheat the oven to broil and position the rack about 6 inches from the top.",
      "secondary_message": null
    },
    {
      "id": 29803,
      "primary_message": "Once the beef has been transferred, add olive oil and the onion to the skillet; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 29804,
      "primary_message": "While the onion cooks, trim and discard the ends of the eggplants; medium dice the eggplants into ½-inch cubes and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 29805,
      "primary_message": "Add the garlic, eggplant, and diced tomatoes to the skillet; season with cinnamon, salt, and pepper. Cook, stirring occasionally, until the eggplant is tender, 8 to 10 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n2 tsp cinnamon\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 29806,
      "primary_message": "While the eggplant cooks, in a small saucepan, melt the butter over medium heat.",
      "secondary_message": "4 tbsp butter, unsalted"
    },
    {
      "id": 29807,
      "primary_message": "While the butter melts, grate ¼ cup of Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 29808,
      "primary_message": "Sprinkle in the flour over the melted butter and whisk until the mixture is smooth, 15 to 30 seconds.",
      "secondary_message": "4 tbsp all-purpose flour"
    },
    {
      "id": 29809,
      "primary_message": "Slowly pour the milk into the saucepan, whisking constantly. Cook the sauce, whisking constantly, until thickened, 1 to 2 minutes.",
      "secondary_message": "16 fl oz (2 cups) whole milk"
    },
    {
      "id": 29810,
      "primary_message": "Add the Parmesan to the sauce and season with salt and pepper; stir and remove from the heat.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 29811,
      "primary_message": "Shave the parsley leaves off the stems; discard the stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 29812,
      "primary_message": "Return the ground beef to the skillet and stir in ¾ of the parsley (save the rest for garnishing).",
      "secondary_message": null
    },
    {
      "id": 29813,
      "primary_message": "Drizzle the béchamel sauce over the top of the beef and eggplant mixture.",
      "secondary_message": ""
    },
    {
      "id": 29814,
      "primary_message": "Place the skillet in the oven and broil until the dish is browned on top, 1 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 29815,
      "primary_message": "To serve, spoon the moussaka into a bowl and sprinkle with the remaining parsley. Enjoy!",
      "secondary_message": null
    }
  ],
