  "instructions": [
    {
      "id": 401535,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 401536,
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Transfer to a baking dish.",
      "secondary_message": "1 medium zucchini squash"
    },
    {
      "id": 401537,
      "primary_message": "Wash, dry, trim, and seed bell pepper; large dice. Add to the dish with the zucchini.",
      "secondary_message": "1 orange bell pepper"
    },
    {
      "id": 401538,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the dish along with oil, salt, and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 401539,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake until veggies start to soften and chicken is partly cooked through, 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 401540,
      "primary_message": "After 10 minutes of baking, remove dish from the oven. Add barbecue sauce, stir to combine, and return baking dish to the oven. Continue to bake until veggies are fork-tender and chicken is cooked through, 6-7 minutes more. Remove from oven.",
      "secondary_message": "½ cup barbecue sauce"
    },
    {
      "id": 401541,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 401542,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add riced cauliflower and spices; cook, stirring occasionally, until tender, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 (340 g) bag frozen, riced cauliflower\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 401543,
      "primary_message": "To serve, divide cauliflower rice and BBQ chicken bake between plates. Enjoy!",
      "secondary_message": null
    }
  ],
