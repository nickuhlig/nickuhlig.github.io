  "instructions": [
    {
      "id": 401553,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 401554,
      "primary_message": "Wash, dry, trim, and halve zucchini lengthwise, then slice crosswise into ¼-inch thick half-moons. Divide between two large baking dishes.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 401555,
      "primary_message": "Wash, dry, trim, and seed bell peppers; large dice. Add to the dishes with the zucchini.",
      "secondary_message": "3 orange bell peppers"
    },
    {
      "id": 401556,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the dishes along with oil, salt, and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401557,
      "primary_message": "Place baking dishes in the oven (it doesn't have to be fully heated) and bake until veggies start to soften and chicken is partly cooked through, 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 401558,
      "primary_message": "After 10 minutes of baking, remove dishes from the oven. Add barbecue sauce, stir to combine, and return baking dishes to the oven. Continue to bake until veggies are fork-tender and chicken is cooked through, 8-10 minutes more. Remove from oven.",
      "secondary_message": "1 ½ cup barbecue sauce"
    },
    {
      "id": 401559,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 401560,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add riced cauliflower and spices; cook, stirring occasionally, until tender, 6-7 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 (340 g) bags frozen, riced cauliflower\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 401561,
      "primary_message": "To serve, divide cauliflower rice and BBQ chicken bake between plates. Enjoy!",
      "secondary_message": null
    }
  ],
