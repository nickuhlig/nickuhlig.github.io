  "instructions": [
    {
      "id": 400082,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "15 oz flat rice (pad thai) noodles"
    },
    {
      "id": 400083,
      "primary_message": "Meanwhile, wash, dry, and cut off skin from each pineapple; quarter, core, and medium dice the flesh. Place in a large bowl.",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 400084,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Add to the bowl with the pineapple.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 400085,
      "primary_message": "Peel, halve, and medium dice onions. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 400086,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400087,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add pineapple, shrimp, onion, garlic, shredded cabbage, and salt. Stir-fry until the pineapple is tender and shrimp are cooked through, 6-7 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil\n1 ½ (14 oz) bags shredded cabbage (coleslaw mix)\n¾ tsp salt"
    },
    {
      "id": 400088,
      "primary_message": "When the shrimp are done, add noodles, hoisin sauce, and water to the pot. Continue to cook, stirring occasionally, until warmed through, about 3 minutes. Remove from heat.",
      "secondary_message": "½ cup hoisin sauce\n½ cup water"
    },
    {
      "id": 400089,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
