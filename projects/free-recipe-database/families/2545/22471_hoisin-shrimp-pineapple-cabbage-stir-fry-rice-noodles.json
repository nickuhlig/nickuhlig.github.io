  "instructions": [
    {
      "id": 400090,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Remove from heat, uncover, and add rice noodles. Soak for 10 minutes or according to package directions. Drain in a colander and rinse under cold water.",
      "secondary_message": "142 g flat rice (pad thai) noodles"
    },
    {
      "id": 400091,
      "primary_message": "Meanwhile, wash, dry, and cut off skin from pineapple; quarter, core, and medium dice the flesh. Place in a medium bowl.",
      "secondary_message": "½ small pineapple"
    },
    {
      "id": 400092,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Add to the bowl with the pineapple.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 400093,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 400094,
      "primary_message": "While the skillet heats up, peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 400095,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add pineapple, shrimp, onion, garlic, shredded cabbage, and salt. Stir-fry until the pineapple is tender and shrimp are cooked through, 4-5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\n½ (397 g) bag shredded cabbage (coleslaw mix)\n¼ tsp salt"
    },
    {
      "id": 400096,
      "primary_message": "When the shrimp are done, add noodles, hoisin sauce, and water to the skillet. Continue to cook, stirring occasionally, until warmed through, 1-2 minutes more. Remove from heat.",
      "secondary_message": "3 tbsp hoisin sauce\n3 tbsp water"
    },
    {
      "id": 400097,
      "primary_message": "To serve, divide stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
