  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer veggies to a large baking sheet pan; drizzle with dressing, then season with salt and pepper. Stir to coat the veggies and spread out in an even layer. Nestle sausages into the veggies. Place baking sheet in the preheated oven and bake until veggies are tender and sausages are cooked through, 18-20 minutes.",
      "secondary_message": "1 (454 g) pkg frozen mixed vegetables (carrots, corn, green beans, peas)\n⅓ cup ranch dressing\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Remove sausage and veggies from the oven, then sprinkle cheese over top. Return baking sheet to the oven and continue to bake until cheese is melted and bubbly, 3-4 minutes. Remove from oven.",
      "secondary_message": "½ cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "¼ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "To serve, divide cheesy sausage and veggie bake between plates or bowls. Sprinkle with parsley and enjoy!",
      "secondary_message": null
    }
  ],
