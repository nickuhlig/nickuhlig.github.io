  "instructions": [
    {
      "id": 1,
      "primary_message": "Remove ham from packaging, wash, and pat dry with paper towels. Allow to come to room temperature while preparing the smoker.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fire up your smoker to 225°F. Add 4 to 5 medium chunks of smoke wood. When the smoker is at temperature and the wood is burning and producing smoke, place the ham in the smoker.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While the ham is smoking, mix the rest of the ingredients into a thick paste in a medium bowl to form the glaze, set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Cook ham to desired temperature, about 4-5 hours for a ten-pound ham to reach 120 degrees. Brush on the glaze during the last hour of cooking. Remove from the smoker, slice, and serve.",
      "secondary_message": null
    }
  ],
