  "instructions": [
    {
      "id": 1,
      "primary_message": "Cut the apple into quarters, leaving the peel intact. With a paring knife, remove the core from two of the quarters and slice them as thinly as possible. (Save the remaining two quarters for a snack.) Place the slices in a bowl, squeeze lemon juice over them, and toss to coat to prevent discoloration.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a small bowl, combine the vinegar and honey. Whisking constantly, slowly drizzle in the olive oil. Season dressing to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When ready to serve, toss the arugula and the apples with just enough dressing to coat the leaves. Divide the salad among four plates. Sprinkle each salad with pomegranate seeds, sliced almonds and crumbled goat cheese.",
      "secondary_message": null
    }
  ],
