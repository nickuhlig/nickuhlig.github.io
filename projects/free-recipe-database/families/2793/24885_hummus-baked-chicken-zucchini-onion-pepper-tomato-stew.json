  "instructions": [
    {
      "id": 400674,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 400675,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Transfer to the baking sheet.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 400676,
      "primary_message": "Season chicken with salt and pepper on both sides. Spread ¼-cup hummus over the top of each fillet, then drizzle with more oil.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper\n1 ½ cups hummus\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 400677,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until chicken is cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400678,
      "primary_message": "Meanwhile, wash and dry zucchini. Using a clean cutting board, trim and medium dice the zucchini; place in a large bowl. ",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 400679,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 400680,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onions. Add to the bowl with the zucchini. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 400681,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add zucchini and onion; cook, stirring occasionally, until starting to soften, 3-4 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 400682,
      "primary_message": "Meanwhile, drain and roughly chop roasted peppers. ",
      "secondary_message": "3 (340 g) jars roasted red bell peppers"
    },
    {
      "id": 400683,
      "primary_message": "Add roasted peppers, marinara sauce, and spices to the pot; stir to combine the stew and bring to a simmer. Once simmering, reduce heat to low, cover, and cook until veggies are tender, 6-7 minutes. Remove from heat.",
      "secondary_message": "1 ½ (680 g) jars marinara sauce\n1 tbsp oregano, dried\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 400684,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 400685,
      "primary_message": "To serve, divide veggie stew between plates or bowls; top with chicken. Enjoy! ",
      "secondary_message": null
    }
  ],
