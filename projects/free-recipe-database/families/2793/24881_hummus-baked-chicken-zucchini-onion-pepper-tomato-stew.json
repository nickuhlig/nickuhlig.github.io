  "instructions": [
    {
      "id": 400626,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 400627,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Transfer to the baking sheet.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 400628,
      "primary_message": "Season chicken with salt and pepper on both sides. Spread ¼-cup hummus over the top of each fillet, then drizzle with more oil.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper\n1 cup hummus\n4 tsp extra virgin olive oil"
    },
    {
      "id": 400629,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until chicken is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400630,
      "primary_message": "Meanwhile, wash and dry zucchini. Using a clean cutting board, trim and medium dice the zucchini; place in a medium bowl. ",
      "secondary_message": "4 medium zucchini squash"
    },
    {
      "id": 400631,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 400632,
      "primary_message": "While the pot heats up, peel, halve, and medium dice onion. Add to the bowl with the zucchini. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 400633,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add zucchini and onion; cook, stirring occasionally, until starting to soften, 2-3 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 400634,
      "primary_message": "Meanwhile, drain and roughly chop roasted peppers. ",
      "secondary_message": "2 (12 oz) jars roasted red bell peppers"
    },
    {
      "id": 400635,
      "primary_message": "Add roasted peppers, marinara sauce, and spices to the pot; stir to combine the stew and bring to a simmer. Once simmering, reduce heat to low, cover, and cook until veggies are tender, about 5 minutes. Remove from heat.",
      "secondary_message": "1 (24 oz) jar marinara sauce\n2 tsp oregano, dried\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 400636,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 400637,
      "primary_message": "To serve, divide veggie stew between plates or bowls; top with chicken. Enjoy! ",
      "secondary_message": null
    }
  ],
