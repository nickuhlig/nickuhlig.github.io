  "instructions": [
    {
      "id": 185556,
      "primary_message": "Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. ",
      "secondary_message": "2 tsp salt\n10 oz linguine pasta"
    },
    {
      "id": 185557,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 185558,
      "primary_message": "While the skillet heats up, slice sausages into ½-inch thick rounds, at an angle.",
      "secondary_message": "4 pre-cooked vegan sausage"
    },
    {
      "id": 185559,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sausages and cook, stirring occasionally, until nicely browned, 2-3 minutes (or cook according to package instructions). Remove to a plate and set aside.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 185560,
      "primary_message": "Meanwhile, peel and mince the garlic. Set aside.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 185561,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 185562,
      "primary_message": "Wash and dry the arugula. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg baby arugula"
    },
    {
      "id": 185563,
      "primary_message": "Drain pasta in a colander, reserving 2 cups of the cooking liquid. ",
      "secondary_message": null
    },
    {
      "id": 185564,
      "primary_message": "Return skillet to the stove and reduce the heat to medium. Add more butter and swirl to coat the bottom.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 185565,
      "primary_message": "Add garlic, reserved cooking liquid, peas, and spices to the skillet. Simmer, stirring frequently, until sauce thickens, 3-4 minutes. ",
      "secondary_message": "1 cup frozen peas\n1 tsp black pepper\n½ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 185566,
      "primary_message": "Stirring frequently, add arugula to the skillet in handfuls, waiting for the arugula to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 185567,
      "primary_message": "Add pasta to the skillet and toss to coat. Reduce heat to low, add Parmesan (reserving a small amount for garnish), and toss with tongs until melted and saucy.",
      "secondary_message": null
    },
    {
      "id": 185568,
      "primary_message": "Add sausage to the pasta and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 185569,
      "primary_message": "To serve, divide pasta between bowls or plates, sprinkle with reserved Parmesan, and enjoy! ",
      "secondary_message": null
    }
  ],
