  "instructions": [
    {
      "id": 185570,
      "primary_message": "Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. ",
      "secondary_message": "1 tbsp salt\n15 oz linguine pasta"
    },
    {
      "id": 185571,
      "primary_message": "Slice sausages into ½-inch thick rounds, at an angle.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 185572,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 185573,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add sausages and cook, stirring occasionally, until nicely browned, 3-4 minutes (or cook according to package instructions). Remove from heat and set aside.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 185574,
      "primary_message": "Meanwhile, peel and mince the garlic. Set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 185575,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 185576,
      "primary_message": "Wash and dry the arugula. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 185577,
      "primary_message": "Drain pasta in a colander, reserving 3 cups of the cooking liquid. ",
      "secondary_message": null
    },
    {
      "id": 185578,
      "primary_message": "Return the large pot to the stove and reduce the heat to medium. Add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 185579,
      "primary_message": "Add garlic, reserved cooking liquid, peas, and spices to the pot. Simmer, stirring frequently, until sauce thickens, 4-5 minutes. ",
      "secondary_message": "1 ½ cups frozen peas\n1 ½ tsp black pepper\n¾ tsp salt\n3 pinch crushed red pepper"
    },
    {
      "id": 185580,
      "primary_message": "Stirring frequently, add arugula to the pot in handfuls, waiting for the arugula to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 185581,
      "primary_message": "Return pasta to the pot and toss to coat. Reduce heat to low, add Parmesan (reserving a small amount for garnish), and toss with tongs until melted and saucy.",
      "secondary_message": null
    },
    {
      "id": 185582,
      "primary_message": "Add sausage to the pasta and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 185583,
      "primary_message": "To serve, divide pasta between bowls or plates, sprinkle with reserved Parmesan, and enjoy! ",
      "secondary_message": null
    }
  ],
