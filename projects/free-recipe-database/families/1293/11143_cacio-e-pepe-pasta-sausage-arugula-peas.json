  "instructions": [
    {
      "id": 185668,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. ",
      "secondary_message": "1 tsp salt\n142 g linguine pasta"
    },
    {
      "id": 185669,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 185670,
      "primary_message": "Use the tip of a knife to slice down the length of each sausage. Peel off the casings and discard.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 185671,
      "primary_message": "Add pork to the skillet and, breaking apart with a spoon, cook until browned and slightly crispy, 6-7 minutes. Using a slotted spoon, transfer sausage to a plate (reserving juices in the skillet) and set aside.",
      "secondary_message": null
    },
    {
      "id": 185672,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Set aside. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 185673,
      "primary_message": "Finely grate Parmesan and set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 185674,
      "primary_message": "Wash and dry the arugula. (Skip this step if it came pre-washed.)",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 185675,
      "primary_message": "Drain pasta in a colander, reserving 1 cup of the cooking liquid. ",
      "secondary_message": null
    },
    {
      "id": 185676,
      "primary_message": "Return skillet to the stove and reduce the heat to medium. Add butter and swirl to coat the bottom.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 185677,
      "primary_message": "Add garlic, reserved cooking liquid, peas, and spices to the skillet. Simmer, stirring frequently, until sauce thickens, 2-3 minutes. ",
      "secondary_message": "½ cup frozen peas\n½ tsp black pepper\n¼ tsp salt\n1 pinch crushed red pepper"
    },
    {
      "id": 185678,
      "primary_message": "Stirring frequently, add arugula to the skillet in handfuls, waiting for the arugula to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 185679,
      "primary_message": "Add pasta to the skillet and toss to coat. Reduce heat to low, add Parmesan (reserving a small amount for garnish), and toss with tongs until melted and saucy.",
      "secondary_message": null
    },
    {
      "id": 185680,
      "primary_message": "Add sausage and toss to combine. ",
      "secondary_message": null
    },
    {
      "id": 185681,
      "primary_message": "To serve, divide pasta between bowls or plates, sprinkle with reserved Parmesan, and enjoy! ",
      "secondary_message": null
    }
  ],
