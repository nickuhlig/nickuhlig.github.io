  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Roughly chop the yellow onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 1,
      "primary_message": "In a blender, combine kimchi and its juices, onion, garlic, and ginger, and blend until a smooth puree forms (add a bit of water, if necessary, to help the blending process).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a medium sauce pan, combine kimchi puree with ketchup, rice vinegar, gochujang, Worcestershire sauce, and molasses, and cook, stirring occasionally, until sauce has thickened slightly and flavors have combined, about 10 minutes. Season with salt and pepper and serve.",
      "secondary_message": null
    }
