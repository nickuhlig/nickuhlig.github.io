  "instructions": [
    {
      "id": 412422,
      "primary_message": "In a medium saucepan, combine quinoa, water, and salt; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 412423,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ (16 oz) pkg strawberries\n1 ½ English cucumbers\n3 peaches\n1 small pkg fresh mint"
    },
    {
      "id": 412424,
      "primary_message": "Zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 412425,
      "primary_message": "Peel and mince shallots. Add to the bowl with the lemon along with oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n⅓ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 412426,
      "primary_message": "Trim and slice strawberries lengthwise into ¼-inch thick pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 412427,
      "primary_message": "Trim and medium dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 412428,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 412429,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 412430,
      "primary_message": "Roughly chop pistachios and add to the bowl.",
      "secondary_message": "1 cup pistachios, unsalted"
    },
    {
      "id": 412431,
      "primary_message": "Crumble goat cheese into the bowl and set aside.",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    },
    {
      "id": 412432,
      "primary_message": "When the quinoa is done, transfer to a large baking sheet pan. Spread out in an even layer and let cool for 5 minutes. Once cool, add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 412433,
      "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
