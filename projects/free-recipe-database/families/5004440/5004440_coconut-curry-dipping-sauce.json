  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine coconut milk and curry paste in a small saucepan over medium heat and bring to a simmer. Cook, stirring, until slightly thickened and fragrant, about 30 seconds. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, combine lime juice, soy sauce, fish sauce, honey, and ginger in a small bowl. Add coconut-curry mixture and stir thoroughly to combine. Serve.",
      "secondary_message": null
    }
  ],
