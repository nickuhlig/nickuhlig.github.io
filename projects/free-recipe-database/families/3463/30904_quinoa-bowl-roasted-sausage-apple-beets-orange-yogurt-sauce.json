  "instructions": [
    {
      "id": 489785,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 489786,
      "primary_message": "In a small saucepan, combine broth and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ cup quinoa"
    },
    {
      "id": 489787,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 Gala apples\n2 medium beets\n½ orange"
    },
    {
      "id": 489788,
      "primary_message": "Quarter, core, and medium dice apples. Transfer to one half of a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 489789,
      "primary_message": "Peel, trim, and small dice beets; add to the other half of the baking sheet. Drizzle apples and beets with oil, then season with spices. Stir each to combine (keeping them separate), then spread out in an even layer. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 489790,
      "primary_message": "Add sausages to the baking sheet, nestling them into the apples.",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 489791,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring apples and beets and flipping sausages halfway through, until beets are tender and sausages are cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 489792,
      "primary_message": "Meanwhile, zest and juice orange into a small bowl. Add yogurt and spices, then whisk to combine the orange-yogurt sauce. Set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n¼ tsp turmeric, ground\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder"
    },
    {
      "id": 489793,
      "primary_message": "Transfer cooked sausages to the cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 489794,
      "primary_message": "To serve, divide quinoa between bowls; top with roasted apples, beets, and sausage slices, then drizzle with orange-yogurt sauce. Enjoy!",
      "secondary_message": null
    }
  ],
