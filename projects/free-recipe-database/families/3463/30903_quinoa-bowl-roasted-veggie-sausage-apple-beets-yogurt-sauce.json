  "instructions": [
    {
      "id": 489774,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 489775,
      "primary_message": "In a medium saucepan, combine broth and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups quinoa"
    },
    {
      "id": 489776,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 Gala apples\n6 medium beets\n1 ½ oranges"
    },
    {
      "id": 489777,
      "primary_message": "Quarter, core, and medium dice apples. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 489778,
      "primary_message": "Peel, trim, and small dice beets; transfer to another baking sheet. Drizzle apples and beets with oil, then season with spices. Stir each to combine, then spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 489779,
      "primary_message": "Place the baking sheet in the oven (it doesn't have to be fully heated) and bake until apples and beets are just tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 489780,
      "primary_message": "Meanwhile, zest and juice oranges into a small bowl. Add yogurt and spices, then whisk to combine the orange-yogurt sauce. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¾ tsp turmeric, ground\n¾ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 489781,
      "primary_message": "When the apples and beets are just tender, remove baking sheets from the oven and stir. Add sausages to the baking sheet with the apples, nestling them into the apples. ",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 489782,
      "primary_message": "Return baking sheets to the oven and continue to roast until beets are fork-tender and sausages are warmed through, 5-7 minutes more (or cook sausages according to package instructions). ",
      "secondary_message": null
    },
    {
      "id": 489783,
      "primary_message": "Remove apples, beets, and sausages from the oven. Transfer sausages to the cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 489784,
      "primary_message": "To serve, divide quinoa between bowls; top with roasted apples, beets, and sausage slices, then drizzle with orange-yogurt sauce. Enjoy!",
      "secondary_message": null
    }
  ],
