  "instructions": [
    {
      "id": 489743,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 489744,
      "primary_message": "In a medium saucepan, combine broth and quinoa; bring the mixture to a boil over high heat. Once boiling, reduce heat to low, cover, and simmer until liquid is fully absorbed, about 15 minutes. Remove from heat and let stand, still covered, for 5 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ cups quinoa"
    },
    {
      "id": 489745,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 Gala apples\n6 medium beets\n1 ½ oranges"
    },
    {
      "id": 489746,
      "primary_message": "Quarter, core, and medium dice apples. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 489747,
      "primary_message": "Peel, trim, and small dice beets; transfer to another large baking sheet. Drizzle apples and beets with oil, then season with spices. Stir each to combine, then spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 489748,
      "primary_message": "Add sausages to the baking sheet with the apples, nestling them into the apples.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 489749,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring apples and beets and flipping sausages halfway through, until beets are tender and sausages are cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 489750,
      "primary_message": "Meanwhile, zest and juice oranges into a small bowl. Add yogurt and spices, then whisk to combine the orange-yogurt sauce. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¾ tsp turmeric, ground\n¾ tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 489751,
      "primary_message": "Transfer cooked sausages to the cutting board and slice crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 489752,
      "primary_message": "To serve, divide quinoa between bowls; top with roasted apples, beets, and sausage slices, then drizzle with orange-yogurt sauce. Enjoy!",
      "secondary_message": null
    }
  ],
