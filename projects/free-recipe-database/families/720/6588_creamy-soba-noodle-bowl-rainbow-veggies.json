  "instructions": [
    {
      "id": 109161,
      "primary_message": "Fill a large pot halfway with water and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 109162,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 medium carrots\n¾ small head red cabbage\n1 ½ small bunches green onions (scallions)\n3 (1 inch) pieces ginger root\n1 ½ red bell peppers"
    },
    {
      "id": 109163,
      "primary_message": "Peel and grate or mince the ginger; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 109164,
      "primary_message": "Add peanut butter, maple syrup, water, tamari, vinegar, chili-garlic sauce, and sesame oil to the bowl with the ginger. Whisk until smooth, set aside.",
      "secondary_message": "⅓ cup natural peanut butter\n3 tbsp water\n2 tbsp tamari soy sauce\n2 tbsp rice vinegar\n1 ½ tsp chili-garlic sauce\n1 ½ tsp toasted sesame oil\n3 tbsp pure maple syrup"
    },
    {
      "id": 109165,
      "primary_message": "Once water is boiling, add salt and noodles and stir for a few seconds. Cook according to package directions, 3 to 4 minutes. When cooked, drain and rinse well under cold water.",
      "secondary_message": "15 oz soba (buckwheat) noodles\n1 ½ tsp salt"
    },
    {
      "id": 109166,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ⅛-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 109167,
      "primary_message": "Cut the bell pepper lengthwise into quarters; remove and discard the seeds and white membrane. Julienne the pepper.",
      "secondary_message": null
    },
    {
      "id": 109168,
      "primary_message": "Trim and discard the ends of the cucumber; halve the cucumber lengthwise and then slice into ⅛-inch thick planks. Then, cut the planks ¼-inch wide julienne sticks.",
      "secondary_message": null
    },
    {
      "id": 109169,
      "primary_message": "Trim the stem ends of the carrots and peel; julienne or coarsely grate the carrots.",
      "secondary_message": null
    },
    {
      "id": 109170,
      "primary_message": "Trim off and discard the root end of the cabbage; halve the cabbage lengthwise, then thinly slice crosswise.",
      "secondary_message": null
    },
    {
      "id": 109171,
      "primary_message": "Roughly chop the cashews.",
      "secondary_message": "1 ½ cups cashews, roasted unsalted"
    },
    {
      "id": 109172,
      "primary_message": "Add noodles, cashews, and veggies to the bowl with the dressing and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 109173,
      "primary_message": "Divide noodles between plates, serve cold. Enjoy!",
      "secondary_message": null
    }
  ],
