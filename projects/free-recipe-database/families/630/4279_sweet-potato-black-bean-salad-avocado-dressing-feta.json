  "instructions": [
    {
      "id": 48172,
      "primary_message": "Preheat the oven to 232°C (450°F) and place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 48173,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ (142 g) pkg spring mix (mixed greens)\n0.34 kg sweet potatoes\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 48174,
      "primary_message": "Peel and medium dice the sweet potatoes into 1 ¼-cm cubes; transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 48175,
      "primary_message": "Drizzle the potatoes with olive oil and season with chili powder, cumin, salt, and pepper; toss to coat. Transfer the mixture to a sheet pan and spread out in a single layer.",
      "secondary_message": "½ tbsp extra virgin olive oil\n½ tsp chili powder\n½ tsp cumin\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 48176,
      "primary_message": "Place the potatoes in the oven and roast, tossing once halfway through cooking time, until the potatoes are tender and lightly browned, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 48177,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 48178,
      "primary_message": "Scoop out the avocado flesh and transfer to a medium bowl; mash with a fork until smooth.",
      "secondary_message": "½ avocado"
    },
    {
      "id": 48179,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Add to the bowl with the mashed avocado.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 48180,
      "primary_message": "Juice the lime and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 48181,
      "primary_message": "Add olive oil, salt, and pepper to the bowl; mix the dressing until well combined. Alternatively, use a hand blender to make a very smooth dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 48182,
      "primary_message": "Place the feta in a small bowl.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 48183,
      "primary_message": "Using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Transfer to a large salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 48184,
      "primary_message": "Add the sweet potatoes and beans to the salad bowl; toss to combine.",
      "secondary_message": null
    },
    {
      "id": 48185,
      "primary_message": "To serve, divide the mixed greens between dishes, top with the salad and feta, and drizzle with the dressing. Mix together and enjoy!",
      "secondary_message": ""
    }
  ],
