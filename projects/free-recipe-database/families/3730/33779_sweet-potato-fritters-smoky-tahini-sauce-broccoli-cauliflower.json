  "instructions": [
    {
      "id": 625046,
      "primary_message": "Preheat oven to 450°F. ",
      "secondary_message": null
    },
    {
      "id": 625047,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n2 crowns broccoli\n1 medium head cauliflower\n1 lemon\n2 (1 inch) pieces ginger root\n1 small bunch fresh dill"
    },
    {
      "id": 625048,
      "primary_message": "Peel and coarsely grate sweet potatoes. Transfer to a colander and sprinkle with salt. Place the colander in a bowl to catch the excess moisture and set aside.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 625049,
      "primary_message": "Separate broccoli and cauliflower into bite-sized florets; cut stems into smaller pieces. Transfer both to a large baking sheet pan, drizzle with oil, and season with salt; toss to combine and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 625050,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the veggies are fork-tender, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 625051,
      "primary_message": "Meanwhile, juice lemon into a small bowl. Add tahini, water, maple syrup, and spices, then whisk to combine the tahini sauce and set aside.",
      "secondary_message": "½ cup tahini\n2 tbsp water\n4 tsp pure maple syrup\n½ tsp chili powder\n½ tsp smoked paprika\n½ tsp salt"
    },
    {
      "id": 625052,
      "primary_message": "Using paper towels or a clean cloth, squeeze excess moisture from the grated sweet potato, then place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 625053,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the sweet potato along with eggs, flour, soy sauce, and spices. Using your hands, mix well to combine the batter.",
      "secondary_message": "2 cloves garlic\n2 eggs\n¼ cup all-purpose flour\n2 tsp soy sauce\n1 tsp chili powder\n1 tsp salt\n½ tsp black pepper\n½ tsp cumin, ground"
    },
    {
      "id": 625054,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 625055,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 625056,
      "primary_message": "Working in batches, use a scant ¼-cup measure to drop batter into the skillet, spacing scoops a few inches apart; flatten slightly with the back of a spoon. Cook, flipping once, until fritters are golden brown and cooked through, 6-8 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": null
    },
    {
      "id": 625057,
      "primary_message": "Meanwhile, shave dill leaves off the stems; discard stems and roughly chop the leaves. Place in a large bowl (reserving a small handful for serving) along with half of the tahini sauce. (Reserve remaining tahini sauce for serving.)",
      "secondary_message": null
    },
    {
      "id": 625058,
      "primary_message": "When the veggies are done, remove from the oven. Add to the bowl with the dill and tahini sauce along with raisins and pumpkin seeds. Stir to combine.",
      "secondary_message": "¼ cup raisins\n¼ cup pumpkin seeds"
    },
    {
      "id": 625059,
      "primary_message": "To serve, divide broccoli, cauliflower, and fritters between plates or bowls. Drizzle fritters with remaining tahini sauce, sprinkle with reserved dill, and enjoy!",
      "secondary_message": null
    }
  ],
