  "instructions": [
    {
      "id": 348708,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb new potatoes\n½ lemon\n1 orange\n½ small bunch Italian (flat-leaf) parsley\n1 avocado\n1 head butter (Boston) lettuce"
    },
    {
      "id": 348709,
      "primary_message": "Quarter potatoes and place in a small saucepan; cover with hot water (from the tap) and bring to a boil over high heat. Once boiling, reduce heat to medium and cook until fork-tender, 8-10 minutes. Drain and rinse with cold water to cool, then set aside.",
      "secondary_message": null
    },
    {
      "id": 348710,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 348711,
      "primary_message": "Zest and juice lemon into a medium bowl; add mayo, oil, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp vegan mayonnaise\n2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 348712,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 348713,
      "primary_message": "Peel orange, separate into segments, and roughly chop the flesh; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348714,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348715,
      "primary_message": "Roughly chop olives and add to the bowl.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 348716,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348717,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl along with the potatoes and beans, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 348718,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
