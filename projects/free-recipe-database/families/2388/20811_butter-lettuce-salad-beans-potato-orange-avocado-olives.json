  "instructions": [
    {
      "id": 348796,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n1 ½ lemons\n3 oranges\n1 small bunch Italian (flat-leaf) parsley\n3 avocados\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 348797,
      "primary_message": "Quarter potatoes and place in a medium saucepan; cover with hot water (from the tap) and bring to a boil over high heat. Once boiling, reduce heat to medium and cook until fork-tender, 8-10 minutes. Drain and rinse with cold water to cool, then set aside.",
      "secondary_message": null
    },
    {
      "id": 348798,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 348799,
      "primary_message": "Zest and juice lemons into a large bowl; add mayo, oil, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 348800,
      "primary_message": "Peel, halve, and slice shallots into thin half-moons; add to the bowl with the dressing and toss to coat.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 348801,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348802,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348803,
      "primary_message": "Roughly chop olives and add to the bowl.",
      "secondary_message": "1 cup Kalamata olives, pitted"
    },
    {
      "id": 348804,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 348805,
      "primary_message": "Chop or tear lettuce into bite-sized pieces; add to the bowl along with the potatoes and beans, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 348806,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
