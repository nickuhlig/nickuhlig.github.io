  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Slice the button mushrooms. Pick the thyme leaves from the stems. Slice the scallions.",
      "secondary_message": "0.45 kg button mushrooms\n2 tsp fresh thyme leaves\nScallions"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat to 220°C (425°F). Melt the butter in a medium non-stick skillet over medium high heat. Add the mushrooms and cook, stirring often, until the mushrooms release their liquid, the liquid evaporates, and the mushrooms begin to brown, about 10 minutes. Add the shallots and thyme and cook, stirring, until shallots are just beginning to brown, about 3 minutes longer. Add the stock and the Marmite, stirring so that Marmite dissolves into the sauce, then bring to a simmer and cook until the stock has reduced to a saucelike consistency, about 10 minutes. Season to taste with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Divide the mushrooms between the ramekins, using a spoon to make a well in the center. Break an egg into each well, then place ramekins on a baking sheet and bake until eggs have just set, about 10 minutes. Sprinkle with sliced scallions, season eggs with salt, and serve immediately with bacon and lightly dressed greens on the side.",
      "secondary_message": null
    }
  ],
