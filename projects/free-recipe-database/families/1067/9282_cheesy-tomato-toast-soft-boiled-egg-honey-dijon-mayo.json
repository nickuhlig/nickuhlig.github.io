  "instructions": [
    {
      "id": 147174,
      "primary_message": "Place eggs in a medium saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 147175,
      "primary_message": "Preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 147176,
      "primary_message": "Place mayo, Dijon, and honey in a small bowl; whisk to combine.",
      "secondary_message": "2 tbsp mayonnaise\n2 tbsp Dijon mustard\n2 tsp honey"
    },
    {
      "id": 147177,
      "primary_message": "Wash and pick leaves from basil; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 147178,
      "primary_message": "Wash and slice tomatoes.",
      "secondary_message": "4 tomatoes"
    },
    {
      "id": 147179,
      "primary_message": "Slice cheese.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 147180,
      "primary_message": "Place bread on a large baking sheet pan and spread with Dijon-mayo; add a layer of cheese. Place in the oven and broil until cheese is melted and bread is toasted, 2-4 minutes. Cook in batches if necessary.",
      "secondary_message": "8 slices whole grain bread"
    },
    {
      "id": 147181,
      "primary_message": "Meanwhile, peel and slice the eggs.",
      "secondary_message": null
    },
    {
      "id": 147182,
      "primary_message": "To serve, layer tomato and egg slices on toast; garnish with basil, salt, and pepper. Enjoy!",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    }
  ],
