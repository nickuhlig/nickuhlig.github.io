  "instructions": [
    {
      "id": 147183,
      "primary_message": "Place eggs in a large pot, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 147184,
      "primary_message": "Preheat oven to broil on high.",
      "secondary_message": null
    },
    {
      "id": 147185,
      "primary_message": "Place mayo, Dijon, and honey in a small bowl; whisk to combine.",
      "secondary_message": "3 tbsp mayonnaise\n3 tbsp Dijon mustard\n1 tbsp honey"
    },
    {
      "id": 147186,
      "primary_message": "Wash and pick leaves from basil; discard the stems and thinly slice the leaves into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 147187,
      "primary_message": "Wash and slice tomatoes.",
      "secondary_message": "6 tomatoes"
    },
    {
      "id": 147188,
      "primary_message": "Slice cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 147189,
      "primary_message": "Divide bread between two baking sheet pans and spread with Dijon-mayo; add a layer of cheese. Place one of the pans in the oven and broil until cheese is melted and bread is toasted, 2-4 minutes. Repeat with the second pan.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 147190,
      "primary_message": "Meanwhile, peel and slice the eggs.",
      "secondary_message": null
    },
    {
      "id": 147191,
      "primary_message": "To serve, layer tomato and egg slices on toast; garnish with basil, salt, and pepper. Enjoy!",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
