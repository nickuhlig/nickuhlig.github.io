  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the shallot. Mince the garlic clove.",
      "secondary_message": "1 small shallot\n1 medium garlic clove"
    },
    {
      "id": 1,
      "primary_message": "Cut the mushrooms based on the variety used: Stem and halve portobello mushrooms and cut into 1.5-cm pieces. Trim white button or cremini mushrooms; quarter them if large or medium (about 4 to 8-cm in diameter) or halve them if small (about 2.5 to 4-cm in diameter). Tear trimmed oyster mushrooms into about 2.5-cm pieces. Stem shiitake mushrooms; quarter large caps (about 4 to 8-cm in diameter) and halve small caps (about 2.5 to 4-cm in diameter). Cut trimmed maitake (hen-of-the-woods) mushrooms into about 1-pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a 30-cm skillet, melt 2 tablespoons butter over medium heat. Add shallot and cook, stirring frequently, until softened, 1 to 2 minutes. Add cut mushrooms and salt and increase heat to medium-high. Cover and cook, stirring occasionally, until mushrooms have released their liquid, 8 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove lid, add remaining 2 tablespoons butter, and cook, stirring occasionally, until mushrooms are deep golden brown and tender, about 15 minutes. Stir in thyme and garlic and cook until fragrant, about 30 seconds. Add vinegar and water and cook, scraping up any browned bits, until liquid is nearly evaporated, about 1 minute. Season with salt and pepper to taste. Serve.",
      "secondary_message": null
    }
  ],
