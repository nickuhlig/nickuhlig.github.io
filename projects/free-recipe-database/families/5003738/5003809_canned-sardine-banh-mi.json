  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the carrot into fine matchsticks. Cut the daikon radish into fine matchsticks. Thinly slice the jalapeño pepper.",
      "secondary_message": "1 medium carrot\n1 small daikon radish\n1 jalapeño pepper"
    },
    {
      "id": 1,
      "primary_message": "To Make the Pickled Carrots and Daikon: combine carrots, daikon, salt, and sugar in a small bowl and toss to coat. Allow to rest 10 minutes until liquid has been drawn out of vegetables and salt and sugar are completely dissolved. Add vinegar and water and transfer to small, sealable container. Let sit at room temperature for 1 hour, or for best results, allow pickled to rest for at least 3 days in the refrigerator.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Lightly toast baguettes if desired, then split each baguette half lengthwise, then evenly distribute the mayonnaise among the baguettes. Add a few dashes of Maggi seasoning to the inside of the baguettes. Divide the sardines among the sandwiches—there should be about 2 whole sardines per sandwich. Using a fork, mash the sardines into the sandwiches. If desired, spoon more of the tomato sauce from the can over the mashed sardines.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Top the sardines with the pickled carrots and daikon, cilantro, and jalapeno slices. Serve immediately.",
      "secondary_message": null
    }
  ],
