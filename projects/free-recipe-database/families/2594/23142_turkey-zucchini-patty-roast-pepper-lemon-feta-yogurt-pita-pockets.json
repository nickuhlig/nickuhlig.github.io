  "instructions": [
    {
      "id": 381442,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 381443,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 medium zucchini squash\n1 small bunch cilantro\n1 ½ lemons"
    },
    {
      "id": 381444,
      "primary_message": "Peel, halve, and medium dice onions. Trim, seed, and medium dice bell peppers. Divide between two baking sheet pans.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 381445,
      "primary_message": "Trim and quarter 1 ½ of the zucchini squashes lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the baking sheets with the onion and pepper. (Reserve the other 1 ½ zucchini squashes for the patties.)",
      "secondary_message": null
    },
    {
      "id": 381446,
      "primary_message": "Peel and mince garlic. Sprinkle over the veggies, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 381447,
      "primary_message": "Place baking sheets in the oven (it doesn't need to be fully heated) and roast, stirring halfway through, until veggies are tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 381448,
      "primary_message": "Meanwhile, coarsely grate the remaining zucchini squashes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 381449,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the zucchini along with turkey and spices. Mix with your hands until well combined.",
      "secondary_message": "2 ¼ lb ground turkey\n1 tbsp chili powder\n2 ½ tsp cumin, ground\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 381450,
      "primary_message": "Using a ¼-cup measure, form turkey mixture into ½-inch thick patties. Place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 381451,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 381452,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the patties and cook, flipping once, until golden and cooked through, about 8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 381453,
      "primary_message": "Meanwhile, zest and juice lemons into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 381454,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the lemon along with feta, yogurt, Italian seasoning, and salt. Stir to combine the sauce and set aside.",
      "secondary_message": "3 cloves garlic\n1 ½ (4 oz) pkgs crumbled feta cheese\n1 ½ cups plain Greek yogurt\n1 ½ tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 381455,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread each pocket with yogurt sauce, then stuff with roasted veggies and patties.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 381456,
      "primary_message": "To serve, divide pita pockets between plates. Enjoy!",
      "secondary_message": null
    }
  ],
