  "instructions": [
    {
      "id": 381547,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 381548,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 medium zucchini squash\n½ small bunch cilantro\n½ lemon"
    },
    {
      "id": 381549,
      "primary_message": "Peel, halve, and medium dice onion. Trim, seed, and medium dice bell pepper. Transfer both to a baking sheet pan.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 381550,
      "primary_message": "Trim and halve zucchini crosswise. Quarter one half of the zucchini lengthwise, then slice crosswise into ¼-inch thick pieces. Add to the baking sheet with the onion and pepper. (Reserve the other half of the zucchini for the patties.)",
      "secondary_message": null
    },
    {
      "id": 381551,
      "primary_message": "Peel and mince garlic. Sprinkle over the veggies, then drizzle with oil and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 381552,
      "primary_message": "Place baking sheet in the oven (it doesn't need to be fully heated) and roast, stirring halfway through, until veggies are tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 381553,
      "primary_message": "Meanwhile, coarsely grate the remaining zucchini and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 381554,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the zucchini along with veggie ground and spices. Mix with your hands until well combined.",
      "secondary_message": "227 g veggie ground, plant based\n¾ tsp cumin, ground\n½ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 381555,
      "primary_message": "Using a scant ¼-cup measure, form veggie ground mixture into ½-inch thick patties. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 381556,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 381557,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the patties and cook, flipping once, until golden, 5-7 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 381558,
      "primary_message": "Meanwhile, zest and juice lemon into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 381559,
      "primary_message": "Peel and mince additional garlic. Add to the bowl with the lemon along with feta, yogurt, Italian seasoning, and salt. Stir to combine the sauce and set aside.",
      "secondary_message": "1 clove garlic\n½ (113 g) pkg crumbled feta cheese\n½ cup plain Greek yogurt\n½ tsp Italian seasoning\n⅛ tsp salt"
    },
    {
      "id": 381560,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread each pocket with yogurt sauce, then stuff with roasted veggies and patties.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 381561,
      "primary_message": "To serve, divide pita pockets between plates. Enjoy!",
      "secondary_message": null
    }
  ],
