  "instructions": [
    {
      "id": 341081,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341082,
      "primary_message": "While the pan heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 341083,
      "primary_message": "Once the pan is hot, coat with oil; add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 341084,
      "primary_message": "Meanwhile, place mayo, honey, water, Dijon, and salt in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp honey\n1 tbsp water\n1 tsp Dijon mustard\n⅛ tsp salt"
    },
    {
      "id": 341085,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (16 oz) pkg strawberries\n½ small bunch green onions (scallions)\n1 head romaine lettuce\n1 avocado"
    },
    {
      "id": 341086,
      "primary_message": "Using a clean cutting board, trim and thinly slice strawberries; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 341087,
      "primary_message": "Trim and thinly slice green onions; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341088,
      "primary_message": "Chop or tear romaine into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341089,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl and toss to combine the salad.",
      "secondary_message": "¼ cup frozen corn"
    },
    {
      "id": 341090,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 341091,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 341092,
      "primary_message": "To serve, divide salad between plates or bowls; top with chicken and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
