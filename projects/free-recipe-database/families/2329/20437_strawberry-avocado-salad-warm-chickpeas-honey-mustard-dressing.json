  "instructions": [
    {
      "id": 341117,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341118,
      "primary_message": "While the skillet heats up, drain and rinse chickpeas.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)"
    },
    {
      "id": 341119,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chickpeas and spices; cook, stirring occasionally, until chickpeas are golden brown, 5-6 minutes. Cover and remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 341120,
      "primary_message": "Meanwhile, place mayo, honey, water, Dijon, and salt in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tbsp honey\n1 tbsp water\n1 tsp Dijon mustard\n⅛ tsp salt"
    },
    {
      "id": 341121,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ (16 oz) pkg strawberries\n½ small bunch green onions (scallions)\n1 head romaine lettuce\n1 avocado"
    },
    {
      "id": 341122,
      "primary_message": "Trim and thinly slice strawberries; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 341123,
      "primary_message": "Trim and thinly slice green onions; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341124,
      "primary_message": "Chop or tear romaine into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341125,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl and toss to combine the salad.",
      "secondary_message": "¼ cup frozen corn"
    },
    {
      "id": 341126,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 341127,
      "primary_message": "To serve, divide salad between plates or bowls; top with chickpeas and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
