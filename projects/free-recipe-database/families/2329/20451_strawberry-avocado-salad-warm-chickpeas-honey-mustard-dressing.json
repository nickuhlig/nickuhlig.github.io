  "instructions": [
    {
      "id": 341274,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341275,
      "primary_message": "While the skillet heats up, drain and rinse chickpeas.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 341276,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chickpeas and spices; cook, stirring occasionally, until chickpeas are golden brown, 6-7 minutes. Cover and remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 341277,
      "primary_message": "Meanwhile, place mayo, maple syrup, water, Dijon, and salt in a large bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup vegan mayonnaise\n3 tbsp pure maple syrup\n3 tbsp water\n1 tbsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 341278,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ (454 g) pkgs strawberries\n1 small bunch green onions (scallions)\n3 heads romaine lettuce\n3 avocados"
    },
    {
      "id": 341279,
      "primary_message": "Trim and thinly slice strawberries; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 341280,
      "primary_message": "Trim and thinly slice green onions; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341281,
      "primary_message": "Chop or tear romaine into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341282,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl and toss to combine the salad.",
      "secondary_message": "¾ cup frozen corn"
    },
    {
      "id": 341283,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 341284,
      "primary_message": "To serve, divide salad between plates or bowls; top with chickpeas and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
