  "instructions": [
    {
      "id": 341105,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341106,
      "primary_message": "While the pan heats up, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 341107,
      "primary_message": "Once the pan is hot, coat with oil; working in batches if necessary, add chicken and grill until charred and cooked through, 3-4 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 341108,
      "primary_message": "Meanwhile, place mayo, honey, water, Dijon, and salt in a large bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n3 tbsp honey\n3 tbsp water\n1 tbsp Dijon mustard\n½ tsp salt"
    },
    {
      "id": 341109,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ (16 oz) pkg strawberries\n1 small bunch green onions (scallions)\n3 heads romaine lettuce\n3 avocados"
    },
    {
      "id": 341110,
      "primary_message": "Using a clean cutting board, trim and thinly slice strawberries; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 341111,
      "primary_message": "Trim and thinly slice green onions; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341112,
      "primary_message": "Chop or tear romaine into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341113,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl and toss to combine the salad.",
      "secondary_message": "¾ cup frozen corn"
    },
    {
      "id": 341114,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 341115,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 341116,
      "primary_message": "To serve, divide salad between plates or bowls; top with chicken and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
