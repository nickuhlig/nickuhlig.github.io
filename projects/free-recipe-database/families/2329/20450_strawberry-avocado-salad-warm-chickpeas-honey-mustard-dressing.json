  "instructions": [
    {
      "id": 341263,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 341264,
      "primary_message": "While the skillet heats up, drain and rinse chickpeas.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 341265,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chickpeas and spices; cook, stirring occasionally, until chickpeas are golden brown, 5-6 minutes. Cover and remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 341266,
      "primary_message": "Meanwhile, place mayo, maple syrup, water, Dijon, and salt in a large bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup vegan mayonnaise\n2 tbsp pure maple syrup\n2 tbsp water\n2 tsp Dijon mustard\n¼ tsp salt"
    },
    {
      "id": 341267,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (454 g) pkg strawberries\n1 small bunch green onions (scallions)\n2 heads romaine lettuce\n2 avocados"
    },
    {
      "id": 341268,
      "primary_message": "Trim and thinly slice strawberries; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 341269,
      "primary_message": "Trim and thinly slice green onions; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341270,
      "primary_message": "Chop or tear romaine into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 341271,
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost; add to the bowl and toss to combine the salad.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 341272,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 341273,
      "primary_message": "To serve, divide salad between plates or bowls; top with chickpeas and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
