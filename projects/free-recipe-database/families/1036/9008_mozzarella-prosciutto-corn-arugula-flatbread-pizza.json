  "instructions": [
    {
      "id": 177289,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 177290,
      "primary_message": "Place corn in a medium bowl and cover with hot water from the tap. ",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "id": 177291,
      "primary_message": "Peel and mince garlic; transfer to a small bowl. Add oil and stir to combine.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 177292,
      "primary_message": "Using a strainer or colander, drain the corn and transfer to a clean towel; pat dry.",
      "secondary_message": null
    },
    {
      "id": 177293,
      "primary_message": "Grate cheese.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 177294,
      "primary_message": "Place the flatbreads on a baking sheet and spread with the garlic oil.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 177295,
      "primary_message": "Layer cheese, corn, and prosciutto onto the flatbreads.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 177296,
      "primary_message": "Place pizza in the oven and bake, until the cheese is golden and melted, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 177297,
      "primary_message": "Meanwhile, wash and dry the basil and arugula. (Skip the arugula if it came pre-washed.) Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 177298,
      "primary_message": "When pizza is done top with arugula, basil, and crushed red pepper.",
      "secondary_message": "¼ tsp crushed red pepper"
    },
    {
      "id": 177299,
      "primary_message": "To serve, cut pizza into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
