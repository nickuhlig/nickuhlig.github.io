  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the rind from the seedless watermelon, then cut it into 1-inch chunks. Juice the lemon. Remove the zest with a sharp vegetable peeler. Pick the mint leaves from the stems and roughly chop them.",
      "secondary_message": "3 lb seedless watermelon\n½ lemon\n4 (2 inch) strips zest\n¼ cup fresh mint"
    },
    {
      "id": 1,
      "primary_message": "Place watermelon chunks in a large bowl. Finely chop lemon zest. Add lemon juice and half of zest to bowl with watermelon. Add mint, oil, and arugula (if using) and toss until watermelon is evenly dressed. Season lightly to taste with salt and pepper. (The cheese will add saltiness, so go light on the salt at this stage.)",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Transfer salad to a wide, shallow bowl or a large plate and spread out evenly. Crumble feta over top. Sprinkle with remaining lemon zest. Drizzle with more olive oil and a few grinds of black pepper. Serve immediately.",
      "secondary_message": null
    }
  ],
