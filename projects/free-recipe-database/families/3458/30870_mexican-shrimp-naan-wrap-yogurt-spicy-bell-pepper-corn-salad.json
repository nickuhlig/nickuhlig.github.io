  "instructions": [
    {
      "id": 489493,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 small bunch cilantro\n3 jalapeño peppers\n3 green bell peppers\n3 red bell peppers"
    },
    {
      "id": 489494,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with oil and spices, then whisk to combine. ",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp chili powder\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 489495,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Add to the bowl with the spice paste, stir to coat, and set aside.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 489496,
      "primary_message": "Juice limes into another large bowl. Add oil and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 489497,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 489498,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 489499,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 489500,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 489501,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 489502,
      "primary_message": "Divide naan between two baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until lightly toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 489503,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 489504,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add shrimp and cook until they are opaque, 1-2 minutes per side. Transfer to a plate. ",
      "secondary_message": null
    },
    {
      "id": 489505,
      "primary_message": "Spread yogurt over each naan and top with a small portion of salad and the shrimp. (Reserve remaining salad for serving.)",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 489506,
      "primary_message": "To make wraps easier to eat, place each naan on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise, eat as is and get a little messy! Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
