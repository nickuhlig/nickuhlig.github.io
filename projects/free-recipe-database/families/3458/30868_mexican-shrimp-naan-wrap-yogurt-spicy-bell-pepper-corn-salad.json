  "instructions": [
    {
      "id": 489465,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ small bunch cilantro\n1 jalapeño pepper\n1 green bell pepper\n1 red bell pepper"
    },
    {
      "id": 489466,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with oil and spices, then whisk to combine. ",
      "secondary_message": "2 cloves garlic\n2 tsp extra virgin olive oil\n2 tsp chili powder\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper\n1 pinch cayenne pepper"
    },
    {
      "id": 489467,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry. Add to the bowl with the spice paste, stir to coat, and set aside.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 489468,
      "primary_message": "Juice lime into another medium bowl. Add oil and spices, then whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 489469,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 489470,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 489471,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 489472,
      "primary_message": "Rinse corn under hot water (from the tap) to thaw. Add to the bowl, stir to combine the salad, and set aside.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 489473,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 489474,
      "primary_message": "Arrange naan bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until lightly toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 489475,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 489476,
      "primary_message": "Once the skillet is hot, add shrimp and cook until they are opaque, 1-2 minutes per side. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 489477,
      "primary_message": "Spread yogurt over each naan and top with a small portion of salad and the shrimp. (Reserve remaining salad for serving.)",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 489478,
      "primary_message": "To make wraps easier to eat, place each naan on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise, eat as is and get a little messy! Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
