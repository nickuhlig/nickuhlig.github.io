  "instructions": [
    {
      "id": 128700,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 128701,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ small pkgs fresh basil\n0.68 kg green beans\n1 ½ Granny Smith apples\n1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 128702,
      "primary_message": "Finely grate the Parmesan; transfer to a medium bowl.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 128703,
      "primary_message": "Peel and mince the garlic. Pick the basil leaves off the stems; discard the stems and mince the leaves. Add both to the bowl with the parmesan.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 128704,
      "primary_message": "Trim and discard the ends of the green beans. Once the water in the pot is boiling, add the beans and cook until bright green and tender-crisp, 3-4 minutes. Drain and set aside.",
      "secondary_message": null
    },
    {
      "id": 128705,
      "primary_message": "Finely chop the pine nuts.",
      "secondary_message": "⅜ cup pine nuts"
    },
    {
      "id": 128706,
      "primary_message": "Add pine nuts, oil, salt, and pepper to the bowl with the Parmesan and stir to combine the pesto; set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 128707,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "1 ½ (227 g) blocks cheddar cheese"
    },
    {
      "id": 128708,
      "primary_message": "Divide pesto among bread slices and top half of them with half of the cheddar. Arrange green beans on top of the cheddar so that they all face the same direction. Cover with remaining cheese and close sandwiches; press to secure ingredients.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 128709,
      "primary_message": "Preheat a large skillet over medium-low heat.",
      "secondary_message": null
    },
    {
      "id": 128710,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Place sandwiches in the skillet and cook, flipping once, until bread is golden brown and cheese is melted, 3-4 minutes per side. Cook in batches if necessary. Once done, transfer to a cutting board; slice sandwiches on the diagonal. ",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 128711,
      "primary_message": "Meanwhile, combine oil, vinegar, maple syrup, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp pure maple syrup\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 128712,
      "primary_message": "Core and thinly slice apples; add apple and mixed greens to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 128713,
      "primary_message": "To serve, divide the salad and sandwiches between plates. Enjoy!",
      "secondary_message": null
    }
  ],
