  "instructions": [
    {
      "id": 444532,
      "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 444533,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 hearts romaine hearts\n3 avocados"
    },
    {
      "id": 444534,
      "primary_message": "Trim, seed, and small dice bell peppers. Transfer to a platter.",
      "secondary_message": null
    },
    {
      "id": 444535,
      "primary_message": "Peel, halve, and small dice onions. Peel and mince garlic. Add both to the platter with the bell pepper.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 444536,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 444537,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, and garlic. Cook, stirring often, until softened, 5-6 minutes. (Reserve platter for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 444538,
      "primary_message": "Meanwhile, halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Transfer to the reserved platter.",
      "secondary_message": null
    },
    {
      "id": 444539,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the platter with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 444540,
      "primary_message": "Crumble tofu into small pieces with your fingers and add to the skillet along with spices. Cook, stirring occasionally, until tofu is golden brown, 5-6 minutes. Remove from heat.",
      "secondary_message": "¼ cup taco seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 444541,
      "primary_message": "Warm taco shells in the microwave if desired.",
      "secondary_message": "18 hard taco shells"
    },
    {
      "id": 444542,
      "primary_message": "To serve, divide taco shells between plates. Fill with tofu mixture, salsa, lettuce, and avocado. Enjoy!",
      "secondary_message": "¾ cup salsa"
    }
  ],
