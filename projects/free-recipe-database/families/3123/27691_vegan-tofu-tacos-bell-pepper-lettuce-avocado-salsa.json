  "instructions": [
    {
      "id": 444477,
      "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 444478,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 heart romaine hearts\n1 avocado"
    },
    {
      "id": 444479,
      "primary_message": "Trim, seed, and small dice bell pepper.",
      "secondary_message": null
    },
    {
      "id": 444480,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 444481,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. Peel and mince garlic.",
      "secondary_message": "½ medium red onion\n1 clove garlic"
    },
    {
      "id": 444482,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, onion, and garlic. Cook, stirring often, until softened, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 444483,
      "primary_message": "Meanwhile, halve lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 444484,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice. Add to the plate with the lettuce.",
      "secondary_message": null
    },
    {
      "id": 444485,
      "primary_message": "Crumble tofu into small pieces with your fingers and add to the skillet along with spices. Cook, stirring occasionally, until tofu is golden brown, 4-5 minutes. Remove from heat.",
      "secondary_message": "1 ½ tbsp taco seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 444486,
      "primary_message": "Warm taco shells in the microwave if desired.",
      "secondary_message": "6 hard taco shells"
    },
    {
      "id": 444487,
      "primary_message": "To serve, divide taco shells between plates. Fill with tofu mixture, salsa, lettuce, and avocado. Enjoy!",
      "secondary_message": "¼ cup salsa"
    }
  ],
