  "instructions": [
    {
      "id": 229302,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 (170 g) pkg blueberries\n4 kiwifruit\n2 mangoes"
    },
    {
      "id": 229303,
      "primary_message": "Mince dates and transfer to a medium saucepan.",
      "secondary_message": "½ cup medjool dates, pitted"
    },
    {
      "id": 229304,
      "primary_message": "Peel and mince ginger; add to the saucepan with the dates.",
      "secondary_message": null
    },
    {
      "id": 229305,
      "primary_message": "Add blueberries, water, and vinegar to the saucepan; stir to combine.",
      "secondary_message": "237 ml water\n¼ cup balsamic vinegar"
    },
    {
      "id": 229306,
      "primary_message": "Bring the blueberry mixture to a boil over medium-high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until blueberries are softened and the sauce has reduced, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 229307,
      "primary_message": "Meanwhile, peel and medium dice kiwis; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 229308,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; medium dice and add to the bowl with the kiwi.",
      "secondary_message": null
    },
    {
      "id": 229309,
      "primary_message": "When the sauce is done cooking, remove from the heat and allow to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 229310,
      "primary_message": "Transfer cooled sauce to a blender; add maple syrup and blend on high until smooth.",
      "secondary_message": "2 tbsp pure maple syrup"
    },
    {
      "id": 229311,
      "primary_message": "To serve, divide the fruit salad between bowls and top with blueberry-ginger sauce. Enjoy!",
      "secondary_message": null
    }
  ],
