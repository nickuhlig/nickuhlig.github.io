  "instructions": [
    {
      "id": 231320,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 231321,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and spread it out on a baking sheet pan to cool slightly, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 231322,
      "primary_message": "While the rice is cooking, cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 231323,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 red bell pepper\n½ (8 oz) pkg sugar snap peas\n½ small bunch green onions (scallions)\n1 medium carrot\n½ small bunch cilantro"
    },
    {
      "id": 231324,
      "primary_message": "Peel and mince ginger; transfer to a small bowl. Add peanut butter, vinegar, soy sauce, water, oil, and chili-garlic sauce; whisk to combine the dressing, then set aside.",
      "secondary_message": "1 ½ tbsp natural peanut butter\n1 ½ tbsp rice vinegar\n1 ½ tbsp soy sauce\n1 tbsp water\n1 tbsp toasted sesame oil\n1 tsp chili-garlic sauce"
    },
    {
      "id": 231325,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 231326,
      "primary_message": "While the skillet heats up, large dice the tofu. Gently toss in a medium bowl with cornstarch.",
      "secondary_message": "2 tbsp cornstarch"
    },
    {
      "id": 231327,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning every few minutes, until golden brown and crispy on all sides, about 10 minutes. Remove to a paper towel-lined plate.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 231328,
      "primary_message": "While the tofu is cooking, trim, seed, and medium dice bell pepper. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 231329,
      "primary_message": "Cut sugar snap peas crosswise into ¼-inch pieces and add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 231330,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231331,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231332,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 231333,
      "primary_message": "Transfer cooled rice to the bowl with the veggies and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 231334,
      "primary_message": "To serve, divide rice salad between bowls. Top with crispy tofu and drizzle with dressing. Enjoy!",
      "secondary_message": null
    }
  ],
