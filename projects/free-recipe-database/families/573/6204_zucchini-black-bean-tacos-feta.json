  "instructions": [
    {
      "id": 75448,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash"
    },
    {
      "id": 75447,
      "primary_message": "Trim off and discard the ends of the zucchini; medium dice the zucchini (cut into ½-inch cubes) and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 75446,
      "primary_message": "Drain and rinse the black beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 75445,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 75444,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces).",
      "secondary_message": "1 ½ medium yellow onion"
    },
    {
      "id": 75443,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 75442,
      "primary_message": "Add the onion to the skillet; cook, stirring frequently, until softened, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 75441,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 75440,
      "primary_message": "Add the garlic, chili powder, cumin, salt, and pepper to the skillet; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "3 tsp chili powder\n1 ½ tsp cumin\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75439,
      "primary_message": "Add the zucchini to the skillet; cook, stirring frequently, until just tender, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 75438,
      "primary_message": "Place the feta in a small bowl.",
      "secondary_message": "1 ½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 75437,
      "primary_message": "Add the black beans to the skillet; cook until the mixture is heated through, 1 to 2 minutes.",
      "secondary_message": ""
    },
    {
      "id": 75436,
      "primary_message": "Wrap the tortillas in damp paper towels and microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "24 small corn tortillas"
    },
    {
      "id": 75435,
      "primary_message": "To serve, divide the zucchini and black bean mixture between the tortillas and top with the feta. Enjoy!",
      "secondary_message": ""
    }
  ],
