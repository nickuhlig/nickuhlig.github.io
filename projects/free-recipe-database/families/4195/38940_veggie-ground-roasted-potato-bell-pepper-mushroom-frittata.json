  "instructions": [
    {
      "id": 605994,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 605995,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.23 kg new potatoes\n1 red bell pepper\n0.23 kg white mushrooms"
    },
    {
      "id": 605996,
      "primary_message": "Small dice new potatoes. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 605997,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 605998,
      "primary_message": "Meanwhile, trim, seed, and slice bell pepper lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 605999,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 606000,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 606001,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n227 g veggie ground, plant based"
    },
    {
      "id": 606002,
      "primary_message": "While the veggie ground is cooking, peel and mince garlic. Add to the bowl with the vegetables.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 606003,
      "primary_message": "When the veggie ground is done, add veggies, garlic, and spices to the skillet; cook, stirring occasionally, until softened, 6-7 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 606004,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl, then whisk to combine. Set aside.",
      "secondary_message": "6 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 606005,
      "primary_message": "When the potatoes are done, change oven to broil on high. Transfer potatoes to the skillet with the veggie ground and vegetables, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 606006,
      "primary_message": "Return skillet to medium-low heat and add the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 606007,
      "primary_message": "Place skillet in the oven and broil until top is set, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 606008,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
