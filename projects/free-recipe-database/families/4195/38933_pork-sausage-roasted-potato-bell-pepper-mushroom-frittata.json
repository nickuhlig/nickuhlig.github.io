  "instructions": [
    {
      "id": 605889,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 605890,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n3 red bell peppers\n1 ½ lb white mushrooms"
    },
    {
      "id": 605891,
      "primary_message": "Small dice new potatoes. Transfer to a large baking sheet pan, drizzle with oil, then season with salt and pepper. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 605892,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and fork-tender, about 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 605893,
      "primary_message": "Meanwhile, trim, seed, and slice bell peppers lengthwise into thin strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 605894,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 605895,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 605896,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ lb ground pork sausage"
    },
    {
      "id": 605897,
      "primary_message": "While the sausage is cooking, peel and mince garlic. Add to the bowl with the veggies.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 605898,
      "primary_message": "When the sausage is done, add veggies, garlic, and spices to the skillet; cook, stirring occasionally, until softened, 7-8 minutes. Remove from heat. (Reserve bowl for the next step.)",
      "secondary_message": "1 ½ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 605899,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl, then whisk to combine. Set aside.",
      "secondary_message": "18 eggs\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 605900,
      "primary_message": "When the potatoes are done, change oven to broil on high. Transfer potatoes to the skillet with the sausage and veggies, then stir to combine.",
      "secondary_message": null
    },
    {
      "id": 605901,
      "primary_message": "Return skillet to medium-low heat and add the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 605902,
      "primary_message": "Place skillet in the oven and broil until top is set, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 605903,
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
