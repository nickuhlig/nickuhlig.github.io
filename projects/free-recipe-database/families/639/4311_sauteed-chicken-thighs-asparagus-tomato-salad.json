  "instructions": [
    {
      "id": 48594,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 48595,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n½ small pkg grape tomatoes"
    },
    {
      "id": 48596,
      "primary_message": "Snap or cut off and discard the woody ends of the asparagus; cut the spears into 5-cm pieces at an angle and transfer to a bowl.",
      "secondary_message": null
    },
    {
      "id": 48597,
      "primary_message": "Once the water in the saucepan is boiling, uncover and season with salt. Add the asparagus and cook until bright green, 2 to 4 minutes (depending on the thickness of the spears). Drain in a colander and run under cold water to stop the cooking process. Set aside to drain further.",
      "secondary_message": "1 tbsp salt"
    },
    {
      "id": 48598,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 48599,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "0.454 kg chicken thighs, boneless skinless\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 48600,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 48601,
      "primary_message": "Carefully place the chicken thighs in the skillet; sear on both sides until golden brown, 2 to 3 minutes per side. Then, reduce the heat to medium and continue to cook until they are cooked through, 2 to 4 minutes total. Once done, transfer to a plate and cover with foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 48602,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Transfer to a salad bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 48603,
      "primary_message": "To the garlic, add olive oil, balsamic vinegar, Dijon, salt, and pepper; whisk together.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n½ tbsp balsamic vinegar\n¼ tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 48604,
      "primary_message": "Halve the grape tomatoes and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 48605,
      "primary_message": "Add the asparagus to the salad bowl and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 48606,
      "primary_message": "To serve, divide the chicken thighs and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
