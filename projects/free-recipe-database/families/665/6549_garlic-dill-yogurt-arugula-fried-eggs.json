  "instructions": [
    {
      "id": 94152,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 small bunches fresh dill\n3 (5 oz) pkgs baby arugula"
    },
    {
      "id": 94153,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 94154,
      "primary_message": "Coarsely chop walnuts. Toast walnuts until fragrant (2-4 minutes). Stir in red pepper flakes and butter until melted. Set walnuts aside in a bowl and return skillet to the heat.",
      "secondary_message": "¾ cup walnuts\n1 ½ tbsp butter, unsalted\n3 pinch crushed red pepper"
    },
    {
      "id": 94155,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 94156,
      "primary_message": "Gently crack the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 3 to 4 minutes. Once done, separate the eggs. Cook in batches if necessary.",
      "secondary_message": "12 eggs"
    },
    {
      "id": 94157,
      "primary_message": "Trim off the root ends of the garlic; peel and mince or press the garlic. Transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 94158,
      "primary_message": "Shave the dill leaves off the stems; discard the stems and mince the leaves. Add to the medium bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 94159,
      "primary_message": "Add plain yogurt, olive oil, salt and pepper to the medium bowl and stir until smooth and well combined.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 94160,
      "primary_message": "In a large bowl, toss arugula with remaining olive oil and salt.",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅜ tsp salt"
    },
    {
      "id": 94161,
      "primary_message": "Toast flatbread if desired.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 94162,
      "primary_message": "To serve, divide yogurt, flat bread, arugula, and eggs between plates. Top with walnuts and enjoy!",
      "secondary_message": null
    }
  ],
