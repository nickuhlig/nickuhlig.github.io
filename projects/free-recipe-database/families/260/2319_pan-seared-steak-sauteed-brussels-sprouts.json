  "instructions": [
    {
      "id": 22178,
      "primary_message": "Wash sprouts, trim rough ends and halve lengthwise. Transfer to a bowl and set aside.",
      "secondary_message": "2 lb brussels sprouts"
    },
    {
      "id": 22179,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 22180,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "1 ½ lb ribeye steak\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 22181,
      "primary_message": "Coat bottom of skillet with oil. Place steak in skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil; set aside.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 22182,
      "primary_message": "Peel and thinly slice shallots. Peel and mince garlic.",
      "secondary_message": "2 shallots\r\n4 cloves garlic"
    },
    {
      "id": 22183,
      "primary_message": "Once steak has been transferred, melt butter in skillet. Add brussels sprouts, shallots, and garlic. Cook, stirring occasionally, until sprouts are browned, 4-5 minutes.",
      "secondary_message": "4 tbsp butter, unsalted"
    },
    {
      "id": 22184,
      "primary_message": "Add 1 cup water to sprouts and bring to a simmer. Cook, stirring occasionally, until the sprouts are tender and liquid has evaporated, 4-5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 22185,
      "primary_message": "Drizzle with vinegar and season with salt and pepper. Cook, stirring occasionally, for another 1-2 minutes.",
      "secondary_message": "4 tbsp balsamic vinegar\r\n1 tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 22186,
      "primary_message": "Serve steak with brussels sprouts on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
