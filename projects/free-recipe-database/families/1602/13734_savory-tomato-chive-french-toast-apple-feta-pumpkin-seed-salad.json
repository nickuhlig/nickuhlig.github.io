  "instructions": [
    {
      "id": 228358,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "3 Gala apples\n1 ½ (142 g) pkg spring mix (mixed greens)\n1 small pkg chives"
    },
    {
      "id": 228359,
      "primary_message": "Place eggs, tomato sauce, cornstarch, and spices in a large baking dish; whisk until smooth.",
      "secondary_message": "6 eggs\n1 ½ (213 ml) cans tomato sauce\n1 ½ tbsp cornstarch\n1 ½ tsp Italian seasoning\n¾ tsp paprika\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 228360,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 228361,
      "primary_message": "While the skillet heats up, working in batches, place bread slices in the dish with the egg batter; turn the slices, making sure both sides are soaked through.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 228362,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, transfer soaked bread to the skillet and cook until golden brown, 2-3 minutes per side. Remove to a plate and cover with aluminum foil.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 228363,
      "primary_message": "Meanwhile, place oil, vinegar, honey, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n1 ½ tsp honey\n1 ½ tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 228364,
      "primary_message": "Quarter and core the apples, then thinly slice each quarter; transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 228365,
      "primary_message": "Add spring mix, feta, and pumpkin seeds to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese\n⅓ cup pumpkin seeds"
    },
    {
      "id": 228366,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 228367,
      "primary_message": "Divide French toast between plates; top with butter and chives. Serve with salad on the side and enjoy!",
      "secondary_message": "3 tbsp butter, unsalted"
    }
  ],
