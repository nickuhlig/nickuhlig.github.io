  "instructions": [
    {
      "id": 228338,
      "primary_message": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)",
      "secondary_message": "1 Gala apple\n½ (142 g) pkg spring mix (mixed greens)\n½ small pkg chives"
    },
    {
      "id": 228339,
      "primary_message": "Place eggs, tomato sauce, cornstarch, and spices in a baking dish; whisk until smooth.",
      "secondary_message": "2 eggs\n½ (213 ml) can tomato sauce\n1 ½ tsp cornstarch\n½ tsp Italian seasoning\n¼ tsp paprika\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 228340,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 228341,
      "primary_message": "While the skillet heats up, place bread slices in the dish with the egg batter; turn the slices, making sure both sides are soaked through.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 228342,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, transfer soaked bread to the skillet and cook until golden brown, 2-3 minutes per side. Remove to a plate.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 228343,
      "primary_message": "Meanwhile, place oil, vinegar, honey, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp honey\n½ tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 228344,
      "primary_message": "Quarter and core the apple, then thinly slice each quarter; transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 228345,
      "primary_message": "Add spring mix, feta, and pumpkin seeds to the bowl and toss to combine the salad. Set aside.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese\n⅛ cup pumpkin seeds"
    },
    {
      "id": 228346,
      "primary_message": "Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 228347,
      "primary_message": "Divide French toast between plates; top with butter and chives. Serve with salad on the side and enjoy!",
      "secondary_message": "1 tbsp butter, unsalted"
    }
  ],
