  "instructions": [
    {
      "id": 410221,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 410222,
      "primary_message": "While the pan heats up, pat the pork chops dry with paper towels and place on a plate. Season both sides with spices.",
      "secondary_message": "6 pork chops, bone-in\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 410223,
      "primary_message": "Once the pan is hot, coat with oil. Working in batches if necessary, add pork chops and grill until golden and cooked through, 4-5 minutes per side. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 410224,
      "primary_message": "Meanwhile, wash, dry, quarter, and core apples; small dice. Place in a large bowl. ",
      "secondary_message": "3 Granny Smith apples"
    },
    {
      "id": 410225,
      "primary_message": "Wash, dry, and chop chives into small pieces. Add to the bowl with the apple.",
      "secondary_message": "1 small pkg chives"
    },
    {
      "id": 410226,
      "primary_message": "Add shredded cabbage and dressing to the bowl. Toss to combine the slaw and set aside. ",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n½ cup balsamic vinaigrette"
    },
    {
      "id": 410227,
      "primary_message": "To serve, divide chops and slaw between plates; drizzle chops with pesto. Enjoy!",
      "secondary_message": "¾ cup basil pesto"
    }
  ],
