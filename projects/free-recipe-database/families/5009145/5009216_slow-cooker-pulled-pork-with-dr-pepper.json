  "instructions": [
    {
      "id": 1,
      "primary_message": "In a heavy-bottomed pan over medium-high heat, brown pork on all sides. Transfer roast to slow cooker. Return pan to stove.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour Dr Pepper into pan and deglaze, using a spatula to scrape up all the pork bits on the bottom. Let cook for 2 minutes, scraping the bottom occasionally.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour Dr Pepper over meat in slow cooker. Add honey, balsamic vinegar, salt, and pepper. Stir well. Cover and cook on low for 7 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "After meat has cooked for 7 hours, drain off any excess liquid and shred meat into small bits with 2 forks. Add barbecue sauce to pork and stir well. Cover slow cooker and cook for 1 more hour.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add more salt and pepper to taste. Fill burger buns with pork and serve immediately.",
      "secondary_message": null
    }
  ],
