  "instructions": [
    {
      "id": 154830,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 pints grape tomatoes\n1 ½ small pkgs fresh basil\n3 medium carrots\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 154831,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 154832,
      "primary_message": "Transfer tomatoes to a large baking sheet pan. Drizzle with oil and season with salt and pepper; toss to coat. Place in the oven (it doesn't have to be fully heated) and broil until soft and lightly charred, 6-8 minutes. Remove from oven and set aside.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 154833,
      "primary_message": "Meanwhile, pick basil leaves off the stems and transfer to a blender. ",
      "secondary_message": null
    },
    {
      "id": 154834,
      "primary_message": "Peel garlic. Add to blender along with oil, salt, and pepper. Blend on high, adding water 1 tbsp at a time, if necessary, to form a semi-smooth pesto.",
      "secondary_message": "3 cloves garlic\n½ cup extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 154835,
      "primary_message": "Toast bread using a toaster. Alternatively, transfer bread to a baking sheet pan; place in the oven and broil, flipping halfway through, until nicely toasted, 2-3 minutes.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 154836,
      "primary_message": "Meanwhile, combine oil, vinegar, maple syrup, Dijon, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp red wine vinegar\n1 ½ tsp pure maple syrup\n1 ½ tsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 154837,
      "primary_message": "Peel and grate the carrots; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 154838,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 154839,
      "primary_message": "To assemble the tartines, divide ricotta between slices of toast and spread out in an even layer. Season with salt and pepper.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 154840,
      "primary_message": "Layer tartines with tomatoes, pesto, and pine nuts.",
      "secondary_message": "⅜ cup pine nuts"
    },
    {
      "id": 154841,
      "primary_message": "To serve, divide salad and tartines between plates. Enjoy!",
      "secondary_message": null
    }
  ],
