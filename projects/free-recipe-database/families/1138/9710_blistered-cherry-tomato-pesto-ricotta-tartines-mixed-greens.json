  "instructions": [
    {
      "id": 154878,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n½ small pkg fresh basil\n1 medium carrot\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 154879,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 154880,
      "primary_message": "Transfer tomatoes to a baking sheet pan. Drizzle with oil and season with salt and pepper; toss to coat. Place in the oven (it doesn't have to be fully heated) and broil until soft and lightly charred, 6-8 minutes. Remove from oven and set aside.",
      "secondary_message": "½ tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 154881,
      "primary_message": "Meanwhile, pick basil leaves off the stems and transfer to a blender. ",
      "secondary_message": null
    },
    {
      "id": 154882,
      "primary_message": "Peel garlic. Add to blender along with oil, salt, and pepper. Blend on high, adding water 1 tbsp at a time, if necessary, to form a semi-smooth pesto.",
      "secondary_message": "1 clove garlic\n3 tbsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 154883,
      "primary_message": "Toast bread.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 154884,
      "primary_message": "Meanwhile, combine oil, vinegar, maple syrup, Dijon, salt, and pepper in a medium bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp pure maple syrup\n½ tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 154885,
      "primary_message": "Peel and grate the carrot; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 154886,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 154887,
      "primary_message": "To assemble the tartines, divide ricotta between slices of toast and spread out in an even layer. Season with salt and pepper.",
      "secondary_message": "½ (425 g) pkg ricotta cheese\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 154888,
      "primary_message": "Layer tartines with tomatoes, pesto, and pine nuts.",
      "secondary_message": "⅛ cup pine nuts"
    },
    {
      "id": 154889,
      "primary_message": "To serve, divide salad and tartines between plates. Enjoy!",
      "secondary_message": null
    }
  ],
