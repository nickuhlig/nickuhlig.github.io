  "instructions": [
    {
      "id": 1,
      "primary_message": "Place sliced chicken in a large bowl and add salt, sugar, ground white pepper, Shaoxing wine, soy sauce, 1 teaspoon oil, and cornstarch. Mix well and marinate for 30 minutes in the refrigerator.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "After 30 minutes, take chicken out of refrigerator. Heat 2 tablespoons oil in a wok over high heat until smoking. Add the 1/4-inch-thick slice of ginger. Cook, stirring, for 30 seconds, then remove and discard ginger.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add chicken. Spread chicken out with a spatula and cook without moving until slightly browned, about 1 minute. Continue to cook while stirring regularly until nearly cooked through, about 2 minutes longer. Transfer to a bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat remaining tablespoon oil in wok over high heat until smoking. Add scallions and onions. Season with salt and cook, stirring, until the onions are tender, another 2 minutes. Return chicken to wok along with julienned ginger and minced garlic. Cook, stirring, until fragrant, about 1 minute. Transfer to serving platter and serve immediately with rice.",
      "secondary_message": null
    }
  ],
