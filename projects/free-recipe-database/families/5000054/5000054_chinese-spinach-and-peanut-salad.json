  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel and finely mince the garlic.",
      "secondary_message": "3 medium cloves fresh garlic"
    },
    {
      "id": 1,
      "primary_message": "In a small saucepan, cover the peanuts with oil. Set over medium heat and cook, slowly bringing the oil up to 350°F and then holding it there, until the peanuts are golden, about 10 minutes. Using a slotted spoon, transfer the peanuts to a paper towel-lined baking sheet to drain, then transfer to a large metal bowl. Toss the peanuts with the salt and let cool.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, prepare an ice bath. In a large pot of salted boiling water, blanch spinach until just tender and cooked through, about 30 seconds. Using a spider, quickly transfer spinach to ice bath, stirring to chill rapidly. Drain spinach, then wrap in a clean kitchen towel and squeeze to express any excess water. Cut spinach into 2-inch lengths.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, whisk together soy sauce, seasoning oil, vinegar, and sugar until well combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "When ready to serve, combine spinach, peanuts, minced garlic, and vinaigrette. Serve cold.",
      "secondary_message": null
    }
  ],
