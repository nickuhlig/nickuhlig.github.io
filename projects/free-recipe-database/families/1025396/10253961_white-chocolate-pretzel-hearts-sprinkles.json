  "instructions": [
    {
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "primary_message": "Uncover the pan and place a medium, heat-proof, bowl over the simmering water, allowing it to sit on the rim. Add chocolate to the bowl; using a silicone spatula, stir continuously, until melted. Remove bowl from the heat.",
      "secondary_message": "1 ½ cups white chocolate chips"
    },
    {
      "primary_message": "Line two large baking sheet pans with parchment paper. Count out 48 pretzels and divide between the baking sheets, then arrange in rows.",
      "secondary_message": "23 g mini pretzel"
    },
    {
      "primary_message": "Transfer half of the melted chocolate to another medium bowl. Add food coloring and stir to combine.",
      "secondary_message": "2 drops red food coloring"
    },
    {
      "primary_message": "Working with one baking sheet (24 pretzels), use a teaspoon to carefully pour pink chocolate into the center \"x\" of each pretzel. Guide the chocolate to the edges of the pretzel with the tip of the spoon, then top with sprinkles. Repeat with the second baking sheet (remaining 24 pretzels), using the white chocolate and remaining sprinkles.",
      "secondary_message": "¼ cup rainbow sprinkles"
    },
    {
      "primary_message": "Place baking sheets in the fridge until chocolate is set, about 10 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Remove baking sheets from the fridge. Carefully transfer pretzels to a platter and enjoy!",
      "secondary_message": null
    }
  ],
