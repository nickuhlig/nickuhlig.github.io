  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Clean and trim the ramps.",
      "secondary_message": "32 ramps"
    },
    {
      "id": 1,
      "primary_message": "Place ramps on a rimmed baking sheet. Drizzle with olive oil and season with salt and pepper. Toss until well coated.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Alternatively, set half the burners on a gas grill to the highest heat setting, cover, and preheat for 10 minutes. Clean and oil the grilling grate.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place ramps on hot side of grill and cook, turning occasionally, until tender and charred, about 2 minutes. Transfer to a serving platter, drizzle with more olive oil, and serve.",
      "secondary_message": null
    }
  ],
