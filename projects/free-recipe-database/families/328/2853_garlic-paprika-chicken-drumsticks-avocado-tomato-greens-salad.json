  "instructions": [
    {
      "id": 27657,
      "primary_message": "Preheat the oven to 500°F. Line a baking dish with foil.",
      "secondary_message": null
    },
    {
      "id": 27658,
      "primary_message": "Peel and mince or press the garlic; transfer to a medium bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 27659,
      "primary_message": "Add lime juice, olive oil, paprika, salt, and pepper to the minced garlic and mix well.",
      "secondary_message": "1 lime\n2 tbsp extra virgin olive oil\n2 tsp paprika\n1 tsp salt\n1 tsp black pepper"
    },
    {
      "id": 27660,
      "primary_message": "Add the chicken drumsticks to the garlic-paprika mixture and toss until well coated. Place the drumsticks in the baking dish.",
      "secondary_message": "2 ½ lb chicken drumsticks"
    },
    {
      "id": 27661,
      "primary_message": "Place the drumsticks in the oven and bake, flipping halfway through cooking time, until they are cooked through and browned, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 27662,
      "primary_message": "In a small bowl, prepare the dressing by whisking together lime juice, olive oil, Dijon, salt, and pepper.",
      "secondary_message": "1 lime\n4 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 27663,
      "primary_message": "Wash and dry the mixed greens.",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 27664,
      "primary_message": "Wash and halve the tomatoes.",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "id": 27665,
      "primary_message": "Halve and pit the avocados; scoop out the flesh and medium dice.",
      "secondary_message": "2 avocados"
    },
    {
      "id": 27666,
      "primary_message": "To serve, arrange the greens on plates, top with tomatoes and avocado, and drizzle with the dressing. Add chicken drumsticks to the side. Enjoy!",
      "secondary_message": null
    }
  ],
