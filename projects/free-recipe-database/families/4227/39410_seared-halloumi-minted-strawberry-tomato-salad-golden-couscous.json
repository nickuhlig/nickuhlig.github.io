  "instructions": [
    {
      "id": 612129,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous and turmeric, then stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 ½ cups whole wheat couscous\n3 pinch turmeric, ground"
    },
    {
      "id": 612130,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 612131,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels, then cut crosswise into ½-inch thick slices.",
      "secondary_message": "3 (250 g) pkgs halloumi cheese"
    },
    {
      "id": 612132,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 612133,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ (454 g) pkgs strawberries\n6 tomatoes\n1 small pkg fresh mint"
    },
    {
      "id": 612134,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n1 tbsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 612135,
      "primary_message": "Trim and halve strawberries lengthwise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 612136,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 612137,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl and stir to combine the salad. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 612138,
      "primary_message": "To serve, divide couscous and salad between plates or bowls. Top salad with halloumi and sprinkle with reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
