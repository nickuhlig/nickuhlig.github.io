  "instructions": [
    {
      "id": 612089,
      "primary_message": "In a medium saucepan, bring broth to a boil over high heat. Once boiling, remove from heat, add couscous and turmeric, then stir to combine. Cover and let stand for 10 minutes; fluff with a fork.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup whole wheat couscous\n⅛ tsp turmeric, ground"
    },
    {
      "id": 612090,
      "primary_message": "Meanwhile, preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 612091,
      "primary_message": "While the skillet heats up, pat halloumi dry with paper towels, then cut crosswise into ½-inch thick slices.",
      "secondary_message": "2 (9 oz) pkgs halloumi cheese"
    },
    {
      "id": 612092,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add the halloumi and cook, turning halfway through, until golden brown on both sides, 5-6 minutes. Remove from heat.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 612093,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (16 oz) pkg strawberries\n4 tomatoes\n1 small pkg fresh mint"
    },
    {
      "id": 612094,
      "primary_message": "Place oil, vinegar, Dijon, honey, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n2 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 612095,
      "primary_message": "Trim and halve strawberries lengthwise. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 612096,
      "primary_message": "Halve tomatoes lengthwise, then cut into ½-inch thick wedges. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 612097,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add half to the bowl and stir to combine the salad. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 612098,
      "primary_message": "To serve, divide couscous and salad between plates or bowls. Top salad with halloumi and sprinkle with reserved mint. Enjoy!",
      "secondary_message": null
    }
  ],
