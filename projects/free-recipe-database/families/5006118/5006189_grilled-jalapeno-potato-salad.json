  "instructions": [
    {
      "id": 1,
      "primary_message": "To make the dressing: In a medium bowl, whisk together vinegar, sour cream, 1 teaspoon salt, 1 teaspoon pepper, and cumin. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place potatoes in a large bowl. Add olive oil and toss to thoroughly coat potatoes. Season with salt and pepper to taste.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney 2/3 full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Alternatively, set half the burners on a gas grill to high heat. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Place jalapenos on hot side of grill and cook until lightly charred on all sides, 5 to 10 minutes. Transfer to cutting board, let cool, then deseed and finely chop jalapenos.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Grill potatoes, cut side down, over hot side of the grill until lightly browned, about 5 minutes. Move to cool side of grill, cover, and continue to cook until a paring knife can slide into potatoes with no resistance, 10 to 15 minutes more.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer potatoes to a large bowl. Add dressing and toss to thoroughly coat. Add jalapeños, green onions, and cilantro and toss again to evenly distribute. Let rest for 30 minutes. Serve at room temperature.",
      "secondary_message": null
    }
  ],
