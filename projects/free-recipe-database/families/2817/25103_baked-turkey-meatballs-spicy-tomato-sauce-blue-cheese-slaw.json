  "instructions": [
    {
      "id": 403089,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 403090,
      "primary_message": "Place tomato sauce and hot sauce in a baking dish. Stir to combine and set aside. ",
      "secondary_message": "2 (8 oz) cans tomato sauce\n3 tbsp hot sauce"
    },
    {
      "id": 403091,
      "primary_message": "Place turkey, bread crumbs, oil, garlic powder, and salt in a medium bowl. Using your hands, mix well to combine. ",
      "secondary_message": "1 ½ lb ground turkey\n⅔ cup panko bread crumbs\n2 tsp extra virgin olive oil\n1 tsp garlic powder\n1 tsp salt"
    },
    {
      "id": 403092,
      "primary_message": "Using a scant ¼-cup measure, form the turkey mixture into rounded meatballs. Transfer to the baking dish with the sauce and turn to coat.",
      "secondary_message": null
    },
    {
      "id": 403093,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake, stirring meatballs once, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 403094,
      "primary_message": "Meanwhile, wash, dry, trim, and thinly slice green onions crosswise. Place half in a clean medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 403095,
      "primary_message": "Wash, dry, trim, and thinly slice celery crosswise. Add to the bowl with the green onions. ",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 403096,
      "primary_message": "Add cabbage, dressing, and almonds to the bowl. Stir to combine the slaw. ",
      "secondary_message": "1 (14 oz) bag shredded cabbage (coleslaw mix)\n½ cup blue cheese dressing\n¼ cup almonds, sliced"
    },
    {
      "id": 403097,
      "primary_message": "To serve, divide saucy meatballs and slaw between plates. Top meatballs with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
