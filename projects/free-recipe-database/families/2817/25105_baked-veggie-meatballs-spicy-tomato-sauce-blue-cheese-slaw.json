  "instructions": [
    {
      "id": 403107,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 403108,
      "primary_message": "Place tomato sauce and hot sauce in a small baking dish. Stir to combine and set aside. ",
      "secondary_message": "1 (8 oz) can tomato sauce\n1 ½ tbsp hot sauce"
    },
    {
      "id": 403109,
      "primary_message": "Place veggie ground, bread crumbs, oil, garlic powder, and salt in a medium bowl. Using your hands, mix well to combine. ",
      "secondary_message": "8 oz veggie ground, plant based\n⅓ cup panko bread crumbs\n1 tsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 403110,
      "primary_message": "Using a scant ¼-cup measure, form the turkey mixture into rounded \"meatballs.\" Transfer to the baking dish with the sauce and turn to coat.",
      "secondary_message": null
    },
    {
      "id": 403111,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake, stirring meatballs once, until golden and cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 403112,
      "primary_message": "Meanwhile, wash, dry, trim, and thinly slice green onions crosswise. Place half in a clean medium bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 403113,
      "primary_message": "Wash, dry, trim, and thinly slice celery crosswise. Add to the bowl with the green onions. ",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 403114,
      "primary_message": "Add cabbage, dressing, and almonds to the bowl. Stir to combine the slaw. ",
      "secondary_message": "½ (14 oz) bag shredded cabbage (coleslaw mix)\n¼ cup blue cheese dressing\n⅛ cup almonds, sliced"
    },
    {
      "id": 403115,
      "primary_message": "To serve, divide saucy meatballs and slaw between plates. Top meatballs with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
