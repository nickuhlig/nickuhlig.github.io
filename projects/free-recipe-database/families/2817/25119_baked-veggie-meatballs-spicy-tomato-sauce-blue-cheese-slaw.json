  "instructions": [
    {
      "id": 403233,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 403234,
      "primary_message": "Place tomato sauce and hot sauce in a large baking dish. Stir to combine and set aside. ",
      "secondary_message": "3 (213 ml) cans tomato sauce\n¼ cup hot sauce"
    },
    {
      "id": 403235,
      "primary_message": "Place veggie ground, bread crumbs, oil, garlic powder, and salt in a large bowl. Using your hands, mix well to combine. ",
      "secondary_message": "680 g veggie ground, plant based\n1 cup panko bread crumbs\n1 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 403236,
      "primary_message": "Using a scant ¼-cup measure, form the turkey mixture into rounded \"meatballs.\" Transfer to the baking dish with the sauce and turn to coat.",
      "secondary_message": null
    },
    {
      "id": 403237,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and bake, stirring meatballs once, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 403238,
      "primary_message": "Meanwhile, wash, dry, trim, and thinly slice green onions crosswise. Place half in a clean large bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 403239,
      "primary_message": "Wash, dry, trim, and thinly slice celery crosswise. Add to the bowl with the green onions. ",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 403240,
      "primary_message": "Add cabbage, dressing, and almonds to the bowl. Stir to combine the slaw. ",
      "secondary_message": "1 ½ (397 g) bags shredded cabbage (coleslaw mix)\n¾ cup blue cheese dressing\n⅓ cup almonds, sliced"
    },
    {
      "id": 403241,
      "primary_message": "To serve, divide saucy meatballs and slaw between plates. Top meatballs with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
