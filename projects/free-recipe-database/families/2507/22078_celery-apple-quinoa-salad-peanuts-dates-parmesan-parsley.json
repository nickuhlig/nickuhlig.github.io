  "instructions": [
    {
      "id": 370341,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 370342,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "4 sticks celery\n2 Granny Smith apples\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 370343,
      "primary_message": "Place oil, vinegar, maple syrup, and spices in a medium bowl. Whisk to combine the dressing. ",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp white wine vinegar\n1 ½ tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 370344,
      "primary_message": "Peel and slice shallot crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 370345,
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370346,
      "primary_message": "Quarter, core, and thinly slice apples. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370347,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370348,
      "primary_message": "Roughly chop peanuts and dates. Add both to the bowl and set aside.",
      "secondary_message": "¼ cup peanuts, roasted unsalted\n¼ cup medjool dates, pitted"
    },
    {
      "id": 370349,
      "primary_message": "Transfer the cooked quinoa to a baking sheet pan. Spread out in an even layer and let cool for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 370350,
      "primary_message": "Finely grate Parmesan. Add to the bowl, along with the cooled quinoa, and stir to combine the salad.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 370351,
      "primary_message": "To serve, divide the salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
