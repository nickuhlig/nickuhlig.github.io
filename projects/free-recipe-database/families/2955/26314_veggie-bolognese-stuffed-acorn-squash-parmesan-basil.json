  "instructions": [
    {
      "id": 425157,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 425158,
      "primary_message": "Wash and dry acorn squash; halve lengthwise, trim ends, then scoop out the seeds. Rub the inside of the squash with oil, then season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "1 acorn squash\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 425159,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425160,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 425161,
      "primary_message": "While the skillet heats up, wash, dry, trim, and small dice celery.",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 425162,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add celery, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n1 tsp Italian seasoning\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 425163,
      "primary_message": "While the veggie ground is cooking, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. ",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 425164,
      "primary_message": "Add half of the basil (reserving the rest for garnish) and marinara sauce to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until the \"bolognese\" sauce thickens slightly, 2-3 minutes. Remove from heat and cover with a lid to keep warm.",
      "secondary_message": "½ (680 g) jar marinara sauce"
    },
    {
      "id": 425165,
      "primary_message": "To serve, divide squash halves between plates and fill with the veggie bolognese; top with cheese and reserved basil. Enjoy!",
      "secondary_message": "¼ cup Parmesan cheese, shredded"
    }
  ],
