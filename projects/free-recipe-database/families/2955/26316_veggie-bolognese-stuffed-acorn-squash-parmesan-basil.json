  "instructions": [
    {
      "id": 425175,
      "primary_message": "Preheat oven to 260°C (500°F) and place rack in the center position. Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 425176,
      "primary_message": "Wash and dry acorn squash; halve lengthwise, trim ends, then scoop out the seeds. Rub the inside of each squash with oil, then season with salt and pepper; arrange halves, cut-side down, on the baking sheet.",
      "secondary_message": "3 acorn squash\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 425177,
      "primary_message": "Place squash in the oven (it doesn't have to be fully heated) and roast until tender, so a knife can easily pierce through the flesh, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 425178,
      "primary_message": "Meanwhile, wash, dry, trim, and small dice celery.",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 425179,
      "primary_message": "Preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 425180,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add celery, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 tbsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 425181,
      "primary_message": "While the veggie ground is cooking, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. ",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 425182,
      "primary_message": "Add half of the basil (reserving the rest for garnish) and marinara sauce to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and cook until the \"bolognese\" sauce thickens slightly, 3-4 minutes. Remove from heat and cover with a lid to keep warm.",
      "secondary_message": "1 ½ (680 g) jars marinara sauce"
    },
    {
      "id": 425183,
      "primary_message": "To serve, divide squash halves between plates and fill with the veggie bolognese; top with cheese and reserved basil. Enjoy!",
      "secondary_message": "¾ cup Parmesan cheese, shredded"
    }
  ],
