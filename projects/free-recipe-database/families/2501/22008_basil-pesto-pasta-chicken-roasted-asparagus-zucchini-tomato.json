  "instructions": [
    {
      "id": 369438,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 369439,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches asparagus\n3 medium zucchini squash\n3 small pkgs grape tomatoes"
    },
    {
      "id": 369440,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 2-inch pieces. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 369441,
      "primary_message": "Trim and medium dice zucchini. Add to the baking sheets with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 369442,
      "primary_message": "Halve tomatoes and add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 369443,
      "primary_message": "Pat chicken dry with paper towels and large dice. Add to the baking sheets.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 369444,
      "primary_message": "Drizzle veggies and chicken with oil, then season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 369445,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender and chicken is cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 369446,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and return to the pan. Cover and set aside to keep warm.",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 369447,
      "primary_message": "When the veggies and chicken are done, carefully transfer them to the pot with the pasta. Add the pesto and stir to combine.",
      "secondary_message": "¾ cup basil pesto"
    },
    {
      "id": 369448,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
