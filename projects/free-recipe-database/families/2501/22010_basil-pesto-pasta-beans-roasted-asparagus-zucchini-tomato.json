  "instructions": [
    {
      "id": 369460,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 369461,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n2 medium zucchini squash\n2 small pkgs grape tomatoes"
    },
    {
      "id": 369462,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 2-inch pieces. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 369463,
      "primary_message": "Trim and medium dice zucchini; add to the baking sheet with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 369464,
      "primary_message": "Halve tomatoes and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 369465,
      "primary_message": "Drain and rinse beans; add to the baking sheet.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 369466,
      "primary_message": "Drizzle veggies and beans with oil, then season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 369467,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until beans are warmed through and veggies are fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 369468,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and return to the pot. Cover and set aside to keep warm.",
      "secondary_message": "1 tsp salt\n283 g rotini pasta"
    },
    {
      "id": 369469,
      "primary_message": "When the veggies and beans are done, carefully transfer them to the pot with the pasta. Add the pesto and stir to combine.",
      "secondary_message": "½ cup basil pesto"
    },
    {
      "id": 369470,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
