  "instructions": [
    {
      "id": 369416,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 369417,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch asparagus\n1 medium zucchini squash\n1 small pkg grape tomatoes"
    },
    {
      "id": 369418,
      "primary_message": "Snap (or cut) off woody ends of the asparagus; cut spears into 2-inch pieces. Transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 369419,
      "primary_message": "Trim and medium dice zucchini. Add to the baking sheet with the asparagus.",
      "secondary_message": null
    },
    {
      "id": 369420,
      "primary_message": "Halve tomatoes and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 369421,
      "primary_message": "Pat chicken dry with paper towels and large dice. Add to the baking sheet.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 369422,
      "primary_message": "Drizzle veggies and chicken with oil, then season with spices. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 369423,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender and chicken is cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 369424,
      "primary_message": "Meanwhile, fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain and return to the pan. Cover and set aside to keep warm.",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 369425,
      "primary_message": "When the veggies and chicken are done, carefully transfer them to the pan with the pasta. Add the pesto and stir to combine.",
      "secondary_message": "¼ cup basil pesto"
    },
    {
      "id": 369426,
      "primary_message": "To serve, divide pasta between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
