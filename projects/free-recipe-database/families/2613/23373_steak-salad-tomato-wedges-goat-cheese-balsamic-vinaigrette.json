  "instructions": [
    {
      "id": 383716,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 383717,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 383718,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 383719,
      "primary_message": "Meanwhile, wash, dry, and chop or tear lettuce into bite-sized pieces. Place in a large bowl.",
      "secondary_message": "6 hearts romaine hearts"
    },
    {
      "id": 383720,
      "primary_message": "Wash, dry, and slice tomatoes into wedges. Add to the bowl with the lettuce.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 383721,
      "primary_message": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 383722,
      "primary_message": "Crumble goat cheese into the bowl.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 383723,
      "primary_message": "Add vinaigrette to the bowl and toss to combine the salad.",
      "secondary_message": "¾ cup balsamic vinaigrette"
    },
    {
      "id": 383724,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 383725,
      "primary_message": "To serve, divide salad between plates or bowls and top with steak. Enjoy!",
      "secondary_message": null
    }
  ],
