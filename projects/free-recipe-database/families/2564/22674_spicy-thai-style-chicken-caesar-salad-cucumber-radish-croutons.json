  "instructions": [
    {
      "id": 376304,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 376305,
      "primary_message": "Cut bread into 1-inch cubes and transfer to a large baking sheet pan. Drizzle with oil and season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "6 slices whole grain bread\n2 tbsp extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp coriander, ground\n3 pinch salt"
    },
    {
      "id": 376306,
      "primary_message": "Place baking sheet in the oven and broil, tossing halfway through, until the croutons are golden and toasted, 3-4 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 376307,
      "primary_message": "Meanwhile, place dressing and curry paste in a large bowl; whisk to combine.",
      "secondary_message": "¾ cup Caesar dressing\n2 tbsp Thai curry paste, red"
    },
    {
      "id": 376308,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 376309,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ bunches radish\n6 hearts romaine hearts"
    },
    {
      "id": 376310,
      "primary_message": "Trim and quarter cucumbers lengthwise, then slice crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 376311,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 376312,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 376313,
      "primary_message": "Place chickens on the cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, add to the bowl, and toss to combine the salad.",
      "secondary_message": "1 ½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 376314,
      "primary_message": "To serve, divide salad between plates or bowls and top with croutons. Enjoy!",
      "secondary_message": null
    }
  ],
