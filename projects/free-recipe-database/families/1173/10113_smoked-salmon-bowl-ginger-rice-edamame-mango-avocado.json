  "instructions": [
    {
      "id": 161190,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ English cucumber\n½ bunch radish\n½ mango\n1 avocado"
    },
    {
      "id": 161191,
      "primary_message": "Peel and grate or mince the ginger.",
      "secondary_message": null
    },
    {
      "id": 161192,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add ginger, water, and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 161193,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 161194,
      "primary_message": "Meanwhile, place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "¾ cup edamame"
    },
    {
      "id": 161195,
      "primary_message": "Combine vinegar, sesame seeds, sugar, and salt in a medium bowl; whisk to dissolve the sugar.",
      "secondary_message": "1 tbsp rice vinegar\n1 tsp sesame seeds\n1 tsp brown sugar\n⅛ tsp salt"
    },
    {
      "id": 161196,
      "primary_message": "Trim cucumber and thinly slice crosswise into rounds. Add to the bowl with the vinegar mixture.",
      "secondary_message": null
    },
    {
      "id": 161197,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl with the cucumber. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 161198,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides. Medium dice and set aside.",
      "secondary_message": null
    },
    {
      "id": 161199,
      "primary_message": "Combine chili-garlic sauce and mayonnaise in a small bowl; whisk until smooth.",
      "secondary_message": "1 tsp chili-garlic sauce\n2 tbsp mayonnaise"
    },
    {
      "id": 161200,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out, keeping avocado halves intact. Fill avocado halves with spicy mayo.",
      "secondary_message": null
    },
    {
      "id": 161201,
      "primary_message": "Divide rice, edamame, mango, and cucumber-radish salad between bowls; top with smoked salmon and an avocado half. Serve with soy sauce on the side and enjoy!",
      "secondary_message": "1 (113 g) pkg smoked salmon\n2 tsp soy sauce"
    }
  ],
