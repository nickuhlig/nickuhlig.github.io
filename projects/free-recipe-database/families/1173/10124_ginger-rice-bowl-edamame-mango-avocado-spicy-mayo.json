  "instructions": [
    {
      "id": 161322,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 ½ English cucumbers\n1 ½ bunches radish\n1 ½ mangoes\n3 avocados"
    },
    {
      "id": 161323,
      "primary_message": "Peel and grate or mince the ginger.",
      "secondary_message": null
    },
    {
      "id": 161324,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add ginger, water, and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n¾ tsp salt"
    },
    {
      "id": 161325,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 161326,
      "primary_message": "Meanwhile, place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "4 ½ cups edamame"
    },
    {
      "id": 161327,
      "primary_message": "Combine vinegar, sesame seeds, sugar, and salt in a medium bowl; whisk to dissolve the sugar.",
      "secondary_message": "3 tbsp rice vinegar\n1 tbsp sesame seeds\n1 tbsp brown sugar\n½ tsp salt"
    },
    {
      "id": 161328,
      "primary_message": "Trim cucumbers and thinly slice crosswise into rounds. Add to the bowl with the vinegar mixture.",
      "secondary_message": null
    },
    {
      "id": 161329,
      "primary_message": "Trim off and discard tops and root ends of radishes; thinly slice and add to the bowl with the cucumber. Stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 161330,
      "primary_message": "Peel mangos and slice flesh away from the pit, starting with the flat sides. Medium dice and set aside.",
      "secondary_message": null
    },
    {
      "id": 161331,
      "primary_message": "Combine chili-garlic sauce and mayonnaise in a small bowl; whisk until smooth.",
      "secondary_message": "1 tbsp chili-garlic sauce\n⅓ cup vegan mayonnaise"
    },
    {
      "id": 161332,
      "primary_message": "Halve and pit the avocados. Slice thinly while still in skin, then scoop out, keeping avocado halves intact. Fill avocado halves with spicy mayo.",
      "secondary_message": null
    },
    {
      "id": 161333,
      "primary_message": "Divide rice, edamame, mango, and cucumber-radish salad between bowls; top with an avocado half. Serve with soy sauce on the side and enjoy!",
      "secondary_message": "2 tbsp soy sauce"
    }
  ],
