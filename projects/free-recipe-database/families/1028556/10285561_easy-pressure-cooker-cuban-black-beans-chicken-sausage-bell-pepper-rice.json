  "instructions": [
    {
      "primary_message": "Slice sausages crosswise into thin rounds.\n\n",
      "secondary_message": "4 Italian chicken sausage, pre-cooked"
    },
    {
      "primary_message": "Place sausage, pepper strips, rice, broth, tomato sauce, garlic, and spices in a 6-quart pressure cooker insert. Stir to combine.\n\n",
      "secondary_message": "1 (396 g) bag frozen pepper strips\n1 ½ cups jasmine rice\n1 ½ cups chicken or vegetable broth\n213 ml tomato sauce\n1 tbsp minced garlic\n1 ½ tsp cumin, ground\n1 ½ tsp oregano, dried\n½ tsp salt\n½ tsp black pepper\n¼ tsp cayenne pepper"
    },
    {
      "primary_message": "Lock lid and set pressure to cook on HIGH for 10 minutes. Once done, allow the pressure to release naturally for 10 minutes, then carefully release any remaining pressure and remove the lid. \n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the pressure is releasing, drain and rinse beans. Add to the insert and stir to combine. Return lid to the pressure cooker and let sit until beans are warmed through, 3-4 minutes. \n\n",
      "secondary_message": "2 (258 g) can black beans"
    },
    {
      "primary_message": "Meanwhile, wash and dry cilantro. Using a clean cutting board, shave leaves off the stems; discard stems and roughly chop the leaves.\n\n",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "primary_message": "To serve, divide beans, sausage, bell pepper, and rice between plates or bowls. Sprinkle with cilantro and enjoy!",
      "secondary_message": null
    }
  ],
