  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve the pitted sour cherries.",
      "secondary_message": "3 pint pitted sour cherries"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 425°F. In a bowl, mix sour cherries, sugar, and cornstarch. Toss together and allow it to sit for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir cherry mixture until cornstarch is completely hydrated and there are no lumps of starch. Allow mixture to sit 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour cherry mixture into shaped, chilled bottom crust. Use rolled-out, chilled dough to design your top crust: (here are a few top-crust ideas.) Chill shaped pie for 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Brush top crust with egg wash and sprinkle with granulated sugar. Bake at 425°F for 15 minutes, rotating halfway through, then lower oven temperature to 350°F and continue to bake for approximately 30 minutes, rotating again halfway through. Bake until crust is golden brown and filling is bubbling though entire pie. Allow to cool for at least one hour before serving.",
      "secondary_message": null
    }
  ],
