  "instructions": [
    {
      "id": 470029,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 470030,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "6 green bell peppers\n1 small bunch green onions (scallions)\n6 sticks celery\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 470031,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a large baking sheet pan, drizzle with oil, and season with salt; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 470032,
      "primary_message": "Meanwhile, place mayo, vinegar, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp apple cider vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 470033,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 470034,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the dressing. (Reserve remaining green onions for the next step.)",
      "secondary_message": null
    },
    {
      "id": 470035,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add remaining green onions, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n¾ tsp salt\n¾ tsp black pepper\n½ tsp oregano, dried"
    },
    {
      "id": 470036,
      "primary_message": "Meanwhile, trim and thinly slice celery crosswise. Add to the bowl with the dressing, along with mixed greens and half of the blue cheese. Toss to combine the salad. (Reserve remaining blue cheese for the next step.)",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled blue cheese"
    },
    {
      "id": 470037,
      "primary_message": "When the veggie ground is done, add remaining blue cheese and hot sauce to the skillet. Stir to combine the filling and remove from heat. ",
      "secondary_message": "3 tbsp hot sauce"
    },
    {
      "id": 470038,
      "primary_message": "Divide peppers between plates, then stuff with veggie ground filling and drizzle with additional hot sauce. Serve with salad on the side and enjoy!",
      "secondary_message": "2 tbsp hot sauce"
    }
  ],
