  "instructions": [
    {
      "id": 469979,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 469980,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 green bell peppers\n½ small bunch green onions (scallions)\n2 sticks celery\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 469981,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, and season with salt; arrange cut-side down. Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 469982,
      "primary_message": "Meanwhile, place mayo, vinegar, salt, and pepper in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp apple cider vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 469983,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 469984,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add half to the bowl with the dressing. (Reserve remaining green onions for the next step.)",
      "secondary_message": null
    },
    {
      "id": 469985,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add remaining green onions, turkey, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ lb ground turkey\n½ tsp salt\n¼ tsp black pepper\n¼ tsp oregano, dried"
    },
    {
      "id": 469986,
      "primary_message": "Meanwhile, trim and thinly slice celery crosswise. Add to the bowl with the dressing, along with mixed greens and half of the blue cheese. Toss to combine the salad. (Reserve remaining blue cheese for the next step.)",
      "secondary_message": "½ (4 oz) pkg crumbled blue cheese"
    },
    {
      "id": 469987,
      "primary_message": "When the turkey is done, add remaining blue cheese and hot sauce to the skillet. Stir to combine the filling and remove from heat. ",
      "secondary_message": "1 tbsp hot sauce"
    },
    {
      "id": 469988,
      "primary_message": "Divide peppers between plates, then stuff with turkey filling and drizzle with additional hot sauce. Serve with salad on the side and enjoy!",
      "secondary_message": "2 tsp hot sauce"
    }
  ],
