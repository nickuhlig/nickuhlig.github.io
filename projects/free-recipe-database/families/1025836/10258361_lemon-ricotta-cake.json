  "instructions": [
    {
      "primary_message": "Preheat oven to 350-degrees F and grease a 9-inch springform pan with a couple of extra teaspoons of butter.",
      "secondary_message": null
    },
    {
      "primary_message": " In mixing bowl, cream together butter, oil and sugar. Add in the ricotta cheese and blend for about 4 minutes (mixture will be light and airy). Beat in the eggs and vanilla, then the lemon juice and zest.",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, whisk both flours with baking soda and salt. Add dry ingredients to the batter and beat just until well blended. Pour batter into the springform pan and bake for about 60 minutes. Let it rest for 15 minutes before loosening the collar and letting the cake cool completely.",
      "secondary_message": null
    },
    {
      "primary_message": "If desired, sprinkle powdered sugar on top.",
      "secondary_message": null
    }
  ],
