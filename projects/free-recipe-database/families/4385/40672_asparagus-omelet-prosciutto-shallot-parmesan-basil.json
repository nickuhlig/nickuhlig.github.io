  "instructions": [
    {
      "id": 628756,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Place in a medium bowl.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 628757,
      "primary_message": "Wash, dry, and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the asparagus.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 628758,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 628759,
      "primary_message": "While the skillet heats up, peel and mince shallot. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 628760,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, basil, and spices; cook, stirring occasionally, until veggies are fork-tender, 4-5 minutes. Transfer to a plate and set aside. (Reserve bowl for the next step and skillet for later use.)",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp garlic powder\n¼ tsp black pepper\n⅛ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 628761,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl, then whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 628762,
      "primary_message": "Cut or tear prosciutto into bite-sized pieces; finely grate Parmesan. Set both aside.",
      "secondary_message": "8 slices prosciutto\n4 oz Parmesan cheese"
    },
    {
      "id": 628763,
      "primary_message": "Wipe the skillet clean with paper towels; return to medium-low heat, add more oil, and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 628764,
      "primary_message": "Add ½ of the eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull cooked edges towards center of the pan. Then tilt the pan, allowing uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 628765,
      "primary_message": "Arrange ½ of the veggies, prosciutto, and Parmesan over one side of the omelet. Fold the omelet in half and continue to cook until filling is warmed through and cheese starts to melt, 1-2 minutes more. Transfer to another plate and loosely cover with aluminum foil to keep warm.",
      "secondary_message": null
    },
    {
      "id": 628766,
      "primary_message": "Add more oil to the skillet, then repeat with remaining eggs and veggies.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 628767,
      "primary_message": "To serve, cut omelets in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
