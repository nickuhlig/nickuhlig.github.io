  "instructions": [
    {
      "id": 628780,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; cut spears into 1-inch long pieces. Place in a medium bowl.",
      "secondary_message": "½ small bunch asparagus"
    },
    {
      "id": 628781,
      "primary_message": "Wash, dry, and pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl with the asparagus.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 628782,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 628783,
      "primary_message": "While the skillet heats up, peel and mince shallot. Add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 628784,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, basil, and spices; cook, stirring occasionally, until veggies are fork-tender, 4-5 minutes. Transfer to a plate and set aside. (Reserve bowl for the next step and skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 628785,
      "primary_message": "Meanwhile, place eggs, salt, and pepper in the reserved bowl, then whisk to combine.",
      "secondary_message": "6 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 628786,
      "primary_message": "Finely grate Parmesan. Set aside.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 628787,
      "primary_message": "Wipe the skillet clean with paper towels; return to medium-low heat, add more oil, and swirl to coat the bottom.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 628788,
      "primary_message": "Add eggs to the skillet and swirl to cover the bottom. As eggs begin to set, use a spatula to pull the cooked edges towards the center of the pan. Then tilt the pan, allowing uncooked egg to move to the edges. Cook until just set, pressing the eggs into a smooth layer on the bottom of the skillet.",
      "secondary_message": null
    },
    {
      "id": 628789,
      "primary_message": "Arrange veggies and Parmesan over one side of the omelet. Fold the omelet in half and continue to cook until filling is warmed through and cheese starts to melt, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 628790,
      "primary_message": "To serve, cut omelet in half and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
