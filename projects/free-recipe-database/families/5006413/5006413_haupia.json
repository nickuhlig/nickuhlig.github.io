  "instructions": [
    {
      "id": 1,
      "primary_message": "Butter an 8-inch square baking dish. Add coconut milk, milk, and vanilla to blender. Blend for about 30 second to thoroughly combine.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour mixture into a medium saucepan and whisk in sugar and corn starch. Heat over medium while whisking constantly until mixture begins to thicken. Reduce heat to low and cook for 10 more minutes, continuously whisking. Pour into prepared baking dish and gently shake back and forth to settle. Let cool uncovered on the counter for about 10 minutes then cover with plastic wrap and refrigerate until firm, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Using a sharp knife, cut into 16 equal-sized squares. Sprinkle with toasted coconut, if desired. Serve cold.",
      "secondary_message": null
    }
  ],
