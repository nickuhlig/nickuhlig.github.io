  "instructions": [
    {
      "id": 1,
      "primary_message": "Place orange juice, tangerines, yogurt, honey, and ice cubes in a blender. Pulse a few times on \"ice crush\" or similar high setting to begin to break down ice cubes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Blend for 30 seconds on high until the mixture is smooth and frothy. Divide between two glasses, adding extra ice cubes for garnish if desired. Serve immediately.",
      "secondary_message": null
    }
