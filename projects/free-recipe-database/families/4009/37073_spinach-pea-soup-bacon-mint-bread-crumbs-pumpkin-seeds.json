  "instructions": [
    {
      "id": 581011,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 581012,
      "primary_message": "While the pot heats up, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 leeks\n1 small pkg fresh mint\n2 (142 g) pkgs baby spinach"
    },
    {
      "id": 581013,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bread crumbs and pumpkin seeds; toast, stirring frequently, until bread crumbs are golden brown, 3-4 minutes. Transfer to a small bowl and set aside. (Reserve pot for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ cup panko bread crumbs\n¼ cup pumpkin seeds"
    },
    {
      "id": 581014,
      "primary_message": "Medium dice bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 581015,
      "primary_message": "Return pot to medium-high heat. Add bacon and cook, stirring occasionally, until crispy, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 581016,
      "primary_message": "Meanwhile, using a clean cutting board, trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 581017,
      "primary_message": "When the bacon is done, add leek, salt, and pepper to the pot. Cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 581018,
      "primary_message": "Add broth, milk, and peas to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce to a simmer and cook, stirring occasionally, until peas are tender, 6-8 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth\n237 ml whole milk\n4 cups frozen peas"
    },
    {
      "id": 581019,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 581020,
      "primary_message": "When the peas are tender, add mint and spinach to the pot in handfuls, waiting for the greens to wilt slightly before adding the next handful. Continue to cook, stirring frequently, until spinach is very tender, 1-2 minutes more. Remove from heat, add vinegar, and stir to combine.",
      "secondary_message": "2 tsp apple cider vinegar"
    },
    {
      "id": 581021,
      "primary_message": "Using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
      "secondary_message": null
    },
    {
      "id": 581022,
      "primary_message": "To serve, divide soup between bowls. Sprinkle with bread crumbs and pumpkin seeds. Enjoy!",
      "secondary_message": null
    }
  ],
