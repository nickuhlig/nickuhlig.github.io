  "instructions": [
    {
      "id": 580999,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 581000,
      "primary_message": "While the pan heats up, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 leek\n½ small pkg fresh mint\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 581001,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add bread crumbs and pumpkin seeds; toast, stirring frequently, until bread crumbs are golden brown, 3-4 minutes. Transfer to a small bowl and set aside. (Reserve pan for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ cup panko bread crumbs\n⅛ cup pumpkin seeds"
    },
    {
      "id": 581002,
      "primary_message": "Medium dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 581003,
      "primary_message": "Return pan to medium-high heat. Add bacon and cook, stirring occasionally, until crispy, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 581004,
      "primary_message": "Meanwhile, using a clean cutting board, trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 581005,
      "primary_message": "When the bacon is done, add leek, salt, and pepper to the pan. Cook, stirring occasionally, until softened, 3-4 minutes. ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 581006,
      "primary_message": "Add broth, milk, and peas to the pan; stir to combine the soup and bring to a boil. Once boiling, reduce to a simmer and cook, stirring occasionally, until peas are tender, 6-8 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n118 ml (½ cup) whole milk\n2 cups frozen peas"
    },
    {
      "id": 581007,
      "primary_message": "Meanwhile, pick mint leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 581008,
      "primary_message": "When the peas are tender, add mint and spinach to the pan in handfuls, waiting for the greens to wilt slightly before adding the next handful. Continue to cook, stirring frequently, until spinach is very tender, 1-2 minutes more. Remove from heat, add vinegar, and stir to combine.",
      "secondary_message": "1 tsp apple cider vinegar"
    },
    {
      "id": 581009,
      "primary_message": "Using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": null
    },
    {
      "id": 581010,
      "primary_message": "To serve, divide soup between bowls. Sprinkle with bread crumbs and pumpkin seeds. Enjoy!",
      "secondary_message": null
    }
  ],
