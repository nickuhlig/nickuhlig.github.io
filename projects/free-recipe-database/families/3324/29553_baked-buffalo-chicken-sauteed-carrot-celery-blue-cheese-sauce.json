  "instructions": [
    {
      "id": 471345,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 471346,
      "primary_message": "Place mayo and hot sauce in a small bowl, then stir to combine the spicy mayo.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp hot sauce"
    },
    {
      "id": 471347,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Arrange on the baking sheet, then season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471348,
      "primary_message": "Spread spicy mayo over the top side of the chicken, then sprinkle with bread crumbs, pressing gently to adhere.",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 471349,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 471350,
      "primary_message": "Meanwhile, wash, dry, and peel carrots. Using a clean cutting board, trim and slice crosswise into ¼-inch thick rounds. Place in a medium bowl.",
      "secondary_message": "9 medium carrots"
    },
    {
      "id": 471351,
      "primary_message": "Wash, dry, trim, and slice celery crosswise into ½-inch thick pieces. Add to the bowl with the carrot.",
      "secondary_message": "9 sticks celery"
    },
    {
      "id": 471352,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 471353,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; sauté until fork-tender, 6-7 minutes. Remove from heat and cover to keep warm. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471354,
      "primary_message": "Meanwhile, place blue cheese, yogurt, mayo, vinegar, sugar, and spices in the reserved bowl. Stir to combine the blue cheese sauce.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled blue cheese\n1 cup plain Greek yogurt\n3 tbsp mayonnaise\n1 tbsp apple cider vinegar\n1 tbsp brown sugar\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471355,
      "primary_message": "To serve, divide chicken and veggies between plates. Drizzle with blue cheese sauce and additional hot sauce. Enjoy!",
      "secondary_message": "3 tbsp hot sauce"
    }
  ],
