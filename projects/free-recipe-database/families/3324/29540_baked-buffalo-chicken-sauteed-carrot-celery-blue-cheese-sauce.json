  "instructions": [
    {
      "id": 471196,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 471197,
      "primary_message": "Place mayo and hot sauce in a small bowl, then stir to combine the spicy mayo.",
      "secondary_message": "3 tbsp mayonnaise\n4 tsp hot sauce"
    },
    {
      "id": 471198,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Arrange on the baking sheet, then season with salt and pepper on both sides.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471199,
      "primary_message": "Spread spicy mayo over the top side of the chicken, then sprinkle with bread crumbs, pressing gently to adhere.",
      "secondary_message": "½ cup panko bread crumbs"
    },
    {
      "id": 471200,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 471201,
      "primary_message": "Meanwhile, wash, dry, and peel carrots. Using a clean cutting board, trim and slice crosswise into ¼-inch thick rounds. Place in a medium bowl.",
      "secondary_message": "6 medium carrots"
    },
    {
      "id": 471202,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 471203,
      "primary_message": "While the skillet heats up, wash, dry, trim, and slice celery crosswise into ½-inch thick pieces. Add to the bowl with the carrot.",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 471204,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; sauté until fork-tender, 5-6 minutes. Remove from heat and cover to keep warm. (Reserve bowl for the next step.)",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp onion powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 471205,
      "primary_message": "Meanwhile, place blue cheese, yogurt, mayo, vinegar, sugar, and spices in the reserved bowl. Stir to combine the blue cheese sauce.",
      "secondary_message": "1 (4 oz) pkg crumbled blue cheese\n⅔ cup plain Greek yogurt\n2 tbsp mayonnaise\n2 tsp apple cider vinegar\n2 tsp brown sugar\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 471206,
      "primary_message": "To serve, divide chicken and veggies between plates. Drizzle with blue cheese sauce and additional hot sauce. Enjoy!",
      "secondary_message": "2 tbsp hot sauce"
    }
  ],
