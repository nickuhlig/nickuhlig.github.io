  "instructions": [
    {
      "id": 471356,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 471357,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 471358,
      "primary_message": "Place mayo and hot sauce in a small bowl, then stir to combine the spicy mayo.",
      "secondary_message": "1 ½ tbsp mayonnaise\n2 tsp hot sauce"
    },
    {
      "id": 471359,
      "primary_message": "Cut tofu planks in half crosswise. Wipe baking sheet dry with paper towels, then coat with a thin layer of oil. Return tofu to the baking sheet, then season with salt and pepper on both sides.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 471360,
      "primary_message": "Spread spicy mayo over the top side of the tofu, then sprinkle with bread crumbs, pressing gently to adhere.",
      "secondary_message": "¼ cup panko bread crumbs"
    },
    {
      "id": 471361,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake until topping is golden and crispy, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 471362,
      "primary_message": "Meanwhile, wash, dry, peel, and trim carrots; slice crosswise into ¼-inch thick rounds. Place in a medium bowl.",
      "secondary_message": "3 medium carrots"
    },
    {
      "id": 471363,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 471364,
      "primary_message": "While the skillet heats up, wash, dry, trim, and slice celery crosswise into ½-inch thick pieces. Add to the bowl with the carrot.",
      "secondary_message": "3 sticks celery"
    },
    {
      "id": 471365,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices; sauté until fork-tender, 5-6 minutes. Remove from heat and cover to keep warm. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 471366,
      "primary_message": "Meanwhile, place blue cheese, yogurt, mayo, vinegar, sugar, and spices in the reserved bowl. Stir to combine the blue cheese sauce.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese\n⅓ cup plain Greek yogurt\n1 tbsp mayonnaise\n1 tsp apple cider vinegar\n1 tsp brown sugar\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 471367,
      "primary_message": "To serve, divide tofu and veggies between plates. Drizzle with blue cheese sauce and additional hot sauce. Enjoy!",
      "secondary_message": "1 tbsp hot sauce"
    }
  ],
