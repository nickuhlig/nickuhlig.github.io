  "instructions": [
    {
      "id": 623679,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 623680,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 bunch radish\n½ small bunch cilantro\n1 lime\n½ jalapeño pepper\n1 avocado"
    },
    {
      "id": 623681,
      "primary_message": "Peel, trim, and coarsely grate carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 623682,
      "primary_message": "Trim and cut radishes into matchsticks. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 623683,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 623684,
      "primary_message": "Juice half of the lime into the bowl. Add salt and pepper, then stir to combine the slaw. Set aside. (Reserve remaining lime for later use.)",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623685,
      "primary_message": "Place oil, sugar, and spices in a small bowl. Stir to combine the spice oil.",
      "secondary_message": "1 tsp extra virgin olive oil\n½ tsp brown sugar\n½ tsp smoked paprika\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp cayenne pepper"
    },
    {
      "id": 623686,
      "primary_message": "Pat salmon dry with paper towels, transfer to the baking sheet, and rub the top side with spice oil. Place salmon in the oven (it doesn't have to be fully heated) and bake until cooked through, 8-10 minutes. Remove from oven. (Reserve bowl for the next step.)",
      "secondary_message": "⅓ kg salmon fillet"
    },
    {
      "id": 623687,
      "primary_message": "Meanwhile, juice remaining lime into the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 623688,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 623689,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh. Add to the bowl, along with yogurt, salt, and pepper, then mash with a fork or potato masher until smooth. Set yogurt guacamole aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 623690,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 623691,
      "primary_message": "Flake salmon with a fork.",
      "secondary_message": null
    },
    {
      "id": 623692,
      "primary_message": "To serve, divide tortillas between plates, then fill with guacamole, slaw, and salmon. Enjoy!",
      "secondary_message": null
    }
  ],
