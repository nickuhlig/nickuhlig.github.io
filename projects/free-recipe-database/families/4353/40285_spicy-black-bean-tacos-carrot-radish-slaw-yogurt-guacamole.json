  "instructions": [
    {
      "id": 623653,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n2 bunches radish\n1 small bunch cilantro\n2 limes\n1 jalapeño pepper\n2 avocados"
    },
    {
      "id": 623654,
      "primary_message": "Peel, trim, and coarsely grate carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 623655,
      "primary_message": "Trim and cut radishes into matchsticks. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 623656,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 623657,
      "primary_message": "Juice one lime into the bowl. Add salt and pepper, then stir to combine the slaw. Set aside. (Reserve remaining lime for later use.)",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 623658,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623659,
      "primary_message": "While the skillet heats up, drain and rinse beans. Pat dry with paper towels.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 623660,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans, sugar, and spices, then stir to combine; cook, stirring occasionally, until tender and warmed through, 5-7 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp brown sugar\n1 tsp salt\n1 tsp smoked paprika\n1 tsp garlic powder\n¼ tsp cayenne pepper"
    },
    {
      "id": 623661,
      "primary_message": "Meanwhile, juice reserved lime into another medium bowl.",
      "secondary_message": null
    },
    {
      "id": 623662,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 623663,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Add to the bowl, along with yogurt, salt, and pepper, then mash with a fork or potato masher until smooth. Set yogurt guacamole aside.",
      "secondary_message": "½ cup plain Greek yogurt\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623664,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 623665,
      "primary_message": "To serve, divide tortillas between plates, then fill with guacamole, slaw, and beans. Enjoy!",
      "secondary_message": null
    }
  ],
