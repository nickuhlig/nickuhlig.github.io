  "instructions": [
    {
      "id": 623666,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 bunches radish\n1 small bunch cilantro\n3 limes\n1 ½ jalapeño peppers\n3 avocados"
    },
    {
      "id": 623667,
      "primary_message": "Peel, trim, and coarsely grate carrots. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 623668,
      "primary_message": "Trim and cut radishes into matchsticks. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 623669,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 623670,
      "primary_message": "Juice half of the limes into the bowl. Add salt and pepper, then stir to combine the slaw. Set aside. (Reserve remaining limes for later use.)",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 623671,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623672,
      "primary_message": "While the skillet heats up, drain and rinse beans. Pat dry with paper towels.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 623673,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add beans, sugar, and spices, then stir to combine; cook, stirring occasionally, until tender and warmed through, 7-8 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp brown sugar\n1 ½ tsp salt\n1 ½ tsp smoked paprika\n1 ½ tsp garlic powder\n¼ tsp cayenne pepper"
    },
    {
      "id": 623674,
      "primary_message": "Meanwhile, juice reserved limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 623675,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 623676,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Add to the bowl, along with yogurt, salt, and pepper, then mash with a fork or potato masher until smooth. Set yogurt guacamole aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623677,
      "primary_message": "Warm tortillas in another skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 623678,
      "primary_message": "To serve, divide tortillas between plates, then fill with guacamole, slaw, and beans. Enjoy!",
      "secondary_message": null
    }
  ],
