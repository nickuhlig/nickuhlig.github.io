  "instructions": [
    {
      "id": 623707,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 623708,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 bunches radish\n1 small bunch cilantro\n3 limes\n1 ½ jalapeño peppers\n3 avocados"
    },
    {
      "id": 623709,
      "primary_message": "Peel, trim, and coarsely grate carrots. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 623710,
      "primary_message": "Trim and cut radishes into matchsticks. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 623711,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 623712,
      "primary_message": "Juice half of the limes into the bowl. Add salt and pepper, then stir to combine the slaw. Set aside. (Reserve remaining limes for later use.)",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 623713,
      "primary_message": "Place oil, sugar, and spices in a small bowl. Stir to combine the spice oil.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp brown sugar\n1 ½ tsp smoked paprika\n1 ½ tsp garlic powder\n¾ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 623714,
      "primary_message": "Pat salmon dry with paper towels, transfer to the baking sheet, and rub the top side with spice oil. Place salmon in the oven (it doesn't have to be fully heated) and bake until cooked through, 8-10 minutes. Remove from oven. ",
      "secondary_message": "1.02 kg salmon fillet"
    },
    {
      "id": 623715,
      "primary_message": "Meanwhile, juice remaining limes into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 623716,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the lime juice. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 623717,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh. Add to the bowl, along with yogurt, salt, and pepper, then mash with a fork or potato masher until smooth. Set yogurt guacamole aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623718,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 623719,
      "primary_message": "Flake salmon with a fork.",
      "secondary_message": null
    },
    {
      "id": 623720,
      "primary_message": "To serve, divide tortillas between plates, then fill with guacamole, slaw, and salmon. Enjoy!",
      "secondary_message": null
    }
  ],
