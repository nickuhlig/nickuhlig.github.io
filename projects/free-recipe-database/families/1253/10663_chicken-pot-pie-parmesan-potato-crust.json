  "instructions": [
    {
      "id": 200057,
      "primary_message": "Preheat oven to 425°F. ",
      "secondary_message": null
    },
    {
      "id": 200058,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium red potato\n1 medium carrot\n1 stick celery"
    },
    {
      "id": 200059,
      "primary_message": "Slice potato, using a mandoline or knife, into very thin rounds. Coat the bottom of a baking sheet pan with oil. Add potatoes in a single layer, and bake until tender; 15-20 minutes. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 200060,
      "primary_message": "Meanwhile, peel, trim, and small dice the carrot. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 200061,
      "primary_message": "Trim and discard ends of the celery; small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200062,
      "primary_message": "Peel and small dice the onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 200063,
      "primary_message": "Heat a medium saucepan over medium-high heat. Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 200064,
      "primary_message": "Add carrots, celery, onion, and spices to the pan. Cook, stirring occasionally, while you prep the chicken.",
      "secondary_message": "½ tsp thyme\n½ tsp rosemary\n½ tsp sage\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 200065,
      "primary_message": "Cut chicken into bite-sized pieces and add to the pan with the vegetables. Cook, stirring occasionally, until vegetables are tender and chicken is cooked through, 5-7 minutes.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 200066,
      "primary_message": "Add peas, corn, and flour, stirring to coat. Add broth and Worcestershire sauce; bring to a simmer and cook, stirring occasionally, until sauce has thickened, 2-3 minutes.",
      "secondary_message": "¼ cup frozen peas\n¼ cup frozen corn\n1 ½ tbsp all-purpose flour\n6 fl oz (¾ cup) chicken or vegetable broth\n1 tsp Worcestershire sauce"
    },
    {
      "id": 200067,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 200068,
      "primary_message": "Carefully pour chicken and vegetable mixture into a small baking dish and use tongs to top with the sliced, par-baked, potatoes. Cover potatoes evenly with Parmesan. ",
      "secondary_message": null
    },
    {
      "id": 200069,
      "primary_message": "Place in the oven and bake for 6 minutes, then increase oven temperature to broil on high. Broil for 2-3 minutes or until bubbly and potato topping is golden brown. Remove from oven and let rest 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 200070,
      "primary_message": "To serve, divide pot pie between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
