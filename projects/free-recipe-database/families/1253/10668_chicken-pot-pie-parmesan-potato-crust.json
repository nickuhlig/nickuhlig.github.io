  "instructions": [
    {
      "id": 200127,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 200128,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium red potatoes\n3 medium carrots\n3 sticks celery"
    },
    {
      "id": 200129,
      "primary_message": "Slice potatoes, using a mandoline or knife, into very thin rounds. Coat the bottom of a large baking sheet pan with oil. Add potatoes in a single layer, and bake until tender; 15-20 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 200130,
      "primary_message": "Meanwhile, peel, trim, and small dice the carrots. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 200131,
      "primary_message": "Trim and discard ends of the celery; small dice and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 200132,
      "primary_message": "Peel and small dice the onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 200133,
      "primary_message": "Heat a large pot over medium-high heat. Once the pot is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 200134,
      "primary_message": "Add carrots, celery, onion, and spices to the pot. Cook, stirring occasionally, while you prep the chicken.",
      "secondary_message": "1 ½ tsp thyme\n1 ½ tsp rosemary\n1 ½ tsp sage\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 200135,
      "primary_message": "Cut chicken into bite-sized pieces and add to the pot with the vegetables. Cook, stirring occasionally, until vegetables are tender and chicken is cooked through, 7-9 minutes.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 200136,
      "primary_message": "Add peas, corn, and flour, stirring to coat. Add broth and Worcestershire sauce; bring to a simmer and cook, stirring occasionally, until sauce has thickened, 4-5 minutes.",
      "secondary_message": "¾ cup frozen peas\n¾ cup frozen corn\n5 tbsp all-purpose flour\n532 ml chicken or vegetable broth\n1 tbsp Worcestershire sauce"
    },
    {
      "id": 200137,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 200138,
      "primary_message": "Carefully pour chicken and vegetable mixture into a large baking dish and use tongs to top with the sliced, par-baked, potatoes. Cover potatoes evenly with Parmesan. ",
      "secondary_message": null
    },
    {
      "id": 200139,
      "primary_message": "Place in the oven and bake for 8 minutes, then increase oven temperature to broil on high. Broil for 2-3 minutes or until bubbly and potato topping is golden brown. Remove from oven and let rest 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 200140,
      "primary_message": "To serve, divide pot pie between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
