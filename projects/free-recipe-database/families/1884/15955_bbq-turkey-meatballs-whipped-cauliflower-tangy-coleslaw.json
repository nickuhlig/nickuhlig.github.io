  "instructions": [
    {
      "id": 261932,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lemons\n3 medium carrots\n1 ½ medium heads napa cabbage"
    },
    {
      "id": 261933,
      "primary_message": "Fill a large pot with about 1-inch of hot water (from the tap); cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 261934,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Roughly chop into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 261935,
      "primary_message": "Once the water in the pot is boiling, add cauliflower, reduce heat to medium, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 261936,
      "primary_message": "While the cauliflower is cooking, peel and mince garlic; place in a large bowl along with turkey, bread crumbs, chili powder, and salt. Using your hands, mix well to combine.",
      "secondary_message": "3 cloves garlic\n1.02 kg ground turkey\n⅓ cup panko bread crumbs\n2 tbsp chili powder\n1 ½ tsp salt"
    },
    {
      "id": 261937,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 261938,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 261939,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until browned on all sides, about 4 minutes (the meatballs will not be cooked all the way through). Remove to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 261940,
      "primary_message": "Once the meatballs have been removed, return the pot (with cooking juices) to medium heat. Add tomato sauce, vinegar, sugar, and spices; stir to combine the sauce and bring to a simmer.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n⅓ cup apple cider vinegar\n1 tbsp brown sugar\n1 tbsp cumin, ground\n¾ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 261941,
      "primary_message": "Once the sauce is simmering, return meatballs to the pot and turn to coat. Cover and simmer, stirring occasionally, until the meatballs are cooked through, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 261942,
      "primary_message": "When the cauliflower is done, drain in a colander. Working in batches to best fit your blender, transfer the cauliflower to the blender, then add milk, oil, salt, and pepper; purée until smooth. Return to the pot and cover to keep warm.",
      "secondary_message": "177 ml whole milk\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 261943,
      "primary_message": "Juice lemons into another large bowl; add oil, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 261944,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 261945,
      "primary_message": "Trim off and discard the root end of each cabbage; halve cabbages lengthwise, then thinly slice crosswise into shreds. Add to the bowl and stir to combine the coleslaw.",
      "secondary_message": null
    },
    {
      "id": 261946,
      "primary_message": "To serve, divide whipped cauliflower, coleslaw, and saucy meatballs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
