  "instructions": [
    {
      "id": 261721,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium red potatoes\n1 ½ lemons\n3 medium carrots\n1 ½ medium heads napa cabbage"
    },
    {
      "id": 261722,
      "primary_message": "Peel and large dice potatoes. Transfer to a large pot, cover with hot water (from the tap), and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to the pot.",
      "secondary_message": null
    },
    {
      "id": 261723,
      "primary_message": "Meanwhile, peel and mince garlic; place in a large bowl along with turkey, bread crumbs, chili powder, and salt. Using your hands, mix well to combine.",
      "secondary_message": "3 cloves garlic\n2 ¼ lb ground turkey\n⅓ cup panko bread crumbs\n2 tbsp chili powder\n1 ½ tsp salt"
    },
    {
      "id": 261724,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place on a large plate.",
      "secondary_message": null
    },
    {
      "id": 261725,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 261726,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add meatballs and cook, turning occasionally, until browned on all sides, about 4 minutes (the meatballs will not be cooked all the way through). Remove to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 261727,
      "primary_message": "Once the meatballs have been removed, return the pot (with cooking juices) to medium heat. Add tomato sauce, vinegar, sugar, and spices; stir to combine the sauce and bring to a simmer.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n⅓ cup apple cider vinegar\n1 tbsp brown sugar\n1 tbsp cumin, ground\n¾ tsp paprika\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 261728,
      "primary_message": "Once the sauce is simmering, return meatballs to the pot and turn to coat. Cover and simmer, stirring occasionally, until the meatballs are cooked through, 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 261729,
      "primary_message": "Meanwhile, juice lemons into another large bowl; add oil, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 261730,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 261731,
      "primary_message": "Trim off and discard the root end of each cabbage; halve cabbages lengthwise, then thinly slice crosswise into shreds. Add to the bowl and stir to combine the coleslaw.",
      "secondary_message": null
    },
    {
      "id": 261732,
      "primary_message": "Add milk, oil, salt, and pepper to the pot with the potatoes and mash until smooth.",
      "secondary_message": "6 fl oz (¾ cup) whole milk\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 261733,
      "primary_message": "To serve, divide mashed potatoes, coleslaw, and saucy meatballs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
