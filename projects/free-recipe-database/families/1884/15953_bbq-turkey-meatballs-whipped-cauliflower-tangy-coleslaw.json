  "instructions": [
    {
      "id": 261902,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ lemon\n1 medium carrot\n½ medium head napa cabbage"
    },
    {
      "id": 261903,
      "primary_message": "Fill a medium saucepan with about 1-inch of hot water (from the tap); cover and place over high heat.",
      "secondary_message": null
    },
    {
      "id": 261904,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Roughly chop into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 261905,
      "primary_message": "Once the water in the saucepan is boiling, add cauliflower, reduce heat to medium, and cook until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 261906,
      "primary_message": "While the cauliflower is cooking, peel and mince garlic; place in a medium bowl along with turkey, bread crumbs, chili powder, and salt. Using your hands, mix well to combine.",
      "secondary_message": "1 clove garlic\n⅓ kg ground turkey\n2 tbsp panko bread crumbs\n2 tsp chili powder\n½ tsp salt"
    },
    {
      "id": 261907,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs and place on a plate.",
      "secondary_message": null
    },
    {
      "id": 261908,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 261909,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add meatballs and cook, turning occasionally, until browned on all sides, about 4 minutes (the meatballs will not be cooked all the way through). Remove to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 261910,
      "primary_message": "Once the meatballs have been removed, return the skillet (with cooking juices) to medium heat. Add tomato sauce, vinegar, sugar, and spices; stir to combine the sauce and bring to a simmer.",
      "secondary_message": "1 (213 ml) can tomato sauce\n2 tbsp apple cider vinegar\n1 tsp brown sugar\n1 tsp cumin, ground\n¼ tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 261911,
      "primary_message": "Once the sauce is simmering, return meatballs to the skillet and turn to coat. Cover and simmer, stirring occasionally, until the meatballs are cooked through, about 6 minutes.",
      "secondary_message": null
    },
    {
      "id": 261912,
      "primary_message": "When the cauliflower is done, drain in a colander, and transfer to a blender. Add milk, oil, salt, and pepper; purée until smooth. Return to the saucepan and cover to keep warm.",
      "secondary_message": "59 ml (¼ cup) whole milk\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 261913,
      "primary_message": "Juice lemon into another medium bowl; add oil, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 261914,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 261915,
      "primary_message": "Trim off and discard the root end of the cabbage; halve lengthwise, then thinly slice crosswise into shreds. Add to the bowl and stir to combine the coleslaw.",
      "secondary_message": null
    },
    {
      "id": 261916,
      "primary_message": "To serve, divide whipped cauliflower, coleslaw, and saucy meatballs between plates. Enjoy!",
      "secondary_message": null
    }
  ],
