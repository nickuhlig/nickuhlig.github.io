  "instructions": [
    {
      "id": 212919,
      "primary_message": "Place couscous in a medium bowl.",
      "secondary_message": "½ cup whole wheat couscous"
    },
    {
      "id": 212920,
      "primary_message": "Pour broth in a small saucepan, cover, and bring to a boil over high heat. Remove from heat, pour broth into the bowl with the couscous, and stir. Cover tightly with aluminum foil and let stand for 10 minutes, then fluff with a fork.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 212921,
      "primary_message": "Meanwhile, peel and mince shallot. Peel and mince garlic.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 212922,
      "primary_message": "Return saucepan to medium heat. Once the saucepan is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 212923,
      "primary_message": "Add shallot and garlic to the saucepan and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 212924,
      "primary_message": "Add cherries, vinegar, and salt to the saucepan. Cook, stirring occasionally, until cherries have softened and balsamic is slightly reduced, 8-10 minutes. Cover and remove from heat.",
      "secondary_message": "1 cup frozen cherries\n2 tbsp balsamic vinegar\n½ tsp salt"
    },
    {
      "id": 212925,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 212926,
      "primary_message": "Pat pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, boneless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 212927,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 212928,
      "primary_message": "Place chops in the skillet and cook, flipping once, until browned and cooked through, 6-7 minutes. Remove to a clean plate and cover with foil.",
      "secondary_message": null
    },
    {
      "id": 212929,
      "primary_message": "Meanwhile, wash, dry, and trim green beans.",
      "secondary_message": "0.23 kg green beans"
    },
    {
      "id": 212930,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium heat.",
      "secondary_message": null
    },
    {
      "id": 212931,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green beans and season with salt and pepper. Cook, tossing frequently, until bright green and tender-crisp, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 212932,
      "primary_message": "Slice pork chops against the grain.",
      "secondary_message": null
    },
    {
      "id": 212933,
      "primary_message": "To serve, divide couscous, green beans, and pork chops between plates. Top chops with cherry sauce and enjoy!",
      "secondary_message": null
    }
  ],
