  "instructions": [
    {
      "id": 276217,
      "primary_message": "Preheat oven to 450°F. Line a two baking sheet pans with aluminum foil and set aside.",
      "secondary_message": null
    },
    {
      "id": 276218,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n3 red bell peppers\n1 ½ avocados"
    },
    {
      "id": 276219,
      "primary_message": "Peel and cut sweet potatoes lengthwise into 1-inch thick wedges (4-6 pieces per potato, depending on size), then divide between the baking sheets. Drizzle with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt"
    },
    {
      "id": 276220,
      "primary_message": "Place sweet potato wedges in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 276221,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans kidney beans"
    },
    {
      "id": 276222,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 276223,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 276224,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, garlic, and corn; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ cups frozen corn"
    },
    {
      "id": 276225,
      "primary_message": "While the veggies are cooking, trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 276226,
      "primary_message": "Add beans, bell pepper, tomatoes, and spices to the pot; stir to combine the chili and bring to a simmer.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n2 tbsp chili powder\n1 tbsp cumin, ground\n1 ½ tsp paprika\n1 ½ tsp salt\n½ tsp cayenne pepper"
    },
    {
      "id": 276227,
      "primary_message": "Once the chili is simmering, reduce heat to medium and cook, stirring occasionally, until veggies are tender and sauce has thickened, 7-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 276228,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 276229,
      "primary_message": "Halve and pit avocados. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 276230,
      "primary_message": "To serve, divide sweet potato wedges between plates or bowls; top with chili, cheese, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
