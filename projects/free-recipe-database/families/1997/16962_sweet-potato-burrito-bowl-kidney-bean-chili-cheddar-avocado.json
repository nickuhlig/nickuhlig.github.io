  "instructions": [
    {
      "id": 276203,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil and set aside.",
      "secondary_message": null
    },
    {
      "id": 276204,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n2 red bell peppers\n1 avocado"
    },
    {
      "id": 276205,
      "primary_message": "Peel and cut sweet potatoes lengthwise into 1-inch thick wedges (4-6 pieces per potato, depending on size), then transfer to the baking sheet. Drizzle with oil and season with spices; toss to coat and spread out in an even layer.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp chili powder\n1 tsp cumin, ground\n1 tsp salt"
    },
    {
      "id": 276206,
      "primary_message": "Place sweet potato wedges in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 276207,
      "primary_message": "Meanwhile, drain and rinse beans; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans kidney beans"
    },
    {
      "id": 276208,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 276209,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 276210,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion, garlic, and corn; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 cup frozen corn"
    },
    {
      "id": 276211,
      "primary_message": "While the veggies are cooking, trim, seed, and small dice bell peppers.",
      "secondary_message": null
    },
    {
      "id": 276212,
      "primary_message": "Add beans, bell pepper, tomatoes, and spices to the skillet; stir to combine the chili and bring to a simmer.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n4 tsp chili powder\n2 tsp cumin, ground\n1 tsp paprika\n1 tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 276213,
      "primary_message": "Once the chili is simmering, reduce heat to medium and cook, stirring occasionally, until veggies are tender and sauce has thickened, 5-6 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 276214,
      "primary_message": "Meanwhile, coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 276215,
      "primary_message": "Halve and pit avocado. Slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 276216,
      "primary_message": "To serve, divide sweet potato wedges between plates or bowls; top with chili, cheese, and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
