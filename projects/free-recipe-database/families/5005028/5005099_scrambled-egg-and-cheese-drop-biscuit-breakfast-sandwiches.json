  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the yellow onion. Beat the eggs. Dice the mozzarella. Pick the dill fronds from the stems and mince them. Split the freshly baked large drop biscuits.",
      "secondary_message": "1 cup yellow onion\n8 large eggs\n170 g mozzarella\n1 tbsp dill\n4 freshly baked large drop biscuits"
    },
    {
      "id": 1,
      "primary_message": "In a medium nonstick skillet, heat butter over medium heat until starting to foam. Add onion and cook, stirring, until translucent, about 5 minutes. Add eggs and cook, stirring constantly, until loosely curds form throughout. Add feta and mozzarella and cook, stirring, until mozzarella is melted and eggs are softly scrambled, about 1 minute. Stir in dill and remove from heat. Season lightly with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Arrange biscuit bottom halves on plates and spoon eggs on top. Close biscuits with top halves and serve immediately.",
      "secondary_message": null
    }
  ],
