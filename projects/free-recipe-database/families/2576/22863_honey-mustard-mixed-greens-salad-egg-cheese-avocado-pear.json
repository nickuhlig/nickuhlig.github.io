  "instructions": [
    {
      "id": 422745,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "3 pears\n1 ½ pints grape tomatoes\n1 ½ avocados\n1 small bunch Italian (flat-leaf) parsley\n3 (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 422746,
      "primary_message": "Peel and slice shallots crosswise into thin rounds. Place in a large bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 422747,
      "primary_message": "Quarter, core, and medium dice pears. Add to the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 422748,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 422749,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 422750,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 422751,
      "primary_message": "Roughly chop eggs and add to the bowl. ",
      "secondary_message": "12 hard-cooked eggs, peeled"
    },
    {
      "id": 422752,
      "primary_message": "Add mixed greens, carrots, cheese, and dressing to the bowl. Toss to combine the salad. ",
      "secondary_message": "1 ½ (10 oz) bags shredded carrots\n1 ½ cups shredded cheese, Italian blend\n1 cup honey mustard dressing"
    },
    {
      "id": 422753,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
