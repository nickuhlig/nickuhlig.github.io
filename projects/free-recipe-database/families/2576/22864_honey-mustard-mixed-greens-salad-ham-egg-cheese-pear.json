  "instructions": [
    {
      "id": 422754,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 pear\n½ small pkg grape tomatoes\n½ small bunch Italian (flat-leaf) parsley\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 422755,
      "primary_message": "Peel and slice shallot crosswise into thin rounds. Place in a medium bowl. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 422756,
      "primary_message": "Quarter, core, and medium dice pear. Add to the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 422757,
      "primary_message": "Halve tomatoes lengthwise and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 422758,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 422759,
      "primary_message": "Roughly chop eggs and add to the bowl. ",
      "secondary_message": "2 hard-cooked eggs, peeled"
    },
    {
      "id": 422760,
      "primary_message": "Small dice ham and add to the bowl. ",
      "secondary_message": "227 g ham steak, boneless"
    },
    {
      "id": 422761,
      "primary_message": "Add mixed greens, carrots, cheese, and dressing to the bowl. Toss to combine the salad. ",
      "secondary_message": "½ (283 g) bag shredded carrots\n½ cup shredded cheese, Italian blend\n⅓ cup honey mustard dressing"
    },
    {
      "id": 422762,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
