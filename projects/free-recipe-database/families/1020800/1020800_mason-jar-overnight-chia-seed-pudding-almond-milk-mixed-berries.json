  "instructions": [
    {
      "primary_message": "Divide milk, chia seeds, and maple syrup between two (pint-sized) jars. Use a fork to combine the mixture, making sure to break apart any seeds that clump together. Set aside.",
      "secondary_message": "1 ½ cups almond milk, unsweetened\n6 tbsp chia seeds\n1 tbsp pure maple syrup"
    },
    {
      "primary_message": "Wash and dry the berries.",
      "secondary_message": "1 (6 oz) pkg raspberries\n1 (6 oz) pkg blueberries"
    },
    {
      "primary_message": " Stir the chia mixture in each jar once more, then top with berries.",
      "secondary_message": null
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge for a minimum of 2 hours or up to 3 days. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, grab a spoon and enjoy!",
      "secondary_message": null
    }
