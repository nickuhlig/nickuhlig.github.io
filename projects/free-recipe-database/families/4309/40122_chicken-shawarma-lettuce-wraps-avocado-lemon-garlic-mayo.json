  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ lemon\n1 tomato\n½ avocado\n½ head butter (Boston) lettuce"
    },
    {
      "primary_message": "Place spices in a medium bowl. Stir to combine the spice rub.",
      "secondary_message": "1 tsp cumin, ground\n½ tsp smoked paprika\n½ tsp coriander, ground\n½ tsp turmeric, ground\nsalt\n⅛ tsp cinnamon, ground\n⅛ tsp cayenne pepper"
    },
    {
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the spice rub.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat the chicken breast dry with paper towels and cut into thin strips. Add to the bowl and toss to combine.",
      "secondary_message": "¾ lb chicken thighs, boneless skinless"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onions and chicken; cook, stirring occasionally, until chicken is golden brown and cooked through, 6-7 minutes.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Place in a small bowl. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "primary_message": "Juice lemon into the bowl with the garlic, then add mayo, oil, salt, and pepper. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup mayonnaise\nextra virgin olive oil\nsalt\n1 pinch black pepper"
    },
    {
      "primary_message": "Small dice tomato.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and small dice.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with chicken, tomato, and avocado. Drizzle with lemon-garlic mayo and enjoy!",
      "secondary_message": null
    }
  ],
