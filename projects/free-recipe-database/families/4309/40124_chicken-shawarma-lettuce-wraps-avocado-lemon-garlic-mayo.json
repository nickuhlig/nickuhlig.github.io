  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ lemons\n3 tomatoes\n1 ½ avocados\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "primary_message": "Place spices in a large bowl. Stir to combine the spice rub.",
      "secondary_message": "1 tbsp cumin, ground\n1 ½ tsp smoked paprika\n1 ½ tsp coriander, ground\n1 ½ tsp turmeric, ground\nsalt\n½ tsp cinnamon, ground\n½ tsp cayenne pepper"
    },
    {
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the spice rub.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat the chicken breast dry with paper towels and cut into thin strips. Add to the bowl and toss to combine.",
      "secondary_message": "2 ¼ lb chicken thighs, boneless skinless"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green onions and chicken; cook, stirring occasionally, until chicken is golden brown and cooked through, 7-8 minutes.",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Place in a small bowl. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "primary_message": "Juice lemons into the bowl with the garlic, then add mayo, oil, salt, and pepper. Whisk to combine the sauce and set aside.",
      "secondary_message": "¾ cup mayonnaise\nextra virgin olive oil\nsalt\n3 pinch black pepper"
    },
    {
      "primary_message": "Small dice tomatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and small dice.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with chicken, tomato, and avocado. Drizzle with lemon-garlic mayo and enjoy!",
      "secondary_message": null
    }
  ],
