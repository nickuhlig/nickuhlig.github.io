  "instructions": [
    {
      "id": 610045,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n1 red bell pepper\n½ small bunch green onions (scallions)\n½ small bunch cilantro\n½ lime"
    },
    {
      "id": 610046,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel the carrots into noodle-like strips. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 610047,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 610048,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 610049,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 610050,
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 610051,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, garlic, pork, salt, and crushed red pepper. Cook, breaking the meat apart with a spoon, until pork is browned and veggies are tender, 5-7 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n¾ lb lean ground pork\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 610052,
      "primary_message": "Meanwhile, place vinegar, soy sauce, fish sauce, and sugar in the reserved bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 tbsp rice vinegar\n1 tbsp soy sauce\n2 tsp fish sauce\n2 tsp brown sugar"
    },
    {
      "id": 610053,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the carrot noodles. Set aside.",
      "secondary_message": null
    },
    {
      "id": 610054,
      "primary_message": "When the pork is done, crack the eggs into the skillet; cook, stirring constantly, until set and no longer runny. ",
      "secondary_message": "2 eggs"
    },
    {
      "id": 610055,
      "primary_message": "Add carrot noodles, cilantro, and sauce to the skillet, then stir to combine. Continue to cook, stirring frequently, until carrot noodles are tender, 3-4 minutes more. Remove from heat, juice lime into the skillet, and stir once more to combine the pad Thai.",
      "secondary_message": null
    },
    {
      "id": 610056,
      "primary_message": "Meanwhile, roughly chop peanuts. ",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    },
    {
      "id": 610057,
      "primary_message": "To serve, divide pad Thai between plates or bowls, sprinkle with peanuts, and enjoy! ",
      "secondary_message": null
    }
  ],
