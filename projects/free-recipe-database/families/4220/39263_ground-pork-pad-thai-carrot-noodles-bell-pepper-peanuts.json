  "instructions": [
    {
      "id": 610227,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "12 medium carrots\n3 red bell peppers\n1 small bunch green onions (scallions)\n1 small bunch cilantro\n1 ½ limes"
    },
    {
      "id": 610228,
      "primary_message": "Peel and trim carrots; using a julienne (or regular) peeler, peel the carrots into noodle-like strips. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 610229,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 610230,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 610231,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 610232,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 610233,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, garlic, pork, salt, and crushed red pepper. Cook, breaking the meat apart with a spoon, until pork is browned and veggies are tender, 8-10 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1.02 kg lean ground pork\n¾ tsp salt\n¾ tsp crushed red pepper"
    },
    {
      "id": 610234,
      "primary_message": "Meanwhile, place vinegar, soy sauce, fish sauce, and sugar in the reserved bowl. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 tbsp rice vinegar\n3 tbsp soy sauce\n2 tbsp fish sauce\n2 tbsp brown sugar"
    },
    {
      "id": 610235,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the carrot noodles. Set aside.",
      "secondary_message": null
    },
    {
      "id": 610236,
      "primary_message": "When the pork is done, crack the eggs into the pot; cook, stirring constantly, until set and no longer runny. ",
      "secondary_message": "6 eggs"
    },
    {
      "id": 610237,
      "primary_message": "Add carrot noodles, cilantro, and sauce to the pot, then stir to combine. Continue to cook, stirring frequently, until carrot noodles are tender, 5-6 minutes more. Remove from heat, juice limes into the pot, and stir once more to combine the pad Thai.",
      "secondary_message": null
    },
    {
      "id": 610238,
      "primary_message": "Meanwhile, roughly chop peanuts. ",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 610239,
      "primary_message": "To serve, divide pad Thai between plates or bowls, sprinkle with peanuts, and enjoy! ",
      "secondary_message": null
    }
  ],
