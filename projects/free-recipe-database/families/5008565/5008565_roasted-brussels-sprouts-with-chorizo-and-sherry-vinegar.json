  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 450°F. Combine olive oil and chorizo in a medium skillet and heat over medium heat. Cook, stirring, until chorizo is crisped in spots, about 5 minutes. Add shallots and garlic and cook, stirring, until pale golden brown. Add paprika and continue to cook, stirring, until garlic and shallots are browned. (The shallots may lightly char in spots; this is fine.)",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Strain mixture into a large bowl and reserve solids. Add Brussels sprouts to bowl and toss to coat. Season with salt and transfer to a rimmed baking sheet, arranging sprouts in a single layer, cut side down.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to oven and roast until charred and tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Return to large bowl and add reserved chorizo/garlic mixture. Add sherry vinegar and honey. Toss to combine and serve.",
      "secondary_message": null
    }
  ],
