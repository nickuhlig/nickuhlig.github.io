  "instructions": [
    {
      "id": 419289,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 419290,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "2 red bell peppers\n½ small bunch cilantro\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 419291,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan, drizzle with oil, season with salt and pepper, then arrange cut-side down.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 419292,
      "primary_message": "Place baking sheet in the oven and broil, flipping once, until peppers are lightly charred and tender, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 419293,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Divide between two medium bowls. (Set one bowl aside for the salad.)",
      "secondary_message": null
    },
    {
      "id": 419294,
      "primary_message": "Drain and rinse beans. Add to remaining bowl with the cilantro along with cheese and taco seasoning. Stir to combine the filling.",
      "secondary_message": "1 (398 ml) can pinto beans\n⅓ cup shredded cheese, Mexican blend\n1 ½ tbsp taco seasoning"
    },
    {
      "id": 419295,
      "primary_message": "Stuff pepper halves with the filling, then top with additional cheese. Return baking sheet to the oven and continue to broil the peppers until filling is warmed through and cheese is melted, 3-4 minutes more. Remove from oven.",
      "secondary_message": "⅓ cup shredded cheese, Mexican blend"
    },
    {
      "id": 419296,
      "primary_message": "Meanwhile, add mixed greens, carrots, and dressing to the second bowl with the cilantro. Toss to combine the salad.",
      "secondary_message": "½ (283 g) bag shredded carrots\n2 tbsp ranch dressing"
    },
    {
      "id": 419297,
      "primary_message": "To serve, divide stuffed peppers and salad between plates; top each pepper with a dollop of guacamole. Enjoy!",
      "secondary_message": "½ cup guacamole"
    }
  ],
