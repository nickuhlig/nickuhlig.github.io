  "instructions": [
    {
      "id": 401836,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n⅜ tsp salt"
    },
    {
      "id": 401837,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 green bell peppers\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 401838,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 401839,
      "primary_message": "While the rice is cooking, trim, seed, and medium dice bell peppers. Place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 401840,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 401841,
      "primary_message": "While the pot heats up, peel and mince ginger. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 401842,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add bell pepper, ginger, and spices; cook, stirring occasionally, until peppers soften, 3-4 minutes. ",
      "secondary_message": "3 tbsp butter, unsalted\n2 tbsp curry powder\n2 tbsp garam masala\n1 ½ tsp garlic powder\n1 ½ tsp salt"
    },
    {
      "id": 401843,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into small bite-sized pieces. ",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless"
    },
    {
      "id": 401844,
      "primary_message": "When the peppers are soft, add chicken, marinara sauce, cream, and water to the pot; stir to combine the curry and bring to a simmer. ",
      "secondary_message": "1 ½ (24 oz) jars marinara sauce\n6 fl oz (¾ cup) heavy whipping cream\n¾ cup water"
    },
    {
      "id": 401845,
      "primary_message": "Once the curry is simmering, reduce heat to low and continue to cook, stirring occasionally, until chicken is cooked through, about 10 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 401846,
      "primary_message": "To serve, divide rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
