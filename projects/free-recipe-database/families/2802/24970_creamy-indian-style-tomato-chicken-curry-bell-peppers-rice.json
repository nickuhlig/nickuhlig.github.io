  "instructions": [
    {
      "id": 401814,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 401815,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 green bell pepper\n1 (1 inch) piece ginger root"
    },
    {
      "id": 401816,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 401817,
      "primary_message": "While the rice is cooking, trim, seed, and medium dice bell peppers. Place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 401818,
      "primary_message": "Preheat a medium saucepan over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 401819,
      "primary_message": "While the pan heats up, peel and mince ginger. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 401820,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add bell pepper, ginger, and spices; cook, stirring occasionally, until peppers soften, 2-3 minutes. ",
      "secondary_message": "1 tbsp butter, unsalted\n2 tsp curry powder\n2 tsp garam masala\n½ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 401821,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into small bite-sized pieces. ",
      "secondary_message": "¾ lb chicken breasts, boneless skinless"
    },
    {
      "id": 401822,
      "primary_message": "When the peppers are soft, add chicken, marinara sauce, cream, and water to the pan; stir to combine the curry and bring to a simmer. ",
      "secondary_message": "½ (24 oz) jar marinara sauce\n2 fl oz (¼ cup) heavy whipping cream\n¼ cup water"
    },
    {
      "id": 401823,
      "primary_message": "Once the curry is simmering, reduce heat to low and continue to cook, stirring occasionally, until chicken is cooked through, 8-10 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": null
    },
    {
      "id": 401824,
      "primary_message": "To serve, divide rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
