  "instructions": [
    {
      "id": 401916,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 401917,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 green bell peppers\n2 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 401918,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 401919,
      "primary_message": "While the rice is cooking, trim, seed, and medium dice bell peppers. Place in medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 401920,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 401921,
      "primary_message": "While the pan heats up, peel and mince ginger. Add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 401922,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggie ground, bell pepper, ginger, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n454 g veggie ground, plant based\n4 tsp curry powder\n4 tsp garam masala\n1 tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 401923,
      "primary_message": "Add marinara sauce, cream, and water to the pot; stir to combine the curry and bring to a simmer. Once simmering, reduce heat to low and continue to cook, stirring occasionally, until bell peppers are soft and curry thickens, 4-5 minutes more. Remove from heat. ",
      "secondary_message": "1 (680 g) jar marinara sauce\n118 ml (½ cup) heavy whipping cream\n½ cup water"
    },
    {
      "id": 401924,
      "primary_message": "To serve, divide rice and curry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
