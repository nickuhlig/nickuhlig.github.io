  "instructions": [
    {
      "primary_message": "FOR THE SPICED SIMPLE SYRUP: Wash, dry, and zest orange into a small saucepan. (Reserve remaining orange for later use.)",
      "secondary_message": "½ orange"
    },
    {
      "primary_message": "Wash and dry thyme. Set aside one sprig for garnish, then add remaining thyme to the pan with the orange zest.",
      "secondary_message": "¼ small pkg fresh thyme"
    },
    {
      "primary_message": "Add sugar, water, and spices to the pan; stir to combine and bring to a boil. Reduce heat to medium and simmer, stirring occasionally, until sugar is just dissolved. Remove from heat and let cool completely before straining and using. (NOTE: this recipe makes about 2/3 cup spiced simple syrup. Transfer leftover syrup to a small jar and refrigerate for up to one month.)",
      "secondary_message": "½ cup granulated sugar\n4 star anise, whole\n¼ tsp allspice, ground"
    },
    {
      "primary_message": "FOR THE COCKTAIL: Juice reserved orange into a small bowl, then measure out 1 tbsp juice and place in a glass or tumbler of choice. (Reserve remaining orange juice for another use.) ",
      "secondary_message": null
    },
    {
      "primary_message": "Add 1/2 fl oz (1 tbsp) spiced simple syrup, 2 fl oz (1/4 cup) gin, and ice cubes to the glass, then stir to combine. ",
      "secondary_message": "2 fl oz gin\n⅔ cup ice cube"
    },
    {
      "primary_message": "Top the glass off with 4 fl oz (1/2 cup) chilled tonic water. Stir gently, then garnish with the reserved thyme sprigs. Enjoy!",
      "secondary_message": "4 fl oz tonic water"
    }
  ],
