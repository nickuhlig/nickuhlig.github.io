  "instructions": [
    {
      "primary_message": "Place root beer, sugar, ketchup, vinegar, Worcestershire, Dijon, and spices in a medium saucepan. Gently whisk to combine and bring to a boil over high heat. Once boiling, reduce heat to medium and simmer until glaze is reduced by half, about 20 minutes. Remove from heat and cover to keep warm. \n\n\n\n",
      "secondary_message": "1 ½ cups root beer\n⅓ cup brown sugar\n¼ cup ketchup\n2 tbsp apple cider vinegar\n1 tsp Worcestershire sauce\n1 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.\n\n",
      "secondary_message": "6 pork chops, bone-in\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a large plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "primary_message": "To serve, arrange chops on a serving platter and pour glaze over top. Enjoy!",
      "secondary_message": null
    }
  ],
