  "instructions": [
    {
      "id": 171122,
      "primary_message": "Preheat oven to broil and position rack in the center of the oven.",
      "secondary_message": null
    },
    {
      "id": 171123,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 orange bell peppers\n½ lime\n½ small bunch cilantro\n1 tomato\n½ jalapeño pepper\n½ avocado"
    },
    {
      "id": 171124,
      "primary_message": "Cut the bell peppers lengthwise into thirds; remove and discard the stem, seeds, and white membrane. Transfer bell pepper pieces, skin-side down, onto a baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 171125,
      "primary_message": "Broil the peppers for 6-8 minutes, flipping them over with tongs halfway through cooking. ",
      "secondary_message": null
    },
    {
      "id": 171126,
      "primary_message": "Meanwhile, juice the lime into a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 171127,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems. Mince the leaves and add to the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 171128,
      "primary_message": "Peel and mince the shallot; small dice the tomato. Add both to the bowl. ",
      "secondary_message": "½ shallot"
    },
    {
      "id": 171129,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the pico de gallo. Season with salt and stir to combine; set aside. ",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 171130,
      "primary_message": "Crack the eggs into a medium bowl and season with salt and pepper; whisk together.",
      "secondary_message": "4 eggs\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 171131,
      "primary_message": "Preheat a nonstick skillet over medium heat. Add butter to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 171132,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 171133,
      "primary_message": "While the eggs are cooking, grate the cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 171134,
      "primary_message": "Reposition the bell pepper pieces, skin-side down, on the baking sheet. Divide the scrambled eggs among the bell pepper pieces and top with cheddar cheese and oregano. Place bell peppers under the broiler for 1 minute, or until the cheese has melted.",
      "secondary_message": "¼ tsp oregano"
    },
    {
      "id": 171135,
      "primary_message": "Halve the avocado and remove pit. Thinly slice the flesh while still in the skin and then scoop out the slices using a spoon. ",
      "secondary_message": null
    },
    {
      "id": 171136,
      "primary_message": "To serve, divide the bell peppers between dishes; top with pico de gallo and sliced avocado. Enjoy!",
      "secondary_message": null
    }
  ],
