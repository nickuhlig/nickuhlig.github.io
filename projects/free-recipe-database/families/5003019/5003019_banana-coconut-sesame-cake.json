  "instructions": [
    {
      "id": 1,
      "primary_message": "In a skillet set over low heat, toast sesame seeds until they turn light brown. Keep an eye on them and stir constantly for they burn easily. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Grease the sides of the pan. (No need to grease the bottom.) Scatter butter cubes all over bottom of pan. Sprinkle brown sugar all over bottom of pan, making sure it's evenly distributed. Arrange banana slices in single layer on top of butter and brown sugar.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Preheat oven to 350 F. Set rack in the middle of oven. In a mixing bowl, whisk together egg yolks, granulated sugar, salt, baking powder, oil, coconut milk, and coconut extract (if using). Once mixture is smooth, whisk in all-purpose flour, one tablespoon at a time. Make sure mixture is free of lumps.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In another clean mixing bowl, whisk egg whites until stiff peaks form. With a rubber spatula, fold half of beaten egg whites into batter; mix well. Fold remaining egg whites into batter, folding just until no white streaks remain, being careful not to deflate batter.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour batter into pan, right over banana topping. Spread out batter with rubber spatula all the way to edges of pan. Tap pan on kitchen counter a few times to get rid of air pockets and make sure batter goes into spaces between banana slices. Sprinkle toasted sesame seeds all over surface of batter.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Bake until a cake tester or toothpick inserted into center comes out clean, 30 to 35 minutes.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Let cake cool down to room temperature (or only slightly warmer than room temperature), then unmold upside down into serving platter. Dust powdered sugar on top, if desired.",
      "secondary_message": null
    }
  ],
