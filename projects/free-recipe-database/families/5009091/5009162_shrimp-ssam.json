  "instructions": [
    {
      "id": 1,
      "primary_message": "Combine ginger, garlic, 1/4 cup chopped cilantro, 3 tablespoons vegetable oil and chili paste in a large dish. Toss shrimp in marinade and allow to stand for 15 minutes (or up to 2 hours).",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Gently remove each leaf from the head of Bibb lettuce and arrange on a platter. Place remaining cilantro, limes and chopped scallions in small bowls.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When ready to eat heat remaining oil in a large skillet over medium high heat. When oil is shimmering add shrimp in single layer and cook until first side is pink and spotty, 1 to 2 minutes. Flip shrimp and cook until second side is pink and shrimp is cooked through, 1 to 2 minutes longer. Season to taste with salt. Place in a serving dish and serve passing along with lettuce, scallions, cilantro and limes so that everyone can make their own lettuce wrap.",
      "secondary_message": null
    }
  ],
