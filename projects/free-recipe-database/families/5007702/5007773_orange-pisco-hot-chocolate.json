  "instructions": [
    {
      "id": 1,
      "primary_message": "In medium saucepan, stir cocoa with sugar and salt. Stir in milk, milk chocolate, and bittersweet chocolate. Heat over medium heat until, stirring constantly, until chocolate is melted and mixture is hot. Gently whisk to completely homogenize mixture.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add Grand Marnier and pisco or rum. Divide into four serving cups. Rub rim of each cup with orange zest. Top with whipped cream, candied orange peel, and orange zest. Serve immediately.",
      "secondary_message": null
    }
