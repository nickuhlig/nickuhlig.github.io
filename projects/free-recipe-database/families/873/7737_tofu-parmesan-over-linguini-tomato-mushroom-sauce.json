  "instructions": [
    {
      "id": 172480,
      "primary_message": "Cut the tofu into approximately ¼-inch thick planks along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 172481,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n5 oz linguine pasta"
    },
    {
      "id": 172482,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lb white mushrooms\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 172483,
      "primary_message": "Peel and mince the garlic. Slice the mushrooms. Transfer both to a medium bowl and set aside.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 172484,
      "primary_message": "Combine spices in a small bowl; stir to combine the spice mix and set aside.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp garlic powder\n½ tsp onion powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 172485,
      "primary_message": "Grate Parmesan and set aside.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 172486,
      "primary_message": "When pasta is done, drain in a colander, and rinse under cold water; set aside to drain further. ",
      "secondary_message": null
    },
    {
      "id": 172487,
      "primary_message": "Return the saucepan to medium heat; add oil and swirl to coat the bottom. Add the mushrooms and garlic; cook, stirring often, until mushrooms soften, 1-2 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 172488,
      "primary_message": "Add tomato sauce and spices to the saucepan and stir to combine. Cover and let simmer over medium-low for 5 minutes; turn off the heat. ",
      "secondary_message": "1 ½ (8 oz) cans tomato sauce\n½ tsp salt\n¼ tsp Italian seasoning\n1 pinch crushed red pepper"
    },
    {
      "id": 172489,
      "primary_message": "Cut tofu planks into approximately 2-inch wide rectangles along the short side. Arrange tofu on a baking sheet in a single layer. Season with half of the spice mix, followed by half of the bread crumbs. Press down lightly with your hands to help the breadcrumbs adhere. ",
      "secondary_message": "¼ cup panko bread crumbs"
    },
    {
      "id": 172490,
      "primary_message": "Carefully turn the tofu planks over. Season with remaining spice mix and bread crumbs. Press down lightly with your hands to help the breadcrumbs adhere. ",
      "secondary_message": null
    },
    {
      "id": 172491,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 172492,
      "primary_message": "When the skillet is hot, add olive oil and swirl to coat the bottom. Add the tofu and cook until golden brown on one side, 3-4 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 172493,
      "primary_message": "Using a spatula, carefully flip the tofu over and top each piece with Parmesan cheese. Cook until the other side has turned golden brown and the cheese has melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 172494,
      "primary_message": "Add the pasta back to the saucepan with the sauce and toss until well coated. Cook until heated through, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 172495,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 172496,
      "primary_message": "Divide pasta and sauce between bowls or dishes. Top with tofu and parsley. Enjoy! ",
      "secondary_message": null
    }
  ],
