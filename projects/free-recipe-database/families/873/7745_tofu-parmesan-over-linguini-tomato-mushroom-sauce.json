  "instructions": [
    {
      "id": 172638,
      "primary_message": "Cut the tofu into approximately ¼-inch thick planks along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 172639,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n425 g linguine pasta"
    },
    {
      "id": 172640,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg white mushrooms\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 172641,
      "primary_message": "Peel and mince the garlic. Slice the mushrooms. Transfer both to a large bowl and set aside.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 172642,
      "primary_message": "Combine spices in a small bowl; stir to combine the spice mix and set aside.",
      "secondary_message": "1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 172643,
      "primary_message": "Grate Parmesan and set aside.",
      "secondary_message": "128 g Parmesan cheese"
    },
    {
      "id": 172644,
      "primary_message": "When pasta is done, drain in a colander, and rinse under cold water; set aside to drain further. ",
      "secondary_message": null
    },
    {
      "id": 172645,
      "primary_message": "Return the pot to medium heat; add oil and swirl to coat the bottom. Add the mushrooms and garlic; cook, stirring often, until mushrooms soften, about 2 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 172646,
      "primary_message": "Add tomato sauce and spices to the pot and stir to combine. Cover and let simmer over medium-low for 5 minutes; turn off the heat. ",
      "secondary_message": "4 ½ (213 ml) cans tomato sauce\n1 ½ tsp salt\n¾ tsp Italian seasoning\n¼ tsp crushed red pepper"
    },
    {
      "id": 172647,
      "primary_message": "Cut tofu planks into approximately 2-inch wide rectangles along the short side. Arrange tofu on a baking sheet in a single layer. Season with half of the spice mix, followed by half of the bread crumbs. Press down lightly with your hands to help the breadcrumbs adhere. ",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 172648,
      "primary_message": "Carefully turn the tofu planks over. Season with remaining spice mix and bread crumbs. Press down lightly with your hands to help the breadcrumbs adhere. ",
      "secondary_message": null
    },
    {
      "id": 172649,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 172650,
      "primary_message": "When the skillet is hot, add olive oil and swirl to coat the bottom. Add the tofu and cook until golden brown on one side, 3-4 minutes. Cook in batches if necessary.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 172651,
      "primary_message": "Using a spatula, carefully flip the tofu over and top each piece with Parmesan cheese. Cook until the other side has turned golden brown and the cheese has melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 172652,
      "primary_message": "Add the pasta back to the pot with the sauce and toss until well coated. Cook until heated through, 2-3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 172653,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 172654,
      "primary_message": "Divide pasta and sauce between bowls or dishes. Top with tofu and sprinkle with parsley. Enjoy! ",
      "secondary_message": null
    }
  ],
