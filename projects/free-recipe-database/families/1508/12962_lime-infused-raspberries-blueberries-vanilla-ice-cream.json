  "instructions": [
    {
      "id": 217801,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 limes\n2 (170 g) pkg raspberries\n2 (170 g) pkg blueberries"
    },
    {
      "id": 217802,
      "primary_message": "Zest and juice limes into a small saucepan.",
      "secondary_message": null
    },
    {
      "id": 217803,
      "primary_message": "Add sugar and water to the saucepan; place over high heat and cook, stirring occasionally, until sugar dissolves. Bring to a boil, then remove from heat.",
      "secondary_message": "1 cup granulated sugar\n118 ml (½ cup) water"
    },
    {
      "id": 217804,
      "primary_message": "Combine berries in a baking dish, then spread out in a single layer. Pour lime syrup over the berries, stir to coat, and set aside to cool, 5-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 217805,
      "primary_message": "Once the berries have cooled completely, divide between bowls, drizzle with lime syrup, and top with ice cream. Enjoy!",
      "secondary_message": "355 ml vanilla ice cream"
    }
  ],
