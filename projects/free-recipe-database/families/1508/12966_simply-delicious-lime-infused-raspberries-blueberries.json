  "instructions": [
    {
      "id": 217821,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 limes\n3 (170 g) pkg raspberries\n3 (170 g) pkg blueberries"
    },
    {
      "id": 217822,
      "primary_message": "Zest and juice limes into a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 217823,
      "primary_message": "Add sugar and water to the saucepan; place over high heat and cook, stirring occasionally, until sugar dissolves. Bring to a boil, then remove from heat.",
      "secondary_message": "1 ½ cup granulated sugar\n177 ml water"
    },
    {
      "id": 217824,
      "primary_message": "Combine berries in a large baking dish, then spread out in a single layer. Pour lime syrup over the berries, stir to coat, and set aside to cool, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 217825,
      "primary_message": "Once the berries have cooled completely, divide between bowls, drizzle with lime syrup, and enjoy!",
      "secondary_message": null
    }
