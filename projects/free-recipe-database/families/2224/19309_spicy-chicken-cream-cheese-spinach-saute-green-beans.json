  "instructions": [
    {
      "id": 317474,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 317475,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg green beans\n1 ½ jalapeño peppers\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 317476,
      "primary_message": "Trim green beans and divide between two baking sheet pans; drizzle with oil, season with salt, and toss to combine. Spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 317477,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until green beans are golden brown and fork-tender, about 15 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 317478,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 317479,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and cut into bite-sized pieces; season with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 317480,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden, 6-7 minutes (the chicken will not be cooked all the way through).",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 317481,
      "primary_message": "While the chicken cooks, using a clean cutting board, peel and mince garlic. ",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 317482,
      "primary_message": "Halve jalapeños lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 317483,
      "primary_message": "When the chicken is done, add garlic and jalapeño to the pot; continue to cook, stirring occasionally, until fragrant, 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "id": 317484,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. ",
      "secondary_message": "¾ (227 g) block cream cheese"
    },
    {
      "id": 317485,
      "primary_message": "Add cream cheese, cream, and spices to the pot; bring to a simmer, reduce heat to low, and continue to cook, stirring frequently, until melted and combined, 3-4 minutes more.",
      "secondary_message": "355 ml heavy whipping cream\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317486,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 317487,
      "primary_message": "To serve, divide green beans and chicken sauté between plates or bowls; sprinkle with crushed red pepper and enjoy! ",
      "secondary_message": "½ tsp crushed red pepper"
    }
  ],
