  "instructions": [
    {
      "id": 317488,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 317489,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.23 kg green beans\n½ jalapeño pepper\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 317490,
      "primary_message": "Drain and rinse beans; set aside to drain further. ",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 317491,
      "primary_message": "Trim green beans and transfer to a baking sheet pan; drizzle with oil, season with salt, and toss to combine. Spread out in an even layer. ",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 317492,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until green beans are golden brown and fork-tender, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 317493,
      "primary_message": "Meanwhile, peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 317494,
      "primary_message": "Halve jalapeño lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 317495,
      "primary_message": "Preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 317496,
      "primary_message": "While the skillet heats up, cut cream cheese into small pieces. ",
      "secondary_message": "¼ (227 g) block cream cheese"
    },
    {
      "id": 317497,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and jalapeño; cook, stirring frequently, until fragrant, 1-2 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 317498,
      "primary_message": "Add beans, cream cheese, cream, and spices to the skillet; bring to a simmer. Once simmering, reduce heat to low, and continue to cook, stirring frequently, until beans are soft and sauce is combined, 4-5 minutes more.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n1 tsp chili powder\n½ tsp coriander, ground\n½ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 317499,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 317500,
      "primary_message": "To serve, divide green beans and bean skillet between plates or bowls; sprinkle with crushed red pepper and enjoy! ",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
