  "instructions": [
    {
      "id": 317433,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 317434,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb green beans\n1 ½ jalapeño peppers\n3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 317435,
      "primary_message": "Drain and rinse beans; set aside to drain further. ",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 317436,
      "primary_message": "Trim green beans and divide between two baking sheet pans; drizzle with oil, season with salt, and toss to combine. Spread out in an even layer. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 317437,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until green beans are golden brown and fork-tender, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 317438,
      "primary_message": "Meanwhile, peel and mince garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 317439,
      "primary_message": "Halve jalapeños lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 317440,
      "primary_message": "Preheat a large pot over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 317441,
      "primary_message": "While the pot heats up, cut cream cheese into small pieces. ",
      "secondary_message": "¾ (8 oz) block cream cheese"
    },
    {
      "id": 317442,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add garlic and jalapeño; cook, stirring frequently, until fragrant, 1-2 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 317443,
      "primary_message": "Add beans, cream cheese, cream, and spices to the pot; bring to a simmer. Once simmering, reduce heat to low, and continue to cook, stirring frequently, until beans are soft and sauce is combined, 5-6 minutes more.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream\n1 tbsp chili powder\n1 ½ tsp coriander, ground\n1 ½ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 317444,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 317445,
      "primary_message": "To serve, divide green beans and bean sauté between plates or bowls; sprinkle with crushed red pepper and enjoy! ",
      "secondary_message": "½ tsp crushed red pepper"
    }
  ],
