  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and mince tomato; place in a small bowl. Season with salt and pepper, stir to combine, and set aside. ",
      "secondary_message": "1 tomato\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Arrange bread slices on a baking sheet pan and drizzle oil over both sides; sprinkle tops with garlic. Place in the oven and bake, flipping halfway through, until toasted, 2-3 minutes. Remove from oven (keep oven on). ",
      "secondary_message": "extra virgin olive oil"
    },
    {
      "primary_message": "Meanwhile, place oil, vinegar, honey, and Dijon in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp honey\n1 tsp Dijon mustard"
    },
    {
      "primary_message": "Wash spinach (skip if it came pre-washed) and add to the bowl with the dressing; toss to combine the salad. ",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "primary_message": "Spread tomato mixture over toasts and return to the oven. Bake until tomato topping is heated through, 1-2 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve olives. Cut or tear prosciutto into bite sized pieces.",
      "secondary_message": "⅓ cup Kalamata olives, pitted\n6 slices prosciutto"
    },
    {
      "primary_message": "To serve, divide toasts and salad between plates. Top salad with olives, prosciutto, and almonds. Enjoy! ",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
