  "instructions": [
    {
      "id": 216811,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 216812,
      "primary_message": "Wash, dry, and mince tomatoes; place in a small bowl. Season with salt and pepper, stir to combine, and set aside. ",
      "secondary_message": "2 tomatoes\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 216813,
      "primary_message": "Peel and mince garlic. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 216814,
      "primary_message": "Arrange bread slices on a large baking sheet pan and drizzle oil over both sides; sprinkle tops with garlic. Place in the oven and bake, flipping halfway through, until toasted, 2-3 minutes. Remove from oven (keep oven on). ",
      "secondary_message": "8 slices whole grain bread\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 216815,
      "primary_message": "Meanwhile, place oil, vinegar, honey, and Dijon in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n4 tsp red wine vinegar\n2 tsp honey\n2 tsp Dijon mustard"
    },
    {
      "id": 216816,
      "primary_message": "Wash spinach (skip if it came pre-washed) and add to the bowl with the dressing; toss to combine the salad. ",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 216817,
      "primary_message": "Spread tomato mixture over toasts and return to the oven. Bake until tomato topping is heated through, 1-2 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 216818,
      "primary_message": "Halve olives. Cut or tear prosciutto into bite sized pieces.",
      "secondary_message": "⅔ cup Kalamata olives, pitted\n12 slices prosciutto"
    },
    {
      "id": 216819,
      "primary_message": "To serve, divide toasts and salad between plates. Top salad with olives, prosciutto, and almonds. Enjoy! ",
      "secondary_message": "½ cup almonds, sliced"
    }
  ],
