  "instructions": [
    {
      "id": 323260,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 323261,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 323262,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb green beans\n6 medium carrots\n3 (1 inch) pieces ginger root\n3 small bunches green onions (scallions)"
    },
    {
      "id": 323263,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 323264,
      "primary_message": "While the rice cooks, trim and cut green beans into 1-inch pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 323265,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the green beans and set aside.",
      "secondary_message": null
    },
    {
      "id": 323266,
      "primary_message": "Peel and mince ginger and garlic; place both in a small bowl. Add cold water (from the tap), soy sauce, cornstarch, vinegar, and chili-garlic sauce to the bowl; whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "6 cloves garlic\n1 ½ cup water\n⅓ cup soy sauce\n3 tbsp cornstarch\n3 tbsp rice vinegar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 323267,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323268,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and stir-fry until starting to soften, 6-7 minutes.",
      "secondary_message": "⅓ cup toasted sesame oil"
    },
    {
      "id": 323269,
      "primary_message": "Using your fingers, crumble tofu into the pot with the veggies; season with salt and pepper. Continue to cook, stirring often, until tofu turns golden brown, 6-7 minutes.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 323270,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 323271,
      "primary_message": "Add the stir-fry sauce, half of the green onions, and sesame seeds to the pot (reserve remaining green onions for the rice). Continue to cook, stirring often, until sauce thickens slightly, 2-3 minutes more.",
      "secondary_message": "3 tbsp sesame seeds"
    },
    {
      "id": 323272,
      "primary_message": "When the rice is done, add reserved green onions and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 323273,
      "primary_message": "To serve, divide rice and tofu stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
