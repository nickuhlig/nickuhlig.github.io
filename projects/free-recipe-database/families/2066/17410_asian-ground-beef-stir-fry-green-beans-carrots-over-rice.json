  "instructions": [
    {
      "id": 323452,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 323453,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "0.68 kg green beans\n6 medium carrots\n3 (2 ½ cm) pieces ginger root\n3 small bunches green onions (scallions)"
    },
    {
      "id": 323454,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 323455,
      "primary_message": "While the rice cooks, trim and cut green beans into 1-inch pieces; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 323456,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the green beans and set aside.",
      "secondary_message": null
    },
    {
      "id": 323457,
      "primary_message": "Peel and mince ginger and garlic; place both in a small bowl. Add cold water (from the tap), soy sauce, cornstarch, vinegar, and chili-garlic sauce to the bowl; whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "6 cloves garlic\n1 ½ cup water\n⅓ cup soy sauce\n3 tbsp cornstarch\n3 tbsp rice vinegar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 323458,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323459,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring often, until starting to soften, 6-7 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 323460,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 323461,
      "primary_message": "Add beef, salt, and pepper to the pot with the veggies. Continue to cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1.02 kg lean ground beef\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 323462,
      "primary_message": "Add the stir-fry sauce, half of the green onions, and sesame seeds to the pot (reserve remaining green onions for the rice). Continue to cook, stirring often, until sauce thickens slightly, 2-3 minutes more.",
      "secondary_message": "1 tbsp sesame seeds"
    },
    {
      "id": 323463,
      "primary_message": "When the rice is done, add reserved green onions and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 323464,
      "primary_message": "To serve, divide rice and beef stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
