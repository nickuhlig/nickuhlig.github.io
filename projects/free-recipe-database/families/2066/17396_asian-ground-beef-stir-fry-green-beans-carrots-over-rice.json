  "instructions": [
    {
      "id": 323147,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 323148,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lb green beans\n2 medium carrots\n1 (1 inch) piece ginger root\n1 small bunch green onions (scallions)"
    },
    {
      "id": 323149,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 323150,
      "primary_message": "While the rice cooks, trim and cut green beans into 1-inch pieces; place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 323151,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the green beans and set aside.",
      "secondary_message": null
    },
    {
      "id": 323152,
      "primary_message": "Peel and mince ginger and garlic; place both in another small bowl. Add cold water (from the tap), soy sauce, cornstarch, vinegar, and chili-garlic sauce to the bowl; whisk to combine the stir-fry sauce and set aside.",
      "secondary_message": "2 cloves garlic\n½ cup water\n2 tbsp soy sauce\n1 tbsp cornstarch\n1 tbsp rice vinegar\n1 tsp chili-garlic sauce"
    },
    {
      "id": 323153,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 323154,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring often, until starting to soften, 5-6 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 323155,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 323156,
      "primary_message": "Add beef, salt, and pepper to the skillet with the veggies. Continue to cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "¾ lb lean ground beef\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 323157,
      "primary_message": "Add the stir-fry sauce, half of the green onions, and sesame seeds to the skillet (reserve remaining green onions for the rice). Continue to cook, stirring often, until sauce thickens slightly, 1-2 minutes more.",
      "secondary_message": "1 tsp sesame seeds"
    },
    {
      "id": 323158,
      "primary_message": "When the rice is done, add reserved green onions and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 323159,
      "primary_message": "To serve, divide rice and beef stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
