  "instructions": [
    {
      "id": 7830,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n236 ml (1 cup) water"
    },
    {
      "id": 7831,
      "primary_message": "Slice chicken into thin strips. Transfer to a small bowl, drizzle with soy sauce, and toss to coat. Set aside.",
      "secondary_message": "0.34 kg chicken breasts, boneless skinless\n1 tsp soy sauce"
    },
    {
      "id": 40226,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 7832,
      "primary_message": "Wash, trim ends, and thinly slice brussels sprouts.",
      "secondary_message": "0.454 kg brussels sprouts"
    },
    {
      "id": 7833,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 7834,
      "primary_message": "Peel and mince garlic and ginger. Wash and dry green onions; trim the root ends and chop.",
      "secondary_message": "1 clove garlic\r\n1 (2 ½ cm) piece ginger\r\n½ small bunch green onions (scallions)"
    },
    {
      "id": 7835,
      "primary_message": "Coat bottom of skillet with oil. Add chicken strips and cook until cooked through, 3-4 minutes per side. Transfer to a plate.",
      "secondary_message": "about 1 tbsp virgin coconut oil"
    },
    {
      "id": 7836,
      "primary_message": "Roughly chop cashews. Set aside.",
      "secondary_message": "⅛ cup cashews, roasted unsalted"
    },
    {
      "id": 7837,
      "primary_message": "Return skillet to stove and add a little more oil. Add garlic, ginger, and pepper and cook until fragrant, 15-30 seconds.",
      "secondary_message": "⅛ tsp crushed red pepper"
    },
    {
      "id": 7838,
      "primary_message": "Add sprouts and, stirring occasionally, cook until softened, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 7839,
      "primary_message": "In a small bowl, whisk together soy sauce, vinegar, honey, sesame oil, and water.",
      "secondary_message": "2 tbsp soy sauce\r\n2 tbsp rice vinegar\r\n½ tbsp honey\r\n½ tsp sesame oil\r\n¼ cup water"
    },
    {
      "id": 7840,
      "primary_message": "Add sauce to skillet and cook, stirring occasionally, until liquid thickens, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 7841,
      "primary_message": "Return chicken to skillet and add green onions. Toss and remove from heat.",
      "secondary_message": ""
    },
    {
      "id": 40225,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 7842,
      "primary_message": "To serve, place rice on a plate, top with stir fry, and sprinkle with cashews. Enjoy!",
      "secondary_message": ""
    }
  ],
