  "instructions": [
    {
      "id": 281637,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg fresh rosemary\n½ lemon\n3 tomatoes\n1 head butter (Boston) lettuce"
    },
    {
      "id": 281638,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Divide between two medium bowls.",
      "secondary_message": null
    },
    {
      "id": 281639,
      "primary_message": "Peel and mince garlic; add to one of the bowls with the rosemary.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 281640,
      "primary_message": "Zest lemon into the bowl with the rosemary and garlic; add oil, vinegar, salt, and pepper. Whisk to combine the marinade, add the steak, and turn to coat; set aside. (Reserve lemon for the next step.)",
      "secondary_message": "1 tsp extra virgin olive oil\n1 tsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper\n¾ lb striploin (New York strip) steak"
    },
    {
      "id": 281641,
      "primary_message": "While the steak is marinating, juice lemon into the second bowl with the rosemary; add oil, Dijon, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp Dijon mustard\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 281642,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 281643,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 281644,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate, loosely cover with aluminum foil, and set aside to rest.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 281645,
      "primary_message": "Meanwhile, halve tomatoes and transfer to a baking sheet pan, cut-side up; season with salt and pepper. Place in the oven and broil until softened, about 8 minutes.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 281646,
      "primary_message": "While the tomatoes are broiling, finely grate Parmesan and place in a small bowl.",
      "secondary_message": "½ oz Parmesan cheese"
    },
    {
      "id": 281647,
      "primary_message": "Peel and mince additional garlic; add to the bowl with the Parmesan, along with Italian seasoning, and stir to combine.",
      "secondary_message": "1 clove garlic\n½ tsp Italian seasoning"
    },
    {
      "id": 281648,
      "primary_message": "When the tomatoes are soft, remove from the oven and top with the Parmesan mixture. Return to the oven and continue to broil until the cheese is melted and golden, 2-3 minutes more. ",
      "secondary_message": null
    },
    {
      "id": 281649,
      "primary_message": "While the tomatoes are broiling, chop or tear lettuce into bite-sized pieces, add to the bowl with the dressing, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 281650,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 281651,
      "primary_message": "To serve, divide salad and broiled tomatoes between plates; top salad with steak and enjoy!",
      "secondary_message": null
    }
  ],
