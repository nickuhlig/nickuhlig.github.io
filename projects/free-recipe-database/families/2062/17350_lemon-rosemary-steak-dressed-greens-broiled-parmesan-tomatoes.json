  "instructions": [
    {
      "id": 281667,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh rosemary\n1 ½ lemons\n9 tomatoes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 281668,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Divide between two large bowls.",
      "secondary_message": null
    },
    {
      "id": 281669,
      "primary_message": "Peel and mince garlic; add to one of the bowls with the rosemary.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 281670,
      "primary_message": "Zest lemons into the bowl with the rosemary and garlic; add oil, vinegar, salt, and pepper. Whisk to combine the marinade, add the steak, and turn to coat; set aside. (Reserve lemons for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 ½ tsp salt\n¾ tsp black pepper\n2 ¼ lb striploin (New York strip) steak"
    },
    {
      "id": 281671,
      "primary_message": "While the steak is marinating, juice lemons into the second bowl with the rosemary; add oil, Dijon, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 281672,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. ",
      "secondary_message": null
    },
    {
      "id": 281673,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 281674,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a plate, loosely cover with aluminum foil, and set aside to rest.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 281675,
      "primary_message": "Meanwhile, halve tomatoes and transfer to a large baking sheet pan, cut-side up; season with salt and pepper. Place in the oven and broil until softened, 8-10 minutes.",
      "secondary_message": "½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 281676,
      "primary_message": "While the tomatoes are broiling, finely grate Parmesan and place in a small bowl.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 281677,
      "primary_message": "Peel and mince additional garlic; add to the bowl with the Parmesan, along with Italian seasoning, and stir to combine.",
      "secondary_message": "3 cloves garlic\n1 ½ tsp Italian seasoning"
    },
    {
      "id": 281678,
      "primary_message": "When the tomatoes are soft, remove from the oven and top with the Parmesan mixture. Return to the oven and continue to broil until the cheese is melted and golden, 2-3 minutes more. ",
      "secondary_message": null
    },
    {
      "id": 281679,
      "primary_message": "While the tomatoes are broiling, chop or tear lettuce into bite-sized pieces, add to the bowl with the dressing, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 281680,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 281681,
      "primary_message": "To serve, divide salad and broiled tomatoes between plates; top salad with steak and enjoy!",
      "secondary_message": null
    }
  ],
