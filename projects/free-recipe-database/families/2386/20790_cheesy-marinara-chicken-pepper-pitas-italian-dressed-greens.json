  "instructions": [
    {
      "id": 421651,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a large bowl, and set aside.",
      "secondary_message": "1 ½ (850 g) whole chickens rotisserie chicken, white and dark meat"
    },
    {
      "id": 421652,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 421653,
      "primary_message": "Wash and dry bell peppers. Using a clean cutting board, trim, seed, and slice peppers lengthwise into thin strips.",
      "secondary_message": "3 yellow bell peppers"
    },
    {
      "id": 421654,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 421655,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper and spices. Cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 421656,
      "primary_message": "Add marinara to the skillet and bring to a simmer. Once simmering, reduce heat to medium and continue to cook until peppers are soft and sauce has thickened slightly, 3-4 minutes more.",
      "secondary_message": "1 ½ (680 g) jars marinara sauce"
    },
    {
      "id": 421657,
      "primary_message": "Add peppers and sauce to the bowl with the chicken and stir to combine. Transfer to a large baking dish and sprinkle with cheese.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 421658,
      "primary_message": "Place baking dish in the oven and broil until the cheese is melted, about 3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421659,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Place greens in another large bowl along with carrots and dressing. Toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkgs spring mix (mixed greens)\n1 ½ (283 g) bags shredded carrots\n⅓ cup Italian salad dressing"
    },
    {
      "id": 421660,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with chicken and peppers.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 421661,
      "primary_message": "To serve, divide pitas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
