  "instructions": [
    {
      "id": 421640,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a medium bowl, and set aside.",
      "secondary_message": "1 (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 421641,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 421642,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 421643,
      "primary_message": "While the skillet heats up, wash and dry bell peppers. Using a clean cutting board, trim, seed, and slice peppers lengthwise into thin strips.",
      "secondary_message": "2 yellow bell peppers"
    },
    {
      "id": 421644,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add bell pepper and spices. Cook, stirring occasionally, until starting to soften, about 2 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 421645,
      "primary_message": "Add marinara to the skillet and bring to a simmer. Once simmering, reduce heat to medium and continue to cook until peppers are soft and sauce has thickened slightly, 2-3 minutes more.",
      "secondary_message": "1 (680 g) jar marinara sauce"
    },
    {
      "id": 421646,
      "primary_message": "Add chicken to the skillet and stir to combine. Sprinkle with cheese and remove from heat.",
      "secondary_message": "1 cup shredded cheese, Italian blend"
    },
    {
      "id": 421647,
      "primary_message": "Place skillet in the oven and broil until the cheese is melted, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 421648,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip this step if they came pre-washed). Place greens in another medium bowl along with carrots and dressing. Toss to combine the salad.",
      "secondary_message": "1 (142 g) pkg spring mix (mixed greens)\n1 (283 g) bag shredded carrots\n¼ cup Italian salad dressing"
    },
    {
      "id": 421649,
      "primary_message": "Cut pitas in half and carefully open the pockets; stuff each pocket with chicken and peppers.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 421650,
      "primary_message": "To serve, divide pitas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
