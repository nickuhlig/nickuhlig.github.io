  "instructions": [
    {
      "id": 358929,
      "primary_message": "Wash, dry, and cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. Transfer to a large bowl and set aside.",
      "secondary_message": "3 medium heads cauliflower"
    },
    {
      "id": 358930,
      "primary_message": "Peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 358931,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 358932,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 358933,
      "primary_message": "While the onion is cooking, fill another large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 358934,
      "primary_message": "Use the tip of a knife to slice down the length of each sausage. Peel off the casings and discard. Add sausage meat to the pot with the onions and, breaking apart with a spoon, cook until starting to brown, 5-6 minutes. ",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 358935,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 358936,
      "primary_message": "Add garlic, tomato sauce, water, sugar, and spices to the pot with the sausage and stir to combine. Cook, stirring occasionally, until slightly thickened, 5-6 minutes.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 cup water\n1 ½ tsp brown sugar\n¾ tsp rosemary, dried\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper\n3 pinch cinnamon, ground"
    },
    {
      "id": 358937,
      "primary_message": "Once the water in the other pot is boiling, add cauliflower and salt. Cook, stirring occasionally, until fork-tender, about 5 minutes. Drain in a colander and set aside.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 358938,
      "primary_message": "Meanwhile, finely grate Parmesan and set aside.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 358939,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the ragú and stir to combine. Remove from heat.",
      "secondary_message": "2 small pkgs fresh basil"
    },
    {
      "id": 358940,
      "primary_message": "To serve, divide cauliflower and ragú between plates or bowls. Garnish with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
