  "instructions": [
    {
      "id": 358963,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 358964,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 358965,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 358966,
      "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 358967,
      "primary_message": "When the onion is soft, add veggie ground, Italian seasoning, and salt to the pot with the onions. Cook, breaking it apart with a spoon, until brown and crumbly, 5-6 minutes. ",
      "secondary_message": "24 oz veggie ground, plant based\n¾ tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 358968,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 358969,
      "primary_message": "Add garlic, tomato sauce, water, sugar, and spices to the pot with the veggie ground and stir to combine. Cook, stirring occasionally, until slightly thickened, 5-6 minutes.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 cup water\n1 ½ tsp brown sugar\n¾ tsp rosemary, dried\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper\n3 pinch cinnamon, ground"
    },
    {
      "id": 358970,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, 4-5 minutes. Drain in a colander and set aside.",
      "secondary_message": "3 (16 oz) pkg potato gnocchi\n1 ½ tsp salt"
    },
    {
      "id": 358971,
      "primary_message": "While the gnocchi is cooking, finely grate Parmesan and set aside.",
      "secondary_message": "1 ½ oz Parmesan cheese"
    },
    {
      "id": 358972,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the ragù and stir to combine. Remove from heat.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 358973,
      "primary_message": "To serve, divide gnocchi and ragù between plates or bowls. Sprinkle with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
