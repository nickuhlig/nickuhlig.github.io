  "instructions": [
    {
      "id": 358952,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 358953,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 358954,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 3-4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 358955,
      "primary_message": "Meanwhile, fill another large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 358956,
      "primary_message": "When the onion is soft, add veggie ground, Italian seasoning, and salt to the pot with the onions. Cook, breaking it apart with a spoon, until brown and crumbly, 4-5 minutes. ",
      "secondary_message": "16 oz veggie ground, plant based\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 358957,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 358958,
      "primary_message": "Add garlic, tomato sauce, water, sugar, and spices to the pot with the veggie ground and stir to combine. Cook, stirring occasionally, until slightly thickened, 4-5 minutes.",
      "secondary_message": "2 (8 oz) cans tomato sauce\n⅔ cup water\n1 tsp brown sugar\n½ tsp rosemary, dried\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 358959,
      "primary_message": "Once the water in the pot is boiling, add gnocchi and salt. Cook, stirring occasionally, until gnocchi begins to float to the surface, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "2 (16 oz) pkg potato gnocchi\n1 tsp salt"
    },
    {
      "id": 358960,
      "primary_message": "While the gnocchi is cooking, finely grate Parmesan and set aside.",
      "secondary_message": "1 oz Parmesan cheese"
    },
    {
      "id": 358961,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the ragù and stir to combine. Remove from heat.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 358962,
      "primary_message": "To serve, divide gnocchi and ragù between plates or bowls. Sprinkle with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
