  "instructions": [
    {
      "id": 359007,
      "primary_message": "Wash, dry, and cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. Transfer to a medium bowl and set aside.",
      "secondary_message": "1 medium head cauliflower"
    },
    {
      "id": 359008,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 359009,
      "primary_message": "Meanwhile, peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 359010,
      "primary_message": "Once the saucepan is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 359011,
      "primary_message": "While the onion is cooking, fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 359012,
      "primary_message": "Use the tip of a knife to slice down the length of each sausage. Peel off the casings and discard. Add sausage meat to the saucepan with the onions and, breaking apart with a spoon, cook until starting to brown, about 4 minutes. ",
      "secondary_message": "2 pork sausages"
    },
    {
      "id": 359013,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 359014,
      "primary_message": "Add garlic, tomato sauce, water, sugar, and spices to the saucepan and stir to combine. Cook, stirring occasionally, until slightly thickened, 4-5 minutes.",
      "secondary_message": "1 (213 ml) can tomato sauce\n⅓ cup water\n½ tsp brown sugar\n¼ tsp rosemary, dried\n¼ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch cinnamon, ground"
    },
    {
      "id": 359015,
      "primary_message": "Once the water in the pot is boiling, add cauliflower and salt. Cook, stirring occasionally, until fork-tender, about 3 minutes. Drain in a colander and set aside.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 359016,
      "primary_message": "Meanwhile, finely grate Parmesan and set aside.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 359017,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the ragú and stir to combine. Remove from heat.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 359018,
      "primary_message": "To serve, divide cauliflower and ragú between plates or bowls. Garnish with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
