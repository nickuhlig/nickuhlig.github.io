  "instructions": [
    {
      "id": 359019,
      "primary_message": "Wash, dry, and cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Cut into small, bite-sized florets. Transfer to a large bowl and set aside.",
      "secondary_message": "2 medium heads cauliflower"
    },
    {
      "id": 359020,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 359021,
      "primary_message": "Meanwhile, peel and small dice onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 359022,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, about 4 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 359023,
      "primary_message": "While the onion is cooking, fill another large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 359024,
      "primary_message": "Use the tip of a knife to slice down the length of each sausage. Peel off the casings and discard. Add sausage meat to the pot with the onions and, breaking apart with a spoon, cook until starting to brown, about 5 minutes. ",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 359025,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 359026,
      "primary_message": "Add garlic, tomato sauce, water, sugar, and spices to the pot with the sausage and stir to combine. Cook, stirring occasionally, until slightly thickened, about 5 minutes.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n⅔ cup water\n1 tsp brown sugar\n½ tsp rosemary, dried\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp cinnamon, ground"
    },
    {
      "id": 359027,
      "primary_message": "Once the water in the other pot is boiling, add cauliflower and salt. Cook, stirring occasionally, until fork-tender, 3-5 minutes. Drain in a colander and set aside.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 359028,
      "primary_message": "Meanwhile, finely grate Parmesan and set aside.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 359029,
      "primary_message": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the ragú and stir to combine. Remove from heat.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 359030,
      "primary_message": "To serve, divide cauliflower and ragú between plates or bowls. Garnish with Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
