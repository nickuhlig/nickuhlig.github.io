  "instructions": [
    {
      "id": 200200,
      "primary_message": "Place eggs in a medium saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 200201,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 (1 inch) pieces ginger root\n1 ½ lb cremini mushrooms\n3 small bunches asparagus\n1 small bunch green onions (scallions)"
    },
    {
      "id": 200202,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Place noodles in a colander and set aside.",
      "secondary_message": null
    },
    {
      "id": 200203,
      "primary_message": "Peel and mince the garlic and ginger. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 200204,
      "primary_message": "Place garlic, ginger, broth, tahini, oil, tomato paste, soy sauce, and crushed red pepper in a large pot.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n½ cup tahini\n½ cup toasted sesame oil\n3 tbsp tomato paste\n3 tbsp soy sauce\n¾ tsp crushed red pepper"
    },
    {
      "id": 200205,
      "primary_message": "Whisk to combine, cover, and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 200206,
      "primary_message": "Meanwhile, thinly slice mushrooms and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 200207,
      "primary_message": "Snap or cut off woody ends of the asparagus and cut into bite-sized pieces. Add to the bowl with the mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 200208,
      "primary_message": "Once the broth in the pot is simmering, add the mushrooms and asparagus. Cook, stirring occasionally, until the noodles and vegetables are tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 200209,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces. Stir half of the onions into the soup (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 200210,
      "primary_message": "Add zucchini noodles to the pot with the veggies during the last 1-2 minutes of cooking; cook until tender and warmed through.",
      "secondary_message": null
    },
    {
      "id": 200211,
      "primary_message": "Peel and halve the eggs. ",
      "secondary_message": null
    },
    {
      "id": 200212,
      "primary_message": "To serve, divide soup and eggs between bowls. Garnish with reserved green onions and crushed red pepper. Enjoy!",
      "secondary_message": "¼ tsp crushed red pepper"
    }
  ],
