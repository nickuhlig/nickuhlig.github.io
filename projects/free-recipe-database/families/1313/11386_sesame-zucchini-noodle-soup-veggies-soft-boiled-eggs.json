  "instructions": [
    {
      "id": 200174,
      "primary_message": "Place eggs in a small saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 200175,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 (1 inch) piece ginger root\n½ lb cremini mushrooms\n1 small bunch asparagus\n½ small bunch green onions (scallions)"
    },
    {
      "id": 200176,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Place noodles in a colander and set aside.",
      "secondary_message": null
    },
    {
      "id": 200177,
      "primary_message": "Peel and mince the garlic and ginger. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 200178,
      "primary_message": "Place garlic, ginger, broth, tahini, oil, tomato paste, soy sauce, and crushed red pepper in a medium saucepan. ",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n3 tbsp tahini\n3 tbsp toasted sesame oil\n1 tbsp tomato paste\n1 tbsp soy sauce\n¼ tsp crushed red pepper"
    },
    {
      "id": 200179,
      "primary_message": "Whisk to combine, cover, and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 200180,
      "primary_message": "Meanwhile, thinly slice mushrooms and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 200181,
      "primary_message": "Snap or cut off woody ends of the asparagus and cut into bite-sized pieces. Add to the bowl with the mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 200182,
      "primary_message": "Once the broth in the saucepan is simmering, add the mushrooms and asparagus. Cook, stirring occasionally, until vegetables are tender, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 200183,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces. Stir half of the onions into the soup (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 200184,
      "primary_message": "Add zucchini noodles to the saucepan with the veggies during the last 1-2 minutes of cooking; cook until tender and warmed through.",
      "secondary_message": null
    },
    {
      "id": 200185,
      "primary_message": "Peel and halve the eggs. ",
      "secondary_message": null
    },
    {
      "id": 200186,
      "primary_message": "To serve, divide soup and eggs between bowls. Garnish with reserved green onions and crushed red pepper. Enjoy!",
      "secondary_message": "1 pinch crushed red pepper"
    }
  ],
