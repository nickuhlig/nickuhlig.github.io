  "instructions": [
    {
      "id": 200296,
      "primary_message": "Place eggs in a small saucepan, cover with water and bring to a boil. Reduce heat to a simmer and cook for 4 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "4 eggs"
    },
    {
      "id": 200297,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n0.45 kg cremini mushrooms\n2 small bunches asparagus\n1 small bunch green onions (scallions)"
    },
    {
      "id": 200298,
      "primary_message": "Peel and mince the garlic and ginger. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 200299,
      "primary_message": "Place garlic, ginger, broth, tahini, tomato paste, soy sauce, oil, and crushed red pepper in a large pot. ",
      "secondary_message": "1893 ml chicken or vegetable broth\n⅓ cup tahini\n2 tbsp tomato paste\n2 tbsp soy sauce\n4 tsp toasted sesame oil\n½ tsp crushed red pepper"
    },
    {
      "id": 200300,
      "primary_message": "Whisk to combine, cover, and bring to a simmer over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 200301,
      "primary_message": "Meanwhile, thinly slice mushrooms and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 200302,
      "primary_message": "Snap or cut off woody ends of the asparagus and cut into bite-sized pieces. Add to the bowl with the mushrooms. ",
      "secondary_message": null
    },
    {
      "id": 200303,
      "primary_message": "Once the broth in the pot is simmering, add the noodles, mushrooms, and asparagus. Cook, stirring occasionally, until the noodles and vegetables are tender, about 5 minutes. ",
      "secondary_message": "283 g soba (buckwheat) noodles"
    },
    {
      "id": 200304,
      "primary_message": "Meanwhile, trim green onions and cut crosswise into ¼-inch pieces. Stir half of the onions into the soup (reserve the rest for garnish).",
      "secondary_message": null
    },
    {
      "id": 200305,
      "primary_message": "Peel and halve the eggs. ",
      "secondary_message": null
    },
    {
      "id": 200306,
      "primary_message": "To serve, divide soup and eggs between bowls. Garnish with reserved green onions and crushed red pepper. Enjoy!",
      "secondary_message": "⅛ tsp crushed red pepper"
    }
  ],
