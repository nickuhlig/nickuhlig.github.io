  "instructions": [
    {
      "id": 471569,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 471570,
      "primary_message": "Place pork chops on a broiler pan and season both sides with spices.",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp smoked paprika\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471571,
      "primary_message": "Place pan in the oven. Broil, flipping halfway through, until chops are no longer pink in the center and are browned at the edges, 12-14 minutes. Remove from oven and let rest, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 471572,
      "primary_message": "Meanwhile, wash, dry, and trim zucchini. Halve lengthwise, then slice crosswise into thin half-moons. Place in a large bowl.",
      "secondary_message": "6 medium zucchini squash"
    },
    {
      "id": 471573,
      "primary_message": "Wash, dry, trim, and seed bell peppers; medium dice. Add to the bowl with the zucchini.",
      "secondary_message": "3 yellow bell peppers"
    },
    {
      "id": 471574,
      "primary_message": "Roughly chop walnuts. Add to the bowl and set aside.",
      "secondary_message": "1 ½ cups walnuts"
    },
    {
      "id": 471575,
      "primary_message": "Peel and thinly slice garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 471576,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 471577,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add garlic and cook, stirring constantly, until fragrant, about 30 seconds.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 471578,
      "primary_message": "Add zucchini, bell pepper, walnuts, and spices to the pot with the garlic. Stir to combine, then cover and cook, undisturbed, until starting to soften, about 5 minutes.",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 471579,
      "primary_message": "Uncover pot and continue to cook, stirring occasionally, until zucchini and bell pepper are fork-tender, 4-5 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 471580,
      "primary_message": "To serve, divide pork chops and veggie sauté between plates. Enjoy!",
      "secondary_message": null
    }
  ],
