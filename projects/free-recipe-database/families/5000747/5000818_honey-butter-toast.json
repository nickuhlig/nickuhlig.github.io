  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 165°C (325°F). Line a small rimmed baking sheet with parchment. In a small bowl, stir together butter, brown sugar, 1 1/2 teaspoons of the honey, salt, cinnamon, and cardamom (if using) until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "If desired, trim crusts from bread to yield a perfectly square slice. Spread a thin layer of butter mixture over top, bottom, and sides of each bread slice. Place on prepared baking sheet.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Bake until very lightly golden-brown, 12 to 16 minutes. Flip slices and continue to bake until evenly golden, 5 to 7 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Remove from oven and cool on baking sheet for 5 minutes. Transfer to a wire rack and cool until crispy, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "While toast cools, whisk together yogurt and vanilla bean paste until smooth. Stir in remaining 1 teaspoon honey, maintaining a swirl by not completely stirring it in.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Place crisped toast on a plate; dollop with yogurt, then spoon berries on top. Drizzle with more honey, if desired. Serve immediately.",
      "secondary_message": null
    }
  ],
