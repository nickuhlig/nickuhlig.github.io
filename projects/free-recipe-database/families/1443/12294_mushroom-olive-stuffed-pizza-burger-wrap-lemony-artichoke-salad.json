  "instructions": [
    {
      "id": 336615,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lemons\n0.23 kg cremini mushrooms\n3 tomatoes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 336616,
      "primary_message": "Peel and mince garlic; transfer to a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 336617,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 tbsp Dijon mustard\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 336618,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl with the dressing, toss to coat, and set aside.",
      "secondary_message": "1 ½ (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 336619,
      "primary_message": "Mince olives and mushrooms; place both in another large bowl.",
      "secondary_message": "⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 336620,
      "primary_message": "Add beef and spices to the bowl with the olives; mix with your hands until well to combined. Form into six, 1-inch thick patties, and place on a plate. Set aside.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper\n3 pinch crushed red pepper"
    },
    {
      "id": 336621,
      "primary_message": "Preheat a large grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 336622,
      "primary_message": "Meanwhile, cut tomatoes into thick slices and season both sides with salt and basil.",
      "secondary_message": "½ tsp salt\n½ tsp basil, dried"
    },
    {
      "id": 336623,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add tomatoes and grill until lightly charred, about 1 minute per side. Transfer to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 336624,
      "primary_message": "Meanwhile, slice cheese.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 336625,
      "primary_message": "Working in batches if necessary, place burger patties on the pan and grill, undisturbed, 5 minutes. Flip patties and top with cheese and grilled tomatoes; continue to grill until cooked through, 5 minutes more. Transfer to the plate used for the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 336626,
      "primary_message": "Meanwhile, chop or tear the lettuce leaves into bite-sized pieces (reserving two leaves per burger); add to the bowl with the artichokes and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 336627,
      "primary_message": "Pile leaves, in stacks of two, onto plates and top with burgers. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
