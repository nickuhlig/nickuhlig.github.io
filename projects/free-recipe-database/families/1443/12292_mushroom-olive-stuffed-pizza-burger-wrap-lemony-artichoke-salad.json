  "instructions": [
    {
      "id": 336589,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n0.11 kg cremini mushrooms\n1 tomato\n1 head butter (Boston) lettuce"
    },
    {
      "id": 336590,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 336591,
      "primary_message": "Juice lemon into the bowl with the garlic. Add oil, Dijon, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 tsp Dijon mustard\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 336592,
      "primary_message": "Drain and thinly slice artichoke hearts. Add to the bowl with the dressing, toss to coat, and set aside.",
      "secondary_message": "½ (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 336593,
      "primary_message": "Mince olives and mushrooms; place both in another medium bowl.",
      "secondary_message": "⅛ cup Kalamata olives, pitted"
    },
    {
      "id": 336594,
      "primary_message": "Add beef and spices to the bowl with the olives; mix with your hands until well to combined. Form into two, 1-inch thick patties, and place on a plate. Set aside.",
      "secondary_message": "⅓ kg lean ground beef\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 336595,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 336596,
      "primary_message": "Meanwhile, cut tomato into thick slices and season on both sides with salt and basil.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp basil, dried"
    },
    {
      "id": 336597,
      "primary_message": "Once the grill pan is hot, coat with oil. Add tomatoes and grill until lightly charred, about 1 minute per side. Transfer to a plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 336598,
      "primary_message": "Meanwhile, slice cheese.",
      "secondary_message": "¼ (227 g) block mozzarella cheese"
    },
    {
      "id": 336599,
      "primary_message": "Place burger patties on the pan and grill, undisturbed, for 5 minutes. Flip patties and top with cheese and grilled tomatoes; continue to grill until cooked through, 5 minutes more. Transfer to the plate used for the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 336600,
      "primary_message": "Meanwhile, chop or tear the lettuce leaves into bite-sized pieces (reserving two leaves per burger); add to the bowl with the artichokes and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 336601,
      "primary_message": "Pile leaves, in stacks of two, onto plates and top with burgers. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
