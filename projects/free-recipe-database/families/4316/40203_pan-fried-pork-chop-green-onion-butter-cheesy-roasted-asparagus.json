  "instructions": [
    {
      "id": 623095,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 623096,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Transfer to a baking sheet pan, spread out in an even layer, and season with spices.",
      "secondary_message": "1 small bunch asparagus\n½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 623097,
      "primary_message": "Peel and mince garlic. Cut butter into small pieces. Sprinkle both over the asparagus.",
      "secondary_message": "2 cloves garlic\n2 tsp butter, unsalted"
    },
    {
      "id": 623098,
      "primary_message": "Place baking sheet in oven (it doesn't have to be fully heated) and roast, stirring halfway through, until asparagus is fork-tender, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623099,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 623100,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623101,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 623102,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 623103,
      "primary_message": "Meanwhile, wash, dry, trim and cut green onions crosswise into thin pieces. Set aside.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 623104,
      "primary_message": "When the asparagus is done, remove from the oven and sprinkle with Parmesan. Return baking sheet to the oven and continue to roast until cheese is melted, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623105,
      "primary_message": "Return skillet (with cooking juices) to medium heat, add more butter, and swirl to coat the bottom. Add green onions and spices; cook, stirring constantly, until fragrant, about 30 seconds. Remove from heat.",
      "secondary_message": "1 tbsp butter, unsalted\n⅛ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 623106,
      "primary_message": "To serve, divide pork chops and asparagus between plates. Drizzle green onion butter over the chops and enjoy!",
      "secondary_message": null
    }
  ],
