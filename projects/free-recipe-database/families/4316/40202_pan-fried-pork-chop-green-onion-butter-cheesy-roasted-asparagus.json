  "instructions": [
    {
      "id": 623083,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 623084,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus. Divide between two baking sheet pans, spread out in an even layer, and season with spices.",
      "secondary_message": "3 small bunches asparagus\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 623085,
      "primary_message": "Peel and mince garlic. Cut butter into small pieces. Sprinkle both over the asparagus.",
      "secondary_message": "6 cloves garlic\n2 tbsp butter, unsalted"
    },
    {
      "id": 623086,
      "primary_message": "Place baking sheets in oven (it doesn't have to be fully heated) and roast, stirring halfway through, until asparagus is fork-tender, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623087,
      "primary_message": "Meanwhile, finely grate Parmesan. Set aside.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 623088,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 623089,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, bone-in\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 623090,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 623091,
      "primary_message": "Meanwhile, wash, dry, trim and cut green onions crosswise into thin pieces. Set aside.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 623092,
      "primary_message": "When the asparagus is done, remove from the oven and sprinkle with Parmesan. Return baking sheets to the oven and continue to roast until cheese is melted, 1-2 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 623093,
      "primary_message": "Return skillet (with cooking juices) to medium heat, add more butter, and swirl to coat the bottom. Add green onions and spices; cook, stirring constantly, until fragrant, about 1 minute. Remove from heat.",
      "secondary_message": "3 tbsp butter, unsalted\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 623094,
      "primary_message": "To serve, divide pork chops and asparagus between plates. Drizzle green onion butter over the chops and enjoy!",
      "secondary_message": null
    }
  ],
