  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve and pit the red cherries. Peel and cut the jicama into batons. Tear the basil leaves. Roughly crush the macadamia nuts. Zest the lime.",
      "secondary_message": "0.57 kg red cherries\n0.45 kg jicama\n1 small handful fresh basil leaves\n113 g macadamia nuts\n1 lime"
    },
    {
      "id": 1,
      "primary_message": "In a large salad or mixing bowl, combine cherries, jicama, basil, and macadamia nuts. Add lime zest and drizzle on just enough olive oil to lightly coat all ingredients. Toss well. Add lime juice to taste (should be bright and tart enough to contrast with the sweet cherries and rich olive oil), tossing well, and season with salt. Serve.",
      "secondary_message": null
    }
  ],
