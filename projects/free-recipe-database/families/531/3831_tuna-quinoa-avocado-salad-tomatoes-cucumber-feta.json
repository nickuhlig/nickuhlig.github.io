  "instructions": [
    {
      "id": 42373,
      "primary_message": "In a small saucepan, combine the quinoa and broth; bring to a boil over high heat.",
      "secondary_message": "1 cup quinoa\n473 ml (2 cups) chicken or vegetable broth"
    },
    {
      "id": 42374,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n1 English cucumber\n2 avocados\n1 lemon"
    },
    {
      "id": 42375,
      "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into 6-mm-thick pieces on an angle. Transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42376,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 42377,
      "primary_message": "Halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and large dice the flesh (cut into 2-cm cubes). Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42378,
      "primary_message": "Halve the grape tomatoes crosswise and add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42379,
      "primary_message": "Juice the lemon into a small bowl (that will be used to make the dressing).",
      "secondary_message": null
    },
    {
      "id": 42380,
      "primary_message": "To the lemon juice, add olive oil, Dijon, salt, and pepper; whisk together.",
      "secondary_message": "4 tbsp extra virgin olive oil\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42381,
      "primary_message": "Drain the tuna and flake with a fork (while still in the can). Add to the salad bowl.",
      "secondary_message": "4 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 42382,
      "primary_message": "Add the feta to the salad bowl.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 42383,
      "primary_message": "Uncover the quinoa and fluff with a fork. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 42384,
      "primary_message": "Pour the dressing over the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 42385,
      "primary_message": "To serve, divide the salad between plates or bowls and season with additional salt and pepper if desired. Enjoy!",
      "secondary_message": null
    }
  ],
