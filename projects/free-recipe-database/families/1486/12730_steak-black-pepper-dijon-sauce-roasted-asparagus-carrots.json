  "instructions": [
    {
      "id": 214507,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 214508,
      "primary_message": "Meanwhile, wash and dry the asparagus. Snap or cut off woody ends, then cut into bite-sized pieces. Transfer to a baking sheet pan.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 214509,
      "primary_message": "Wash, dry, peel, and slice carrot into thin rounds. Add to the baking sheet with the asparagus. ",
      "secondary_message": "1 medium carrot"
    },
    {
      "id": 214510,
      "primary_message": "Peel and mince garlic and shallot; sprinkle both over the veggies. Drizzle with oil, season with salt, and toss to combine.",
      "secondary_message": "1 clove garlic\n1 shallot\n2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 214511,
      "primary_message": "Place baking sheet in the oven and roast veggies, tossing once, until fork-tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 214512,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 214513,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 214514,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate and loosely cover with foil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 214515,
      "primary_message": "Return skillet to medium-high heat; add cream, Dijon, salt, and pepper. Whisk to combine the sauce and bring to a simmer. Cook until heated through and slightly thickened, 1-2 minutes. Remove from the heat. ",
      "secondary_message": "118 ml (½ cup) heavy cream\n2 tbsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 214516,
      "primary_message": "Meanwhile, thinly slice steak into strips.",
      "secondary_message": null
    },
    {
      "id": 214517,
      "primary_message": "To serve, divide steak and veggies between plates. Top steak with sauce and enjoy! ",
      "secondary_message": null
    }
  ],
