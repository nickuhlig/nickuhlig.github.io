  "instructions": [
    {
      "id": 214529,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 214530,
      "primary_message": "Meanwhile, wash and dry the asparagus. Snap or cut off woody ends, then cut into bite-sized pieces. Divide between two baking sheet pans.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 214531,
      "primary_message": "Wash, dry, peel, and slice carrots into thin rounds. Divide between baking sheets.",
      "secondary_message": "3 medium carrots"
    },
    {
      "id": 214532,
      "primary_message": "Peel and mince garlic and onion; sprinkle both over the veggies. Drizzle with oil, season with salt, and toss to combine.",
      "secondary_message": "3 cloves garlic\n1 medium red onion\n2 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 214533,
      "primary_message": "Place baking sheets in the oven and roast veggies, tossing once, until fork-tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 214534,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 214535,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 214536,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate and loosely cover with foil. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 214537,
      "primary_message": "Return skillet to medium-high heat; add cream, Dijon, salt, and pepper. Whisk to combine the sauce and bring to a simmer. Cook until heated through and slightly thickened, 2-3 minutes. Remove from the heat. ",
      "secondary_message": "355 ml heavy cream\n⅓ cup Dijon mustard\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 214538,
      "primary_message": "Meanwhile, thinly slice steak into strips.",
      "secondary_message": null
    },
    {
      "id": 214539,
      "primary_message": "To serve, divide steak and veggies between plates. Top steak with sauce and enjoy! ",
      "secondary_message": null
    }
  ],
