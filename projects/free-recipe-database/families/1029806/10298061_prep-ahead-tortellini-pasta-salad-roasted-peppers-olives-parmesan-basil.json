  "instructions": [
    {
      "primary_message": "This recipe makes 4 small meals and utilizes 4 medium food storage containers. (For \"snack-sized\" portions, you can use 6 small food storage containers.)",
      "secondary_message": null
    },
    {
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add tortellini, and stir for a few seconds. Cook, stirring occasionally, until just tender, about 5 minutes (or cook according to package instructions",
      "secondary_message": "510 g cheese tortellini, fresh or frozen"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and halve tomatoes. Place in a large bowl. ",
      "secondary_message": "1 pint grape tomatoes"
    },
    {
      "primary_message": "Roughly chop peppers and olives. Add both to the bowl with the tomatoes along with Parmesan, salt, and pepper.",
      "secondary_message": "1 (340 g) jar roasted red bell peppers\n⅔ cup Kalamata olives, pitted\n⅔ cup Parmesan cheese, shredded\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "When the tortellini is done, drain and rinse under cold water to cool completely. Add to the bowl, along with dressing, and stir to combine the pasta salad.",
      "secondary_message": "⅓ cup Italian salad dressing"
    },
    {
      "primary_message": "Divide pasta salad between containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry basil. Pick leaves off the stems and add to the containers (keeping the leaves in a small pile).",
      "secondary_message": "¼ small pkg fresh basil"
    },
    {
      "primary_message": "Cover containers and refrigerate. When ready to eat, tear basil into bite-sized pieces, stir into the pasta salad, and enjoy!",
      "secondary_message": null
    }
  ],
