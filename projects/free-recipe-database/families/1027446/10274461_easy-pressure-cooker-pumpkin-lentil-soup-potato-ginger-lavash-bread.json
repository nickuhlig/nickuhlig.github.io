  "instructions": [
    {
      "primary_message": "Wash, dry, and quarter new potatoes. Peel, halve, and small dice onion. Place both in a 6-quart pressure cooker insert along with broth, water, coconut milk, pumpkin, lentils, garlic, and spices. Stir to combine the soup, then lock lid and set to pressure cook on HIGH for 12 minutes. \n\n",
      "secondary_message": "454 g new potatoes\n1 medium yellow onion\n4 cups chicken or vegetable broth\n380 ml coconut milk\n1 (425 g) can pure pumpkin purée\n1 cup green lentils, dried\n1 tbsp minced garlic\n¾ tsp ginger, ground\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "primary_message": "When the soup is done, drape a clean towel over the vent, then manually release pressure.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide soup between bowls. Serve with lavash on the side and enjoy!",
      "secondary_message": "2 (8 x 10-inch) piece lavash bread"
    }
  ],
