  "instructions": [
    {
      "id": 491002,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 491003,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 orange bell peppers\n½ small bunch cilantro"
    },
    {
      "id": 491004,
      "primary_message": "Trim, seed, and halve bell peppers lengthwise. Transfer to a baking sheet pan. Drizzle with oil, season with salt, then arrange cut-side down. Place baking sheet in the oven and broil, flipping peppers halfway through, until lightly charred and very tender, 8-10 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 491005,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with cheese and chili powder. Stir to combine.",
      "secondary_message": "2 cups shredded cheese, Mexican blend\n1 tsp chili powder"
    },
    {
      "id": 491006,
      "primary_message": "When the bell peppers are done, remove from oven. With the peppers facing cut-side up, fill with the cheese mixture. ",
      "secondary_message": null
    },
    {
      "id": 491007,
      "primary_message": "Return peppers to the oven and continue to broil until cheese is melted, 1-2 minutes more. Remove from oven, and using tongs, carefully fold one half of each pepper over the other half to enclose the cheese.",
      "secondary_message": null
    },
    {
      "id": 491008,
      "primary_message": "Divide stuffed bell peppers between plates. Serve with guacamole on the side and enjoy!",
      "secondary_message": "1 cup guacamole"
    }
  ],
