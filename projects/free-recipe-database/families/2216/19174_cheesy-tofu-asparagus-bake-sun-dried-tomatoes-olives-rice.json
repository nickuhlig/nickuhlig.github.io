  "instructions": [
    {
      "id": 315690,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 315691,
      "primary_message": "Cut tofu into quarters along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 315692,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 315693,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 315694,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; divide between two large baking dishes, arranging the spears in an even layer.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 315695,
      "primary_message": "Peel and mince garlic; place in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 315696,
      "primary_message": "Mince sun-dried tomatoes and olives; add both to the bowl with the garlic, along with cream cheese, and mash with the back of a spoon to combine.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n¾ cup Kalamata olives, pitted\n1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 315697,
      "primary_message": "Season both sides of the tofu with spices, then arrange, in an even layer, on top of the asparagus; spread cream cheese mixture over top.",
      "secondary_message": "1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 315698,
      "primary_message": "Finely grate Parmesan and sprinkle over the tofu.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 315699,
      "primary_message": "Wash, dry, and juice lemons over the tofu, then drizzle with oil.",
      "secondary_message": "3 lemons\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 315700,
      "primary_message": "Place baking dishes in the oven and bake until the tofu is warmed through and asparagus is tender, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 315701,
      "primary_message": "When the tofu is done, change oven setting to broil on high; working in batches, return the baking dishes to the oven and continue to cook until topping is golden, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 315702,
      "primary_message": "To serve, divide rice, asparagus, and tofu between plates; drizzle with sauce from the dish and enjoy!",
      "secondary_message": null
    }
  ],
