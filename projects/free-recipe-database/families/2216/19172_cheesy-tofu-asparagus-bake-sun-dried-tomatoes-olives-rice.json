  "instructions": [
    {
      "id": 315664,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 315665,
      "primary_message": "Cut tofu into quarters along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 315666,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 315667,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 315668,
      "primary_message": "Meanwhile, wash, dry, and snap (or cut) off woody ends of the asparagus; place in a baking dish, arranging the spears in an even layer.",
      "secondary_message": "1 small bunch asparagus"
    },
    {
      "id": 315669,
      "primary_message": "Peel and mince garlic; place in a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 315670,
      "primary_message": "Mince sun-dried tomatoes and olives; add both to the bowl with the garlic, along with cream cheese, and mash with the back of a spoon to combine.",
      "secondary_message": "6 sun-dried tomatoes, oil-packed\n¼ cup Kalamata olives, pitted\n½ (227 g) block cream cheese"
    },
    {
      "id": 315671,
      "primary_message": "Season both sides of the tofu with spices, then arrange, in an even layer, on top of the asparagus; spread cream cheese mixture over top.",
      "secondary_message": "½ tsp oregano, dried\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 315672,
      "primary_message": "Finely grate Parmesan and sprinkle over the tofu.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 315673,
      "primary_message": "Wash, dry, and juice lemon over the tofu, then drizzle with oil.",
      "secondary_message": "1 lemon\n2 tsp extra virgin olive oil"
    },
    {
      "id": 315674,
      "primary_message": "Place baking dish in the oven and bake until the tofu is warmed through and asparagus is tender, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 315675,
      "primary_message": "When the tofu is done, change oven setting to broil on high; continue to cook until topping is golden, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 315676,
      "primary_message": "To serve, divide rice, asparagus, and tofu between plates; drizzle with sauce from the dish and enjoy!",
      "secondary_message": null
    }
  ],
