  "instructions": [
    {
      "id": 315654,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 315655,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; divide between two large baking dishes, arranging the spears in an even layer.",
      "secondary_message": "3 small bunches asparagus"
    },
    {
      "id": 315656,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season both sides with spices and arrange on top of the asparagus in an even layer.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp oregano, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 315657,
      "primary_message": "Using a clean cutting board, peel and mince garlic; place in a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 315658,
      "primary_message": "Mince sun-dried tomatoes and olives; add both to the bowl with the garlic, along with cream cheese, and mash with the back of a spoon to combine. Spread over the top side of the chicken cutlets.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n¾ cup Kalamata olives, pitted\n1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 315659,
      "primary_message": "Finely grate Parmesan and sprinkle over the chicken.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 315660,
      "primary_message": "Wash, dry, and juice lemons over the chicken, then drizzle with oil.",
      "secondary_message": "1 ½ lemons\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 315661,
      "primary_message": "Place baking dishes in the oven and bake until the asparagus is tender and chicken is cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 315662,
      "primary_message": "When the chicken is done, change oven setting to broil on high; working in batches, return the baking dishes to the oven and continue to cook until topping is golden, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 315663,
      "primary_message": "To serve, divide asparagus and chicken between plates; drizzle with sauce from the dish and enjoy!",
      "secondary_message": null
    }
  ],
