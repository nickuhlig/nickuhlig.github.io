  "instructions": [
    {
      "id": 315575,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 315576,
      "primary_message": "Wash, dry, and snap (or cut) off woody ends of the asparagus; place in a large baking dish, arranging the spears in an even layer.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 315577,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season both sides with spices and arrange on top of the asparagus in an even layer.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 315578,
      "primary_message": "Using a clean cutting board, peel and mince garlic; place in a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 315579,
      "primary_message": "Mince sun-dried tomatoes and olives; add both to the bowl with the garlic, along with cream cheese, and mash with the back of a spoon to combine. Spread over the top side of the chicken cutlets.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n½ cup Kalamata olives, pitted\n1 (8 oz) block cream cheese"
    },
    {
      "id": 315580,
      "primary_message": "Finely grate Parmesan and sprinkle over the chicken.",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 315581,
      "primary_message": "Wash, dry, and juice lemon over the chicken, then drizzle with oil.",
      "secondary_message": "1 lemon\n4 tsp extra virgin olive oil"
    },
    {
      "id": 315582,
      "primary_message": "Place baking dish in the oven and bake until the asparagus is tender and chicken is cooked through, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 315583,
      "primary_message": "When the chicken is done, change oven setting to broil on high; continue to cook until topping is golden, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 315584,
      "primary_message": "To serve, divide asparagus and chicken between plates; drizzle with sauce from the dish and enjoy!",
      "secondary_message": null
    }
  ],
