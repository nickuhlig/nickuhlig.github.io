  "instructions": [
    {
      "id": 320172,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 320173,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "9 baby bok choy\n3 (227 g) pkg sugar snap peas\n3 (2 ½ cm) pieces ginger root\n3 small bunches green onions (scallions)"
    },
    {
      "id": 320174,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 320175,
      "primary_message": "While the rice cooks, place broth, chili-garlic sauce, soy sauce, vinegar, sugar, and cornstarch in a small bowl; whisk to combine the sauce and set aside. ",
      "secondary_message": "355 ml chicken or vegetable broth\n3 tbsp chili-garlic sauce\n3 tbsp soy sauce\n2 tbsp rice vinegar\n1 tbsp brown sugar\n1 tbsp cornstarch"
    },
    {
      "id": 320176,
      "primary_message": "Trim and cut bok choy crosswise into 1-inch strips. Place in a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 320177,
      "primary_message": "Halve snap peas crosswise and add to the bowl with the bok choy; set aside. ",
      "secondary_message": null
    },
    {
      "id": 320178,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 320179,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "3 tbsp toasted sesame oil\n680 g veggie ground, plant based"
    },
    {
      "id": 320180,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. Add both to the bowl with the veggies. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 320181,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add half to the bowl. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 320182,
      "primary_message": "When the veggie ground is done, add veggies, ginger, garlic, salt, and pepper to the pot; stir-fry until veggies soften, about 4 minutes.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 320183,
      "primary_message": "Add sauce to the pot and continue to cook, stirring occasionally, until sauce thickens, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 320184,
      "primary_message": "To serve, divide rice and stir-fry between plates; sprinkle with reserved green onion and enjoy! ",
      "secondary_message": null
    }
  ],
