  "instructions": [
    {
      "id": 429289,
      "primary_message": "Preheat oven to 190°C (375°F).",
      "secondary_message": null
    },
    {
      "id": 429290,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 429291,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 (454 g) pkg strawberries\n2 lemons\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 429292,
      "primary_message": "Trim and quarter strawberries lengthwise. Transfer to a baking dish, drizzle with honey, and season with salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "2 tsp honey\n⅛ tsp salt"
    },
    {
      "id": 429293,
      "primary_message": "Place baking dish in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until strawberries are soft, about 25 minutes. Remove from oven and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 429294,
      "primary_message": "Meanwhile, zest lemons into a medium bowl (reserve lemons for later use). Add mayo and spices to the bowl, then whisk to combine the marinade.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 429295,
      "primary_message": "Pat the chicken dry with paper towels and cut into bite-sized pieces. Add to the bowl with the marinade and stir to coat.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless"
    },
    {
      "id": 429296,
      "primary_message": "Thread chicken onto skewers and place on a plate. (Alternatively, you can cook the chicken pieces directly on the grill pan without using skewers.)",
      "secondary_message": null
    },
    {
      "id": 429297,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 429298,
      "primary_message": "Once the pan is hot, working in batches if necessary, add the skewers and grill, turning occasionally, until chicken is cooked through, 8-10 minutes. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 429299,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in a clean medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 429300,
      "primary_message": "Juice one lemon into the bowl with the shallot. Add oil, pepper, and salt, then whisk to combine the dressing. (Reserve remaining lemon for serving.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp black pepper\n¼ tsp salt"
    },
    {
      "id": 429301,
      "primary_message": "Pick basil leaves off the stems and roughly chop the leaves. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 429302,
      "primary_message": "Roughly chop pistachios. Add to the bowl along with arugula, cooled strawberries, and feta. Gently toss to combine the salad.",
      "secondary_message": "½ cup pistachios, unsalted\n1 (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 429303,
      "primary_message": "To serve, divide skewers and salad between plates. Squeeze reserved lemon over the skewers and enjoy!",
      "secondary_message": null
    }
  ],
