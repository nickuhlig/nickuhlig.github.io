  "instructions": [
    {
      "id": 111719,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces. Transfer to medium saucepan.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 111720,
      "primary_message": "Add broth to the saucepan, cover, and bring to a boil. Reduce to a simmer and cook until cauliflower is tender and easy to mash, about 12 minutes. Drain any excess liquid.",
      "secondary_message": "177 ml chicken or vegetable broth"
    },
    {
      "id": 111721,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 111722,
      "primary_message": "Chop the bacon into small pieces. Add to the skillet and cook until crispy, 4-6 minutes. Once cooked, remove bacon bits from skillet with slotted spoon and drain on paper towel, leaving the drippings in the pan.",
      "secondary_message": "2 slices bacon"
    },
    {
      "id": 111723,
      "primary_message": "Trim off the root ends and the dark green top of the leek, leaving only the white and pale green parts. Cut the leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice on the diagonal into ¼ inch thick pieces.",
      "secondary_message": "1 leek"
    },
    {
      "id": 111724,
      "primary_message": "Once the bacon has been transferred, add the leeks to the skillet and season with salt and pepper. Cook, stirring occasionally, until tender, about 5 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 111725,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 111726,
      "primary_message": "Add garlic and cook until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 111727,
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "¼ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 111728,
      "primary_message": "Once the cauliflower is ready, mash with a fork or potato masher, adding the leeks, butter, and parsley to the saucepan.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 111729,
      "primary_message": "Return the skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 111730,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "⅓ kg striploin (New York strip) steak\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 111731,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tsp virgin coconut oil"
    },
    {
      "id": 111732,
      "primary_message": "Carefully place the steak in the skillet; flipping every 15 to 30 seconds, cook the steak until desired doneness (5 to 7 minutes for medium-rare). (Use a thermometer or cut into the steak to check the doneness.) Once done, transfer the steak to a plate and let it rest for 5 to 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 111733,
      "primary_message": "To serve, divide the cauliflower mash and steak between plates. Top the cauliflower with bacon bits. Enjoy!",
      "secondary_message": null
    }
  ],
