  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Dressing: In a large bowl, whisk together garlic, lemon juice, vinegar, olive oil, mustard, and honey. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Salad: Add beans and shallot to dressing and toss well. Let stand at room temperature for 10 minutes. (To save time, you can prep the rest of the salad ingredients while you wait.)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir tomatoes, cucumber, olives, herbs, and cheese into bean/shallot mixture. Season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spoon salad into individual bowls or lettuce-leaf cups (if using) and serve.",
      "secondary_message": null
    }
