  "instructions": [
    {
      "id": 473377,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 473378,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg new potatoes\n1 orange bell pepper\n½ bunch Swiss chard\n½ small bunch cilantro"
    },
    {
      "id": 473379,
      "primary_message": "Halve new potatoes. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 473380,
      "primary_message": "Trim, seed, and large dice bell pepper; add to the baking sheet with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 473381,
      "primary_message": "Peel, halve, and large dice onion; add to the baking sheet. Drizzle veggies with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "1 medium yellow onion\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 473382,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 473383,
      "primary_message": "Meanwhile, place mayo, water, and spices in a small bowl. Stir to combine the sauce and set aside.",
      "secondary_message": "3 tbsp vegan mayonnaise\n1 tbsp water\n½ tsp smoked paprika\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 473384,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 473385,
      "primary_message": "While the skillet heats up, fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in another small bowl, reserving stems for the next step. (Set leaves aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 473386,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n227 g veggie ground, plant based\n¼ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 473387,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 473388,
      "primary_message": "When the veggie ground is done, add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 473389,
      "primary_message": "Remove skillet from the heat, add half of the cilantro, and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 473390,
      "primary_message": "To serve, divide roasted vegetables and veggie ground sauté between plates or bowls. Drizzle with sauce and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
