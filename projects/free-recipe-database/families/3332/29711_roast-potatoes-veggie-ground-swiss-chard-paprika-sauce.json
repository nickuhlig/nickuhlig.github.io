  "instructions": [
    {
      "id": 473391,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 473392,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg new potatoes\n2 orange bell peppers\n1 bunch Swiss chard\n1 small bunch cilantro"
    },
    {
      "id": 473393,
      "primary_message": "Halve new potatoes. Transfer to a large baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 473394,
      "primary_message": "Trim, seed, and large dice bell peppers; add to the baking sheet with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 473395,
      "primary_message": "Peel, halve, and large dice onions; add to the baking sheet. Drizzle veggies with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "2 medium yellow onions\n2 tbsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 473396,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 473397,
      "primary_message": "Meanwhile, place mayo, water, and spices in a small bowl. Stir to combine the sauce and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n2 tbsp water\n1 tsp smoked paprika\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 473398,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 473399,
      "primary_message": "While the skillet heats up, fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl, reserving stems for the next step. (Set leaves aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 473400,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based\n½ tsp smoked paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 473401,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 473402,
      "primary_message": "When the veggie ground is done, add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 473403,
      "primary_message": "Remove skillet from the heat, add half of the cilantro, and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 473404,
      "primary_message": "To serve, divide roasted vegetables and veggie ground sauté between plates or bowls. Drizzle with sauce and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
