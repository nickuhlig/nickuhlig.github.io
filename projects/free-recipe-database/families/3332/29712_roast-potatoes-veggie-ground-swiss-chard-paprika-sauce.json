  "instructions": [
    {
      "id": 473405,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 473406,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg new potatoes\n3 orange bell peppers\n1 ½ bunches Swiss chard\n1 small bunch cilantro"
    },
    {
      "id": 473407,
      "primary_message": "Halve new potatoes. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 473408,
      "primary_message": "Trim, seed, and large dice bell peppers; add to the baking sheets with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 473409,
      "primary_message": "Peel, halve, and large dice onions; add to the baking sheets. Drizzle veggies with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "3 medium yellow onions\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 473410,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 473411,
      "primary_message": "Meanwhile, place mayo, water, and spices in a small bowl. Stir to combine the sauce and set aside.",
      "secondary_message": "½ cup vegan mayonnaise\n3 tbsp water\n1 ½ tsp smoked paprika\n¾ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 473412,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl. (Set stems and leaves aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 473413,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 473414,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chard stems, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n¾ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 473415,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 473416,
      "primary_message": "When the veggie ground is done, add chard leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 473417,
      "primary_message": "Remove pot from the heat, add half of the cilantro, and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 473418,
      "primary_message": "To serve, divide roasted vegetables and veggie ground sauté between plates or bowls. Drizzle with sauce and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
