  "instructions": [
    {
      "id": 473167,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 473168,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb new potatoes\n1 orange bell pepper\n½ bunch Swiss chard\n½ small bunch cilantro"
    },
    {
      "id": 473169,
      "primary_message": "Halve new potatoes. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 473170,
      "primary_message": "Trim, seed, and large dice bell pepper; add to the baking sheet with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 473171,
      "primary_message": "Peel, halve, and large dice onion; add to the baking sheet. Drizzle veggies with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "1 medium yellow onion\n1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 473172,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and fork-tender, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 473173,
      "primary_message": "Meanwhile, place yogurt, mayo, water, and spices in a small bowl. Stir to combine the sauce and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tbsp mayonnaise\n1 tsp water\n½ tsp smoked paprika\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 473174,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 473175,
      "primary_message": "While the skillet heats up, fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in another small bowl, reserving stems for the next step. (Set leaves aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 473176,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chard stems, chicken, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes. ",
      "secondary_message": "2 tsp extra virgin olive oil\n½ lb ground chicken\n¼ tsp smoked paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 473177,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 473178,
      "primary_message": "When the chicken is done, add chard leaves to the skillet in handfuls, waiting for the leaves to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 473179,
      "primary_message": "Remove skillet from the heat, add half of the cilantro, and stir to combine. Cover with a lid to keep warm. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 473180,
      "primary_message": "To serve, divide roasted veggies and chicken sauté between plates or bowls. Drizzle with sauce and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
