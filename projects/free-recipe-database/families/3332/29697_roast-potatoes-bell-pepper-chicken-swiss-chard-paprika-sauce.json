  "instructions": [
    {
      "id": 473195,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 473196,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n3 orange bell peppers\n1 ½ bunches Swiss chard\n1 small bunch cilantro"
    },
    {
      "id": 473197,
      "primary_message": "Halve new potatoes. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 473198,
      "primary_message": "Trim, seed, and large dice bell peppers; add to the baking sheets with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 473199,
      "primary_message": "Peel, halve, and large dice onions; add to the baking sheets. Drizzle veggies with oil, then season with salt and pepper; stir to coat and spread out in an even layer.",
      "secondary_message": "3 medium yellow onions\n3 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 473200,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until potatoes are golden and fork-tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 473201,
      "primary_message": "Meanwhile, place yogurt, mayo, water, and spices in a small bowl. Stir to combine the sauce and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n⅓ cup mayonnaise\n1 tbsp water\n1 ½ tsp smoked paprika\n¾ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 473202,
      "primary_message": "Fold chard leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Place leaves in a medium bowl. (Set stems and leaves aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 473203,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 473204,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chard stems, chicken, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ lb ground chicken\n¾ tsp smoked paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 473205,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 473206,
      "primary_message": "When the chicken is done, add chard leaves to the pot in handfuls, waiting for the leaves to wilt slightly before adding the next handful. ",
      "secondary_message": null
    },
    {
      "id": 473207,
      "primary_message": "Remove pot from the heat, add half of the cilantro, and stir to combine. Cover with a lid to keep warm. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 473208,
      "primary_message": "To serve, divide roasted veggies and chicken sauté between plates or bowls. Drizzle with sauce and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
