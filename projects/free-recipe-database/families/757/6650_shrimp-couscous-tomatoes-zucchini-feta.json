  "instructions": [
    {
      "id": 163936,
      "primary_message": "In a small saucepan, bring broth to a boil over high heat. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes then fluff with a fork.",
      "secondary_message": "355 ml chicken or vegetable broth\n1 cup whole wheat couscous"
    },
    {
      "id": 163937,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.91 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 163938,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n1 small bunch fresh dill\n2 medium zucchini squash\n2 yellow bell peppers"
    },
    {
      "id": 163939,
      "primary_message": "Halve tomatoes. Cut peppers into quarters, remove seeds and membranes and slice into strips. Medium dice the zucchini into ½-inch cubes. Transfer cut veggies into a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 163940,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 163941,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 163942,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 163943,
      "primary_message": "Add the shrimp and garlic to the skillet; cook until shrimp are opaque, 1-2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 163944,
      "primary_message": "Return skillet to the heat, add oil and swirl to coat the bottom. Add peppers, zucchini, tomato, and oregano to the skillet, stirring occasionally until vegetables soften, 3-4 minutes.",
      "secondary_message": "4 tsp virgin coconut oil\n1 tsp oregano"
    },
    {
      "id": 163945,
      "primary_message": "Shave dill leaves from stalk; discard stalk and mince leaves. ",
      "secondary_message": null
    },
    {
      "id": 163946,
      "primary_message": "Once veggies are soft add broth, scraping up any browned bits, and cook until most of the liquid has evaporated, 4-5 minutes.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth"
    },
    {
      "id": 163947,
      "primary_message": "Add dill to the skillet, along with the shrimp and any accumulated juices; allow to cook for 1 minute more.",
      "secondary_message": null
    },
    {
      "id": 163948,
      "primary_message": "To serve, divide couscous between plates and top with the shrimp, veggies, and crumbled feta. Enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
