  "instructions": [
    {
      "id": 475149,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 475150,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ pints grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 475151,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 475152,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 475153,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, tomatoes, and salt. Cook, stirring occasionally, until tender and starting to brown, 7-9 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 475154,
      "primary_message": "Meanwhile, divide flatbreads between two baking sheet pans. Place in the oven (it doesn't have to be fully heated) and bake, flipping halfway through, until slightly crispy, 8-10 minutes. Remove from oven and set aside.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 475155,
      "primary_message": "While the flatbreads are baking, place cottage cheese in a strainer to remove excess liquid. Transfer to a medium bowl, season with salt, and stir to combine. Set aside.",
      "secondary_message": "3 cups cottage cheese\n3 pinch salt"
    },
    {
      "id": 475156,
      "primary_message": "Place honey, hot sauce, and salt in a small bowl. Whisk to combine the hot honey and set aside.",
      "secondary_message": "¼ cup honey\n1 tbsp hot sauce\n3 pinch salt"
    },
    {
      "id": 475157,
      "primary_message": "When the veggies are done, add vinegar to the pot, stir to combine, and remove from heat.",
      "secondary_message": "1 tbsp balsamic vinegar"
    },
    {
      "id": 475158,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the pot with the veggies and stir to combine. (Reserve remaining basil for serving.)",
      "secondary_message": null
    },
    {
      "id": 475159,
      "primary_message": "Spread the cottage cheese over each flatbread, then top with veggies.",
      "secondary_message": null
    },
    {
      "id": 475160,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Drizzle with hot honey and top with reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
