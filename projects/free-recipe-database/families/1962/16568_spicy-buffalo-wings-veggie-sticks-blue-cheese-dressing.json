  "instructions": [
    {
      "id": 270666,
      "primary_message": "Preheat oven to 245°C (475°F). Line a baking sheet pan with aluminum foil to make clean up easier (optional).",
      "secondary_message": null
    },
    {
      "id": 270667,
      "primary_message": "Pat chicken wings dry with paper towels, place on the baking sheet, and drizzle with oil. Season with salt and pepper, toss to combine, and spread out in an even layer.",
      "secondary_message": "0.45 kg chicken wings, split with tips removed\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 270668,
      "primary_message": "Place wings in the oven (it doesn't have to be fully heated) and bake, turning once, until cooked through, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 270669,
      "primary_message": "Meanwhile, place blue cheese in a small bowl; add mayo, water, vinegar, salt, and pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "½ (113 g) pkg crumbled blue cheese\n¼ cup avocado oil mayonnaise\n1 tbsp water\n1 tsp white wine vinegar\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 270670,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 medium carrot\n1 red bell pepper"
    },
    {
      "id": 270671,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into 3-inch pieces; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 270672,
      "primary_message": "Peel, trim, and quarter carrot lengthwise, then cut crosswise into 3-inch long pieces; add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 270673,
      "primary_message": "Trim, seed, and slice bell pepper into thin strips; add to the plate and set aside.",
      "secondary_message": null
    },
    {
      "id": 270674,
      "primary_message": "Place oil, chili-garlic sauce, and vinegar in a small saucepan; whisk to combine the sauce and bring to a simmer over medium heat. Once simmering, remove from heat and cover with a lid to keep warm. (If the sauce separates, whisk together once more, right before serving.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp chili-garlic sauce\n1 ½ tsp white wine vinegar"
    },
    {
      "id": 270675,
      "primary_message": "When the wings are done, drizzle with the warm sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 270676,
      "primary_message": "To serve, divide wings, veggies, and dressing between plates. Enjoy!",
      "secondary_message": null
    }
  ],
