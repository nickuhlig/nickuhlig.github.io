  "instructions": [
    {
      "id": 341003,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup of cooking water before draining; set aside.)",
      "secondary_message": "½ tsp salt\n142 g rotini pasta"
    },
    {
      "id": 341004,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n1 small pkg grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 341005,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 341006,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 341007,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the zucchini.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 341008,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 341009,
      "primary_message": "Meanwhile, halve tomatoes and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 341010,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add half of the basil to the bowl with the tomatoes. (Set remaining basil aside for garnish.)",
      "secondary_message": null
    },
    {
      "id": 341011,
      "primary_message": "Add tomato paste to the skillet with the veggies; cook, stirring often, for 1 minute.",
      "secondary_message": "1 tbsp tomato paste"
    },
    {
      "id": 341012,
      "primary_message": "Drain tuna and flake with a fork; add to the skillet along with cream, salt, and pepper; stir to combine the sauce. Reduce heat to low and continue to cook, stirring often, until sauce thickens slightly, 3-4 minutes more.",
      "secondary_message": "1 (170 g) can chunk light tuna in water\n118 ml (½ cup) heavy whipping cream\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 341013,
      "primary_message": "While the sauce is cooking, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 341014,
      "primary_message": "Add drained pasta to the skillet along with tomatoes and basil; stir to combine. Add reserved pasta water, 1 tablespoon at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 341015,
      "primary_message": "To serve, divide pasta between plates or bowls; top with Parmesan and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
