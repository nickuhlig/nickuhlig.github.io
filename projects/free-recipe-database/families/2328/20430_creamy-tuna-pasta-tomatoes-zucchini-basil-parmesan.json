  "instructions": [
    {
      "id": 341029,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of cooking water before draining; set aside.)",
      "secondary_message": "1 ½ tsp salt\n425 g rotini pasta"
    },
    {
      "id": 341030,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 341031,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 341032,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the zucchini.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 341033,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 341034,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 341035,
      "primary_message": "Meanwhile, halve tomatoes and place in the reserved bowl.",
      "secondary_message": null
    },
    {
      "id": 341036,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add half of the basil to the bowl with the tomatoes. (Set remaining basil aside for garnish.)",
      "secondary_message": null
    },
    {
      "id": 341037,
      "primary_message": "Add tomato paste to the pot with the veggies; cook, stirring often, for 1 minute.",
      "secondary_message": "3 tbsp tomato paste"
    },
    {
      "id": 341038,
      "primary_message": "Drain tuna and flake with a fork; add to the pot along with cream, salt, and pepper; stir to combine the sauce. Reduce heat to low and continue to cook, stirring often, until sauce thickens slightly, 4-5 minutes more.",
      "secondary_message": "3 (170 g) cans chunk light tuna in water\n355 ml heavy whipping cream\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 341039,
      "primary_message": "While the sauce is cooking, finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 341040,
      "primary_message": "Add drained pasta to the pot along with tomatoes and basil; stir to combine. Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 341041,
      "primary_message": "To serve, divide pasta between plates or bowls; top with Parmesan and reserved basil. Enjoy!",
      "secondary_message": null
    }
  ],
