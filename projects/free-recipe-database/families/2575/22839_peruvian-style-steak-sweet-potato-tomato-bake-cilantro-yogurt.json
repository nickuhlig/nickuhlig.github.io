  "instructions": [
    {
      "id": 377974,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 377975,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1.02 kg sweet potatoes\n6 green bell peppers\n6 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 377976,
      "primary_message": "Peel and cut each sweet potato lengthwise into 6-8 wedges, depending on size, then divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 377977,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the baking sheets with the sweet potato. ",
      "secondary_message": null
    },
    {
      "id": 377978,
      "primary_message": "Cut tomatoes into wedges and add to the baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 377979,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces. Add to the baking sheets.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 377980,
      "primary_message": "Drizzle veggies with oil and soy sauce, then season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp soy sauce\n1 tbsp garlic powder\n1 tbsp paprika\n¾ tsp black pepper"
    },
    {
      "id": 377981,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies start to soften, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 377982,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl, along with yogurt, and stir to combine. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 377983,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch thick slices. Place in a medium bowl, drizzle with additional soy sauce and oil, then season with pepper. Toss to coat.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n3 tbsp soy sauce\n2 tbsp extra virgin olive oil\n½ tsp black pepper"
    },
    {
      "id": 377984,
      "primary_message": "When the veggies are starting to soften, remove from oven. Add steak (and any marinade in the bowl) to the baking sheets, stir to combine, and return to the oven. Continue to bake until veggies are fork-tender and steak is cooked through, 10-12 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 377985,
      "primary_message": "To serve, divide steak and veggies between plates; top with cilantro yogurt. Enjoy! ",
      "secondary_message": null
    }
  ],
