  "instructions": [
    {
      "id": 377791,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 377792,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 ½ medium heads cauliflower\n6 green bell peppers\n6 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 377793,
      "primary_message": "Separate each cauliflower into bite-sized florets and cut stems into smaller pieces. Divide between two large baking sheet pans. ",
      "secondary_message": null
    },
    {
      "id": 377794,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the baking sheets with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 377795,
      "primary_message": "Cut tomatoes into wedges and add to the baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 377796,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick pieces. Add to the baking sheets.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 377797,
      "primary_message": "Drizzle the veggies with oil and soy sauce, then season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp soy sauce\n1 tbsp garlic powder\n1 tbsp paprika\n¾ tsp black pepper"
    },
    {
      "id": 377798,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies start to soften, 10-12 minutes. ",
      "secondary_message": null
    },
    {
      "id": 377799,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl, along with yogurt, and stir to combine. Set aside.",
      "secondary_message": "1 cup plain Greek yogurt"
    },
    {
      "id": 377800,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch pieces. Place in a medium bowl, drizzle with additional soy sauce and oil, then season with pepper. Toss to coat.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n3 tbsp soy sauce\n2 tbsp extra virgin olive oil\n½ tsp black pepper"
    },
    {
      "id": 377801,
      "primary_message": "When the veggies are starting to soften, remove from oven. Add steak (and any marinade in the bowl) to the baking sheets, stir to combine, and return to the oven. Continue to bake until veggies are fork-tender and steak is cooked through, 10-12 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 377802,
      "primary_message": "To serve, divide steak and veggies between plates; top with cilantro yogurt. Enjoy! ",
      "secondary_message": null
    }
  ],
