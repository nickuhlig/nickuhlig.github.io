  "instructions": [
    {
      "id": 377803,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 377804,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "½ medium head cauliflower\n2 green bell peppers\n2 tomatoes\n½ small bunch cilantro"
    },
    {
      "id": 377805,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Transfer to a baking sheet pan. ",
      "secondary_message": null
    },
    {
      "id": 377806,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the baking sheet with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 377807,
      "primary_message": "Cut tomatoes into wedges and add to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 377808,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick pieces. Add to the baking sheet.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 377809,
      "primary_message": "Drizzle the veggies with oil and coconut aminos, then season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp coconut aminos\n1 tsp garlic powder\n1 tsp paprika\n¼ tsp black pepper"
    },
    {
      "id": 377810,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies start to soften, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 377811,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl, along with yogurt, and stir to combine. Set aside.",
      "secondary_message": "⅓ cup plain Greek yogurt"
    },
    {
      "id": 377812,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch pieces. Place in another small bowl, drizzle with additional coconut aminos and oil, then season with pepper. Toss to coat.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n1 tbsp coconut aminos\n2 tsp extra virgin olive oil\n⅛ tsp black pepper"
    },
    {
      "id": 377813,
      "primary_message": "When the veggies are starting to soften, remove from oven. Add steak (and any marinade in the bowl) to the baking sheet, stir to combine, and return to the oven. Continue to bake until veggies are fork-tender and steak is cooked through, 8-10 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 377814,
      "primary_message": "To serve, divide steak and veggies between plates; top with cilantro yogurt. Enjoy! ",
      "secondary_message": null
    }
  ],
