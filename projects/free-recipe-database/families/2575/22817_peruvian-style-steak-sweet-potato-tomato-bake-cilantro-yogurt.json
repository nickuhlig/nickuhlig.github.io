  "instructions": [
    {
      "id": 377704,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 377705,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 ½ lb sweet potatoes\n4 green bell peppers\n4 tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 377706,
      "primary_message": "Peel and cut each sweet potato lengthwise into 6-8 wedges, depending on size, then transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 377707,
      "primary_message": "Trim, seed, and medium dice bell peppers. Add to the baking sheet with the sweet potato. ",
      "secondary_message": null
    },
    {
      "id": 377708,
      "primary_message": "Cut tomatoes into wedges and add to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 377709,
      "primary_message": "Peel, halve, and slice onion lengthwise into ¼-inch thick pieces. Add to the baking sheet.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 377710,
      "primary_message": "Drizzle veggies with oil and soy sauce, then season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp soy sauce\n2 tsp garlic powder\n2 tsp paprika\n½ tsp black pepper"
    },
    {
      "id": 377711,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies start to soften, about 10 minutes. ",
      "secondary_message": null
    },
    {
      "id": 377712,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a small bowl, along with yogurt, and stir to combine. Set aside.",
      "secondary_message": "⅔ cup plain Greek yogurt"
    },
    {
      "id": 377713,
      "primary_message": "Pat steak dry with paper towels and cut into 1-inch thick slices. Place in a medium bowl, drizzle with additional soy sauce and oil, then season with pepper. Toss to coat.",
      "secondary_message": "1 ½ lb striploin (New York strip) steak\n2 tbsp soy sauce\n4 tsp extra virgin olive oil\n¼ tsp black pepper"
    },
    {
      "id": 377714,
      "primary_message": "When the veggies are starting to soften, remove from oven. Add steak (and any marinade in the bowl) to the baking sheet, stir to combine, and return to the oven. Continue to bake until veggies are fork-tender and steak is cooked through, 8-10 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 377715,
      "primary_message": "To serve, divide steak and veggies between plates; top with cilantro yogurt. Enjoy! ",
      "secondary_message": null
    }
  ],
