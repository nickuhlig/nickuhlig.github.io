  "instructions": [
    {
      "id": 344551,
      "primary_message": "Preheat the oven to 220°C (425°F). Line a large baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 344552,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg fresh rosemary\n1 ½ medium heads cauliflower\n1 small pkg chives"
    },
    {
      "id": 344553,
      "primary_message": "Slide rosemary leaves off the sprigs; discard sprigs and mince the leaves. Peel and mince garlic. Place both in a small bowl along with oil, salt, and pepper; stir to combine the herb paste.",
      "secondary_message": "6 cloves garlic\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 344554,
      "primary_message": "Place chicken on the baking sheet; using your hands, coat drumsticks with herb paste and arrange in a single layer.",
      "secondary_message": "1.7 kg chicken drumsticks"
    },
    {
      "id": 344555,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, turning once, until golden brown and cooked through, about 35 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344556,
      "primary_message": "Meanwhile, fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 344557,
      "primary_message": "While the water is heating, cut each cauliflower head into quarters, then trim off and discard leaves and thick stem. Separate into 2-inch wide florets.",
      "secondary_message": null
    },
    {
      "id": 344558,
      "primary_message": "Once the water comes to a boil, uncover and add cauliflower; stir for a few seconds. Cover and return to a boil; cook until tender, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 344559,
      "primary_message": "While the cauliflower is cooking, grate the cheese. Chop chives into small pieces.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 344560,
      "primary_message": "Drain cauliflower, then carefully divide florets between two additional baking sheets; drizzle with oil and season with spices.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 344561,
      "primary_message": "Using a fork or potato masher, gently crush each cauliflower floret, flattening them to about a ½-inch thickness. Gather any loose cauliflower pieces into small piles of about the same size.",
      "secondary_message": null
    },
    {
      "id": 344562,
      "primary_message": "Sprinkle cauliflower with cheese and chives.",
      "secondary_message": null
    },
    {
      "id": 344563,
      "primary_message": "Add baking sheets to the oven and bake until cheese is golden and bubbly, about 7 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 344564,
      "primary_message": "To serve, divide drumsticks and cheesy cauliflower between plates. Enjoy!",
      "secondary_message": null
    }
  ],
