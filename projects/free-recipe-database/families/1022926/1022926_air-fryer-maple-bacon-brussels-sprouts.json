  "instructions": [
    {
      "primary_message": "Wash, dry, trim, and halve Brussels sprouts lengthwise. Place in a medium bowl.",
      "secondary_message": "1 lb Brussels sprouts"
    },
    {
      "primary_message": "Medium dice bacon. Add to the bowl with the Brussels sprouts along with maple syrup, salt, and pepper. Stir to combine.",
      "secondary_message": "4 slice bacon\n2 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Transfer Brussels sprouts and bacon to the air fryer basket, arranging them in a single layer. (Work in batches, if necessary, to accommodate the size of your air fryer basket.)",
      "secondary_message": null
    },
    {
      "primary_message": "Insert basket into air fryer and set temperature to 350°F. Cook, stirring every 5 minutes, until Brussels sprouts are tender and bacon is crisp, about 20 minutes. Remove from air fryer.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer Brussels sprouts to a serving dish and enjoy!",
      "secondary_message": null
    }
  ],
