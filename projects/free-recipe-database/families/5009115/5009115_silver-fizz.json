  "instructions": [
    {
      "id": 1,
      "primary_message": "In a cocktail shaker, dissolve the sugar in the lemon juice; add the gin and egg white and shake, without ice, for about 10 seconds to give the egg white some froth. Add ice to the shaker and shake vigorously for a good 10 seconds, to work up the foam. Strain into a chilled Collins glass and top with about 2 ounces of club soda. If you're in the mood for it, dash some bitters atop the foam.",
      "secondary_message": null
    }
  ],
