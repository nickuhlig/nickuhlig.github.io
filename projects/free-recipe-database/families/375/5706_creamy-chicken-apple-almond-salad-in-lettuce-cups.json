  "instructions": [
    {
      "id": 68105,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 68093,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Season with salt and pepper.",
      "secondary_message": "3 lb chicken breasts, boneless skinless\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 68104,
      "primary_message": "Add olive oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 68103,
      "primary_message": "Place the chicken in the skillet and cook until browned and cooked through, 3 to 4 minutes per side. Transfer to a plate and set aside to cool.",
      "secondary_message": ""
    },
    {
      "id": 68102,
      "primary_message": "While the chicken cooks, wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n3 Granny Smith apples\n1 ½ small bunches green onions\n1 ½ lemon\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 68101,
      "primary_message": "Juice the lemons into a large bowl, then add the mayonnaise, Dijon, salt, and pepper; whisk together.",
      "secondary_message": "1 cup mayonnaise\n3 tsp Dijon mustard\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 68100,
      "primary_message": "Cut the apples into 4 wedges lengthwise, core, and medium dice; add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68099,
      "primary_message": "Trim and discard the ends of the celery; medium dice and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68098,
      "primary_message": "Trim and discard the ends of the green onions; chop on an angle into ¼-inch pieces and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68097,
      "primary_message": "Measure out the sliced almonds and add to the bowl.",
      "secondary_message": "⅜ cup almonds, sliced"
    },
    {
      "id": 68096,
      "primary_message": "Separate the lettuce leaves and arrange into two-leaf stacks. Alternatively, you can chop the lettuce.",
      "secondary_message": ""
    },
    {
      "id": 68095,
      "primary_message": "Once the chicken has cooled, pull apart with your hands or medium dice; add to the bowl. Mix the salad until well combined.",
      "secondary_message": ""
    },
    {
      "id": 68094,
      "primary_message": "Spoon the chicken salad onto the leaf stacks and divide between plates. Alternatively, arrange the chopped lettuce on plates and top with the salad. Enjoy!",
      "secondary_message": ""
    }
  ],
