  "instructions": [
    {
      "id": 75488,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 tomatoes\n1 ½ English cucumber\n1 ½ lemon"
    },
    {
      "id": 75477,
      "primary_message": "Quarter the tomatoes lengthwise and cut out and discard the stem ends; cut the quarters crosswise into 1 ¼-cm-thick chunks and transfer to a large salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 75487,
      "primary_message": "Trim off and discard the ends of the cucumber; quarter the cucumber lengthwise, then slice crosswise into 1 ¼-cm-thick pieces and add to the salad bowl.",
      "secondary_message": ""
    },
    {
      "id": 75486,
      "primary_message": "Trim off and discard the ends of the shallots; peel and halve the shallots lengthwise, then thinly slice crosswise into half-rounds and add to the salad bowl.",
      "secondary_message": "3 shallots"
    },
    {
      "id": 75485,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 75476,
      "primary_message": "In a medium bowl, combine and mix together the ground beef, salt, and pepper. Form the mixture into 6 equal-sized patties and place on a plate.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 75484,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 75483,
      "primary_message": "Place the burger patties in the skillet and cook until desired doneness, 2 to 5 minutes per side. Once done, transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 75482,
      "primary_message": "Juice the lemons; add ½ of the juice to the salad bowl and transfer the other ½ to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 75481,
      "primary_message": "Drizzle the salad with olive oil and season with salt and pepper; toss to combine.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 75480,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the small bowl with the lemon juice.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 75479,
      "primary_message": "To the lemon juice and garlic, add mayonnaise, salt, and pepper; mix together until well combined.",
      "secondary_message": "9 tbsp mayonnaise\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 75478,
      "primary_message": "To serve, divide the salad between plates; place the burger patties on the side and serve with the garlic aioli. Enjoy!",
      "secondary_message": ""
    }
  ],
