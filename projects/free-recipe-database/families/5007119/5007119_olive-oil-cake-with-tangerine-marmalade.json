  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Scrub the tangerines.",
      "secondary_message": "2 large tangerines"
    },
    {
      "id": 1,
      "primary_message": "For the marmalade: Place a saucer in the freezer. Cut tangerines in quarters, then remove the peels. Coarsely chop the flesh, removing and discarding any seeds. Using a spoon, scrape off any excess pith from the tangerine peels, then slice them into 1/8-inch strips.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place orange flesh, peels, and water in medium heavy-bottomed saucepan. Bring mixture to boil over high heat, then reduce heat to medium and simmer, stirring occasionally, until rinds are tender, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in sugar and increase heat to medium-high. Stir until mixture thickens and darkens in color, 15 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "To test the marmalade, spoon 1 teaspoon onto the chilled saucer and allow to rest for 30 seconds. If, when tilted, the mixture moves only slightly, the marmalade is done. If not, continue to cook, repeating the plate test every 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cool marmalade to room temperature and serve with cake or, spread on cooled cake while marmalade is still warm.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the cake: Adjust oven rack to middle position and preheat oven to 350°F. Grease 9-inch round baking pan with 1 tablespoon olive oil.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Beat sugar and eggs on medium-high speed until pale yellow and foamy, 2 to 3 minutes. Add tangerine zest, salt, buttermilk, and olive oil and beat until thoroughly combined, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 8,
      "primary_message": "Whisk together flour, baking powder, and baking soda in small bowl. Decrease mixer speed to lowest setting and add flour mixture. Beat just until combined, scraping the sides and bottom of bowl with rubber spatula as necessary.",
      "secondary_message": null
    },
    {
      "id": 9,
      "primary_message": "Scrape batter into prepared pan and bake until cake tester inserted in center of cake comes out clean, 30 to 35 minutes",
      "secondary_message": null
    },
    {
      "id": 10,
      "primary_message": "Cool cake in pan 10 minutes, then turn over onto plate and invert onto cooling rack. Cool completely, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 11,
      "primary_message": "Transfer cake to serving platter. Sift confectioners’ sugar over cake.",
      "secondary_message": null
    }
  ],
