  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the onion. Melt the unsalted butter. Juice the lemon. Chop the scallions.",
      "secondary_message": "1 small onion\n1 tbsp (½ oz) unsalted butter\n½ lemon\n1 tbsp scallions"
    },
    {
      "id": 1,
      "primary_message": "Make Remoulade sauce: Stir all ingredients in a bowl until combined. Season to taste and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Make hush puppies: Stir cornmeal, flour, sugar, baking powder, salt, and cayenne in a medium bowl. Add onion, buttermilk, melted butter, hot sauce, and scallions (if using), and then stir until just combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour oil into a heavy duty pot to 5 cm deep. Heat over medium high heat until temperature reaches 191°C. Working in batches, gently roll dough into golf ball-sized balls and carefully lower into hot oil using a slotted spoon. Take care not to crowd pot. Fry until golden brown and cooked through, turning with wooden spoon for even browning, 2 to 3 minutes. Serve warm hush puppies plain or with remoulade dipping sauce.",
      "secondary_message": null
    }
  ],
