  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the roasted peanuts.",
      "secondary_message": "¼ cup roasted peanuts, plus more for garnish"
    },
    {
      "id": 1,
      "primary_message": "For the Peanut Butter Banana Breakfast Bars: Adjust oven rack to middle position and preheat oven to 175°C (350°F). Line an 8- by 20-cm baking pan with parchment paper, leaving a 5-cm overhang on each side. Lightly coat the parchment with cooking spray; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, use a potato masher or large fork to mash bananas until mostly smooth (about 1 cup mashed). Whisk in peanut butter, eggs, maple syrup, milk, and vanilla until well combined.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk in oats, flour, baking powder, cinnamon, and salt until evenly combined. Fold in chocolate chips, if using, and peanuts. Let batter sit for 10 minutes. (This allows the oats to begin absorbing some of the moisture.)",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Spread batter evenly in prepared pan. Bake until lightly browned around edges and center springs back when gently pressed, and a toothpick inserted in the center comes out with a few moist crumbs, 25 to 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Cool in the pan for 10 minutes. Using the parchment overhang, lift from the pan and transfer to a wire rack to cool completely, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "For the Peanut Butter Glaze: In a medium bowl, whisk peanut butter, milk, maple syrup, salt, and cinnamon together until smooth. Using a spoon, drizzle over the cooled bars. Cut into 9 large squares or 12 rectangles.",
      "secondary_message": null
    }
  ],
