  "instructions": [
    {
      "id": 299283,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 red chili pepper\n2 caps portobello mushrooms\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 299284,
      "primary_message": "Heat a medium saucepan over medium heat. Once hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 299285,
      "primary_message": "Add veggie ground to the pan; cook, breaking apart with a spoon, until crumbly and cooked through, about 5 minutes. ",
      "secondary_message": "227 g veggie ground, plant based"
    },
    {
      "id": 299286,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add to the pan with the veggie ground. Cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 299287,
      "primary_message": "Add broth to the pan and bring to a simmer over medium-high heat.",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 299288,
      "primary_message": "Remove top and seeds from the chili pepper and slice into thin rounds. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 299289,
      "primary_message": "Remove mushroom stems and scrape out the gills using a spoon; halve and thinly slice.",
      "secondary_message": null
    },
    {
      "id": 299290,
      "primary_message": "Once the soup is simmering, add chili pepper, mushrooms, soy sauce, and turmeric. Cook until mushrooms begin to soften, about 5 minutes.",
      "secondary_message": "1 tbsp soy sauce\n½ tsp turmeric, ground"
    },
    {
      "id": 299291,
      "primary_message": "Crack the eggs into a small bowl and beat lightly with a whisk or fork.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 299292,
      "primary_message": "Slowly pour egg into the soup, while gently stirring, to separate into ribbons.",
      "secondary_message": null
    },
    {
      "id": 299293,
      "primary_message": "Roughly chop spinach, add to the pan, and continue to cook until tender, 2 minutes more. ",
      "secondary_message": null
    },
    {
      "id": 299294,
      "primary_message": "To serve, divide soup between bowls and drizzle with sesame oil. Enjoy!",
      "secondary_message": "1 ½ tsp toasted sesame oil"
    }
  ],
