  "instructions": [
    {
      "id": 299009,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 red chili peppers\n3 caps portobello mushrooms\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 299010,
      "primary_message": "Heat a large pot over medium heat. Once hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 299011,
      "primary_message": "Add pork to the pot. Cook, breaking apart with a spoon, until crumbly and cooked through, about 8 minutes. ",
      "secondary_message": "2 ¼ lb lean ground pork"
    },
    {
      "id": 299012,
      "primary_message": "Meanwhile, peel and mince the garlic and ginger. Add to the pot with the pork and cook, stirring often, until fragrant, about 1 minute.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 299013,
      "primary_message": "Add broth to the pot and bring to a simmer.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth"
    },
    {
      "id": 299014,
      "primary_message": "Remove top and seeds from the peppers and slice into thin rounds. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 299015,
      "primary_message": "Remove mushroom stems and scrape out the gills using a spoon; halve and thinly slice.",
      "secondary_message": null
    },
    {
      "id": 299016,
      "primary_message": "Once the broth is simmering, add chili pepper, mushrooms, soy sauce, and turmeric. Cook until mushrooms begin to soften, about 5 minutes.",
      "secondary_message": "3 tbsp soy sauce\n1 ½ tsp turmeric, ground"
    },
    {
      "id": 299017,
      "primary_message": "Crack the eggs into a medium bowl and beat lightly with a whisk or fork.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 299018,
      "primary_message": "Slowly pour the eggs into the soup, while stirring constantly, to separate the egg into ribbons.",
      "secondary_message": null
    },
    {
      "id": 299019,
      "primary_message": "Roughly chop spinach, add to the pot, and cook for 3 minutes more. ",
      "secondary_message": null
    },
    {
      "id": 299020,
      "primary_message": "To serve, divide the soup between bowls and drizzle with sesame oil. Enjoy!",
      "secondary_message": "1 tbsp toasted sesame oil"
    }
  ],
