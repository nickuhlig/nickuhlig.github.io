  "instructions": [
    {
      "id": 299307,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 red chili peppers\n6 caps portobello mushrooms\n1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 299308,
      "primary_message": "Heat a large pot over medium heat. Once hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 299309,
      "primary_message": "Add veggie ground to the pot; cook, breaking apart with a spoon, until crumbly and cooked through, 5-6 minutes. ",
      "secondary_message": "680 g veggie ground, plant based"
    },
    {
      "id": 299310,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; add to the pot with the veggie ground. Cook, stirring constantly, until fragrant, 1-2 minutes.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 299311,
      "primary_message": "Add broth to the pot and bring to a simmer over medium-high heat.",
      "secondary_message": "2839 ml chicken or vegetable broth"
    },
    {
      "id": 299312,
      "primary_message": "Remove top and seeds from the chili peppers and slice into thin rounds. (Be careful, with chili peppers, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 299313,
      "primary_message": "Remove mushroom stems and scrape out the gills using a spoon; halve and thinly slice.",
      "secondary_message": null
    },
    {
      "id": 299314,
      "primary_message": "Once the soup is simmering, add chili pepper, mushrooms, soy sauce, and turmeric. Cook until mushrooms begin to soften, 5-6 minutes.",
      "secondary_message": "3 tbsp soy sauce\n1 ½ tsp turmeric, ground"
    },
    {
      "id": 299315,
      "primary_message": "Crack the eggs into a medium bowl and beat lightly with a whisk or fork.",
      "secondary_message": "9 eggs"
    },
    {
      "id": 299316,
      "primary_message": "Slowly pour egg into the soup, while gently stirring, to separate into ribbons.",
      "secondary_message": null
    },
    {
      "id": 299317,
      "primary_message": "Roughly chop spinach, add to the pot, and continue to cook until tender, 3 minutes more. ",
      "secondary_message": null
    },
    {
      "id": 299318,
      "primary_message": "To serve, divide soup between bowls and drizzle with sesame oil. Enjoy!",
      "secondary_message": "1 ½ tbsp toasted sesame oil"
    }
  ],
