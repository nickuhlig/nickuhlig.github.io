  "instructions": [
    {
      "id": 499695,
      "primary_message": "Preheat oven to 450°F. Line a baking sheet pan with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 499696,
      "primary_message": "Place beef, egg, bread crumbs, and spices in a medium bowl; mix with your hands until the meatloaf mixture is well combined.",
      "secondary_message": "¾ lb lean ground beef\n1 egg\n¼ cup panko bread crumbs\n2 tsp chili powder\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 499697,
      "primary_message": "Form the beef mixture into 6 short, sausage-like shapes, approximately 3-inches long. Transfer to one half of the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 499698,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips. Add to the other half of the baking sheet.",
      "secondary_message": "2 red bell peppers\n1 green bell pepper"
    },
    {
      "id": 499699,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons; add to baking sheet with the peppers. Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "½ medium red onion\n1 tbsp extra virgin olive oil\n½ tsp chili powder\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 499700,
      "primary_message": "Place baking sheet in the oven and bake, stirring veggies halfway through, until meatloaves are almost cooked through and veggies are fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 499701,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 499702,
      "primary_message": "When the meatloaves are almost cooked through, remove from the oven, and top with sliced cheese. Return to the oven and continue to bake until meatloaves are cooked through and the cheese is melted, 2-3 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 499703,
      "primary_message": "To serve, divide meatloaves and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
