  "instructions": [
    {
      "id": 499713,
      "primary_message": "Preheat oven to 450°F. Line two large baking sheet pans with aluminum foil for easier cleanup (optional).",
      "secondary_message": null
    },
    {
      "id": 499714,
      "primary_message": "Place beef, eggs, bread crumbs, and spices in a large bowl; mix with your hands until the meatloaf mixture is well combined.",
      "secondary_message": "2 ¼ lb lean ground beef\n3 eggs\n¾ cup panko bread crumbs\n2 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 499715,
      "primary_message": "Form the beef mixture into 18 short, sausage-like shapes, approximately 3-inches long. Transfer to one of the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 499716,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips. Transfer to the other baking sheet.",
      "secondary_message": "6 red bell peppers\n3 green bell peppers"
    },
    {
      "id": 499717,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons; add to baking sheet with the peppers. Drizzle veggies with oil and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "1 ½ medium red onions\n3 tbsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 499718,
      "primary_message": "Place baking sheets in the oven and bake, stirring veggies halfway through, until meatloaves are almost cooked through and veggies are fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 499719,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 499720,
      "primary_message": "When the meatloaves are almost cooked through, remove from the oven, and top with sliced cheese. Return to the oven and continue to bake until meatloaves are cooked through and the cheese is melted, 3-4 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 499721,
      "primary_message": "To serve, divide meatloaves and veggies between plates. Enjoy!",
      "secondary_message": null
    }
  ],
