  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the shallot. Pick the cilantro leaves from the stems and chop them. Finely mince the jalapeno pepper. Juice the lime.",
      "secondary_message": "1 small shallot\n2 tbsp fresh cilantro\n1 tbsp jalapeno pepper\n1 lime"
    },
    {
      "id": 1,
      "primary_message": "Bring a large pot of salted water to a boil. Meanwhile, kill lobster by inserting a large knife into its head and splitting it in half. Tear off claws (with knuckles) and tail by twisting away from lobster body, using a clean kitchen towel to grip. Discard body.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Prepare an ice bath by adding 2 quarts of water and a quart of ice cubes to a large bowl. Drop tail and claws into boiling water. Boil tail for exactly 1 1/2 minutes, then transfer to ice bath. Boil claws for a further 1 1/2 minutes (3 minutes total), then transfer to ice bath. Carefully shell lobster and transfer meat to a cutting board.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Slice lobster tail into thin slices and roughly chop claw and knuckle meat. Transfer to a medium bowl. Add shallots, cilantro, jalapeño, and lime juice. Toss to combine and season to taste with salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Plate ceviche and drizzle with extra-virgin olive oil. Serve immediately.",
      "secondary_message": null
    }
  ],
