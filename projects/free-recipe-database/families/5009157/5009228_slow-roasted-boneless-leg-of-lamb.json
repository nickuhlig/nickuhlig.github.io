  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to lower-third position and preheat oven to 135°C (275°F). In a small saucepan set over medium heat, heat olive oil until shimmering, about 3 minutes. Add garlic, shallot, anchovies, rosemary, lemon zest, and red pepper flakes. Cook, stirring occasionally, until shallots and garlic are softened, 3 to 5 minutes. Transfer to a small heatproof bowl. Stir in salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Rub half of the mixture inside butterflied lamb leg. Roll leg and, using butcher’s twine, tie securely at 2.5-cm intervals. Rub remaining mixture over exterior of lamb. Cook immediately or let rest uncovered in the refrigerator for up to 12 hours for best flavor and texture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "When ready to cook, place lamb, fat side up, on a wire rack set in a foil-lined rimmed baking sheet. Transfer to oven and roast until an instant-read thermometer inserted into thickest section of lamb registers 50°C (125°F) to 55°C (130°F) (52° to 54°C) for medium-rare, or 54°C to 57°C for medium (54° to 57°C), 2 1/2 to 3 hours. Remove from oven and let rest, uncovered, for 40 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While lamb is resting, increase oven temperature to 260°C (500°F). Return lamb to oven and roast until exterior is deep brown and crisp, about 15 minutes. Remove from oven and let rest 5 minutes. Remove twine with kitchen shears, transfer lamb to cutting board, slice into 0.5 cm slices, and serve.",
      "secondary_message": null
    }
  ],
