  "instructions": [
    {
      "id": 171912,
      "primary_message": "Wash and dry tomatoes; slice into wedges and place in a large bowl with oil, salt, and pepper.",
      "secondary_message": "6 tomatoes\n1 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 171913,
      "primary_message": "Wash and dry the basil; pick the leaves off the stems and slice into ribbons. Add to the bowl with the tomatoes and toss gently to combine the salad; set aside. ",
      "secondary_message": "1 ½ small pkgs fresh basil"
    },
    {
      "id": 171914,
      "primary_message": "Crack the eggs into a large bowl and season with pepper; whisk together.",
      "secondary_message": "12 eggs\n¾ tsp black pepper"
    },
    {
      "id": 171915,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 171916,
      "primary_message": "Add spinach and feta to eggs and stir gently to combine.",
      "secondary_message": "1 ½ (5 oz) pkgs baby spinach\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 171917,
      "primary_message": "Add oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 171918,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 171919,
      "primary_message": "To serve, divide eggs and tomato salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
