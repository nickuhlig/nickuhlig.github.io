  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 425°F. Grease bottoms of each mini loaf holder.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, combine polenta, flour, salt, sugar, baking powder, and rosemary.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, whisk together egg, olive oil, and milk until combined.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add wet ingredients to polenta mixture and stir until well combined.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Pour batter into loaf pans. Bake until golden and starting to crack on top, about 10 minutes.",
      "secondary_message": null
    }
