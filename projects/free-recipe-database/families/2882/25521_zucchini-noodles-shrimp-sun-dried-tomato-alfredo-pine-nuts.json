  "instructions": [
    {
      "id": 409056,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 409057,
      "primary_message": "Wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Divide between two large baking sheet pans, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "12 medium zucchini squash\n3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 409058,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until zucchini noodles start to soften, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 409059,
      "primary_message": "Meanwhile, place Alfredo sauce and pesto in a medium saucepan. Bring to a simmer over medium heat, stirring occasionally. Once simmering, remove from heat and cover to keep warm.",
      "secondary_message": "1 ½ (454 g) jars Alfredo sauce\n¾ cup sun-dried tomato pesto"
    },
    {
      "id": 409060,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 409061,
      "primary_message": "When the zucchini is soft, remove from the oven and toss. Top with shrimp and drizzle with additional oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 409062,
      "primary_message": "Return baking sheets to the oven and continue to bake until zucchini noodles are tender and shrimp are cooked through, 7-8 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 409063,
      "primary_message": "To serve, divide zucchini noodles and shrimp between plates or bowls; top with sauce and pine nuts. Enjoy!",
      "secondary_message": "⅓ cup pine nuts"
    }
  ],
