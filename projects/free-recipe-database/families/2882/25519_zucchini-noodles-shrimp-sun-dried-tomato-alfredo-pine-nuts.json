  "instructions": [
    {
      "id": 409040,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 409041,
      "primary_message": "Wash, dry, and trim zucchini; use a julienne (or regular) peeler to make noodles. Transfer to a baking sheet pan, drizzle with oil, and season with spices; toss to combine and spread out in an even layer.",
      "secondary_message": "4 medium zucchini squash\n1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 409042,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until zucchini noodles start to soften, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 409043,
      "primary_message": "Meanwhile, place Alfredo sauce and pesto in a small saucepan. Bring to a simmer over medium heat, stirring occasionally. Once simmering, remove from heat and cover to keep warm.",
      "secondary_message": "½ (454 g) jar Alfredo sauce\n¼ cup sun-dried tomato pesto"
    },
    {
      "id": 409044,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "⅓ kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 409045,
      "primary_message": "When the zucchini is soft, remove from the oven and toss. Top with shrimp and drizzle with additional oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 409046,
      "primary_message": "Return baking sheet to the oven and continue to bake until zucchini noodles are tender and shrimp are cooked through, 6-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 409047,
      "primary_message": "To serve, divide zucchini noodles and shrimp between plates or bowls; top with sauce and pine nuts. Enjoy!",
      "secondary_message": "⅛ cup pine nuts"
    }
  ],
