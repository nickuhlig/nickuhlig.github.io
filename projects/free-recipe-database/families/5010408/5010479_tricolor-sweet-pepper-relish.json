  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring 4 cups of water to a boil in a small saucepan over high heat. Remove from heat, add in diced peppers and let steep for 5 minutes. Strain peppers through a fine-mesh strainer.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add in vinegar, sugar, mustard seeds, salt, and celery seeds into now empty saucepan. Bring to a boil over medium-high heat, stirring to dissolve sugar.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add peppers and simmer, stirring occasionally, until little liquid remains, 15-20 minutes. Transfer relish to a jar, let cool slightly, then cover and place in refrigerator until completely chilled. Store in refrigerator for up to 2 weeks.",
      "secondary_message": null
    }
  ],
