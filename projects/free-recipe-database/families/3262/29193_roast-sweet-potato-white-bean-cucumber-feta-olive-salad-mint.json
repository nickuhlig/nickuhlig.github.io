  "instructions": [
    {
      "id": 465727,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 465728,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n1 small bunch green onions (scallions)\n1 ½ English cucumbers\n1 ½ heads romaine lettuce\n1 small pkg fresh mint"
    },
    {
      "id": 465729,
      "primary_message": "Peel and medium dice sweet potatoes. Divide between two baking sheet pans, drizzle with oil, and season with salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 465730,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is browned and fork-tender, about 20 minutes. Remove from oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 465731,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n¼ cup red wine vinegar\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 465732,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 465733,
      "primary_message": "Halve olives lengthwise and add to the bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 465734,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 465735,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 465736,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 465737,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 465738,
      "primary_message": "When the sweet potato is cool, add to the bowl, along with feta, then gently stir to combine the salad.",
      "secondary_message": "1 ½ (113 g) pkgs crumbled feta cheese"
    },
    {
      "id": 465739,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
