  "instructions": [
    {
      "id": 465701,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 465702,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg sweet potato\n½ small bunch green onions (scallions)\n½ English cucumber\n½ head romaine lettuce\n½ small pkg fresh mint"
    },
    {
      "id": 465703,
      "primary_message": "Peel and medium dice sweet potato. Transfer to a baking sheet pan, drizzle with oil, and season with salt. Stir to coat and spread out in an even layer.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 465704,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until sweet potato is browned and fork-tender, 15-20 minutes. Remove from oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 465705,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n½ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 465706,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 465707,
      "primary_message": "Halve olives lengthwise and add to the bowl.",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 465708,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 465709,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 465710,
      "primary_message": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 465711,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 465712,
      "primary_message": "When the sweet potato is cool, add to the bowl, along with feta, then gently stir to combine the salad.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 465713,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
