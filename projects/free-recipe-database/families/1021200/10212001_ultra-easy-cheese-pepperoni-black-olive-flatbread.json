  "instructions": [
    {
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange flatbreads on a baking sheet pan. Spread pizza sauce over each bread (leaving a ½-inch border around the edge), then top with cheese and pepperoni.",
      "secondary_message": "½ (397 g) jar pizza sauce\n1 cup shredded cheese, Italian blend\n43 g pepperoni, sliced"
    },
    {
      "primary_message": "Drain olives and sprinkle on top of the pizzas.",
      "secondary_message": "1 (64 g) can sliced black olives"
    },
    {
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until cheese is melted and pepperoni are warmed through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, slice flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
