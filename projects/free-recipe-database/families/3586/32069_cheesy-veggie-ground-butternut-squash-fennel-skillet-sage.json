  "instructions": [
    {
      "id": 507119,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n2 fennel bulbs\n1 small pkg fresh sage"
    },
    {
      "id": 507120,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds and medium dice. Place in a medium bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 507121,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 507122,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 507123,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and veggie ground; cook, breaking the veggie ground apart with a spoon, until it is browned and crumbly, 5-7 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n454 g veggie ground, plant based"
    },
    {
      "id": 507124,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 507125,
      "primary_message": "When the veggie ground is done, add fennel to the skillet. Cook, stirring occasionally, until fennel is softened and caramelized, about 6 minutes. Transfer veggie ground, onion, and fennel to a plate.",
      "secondary_message": null
    },
    {
      "id": 507126,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add squash and spices to the skillet. Cook, undisturbed, until the squash is just starting to brown, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 507127,
      "primary_message": "Add broth to the skillet and stir to combine. Cover and continue to cook, stirring occasionally, until the liquid has evaporated and squash is tender, 6-7 minutes more.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 507128,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 507129,
      "primary_message": "Finely grate Parmesan. Place in a small bowl and set aside.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 507130,
      "primary_message": "Pick sage leaves off the stems; discard stems and mince half of the leaves. (Reserve remaining sage for serving.)",
      "secondary_message": null
    },
    {
      "id": 507131,
      "primary_message": "When the squash is done, return veggie ground, onion, and fennel to the skillet along with minced sage. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 507132,
      "primary_message": "Transfer sausage and veggie sauté to a large baking dish, then sprinkle with Parmesan.",
      "secondary_message": null
    },
    {
      "id": 507133,
      "primary_message": "Place baking dish in the oven and broil until cheese is melted and golden, 3-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 507134,
      "primary_message": "To serve, divide skillet between plates or bowls. Top with reserved sage and enjoy!",
      "secondary_message": null
    }
  ],
