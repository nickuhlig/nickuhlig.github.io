  "instructions": [
    {
      "id": 506980,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small butternut squash\n2 fennel bulbs\n1 small pkg fresh sage"
    },
    {
      "id": 506981,
      "primary_message": "Trim and peel squash; halve lengthwise, scrape out the seeds and medium dice. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 506982,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 506983,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion. ",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 506984,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and sausage; cook, breaking the meat apart with a spoon, until sausage is browned and crumbly, 5-7 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 lb ground pork sausage"
    },
    {
      "id": 506985,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 506986,
      "primary_message": "When the sausage is done, add fennel to the skillet. Cook, stirring occasionally, until fennel is softened and caramelized, about 5 minutes. Transfer sausage, onion, and fennel to a plate.",
      "secondary_message": null
    },
    {
      "id": 506987,
      "primary_message": "Return skillet to medium heat, add more oil, and swirl to coat the bottom. Add squash and spices to the skillet. Cook, undisturbed, until the squash is just starting to brown, 2-3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 506988,
      "primary_message": "Add broth to the skillet and stir to combine. Cover and continue to cook, stirring occasionally, until the liquid has evaporated and squash is tender, 4-5 minutes more.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 506989,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 506990,
      "primary_message": "Finely grate Parmesan. Place in a small bowl and set aside.",
      "secondary_message": "4 oz Parmesan cheese"
    },
    {
      "id": 506991,
      "primary_message": "Pick sage leaves off the stems; discard stems and mince half of the leaves. (Reserve remaining sage for serving.)",
      "secondary_message": null
    },
    {
      "id": 506992,
      "primary_message": "When the squash is done, return sausage, onion, and fennel to the skillet along with minced sage. Stir to combine, then top with Parmesan. ",
      "secondary_message": null
    },
    {
      "id": 506993,
      "primary_message": "Place skillet in the oven and broil until cheese is melted and golden, 3-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 506994,
      "primary_message": "To serve, divide skillet between plates or bowls. Top with reserved sage and enjoy!",
      "secondary_message": null
    }
  ],
