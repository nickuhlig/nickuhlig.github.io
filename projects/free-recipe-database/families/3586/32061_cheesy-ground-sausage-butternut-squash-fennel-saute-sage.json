  "instructions": [
    {
      "id": 506995,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small butternut squash\n3 fennel bulbs\n1 small pkg fresh sage"
    },
    {
      "id": 506996,
      "primary_message": "Trim and peel each squash; halve lengthwise, scrape out the seeds and medium dice. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 506997,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 506998,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 506999,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and sausage; cook, breaking the meat apart with a spoon, until sausage is browned and crumbly, 7-8 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ lb ground pork sausage"
    },
    {
      "id": 507000,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons.",
      "secondary_message": null
    },
    {
      "id": 507001,
      "primary_message": "When the sausage is done, add fennel to the pot. Cook, stirring occasionally, until fennel is softened and caramelized, 5-7 minutes. Transfer sausage, onion, and fennel to a plate.",
      "secondary_message": null
    },
    {
      "id": 507002,
      "primary_message": "Return pot to medium heat, add more oil, and swirl to coat the bottom. Add squash and spices to the pot. Cook, undisturbed, until the squash is just starting to brown, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 507003,
      "primary_message": "Add broth to the pot and stir to combine. Cover and continue to cook, stirring occasionally, until the liquid has evaporated and squash is tender, 5-6 minutes more.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 507004,
      "primary_message": "Meanwhile, preheat oven to broil on high and position the rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 507005,
      "primary_message": "Finely grate Parmesan. Place in another medium bowl and set aside.",
      "secondary_message": "6 oz Parmesan cheese"
    },
    {
      "id": 507006,
      "primary_message": "Pick sage leaves off the stems; discard stems and mince half of the leaves. (Reserve remaining sage for serving.)",
      "secondary_message": null
    },
    {
      "id": 507007,
      "primary_message": "When the squash is done, return sausage, onion, and fennel to the pot along with minced sage. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 507008,
      "primary_message": "Transfer sausage and veggie sauté to a large baking dish, then sprinkle with Parmesan.",
      "secondary_message": null
    },
    {
      "id": 507009,
      "primary_message": "Place baking dish in the oven and broil until cheese is melted and golden, about 5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 507010,
      "primary_message": "To serve, divide sauté between plates or bowls. Top with reserved sage and enjoy!",
      "secondary_message": null
    }
  ],
