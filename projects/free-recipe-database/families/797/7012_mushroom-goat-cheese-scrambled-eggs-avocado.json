  "instructions": [
    {
      "id": 166922,
      "primary_message": "Wash, dry, and thinly slice the mushrooms.",
      "secondary_message": "1 lb white mushrooms"
    },
    {
      "id": 166923,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 166924,
      "primary_message": "Break the eggs into a medium bowl and season with salt and pepper; whisk together.",
      "secondary_message": "12 eggs\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 166925,
      "primary_message": "When skillet is hot, add butter and swirl to coat the bottom.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 166926,
      "primary_message": "Add mushrooms and cook, stirring occasionally, until tender and brown, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 166927,
      "primary_message": "Wash the avocado then halve and pit; slice while still in the skin then scoop out with a spoon and set aside.",
      "secondary_message": "1 avocado"
    },
    {
      "id": 166928,
      "primary_message": "Pour the egg mixture into the skillet with the mushrooms. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Add goat cheese once the eggs begin to set. Cook until the eggs are no longer runny.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 166929,
      "primary_message": "To serve, divide scrambled eggs between the plates and top with avocado. Enjoy!",
      "secondary_message": null
    }
  ],
