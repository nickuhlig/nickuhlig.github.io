  "instructions": [
    {
      "id": 483152,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 483153,
      "primary_message": "While the skillet heats up, line a plate with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 483154,
      "primary_message": "Once the skillet is hot, add almonds and cook, stirring often, until golden and fragrant, about 3 minutes. Remove from heat.",
      "secondary_message": "⅔ cup almonds, sliced"
    },
    {
      "id": 483155,
      "primary_message": "Add maple syrup and salt to the skillet with the almonds. Stir to coat, then return to medium-low heat. Cook, stirring often, until liquid is mostly evaporated, 2-3 minutes. Transfer almonds to the plate and set aside to cool (they will continue to harden as they cool).",
      "secondary_message": "3 tbsp pure maple syrup\n⅛ tsp salt"
    },
    {
      "id": 483156,
      "primary_message": "Wash and dry raspberries. Place raspberries in a small bowl (setting aside a small handful for garnish). Using a potato masher or fork, gently mash raspberries.",
      "secondary_message": "2 (6 oz) pkgs raspberries"
    },
    {
      "id": 483157,
      "primary_message": "Place milk, chocolate, maple syrup, and vanilla in a small saucepan. Slowly melt chocolate over low heat, stirring constantly, until sauce is combined and thickened, about 5 minutes. Add mashed raspberries, stir to combine, and remove from heat.",
      "secondary_message": "4 fl oz (½ cup) whole milk\n⅔ cup dark chocolate chips\n1 tbsp pure maple syrup\n1 tsp vanilla extract"
    },
    {
      "id": 483158,
      "primary_message": "To serve, place one scoop of ice cream in the bottom of each bowl; top with half of the chocolate-raspberry sauce. Place a second scoop of ice cream on top, drizzle with remaining sauce, and sprinkle with candied almonds. Enjoy!",
      "secondary_message": "24 fl oz (3 cups) vanilla ice cream"
    }
  ],
