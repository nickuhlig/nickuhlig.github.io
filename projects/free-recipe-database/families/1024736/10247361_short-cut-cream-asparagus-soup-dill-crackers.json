  "instructions": [
    {
      "primary_message": "Wash, dry, and shave dill leaves off the stems; discard stems and place leaves in a medium saucepan.",
      "secondary_message": "½ small bunch fresh dill"
    },
    {
      "primary_message": "Drain asparagus and add to the pan with the dill along with broth, cream, salt, and pepper. Using a hand blender, purée the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": "2 (411 g) can asparagus spears, canned\n2 cups chicken or vegetable broth\n1 cup heavy whipping cream\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Set soup over medium heat and cook, stirring occasionally, until soup is just simmering, 6-8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Divide soup between bowls and serve with crackers on the side. Enjoy!",
      "secondary_message": null
    }
  ],
