  "instructions": [
    {
      "id": 454353,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium yellow potatoes\n6 medium carrots\n0.68 kg cremini mushrooms\n1 ½ medium heads napa cabbage"
    },
    {
      "id": 454354,
      "primary_message": "Medium dice potatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 454355,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 454356,
      "primary_message": "Thinly slice mushrooms. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 454357,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl and set aside.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 454358,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 454359,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp coriander, ground"
    },
    {
      "id": 454360,
      "primary_message": "Add vegetables to the pot. Continue to cook, stirring occasionally, until slightly softened, 4-5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 454361,
      "primary_message": "Meanwhile, trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into 1-inch wide strips.",
      "secondary_message": null
    },
    {
      "id": 454362,
      "primary_message": "When the vegetables are done, add cabbage, broth, soy sauce, and chili-garlic sauce to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, 12-15 minutes. Remove from heat.",
      "secondary_message": "2839 ml chicken or vegetable broth\n⅓ cup soy sauce\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 454363,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
