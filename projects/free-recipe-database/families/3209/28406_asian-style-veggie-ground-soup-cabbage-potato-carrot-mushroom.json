  "instructions": [
    {
      "id": 454210,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n4 medium carrots\n1 lb cremini mushrooms\n1 medium head napa cabbage"
    },
    {
      "id": 454211,
      "primary_message": "Medium dice potatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 454212,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 454213,
      "primary_message": "Thinly slice mushrooms. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 454214,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 454215,
      "primary_message": "While the pot heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl and set aside.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 454216,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n16 oz veggie ground, plant based\n1 tsp salt\n½ tsp black pepper\n½ tsp coriander, ground"
    },
    {
      "id": 454217,
      "primary_message": "Add vegetables to the pot. Continue to cook, stirring occasionally, until slightly softened, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 454218,
      "primary_message": "Meanwhile, trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into 1-inch wide strips.",
      "secondary_message": null
    },
    {
      "id": 454219,
      "primary_message": "When the vegetables are done, add cabbage, broth, soy sauce, and chili-garlic sauce to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, 12-15 minutes. Remove from heat.",
      "secondary_message": "64 fl oz (8 cups) chicken or vegetable broth\n¼ cup soy sauce\n2 tsp chili-garlic sauce"
    },
    {
      "id": 454220,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
