  "instructions": [
    {
      "id": 454331,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium yellow potato\n2 medium carrots\n0.23 kg cremini mushrooms\n½ medium head napa cabbage"
    },
    {
      "id": 454332,
      "primary_message": "Medium dice potato. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 454333,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 454334,
      "primary_message": "Thinly slice mushrooms. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 454335,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 454336,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl and set aside.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 454337,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n227 g veggie ground, plant based\n½ tsp salt\n¼ tsp black pepper\n¼ tsp coriander, ground"
    },
    {
      "id": 454338,
      "primary_message": "Add vegetables to the pan. Continue to cook, stirring occasionally, until slightly softened, 3-4 minutes more.",
      "secondary_message": null
    },
    {
      "id": 454339,
      "primary_message": "Meanwhile, trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into 1-inch wide strips.",
      "secondary_message": null
    },
    {
      "id": 454340,
      "primary_message": "When the vegetables are done, add cabbage, broth, soy sauce, and chili-garlic sauce to the pan; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, 12-15 minutes. Remove from heat.",
      "secondary_message": "946 ml chicken or vegetable broth\n2 tbsp soy sauce\n1 tsp chili-garlic sauce"
    },
    {
      "id": 454341,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
