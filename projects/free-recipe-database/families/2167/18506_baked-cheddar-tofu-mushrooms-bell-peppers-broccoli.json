  "instructions": [
    {
      "id": 303195,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 303196,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 303197,
      "primary_message": "Place spices in a medium bowl and stir to combine.",
      "secondary_message": "½ tsp onion powder\n½ tsp garlic powder\n½ tsp rosemary, dried\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 303198,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 303199,
      "primary_message": "While the skillet heats up, medium dice tofu and place in another medium bowl. Sprinkle with cornstarch and half of the spices; gently toss to combine. (Reserve remaining spice mix for the veggies.)",
      "secondary_message": "1 tsp cornstarch"
    },
    {
      "id": 303200,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the tofu and cook, turning every few minutes, until golden brown, 8-10 minutes. Remove to a plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 303201,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 cap portobello mushroom\n1 red bell pepper\n1 crown broccoli"
    },
    {
      "id": 303202,
      "primary_message": "Remove mushroom stem and carefully scrape out the gills. Medium dice and add to the bowl with the remaining spice mix.",
      "secondary_message": null
    },
    {
      "id": 303203,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 303204,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 303205,
      "primary_message": "Return skillet to medium heat. Add more butter and swirl to coat the bottom; add veggies and remaining spice mix. Cook, stirring occasionally, until veggies soften, 5-7 minutes.",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 303206,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. Coarsely grate cheddar.",
      "secondary_message": "½ (8 oz) block cream cheese\n¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 303207,
      "primary_message": "When the veggies are soft, add cream cheese and broth to the skillet; cook, stirring frequently, until melted and combined.",
      "secondary_message": "4 fl oz (½ cup) chicken or vegetable broth"
    },
    {
      "id": 303208,
      "primary_message": "Return tofu to the skillet, stir to combine, and top with cheddar. Place skillet in the oven and bake until cheese is melted, 7-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 303209,
      "primary_message": "To serve, divide cheesy tofu and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
