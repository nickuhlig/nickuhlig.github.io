  "instructions": [
    {
      "id": 303268,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 303269,
      "primary_message": "Place spices in a large bowl and stir to combine.",
      "secondary_message": "1 ½ tsp onion powder\n1 ½ tsp garlic powder\n1 ½ tsp rosemary, dried\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 303270,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 303271,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels and place on a plate. Sprinkle half of the spices over both sides to coat. (Reserve remaining spice mix for the veggies.)",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 303272,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Working in batches if necessary, add the chicken and cook until golden brown and almost cooked through, 3-4 minutes per side. Remove to a clean plate and loosely cover with aluminum foil. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 303273,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 caps portobello mushrooms\n3 red bell peppers\n3 crowns broccoli"
    },
    {
      "id": 303274,
      "primary_message": "Remove mushroom stems and carefully scrape out the gills. Medium dice and add to the bowl with the remaining spice mix.",
      "secondary_message": null
    },
    {
      "id": 303275,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 303276,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 303277,
      "primary_message": "Return pot to medium heat. Add more butter and swirl to coat the bottom; add veggies and remaining spice mix. Cook, stirring occasionally, until veggies soften, 7-8 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 303278,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. Coarsely grate cheddar.",
      "secondary_message": "¾ (227 g) block cream cheese\n¾ (227 g) block cheddar cheese"
    },
    {
      "id": 303279,
      "primary_message": "When the veggies are soft, add cream cheese to the pot; cook, stirring frequently, until melted and combined. ",
      "secondary_message": null
    },
    {
      "id": 303280,
      "primary_message": "Transfer veggie mixture to a large baking dish; nestle chicken into the veggies and top with cheddar. Place in the oven and bake until cheese is melted and chicken is cooked through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 303281,
      "primary_message": "To serve, divide cheesy chicken and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
