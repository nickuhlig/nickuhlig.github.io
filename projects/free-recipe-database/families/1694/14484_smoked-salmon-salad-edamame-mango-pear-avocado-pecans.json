  "instructions": [
    {
      "id": 240083,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ lemon\n1 mango\n1 avocado\n1 pear\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 240084,
      "primary_message": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain.",
      "secondary_message": "1 cup edamame, shelled"
    },
    {
      "id": 240085,
      "primary_message": "Juice lemon into a medium bowl. Add oil, vinegar, Dijon, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 240086,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 240087,
      "primary_message": "Halve and pit avocado; slice crosswise while still in the skin and scoop out with a spoon. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 240088,
      "primary_message": "Quarter, core, and medium dice pear; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 240089,
      "primary_message": "Roughly chop pecans and add to the bowl.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 240090,
      "primary_message": "Chop or tear salmon into bite-sized pieces and add to the bowl.",
      "secondary_message": "1 (113 g) pkg smoked salmon"
    },
    {
      "id": 240091,
      "primary_message": "Add mixed greens and edamame to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 240092,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
