  "instructions": [
    {
      "id": 148829,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 leeks\n6 caps portobello mushrooms\n1 lemon\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 148830,
      "primary_message": "Trim off the root end and the dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch half-moons. ",
      "secondary_message": null
    },
    {
      "id": 148831,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 148832,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add the leeks and cook, stirring occasionally, until soft, 3-4 minutes. ",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 148833,
      "primary_message": "Halve mushrooms then cut crosswise into thin strips. Add to the pot with the leeks.",
      "secondary_message": null
    },
    {
      "id": 148834,
      "primary_message": "Add flour to the pot; cook, stirring constantly, until combined, about 1 minute. ",
      "secondary_message": "¼ cup all-purpose flour"
    },
    {
      "id": 148835,
      "primary_message": "Gradually stir milk into the pot, then add the broth, salt, and pepper. Bring to a boil over high heat, then reduce heat to low and simmer, covered, for 10 minutes, or until mushrooms are tender.",
      "secondary_message": "24 fl oz (3 cups) whole milk\n16 fl oz (2 cups) chicken or vegetable broth\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 148836,
      "primary_message": "Meanwhile, zest and juice lemon into a large bowl. Add oil, maple syrup, salt, and pepper; whisk to combine the dressing. Add arugula and toss to combine; set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp pure maple syrup\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 148837,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 148838,
      "primary_message": "Peel and mince garlic; transfer to a small bowl. Add butter and mash with the back of a spoon until soft. ",
      "secondary_message": "2 cloves garlic\n¼ cup butter, unsalted"
    },
    {
      "id": 148839,
      "primary_message": "Finely grate Parmesan. Add to the bowl with the butter along with spices; mash with the back of a spoon to combine. ",
      "secondary_message": "1 oz Parmesan cheese\n1 tsp Italian seasoning\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp black pepper"
    },
    {
      "id": 148840,
      "primary_message": "Slice rolls in half and place on a baking sheet pan, cut-side up. Spread with garlic butter and sprinkle with parsley. Place in the oven and cook until golden around the edges, 2-3 minutes. Remove from the oven and cut in half.",
      "secondary_message": "2 whole grain buns or rolls\n½ tsp parsley flakes"
    },
    {
      "id": 148841,
      "primary_message": "Meanwhile, using an immersion (hand) or regular blender, purée the soup until almost smooth, leaving some flecks for texture.",
      "secondary_message": null
    },
    {
      "id": 148842,
      "primary_message": "Divide soup between bowls; serve with lemony arugula and garlic bread on the side. Enjoy!",
      "secondary_message": null
    }
  ],
