  "instructions": [
    {
      "id": 384857,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 384858,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a large baking sheet pan.",
      "secondary_message": "4 crowns broccoli"
    },
    {
      "id": 384859,
      "primary_message": "Peel and quarter or halve shallots (depending on size). Add to the baking sheet with the broccoli. ",
      "secondary_message": "6 shallots"
    },
    {
      "id": 384860,
      "primary_message": "Drizzle veggies with oil and season with salt.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 384861,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until veggies are golden brown and tender, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 384862,
      "primary_message": "Meanwhile, wash, dry, and juice lemon into a small bowl. ",
      "secondary_message": "1 lemon"
    },
    {
      "id": 384863,
      "primary_message": "Add tahini, water, and spices to the bowl with the lemon juice. Whisk to combine the sauce and set aside.",
      "secondary_message": "¼ cup tahini\n3 tbsp water\n½ tsp garlic powder\n½ tsp black pepper\n⅛ tsp salt"
    },
    {
      "id": 384864,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 384865,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n1 tsp salt"
    },
    {
      "id": 384866,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate, loosely cover with aluminum foil, and set aside to rest, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 384867,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 384868,
      "primary_message": "To serve, divide steak and veggies between plates; drizzle veggies with tahini-lemon sauce. Enjoy!",
      "secondary_message": null
    }
  ],
