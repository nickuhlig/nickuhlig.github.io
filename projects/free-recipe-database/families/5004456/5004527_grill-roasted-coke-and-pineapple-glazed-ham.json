  "instructions": [
    {
      "id": 1,
      "primary_message": "To make the glaze: Combine brown sugar, Coke, pineapple juice, ketchup, honey, vinegar, and soy sauce in a medium sauce pan. Bring to a boil over medium-high heat, reduce to a simmer, and cook, stirring occasionally until thickened to a syrupy consistency, 20 to 30 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Fire up smoker or grill to 120°C. Wrap ham in heavy duty aluminum foil and place on smoked. Cover and cook until an instant read thermometer registers 38°C when inserted into thickest part of ham, about 2 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Unwrap ham and brush liberally with glaze. Cover and continue to cook for 15 minutes. Brush ham with glaze a second time, cover, and continue to cook until an instant read thermometer registers 48°C when inserted into thickest portion of ham, about 15 minutes more. Remove ham from smoker, let rest for 15 minutes, then serve.",
      "secondary_message": null
    }
  ],
