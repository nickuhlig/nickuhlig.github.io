  "instructions": [
    {
      "id": 1,
      "primary_message": "Place sweet potatoes in a large saucepan and cover with water. Heat water to 71°C as registered on an instant-read thermometer. Cover and set aside for 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, adjust oven racks to upper middle and lower middle positions and preheat oven to 200°C (400°F). Drain sweet potatoes and transfer to a large bowl. Toss with 3 tablespoons olive oil and season to taste with salt and pepper. Spread sweet potatoes on 2 rimmed baking sheets and roast until bottom side is browned, about 30 minutes. Carefully flip potatoes with thin offset spatula and roast until second side is browned and potatoes are tender, about 20 minutes longer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer to a large bowl. Toss with remaining 3 tablespoons olive oil, parsley, and honey (or maple syrup or agave nectar, if using). Serve immediately.",
      "secondary_message": null
    }
  ],
