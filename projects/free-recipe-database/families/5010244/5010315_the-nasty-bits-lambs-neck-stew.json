  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemon.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Add olive oil to the pan and set over medium-high heat, heating oil until it is near smoking. Add the pieces of neck, in batches if necessary to avoid crowding. Once the lamb is browned, removed to plate.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "When you have finished browning all the lamb, place the pieces in a pot and pour wine, stock or water to cover the meat three-quarters of the way. Add the lemon juice and thyme. Add salt.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Simmer for approximately one hour, until the lamb is tender. Removed herbs and discard. Serve lamb in soup bowls with the broth, accompanied by a good crusty loaf.",
      "secondary_message": null
    }
  ],
