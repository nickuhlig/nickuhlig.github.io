  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.) ",
      "secondary_message": "2 lb russet potatoes\n1 (5 oz) pkg baby arugula"
    },
    {
      "primary_message": "Set a 6-quart electric pressure cooker to sauté on HIGH.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "primary_message": "Once the pressure cooker insert is hot, add butter and swirl to coat the bottom. Add leeks and cook, stirring occasionally, until softened, about 4 minutes. Turn off heat.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "primary_message": "Peel and large dice potatoes. Add to the pressure cooker, along with broth and spices, then stir to combine the soup. Lock lid and set to pressure cook on HIGH for 10 minutes.\n\n",
      "secondary_message": "4 cups chicken or vegetable broth\n½ tsp garlic powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "While the soup is cooking, flake salmon into bite-sized pieces. Set aside for serving. \n\n",
      "secondary_message": "2 (4 oz) pkg hot smoked salmon"
    },
    {
      "primary_message": "When the soup is done, allow the pressure to release naturally for 10 minutes, then manually release any remaining pressure and open the lid. Add cream and stir to combine. Using an immersion or regular blender, blend the soup until smooth. (If using a regular blender, work in batches as needed, then return soup to the pressure cooker.) Remove from heat.",
      "secondary_message": "½ cup heavy whipping cream"
    },
    {
      "primary_message": "Place arugula in a medium bowl, add dressing, and toss coat.\n\n",
      "secondary_message": "¼ cup French vinaigrette"
    },
    {
      "primary_message": "Divide soup between bowls and top with flaked smoked salmon. Serve with dressed arugula on the side and enjoy!",
      "secondary_message": null
    }
  ],
