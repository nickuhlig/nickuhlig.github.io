  "instructions": [
    {
      "id": 370148,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a medium bowl, and set aside.",
      "secondary_message": "1 ½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 370149,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n3 medium zucchini squash\n1 ½ limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 370150,
      "primary_message": "Using a clean cutting board, peel, halve, and small dice onions; peel and mince garlic. Place both in another medium bowl.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 370151,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 370152,
      "primary_message": "Trim and slice celery crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370153,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 370154,
      "primary_message": "While the pot heats up, trim and halve zucchini lengthwise, then slice crosswise into thin half-moons; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 370155,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 ½ tsp chili powder\n¾ tsp oregano, dried\n¾ tsp salt"
    },
    {
      "id": 370156,
      "primary_message": "Meanwhile, cut limes into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 370157,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 370158,
      "primary_message": "When the veggies have softened, add shredded chicken, broth, and pasta to the pot; cover and bring to a boil. Once the soup is boiling, reduce heat to medium and simmer, stirring occasionally, until veggies and pasta are cooked through, about 8 minutes.",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n6 oz penne pasta"
    },
    {
      "id": 370159,
      "primary_message": "When the soup is done, add cilantro and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 370160,
      "primary_message": "Divide soup between bowls and serve with lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
