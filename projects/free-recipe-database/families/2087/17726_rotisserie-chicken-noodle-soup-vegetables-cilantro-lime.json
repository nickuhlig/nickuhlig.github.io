  "instructions": [
    {
      "id": 370122,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a small bowl, and set aside.",
      "secondary_message": "½ (30 oz) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 370123,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 medium zucchini squash\n½ lime\n½ small bunch cilantro"
    },
    {
      "id": 370124,
      "primary_message": "Using a clean cutting board, peel, halve, and small dice onion; peel and mince garlic. Place both in a medium bowl.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 370125,
      "primary_message": "Peel, trim, and slice carrot crosswise into thin rounds; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 370126,
      "primary_message": "Trim and slice celery crosswise into thin pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 370127,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 370128,
      "primary_message": "While the pan heats up, trim and halve zucchini lengthwise, then slice crosswise into thin half-moons; add to the bowl with the other veggies.",
      "secondary_message": null
    },
    {
      "id": 370129,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n¾ tsp chili powder\n¼ tsp oregano, dried\n¼ tsp salt"
    },
    {
      "id": 370130,
      "primary_message": "Meanwhile, cut lime into wedges and set aside.",
      "secondary_message": null
    },
    {
      "id": 370131,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.",
      "secondary_message": null
    },
    {
      "id": 370132,
      "primary_message": "When the veggies have softened, add shredded chicken, broth, and pasta to the pan; cover and bring to a boil. Once the soup is boiling, reduce heat to medium and simmer, stirring occasionally, until veggies and pasta are cooked through, about 8 minutes.",
      "secondary_message": "32 fl oz (4 cups) chicken or vegetable broth\n2 oz penne pasta"
    },
    {
      "id": 370133,
      "primary_message": "When the soup is done, add cilantro and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 370134,
      "primary_message": "Divide soup between bowls and serve with lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
