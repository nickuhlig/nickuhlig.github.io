  "instructions": [
    {
      "id": 440514,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 440515,
      "primary_message": "Place mayo and spices in a small bowl. Stir to combine the curry mayo and set aside.",
      "secondary_message": "3 tbsp vegan mayonnaise\n½ tsp curry powder\n⅛ tsp garlic powder\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 440516,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n½ small bunch green onions (scallions)\n1 tomato"
    },
    {
      "id": 440517,
      "primary_message": "Trim, seed, and small dice bell pepper. Place in another small bowl.",
      "secondary_message": null
    },
    {
      "id": 440518,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 440519,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 440520,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and green onion; cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 440521,
      "primary_message": "Crumble the tofu with your fingers into the skillet, then season with spices. Continue to cook, stirring occasionally, until tofu is warmed through and golden, 3-4 minutes more. Remove from heat.",
      "secondary_message": "¼ tsp turmeric, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 440522,
      "primary_message": "Meanwhile, thinly slice tomato.",
      "secondary_message": null
    },
    {
      "id": 440523,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 440524,
      "primary_message": "To serve, divide buns between plates and spread with curry mayo; top with tomato slices and tofu scramble. Enjoy!",
      "secondary_message": null
    }
  ],
