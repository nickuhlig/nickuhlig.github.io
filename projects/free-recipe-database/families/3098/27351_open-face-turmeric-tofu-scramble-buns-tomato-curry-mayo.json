  "instructions": [
    {
      "id": 440503,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 440504,
      "primary_message": "Place mayo and spices in a small bowl. Stir to combine the curry mayo and set aside.",
      "secondary_message": "½ cup mayonnaise\n1 ½ tsp curry powder\n½ tsp garlic powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 440505,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n1 small bunch green onions (scallions)\n3 tomatoes"
    },
    {
      "id": 440506,
      "primary_message": "Trim, seed, and small dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 440507,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 440508,
      "primary_message": "While the skillet heats up, trim and cut green onions crosswise into thin pieces. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 440509,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and green onion; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 440510,
      "primary_message": "Crumble the tofu with your fingers into the skillet, then season with spices. Continue to cook, stirring occasionally, until tofu is warmed through and golden, 4-5 minutes more. Remove from heat.",
      "secondary_message": "¾ tsp turmeric, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 440511,
      "primary_message": "Meanwhile, thinly slice tomatoes.",
      "secondary_message": null
    },
    {
      "id": 440512,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 440513,
      "primary_message": "To serve, divide buns between plates and spread with curry mayo; top with tomato slices and tofu scramble. Enjoy!",
      "secondary_message": null
    }
  ],
