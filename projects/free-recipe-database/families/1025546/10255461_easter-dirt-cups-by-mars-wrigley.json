  "instructions": [
    {
      "primary_message": "In medium bowl, prepare instant pudding with milk according to package directions. Fold in whipped topping.",
      "secondary_message": null
    },
    {
      "primary_message": "Spoon 2 tbsp pudding mixture into bottom of each of 12 (4-oz) clear serving cups. Divide one-third chocolate cookie crumbs among cups, then one-third M&M’S® Milk Chocolate Pastels among cups. Repeat layers 2 more times. Refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "primary_message": "In another medium bowl, toss together coconut and green food coloring until combined and mixture resembles strands of grass; add a drop more of green food coloring if needed.",
      "secondary_message": null
    },
    {
      "primary_message": "Just before serving, top each dirt cup with coconut “grass” and M&M'S® Peanut Butter Eggs.",
      "secondary_message": null
    },
    {
      "primary_message": "Chef's tip: Substitute vanilla pudding with chocolate pudding if preferred.",
      "secondary_message": null
    }
  ],
