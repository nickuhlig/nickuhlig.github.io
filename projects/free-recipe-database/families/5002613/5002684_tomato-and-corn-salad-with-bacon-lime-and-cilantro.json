  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the thick-cut bacon into 1/2-inch pieces. Shuck the fresh corn. Halve the tomato. Mince or grate the garlic. Halve the cherry tomatoes.",
      "secondary_message": "6 slices thick-cut bacon\n6 ears fresh corn\n1 medium tomato\n1 small clove garlic\n284 g cherry tomatoes"
    },
    {
      "id": 1,
      "primary_message": "In a large skillet, cook bacon over medium heat until fat is rendered and crisp, 10 to 12 minutes. Transfer bacon to a paper towel–lined plate.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While bacon cooks, in a large pot, cover corn with cold water. Set over high heat and bring to 82°C with a digital thermometer (if you don’t have a thermometer, a bare simmer is another good indicator you’ve reached the right temperature). Immediately cover and turn off the heat. Let stand for at least 10 and up to 25 minutes. Drain, rinse with cold water, and let sit until cool enough to handle, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Grate half of the medium tomato, cut side down, on the large holes of a box grater into a large bowl. Whisk in lime juice, oil, garlic, salt, and pepper. Cut remaining half of medium tomato into 1.5-cm pieces and add to bowl.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Once corn is cool, cut kernels from cobs. Add corn kernels, cherry tomatoes, cilantro, and cooked bacon to bowl with tomatoes, toss to combine, then serve.",
      "secondary_message": null
    }
  ],
