  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Juice the lemons. Thinly slice the at room temperature of the lemon. Strain the chilled pickle brine.",
      "secondary_message": "8 lemons\n1 lemon\n8 oz chilled pickle brine"
    },
    {
      "id": 1,
      "primary_message": "For the Pickle Lemonade: In a serving pitcher, place lemon slices. Add 1 cup sugar and use a muddler (or a wooden spoon) to mash sugar into lemon slices until all sugar is moistened. Let sit for 10 minutes at room temperature.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add lemon juice, water, and pickle brine to serving pitcher, and whisk thoroughly until sugar has dissolved. Refrigerate until serving.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For Serving: Serve over ice, garnish with a pickle slice and a lemon round, if desired.",
      "secondary_message": null
    }
