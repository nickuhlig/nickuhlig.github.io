  "instructions": [
    {
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry lettuce, tomatoes, jalapeños, and green onions.",
      "secondary_message": "1 head romaine lettuce\n4 tomatoes\n2 jalapeño peppers\n1 small bunch green onions (scallions)"
    },
    {
      "primary_message": "Add beef to the skillet and, breaking apart with a spoon, cook until beef is browned and crumbly, 3-4 minutes.",
      "secondary_message": "680 g lean ground beef"
    },
    {
      "primary_message": "Add chili powder, cumin, salt, and pepper to skillet and stir to combine with the beef. Remove skillet from heat.",
      "secondary_message": "1 tbsp chili powder\nsalt\nblack pepper"
    },
    {
      "primary_message": "Halve the lettuce lengthwise, then slice crosswise into thin (shred-like) strips. Small dice the tomatoes. Seed and mince the jalapeños. Trim and discard root ends and chop green onions.",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, prepare the salsa by mixing together tomatoes, jalapeño, onions, lime juice, salt, and pepper.",
      "secondary_message": "1 lime\nsalt\nblack pepper"
    },
    {
      "primary_message": "To serve, fill tortillas with shredded lettuce, ground beef, and salsa. Enjoy!",
      "secondary_message": "16 small corn tortillas"
    }
  ],
