  "instructions": [
    {
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry lettuce, tomatoes, jalapeño, and green onions.",
      "secondary_message": "½ head romaine lettuce\n2 tomatoes\n1 jalapeño pepper\n½ small bunch green onions (scallions)"
    },
    {
      "primary_message": "Add beef to the skillet and, breaking apart with a spoon, cook until beef is browned and crumbly, 3-4 minutes.",
      "secondary_message": "¾ lb lean ground beef"
    },
    {
      "primary_message": "Add chili powder, cumin, salt, and pepper to skillet and stir to combine with the beef. Remove skillet from heat.",
      "secondary_message": "½ tbsp chili powder\nsalt\nblack pepper"
    },
    {
      "primary_message": "Slice the lettuce crosswise into thin (shred-like) strips. Small dice the tomatoes. Seed and mince the jalapeño. Trim and discard root ends and chop green onions.",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, prepare the salsa by mixing together tomatoes, jalapeño, onions, lime juice, salt, and pepper.",
      "secondary_message": "½ lime\nsalt\nblack pepper"
    },
    {
      "primary_message": "To serve, fill tortillas with shredded lettuce, ground beef, and salsa. Enjoy!",
      "secondary_message": "8 small corn tortillas"
    }
  ],
