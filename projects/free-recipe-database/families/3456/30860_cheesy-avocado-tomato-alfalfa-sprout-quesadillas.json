  "instructions": [
    {
      "id": 489371,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 tomatoes\n1 avocado\n1 (3 oz) pkg alfalfa sprouts"
    },
    {
      "id": 489372,
      "primary_message": "Halve tomatoes lengthwise, then slice crosswise into thin half-moons. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 489373,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the tomato, then season both with spices. Set aside.",
      "secondary_message": "¼ tsp onion powder\n¼ tsp garlic powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 489374,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 489375,
      "primary_message": "While the skillet heats up, arrange tortillas on a flat surface. Divide cheese between tortillas, spreading it out over the entire surface. Layer tomato, avocado, and sprouts over one half of each tortilla.",
      "secondary_message": "8 small corn tortillas\n1 ⅓ cups shredded cheese, Mexican blend"
    },
    {
      "id": 489376,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, carefully add the open quesadillas and cook until tortillas start to soften and become flexible, about 1 minute.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 489377,
      "primary_message": "Using a spatula, fold the cheese-only side of the tortilla over the veggie-filled side to close. Press down on the quesadillas with the back of the spatula to seal. Continue to cook, flipping once, until cheese is melted and tortillas are golden, about 1 minute per side. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 489378,
      "primary_message": "To serve, divide quesadillas between plates and enjoy!",
      "secondary_message": null
    }
  ],
