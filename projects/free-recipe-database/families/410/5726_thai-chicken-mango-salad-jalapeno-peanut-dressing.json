  "instructions": [
    {
      "id": 68385,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 heads butter (Boston) lettuce\n3 red bell peppers\n3 mangoes\n3 jalapeño peppers\n3 limes\n1 ½ small bunches cilantro"
    },
    {
      "id": 68392,
      "primary_message": "Trim and discard the lettuce cores; chop the lettuce into bite-sized pieces and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 68384,
      "primary_message": "Cut the bell peppers into quarters lengthwise; remove and discard the seeds and white membranes. Medium dice the peppers and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68383,
      "primary_message": "Peel the mangoes and slice the flesh away from the pit, starting with the flat sides. Medium dice the mangoes and add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68391,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 68382,
      "primary_message": "Measure out and chop the peanuts; add to the bowl.",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    },
    {
      "id": 68381,
      "primary_message": "Cut the jalapeños into quarters lengthwise; remove and discard the seeds and white membranes. Mince the peppers and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 68380,
      "primary_message": "Juice the limes and add the juice to the bowl with the jalapeño.",
      "secondary_message": ""
    },
    {
      "id": 68390,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 68379,
      "primary_message": "Cut the chicken into bite-sized cubes, then season with salt and pepper.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 68389,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 68388,
      "primary_message": "Add the chicken to the skillet; cook until it is cooked through and golden brown; 3 to 4 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 68378,
      "primary_message": "While the chicken cooks, prepare the dressing by adding peanut butter, soy sauce, water, honey, and sesame oil to the bowl with the jalapeño and lime juice; whisk together until smooth. If the dressing is too thick, add more water to thin it out.",
      "secondary_message": "9 tbsp natural peanut butter\n3 tbsp soy sauce\n3 tbsp hot water\n3 tsp honey\n3 tsp toasted sesame oil"
    },
    {
      "id": 68387,
      "primary_message": "Add the chicken to the salad and toss to combine.",
      "secondary_message": ""
    },
    {
      "id": 68386,
      "primary_message": "To serve, place the salad in a bowl and drizzle with the jalapeño-peanut dressing. Enjoy!",
      "secondary_message": ""
    }
  ],
