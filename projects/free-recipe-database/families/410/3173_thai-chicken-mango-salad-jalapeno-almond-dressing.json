  "instructions": [
    {
      "id": 32198,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 head butter (Boston) lettuce\n1 red bell pepper\n1 mango\n1 jalapeño pepper\n1 lime\n½ small bunch cilantro"
    },
    {
      "id": 32199,
      "primary_message": "Trim and discard the lettuce core; chop the lettuce into bite-sized pieces and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 32200,
      "primary_message": "Cut the bell pepper into quarters lengthwise; remove and discard the seeds and white membranes. Medium dice the pepper and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 32201,
      "primary_message": "Peel the mango and slice the flesh away from the pit, starting with the flat sides. Medium dice the mango and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 32202,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 32203,
      "primary_message": "Measure out and chop the cashews; add to the bowl.",
      "secondary_message": "¼ cup cashews, roasted unsalted"
    },
    {
      "id": 32204,
      "primary_message": "Cut the jalapeño into quarters lengthwise; remove and discard the seeds and white membranes. Mince the pepper and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 32205,
      "primary_message": "Juice the lime and add the juice to the bowl with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 32206,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 32207,
      "primary_message": "Cut the chicken into bite-sized cubes, then season with salt and pepper.",
      "secondary_message": "½ lb chicken breasts, boneless skinless\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 32208,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 32209,
      "primary_message": "Add the chicken to the skillet; cook until it is cooked through and golden brown; 3 to 4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 32210,
      "primary_message": "While the chicken cooks, prepare the dressing by adding almond butter, soy sauce, water, honey, and sesame oil to the bowl with the jalapeño and lime juice; whisk together until smooth. If the dressing is too thick, add more water to thin it out.",
      "secondary_message": "3 tbsp natural almond butter\n1 tbsp soy sauce\n1 tbsp hot water\n1 tsp honey\n1 tsp toasted sesame oil"
    },
    {
      "id": 32211,
      "primary_message": "Add the chicken to the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 32212,
      "primary_message": "To serve, place the salad in a bowl and drizzle with the jalapeño-almond dressing. Enjoy!",
      "secondary_message": null
    }
  ],
