  "instructions": [
    {
      "id": 39440,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 heads butter (Boston) lettuce\n2 red bell peppers\n2 mangoes\n2 jalapeño peppers\n2 limes\n1 small bunch cilantro"
    },
    {
      "id": 39441,
      "primary_message": "Trim and discard the lettuce cores; chop the lettuce into bite-sized pieces and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 39442,
      "primary_message": "Cut the bell peppers into quarters lengthwise; remove and discard the seeds and white membranes. Medium dice the peppers and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 39443,
      "primary_message": "Peel the mangoes and slice the flesh away from the pit, starting with the flat sides. Medium dice the mangoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 39444,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 39445,
      "primary_message": "Measure out and chop the cashews; add to the bowl.",
      "secondary_message": "½ cup cashews, roasted unsalted"
    },
    {
      "id": 39446,
      "primary_message": "Cut the jalapeños into quarters lengthwise; remove and discard the seeds and white membranes. Mince the peppers and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 39447,
      "primary_message": "Juice the limes and add the juice to the bowl with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 39448,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 39449,
      "primary_message": "Cut the chicken into bite-sized cubes, then season with salt and pepper.",
      "secondary_message": "0.454 kg chicken breasts, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 39450,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 39451,
      "primary_message": "Add the chicken to the skillet; cook until it is cooked through and golden brown; 3 to 4 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 39452,
      "primary_message": "While the chicken cooks, prepare the dressing by adding almond butter, soy sauce, water, honey, and sesame oil to the bowl with the jalapeño and lime juice; whisk together until smooth. If the dressing is too thick, add more water to thin it out.",
      "secondary_message": "6 tbsp natural almond butter\n2 tbsp soy sauce\n2 tbsp hot water\n2 tsp honey\n2 tsp toasted sesame oil"
    },
    {
      "id": 39453,
      "primary_message": "Add the chicken to the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 39454,
      "primary_message": "To serve, place the salad in a bowl and drizzle with the jalapeño-almond dressing. Enjoy!",
      "secondary_message": null
    }
  ],
