  "instructions": [
    {
      "id": 168173,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 168174,
      "primary_message": "While the oven heats up, pat the chicken thighs dry with paper towels and place on a large baking sheet pan; rub with oil and season with salt and pepper on both sides.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 168175,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, flipping once, until chicken is golden and cooked through, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 168176,
      "primary_message": "Meanwhile, wash, dry, and quarter the potatoes. Place in a large bowl.",
      "secondary_message": "1 lb new potatoes"
    },
    {
      "id": 168177,
      "primary_message": "Wash, dry, trim, and halve the Brussels sprouts; add to the bowl.",
      "secondary_message": "2 lb Brussels sprouts"
    },
    {
      "id": 168178,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 168179,
      "primary_message": "Add oil and spices to the bowl and toss to coat. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n½ tsp thyme\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 168180,
      "primary_message": "Place Brussels sprouts and potatoes on a second large baking sheet pan and spread out in an even layer. Place in the oven and roast, tossing occasionally, until the veggies are fork-tender, about 18 minutes.",
      "secondary_message": null
    },
    {
      "id": 168181,
      "primary_message": "Meanwhile, wash, quarter, core, and slice apples into wedges. Place in the large bowl with maple syrup and cinnamon; toss to coat.",
      "secondary_message": "2 Gala apples\n2 tbsp pure maple syrup\n½ tsp cinnamon"
    },
    {
      "id": 168182,
      "primary_message": "Add apples to the baking sheet pan with the chicken during the last 8 minutes of cooking. Continue to roast, until the apples are tender and chicken is cooked through.",
      "secondary_message": null
    },
    {
      "id": 168183,
      "primary_message": "To serve, divide chicken and veggies between plates and enjoy!",
      "secondary_message": null
    }
  ],
