  "instructions": [
    {
      "id": 168162,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 168163,
      "primary_message": "While the oven heats up, pat the chicken thighs dry with paper towels and place on a baking sheet pan; rub with oil and season with salt and pepper on both sides.",
      "secondary_message": "1 lb chicken thighs, boneless skinless\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 168164,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until chicken starts to brown, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 168165,
      "primary_message": "Meanwhile, wash, dry, and quarter the potatoes. Place in a medium bowl.",
      "secondary_message": "½ lb new potatoes"
    },
    {
      "id": 168166,
      "primary_message": "Wash, dry, trim, and halve the Brussels sprouts; add to the bowl.",
      "secondary_message": "1 lb Brussels sprouts"
    },
    {
      "id": 168167,
      "primary_message": "Peel and mince garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 168168,
      "primary_message": "Add oil and spices to the bowl and toss to coat. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp thyme\n⅛ tsp black pepper\n1 pinch crushed red pepper"
    },
    {
      "id": 168169,
      "primary_message": "Remove baking sheet pan from the oven, flip chicken, and push to one side. Add Brussels sprouts and potatoes in an even layer. Return to oven and roast until veggies start to soften, about 8 minutes.",
      "secondary_message": null
    },
    {
      "id": 168170,
      "primary_message": "Meanwhile, wash, quarter, core, and slice apple into wedges. Place in the medium bowl with maple syrup and cinnamon; toss to coat.",
      "secondary_message": "1 Gala apple\n1 tbsp pure maple syrup\n¼ tsp cinnamon"
    },
    {
      "id": 168171,
      "primary_message": "Add apples to the baking sheet pan, on top of the chicken, and cook until veggies are fork-tender and chicken is cooked through, about 8 minutes more.",
      "secondary_message": null
    },
    {
      "id": 168172,
      "primary_message": "To serve, divide chicken and veggies between plates and enjoy!",
      "secondary_message": null
    }
  ],
