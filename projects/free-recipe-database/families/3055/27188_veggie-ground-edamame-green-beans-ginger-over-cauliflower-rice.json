  "instructions": [
    {
      "id": 437898,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 437899,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 small bunch green onions (scallions)\n4 (2 ½ cm) pieces ginger root\n0.45 kg green beans"
    },
    {
      "id": 437900,
      "primary_message": "Cut cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 437901,
      "primary_message": "Trim and thinly slice green onions crosswise. Add half to the baking sheet with the cauliflower and place half in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 437902,
      "primary_message": "Peel and mince ginger. Sprinkle half over the cauliflower and add half to the bowl with the green onion.",
      "secondary_message": null
    },
    {
      "id": 437903,
      "primary_message": "Drizzle oil over the cauliflower and season with salt. Stir to combine, then spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n½ tsp salt"
    },
    {
      "id": 437904,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and golden, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 437905,
      "primary_message": "While the cauliflower is roasting, trim and halve green beans crosswise.",
      "secondary_message": null
    },
    {
      "id": 437906,
      "primary_message": "Preheat a large skillet over high heat. ",
      "secondary_message": null
    },
    {
      "id": 437907,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add green beans and cook, stirring frequently, until starting to brown and soften, 4-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 437908,
      "primary_message": "Add veggie ground to the skillet. Cook, breaking it apart with a spoon, until the veggie ground is browned and crumbly and green beans are tender, 4-5 minutes.",
      "secondary_message": "454 g veggie ground, plant based"
    },
    {
      "id": 437909,
      "primary_message": "Meanwhile, add soy sauce, chili-garlic sauce, sesame seeds, and maple syrup to the bowl with the green onion and ginger. Stir to combine the stir-fry sauce.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp chili-garlic sauce\n2 tbsp sesame seeds\n2 tsp pure maple syrup"
    },
    {
      "id": 437910,
      "primary_message": "Place edamame in the colander and rinse under hot water (from the tap) to defrost. ",
      "secondary_message": "2 cups edamame"
    },
    {
      "id": 437911,
      "primary_message": "When the green beans and veggie ground are done, reduce heat to medium. Add stir-fry sauce and edamame; cook, stirring constantly, until warmed through and fragrant, about 1 minute. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 437912,
      "primary_message": "To serve, divide cauliflower rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
