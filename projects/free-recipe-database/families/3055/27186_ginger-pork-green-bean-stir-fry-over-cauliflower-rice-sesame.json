  "instructions": [
    {
      "id": 437869,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 437870,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch green onions (scallions)\n6 (2 ½ cm) pieces ginger root\n0.68 kg green beans"
    },
    {
      "id": 437871,
      "primary_message": "Cut each cauliflower head into quarters; using a box grater, hold the stem end of the cauliflower and coarsely grate. (Alternatively, transfer cauliflower to the bowl of a food processor; pulse until rice-like in consistency.) Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 437872,
      "primary_message": "Trim and thinly slice green onions crosswise. Add half to the baking sheets with the cauliflower and place half in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 437873,
      "primary_message": "Peel and mince ginger. Sprinkle half over the cauliflower and add half to the bowl with the green onion.",
      "secondary_message": null
    },
    {
      "id": 437874,
      "primary_message": "Drizzle oil over the cauliflower and season with salt. Stir to combine, then spread out in an even layer.",
      "secondary_message": "3 tbsp toasted sesame oil\n¾ tsp salt"
    },
    {
      "id": 437875,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring cauliflower halfway through, until rice is tender and golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 437876,
      "primary_message": "While the cauliflower is roasting, trim and halve green beans crosswise.",
      "secondary_message": null
    },
    {
      "id": 437877,
      "primary_message": "Preheat a large pot over high heat. ",
      "secondary_message": null
    },
    {
      "id": 437878,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add green beans and cook, stirring frequently, until starting to brown and soften, 6-8 minutes.",
      "secondary_message": "3 tbsp toasted sesame oil"
    },
    {
      "id": 437879,
      "primary_message": "Add pork and salt to the pot. Cook, breaking the meat apart with a spoon, until the pork is browned and crumbly and green beans are tender, 5-6 minutes.",
      "secondary_message": "1.02 kg lean ground pork\n3 pinch salt"
    },
    {
      "id": 437880,
      "primary_message": "Meanwhile, add soy sauce, chili-garlic sauce, sesame seeds, and maple syrup to the bowl with the green onion and ginger. Stir to combine the stir-fry sauce.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp chili-garlic sauce\n3 tbsp sesame seeds\n1 tbsp pure maple syrup"
    },
    {
      "id": 437881,
      "primary_message": "When the green beans and pork are done, reduce heat to low. Add stir-fry sauce and cook, stirring constantly, until fragrant, 30-60 seconds. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 437882,
      "primary_message": "To serve, divide cauliflower rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
