  "instructions": [
    {
      "id": 418093,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 418094,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place on a large baking sheet pan, drizzle with oil, and season with salt and pepper. ",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 418095,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until almost cooked through, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 418096,
      "primary_message": "Meanwhile, wash and dry bell peppers; using a clean cutting board, trim, seed, and small dice. Place in a medium bowl.",
      "secondary_message": "3 green bell peppers"
    },
    {
      "id": 418097,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 418098,
      "primary_message": "While the pot heats up, wash, dry, trim, and cut green onions crosswise into thin pieces. Set aside a small handful for serving and add remaining green onions to the bowl with the bell pepper.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 418099,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, and spices; cook, stirring occasionally, until starting to soften, about 3 minutes. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp garlic powder\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 418100,
      "primary_message": "Add cauliflower and water to the pot; stir combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook, stirring occasionally, until liquid has evaporated and cauliflower is tender, 7-8 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": "3 (340 g) bags frozen, riced cauliflower\n¾ cup water"
    },
    {
      "id": 418101,
      "primary_message": "When the chicken is almost cooked through, remove from oven. Drizzle barbecue sauce over each fillet, then top with cheese. ",
      "secondary_message": "1 cup barbecue sauce\n1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 418102,
      "primary_message": "Return baking sheet to the oven and continue to bake until cheese is melted and chicken is cooked through, about 10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 418103,
      "primary_message": "To serve, divide chicken and cauliflower rice between plates. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
