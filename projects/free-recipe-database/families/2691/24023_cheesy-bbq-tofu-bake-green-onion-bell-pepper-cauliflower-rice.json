  "instructions": [
    {
      "id": 418116,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 418117,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 418118,
      "primary_message": "Wash, dry, trim, and seed bell peppers; small dice. Place in a medium bowl and set aside.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 418119,
      "primary_message": "Cut the tofu planks in half crosswise and return to the baking sheet. Drizzle with oil, then season with salt and pepper on both sides. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 418120,
      "primary_message": "Place tofu in the oven (it doesn't have to be fully heated) and bake, flipping halfway, until warmed through, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 418121,
      "primary_message": "Meanwhile, preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 418122,
      "primary_message": "While the pot heats up, wash, dry, trim, and cut green onions crosswise into thin pieces. Set aside a small handful for serving and add remaining green onions to the bowl with the bell pepper.",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 418123,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, and spices; cook, stirring occasionally, until softened, about 2 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp garlic powder\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 418124,
      "primary_message": "Add cauliflower and water to the pot; stir combine and bring to a simmer. Once simmering, reduce heat to low and cook, stirring occasionally, until liquid has evaporated and cauliflower is tender, 5-7 minutes. Remove from heat and cover to keep warm. ",
      "secondary_message": "2 (340 g) bags frozen, riced cauliflower\n½ cup water"
    },
    {
      "id": 418125,
      "primary_message": "When the tofu is warmed through, remove from oven. Drizzle barbecue sauce over each piece, then top with cheese. ",
      "secondary_message": "⅔ cup barbecue sauce\n1 ⅓ cups shredded cheese, Mexican blend"
    },
    {
      "id": 418126,
      "primary_message": "Return baking sheet to the oven and continue to bake until cheese is melted and bubbly, 7-8 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 418127,
      "primary_message": "To serve, divide tofu and cauliflower rice between plates. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
