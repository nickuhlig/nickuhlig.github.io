  "instructions": [
    {
      "id": 418071,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 418072,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place in a baking dish, drizzle with oil, and season with salt and pepper. ",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 418073,
      "primary_message": "Place chicken in the oven (it doesn't have to be fully heated) and bake until almost cooked through, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 418074,
      "primary_message": "Meanwhile, wash and dry bell pepper; using a clean cutting board, trim, seed, and small dice. Place in a small bowl.",
      "secondary_message": "1 green bell pepper"
    },
    {
      "id": 418075,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 418076,
      "primary_message": "While the pan heats up, wash, dry, trim, and cut green onions crosswise into thin pieces. Set aside a small handful for serving and add remaining green onions to the bowl with the bell pepper.",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 418077,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add bell pepper, green onion, and spices; cook, stirring occasionally, until starting to soften, about 2 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp garlic powder\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 418078,
      "primary_message": "Add cauliflower and water to the pan; stir combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook, stirring occasionally, until liquid has evaporated and cauliflower is tender, 5-7 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": "1 (340 g) bag frozen, riced cauliflower\n¼ cup water"
    },
    {
      "id": 418079,
      "primary_message": "When the chicken is almost cooked through, remove from oven. Drizzle barbecue sauce over each fillet, then top with cheese. ",
      "secondary_message": "⅓ cup barbecue sauce\n½ cup shredded cheese, Mexican blend"
    },
    {
      "id": 418080,
      "primary_message": "Return baking dish to the oven and continue to bake until cheese is melted and chicken is cooked through, 8-10 minutes more. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 418081,
      "primary_message": "To serve, divide chicken and cauliflower rice between plates. Top with reserved green onions and enjoy!",
      "secondary_message": null
    }
  ],
