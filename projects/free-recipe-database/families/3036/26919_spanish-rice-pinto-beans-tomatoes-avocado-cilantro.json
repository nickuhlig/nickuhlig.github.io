  "instructions": [
    {
      "id": 447398,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n3 avocados\n1 small bunch cilantro"
    },
    {
      "id": 447399,
      "primary_message": "Peel, trim, and small dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 447400,
      "primary_message": "Trim and small dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 447401,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 447402,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 447403,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n½ tsp black pepper\n½ tsp cayenne pepper"
    },
    {
      "id": 447404,
      "primary_message": "Meanwhile, drain and rinse beans. Place in the reserved bowl and set aside.",
      "secondary_message": "3 (398 ml) cans pinto beans"
    },
    {
      "id": 447405,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain. When the veggies are soft, add rice to the pot; cook, stirring constantly, until rice is slightly translucent, 2-3 minutes.",
      "secondary_message": "1 ½ cups basmati rice"
    },
    {
      "id": 447406,
      "primary_message": "Add beans, tomatoes, and broth to the pot. Stir to combine and bring to a boil over high heat.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n710 ml chicken or vegetable broth"
    },
    {
      "id": 447407,
      "primary_message": "Once the liquid in the pot comes to a boil, stir the mixture, cover the pot, and reduce heat to low. Simmer until rice is tender and the liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 447408,
      "primary_message": "When the rice is almost done, halve and pit avocados; using a spoon, scoop out the flesh and thinly slice. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 447409,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the rice and stir to combine (reserve the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 447410,
      "primary_message": "To serve, divide rice between plates or bowls; top with avocado and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
