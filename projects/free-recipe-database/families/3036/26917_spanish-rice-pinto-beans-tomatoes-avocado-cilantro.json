  "instructions": [
    {
      "id": 447372,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 avocado\n½ small bunch cilantro"
    },
    {
      "id": 447373,
      "primary_message": "Peel, trim, and small dice carrot. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 447374,
      "primary_message": "Trim and small dice celery. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 447375,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 447376,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 447377,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until starting to soften, 2-3 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp oregano, dried\n½ tsp salt\n⅛ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 447378,
      "primary_message": "Meanwhile, drain and rinse beans. Place in the reserved bowl and set aside.",
      "secondary_message": "1 (398 ml) can pinto beans"
    },
    {
      "id": 447379,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain. When the veggies are soft, add rice to the pan; cook, stirring constantly, until rice is slightly translucent, 1-2 minutes.",
      "secondary_message": "½ cup basmati rice"
    },
    {
      "id": 447380,
      "primary_message": "Add beans, tomatoes, and broth to the pan. Stir to combine and bring to a boil over high heat.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n237 ml chicken or vegetable broth"
    },
    {
      "id": 447381,
      "primary_message": "Once the liquid in the saucepan comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Simmer until rice is tender and the liquid is mostly absorbed, 15-18 minutes. Once done, remove from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 447382,
      "primary_message": "When the rice is almost done, halve and pit avocado; using a spoon, scoop out the flesh and thinly slice. Set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 447383,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add half of the cilantro to the rice and stir to combine (reserve the rest for serving).",
      "secondary_message": null
    },
    {
      "id": 447384,
      "primary_message": "To serve, divide rice between plates or bowls; top with avocado and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
