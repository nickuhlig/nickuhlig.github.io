  "instructions": [
    {
      "primary_message": "This recipe utilizes 2 large and 2 mini food storage containers.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, trim, and small dice celery. Place in a medium bowl.\n\n",
      "secondary_message": "1 stick celery"
    },
    {
      "primary_message": "Peel and small dice shallot. Add to the bowl with the celery.\n\n",
      "secondary_message": "½ shallot"
    },
    {
      "primary_message": "Drain and mince capers. Add to the bowl along with yogurt, mayo, and spices, then stir to combine the dressing.\n\n",
      "secondary_message": "½ tbsp capers\n⅛ cup plain Greek yogurt\n2 tbsp mayonnaise\n¼ tsp dill, dried\n⅛ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "primary_message": "Drain tuna, add to the bowl with the dressing, and flake with a fork. Stir to combine the tuna salad.\n\n",
      "secondary_message": "1 (6 oz) can chunk light tuna in water"
    },
    {
      "primary_message": "Spread a thin layer of butter on each slice of bread. Divide tuna salad between half of the slices, then close sandwiches with remaining slices of bread. Cut sandwiches in half and wrap tightly in plastic wrap. Place on one side of the large food storage containers.\n\n",
      "secondary_message": "2 tsp butter, unsalted\n4 slice whole grain bread"
    },
    {
      "primary_message": "Place dressing in the mini containers with a lid, then divide dressing and carrots between the large containers. Cover and refrigerate until ready to eat. Enjoy! \n\n",
      "secondary_message": "⅓ cup ranch dressing\n2 cups baby carrots"
    }
  ],
