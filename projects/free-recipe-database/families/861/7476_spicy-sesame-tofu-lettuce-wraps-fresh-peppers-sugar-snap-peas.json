  "instructions": [
    {
      "id": 113166,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 113167,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add both to a medium bowl.",
      "secondary_message": "6 cloves garlic\n3 (2 ½ cm) pieces ginger root"
    },
    {
      "id": 113168,
      "primary_message": "Add tahini, maple syrup, chili-garlic sauce, soy sauce, and rice vinegar to the bowl with the garlic and whisk to combine. Thin the sauce out with 1-3 tbsp of water, if needed, to reach a honey-like consistency.",
      "secondary_message": "¾ cup tahini\n¼ cup pure maple syrup\n3 tbsp chili-garlic sauce\n3 tbsp soy sauce\n2 tbsp rice vinegar"
    },
    {
      "id": 113169,
      "primary_message": "Cut the tofu planks into ½-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 113170,
      "primary_message": "Preheat a large skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "¼ cup toasted sesame oil"
    },
    {
      "id": 113171,
      "primary_message": "Add tofu to the skillet and cook, undisturbed, for 4 minutes. Once a golden brown crust forms, toss the tofu every minute for an additional 5 minutes. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 113172,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ (227 g) pkg sugar snap peas\n1 ½ small bunches green onions (scallions)\n1 ½ limes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 113173,
      "primary_message": "Once tofu is golden brown on all sides, turn heat down to low and add sauce to the skillet. Stir until tofu is well coated, then remove from heat and let sit for 5 minutes, allowing the tofu to soak up the sauce.",
      "secondary_message": null
    },
    {
      "id": 113174,
      "primary_message": "Seed the bell peppers and slice into thin strips.",
      "secondary_message": null
    },
    {
      "id": 113175,
      "primary_message": "Cut the snap peas crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 113176,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 113177,
      "primary_message": "Cut the lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 113178,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates.",
      "secondary_message": null
    },
    {
      "id": 113179,
      "primary_message": "To serve, spoon the tofu onto lettuce stacks, then top with snap peas, peppers, green onions, and sesame seeds. Garnish with lime wedges and enjoy!",
      "secondary_message": "3 tbsp sesame seeds"
    }
  ],
