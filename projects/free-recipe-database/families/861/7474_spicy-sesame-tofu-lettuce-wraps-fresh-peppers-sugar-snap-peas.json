  "instructions": [
    {
      "id": 113138,
      "primary_message": "Cut the tofu in half along the long side. Sandwich the tofu between clean towels or paper towels and place on a baking sheet. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 113139,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Add both to a medium bowl.",
      "secondary_message": "2 cloves garlic\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 113140,
      "primary_message": "Add tahini, maple syrup, chili-garlic sauce, soy sauce, and rice vinegar to the bowl with the garlic and whisk to combine. Thin the sauce out with 1-3 tsp of water, if needed, to reach a honey-like consistency.",
      "secondary_message": "¼ cup tahini\n1 ½ tbsp pure maple syrup\n1 tbsp chili-garlic sauce\n1 tbsp soy sauce\n2 tsp rice vinegar"
    },
    {
      "id": 113141,
      "primary_message": "Cut the tofu planks into ½-inch cubes.",
      "secondary_message": null
    },
    {
      "id": 113142,
      "primary_message": "Preheat a skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 ½ tbsp toasted sesame oil"
    },
    {
      "id": 113143,
      "primary_message": "Add tofu to the skillet and cook, undisturbed, for 4 minutes. Once a golden brown crust forms, toss the tofu every minute for an additional 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 113144,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n½ (227 g) pkg sugar snap peas\n½ small bunch green onions (scallions)\n½ lime\n1 head butter (Boston) lettuce"
    },
    {
      "id": 113145,
      "primary_message": "Once tofu is golden brown on all sides, turn heat down to low and add sauce to the skillet. Stir until tofu is well coated, then remove from heat and let sit for 5 minutes, allowing the tofu to soak up the sauce.",
      "secondary_message": null
    },
    {
      "id": 113146,
      "primary_message": "Seed the bell pepper and slice into thin strips.",
      "secondary_message": null
    },
    {
      "id": 113147,
      "primary_message": "Cut the snap peas crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 113148,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 113149,
      "primary_message": "Cut the lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 113150,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates.",
      "secondary_message": null
    },
    {
      "id": 113151,
      "primary_message": "To serve, spoon the tofu onto lettuce stacks, then top with snap peas, peppers, green onions, and sesame seeds. Garnish with lime wedges and enjoy!",
      "secondary_message": "1 tbsp sesame seeds"
    }
  ],
