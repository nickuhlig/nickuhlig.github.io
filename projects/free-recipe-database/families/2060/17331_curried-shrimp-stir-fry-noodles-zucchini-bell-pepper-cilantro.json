  "instructions": [
    {
      "id": 322718,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 322719,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 (2 ½ cm) pieces ginger root\n2 medium carrots\n2 red bell peppers\n2 medium zucchini squash\n1 small bunch cilantro"
    },
    {
      "id": 322720,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "283 g flat rice (pad thai) noodles"
    },
    {
      "id": 322721,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "0.68 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 322722,
      "primary_message": "Juice lime into a small bowl. Add water, soy sauce, sugar, and spices; whisk to combine the sauce and set aside.",
      "secondary_message": "½ cup water\n2 tbsp soy sauce\n2 tsp brown sugar\n2 tbsp curry powder\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 322723,
      "primary_message": "Peel and mince ginger and garlic; place in a medium bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 322724,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with ginger and garlic. ",
      "secondary_message": null
    },
    {
      "id": 322725,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 322726,
      "primary_message": "Trim and medium dice zucchini; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 322727,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 322728,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shrimp, salt, and pepper; cook until the shrimp are opaque, 1-2 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "4 tsp virgin coconut oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 322729,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom; add veggies and salt. Stir-fry until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp virgin coconut oil\n½ tsp salt"
    },
    {
      "id": 322730,
      "primary_message": "Add drained noodles and sauce to the skillet with the veggies. Continue to cook, tossing frequently, until the liquid is absorbed and noodles are warmed through, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 322731,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the skillet, along with cooked shrimp, and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 322732,
      "primary_message": "To serve, divide noodles, shrimp, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
