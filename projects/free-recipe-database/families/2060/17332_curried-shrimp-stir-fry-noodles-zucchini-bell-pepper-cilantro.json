  "instructions": [
    {
      "id": 322733,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "id": 322734,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 (2 ½ cm) pieces ginger root\n3 medium carrots\n3 red bell peppers\n3 medium zucchini squash\n1 small bunch cilantro"
    },
    {
      "id": 322735,
      "primary_message": "Once the water in the pot is boiling, remove from heat and add rice noodles. Soak for 10 minutes, or according to package directions, then drain in a colander and rinse under cold water; set aside.",
      "secondary_message": "425 g flat rice (pad thai) noodles"
    },
    {
      "id": 322736,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 322737,
      "primary_message": "Juice limes into a small bowl. Add water, soy sauce, sugar, and spices; whisk to combine the sauce and set aside.",
      "secondary_message": "¾ cup water\n3 tbsp soy sauce\n1 tbsp brown sugar\n3 tbsp curry powder\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 322738,
      "primary_message": "Peel and mince ginger and garlic; place in a large bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 322739,
      "primary_message": "Peel, trim, and slice carrots crosswise into thin rounds; add to the bowl with ginger and garlic. ",
      "secondary_message": null
    },
    {
      "id": 322740,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 322741,
      "primary_message": "Trim and medium dice zucchini; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 322742,
      "primary_message": "Preheat another large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 322743,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Cooking in batches if necessary, add shrimp, salt, and pepper; cook until the shrimp are opaque, 1-2 minutes per side. Remove to a plate and loosely cover with aluminum foil.",
      "secondary_message": "2 tbsp virgin coconut oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 322744,
      "primary_message": "Return pot to medium-high heat, add more oil, and swirl to coat the bottom; add veggies and salt. Stir-fry until starting to soften, 4-5 minutes.",
      "secondary_message": "¼ cup virgin coconut oil\n¾ tsp salt"
    },
    {
      "id": 322745,
      "primary_message": "Add drained noodles and sauce to the pot with the veggies. Continue to cook, tossing frequently, until the liquid is absorbed and noodles are warmed through, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 322746,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add cilantro to the pot, along with cooked shrimp, and toss to combine; remove from heat.",
      "secondary_message": null
    },
    {
      "id": 322747,
      "primary_message": "To serve, divide noodles, shrimp, and veggies between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
