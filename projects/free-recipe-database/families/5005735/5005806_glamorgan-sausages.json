  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely chop the leek. Remove the leaves from the thyme.",
      "secondary_message": "1 leek\n2 sprigs thyme"
    },
    {
      "id": 1,
      "primary_message": "Melt butter in a large skillet over medium high heat. Add leek and thyme leaves and cook, stirring, until onions are soft and just beginning to brown, about 5 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl combine cheese, 1 cup breadcrumbs, 1 egg, milk, mustard, and reserved leek mixture. Season with salt and pepper. Mix with hands until all the ingredients are moist and you can easily form a sausage shape with the mixture. Divide mixture into 8 pieces and form each piece into the shape of a sausage.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place remaining breadcrumbs, flour, and remaining beaten egg in separate plates. Bread each sausage by coating it in flour, then egg, then breadcrumbs.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a high sided skillet or saucepan, heat 2.5-cm of oil over medium-high heat until shimmering. Cook sausages until browned on all sides, about 3 minutes total. Transfer to a paper towel-lined place and season with salt. Serve immediately.",
      "secondary_message": null
    }
  ],
