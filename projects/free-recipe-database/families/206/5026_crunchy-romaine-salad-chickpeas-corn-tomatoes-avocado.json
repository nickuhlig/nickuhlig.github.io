  "instructions": [
    {
      "id": 60963,
      "primary_message": "Remove husks and silks from corn. Hold vertically in the middle of a large bowl and slice kernels off the cobs. Wash, halve, and add tomatoes to bowl. Halve and pit avocados; scoop out and medium dice. Add ½ to the bowl with the other ingredients and the other ½ to a small bowl (for the dressing).",
      "secondary_message": "3 ears corn\n1 ½ small pkg grape tomatoes\n3 avocados"
    },
    {
      "id": 60962,
      "primary_message": "Wash lettuce, halve lengthwise, then chop into 2 ½ cm strips. Add to bowl.",
      "secondary_message": "1 ½ head romaine lettuce"
    },
    {
      "id": 60961,
      "primary_message": "Drain and rinse chickpeas; place on paper towels and pat dry. Add to bowl and toss salad.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 60960,
      "primary_message": "Peel and mince garlic. Add garlic, lemon juice, oil, cumin, chili powder, salt, and pepper to bowl with avocado. Mash with a fork until smooth.",
      "secondary_message": "3 cloves garlic\n1 ½ lemon\n6 tbsp extra virgin olive oil\n¾ tsp cumin\n¾ tsp chili powder\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60959,
      "primary_message": "To serve, place salad on a plate, drizzle with dressing, and season with salt and pepper to taste. Enjoy!",
      "secondary_message": ""
    }
  ],
