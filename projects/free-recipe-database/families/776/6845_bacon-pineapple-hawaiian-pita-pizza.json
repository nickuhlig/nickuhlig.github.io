  "instructions": [
    {
      "id": 92088,
      "primary_message": "Peel and slice the onions into thin half rings.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 92089,
      "primary_message": "Wash and dry the pineapples. Cut skin off pineapples, core, and cut into bite-sized pieces.",
      "secondary_message": "1 ½ small pineapples"
    },
    {
      "id": 92090,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 92091,
      "primary_message": "Chop the bacon into small pieces. Add to the skillet and cook until crispy, 3-4 minutes. Remove with a slotted spoon and transfer to a paper towel lined plate.",
      "secondary_message": "6 slices bacon"
    },
    {
      "id": 92092,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 92093,
      "primary_message": "In a medium bowl, combine garlic, tomato sauce, and spices. Stir to combine and set aside.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n½ tsp crushed red pepper\n½ tsp paprika\n½ tsp onion powder\n½ tsp black pepper"
    },
    {
      "id": 92094,
      "primary_message": "Preheat your oven to broil.",
      "secondary_message": null
    },
    {
      "id": 92095,
      "primary_message": "Grate the mozzarella.",
      "secondary_message": "1 ½ (8 oz) blocks mozzarella cheese"
    },
    {
      "id": 92096,
      "primary_message": "To assemble, top the pitas with a thin layer of tomato sauce, cheese, red onion, and pineapple. Place on a baking sheet and cook in the oven for 2-3 minutes, until the cheese melts. Cook in batches if necessary.",
      "secondary_message": "12 whole grain pitas"
    },
    {
      "id": 92097,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems.",
      "secondary_message": "1 ½ small bunches cilantro"
    },
    {
      "id": 92098,
      "primary_message": "Remove from oven and top with bacon and cilantro leaves. Enjoy!",
      "secondary_message": null
    }
  ],
