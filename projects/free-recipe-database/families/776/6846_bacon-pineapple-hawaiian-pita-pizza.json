  "instructions": [
    {
      "id": 92099,
      "primary_message": "Peel and slice the onion into thin half rings.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 92100,
      "primary_message": "Wash and dry the pineapple. Cut skin off pineapple, core, and cut into bite-sized pieces.",
      "secondary_message": "½ small pineapple"
    },
    {
      "id": 92101,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 92102,
      "primary_message": "Chop the bacon into small pieces. Add to the skillet and cook until crispy, 3-4 minutes. Remove with a slotted spoon and transfer to a paper towel lined plate.",
      "secondary_message": "2 slices bacon"
    },
    {
      "id": 92103,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 92104,
      "primary_message": "In a medium bowl, combine garlic, tomato sauce, and spices. Stir to combine and set aside.",
      "secondary_message": "1 (213 ml) can tomato sauce\n⅛ tsp crushed red pepper\n⅛ tsp paprika\n⅛ tsp onion powder\n⅛ tsp black pepper"
    },
    {
      "id": 92105,
      "primary_message": "Preheat your oven to broil.",
      "secondary_message": null
    },
    {
      "id": 92106,
      "primary_message": "Grate the mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 92107,
      "primary_message": "To assemble, top the pitas with a thin layer of tomato sauce, cheese, red onion, and pineapple. Place on a baking sheet and cook in the oven for 2-3 minutes, until the cheese melts.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 92108,
      "primary_message": "Wash and dry cilantro. Shave leaves off the stems; discard the stems.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 92109,
      "primary_message": "Remove from oven and top with bacon and cilantro leaves. Enjoy!",
      "secondary_message": null
    }
  ],
