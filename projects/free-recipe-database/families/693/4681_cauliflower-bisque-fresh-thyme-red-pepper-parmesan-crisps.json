  "instructions": [
    {
      "id": 111644,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 111645,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium head cauliflower\n1 lemon\n½ small pkg fresh thyme\n1 red bell pepper"
    },
    {
      "id": 111646,
      "primary_message": "Cut off the cauliflower leaves. Roughly cut into florets and cut the thick stems into smaller pieces.",
      "secondary_message": null
    },
    {
      "id": 111647,
      "primary_message": "Peel and mince or press the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 111648,
      "primary_message": "Holding the thyme at one end, slide leaves off the stems; discard the stems.",
      "secondary_message": null
    },
    {
      "id": 111649,
      "primary_message": "Heat a large pot over medium heat. Add butter and warm until butter foams, about 1 minute.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 111650,
      "primary_message": "Add garlic, salt, pepper, and half of the thyme. Cook, stirring often, until the garlic begins to brown, 4-5 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 111651,
      "primary_message": "Add the cauliflower and the broth to the pot and cover with a lid. Cook until cauliflower is fork tender, 14-18 minutes.",
      "secondary_message": "946 ml chicken or vegetable broth"
    },
    {
      "id": 111652,
      "primary_message": "Grate Parmesan cheese. Line a baking sheet with parchment paper. Measure out 1 tbsp of the grated Parmesan and place in a pile on the sheet. Repeat with remaining cheese, keeping the piles a few inches apart.",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 111653,
      "primary_message": "Place in the oven and bake until lightly browned, 5-7 minutes. Watch carefully because they can burn quickly. Once done, remove from the oven and let them sit for a couple of minutes.",
      "secondary_message": null
    },
    {
      "id": 111654,
      "primary_message": "Cut the bell pepper into quarters lengthwise; remove and discard the seeds and white membrane. Finely dice the pepper and set aside.",
      "secondary_message": null
    },
    {
      "id": 111655,
      "primary_message": "Juice the lemon and add to the pot.",
      "secondary_message": null
    },
    {
      "id": 111656,
      "primary_message": "Purée soup until smooth using a hand or regular blender.",
      "secondary_message": null
    },
    {
      "id": 111657,
      "primary_message": "Turn the heat down to low and stir in 1 cup of cream.",
      "secondary_message": "237 ml heavy cream"
    },
    {
      "id": 111658,
      "primary_message": "To serve, spoon the soup into bowls and garnish with olive oil, red bell pepper and thyme; arrange Parmesan medallions on the side. Enjoy!",
      "secondary_message": "4 tsp extra virgin olive oil"
    }
  ],
