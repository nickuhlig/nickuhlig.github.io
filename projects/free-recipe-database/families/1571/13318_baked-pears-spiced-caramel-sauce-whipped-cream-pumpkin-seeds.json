  "instructions": [
    {
      "id": 222656,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 222657,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 222658,
      "primary_message": "Wash, dry, quarter, and core pears; medium dice and transfer to a small baking dish.",
      "secondary_message": "2 pears"
    },
    {
      "id": 222659,
      "primary_message": "Dot pears with small pieces of butter and place in the oven (it doesn't have to be fully heated). Bake until pears are fork-tender, about 20 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 222660,
      "primary_message": "Meanwhile, melt additional butter in a small saucepan over low heat.",
      "secondary_message": "1 ½ tbsp butter, unsalted"
    },
    {
      "id": 222661,
      "primary_message": "Once butter is melted, whisk in cream, sugar, honey, and spices. Increase heat to medium and simmer, whisking frequently, until sauce is slightly thickened and glossy, about 2 minutes. Remove from heat and let cool slightly to further thicken the sauce.",
      "secondary_message": "1 fl oz (⅛ cup) heavy cream\n2 tbsp brown sugar\n1 tbsp honey\n1 pinch cinnamon\n1 pinch nutmeg, ground\n1 pinch salt"
    },
    {
      "id": 222662,
      "primary_message": "Meanwhile, remove bowl from the freezer. Pour cold cream into the bowl; use a whisk to beat the cream vigorously, until medium-soft peaks form, about 2 minutes. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": "3 fl oz (⅜ cup) heavy cream\n½ tsp granulated sugar"
    },
    {
      "id": 222663,
      "primary_message": "To serve, divide baked pears between bowls; top with caramel sauce, whip cream, and pumpkin seeds. Enjoy!",
      "secondary_message": "⅛ cup pumpkin seeds"
    }
  ],
