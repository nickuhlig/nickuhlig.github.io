  "instructions": [
    {
      "id": 222673,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 222674,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 222675,
      "primary_message": "Wash, dry, quarter, and core pears; medium dice and transfer to a large baking dish.",
      "secondary_message": "6 pears"
    },
    {
      "id": 222676,
      "primary_message": "Dot pears with small pieces of butter and place in the oven (it doesn't have to be fully heated). Bake until pears are fork-tender, about 25 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 222677,
      "primary_message": "Meanwhile, melt additional butter in a medium saucepan over low heat.",
      "secondary_message": "¼ cup butter, unsalted"
    },
    {
      "id": 222678,
      "primary_message": "Once butter is melted, whisk in cream, sugar, honey, and spices. Increase heat to medium and simmer, whisking frequently, until sauce is slightly thickened and glossy, about 3 minutes. Remove from heat and let cool slightly to further thicken the sauce.",
      "secondary_message": "4 fl oz (½ cup) heavy cream\n⅓ cup brown sugar\n3 tbsp honey\n3 pinch cinnamon\n3 pinch nutmeg, ground\n3 pinch salt"
    },
    {
      "id": 222679,
      "primary_message": "Meanwhile, remove bowl from the freezer. Pour cold cream and sugar into the bowl.",
      "secondary_message": "8 fl oz (1 cup) heavy cream\n1 ½ tsp granulated sugar"
    },
    {
      "id": 222680,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 4 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 222681,
      "primary_message": "To serve, divide baked pears between bowls; top with caramel sauce, whip cream, and pumpkin seeds. Enjoy!",
      "secondary_message": "⅓ cup pumpkin seeds"
    }
  ],
