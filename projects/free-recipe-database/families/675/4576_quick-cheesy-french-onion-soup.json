  "instructions": [
    {
      "id": 187720,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 187721,
      "primary_message": "Peel and very thinly slice onions, using a mandoline slicer if desired.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 187722,
      "primary_message": "When the pot is warm, melt butter until foamy. Add onions to the pot and season with salt to help them release their moisture. Cook until tender, stirring occasionally, 4-5 minutes.",
      "secondary_message": "¼ cup butter, unsalted\n1 pinch salt"
    },
    {
      "id": 187723,
      "primary_message": "Add broth, water, soy sauce, Worcestershire, pepper, and thyme; bring to a boil. Reduce heat to low, cover and simmer, 10-15 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n½ cup water\n1 tbsp soy sauce\n2 tsp Worcestershire sauce\n¼ tsp black pepper\n⅛ tsp thyme"
    },
    {
      "id": 187724,
      "primary_message": "While soup is simmering, slice bread (if required) and grate cheese; set aside.",
      "secondary_message": "4 slices whole grain bread\n½ (8 oz) block mozzarella cheese\n1 oz Parmesan cheese"
    },
    {
      "id": 187725,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 187726,
      "primary_message": "Divide soup into oven-safe bowls or ramekins, place bowls on a baking sheet pan. Top with bread slices and cheese. ",
      "secondary_message": null
    },
    {
      "id": 187727,
      "primary_message": "Place under broiler until cheese is golden brown, about 1 minute. Watch it carefully as it can burn easily.",
      "secondary_message": null
    },
    {
      "id": 187728,
      "primary_message": "When the soup is brown and bubbly, carefully remove from oven using oven mitts and place bowls on a plate. Enjoy!",
      "secondary_message": null
    }
  ],
