  "instructions": [
    {
      "id": 617121,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n1 leek\n½ bunch kale"
    },
    {
      "id": 617122,
      "primary_message": "Peel, trim, and medium dice carrots. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 617123,
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise, then add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 617124,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 617125,
      "primary_message": "While the pan heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 617126,
      "primary_message": "Once the pan is hot, add butter and swirl to coat the bottom. Add veggies, sausage, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "1 tbsp butter, unsalted\n0.23 kg ground pork sausage\n½ tsp salt\n¼ tsp black pepper\n¼ tsp sage, dried\n¼ tsp nutmeg, ground\n¼ tsp crushed red pepper"
    },
    {
      "id": 617127,
      "primary_message": "Add broth, milk, and pumpkin to the pan; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until the veggies are tender and soup is slightly thickened, 8-10 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n237 ml whole milk\n½ (398 ml) can pure pumpkin purée"
    },
    {
      "id": 617128,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 617129,
      "primary_message": "When the soup has thickened, add kale to the pan in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until kale is tender, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 617130,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
