  "instructions": [
    {
      "id": 617141,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 leeks\n1 ½ bunches kale"
    },
    {
      "id": 617142,
      "primary_message": "Peel, trim, and medium dice carrots. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 617143,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Thinly slice crosswise, then add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 617144,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 617145,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 617146,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggies, sausage, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "3 tbsp butter, unsalted\n0.68 kg ground pork sausage\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp sage, dried\n¾ tsp nutmeg, ground\n¾ tsp crushed red pepper"
    },
    {
      "id": 617147,
      "primary_message": "Add broth, milk, and pumpkin to the pot; stir to combine the soup and bring to a boil over high heat. Once boiling, reduce to a simmer and cook, stirring occasionally, until the veggies are tender and soup is slightly thickened, 10-12 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n710 ml whole milk\n1 ½ (398 ml) cans pure pumpkin purée"
    },
    {
      "id": 617148,
      "primary_message": "Meanwhile, fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 617149,
      "primary_message": "When the soup has thickened, add kale to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Continue to cook, stirring occasionally, until kale is tender, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 617150,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
