  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 leek\n2 medium carrots\n2 sticks celery"
    },
    {
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "primary_message": "Trim off root end and dark green top of the leek, leaving only the white and pale green parts. Cut leek in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and place in a medium bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the leek. ",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and thinly slice celery crosswise. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat an ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, peel and mince garlic. Add to the bowl with the veggies. ",
      "secondary_message": "1 clove garlic"
    },
    {
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, garlic, and spices; cook, stirring occasionally, until softened, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp paprika\n½ tsp salt\n¼ tsp black pepper\n¼ tsp thyme, dried"
    },
    {
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Coarsely grate cheese. Place in the reserved bowl and set aside. ",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "primary_message": "When the veggies are softened, add beans, tomato sauce, water, and soy sauce to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to low and continue to cook, stirring occasionally, until sauce is slightly thickened, 3-4 minutes more. ",
      "secondary_message": "1 (8 oz) can tomato sauce\n1 tsp soy sauce"
    },
    {
      "primary_message": "When the sauce is slightly thickened, top skillet with cheese. Place in the oven and broil until cheese is melted and golden, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "When the skillet is done, arrange bread on a baking sheet pan. Place in the oven and broil, flipping halfway through, until lightly toasted, 1-2 minutes. Remove from oven and cut in half. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "primary_message": "To serve, divide cheesy bean skillet and toast between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
