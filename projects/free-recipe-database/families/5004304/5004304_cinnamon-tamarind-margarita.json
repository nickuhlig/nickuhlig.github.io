  "instructions": [
    {
      "id": 1,
      "primary_message": "Mix sugar, salt, cayenne, and cinnamon in a small bowl, then pour onto a saucer. Pour 2 tablespoons lime juice onto a second saucer. Turn serving glass (martini glass or old fashioned) in lime juice to coat the outer rim. Then spin glass in cayenne mixture, rotating slowly to coat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add tamarind concentrate, tequila, lime juice, simple syrup, lemon juice, and Cointreau to mixing glass. Fill with ice and shake well, about 30 seconds. Strain into serving glass. Garnish with cinnamon stick if desired.",
      "secondary_message": null
    }
  ],
