  "instructions": [
    {
      "id": 338268,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ½-cup cooking water before draining and set aside.)",
      "secondary_message": "1 tsp salt\n283 g spaghetti pasta"
    },
    {
      "id": 338269,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "4 peaches\n1 small pkg grape tomatoes\n1 small pkg fresh basil\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 338270,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice, place in a medium bowl, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 338271,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 338272,
      "primary_message": "While the skillet heats up, peel, halve, and small dice onion; peel and mince garlic.",
      "secondary_message": "1 medium red onion\n2 cloves garlic"
    },
    {
      "id": 338273,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring frequently, until starting to soften, 2-3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 338274,
      "primary_message": "Add peaches, tomatoes, vinegar, and spices to the skillet; continue to cook, stirring occasionally, until peaches soften and tomatoes start to burst, 3-4 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tbsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 338275,
      "primary_message": "Meanwhile, roughly chop olives and place in the reserved bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 338276,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl with the olives. (Set remaining basil aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 338277,
      "primary_message": "Add pasta, reserved pasta water, olives, basil, and almonds to the skillet; continue to cook, stirring occasionally, until sauce has thickened slightly, 1-2 minutes more.",
      "secondary_message": "⅔ cup almonds, sliced"
    },
    {
      "id": 338278,
      "primary_message": "Add arugula to the skillet in handfuls, waiting for the arugula to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 338279,
      "primary_message": "To serve, divide pasta between plates or bowls and crumble goat cheese over top. Garnish with reserved basil and enjoy!",
      "secondary_message": "1 (113 g) log goat cheese"
    }
  ],
