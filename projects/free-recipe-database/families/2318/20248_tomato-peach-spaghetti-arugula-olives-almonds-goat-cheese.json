  "instructions": [
    {
      "id": 338208,
      "primary_message": "Fill a large pot halfway with hot water (from the tap); cover and bring to a boil over high heat. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve ¾-cup cooking water before draining and set aside.)",
      "secondary_message": "1 ½ tsp salt\n15 oz spaghetti pasta"
    },
    {
      "id": 338209,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 peaches\n1 ½ pints grape tomatoes\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 338210,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice, place in a medium bowl, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 338211,
      "primary_message": "Peel, halve, and small dice onions; peel and mince garlic.",
      "secondary_message": "1 ½ medium red onions\n3 cloves garlic"
    },
    {
      "id": 338212,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 338213,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add onion and garlic. Cook, stirring frequently, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 338214,
      "primary_message": "Add peaches, tomatoes, vinegar, and spices to the pot; continue to cook, stirring occasionally, until peaches soften and tomatoes start to burst, 4-5 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "3 tbsp balsamic vinegar\n¾ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 338215,
      "primary_message": "Meanwhile, roughly chop olives and place in the reserved bowl.",
      "secondary_message": "¾ cup Kalamata olives, pitted"
    },
    {
      "id": 338216,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add half to the bowl with the olives. (Set remaining basil aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 338217,
      "primary_message": "Add pasta, reserved pasta water, olives, basil, and almonds to the pot; continue to cook, stirring occasionally, until sauce has thickened slightly, 2-3 minutes more.",
      "secondary_message": "1 cup almonds, sliced"
    },
    {
      "id": 338218,
      "primary_message": "Add arugula to the pot in handfuls, waiting for the arugula to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 338219,
      "primary_message": "To serve, divide pasta between plates or bowls and crumble goat cheese over top. Garnish with reserved basil and enjoy!",
      "secondary_message": "1 ½ (4 oz) logs goat cheese"
    }
  ],
