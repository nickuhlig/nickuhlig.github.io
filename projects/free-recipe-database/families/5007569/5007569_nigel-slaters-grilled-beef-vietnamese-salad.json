  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Stem, seed, and mince the fresh red Thai chiles. Remove the tough stems from the watercress. Cut the cucumber into matchsticks. Cut the carrots into matchsticks. Seed and cut the tomatoes into thin wedges.",
      "secondary_message": "2 fresh red Thai chiles\n2 bunches watercress\n1 (4 inch) piece cucumber\n2 medium carrots\n2 large tomatoes"
    },
    {
      "id": 1,
      "primary_message": "Preheat a grill or broiler for the steaks.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While the grill or broiler heats up, combine the lime juice, fish sauce, chile sauce, and sugar in a small bowl. Stir well to dissolve the sugar, then add the minced red chile. Taste and adjust the levels of each ingredient as desired. It should be tart, sweet, and funky.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Season the steak generously with salt and pepper and rub with the oil. Grill, turning once, until well-charred but still rosy pink within, 5 to 8 minutes depending on the thickness. Allow them to rest at least 5 minutes after cooking, then slice against the grain into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While the steaks are grilling, combine the watercress, cilantro, mint leaves, cucumber, cucumber, carrot, and tomatoes.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "When the steaks are done and sliced, add them to the salad and toss everything together with the dressing. Serve immediately while the steak is still hot.",
      "secondary_message": null
    }
  ],
