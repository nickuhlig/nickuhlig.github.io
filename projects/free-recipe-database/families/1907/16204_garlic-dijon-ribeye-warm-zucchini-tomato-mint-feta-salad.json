  "instructions": [
    {
      "id": 265549,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 265550,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n1 ½ lemons\n3 tomatoes\n1 small pkg fresh mint"
    },
    {
      "id": 265551,
      "primary_message": "Trim zucchini, quarter lengthwise, then slice crosswise into 2-inch long pieces; divide between two baking sheet pans. Drizzle with oil, season with salt and pepper, and toss to coat; spread out in an even layer.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 265552,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until zucchini is fork-tender, 25-30 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 265553,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with oil, vinegar, Dijon, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n1 tbsp balsamic vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 265554,
      "primary_message": "Cut steak into portions, place on a large plate, and drizzle with marinade on both sides; turn to coat and set aside.",
      "secondary_message": "2 ¼ lb ribeye steak"
    },
    {
      "id": 265555,
      "primary_message": "While the steaks are marinating, zest and juice lemons into a large bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 265556,
      "primary_message": "Using a clean cutting board, peel and mince additional garlic; peel and mince shallots. Add both to the bowl with the dressing.",
      "secondary_message": "3 cloves garlic\n2 shallots"
    },
    {
      "id": 265557,
      "primary_message": "Slice tomatoes lengthwise into wedges; add to the bowl, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 265558,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 265559,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, add steaks and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 265560,
      "primary_message": "While the steaks are cooking, pick mint leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 265561,
      "primary_message": "When the zucchini is done, add to the bowl with the dressing and tomatoes. Add mint and toss to combine the warm salad.",
      "secondary_message": null
    },
    {
      "id": 265562,
      "primary_message": "To serve, divide steak and salad between plates; sprinkle feta over salad and enjoy!",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese"
    }
  ],
