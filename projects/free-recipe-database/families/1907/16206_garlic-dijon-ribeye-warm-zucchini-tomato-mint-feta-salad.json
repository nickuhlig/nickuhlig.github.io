  "instructions": [
    {
      "id": 265577,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 265578,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium zucchini squash\n1 lemon\n2 tomatoes\n1 small pkg fresh mint"
    },
    {
      "id": 265579,
      "primary_message": "Trim zucchini, quarter lengthwise, then slice crosswise into 2-inch long pieces; transfer to a large baking sheet pan. Drizzle with oil, season with salt and pepper, and toss to coat; spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 265580,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until zucchini is fork-tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 265581,
      "primary_message": "Meanwhile, peel and mince garlic; place in a small bowl along with oil, vinegar, Dijon, salt, and pepper. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n4 tsp extra virgin olive oil\n2 tsp balsamic vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 265582,
      "primary_message": "Cut steak into portions, place on a plate, and drizzle with marinade on both sides; turn to coat and set aside.",
      "secondary_message": "0.68 kg ribeye steak"
    },
    {
      "id": 265583,
      "primary_message": "While the steaks are marinating, zest and juice lemon into a medium bowl. Add oil, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 265584,
      "primary_message": "Using a clean cutting board, peel and mince additional garlic; peel and mince shallot. Add both to the bowl with the dressing.",
      "secondary_message": "2 cloves garlic\n1 shallot"
    },
    {
      "id": 265585,
      "primary_message": "Slice tomatoes lengthwise into wedges; add to the bowl, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 265586,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 265587,
      "primary_message": "Once the grill pan is hot, add steaks and cook until desired doneness, 2-5 minutes per side. Remove to a clean plate.",
      "secondary_message": null
    },
    {
      "id": 265588,
      "primary_message": "While the steaks are cooking, pick mint leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 265589,
      "primary_message": "When the zucchini is done, add to the bowl with the dressing and tomatoes. Add mint and toss to combine the warm salad.",
      "secondary_message": null
    },
    {
      "id": 265590,
      "primary_message": "To serve, divide steak and salad between plates; sprinkle feta over salad and enjoy!",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
