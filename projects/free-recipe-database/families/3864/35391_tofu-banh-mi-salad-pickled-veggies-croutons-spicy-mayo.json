  "instructions": [
    {
      "id": 557397,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 557398,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 557399,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch cilantro\n1 ½ English cucumbers\n1 ½ bunches radish\n3 medium carrots\n1 ½ limes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 557400,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with vinegar, sugar, and salt, then whisk to combine the pickling liquid. ",
      "secondary_message": "¾ cup rice vinegar\n1 tbsp brown sugar\n¾ tsp salt"
    },
    {
      "id": 557401,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the pickling liquid. ",
      "secondary_message": null
    },
    {
      "id": 557402,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 557403,
      "primary_message": "Peel, trim, and coarsely grate carrots. Add to the bowl, stir combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 557404,
      "primary_message": "Medium dice tofu; place in a large bowl. Sprinkle with cornstarch, salt, and pepper, then gently stir to coat. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet and spread out in an even layer. Drizzle with oil. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp cornstarch\n¾ tsp salt\n¾ tsp black pepper\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 557405,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until tofu is golden, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 557406,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 557407,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes.",
      "secondary_message": "6 slices sourdough bread"
    },
    {
      "id": 557408,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 4-5 minutes. Remove from heat. ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 557409,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and water in a small bowl. Stir to combine the spicy mayo and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp chili-garlic sauce\n1 tbsp water"
    },
    {
      "id": 557410,
      "primary_message": "Juice limes into the reserved bowl. Add additional mayo, sugar, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n1 ½ tsp brown sugar\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 557411,
      "primary_message": "Just before serving, chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 557412,
      "primary_message": "To serve, divide dressed lettuce between plates or bowls. Top with pickled veggies, tofu, and croutons, then drizzle with spicy mayo. Enjoy!",
      "secondary_message": null
    }
  ],
