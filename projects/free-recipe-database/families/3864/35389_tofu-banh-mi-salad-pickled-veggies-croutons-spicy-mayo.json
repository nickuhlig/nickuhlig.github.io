  "instructions": [
    {
      "id": 557365,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 557366,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 557367,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n½ English cucumber\n½ bunch radish\n1 medium carrot\n½ lime\n1 head butter (Boston) lettuce"
    },
    {
      "id": 557368,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl along with vinegar, sugar, and salt, then whisk to combine the pickling liquid. ",
      "secondary_message": "¼ cup rice vinegar\n1 tsp brown sugar\n¼ tsp salt"
    },
    {
      "id": 557369,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the pickling liquid. ",
      "secondary_message": null
    },
    {
      "id": 557370,
      "primary_message": "Trim and halve radishes, then slice crosswise into thin half-moons. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 557371,
      "primary_message": "Peel, trim, and coarsely grate carrot. Add to the bowl, stir combine, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 557372,
      "primary_message": "Medium dice tofu; place in another medium bowl. Sprinkle with cornstarch, salt, and pepper, then gently stir to coat. Wipe baking sheet dry with paper towels, then return tofu to the baking sheet and spread out in an even layer. Drizzle with oil. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp cornstarch\n¼ tsp salt\n¼ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 557373,
      "primary_message": "Place baking sheet in the oven and roast, stirring halfway through, until tofu is golden, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 557374,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 557375,
      "primary_message": "While the skillet heats up, cut bread into 1-inch cubes.",
      "secondary_message": "2 slices sourdough bread"
    },
    {
      "id": 557376,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread cubes and cook, stirring occasionally, until croutons are golden and toasted, 3-4 minutes. Remove from heat. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 557377,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and water in a small bowl. Stir to combine the spicy mayo and set aside.",
      "secondary_message": "2 tbsp mayonnaise\n2 tsp chili-garlic sauce\n1 tsp water"
    },
    {
      "id": 557378,
      "primary_message": "Juice lime into the reserved bowl. Add additional mayo, sugar, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp mayonnaise\n½ tsp brown sugar\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 557379,
      "primary_message": "Just before serving, chop (or tear) lettuce into bite-sized pieces. Add to the bowl with the dressing and toss to coat. ",
      "secondary_message": null
    },
    {
      "id": 557380,
      "primary_message": "To serve, divide dressed lettuce between plates or bowls. Top with pickled veggies, tofu, and croutons, then drizzle with spicy mayo. Enjoy!",
      "secondary_message": null
    }
  ],
