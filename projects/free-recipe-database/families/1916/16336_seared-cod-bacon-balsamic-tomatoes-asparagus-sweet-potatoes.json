  "instructions": [
    {
      "id": 267291,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 267292,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches asparagus\n1 ½ lb sweet potatoes\n1 ½ lemons\n3 pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 267293,
      "primary_message": "Medium dice bacon. ",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 267294,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267295,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate, leaving the drippings in the skillet. (Set skillet aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 267296,
      "primary_message": "Meanwhile, using a clean cutting board, snap or cut off woody ends of the asparagus; peel and small dice sweet potatoes. Divide both between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 267297,
      "primary_message": "Peel and mince garlic; sprinkle over the veggies. Squeeze lemons over top, drizzle with oil, then season with salt and pepper; toss to combine and spread out in an even layer.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 267298,
      "primary_message": "Place veggies in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until crisp-tender, 15-18 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 267299,
      "primary_message": "While the veggies are cooking, pat fish dry with paper towels and place on a large plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb cod fillet\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 267300,
      "primary_message": "Return skillet (with bacon drippings) to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267301,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add fish and pan-fry until golden brown and cooked through, about 5 minutes per side. Remove to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 267302,
      "primary_message": "When the fish is done, remove all but 3 tablespoons of drippings from the skillet. Return to medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 267303,
      "primary_message": "Once the skillet is hot, add tomatoes and cook, stirring occasionally, until they start to burst, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 267304,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 267305,
      "primary_message": "Add vinegar and half of the parsley (reserving the rest for garnish) to the skillet; continue to cook, crushing tomatoes with the back of a spoon to release their juices, until sauce is thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": "⅓ cup balsamic vinegar"
    },
    {
      "id": 267306,
      "primary_message": "To serve, divide fish, sauce, and roasted veggies between plates. Top fish with bacon and sprinkle with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
