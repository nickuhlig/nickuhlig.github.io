  "instructions": [
    {
      "id": 329435,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 329436,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potato\n2 green bell peppers\n1 red chili pepper\n½ small bunch cilantro"
    },
    {
      "id": 329437,
      "primary_message": "Peel and medium dice sweet potato; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 329438,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheet with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 329439,
      "primary_message": "Halve chili pepper lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons and add to the baking sheet. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 329440,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the baking sheet with the other veggies, drizzle with oil, and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "½ medium red onion\n2 tbsp extra virgin olive oil\n1 tsp paprika\n1 tsp cumin, ground\n½ tsp coriander, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 329441,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and fork-tender, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 329442,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl along with mayo, vinegar, soy sauce, and spices; stir to combine the aioli and set aside. ",
      "secondary_message": "1 clove garlic\n2 tbsp mayonnaise\n2 tsp apple cider vinegar\n½ tsp soy sauce\n½ tsp paprika\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 329443,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329444,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper. ",
      "secondary_message": "2 tsp extra virgin olive oil\n4 eggs\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 329445,
      "primary_message": "While the eggs are cooking, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329446,
      "primary_message": "When the veggies are done, remove from the oven, sprinkle with half of the cilantro, and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 329447,
      "primary_message": "To serve, divide veggies and eggs between plates or bowls; top with aioli, remaining cilantro, and feta. Enjoy!",
      "secondary_message": "½ (4 oz) pkg crumbled feta cheese"
    }
  ],
