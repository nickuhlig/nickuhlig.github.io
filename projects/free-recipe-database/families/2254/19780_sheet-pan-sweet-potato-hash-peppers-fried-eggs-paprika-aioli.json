  "instructions": [
    {
      "id": 329581,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 329582,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n6 green bell peppers\n3 red chili peppers\n1 small bunch cilantro"
    },
    {
      "id": 329583,
      "primary_message": "Peel and medium dice sweet potatoes; divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 329584,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 329585,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons and add to the baking sheets. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 329586,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the baking sheets with the other veggies, drizzle with oil, and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "1 ½ medium red onions\n⅓ cup extra virgin olive oil\n1 tbsp paprika\n1 tbsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 329587,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 329588,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl along with mayo, vinegar, soy sauce, and spices; stir to combine the aioli and set aside. ",
      "secondary_message": "3 cloves garlic\n⅓ cup mayonnaise\n2 tbsp apple cider vinegar\n1 ½ tsp soy sauce\n1 ½ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 329589,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329590,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, gently crack eggs into the skillet and cook until the tops of the whites are set but the yolks are still runny, about 4 minutes. Remove from heat and season with salt and pepper. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 329591,
      "primary_message": "While the eggs are cooking, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329592,
      "primary_message": "When the veggies are done, remove from the oven, sprinkle with half of the cilantro, and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 329593,
      "primary_message": "To serve, divide veggies and eggs between plates or bowls; top with aioli, remaining cilantro, and feta. Enjoy!",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
