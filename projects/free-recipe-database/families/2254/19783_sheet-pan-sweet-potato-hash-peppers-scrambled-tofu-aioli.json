  "instructions": [
    {
      "id": 329622,
      "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 329623,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 329624,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n6 green bell peppers\n3 red chili peppers\n1 small bunch cilantro"
    },
    {
      "id": 329625,
      "primary_message": "Peel and medium dice sweet potatoes; divide between two large baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 329626,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 329627,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons and add to the baking sheets. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 329628,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the baking sheets with the other veggies, drizzle with oil, and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "1 ½ medium red onions\n⅓ cup extra virgin olive oil\n1 tbsp paprika\n1 tbsp cumin, ground\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 329629,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and fork-tender, 20-25 minutes. ",
      "secondary_message": null
    },
    {
      "id": 329630,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl along with mayo, vinegar, and spices; stir to combine the aioli and set aside. ",
      "secondary_message": "3 cloves garlic\n⅓ cup vegan mayonnaise\n3 tbsp apple cider vinegar\n1 ½ tsp paprika\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 329631,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329632,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329633,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble the tofu with your fingers into the skillet. Add salt and pepper; increase heat to medium-high and continue to cook, stirring often, until tofu begins to brown, 6-7 minutes. Remove from heat.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 329634,
      "primary_message": "When the veggies are done, remove from the oven, sprinkle with half of the cilantro, and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 329635,
      "primary_message": "To serve, divide veggies and tofu between plates or bowls; top with aioli and remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
