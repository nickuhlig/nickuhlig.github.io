  "instructions": [
    {
      "id": 329488,
      "primary_message": "Cut the tofu in half along the long side. Sandwich between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 329489,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 329490,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb sweet potatoes\n4 green bell peppers\n2 red chili peppers\n1 small bunch cilantro"
    },
    {
      "id": 329491,
      "primary_message": "Peel and medium dice sweet potatoes; divide between two additional baking sheets. ",
      "secondary_message": null
    },
    {
      "id": 329492,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the baking sheets with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 329493,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons and add to the baking sheets. (Be careful with chili peppers; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 329494,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the baking sheets with the other veggies, drizzle with oil, and season with spices; toss to combine and spread out in an even layer. ",
      "secondary_message": "1 medium red onion\n¼ cup extra virgin olive oil\n2 tsp paprika\n2 tsp cumin, ground\n1 tsp coriander, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 329495,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden and fork-tender, 18-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 329496,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a small bowl along with mayo, vinegar, and spices; stir to combine the aioli and set aside. ",
      "secondary_message": "2 cloves garlic\n¼ cup vegan mayonnaise\n2 tbsp apple cider vinegar\n1 tsp paprika\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 329497,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329498,
      "primary_message": "While the skillet heats up, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 329499,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Crumble the tofu with your fingers into the skillet. Add salt and pepper; increase heat to medium-high and continue to cook, stirring often, until tofu begins to brown, about 5 minutes. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 329500,
      "primary_message": "When the veggies are done, remove from the oven, sprinkle with half of the cilantro, and stir to combine. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 329501,
      "primary_message": "To serve, divide veggies and tofu between plates or bowls; top with aioli and remaining cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
