  "instructions": [
    {
      "id": 1,
      "primary_message": "Add pork butt, fatback, salt, pepper, sage, thyme, rosemary, brown sugar, nutmeg, cayenne, and pepper flakes to medium bowl and toss to combine. Refrigerate for at least 1 hour.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Using 1/4-inch die, grind mixture in chilled meat grinder into a medium bowl set in a larger bowl of ice water.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat 1/2 teaspoon of oil in a small skillet over medium heat. When oil is shimmering, cook a 1 tablespoon-sized patty of sausage mixture until browned and cooked through, about 1 1/2 minutes. Taste patty and adjust salt and spice level of mixture as needed. Form mixture into 3 ounce patties, about 1/2-inch thick, and 3-inches wide.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over entire surface of coal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil cooking grate. Grill patties over high heat until browned and cooked through flipping once half way through, 7 to 10 minutes total. Remove patties from grill, allow to rest for 3 minutes, and serve.",
      "secondary_message": null
    }
  ],
