  "instructions": [
    {
      "id": 358386,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 358387,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.68 kg new potatoes\n3 pears\n3 (142 g) pkg baby arugula"
    },
    {
      "id": 358388,
      "primary_message": "Quarter potatoes and transfer to a baking sheet pan. Drizzle potatoes with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 358389,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Place cutlets on another baking sheet; drizzle with oil, then season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 358390,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing potatoes and flipping chicken halfway through, until cooked through, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 358391,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic. Place in a large bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp apple cider vinegar\n2 tbsp Dijon mustard\n1 tbsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 358392,
      "primary_message": "Quarter, core, and thinly slice pears; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 358393,
      "primary_message": "Roughly chop pecans and add to the bowl.",
      "secondary_message": "¾ cup pecans, dry roasted"
    },
    {
      "id": 358394,
      "primary_message": "Crumble goat cheese into the bowl and set aside.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 358395,
      "primary_message": "When the chicken and potatoes are done, transfer chicken to a cutting board and slice into thin strips.",
      "secondary_message": null
    },
    {
      "id": 358396,
      "primary_message": "Add roast potatoes and arugula to the bowl; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 358397,
      "primary_message": "To serve, divide salad between plates or bowls and top with sliced chicken. Enjoy!",
      "secondary_message": null
    }
  ],
