  "instructions": [
    {
      "id": 358474,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 358475,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.45 kg new potatoes\n2 pears\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 358476,
      "primary_message": "Quarter potatoes and transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 358477,
      "primary_message": "Drain and rinse chickpeas in the colander; add to the baking sheet. Drizzle potatoes and chickpeas with oil, season with spices, and toss to coat. Spread out in an even layer.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n2 tsp Italian seasoning\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 358478,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until potatoes are fork-tender and chickpeas are crisp, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 358479,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a large bowl along with oil, vinegar, Dijon, maple syrup, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n4 tsp Dijon mustard\n2 tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 358480,
      "primary_message": "Quarter, core, and thinly slice pears; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 358481,
      "primary_message": "Roughly chop pecans, add to the bowl, and set aside.",
      "secondary_message": "½ cup pecans, dry roasted"
    },
    {
      "id": 358482,
      "primary_message": "When the potatoes and chickpeas are done, add to the bowl, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 358483,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
