  "instructions": [
    {
      "id": 358398,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 358399,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "0.23 kg new potatoes\n1 pear\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 358400,
      "primary_message": "Quarter potatoes and transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 358401,
      "primary_message": "Drain and rinse chickpeas in the colander; add to the baking sheet. Drizzle potatoes and chickpeas with oil, season with spices, and toss to coat. Spread out in an even layer.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 358402,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until potatoes are fork-tender and chickpeas are crisp, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 358403,
      "primary_message": "Meanwhile, peel and mince garlic. Place in a medium bowl along with oil, vinegar, Dijon, honey, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n1 tbsp apple cider vinegar\n2 tsp Dijon mustard\n1 tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 358404,
      "primary_message": "Quarter, core, and thinly slice pear; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 358405,
      "primary_message": "Roughly chop pecans and add to the bowl.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 358406,
      "primary_message": "Crumble goat cheese into the bowl.",
      "secondary_message": "½ (113 g) log goat cheese"
    },
    {
      "id": 358407,
      "primary_message": "When the potatoes and chickpeas are done, add to the bowl, along with the arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 358408,
      "primary_message": "To serve, divide salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
