  "instructions": [
    {
      "id": 266965,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n1 (1 inch) piece ginger root\n1 medium yellow potato\n1 tomato\n½ small bunch cilantro\n½ English cucumber"
    },
    {
      "id": 266966,
      "primary_message": "Cut off leaves from the cauliflower, separate into small florets, and cut the thick stems into smaller pieces. Place in a medium bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 266967,
      "primary_message": "Peel and mince ginger and garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 266968,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 266969,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 266970,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add ginger, garlic, onion, and salt; cook, stirring occasionally, until softened, about 5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil\n¼ tsp salt"
    },
    {
      "id": 266971,
      "primary_message": "Meanwhile, peel and small dice potato; medium dice tomato. Add both to the bowl with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 266972,
      "primary_message": "Add spices to the pan and continue to cook, stirring constantly, until fragrant, about 1 minute. ",
      "secondary_message": "1 tsp curry powder\n1 tsp cumin, ground\n1 tsp coriander, ground\n½ tsp turmeric, ground\n½ tsp chili powder\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 266973,
      "primary_message": "Add cauliflower, potato, tomato, and broth to the pan; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce heat to a simmer and cover; cook, stirring occasionally, until veggies are tender, 15-18 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 266974,
      "primary_message": "While the curry cooks, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in the reserved bowl (reserving the rest for the curry). ",
      "secondary_message": null
    },
    {
      "id": 266975,
      "primary_message": "Trim and grate cucumber into the bowl with the cilantro; add yogurt, water, salt, and pepper. Stir to combine the raita and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n1 tbsp water\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 266976,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 266977,
      "primary_message": "Arrange naan on a baking sheet pan and place in the oven; broil, flipping once, until golden brown and toasted, 1-2 minutes. Remove from oven, spread with oil, and cut into quarters.",
      "secondary_message": "2 flatbreads or naan\n½ tsp virgin coconut oil"
    },
    {
      "id": 266978,
      "primary_message": "When the curry is done, stir in reserved cilantro and remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 266979,
      "primary_message": "Divide curry between bowls; serve with raita and naan on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
