  "instructions": [
    {
      "id": 266995,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n3 (1 inch) pieces ginger root\n3 medium yellow potatoes\n3 tomatoes\n1 small bunch cilantro\n1 ½ English cucumbers"
    },
    {
      "id": 266996,
      "primary_message": "Cut leaves off each cauliflower head, separate into small florets, and cut the thick stems into smaller pieces. Place in a large bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 266997,
      "primary_message": "Peel and mince ginger and garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 266998,
      "primary_message": "Peel, halve, and small dice onions. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 266999,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 267000,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, onion, and salt; cook, stirring occasionally, until softened, about 6 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil\n¾ tsp salt"
    },
    {
      "id": 267001,
      "primary_message": "Meanwhile, peel and small dice potatoes; medium dice tomatoes. Add both to the bowl with the cauliflower. ",
      "secondary_message": null
    },
    {
      "id": 267002,
      "primary_message": "Add spices to the pot and continue to cook, stirring constantly, until fragrant, 1-2 minutes. ",
      "secondary_message": "1 tbsp curry powder\n1 tbsp cumin, ground\n1 tbsp coriander, ground\n1 ½ tsp turmeric, ground\n1 ½ tsp chili powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 267003,
      "primary_message": "Add cauliflower, potato, tomato, and broth to the pot; stir to combine and bring to a boil over medium-high heat. Once boiling, reduce heat to a simmer and cover; cook, stirring occasionally, until veggies are tender, 18-20 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 267004,
      "primary_message": "While the curry cooks, shave cilantro leaves off the stems; discard stems and mince the leaves. Place half in the reserved bowl (reserving the rest for the curry). ",
      "secondary_message": null
    },
    {
      "id": 267005,
      "primary_message": "Trim and grate cucumbers into the bowl with the cilantro; add yogurt, water, salt, and pepper. Stir to combine the raita and set aside. ",
      "secondary_message": "1 ½ cups plain Greek yogurt\n3 tbsp water\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 267006,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 267007,
      "primary_message": "Divide naan between two large baking sheet pans. Working in batches, place in the oven and broil, flipping once, until golden brown and toasted, 1-2 minutes. Remove from oven, spread with oil, and cut into quarters.",
      "secondary_message": "6 flatbreads or naan\n1 ½ tsp virgin coconut oil"
    },
    {
      "id": 267008,
      "primary_message": "When the curry is done, stir in reserved cilantro and remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 267009,
      "primary_message": "Divide curry between bowls; serve with raita and naan on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
