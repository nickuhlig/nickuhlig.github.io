  "instructions": [
    {
      "primary_message": "Using a sharp serrated knife, slice the log into 6 disks, each about 1/3-inch thick.",
      "secondary_message": null
    },
    {
      "primary_message": "In mixing bowl, beat the egg white almost to when soft peaks form with a whisk attachment.",
      "secondary_message": null
    },
    {
      "primary_message": "Using a mini food processor (or nut chopper or knife), briefly pulse to finely chop pecans. Add pecans and graham cracker crumbs to a custard cup or ramekin and blend together with a fork. Dip each disk into the egg white then the pecan mixture to coat both sides and place on parchment paper.",
      "secondary_message": null
    },
    {
      "primary_message": "Start heating medium nonstick griddle/skillet over medium heat. Distribute the oil to cover 6 round areas on the griddle. Place the disks on top and cook until the undersides are nicely golden (about 2 minutes), then use a fork and mini spatula to carefully flip each disk over to lightly brown the other side (about 1 minute more). ",
      "secondary_message": null
    },
    {
      "primary_message": "Serve them warm on crackers and top with 1 tsp yogurt, a blueberry if desired, and a dusting of cinnamon.",
      "secondary_message": null
    }
  ],
