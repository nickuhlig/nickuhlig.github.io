  "instructions": [
    {
      "id": 286179,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 286180,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n1 small bunch fresh dill\n3 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 286181,
      "primary_message": "Quarter potatoes, divide between two baking sheet pans, and drizzle with oil. Season with salt and pepper, toss to combine, and spread out in an even layer. Place in the oven (it doesn't have to be fully heated) and roast until starting to soften, 15-20 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 286182,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Place in a large bowl, then add mayo, vinegar, Dijon, and spices; whisk to combine the dressing and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n2 tbsp white wine vinegar\n2 tbsp Dijon mustard\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 286183,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 286184,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 286185,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 286186,
      "primary_message": "While the steak is cooking, peel, halve, and slice onion into ¼-inch thick half-moons.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 286187,
      "primary_message": "When the potatoes have started to soften, remove from the oven. Add onion and snap peas, toss to combine, then spread out in an even layer. Return to the oven and roast until veggies are fork-tender, 12-15 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 286188,
      "primary_message": "When the veggies are done, add to the bowl with the dressing and toss to combine the potato salad.",
      "secondary_message": null
    },
    {
      "id": 286189,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 286190,
      "primary_message": "To serve, divide steak and warm potato salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
