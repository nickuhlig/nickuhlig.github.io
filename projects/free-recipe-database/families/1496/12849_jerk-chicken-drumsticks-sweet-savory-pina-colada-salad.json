  "instructions": [
    {
      "id": 345497,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 limes\n1 small bunch green onions (scallions)\n1 small pkg fresh mint\n1 ½ small pineapples\n2 red bell peppers"
    },
    {
      "id": 345498,
      "primary_message": "Peel and mince ginger, garlic, and shallots. Place in a large bowl along with soy sauce, oil, and spices; stir to combine the rub.",
      "secondary_message": "6 cloves garlic\n3 shallots\n3 tbsp soy sauce\n1 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp cinnamon, ground\n3 pinch crushed red pepper"
    },
    {
      "id": 345499,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the rub; turn to coat.",
      "secondary_message": "1.7 kg chicken drumsticks"
    },
    {
      "id": 345500,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345501,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add chicken and grill, turning occasionally, until cooked through, about 20 minutes. Remove to a large plate and cover with foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 345502,
      "primary_message": "Meanwhile, preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 345503,
      "primary_message": "Juice limes into another large bowl. ",
      "secondary_message": null
    },
    {
      "id": 345504,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 345505,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345506,
      "primary_message": "Cut off skin from pineapples, core, and cut into bite-sized pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345507,
      "primary_message": "Seed and small dice bell peppers; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 345508,
      "primary_message": "Spread coconut on a baking sheet pan, place in the oven, and toast until golden, 2-3 minutes. ",
      "secondary_message": "¾ cup shredded unsweetened coconut"
    },
    {
      "id": 345509,
      "primary_message": "To serve, divide chicken and salad between plates. Sprinkle salad with toasted coconut and enjoy! ",
      "secondary_message": null
    }
  ],
