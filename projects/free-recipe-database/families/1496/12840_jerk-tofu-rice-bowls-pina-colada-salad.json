  "instructions": [
    {
      "id": 345372,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 345373,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 limes\n1 small bunch green onions (scallions)\n1 small pkg fresh mint\n1 ½ small pineapples\n3 red bell peppers"
    },
    {
      "id": 345374,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 345375,
      "primary_message": "Peel and mince ginger, garlic and shallots. Place in a large baking dish along with soy sauce, oil, and spices; stir to combine the rub.",
      "secondary_message": "6 cloves garlic\n3 shallots\n3 tbsp soy sauce\n3 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n¾ tsp salt\n½ tsp cinnamon, ground\n3 pinch crushed red pepper"
    },
    {
      "id": 345376,
      "primary_message": "Drain and cut tofu into 1-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Place tofu in the baking dish with the rub and turn to coat.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 345377,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345378,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, flipping once, until warmed through and golden brown, 6-8 minutes. Return to the baking dish and cover with foil. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 345379,
      "primary_message": "Meanwhile, juice limes into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 345380,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 345381,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345382,
      "primary_message": "Cut off skin from pineapples, core, and cut into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 345383,
      "primary_message": "Seed and small dice bell peppers; add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 345384,
      "primary_message": "Wipe skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345385,
      "primary_message": "Once the skillet is hot, add coconut and toast, stirring constantly, until golden, 2-3 minutes. Remove from heat.",
      "secondary_message": "¾ cup shredded unsweetened coconut"
    },
    {
      "id": 345386,
      "primary_message": "To serve, divide rice, tofu, and salad between bowls. Sprinkle with toasted coconut and enjoy! ",
      "secondary_message": null
    }
  ],
