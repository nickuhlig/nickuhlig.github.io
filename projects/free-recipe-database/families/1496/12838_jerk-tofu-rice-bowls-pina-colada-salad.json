  "instructions": [
    {
      "id": 345342,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 345343,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 lime\n½ small bunch green onions (scallions)\n½ small pkg fresh mint\n½ small pineapple\n1 red bell pepper"
    },
    {
      "id": 345344,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 345345,
      "primary_message": "Peel and mince ginger, garlic and shallot. Place in a medium bowl along with soy sauce, oil, and spices; stir to combine the rub.",
      "secondary_message": "2 cloves garlic\n1 shallot\n1 tbsp soy sauce\n1 tbsp extra virgin olive oil\n½ tsp thyme, dried\n¼ tsp salt\n⅛ tsp cinnamon, ground\n⅛ tsp crushed red pepper"
    },
    {
      "id": 345346,
      "primary_message": "Drain and cut tofu into 1-inch thick slices; sandwich the slices between clean towels or paper towels and gently press to remove excess water. Place tofu in the bowl with the rub and turn to coat.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 345347,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345348,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, flipping once, until warmed through and golden brown, 6-8 minutes. Remove to a plate and cover with foil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 345349,
      "primary_message": "Meanwhile, juice limes into the bowl used for the tofu.",
      "secondary_message": null
    },
    {
      "id": 345350,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 345351,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345352,
      "primary_message": "Cut off skin from pineapple, core, and cut into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 345353,
      "primary_message": "Seed and small dice bell pepper; add to the bowl and toss to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 345354,
      "primary_message": "Wipe skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345355,
      "primary_message": "Once the skillet is hot, add coconut and toast, stirring constantly, until golden, 2-3 minutes. Remove from heat.",
      "secondary_message": "¼ cup shredded unsweetened coconut"
    },
    {
      "id": 345356,
      "primary_message": "To serve, divide rice, tofu, and salad between bowls. Sprinkle with toasted coconut and enjoy! ",
      "secondary_message": null
    }
  ],
