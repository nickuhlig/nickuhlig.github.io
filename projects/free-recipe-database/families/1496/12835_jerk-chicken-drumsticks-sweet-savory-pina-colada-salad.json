  "instructions": [
    {
      "id": 345303,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (1 inch) piece ginger root\n1 lime\n½ small bunch green onions (scallions)\n½ small pkg fresh mint\n½ small pineapple\n½ red bell pepper"
    },
    {
      "id": 345304,
      "primary_message": "Peel and mince ginger, garlic, and shallot. Place in a medium bowl along with soy sauce, oil, and spices; stir to combine the rub.",
      "secondary_message": "2 cloves garlic\n1 shallot\n1 tbsp soy sauce\n1 tsp extra virgin olive oil\n½ tsp thyme, dried\n¼ tsp salt\n⅛ tsp cinnamon, ground\n⅛ tsp crushed red pepper"
    },
    {
      "id": 345305,
      "primary_message": "Preheat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345306,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the rub; turn to coat.",
      "secondary_message": "1 ¼ lb chicken drumsticks"
    },
    {
      "id": 345307,
      "primary_message": "Once the grill pan is hot, coat with oil. Add chicken and grill, turning occasionally, until cooked through, 15-20 minutes. Remove to a plate and cover with foil. ",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 345308,
      "primary_message": "Meanwhile, preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 345309,
      "primary_message": "Juice lime into another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 345310,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 345311,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345312,
      "primary_message": "Cut off skin from pineapple, core, and cut into bite-sized pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345313,
      "primary_message": "Seed and small dice bell pepper; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 345314,
      "primary_message": "Spread coconut on a baking sheet pan, place in the oven, and toast until golden, 2-3 minutes. ",
      "secondary_message": "¼ cup shredded unsweetened coconut"
    },
    {
      "id": 345315,
      "primary_message": "To serve, divide chicken and salad between plates. Sprinkle salad with toasted coconut and enjoy! ",
      "secondary_message": null
    }
  ],
