  "instructions": [
    {
      "id": 345316,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 limes\n1 small bunch green onions (scallions)\n½ small pkg fresh mint\n1 small pineapple\n1 red bell pepper"
    },
    {
      "id": 345317,
      "primary_message": "Peel and mince ginger, garlic, and shallots. Place in a medium bowl along with soy sauce, oil, and spices; stir to combine the rub.",
      "secondary_message": "4 cloves garlic\n2 shallots\n2 tbsp soy sauce\n2 tsp extra virgin olive oil\n1 tsp thyme, dried\n½ tsp salt\n¼ tsp cinnamon, ground\n¼ tsp crushed red pepper"
    },
    {
      "id": 345318,
      "primary_message": "Pat chicken dry with paper towels and add to the bowl with the rub; turn to coat.",
      "secondary_message": "2 ½ lb chicken drumsticks"
    },
    {
      "id": 345319,
      "primary_message": "Preheat a grill pan, outdoor grill, or large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 345320,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add chicken and grill, turning occasionally, until cooked through, 15-20 minutes. Remove to a plate and cover with foil. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 345321,
      "primary_message": "Meanwhile, preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 345322,
      "primary_message": "Juice limes into another medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 345323,
      "primary_message": "Trim green onions; cut crosswise into ¼-inch pieces at an angle. Add to the bowl with the lime juice. ",
      "secondary_message": null
    },
    {
      "id": 345324,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345325,
      "primary_message": "Cut off skin from pineapple, core, and cut into bite-sized pieces. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 345326,
      "primary_message": "Seed and small dice bell pepper; add to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 345327,
      "primary_message": "Spread coconut on a baking sheet pan, place in the oven, and toast until golden, 2-3 minutes. ",
      "secondary_message": "½ cup shredded unsweetened coconut"
    },
    {
      "id": 345328,
      "primary_message": "To serve, divide chicken and salad between plates. Sprinkle salad with toasted coconut and enjoy! ",
      "secondary_message": null
    }
  ],
