  "instructions": [
    {
      "id": 182052,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with foil and coat with a thin layer of oil.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 182053,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 182054,
      "primary_message": "Combine mayo and spices in a large bowl.",
      "secondary_message": "½ cup mayonnaise\n1 tsp paprika\n1 tsp oregano\n½ tsp garlic powder\n½ tsp salt\n⅛ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 182055,
      "primary_message": "Place breadcrumbs in a second large bowl.",
      "secondary_message": "2 cup panko bread crumbs"
    },
    {
      "id": 182056,
      "primary_message": "Toss shrimp in the mayo mixture to coat. Working in batches, transfer shrimp to the breadcrumb mixture and turn to coat, pressing gently to adhere. Transfer shrimp to the prepared baking sheet in a single layer.",
      "secondary_message": null
    },
    {
      "id": 182057,
      "primary_message": "Place shrimp in the oven and bake 10 minutes, then flip and cook until golden and crisp, 5 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 182058,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 lemon\n1 pint grape tomatoes\n1 English cucumber\n1 yellow bell pepper\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 182059,
      "primary_message": "Juice lemon into a small bowl. Peel and mince garlic; add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 182060,
      "primary_message": "Add ketchup, Worcestershire sauce, sugar, and spices to the bowl with the garlic and lemon; stir to combine the cocktail sauce and set aside. ",
      "secondary_message": "⅔ cup ketchup\n2 tsp Worcestershire sauce\n2 tsp brown sugar\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp chili powder"
    },
    {
      "id": 182061,
      "primary_message": "Place mayo, oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n4 tsp extra virgin olive oil\n4 tsp white wine vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 182062,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 182063,
      "primary_message": "Trim cucumber, halve lengthwise, and thinly slice crosswise on an angle. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 182064,
      "primary_message": "Seed and slice the bell pepper into thin strips; add to the bowl, along with the mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 182065,
      "primary_message": "Divide shrimp and salad between plates. Serve with cocktail sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
