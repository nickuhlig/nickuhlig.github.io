  "instructions": [
    {
      "id": 182066,
      "primary_message": "Preheat oven to 450°F. Line two baking sheet pans with foil and coat with a thin layer of oil.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 182067,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "2 ¼ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 182068,
      "primary_message": "Combine mayo and spices in a large bowl.",
      "secondary_message": "¾ cup mayonnaise\n1 ½ tsp paprika\n1 ½ tsp oregano\n¾ tsp garlic powder\n¾ tsp salt\n3 pinch black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 182069,
      "primary_message": "Place breadcrumbs in a second large bowl.",
      "secondary_message": "3 cup panko bread crumbs"
    },
    {
      "id": 182070,
      "primary_message": "Toss shrimp in the mayo mixture to coat. Working in batches, transfer shrimp to the breadcrumb mixture and turn to coat, pressing gently to adhere. Transfer shrimp to the prepared baking sheets in a single layer.",
      "secondary_message": null
    },
    {
      "id": 182071,
      "primary_message": "Place shrimp in the oven and bake 10 minutes, then flip and cook until golden and crisp, 5-8 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 182072,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ lemons\n1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 ½ yellow bell peppers\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 182073,
      "primary_message": "Juice lemons into a small bowl. Peel and mince garlic; add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 182074,
      "primary_message": "Add ketchup, Worcestershire sauce, sugar, and spices to the bowl with the garlic and lemon; stir to combine the cocktail sauce and set aside. ",
      "secondary_message": "1 cup ketchup\n1 tbsp Worcestershire sauce\n1 tbsp brown sugar\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp chili powder"
    },
    {
      "id": 182075,
      "primary_message": "Place mayo, oil, vinegar, salt, and pepper in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp mayonnaise\n2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n¼ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 182076,
      "primary_message": "Halve tomatoes and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 182077,
      "primary_message": "Trim cucumbers, halve lengthwise, and thinly slice crosswise on an angle. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 182078,
      "primary_message": "Seed and slice the bell peppers into thin strips; add to the bowl, along with the mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 182079,
      "primary_message": "Divide shrimp and salad between plates. Serve with cocktail sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
