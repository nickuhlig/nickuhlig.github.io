  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mix the cornstarch with 1/4 cup water to form a paste. Lightly beat the egg whites. Pick the cilantro leaves from the stems and finely chop them.",
      "secondary_message": "5 tbsp cornstarch\n4 egg whites\n1 ¼ cups cilantro"
    },
    {
      "id": 1,
      "primary_message": "In a medium-sized mixing bowl, combine meat with 1 teaspoon salt, soy sauce, and rice wine and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine broth and cornstarch paste in a 3-quart saucepan and cook over medium-high heat, stirring occasionally, until broth comes to a boil and thickens slightly. Reduce heat to a bare simmer.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the marinated ground meat stirring to break it up as you add it (stir gently if using fish). When the meat or fish is just cooked (about 30 seconds for meat or 2 minutes for fish), add egg whites by drizzling them into the simmering broth and stirring the broth around slowly with a pair of chopsticks. When egg whites are solidified, about 30 seconds longer, turn off the heat. Add white pepper and more salt to taste. Add chopped cilantro and stir around to incorporate. Serve immediately.",
      "secondary_message": null
    }
  ],
