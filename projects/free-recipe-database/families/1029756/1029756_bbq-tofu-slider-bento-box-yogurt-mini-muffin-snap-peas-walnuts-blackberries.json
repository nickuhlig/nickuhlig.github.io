  "instructions": [
    {
      "primary_message": "This recipe utilizes a 4-compartment bento box. Please adjust the recipe as needed to accommodate the size of your bento box or food storage containers.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry snap peas. Place in the medium compartment of the bento box.",
      "secondary_message": "½ cup sugar snap peas"
    },
    {
      "primary_message": "Wash and dry blackberries. Place in the first small compartment of the bento box. ",
      "secondary_message": "⅓ cup blackberries"
    },
    {
      "primary_message": "Place walnuts in the second small compartment of the bento box. ",
      "secondary_message": "⅓ cup walnuts"
    },
    {
      "primary_message": "Cut cheese into quarters and set aside. Holding a knife parallel to the cutting board, cut one piece of tofu in half horizontally to form thin planks. Cut one plank in half crosswise to yield 2 pieces; set aside for the sliders. (Reserve remaining tofu for another use.)",
      "secondary_message": "1 slice Muenster cheese, sliced\n¼ (7 oz) pkg baked tofu, teriyaki flavor"
    },
    {
      "primary_message": "Place rolls on a flat surface, then slice crosswise to separate into halves. Spread each half with BBQ sauce. Layer cheese and tofu over the bottom halves of the rolls, then close with the top halves. Place sliders in the large compartment of the bento box, along with yogurt and mini muffin.",
      "secondary_message": "2 Hawaiian sweet rolls\n2 tsp barbecue sauce\n1 (6 oz) cup strawberry yogurt\n1 mini blueberry muffin"
    },
    {
      "primary_message": "Cover bento box and refrigerate until ready to eat. Enjoy!",
      "secondary_message": null
    }
  ],
