  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "680 g new potatoes\n1 lemon\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "Halve new potatoes. Peel, trim, and cut carrots crosswise into ½-inch thick rounds. Place both in a medium bowl and set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a Dutch oven over medium heat.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "While the Dutch oven heats up, pat chicken dry with paper towels and cut into bite-sized pieces.\n\n",
      "secondary_message": "680 g chicken breasts, boneless skinless"
    },
    {
      "primary_message": "Once the Dutch oven is hot, add oil and swirl to coat the bottom. Add chicken, salt, and pepper; cook, stirring occasionally, until golden, 3-4 minutes (the chicken will not be cooked all the way through).\n\n",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, zest and juice lemon into the bowl with the veggies.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the chicken is golden, add potatoes, carrots, lemon, frozen peppers and onions, garlic, and spices to the Dutch oven. Stir to combine, cover with a lid, and place in the oven. Bake until chicken is cooked through and veggies are tender, about 1 hour 30 minutes. Remove from oven. \n\n",
      "secondary_message": "2 (397 g) pkg frozen pepper and onion strips (fajita vegetable blend)\n1 tbsp minced garlic\n1 tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "When the chicken and veggies are done, using a clean cutting board, shave parsley leaves off the stems; discard stems and mince the leaves.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, divide chicken, veggies, and sauce between plates or bowls, then sprinkle with parsley and feta. Enjoy!\n\n",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese"
    }
  ],
