  "instructions": [
    {
      "id": 43696,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 (5 oz) pkg spring mix (mixed greens)\n2 (6 oz) pkg blueberries\n1 lemon"
    },
    {
      "id": 43697,
      "primary_message": "Grate all of the zest from the lemon, then juice the lemon; transfer both to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 43698,
      "primary_message": "To the lemon zest and juice, add olive oil, Dijon, honey, salt, and pepper; whisk together. Set aside.",
      "secondary_message": "4 tbsp extra virgin olive oil\n1 tsp Dijon mustard\n1 tsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43699,
      "primary_message": "Place the feta in a small bowl.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 43700,
      "primary_message": "Roughly chop the walnuts and transfer to a small bowl.",
      "secondary_message": "½ cup walnuts"
    },
    {
      "id": 43701,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43702,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water until there are no more ice chunks. Then, lay them out on a clean towel or paper towels and pat dry. If using fresh shrimp, skip the first step.",
      "secondary_message": "1 ½ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 43703,
      "primary_message": "Once the skillet is hot, add the walnuts; cook, stirring constantly, until they are lightly browned, 2 to 3 minutes. Once done, return back to the bowl.",
      "secondary_message": ""
    },
    {
      "id": 43704,
      "primary_message": "Once the walnuts have been transferred, add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 43705,
      "primary_message": "Add the shrimp to the skillet; cook until they are opaque, 1 to 2 minutes per side. Once done, transfer to a bowl and set aside to cool.",
      "secondary_message": null
    },
    {
      "id": 43706,
      "primary_message": "To serve, divide the mixed greens between plates, top with the blueberries, shrimp, feta, and walnuts, and drizzle with the lemon vinaigrette. Enjoy!",
      "secondary_message": null
    }
  ],
