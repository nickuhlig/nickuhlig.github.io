  "instructions": [
    {
      "id": 1,
      "primary_message": "In medium saucepan over medium heat, stir 4 cups milk, sugar, and salt until dissolved. Add rice and bring to boil, stirring frequently.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Reduce heat to medium-low and cook, stirring, until rice is tender and pudding is thickened, about 30 minutes. Add more milk if pudding thickens before rice is tender.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in vanilla and chocolate until combined. Serve immediately.",
      "secondary_message": null
    }
  ],
