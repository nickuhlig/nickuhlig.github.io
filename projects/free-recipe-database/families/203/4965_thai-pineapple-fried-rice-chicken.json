  "instructions": [
    {
      "id": 60296,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n24 fl oz (3 cups) water"
    },
    {
      "id": 60295,
      "primary_message": "Slice skin from pineapple, core, and cut into bite-sized pieces. Transfer to a bowl.",
      "secondary_message": "1 ½ small pineapple"
    },
    {
      "id": 60285,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15 to 18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 60294,
      "primary_message": "Peel and thinly slice onion into half rings. Peel and mince garlic. Wash and dry cilantro. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 ½ medium red onion\n6 cloves garlic\n1 ½ small bunches cilantro"
    },
    {
      "id": 60293,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 60292,
      "primary_message": "Cut chicken into bite-sized pieces and season with salt.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n3 pinches salt"
    },
    {
      "id": 60286,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and, stirring occasionally, cook until cooked through, 2-3 minutes. Transfer to a plate.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 60291,
      "primary_message": "Return skillet to stove and add more oil. Add onion, garlic, and crushed red pepper. Stirring frequently, cook until onion is softened, 2-3 minutes.",
      "secondary_message": "about 3 tbsp virgin coconut oil\n⅜ tsp crushed red pepper"
    },
    {
      "id": 60290,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 60289,
      "primary_message": "Add rice and fish sauce to skillet. Stir until well combined, 1-2 minutes.",
      "secondary_message": "3 tbsp fish sauce"
    },
    {
      "id": 60288,
      "primary_message": "Stir in chicken, pineapple, cashews, ½ of the cilantro (save the rest for garnishing), and soy sauce. Remove from heat.",
      "secondary_message": "⅜ cup cashews, roasted unsalted\n6 tbsp soy sauce"
    },
    {
      "id": 60287,
      "primary_message": "To serve, place rice in a bowl and garnish with remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
