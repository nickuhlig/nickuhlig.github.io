  "instructions": [
    {
      "id": 224004,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 224005,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "9 caps portobello mushrooms\n3 medium beets\n3 medium carrots\n3 medium parsnips\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 224006,
      "primary_message": "Peel, halve, and thinly slice onions into half-moons. Peel and mince garlic. Transfer both to a large bowl, then add oil, honey, and spices.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp honey\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 224007,
      "primary_message": "Peel, trim, and dice beets, carrots, and parsnips into ½-inch pieces; add to the bowl with the onion. Toss to combine, divide between two baking sheet pans, and spread out in even layers. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 224008,
      "primary_message": "Place mixed veggies in the oven and roast, tossing halfway through, until fork-tender and golden, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 224009,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the marinade.",
      "secondary_message": "2 tbsp balsamic vinegar\n1 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 224010,
      "primary_message": "Remove mushroom stems and scrape out the gills; thinly slice and transfer to a large baking sheet. Drizzle with the marinade. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 224011,
      "primary_message": "Place mushrooms in the oven and bake until golden brown and tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 224012,
      "primary_message": "While the mushrooms are cooking, peel and mince additional garlic; transfer to a small bowl. Add mayo and whisk to combine the aioli. Set aside.",
      "secondary_message": "3 cloves garlic\n⅓ cup mayonnaise"
    },
    {
      "id": 224013,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "¾ (8 oz) block mozzarella cheese"
    },
    {
      "id": 224014,
      "primary_message": "Remove mushrooms from the oven, toss, add sprinkle with cheese. Return to the oven and continue to bake, until cheese is melted, about 3 minutes more. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 224015,
      "primary_message": "Meanwhile, halve olives and transfer to the reserved bowl along with the pine nuts.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n⅓ cup pine nuts"
    },
    {
      "id": 224016,
      "primary_message": "When the roasted veggies are done, remove from the oven and transfer to the bowl with the olives; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 224017,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread with aioli and stuff with cheesy mushrooms and spinach.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 224018,
      "primary_message": "To serve, divide pita pockets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
