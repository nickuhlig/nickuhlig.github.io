  "instructions": [
    {
      "id": 224034,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 224035,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "6 caps portobello mushrooms\n2 medium beets\n2 medium carrots\n2 medium parsnips\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 224036,
      "primary_message": "Peel, halve, and thinly slice onion into half-moons. Peel and mince garlic. Transfer both to a large bowl, then add oil, honey, and spices.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic\n4 tsp extra virgin olive oil\n4 tsp honey\n1 tsp oregano, dried\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 224037,
      "primary_message": "Peel, trim, and dice beets, carrots, and parsnips into ½-inch pieces; add to the bowl with the onion. Toss to combine, transfer to a large baking sheet pan, and spread out in an even layer. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 224038,
      "primary_message": "Place mixed veggies in the oven and roast, tossing halfway through, until fork-tender and golden, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 224039,
      "primary_message": "Meanwhile, place vinegar, oil, salt, and pepper in the reserved bowl; whisk to combine the marinade.",
      "secondary_message": "4 tsp balsamic vinegar\n2 tsp extra virgin olive oil\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 224040,
      "primary_message": "Remove mushroom stems and scrape out the gills; thinly slice and transfer to another large baking sheet. Drizzle with the marinade. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 224041,
      "primary_message": "Place mushrooms in the oven and bake until golden brown and tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 224042,
      "primary_message": "While the mushrooms are cooking, peel and mince additional garlic; transfer to a small bowl. Add mayo and whisk to combine the aioli. Set aside.",
      "secondary_message": "2 cloves garlic\n¼ cup mayonnaise"
    },
    {
      "id": 224043,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "½ (8 oz) block mozzarella cheese"
    },
    {
      "id": 224044,
      "primary_message": "Remove mushrooms from the oven, toss, add sprinkle with cheese. Return to the oven and continue to bake, until cheese is melted, 2-3 minutes more. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 224045,
      "primary_message": "Meanwhile, halve olives and transfer to the reserved bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 224046,
      "primary_message": "When the roasted veggies are done, remove from the oven and transfer to the bowl with the olives; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 224047,
      "primary_message": "Cut pitas in half and carefully open the pockets. Spread with aioli and stuff with cheesy mushrooms and spinach.",
      "secondary_message": "4 whole grain pitas"
    },
    {
      "id": 224048,
      "primary_message": "To serve, divide pita pockets and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
