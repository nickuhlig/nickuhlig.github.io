  "instructions": [
    {
      "id": 194228,
      "primary_message": "Preheat oven to 205°C (400°F) and position a rack near the bottom of the oven; grease 18 muffin cups with butter.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 194229,
      "primary_message": "Chop the prosciutto into ½-inch pieces.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 194230,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 194231,
      "primary_message": "Wash and chop the spinach. Add to the skillet and wilt for 1-2 minutes.",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 194232,
      "primary_message": "Divide the prosciutto and spinach between the greased muffin tins.",
      "secondary_message": null
    },
    {
      "id": 194233,
      "primary_message": "Crack the eggs into a large bowl and season with pepper; whisk together and pour on top of the prosciutto and spinach.",
      "secondary_message": "15 eggs\n¾ tsp black pepper"
    },
    {
      "id": 194234,
      "primary_message": "Coarsely grate the cheddar and add to the muffin tins. ",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 194235,
      "primary_message": "Bake for 12-15 minutes, until eggs are no longer soft in the center. Remove from the oven and let cool for 1 minute. Use a spatula to wedge each egg muffin out of its cup.",
      "secondary_message": null
    },
    {
      "id": 194236,
      "primary_message": "Serve warm or cool for breakfast on the go. Enjoy! ",
      "secondary_message": null
    }
  ],
