  "instructions": [
    {
      "id": 376036,
      "primary_message": "Place eggs in a medium saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool.",
      "secondary_message": "6 eggs"
    },
    {
      "id": 376037,
      "primary_message": "Meanwhile, wash, dry and shave dill leaves off the stems; discard stems and mince the leaves. Place in a small bowl and set aside.",
      "secondary_message": "¼ small bunch fresh dill"
    },
    {
      "id": 376038,
      "primary_message": "When the eggs are cool enough to handle, peel and halve lengthwise.",
      "secondary_message": null
    },
    {
      "id": 376039,
      "primary_message": "Scoop the yolks out into another small bowl (reserve egg whites for the next step). Add mayo, Dijon, and spices. Using a fork, mash to combine, creating a smooth paste.",
      "secondary_message": "¼ cup mayonnaise\n1 tsp Dijon mustard\n½ tsp curry powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 376040,
      "primary_message": "Spoon the yolk mixture back into the eggs, then sprinkle with dill.",
      "secondary_message": null
    },
    {
      "id": 376041,
      "primary_message": "To serve, divide eggs between plates and enjoy!",
      "secondary_message": null
    }
  ],
