  "instructions": [
    {
      "primary_message": "Place salsa verde, green chiles, garlic, and spices in the insert of a 4-quart slow cooker, then stir to combine the sauce. \n\n",
      "secondary_message": "1 (454 g) jar salsa verde\n1 (113 g) can diced green chiles, canned\n2 tbsp minced garlic\n1 tsp onion powder\n1 tsp cumin, ground\n½ tsp black pepper"
    },
    {
      "primary_message": "Pat chicken dry with paper towels and add to the slow cooker, nestling thighs into the sauce. Cover and cook until chicken is tender, LOW for 5-6 hours.\n\n",
      "secondary_message": "680 g chicken thighs, boneless skinless"
    },
    {
      "primary_message": "When the chicken is done, turn off the heat, then use two forks to shred the meat. Re-cover the salsa verde chicken and set aside.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Set aside.\n\n",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Use a slotted spoon to fill tortillas with chicken filling. Top with lettuce, sour cream, pickled onions, and cilantro. Serve with sauce for dipping (optional) and enjoy! \n\n",
      "secondary_message": "2 cups shredded lettuce\n½ cup sour cream\n1 cup pickled red onions"
    }
  ],
