  "instructions": [
    {
      "id": 155988,
      "primary_message": "Preheat oven to 400°F and line a baking sheet with parchment paper. ",
      "secondary_message": null
    },
    {
      "id": 155989,
      "primary_message": "Roughly chop nuts and place in a medium bowl.",
      "secondary_message": "¼ cup pecans, dry roasted"
    },
    {
      "id": 155990,
      "primary_message": "Add oats and pumpkin seeds to the bowl with the nuts.",
      "secondary_message": "½ cup oats, quick cooking\n¼ cup pumpkin seeds"
    },
    {
      "id": 155991,
      "primary_message": "Melt oil in a small saucepan over medium heat. Add maple syrup, cinnamon, and salt; whisk to combine.",
      "secondary_message": "1 tbsp virgin coconut oil\n1 tsp pure maple syrup\n½ tsp cinnamon\n¼ tsp salt"
    },
    {
      "id": 155992,
      "primary_message": "Pour oil mixture over oats and nuts; stir to coat.",
      "secondary_message": null
    },
    {
      "id": 155993,
      "primary_message": "Spread mixture out on the baking sheet and bake for 6-8 minutes, stirring halfway through cooking. Watch carefully as the granola can burn easily. Reserve bowl for the next step.",
      "secondary_message": null
    },
    {
      "id": 155994,
      "primary_message": "Add pumpkin, yogurt, maple syrup, and cinnamon to the bowl and whisk to combine.",
      "secondary_message": "½ (15 oz) can pure pumpkin purée\n⅔ cup plain Greek yogurt\n2 tbsp pure maple syrup\n½ tsp cinnamon"
    },
    {
      "id": 155995,
      "primary_message": "To serve, divide pumpkin-yogurt, plain yogurt, and granola between jars or bowls, alternating ingredients to create layers. Enjoy!",
      "secondary_message": "⅓ cup plain Greek yogurt"
    }
  ],
