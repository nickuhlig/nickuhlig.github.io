  "instructions": [
    {
      "id": 293248,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 medium yellow potato\n1 stick celery\n1 medium zucchini squash\n½ small pkg fresh thyme\n½ lemon"
    },
    {
      "id": 293249,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 293250,
      "primary_message": "Peel and medium dice carrot and potato; place both in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 293251,
      "primary_message": "Trim celery and cut crosswise into thin pieces; add to the bowl with the carrot and potato.",
      "secondary_message": null
    },
    {
      "id": 293252,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 293253,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 293254,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add veggies, salt, and pepper. Cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 293255,
      "primary_message": "Meanwhile, trim and medium dice zucchini.",
      "secondary_message": null
    },
    {
      "id": 293256,
      "primary_message": "Slide thyme leaves off the stems; discard the stems.",
      "secondary_message": null
    },
    {
      "id": 293257,
      "primary_message": "When the veggies are soft, add beans, zucchini, thyme, broth, coconut milk, and corn to the pan. Stir to combine the soup, cover, and bring to a simmer over medium-high heat.",
      "secondary_message": "710 ml chicken or vegetable broth\n½ (398 ml) can coconut milk\n½ cup frozen corn"
    },
    {
      "id": 293258,
      "primary_message": "Once the soup is simmering, reduce heat to medium-low and cook, stirring occasionally, until the potatoes are fork-tender, about 8 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 293259,
      "primary_message": "Juice lemon into the soup and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 293260,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
