  "instructions": [
    {
      "id": 225129,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 225130,
      "primary_message": "Wash, dry, and halve potatoes; transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to combine, then spread out in a single layer.",
      "secondary_message": "0.45 kg new potatoes\n2 tsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 225131,
      "primary_message": "Place potatoes in the oven (it doesn't have to be fully heated) and roast until fork-tender, 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 225132,
      "primary_message": "While the potatoes are baking, peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 225133,
      "primary_message": "Add oil, vinegar, Dijon, salt, and pepper to the bowl with the garlic; whisk to combine the dressing and set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 225134,
      "primary_message": "Heat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 225135,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "0.68 kg ribeye steak\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 225136,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add steak and grill until desired doneness, 2-5 minutes per side. Transfer to a clean plate, cover with aluminum foil, and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 225137,
      "primary_message": "While the steak is cooking, peel and mince additional garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 225138,
      "primary_message": "Place bread on an another baking sheet, sprinkle with garlic, and drizzle with oil. Transfer to the oven and bake until toasted, about 3 minutes.",
      "secondary_message": "4 slices whole grain bread\n1 tsp extra virgin olive oil"
    },
    {
      "id": 225139,
      "primary_message": "Wash and dry the mixed greens (skip if they came pre-washed). Add to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": "1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 225140,
      "primary_message": "Divide toast between plates and top with steak. Serve with roasted potatoes and salad on the side. Enjoy sandwiches pub-style, with a knife and fork!",
      "secondary_message": null
    }
  ],
