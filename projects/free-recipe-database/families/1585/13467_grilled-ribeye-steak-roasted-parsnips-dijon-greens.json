  "instructions": [
    {
      "id": 224968,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 224969,
      "primary_message": "Wash, dry, peel, and medium dice parsnips; transfer to a large baking sheet pan, drizzle with oil, and season with spices. Toss to combine, then spread out in a single layer.",
      "secondary_message": "6 medium parsnips\n1 tbsp extra virgin olive oil\n¾ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 224970,
      "primary_message": "Place parsnips in the oven (it doesn't have to be fully heated) and roast until fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 224971,
      "primary_message": "While the parsnips are baking, peel and mince garlic; transfer to a large bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 224972,
      "primary_message": "Add oil, vinegar, Dijon, salt, and pepper to the bowl with the garlic; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n1 ½ tsp Dijon mustard\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 224973,
      "primary_message": "Heat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 224974,
      "primary_message": "While the grill pan heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 224975,
      "primary_message": "Once the grill pan is hot, coat with oil. Working in batches if necessary, add steak and grill until desired doneness, 2-5 minutes per side. Transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 224976,
      "primary_message": "Meanwhile, wash and dry the mixed greens (skip if they came pre-washed).",
      "secondary_message": "1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 224977,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 224978,
      "primary_message": "To serve, divide steak, parsnips, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
