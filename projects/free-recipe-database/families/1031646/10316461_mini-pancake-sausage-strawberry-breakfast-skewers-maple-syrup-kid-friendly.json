  "instructions": [
    {
      "primary_message": "Preheat a large skillet over medium heat. Once the skillet is hot, add sausage patties in a single layer. Cook, flipping once halfway, until browned and cooked through, 10-12 minutes. Remove from heat and cut in half.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash, dry, trim, and halve strawberries lengthwise. Set aside.\n\n",
      "secondary_message": "1 (454 g) pkg strawberries"
    },
    {
      "primary_message": "Place pancakes on a microwave-safe plate. Place plate in the microwave and heat on high until warmed through, about 1 minute (or cook according to package instructions).\n\n",
      "secondary_message": "16 mini pancakes, frozen"
    },
    {
      "primary_message": "Thread pancakes, sausage patty halves, and strawberries onto the skewers, alternating ingredients.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Divide skewers between plates. Serve with maple syrup on the side for dipping and enjoy!\n\n",
      "secondary_message": "½ cup pure maple syrup"
    }
  ],
