  "instructions": [
    {
      "id": 1,
      "primary_message": "Cut goat cheese log into 8 equal pieces; roll into balls, if desired.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Pour olive oil into clean wide-necked jars until halfway full. Distribute chili flakes, fennel seed, and peppercorns equally into both jars.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the goat cheese pieces one at a time, adding a little olive oil between each one so they are fully immersed. Add lemon zest, bay leaves, thyme and garlic to jars. Pour in enough olive oil to fully cover cheese. Seal jars and refrigerate for at least a few hours (we found it tasted best after 2 days). The marinated goat cheese can be kept refrigerated for up to 1 week, but not any longer than that (see 'Notes' below.)",
      "secondary_message": null
    }
  ],
