  "instructions": [
    {
      "id": 286240,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n2 green bell peppers\n1 English cucumber\n1 pint grape tomatoes\n1 small bunch fresh dill\n2 lemons"
    },
    {
      "id": 286241,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a large pot.",
      "secondary_message": null
    },
    {
      "id": 286242,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Add chicken to the pot with the carrot and celery, placing the fillets over the veggies in a single layer; sprinkle with spices.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless\n1 tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp oregano, dried"
    },
    {
      "id": 286243,
      "primary_message": "Add broth, rice, and oil to the pot. Place the pot over high heat, cover, and bring to a boil; once boiling, reduce heat to low and simmer, stirring occasionally, until chicken is cooked through and rice is almost tender, 8-10 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n½ cup basmati rice\n4 tsp extra virgin olive oil"
    },
    {
      "id": 286244,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper\n¼ tsp oregano, dried"
    },
    {
      "id": 286245,
      "primary_message": "Using a clean cutting board, trim, seed, halve, and thinly slice bell peppers. Peel, trim, and thinly slice cucumber crosswise into rounds. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 286246,
      "primary_message": "Halve tomatoes and olives; add both to the bowl along with the feta.",
      "secondary_message": "½ cup Kalamata olives, pitted\n1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 286247,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half of the dill to the bowl and toss to combine the salad; set aside. (Reserve remaining dill for the soup.) ",
      "secondary_message": null
    },
    {
      "id": 286248,
      "primary_message": "Juice lemons into another medium bowl. Add the eggs and whisk to combine the thickening liquid; set aside.",
      "secondary_message": "2 eggs"
    },
    {
      "id": 286249,
      "primary_message": "When the chicken is done, remove fillets to a plate using tongs (cover the soup and continue to simmer over low heat). Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 286250,
      "primary_message": "Using a ladle, carefully add 3-4 cups of hot broth (from the pot) to the bowl with the thickening liquid, whisking constantly.",
      "secondary_message": null
    },
    {
      "id": 286251,
      "primary_message": "Slowly pour the warm thickening liquid back into the pot, stirring to combine. Add shredded chicken and reserved dill; continue to cook, stirring occasionally, until slightly thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 286252,
      "primary_message": "Divide soup between bowls and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
