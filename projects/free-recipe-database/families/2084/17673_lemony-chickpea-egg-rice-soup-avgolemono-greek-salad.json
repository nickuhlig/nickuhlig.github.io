  "instructions": [
    {
      "id": 286317,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium carrots\n2 sticks celery\n2 green bell peppers\n1 English cucumber\n1 pint grape tomatoes\n1 small bunch fresh dill\n2 lemons"
    },
    {
      "id": 286318,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a large pot.",
      "secondary_message": null
    },
    {
      "id": 286319,
      "primary_message": "Drain and rinse chickpeas in a colander; add to the pot with the carrot and celery.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 286320,
      "primary_message": "Add broth, rice, oil, and spices to the pot. Place the pot over high heat, cover, and bring to a boil; once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are soft and rice is almost tender, 8-10 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n½ cup basmati rice\n4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp oregano, dried"
    },
    {
      "id": 286321,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n½ tsp salt\n¼ tsp black pepper\n¼ tsp oregano, dried"
    },
    {
      "id": 286322,
      "primary_message": "Trim, seed, halve, and thinly slice bell peppers. Peel, trim, and thinly slice cucumber crosswise into rounds. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 286323,
      "primary_message": "Halve tomatoes and olives; add both to the bowl along with the feta.",
      "secondary_message": "½ cup Kalamata olives, pitted\n1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 286324,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half of the dill to the bowl and toss to combine the salad; set aside. (Reserve remaining dill for the soup.) ",
      "secondary_message": null
    },
    {
      "id": 286325,
      "primary_message": "Juice lemons into another medium bowl. Add the eggs and salt; whisk to combine the thickening liquid.",
      "secondary_message": "2 eggs\n¼ tsp salt"
    },
    {
      "id": 286326,
      "primary_message": "Using a ladle, carefully add 3-4 cups of hot broth (from the pot) to the bowl with the thickening liquid, whisking constantly.",
      "secondary_message": null
    },
    {
      "id": 286327,
      "primary_message": "Slowly pour the warm thickening liquid back into the pot, stirring to combine. Add the reserved dill and continue to cook, stirring occasionally, until slightly thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 286328,
      "primary_message": "Divide soup between bowls and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
