  "instructions": [
    {
      "id": 286227,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 green bell pepper\n½ English cucumber\n½ pint grape tomatoes\n½ small bunch fresh dill\n1 lemon"
    },
    {
      "id": 286228,
      "primary_message": "Peel, trim, and small dice carrot; trim and small dice celery. Place both in a medium saucepan.",
      "secondary_message": null
    },
    {
      "id": 286229,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Add chicken to the pan with the carrot and celery, placing the fillets over the veggies in a single layer; sprinkle with spices.",
      "secondary_message": "¾ lb chicken breasts, boneless skinless\n½ tsp salt\n⅛ tsp black pepper\n⅛ tsp garlic powder\n⅛ tsp onion powder\n⅛ tsp oregano, dried"
    },
    {
      "id": 286230,
      "primary_message": "Add broth, rice, and oil to the pan. Place the pan over high heat, cover, and bring to a boil; once boiling, reduce heat to low and simmer, stirring occasionally, until chicken is cooked through and rice is almost tender, 8-10 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n¼ cup basmati rice\n2 tsp extra virgin olive oil"
    },
    {
      "id": 286231,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tsp red wine vinegar\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp oregano, dried"
    },
    {
      "id": 286232,
      "primary_message": "Using a clean cutting board, trim, seed, halve, and thinly slice bell pepper. Peel, trim, and thinly slice cucumber crosswise into rounds. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 286233,
      "primary_message": "Halve tomatoes and olives; add both to the bowl along with the feta.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n½ (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 286234,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half of the dill to the bowl and toss to combine the salad; set aside. (Reserve remaining dill for the soup.) ",
      "secondary_message": null
    },
    {
      "id": 286235,
      "primary_message": "Juice lemon into another medium bowl. Add the egg and whisk to combine the thickening liquid; set aside.",
      "secondary_message": "1 egg"
    },
    {
      "id": 286236,
      "primary_message": "When the chicken is done, remove fillets to a plate using tongs (cover the soup and continue to simmer over low heat). Shred the chicken using two forks; use one fork to hold the chicken and the other fork to pull and shred the meat. Set aside.",
      "secondary_message": null
    },
    {
      "id": 286237,
      "primary_message": "Using a ladle, carefully add 1-2 cups of hot broth (from the saucepan) to the bowl with the thickening liquid, whisking constantly.",
      "secondary_message": null
    },
    {
      "id": 286238,
      "primary_message": "Slowly pour the warm thickening liquid back into the saucepan, stirring to combine. Add shredded chicken and reserved dill; continue to cook, stirring occasionally, until slightly thickened, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 286239,
      "primary_message": "Divide soup between bowls and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
