  "instructions": [
    {
      "id": 286329,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n3 green bell peppers\n1 ½ English cucumbers\n1 ½ pints grape tomatoes\n1 small bunch fresh dill\n3 lemons"
    },
    {
      "id": 286330,
      "primary_message": "Peel, trim, and small dice carrots; trim and small dice celery. Place both in a large pot.",
      "secondary_message": null
    },
    {
      "id": 286331,
      "primary_message": "Drain and rinse chickpeas in a colander; add to the pot with the carrot and celery.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 286332,
      "primary_message": "Add broth, rice, oil, and spices to the pot. Place the pot over high heat, cover, and bring to a boil; once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are soft and rice is almost tender, 8-10 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n¾ cup basmati rice\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp oregano, dried"
    },
    {
      "id": 286333,
      "primary_message": "Meanwhile, place oil, vinegar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tbsp red wine vinegar\n¾ tsp salt\n½ tsp black pepper\n½ tsp oregano, dried"
    },
    {
      "id": 286334,
      "primary_message": "Trim, seed, halve, and thinly slice bell peppers. Peel, trim, and thinly slice cucumbers crosswise into rounds. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 286335,
      "primary_message": "Halve tomatoes and olives; add both to the bowl along with the feta.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n1 ½ (4 oz) pkgs crumbled feta cheese"
    },
    {
      "id": 286336,
      "primary_message": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add half of the dill to the bowl and toss to combine the salad; set aside. (Reserve remaining dill for the soup.) ",
      "secondary_message": null
    },
    {
      "id": 286337,
      "primary_message": "Juice lemons into another large bowl. Add the eggs and salt; whisk to combine the thickening liquid.",
      "secondary_message": "3 eggs\n½ tsp salt"
    },
    {
      "id": 286338,
      "primary_message": "Using a ladle, carefully add 5-6 cups of hot broth (from the pot) to the bowl with the thickening liquid, whisking constantly.",
      "secondary_message": null
    },
    {
      "id": 286339,
      "primary_message": "Slowly pour the warm thickening liquid back into the pot, stirring to combine. Add the reserved dill and continue to cook, stirring occasionally, until slightly thickened, 3-4 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 286340,
      "primary_message": "Divide soup between bowls and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
