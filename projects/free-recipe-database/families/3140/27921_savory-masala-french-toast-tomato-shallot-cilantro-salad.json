  "instructions": [
    {
      "id": 447913,
      "primary_message": "Peel and mince shallots. Place in a medium bowl along with vinegar and salt. Stir to combine and set aside.",
      "secondary_message": "2 shallots\n3 tbsp rice vinegar\n¾ tsp salt"
    },
    {
      "id": 447914,
      "primary_message": "Place milk, eggs, and spices in a large baking dish. Whisk to combine the batter. ",
      "secondary_message": "6 fl oz (¾ cup) whole milk\n6 eggs\n2 ½ tsp garam masala\n¾ tsp salt\n½ tsp cayenne pepper\n½ tsp turmeric, ground"
    },
    {
      "id": 447915,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 447916,
      "primary_message": "While the skillet heats up, working in batches, place bread slices in the dish with the batter; turn the slices, making sure both sides are soaked through.",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 447917,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, transfer soaked bread to the skillet and cook until golden brown, 2-3 minutes per side. Remove to a plate.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 447918,
      "primary_message": "Meanwhile, wash, dry, and small dice tomatoes. Add to the bowl with the shallot.",
      "secondary_message": "6 tomatoes"
    },
    {
      "id": 447919,
      "primary_message": "Wash, dry, and shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 447920,
      "primary_message": "To serve, divide French toast between plates; top with tomato salad. Enjoy!",
      "secondary_message": null
    }
  ],
