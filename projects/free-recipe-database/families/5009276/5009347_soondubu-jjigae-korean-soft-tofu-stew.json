  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the garlic on a microplane grater. Roughly break the soft silken tofu.",
      "secondary_message": "4 cloves garlic\n0.68 kg soft silken tofu"
    },
    {
      "id": 1,
      "primary_message": "Combine kombu and anchovies (if using) and cover with 1 quart water. Bring to a simmer and remove from heat. Let stand 5 minutes, then strain. Discard solids and reserve broth. Meanwhile, drain kimchi in a fine mesh strainer set over a small bowl, squeezing to remove as much liquid as possible. Roughly chop kimchi and reserve kimchi and juice separately.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat oil in a 2 to 3 quart stone dolsot or saucepan over medium-high heat until shimmering. Add pork belly and cook, stirring constantly, until just cooked through, about 1 minute. Add scallion whites, garlic, and chopped kimchi. Cook, stirring constantly, until fragrant, about 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add kimchi juice, gochujang, and soy sauce. Cook until vegetables are well-coated in even layer of sauce. Add strained broth, kochukaru, and tofu. Stir gently and heat until boiling. Season to taste with more kochukaru or soy sauce if desired. Remove from heat and add eggs. sprinkle with scallion greens. Serve immediately while still boiling, gently stirring eggs into the broth.",
      "secondary_message": null
    }
  ],
