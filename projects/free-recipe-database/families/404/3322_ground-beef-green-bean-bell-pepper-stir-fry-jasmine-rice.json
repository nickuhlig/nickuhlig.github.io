  "instructions": [
    {
      "id": 34454,
      "primary_message": "Rinse the rice in a colander and transfer to a small saucepan. Add water and salt; bring to a boil.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n¼ tsp salt"
    },
    {
      "id": 34455,
      "primary_message": "While the water comes to a boil, wash and dry the fresh produce.",
      "secondary_message": "0.227 kg green beans\n1 red bell pepper\n½ lime\n½ small pkg fresh basil"
    },
    {
      "id": 34456,
      "primary_message": "Once the water is boiling, reduce the heat to low and cover. Cook the rice until the liquid is absorbed, 12 to 15 minutes. Once done, remove the saucepan from the heat and let it stand, covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 34457,
      "primary_message": "Trim and discard the ends of the green beans; cut the beans in half and transfer to a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 34458,
      "primary_message": "Cut the bell pepper into quarters lengthwise; remove and discard the seeds and white membrane. Thinly slice the pepper into strips and add to the bowl with the green beans.",
      "secondary_message": null
    },
    {
      "id": 34459,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and transfer the leaves to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 34460,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 34461,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 34462,
      "primary_message": "Add coconut oil to the skillet and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 34463,
      "primary_message": "Add the ground beef to the skillet; cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer to a bowl, leaving juices in the skillet.",
      "secondary_message": "0.34 kg lean ground beef"
    },
    {
      "id": 34464,
      "primary_message": "Once the beef has been transferred, add more coconut oil to the skillet followed by the garlic, bell pepper, and green beans. Cook, stirring frequently, until the vegetables are tender-crisp, 3 to 4 minutes.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 34465,
      "primary_message": "While the vegetables cook, juice the lime into a small bowl, then add soy sauce, fish sauce, and whisk together.",
      "secondary_message": "1 tbsp soy sauce\n1 tbsp fish sauce"
    },
    {
      "id": 34466,
      "primary_message": "Return the beef to the skillet, pour in the sauce, and season with black pepper; stir to combine.",
      "secondary_message": "¼ tsp black pepper"
    },
    {
      "id": 34467,
      "primary_message": "Remove the skillet from the heat and stir in the basil leaves.",
      "secondary_message": null
    },
    {
      "id": 34468,
      "primary_message": "Uncover the rice and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 34469,
      "primary_message": "To serve, place the rice onto a plate and top with the stir fry. Enjoy!",
      "secondary_message": null
    }
  ],
