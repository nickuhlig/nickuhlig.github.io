  "instructions": [
    {
      "primary_message": "Place oil, vinegar, and soy sauce in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "toasted sesame oil\n2 tbsp rice vinegar"
    },
    {
      "primary_message": "Add broccoli slaw and pumpkin seeds to the bowl with the dressing. Stir to combine and set aside.",
      "secondary_message": "3 (340 g) pkg broccoli slaw\n¾ cup pumpkin seeds"
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n1 ½ English cucumbers\n1 ½ avocados"
    },
    {
      "primary_message": "Peel and mince ginger. Place in a small bowl along with mayo, additional oil, and spices. Stir to combine the ginger mayo and set aside.",
      "secondary_message": "¾ cup mayonnaise\ntoasted sesame oil\n¾ tsp garlic powder\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "primary_message": "Trim cucumbers and use a vegetable peeler to make thin ribbons; place on a large plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "primary_message": "Chop or tear salmon into bite-sized pieces and add to the plate.",
      "secondary_message": "3 (113 g) pkgs smoked salmon"
    },
    {
      "primary_message": "To assemble the rolls, arrange cucumber ribbons on a flat surface. Divide smoked salmon and avocado between ribbons, placing them at one end. Roll tightly to secure. (Assemble in batches if necessary.)",
      "secondary_message": null
    },
    {
      "primary_message": "Divide cucumber rolls and slaw between plates. Serve with ginger mayo for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
