  "instructions": [
    {
      "id": 378543,
      "primary_message": "Place oil, vinegar, and soy sauce in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp toasted sesame oil\n4 tsp rice vinegar\n4 tsp soy sauce"
    },
    {
      "id": 378544,
      "primary_message": "Add broccoli slaw and pumpkin seeds to the bowl with the dressing. Stir to combine and set aside.",
      "secondary_message": "2 (12 oz) pkg broccoli slaw\n½ cup pumpkin seeds"
    },
    {
      "id": 378545,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n1 English cucumber\n1 avocado"
    },
    {
      "id": 378546,
      "primary_message": "Peel and mince ginger. Place in a small bowl along with mayo, additional oil, and spices. Stir to combine the ginger mayo and set aside.",
      "secondary_message": "½ cup mayonnaise\n4 tsp toasted sesame oil\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 378547,
      "primary_message": "Trim cucumber and use a vegetable peeler to make thin ribbons; place on a plate.",
      "secondary_message": null
    },
    {
      "id": 378548,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and slice crosswise into thin half-moons. Add to the plate with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 378549,
      "primary_message": "Chop or tear salmon into bite-sized pieces and add to the plate.",
      "secondary_message": "2 (4 oz) pkgs smoked salmon"
    },
    {
      "id": 378550,
      "primary_message": "To assemble the rolls, arrange cucumber ribbons on a flat surface. Divide smoked salmon and avocado between ribbons, placing them at one end. Roll tightly to secure. (Assemble in batches if necessary.)",
      "secondary_message": null
    },
    {
      "id": 378551,
      "primary_message": "Divide cucumber rolls and slaw between plates. Serve with ginger mayo for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
