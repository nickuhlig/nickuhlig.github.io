  "instructions": [
    {
      "id": 361147,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 361148,
      "primary_message": "While the pan heats up, wash, dry, trim, and thinly slice celery crosswise. ",
      "secondary_message": "2 sticks celery"
    },
    {
      "id": 361149,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom; add celery and cook, stirring occasionally, until softened, 2-3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 361150,
      "primary_message": "Add broth, marinara, garam masala, and salt to the pan; stir to combine the soup and bring to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until flavors blend, 8-10 minutes.",
      "secondary_message": "473 ml chicken or vegetable broth\n½ (680 g) jar marinara sauce\n2 tsp garam masala\n¼ tsp salt"
    },
    {
      "id": 361151,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 361152,
      "primary_message": "Arrange naan on a baking sheet pan; place in the oven and broil, flipping once, until golden brown and toasted, 1-2 minutes.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 361153,
      "primary_message": "While the naan is toasting, slice peppers into strips. ",
      "secondary_message": "½ (340 g) jar roasted red bell peppers"
    },
    {
      "id": 361154,
      "primary_message": "Remove naan from oven and top with sliced peppers.",
      "secondary_message": null
    },
    {
      "id": 361155,
      "primary_message": "When the soup is almost done, return naan to the oven and broil until peppers are warmed through, 1-2 minutes. Remove from oven and cut into quarters. ",
      "secondary_message": null
    },
    {
      "id": 361156,
      "primary_message": "When the soup is done, wash and dry the spinach (skip this step if it came pre-washed). Add spinach to the pan in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat. ",
      "secondary_message": "½ (142 g) pkg baby spinach"
    },
    {
      "id": 361157,
      "primary_message": "Divide soup between bowls and serve with naan on the side. Enjoy!",
      "secondary_message": null
    }
  ],
