  "instructions": [
    {
      "id": 361181,
      "primary_message": "Wash, dry, trim, and thinly slice celery crosswise. ",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 361182,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 361183,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add celery and cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 361184,
      "primary_message": "Add broth, marinara, garam masala, and salt to the pot; stir to combine the soup and bring to a boil over medium-high heat. Once boiling, reduce heat to low and continue to cook, stirring occasionally, until flavors blend, 8-10 minutes.",
      "secondary_message": "1420 ml chicken or vegetable broth\n1 ½ (680 g) jars marinara sauce\n2 tbsp garam masala\n¾ tsp salt"
    },
    {
      "id": 361185,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 361186,
      "primary_message": "Divide naan between two large baking sheet pans; working in batches, place in the oven and broil, flipping once, until golden brown and toasted, 1-2 minutes.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 361187,
      "primary_message": "While the naan is toasting, slice peppers into strips. ",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers"
    },
    {
      "id": 361188,
      "primary_message": "Remove naan from oven and top with sliced peppers.",
      "secondary_message": null
    },
    {
      "id": 361189,
      "primary_message": "When the soup is almost done, working in batches, return naan to the oven and broil until peppers are warmed through, 1-2 minutes. Remove from oven and cut into quarters. ",
      "secondary_message": null
    },
    {
      "id": 361190,
      "primary_message": "When the soup is done, wash and dry the spinach (skip this step if it came pre-washed). Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Remove from heat. ",
      "secondary_message": "1 ½ (142 g) pkg baby spinach"
    },
    {
      "id": 361191,
      "primary_message": "Divide soup between bowls and serve with naan on the side. Enjoy!",
      "secondary_message": null
    }
  ],
