  "instructions": [
    {
      "id": 517737,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 517738,
      "primary_message": "Wash, dry, and halve each acorn squash lengthwise; trim ends, scrape out the seeds, and medium dice. Divide between two baking sheet pans. ",
      "secondary_message": "3 acorn squash"
    },
    {
      "id": 517739,
      "primary_message": "Peel, halve, and slice onions lengthwise into ¼-inch thick strips. Add to the baking sheets with the squash.",
      "secondary_message": "3 medium red onions"
    },
    {
      "id": 517740,
      "primary_message": "Peel and thinly slice garlic. Add to the baking sheets along with oil, maple syrup, and spices. Stir to combine and spread out in an even layer.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil\n3 tbsp pure maple syrup\n1 ½ tsp Italian seasoning\n¾ tsp sage, dried\n¾ tsp cinnamon, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 517741,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast until squash is starting to soften, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 517742,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat. Once the water is boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n425 g linguine pasta"
    },
    {
      "id": 517743,
      "primary_message": "While the pasta is cooking, crumble goat cheese into a small bowl. Set aside.",
      "secondary_message": "1 ½ (113 g) logs goat cheese"
    },
    {
      "id": 517744,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed). Place spinach in a colander and set aside.",
      "secondary_message": "1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 517745,
      "primary_message": "When the squash is starting to soften, remove from the oven. Add pumpkin seeds to the baking sheet, stir to combine, and spread back out in an even layer. Return to the oven and continue to roast until squash is fork-tender and golden, about 10 minutes. Remove from oven.",
      "secondary_message": "¾ cup pumpkin seeds"
    },
    {
      "id": 517746,
      "primary_message": "When the pasta is done, reserve ¾-cup of pasta water, then drain over the spinach in the colander. Return pasta, spinach, and reserved pasta water to the pot. Add goat cheese and stir until the pasta is creamy and combined.",
      "secondary_message": null
    },
    {
      "id": 517747,
      "primary_message": "To serve, divide pasta between plates or bowls, then top with roasted squash, onion, and pumpkin seeds. Enjoy!",
      "secondary_message": null
    }
  ],
