  "instructions": [
    {
      "id": 1,
      "primary_message": "Place cranberries, apple, sugar, orange juice, orange zest, and salt in workbowl of a food processor fitted with steel blade. Pulse until cranberries and apple are finely chopped, stopping to scrape down sides of bowl as necessary. Transfer to serving dish and serve immediately, or store in an airtight container in refrigerator for up to a week.",
      "secondary_message": null
