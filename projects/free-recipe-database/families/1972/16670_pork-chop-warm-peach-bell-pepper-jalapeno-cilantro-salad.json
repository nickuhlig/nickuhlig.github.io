  "instructions": [
    {
      "id": 272085,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lime\n½ small bunch cilantro\n1 jalapeño pepper\n1 red bell pepper\n2 peaches"
    },
    {
      "id": 272086,
      "primary_message": "Zest and juice lime into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 272087,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime along with oil, sugar, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp brown sugar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 272088,
      "primary_message": "Peel and thinly slice shallot; add to the bowl with the dressing. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 272089,
      "primary_message": "Thinly slice jalapeño into rounds and add to the bowl; stir to combine and set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 272090,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 272091,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 272092,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer chops to a clean plate and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 272093,
      "primary_message": "While the chops are cooking, trim, seed, and medium dice bell pepper. Place in a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 272094,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice and add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 272095,
      "primary_message": "Return the skillet (with cooking juices) to medium heat, add more oil, and swirl to coat the bottom. Add bell pepper and peaches; cook, stirring occasionally, until soft and lightly charred in spots, 3-4 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 272096,
      "primary_message": "When the bell pepper and peaches are done, transfer to the bowl with the dressing; stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 272097,
      "primary_message": "To serve, divide chops and peach salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
