  "instructions": [
    {
      "id": 272152,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n1 small bunch cilantro\n3 jalapeño peppers\n3 red bell peppers\n6 peaches"
    },
    {
      "id": 272153,
      "primary_message": "Zest and juice limes into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 272154,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime along with oil, sugar, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp brown sugar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 272155,
      "primary_message": "Peel, halve, and thinly slice onion; add to the bowl with the dressing. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 272156,
      "primary_message": "Thinly slice jalapeños into rounds and add to the bowl; stir to combine and set aside. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 272157,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 272158,
      "primary_message": "While the pot heats up, pat the pork chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "6 pork chops, bone-in\n1 ½ tsp salt\n1 ½ tsp black pepper"
    },
    {
      "id": 272159,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chops and pan-fry until golden brown and cooked through, 3-4 minutes per side. Transfer chops to a clean plate and loosely cover with aluminum foil. (Reserve pot for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 272160,
      "primary_message": "While the chops are cooking, trim, seed, and medium dice bell peppers. Place in another large bowl. ",
      "secondary_message": null
    },
    {
      "id": 272161,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice and add to the bowl with the bell pepper. ",
      "secondary_message": null
    },
    {
      "id": 272162,
      "primary_message": "Return the pot (with cooking juices) to medium heat, add more oil, and swirl to coat the bottom. Add bell pepper and peaches; cook, stirring occasionally, until soft and lightly charred in spots, 4-5 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 272163,
      "primary_message": "Meanwhile, roughly chop almonds. ",
      "secondary_message": "⅓ cup almonds"
    },
    {
      "id": 272164,
      "primary_message": "When the bell pepper and peaches are done, transfer to the bowl with the dressing; stir to combine the salad. ",
      "secondary_message": null
    },
    {
      "id": 272165,
      "primary_message": "To serve, divide chops and peach salad between plates. Sprinkle with almonds and enjoy! ",
      "secondary_message": null
    }
  ],
