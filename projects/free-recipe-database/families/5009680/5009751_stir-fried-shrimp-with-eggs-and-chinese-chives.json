  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the Chinese chives into 1-inch lengths. Mince the garlic. Mince the ginger.",
      "secondary_message": "57 g Chinese chives\n2 medium cloves garlic\n1 tsp ginger root"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, cover shrimp with cold water and stir in baking soda. Refrigerate for 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Drain and rinse shrimp under cold running water; pat dry with paper towels. Transfer shrimp to a small bowl and add 1 teaspoon oil, 1/4 teaspoon salt, and 1/4 teaspoon white pepper. Mix well.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a medium bowl, whisk together 4 eggs with milk, remaining 1/4 teaspoon white pepper, and remaining 1/4 teaspoon salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat 1 tablespoon oil in a wok over high heat until lightly smoking. Add shrimp and stir-fry for 1 minute. Add Chinese chives, garlic, and ginger and stir-fry until chives begin to wilt and shrimp are just cooked, about 1 minute longer. Transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Heat the remaining 1 tablespoon oil in the wok over high heat until lightly smoking. Add eggs, lower heat to medium, and cook without stirring until the bottom layer of egg has set, about 30 seconds. Using a spatula, scrape eggs from sides in towards middle of wok. Continue to cook, scraping eggs from sides in towards the middle, until some large fluffy curds have formed and eggs are about halfway cooked. Add shrimp and chives to eggs and gently stir until eggs are just slightly runny. Transfer to serving plate and serve immediately.",
      "secondary_message": null
    }
  ],
