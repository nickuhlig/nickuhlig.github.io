  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Remove the greens from the beets but skin left on. Juice the lemon. Pick the parsley leaves from the stems and chop them.",
      "secondary_message": "4 large beets\n1 lemon\n2 tbsp parsley"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 220°C (425°F). Line a baking sheet with foil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place beets on prepared baking sheet and roast until fork tender, about 1 hour.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Let beets cool. Peel beets and roughly chop.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "While beets are cooling, whisk together cinnamon, sugar, lemon juice, and olive oil in a large bowl. Add beets and stir to combine. Season with salt to taste.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Let beets rest in refrigerator for at least one hour. When ready to eat, take beets out of refrigerator and let come to room temperature. Sprinkle beets with parsley and serve.",
      "secondary_message": null
    }
  ],
