  "instructions": [
    {
      "id": 100010,
      "primary_message": "Wash and dry the spinach (skip this step if the spinach came pre-washed).",
      "secondary_message": "1 (142 g) pkg baby spinach"
    },
    {
      "id": 100011,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 100012,
      "primary_message": "Break the eggs into a medium bowl and add spices; whisk together.",
      "secondary_message": "8 eggs\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 100013,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom; add the spinach and cook, stirring constantly, until wilted, 1-2 minutes.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 100014,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 100015,
      "primary_message": "Finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 100016,
      "primary_message": "Remove the skillet from the heat. Sprinkle the eggs with the Parmesan; stir to combine.",
      "secondary_message": null
    },
    {
      "id": 100017,
      "primary_message": "Place tortillas on a flat surface and top with egg mixture. Tightly roll to close. Enjoy!",
      "secondary_message": "4 large flour tortillas"
    }
  ],
