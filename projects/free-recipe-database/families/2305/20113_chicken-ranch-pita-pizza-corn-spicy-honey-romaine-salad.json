  "instructions": [
    {
      "id": 422129,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 422130,
      "primary_message": "Place chickens on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a medium bowl, and set aside.",
      "secondary_message": "1 ½ (850 g) whole chickens rotisserie chicken, white and dark meat"
    },
    {
      "id": 422131,
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to defrost.",
      "secondary_message": "1 ½ cups frozen corn"
    },
    {
      "id": 422132,
      "primary_message": "Divide pitas between two baking sheet pans; spread evenly with dressing, then sprinkle with cheese.",
      "secondary_message": "6 whole grain pitas\n⅓ cup ranch dressing\n¾ cup shredded cheese, Italian blend"
    },
    {
      "id": 422133,
      "primary_message": "Top pitas with chicken, corn, and more cheese.",
      "secondary_message": "¾ cup shredded cheese, Italian blend"
    },
    {
      "id": 422134,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake until pita pizzas are golden and cheese is melted 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 422135,
      "primary_message": "Meanwhile, place honey and hot sauce in a clean small bowl; stir to combine and set aside.",
      "secondary_message": "2 tbsp honey\n2 tbsp hot sauce"
    },
    {
      "id": 422136,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ green bell peppers\n3 hearts romaine hearts\n1 small bunch cilantro"
    },
    {
      "id": 422137,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 422138,
      "primary_message": "Chop or tear romaine into bite-sized pieces; add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 422139,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with additional dressing and salt; toss to combine the salad.",
      "secondary_message": "⅓ cup ranch dressing\n3 pinch salt"
    },
    {
      "id": 422140,
      "primary_message": "When the pizzas are done, remove from oven and drizzle with spicy honey; cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 422141,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
