  "instructions": [
    {
      "id": 422103,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 422104,
      "primary_message": "Place chicken on a cutting board and, using your hands, remove meat from the skin and bones. Separate the meat into shred-like pieces, place in a small bowl, and set aside.",
      "secondary_message": "½ (850 g) whole chicken rotisserie chicken, white and dark meat"
    },
    {
      "id": 422105,
      "primary_message": "Place corn in a colander and run under hot water (from the tap) to defrost.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 422106,
      "primary_message": "Place pitas on a baking sheet pan; spread evenly with dressing, then sprinkle with cheese.",
      "secondary_message": "2 whole grain pitas\n2 tbsp ranch dressing\n¼ cup shredded cheese, Italian blend"
    },
    {
      "id": 422107,
      "primary_message": "Top pitas with chicken, corn, and more cheese.",
      "secondary_message": "¼ cup shredded cheese, Italian blend"
    },
    {
      "id": 422108,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until pita pizzas are golden and cheese is melted 6-8 minutes.",
      "secondary_message": null
    },
    {
      "id": 422109,
      "primary_message": "Meanwhile, place honey and hot sauce in a clean small bowl; stir to combine and set aside.",
      "secondary_message": "2 tsp honey\n2 tsp hot sauce"
    },
    {
      "id": 422110,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ green bell pepper\n1 heart romaine hearts\n½ small bunch cilantro"
    },
    {
      "id": 422111,
      "primary_message": "Trim, seed, and slice bell pepper lengthwise into thin strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 422112,
      "primary_message": "Chop or tear romaine into bite-sized pieces; add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 422113,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl along with additional dressing and salt; toss to combine the salad.",
      "secondary_message": "2 tbsp ranch dressing\n1 pinch salt"
    },
    {
      "id": 422114,
      "primary_message": "When the pizzas are done, remove from oven and drizzle with spicy honey; cut into wedges.",
      "secondary_message": null
    },
    {
      "id": 422115,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
