  "instructions": [
    {
      "id": 349606,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and turmeric, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth\n¾ tsp turmeric, ground"
    },
    {
      "id": 349607,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 ½ lemons\n1 small pkg fresh mint\n1 ½ English cucumbers\n3 tomatoes"
    },
    {
      "id": 349608,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 349609,
      "primary_message": "While the rice is cooking, peel, halve, and mince onions. Place half in a large bowl and half in a medium bowl (set medium bowl aside for the raita).",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 349610,
      "primary_message": "Peel and mince ginger and garlic; add both to the large bowl along with the chicken, bread crumbs, and spices. Using your hands, mix until well combined.",
      "secondary_message": "3 cloves garlic\n0.68 kg ground chicken\n⅓ cup panko bread crumbs\n1 tbsp garam masala\n1 tbsp curry powder\n1 ½ tsp salt"
    },
    {
      "id": 349611,
      "primary_message": "Using a ¼-cup measure, form the chicken mixture into 18 short, sausage-like shapes, approximately 4-inches long; place kofta on a large plate.",
      "secondary_message": null
    },
    {
      "id": 349612,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349613,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add kofta and pan-fry, rotating every 2-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a clean plate.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 349614,
      "primary_message": "Meanwhile, juice lemons into the medium bowl that was set aside for the raita.",
      "secondary_message": null
    },
    {
      "id": 349615,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349616,
      "primary_message": "Trim and small dice cucumbers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349617,
      "primary_message": "Small dice tomatoes; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349618,
      "primary_message": "Add yogurt, salt, and pepper to the bowl; stir to combine the raita. ",
      "secondary_message": "2 cups plain Greek yogurt\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 349619,
      "primary_message": "To serve, divide rice, kofta, and raita between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
