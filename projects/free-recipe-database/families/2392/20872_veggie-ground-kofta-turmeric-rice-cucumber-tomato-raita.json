  "instructions": [
    {
      "id": 349620,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and turmeric, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth\n¼ tsp turmeric, ground"
    },
    {
      "id": 349621,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n½ lemon\n½ small pkg fresh mint\n½ English cucumber\n1 tomato"
    },
    {
      "id": 349622,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 349623,
      "primary_message": "While the rice is cooking, peel, halve, and mince onion. Place half in a medium bowl and half in a small bowl (set small bowl aside for the raita).",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 349624,
      "primary_message": "Peel and mince ginger and garlic; add both to the medium bowl along with the veggie ground, bread crumbs, and spices. Using your hands, mix until well combined.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 clove garlic\n227 g veggie ground, plant based\n2 tbsp panko bread crumbs\n1 tsp garam masala\n1 tsp curry powder\n¼ tsp salt"
    },
    {
      "id": 349625,
      "primary_message": "Using a ¼-cup measure, form the veggie ground mixture into 4 short, sausage-like shapes, approximately 4-inches long; place \"kofta\" on a plate.",
      "secondary_message": null
    },
    {
      "id": 349626,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349627,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add kofta and pan-fry, rotating every 2-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 349628,
      "primary_message": "Meanwhile, juice lemon into the small bowl that was set aside for the raita.",
      "secondary_message": null
    },
    {
      "id": 349629,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349630,
      "primary_message": "Trim and small dice cucumber; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349631,
      "primary_message": "Small dice tomato; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349632,
      "primary_message": "Add yogurt, salt, and pepper to the bowl; stir to combine the raita. ",
      "secondary_message": "⅔ cup plain Greek yogurt\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 349633,
      "primary_message": "To serve, divide rice, kofta, and raita between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
