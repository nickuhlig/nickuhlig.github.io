  "instructions": [
    {
      "id": 349592,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and turmeric, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth\n½ tsp turmeric, ground"
    },
    {
      "id": 349593,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 (2 ½ cm) pieces ginger root\n1 lemon\n1 small pkg fresh mint\n1 English cucumber\n2 tomatoes"
    },
    {
      "id": 349594,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 349595,
      "primary_message": "While the rice is cooking, peel, halve, and mince onion. Divide between two medium bowls (set one bowl aside for the raita).",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 349596,
      "primary_message": "Peel and mince ginger and garlic; add both to the remaining bowl along with the chicken, bread crumbs, and spices. Using your hands, mix until well combined.",
      "secondary_message": "2 cloves garlic\n0.45 kg ground chicken\n¼ cup panko bread crumbs\n2 tsp garam masala\n2 tsp curry powder\n1 tsp salt"
    },
    {
      "id": 349597,
      "primary_message": "Using a ¼-cup measure, form the chicken mixture into 12 short, sausage-like shapes, approximately 4-inches long; place kofta on a plate.",
      "secondary_message": null
    },
    {
      "id": 349598,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349599,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add kofta and pan-fry, rotating every 2-3 minutes, until browned and cooked through, 10-12 minutes. Transfer to a clean plate.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 349600,
      "primary_message": "Meanwhile, juice lemon into the bowl that was set aside for the raita.",
      "secondary_message": null
    },
    {
      "id": 349601,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349602,
      "primary_message": "Trim and small dice cucumber; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349603,
      "primary_message": "Small dice tomatoes; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 349604,
      "primary_message": "Add yogurt, salt, and pepper to the bowl; stir to combine the raita. ",
      "secondary_message": "1 ⅓ cups plain Greek yogurt\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 349605,
      "primary_message": "To serve, divide rice, kofta, and raita between plates. Enjoy! ",
      "secondary_message": null
    }
  ],
