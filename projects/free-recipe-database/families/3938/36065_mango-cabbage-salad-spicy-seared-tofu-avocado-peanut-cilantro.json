  "instructions": [
    {
      "id": 566939,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 566940,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro\n1 small head red cabbage\n1 head butter (Boston) lettuce\n2 mangoes\n2 avocados"
    },
    {
      "id": 566941,
      "primary_message": "Juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 566942,
      "primary_message": "Peel and mince ginger. Add to the bowl with the lime juice along with soy sauce, maple syrup, and chili-garlic sauce, then whisk to combine. Set aside.",
      "secondary_message": "2 tbsp soy sauce\n2 tbsp pure maple syrup\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 566943,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 566944,
      "primary_message": "While the skillet heats up, cut the tofu planks in half, then cut each half into 2 triangles. Place in a large bowl, then sprinkle with cornstarch, salt, and pepper. Gently turn to coat.",
      "secondary_message": "2 tbsp cornstarch\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 566945,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, flipping halfway through, until golden and crispy, 6-8 minutes. Remove from heat. (Wipe the bowl clean with paper towels and reserve for next step.)",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 566946,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Place in the reserved bowl. (Set aside a small handful of cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 566947,
      "primary_message": "Add half of the sauce to the bowl with the cilantro, along with oil and vinegar, then whisk to combine the dressing. (Set remaining sauce aside for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp rice vinegar"
    },
    {
      "id": 566948,
      "primary_message": "Halve cabbage lengthwise, cut out the core, and slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 566949,
      "primary_message": "Chop or tear lettuce into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 566950,
      "primary_message": "Peel mangoes and slice flesh away from the pit, starting with the flat sides; cut into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 566951,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 566952,
      "primary_message": "Roughly chop peanuts. Add to the bowl and toss to combine the salad; set aside.",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    },
    {
      "id": 566953,
      "primary_message": "Add remaining sauce to the skillet with the tofu and gently toss to coat.",
      "secondary_message": null
    },
    {
      "id": 566954,
      "primary_message": "To serve, divide salad between plates or bowls, then top with tofu and reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
