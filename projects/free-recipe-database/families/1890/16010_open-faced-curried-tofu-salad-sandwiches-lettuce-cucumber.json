  "instructions": [
    {
      "id": 262757,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 262758,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n½ red bell pepper\n½ English cucumber\n½ head butter (Boston) lettuce"
    },
    {
      "id": 262759,
      "primary_message": "Place mayo, nutritional yeast, Dijon, vinegar, and spices in a medium bowl; stir to combine the creamy dressing.",
      "secondary_message": "¼ cup vegan mayonnaise\n⅛ cup nutritional yeast flakes\n½ tsp Dijon mustard\n½ tsp rice vinegar\n2 tsp curry powder\n¾ tsp salt\n½ tsp onion powder\n¼ tsp turmeric, ground\n¼ tsp black pepper"
    },
    {
      "id": 262760,
      "primary_message": "Crumble tofu with your fingers into the bowl with the dressing; using a fork, mash to combine the tofu mixture.",
      "secondary_message": null
    },
    {
      "id": 262761,
      "primary_message": "Peel, trim, and coarsely grate carrot; add to the bowl with the tofu mixture.",
      "secondary_message": null
    },
    {
      "id": 262762,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 262763,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl. Stir to combine the tofu salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 262764,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 262765,
      "primary_message": "Peel and mince garlic; place in a small bowl along with oil and salt. Stir to combine the garlic oil.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 262766,
      "primary_message": "Arrange bread on the baking sheet and drizzle with garlic oil. Place in the oven and broil until golden brown and toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 262767,
      "primary_message": "Meanwhile, trim and slice cucumber crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 262768,
      "primary_message": "Separate lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 262769,
      "primary_message": "To serve, divide toast between plates; top with lettuce, tofu salad, and cucumber slices. Season cucumber with salt and pepper. Enjoy!",
      "secondary_message": "1 pinch salt\n1 pinch black pepper"
    }
  ],
