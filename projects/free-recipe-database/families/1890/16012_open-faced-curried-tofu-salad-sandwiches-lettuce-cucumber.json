  "instructions": [
    {
      "id": 262783,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 262784,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n1 ½ red bell peppers\n1 ½ English cucumbers\n1 ½ heads butter (Boston) lettuce"
    },
    {
      "id": 262785,
      "primary_message": "Place mayo, nutritional yeast, Dijon, vinegar, and spices in a large bowl; stir to combine the creamy dressing.",
      "secondary_message": "¾ cup vegan mayonnaise\n⅓ cup nutritional yeast flakes\n1 ½ tsp Dijon mustard\n1 ½ tsp rice vinegar\n2 tbsp curry powder\n2 tsp salt\n1 ½ tsp onion powder\n¾ tsp turmeric, ground\n¾ tsp black pepper"
    },
    {
      "id": 262786,
      "primary_message": "Crumble tofu with your fingers into the bowl with the dressing; using a fork, mash to combine the tofu mixture.",
      "secondary_message": null
    },
    {
      "id": 262787,
      "primary_message": "Peel, trim, and coarsely grate carrots; add to the bowl with the tofu mixture.",
      "secondary_message": null
    },
    {
      "id": 262788,
      "primary_message": "Trim and small dice celery; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 262789,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. Stir to combine the tofu salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 262790,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 262791,
      "primary_message": "Peel and mince garlic; place in a small bowl along with oil and salt. Stir to combine the garlic oil.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 262792,
      "primary_message": "Divide bread between two baking sheets and drizzle with garlic oil. Working in batches, place in the oven and broil until golden brown and toasted, 1-2 minutes. Remove from oven.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 262793,
      "primary_message": "Meanwhile, trim and slice cucumbers crosswise into thin rounds.",
      "secondary_message": null
    },
    {
      "id": 262794,
      "primary_message": "Separate lettuce into leaves.",
      "secondary_message": null
    },
    {
      "id": 262795,
      "primary_message": "To serve, divide toast between plates; top with lettuce, tofu salad, and cucumber slices. Season cucumber with salt and pepper. Enjoy!",
      "secondary_message": "3 pinch salt\n3 pinch black pepper"
    }
  ],
