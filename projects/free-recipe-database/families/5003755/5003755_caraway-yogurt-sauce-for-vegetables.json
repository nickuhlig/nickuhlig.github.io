  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the thyme leaves from the stems and mince them. Zest the lemon.",
      "secondary_message": "½ tsp fresh thyme leaves\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Heat oil in a medium skillet over medium-high heat until shimmering. Add caraway and cook, stirring, until seeds sputter and smell toasty, about 30 seconds. Immediately add thyme and cook, stirring, until fragrant, about 30 seconds longer. Pour oil into a medium bowl and add yogurt. Stir in lemon zest and season with salt and pepper. Serve immediately or chill in the refrigerator before serving.",
      "secondary_message": null
    }
