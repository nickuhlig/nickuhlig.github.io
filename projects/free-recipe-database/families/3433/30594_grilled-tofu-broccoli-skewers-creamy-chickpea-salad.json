  "instructions": [
    {
      "id": 485831,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 485832,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 485833,
      "primary_message": "Place mayo, Dijon, vinegar, and spices in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "½ cup mayonnaise\n3 tbsp Dijon mustard\n2 tbsp white wine vinegar\n1 ½ tsp dill, dried\n¾ tsp curry powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 485834,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; small dice stems. Place florets in another large bowl and set aside for the skewers. Add stems to the bowl with the dressing.",
      "secondary_message": "3 crowns broccoli"
    },
    {
      "id": 485835,
      "primary_message": "Wash, dry, trim, and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 485836,
      "primary_message": "Drain and rinse chickpeas in a colander. Add to the bowl and stir to combine the chickpea salad. Set aside.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 485837,
      "primary_message": "Large dice tofu and add to the bowl with the broccoli florets. Drizzle with soy sauce and oil, then season with spices. Gently toss to coat.",
      "secondary_message": "3 tbsp soy sauce\n3 tbsp extra virgin olive oil\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 485838,
      "primary_message": "Thread tofu and broccoli onto skewers, alternating ingredients, and place on a plate. (If you don't have skewers, you can cook the tofu and broccoli directly on the grill pan.)",
      "secondary_message": null
    },
    {
      "id": 485839,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 485840,
      "primary_message": "Once the pan is hot, working in batches, add skewers and cook, turning occasionally, until tofu is warmed through and broccoli is tender-crisp, 8-10 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 485841,
      "primary_message": "To serve, divide chickpea salad and tofu-broccoli skewers between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
