  "instructions": [
    {
      "id": 102168,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n2 tomatoes\n1 lime\n½ head romaine lettuce\n1 avocado"
    },
    {
      "id": 102169,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 102170,
      "primary_message": "Seed and medium dice the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 102171,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 102172,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 102173,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 102174,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 102175,
      "primary_message": "Add onion, bell pepper, and garlic to the skillet; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 102176,
      "primary_message": "Add beans, corn, tomato sauce, and spices to the skillet, stirring to combine. Reduce heat to low and simmer for 15 minutes, stirring occasionally.",
      "secondary_message": "1 cup frozen corn\n1 (213 ml) can tomato sauce\n1 tsp chili powder\n1 tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 102177,
      "primary_message": "Meanwhile, halve and pit the avocado. Slice while still in the skin, then scoop out into a medium bowl; mash slightly with a fork.",
      "secondary_message": null
    },
    {
      "id": 102178,
      "primary_message": "Medium dice the tomatoes; place in the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 102179,
      "primary_message": "Juice lime into the bowl, add salt, and stir to combine.",
      "secondary_message": "¼ tsp salt"
    },
    {
      "id": 102180,
      "primary_message": "Separate whole leaves from the head of romaine for taco shells.",
      "secondary_message": null
    },
    {
      "id": 102181,
      "primary_message": "To serve, arrange romaine leaves on plates and fill with seasoned beans and veggies. Top with guacamole and enjoy!",
      "secondary_message": null
    }
  ],
