  "instructions": [
    {
      "id": 102138,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n4 tomatoes\n2 limes\n1 head romaine lettuce\n2 avocados"
    },
    {
      "id": 102139,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 102140,
      "primary_message": "Seed and medium dice the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 102141,
      "primary_message": "Peel and small dice the onion.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 102142,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 102143,
      "primary_message": "Peel and mince the garlic.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 102144,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 102145,
      "primary_message": "Add onion, bell pepper, and garlic to the skillet; cook, stirring occasionally, until softened, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 102146,
      "primary_message": "Grate mozzarella.",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 102147,
      "primary_message": "Add beans, corn, tomato sauce, and spices to the skillet, stirring to combine. Reduce heat to low and simmer for 15 minutes, stirring occasionally.",
      "secondary_message": "2 cups frozen corn\n2 (213 ml) cans tomato sauce\n2 tsp chili powder\n2 tsp cumin\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 102148,
      "primary_message": "Meanwhile, halve and pit the avocadoes. Slice while still in the skin, then scoop out into a medium bowl; mash slightly with a fork.",
      "secondary_message": null
    },
    {
      "id": 102149,
      "primary_message": "Medium dice the tomatoes; place in the bowl with the avocado.",
      "secondary_message": null
    },
    {
      "id": 102150,
      "primary_message": "Juice limes into the bowl, add salt, and stir to combine.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 102151,
      "primary_message": "Separate whole leaves from the head of romaine to use as taco shells.",
      "secondary_message": null
    },
    {
      "id": 102152,
      "primary_message": "To serve, arrange romaine leaves on plates and fill with seasoned beans and veggies. Top with guacamole and cheese. Enjoy!",
      "secondary_message": null
    }
  ],
