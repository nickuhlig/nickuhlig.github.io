  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n½ English cucumber\n1 lime"
    },
    {
      "primary_message": "Juice the lime into a small bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Place the steak in a shallow bowl and pierce with a fork in multiple places.",
      "secondary_message": "340 g striploin (New York strip) steak"
    },
    {
      "primary_message": "Pour ½ of the lime juice (save the rest for the salad dressing) and soy sauce over the steak; turn to coat. Set aside to marinate for 10 minutes.",
      "secondary_message": "2 tbsp tamari soy sauce"
    },
    {
      "primary_message": "Heat a grill pan or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the pan warms up, peel and mince the garlic.",
      "secondary_message": "1 clove garlic"
    },
    {
      "primary_message": "Coat the grill pan or skillet with coconut oil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "primary_message": "Pat the steak dry with paper towels, then place in the grill pan or skillet and cook until desired doneness, 2 to 5 minutes per side. Once done, transfer to a plate and loosely cover with foil.",
      "secondary_message": null
    },
    {
      "primary_message": "Add the minced garlic, sesame oil, rice vinegar, crushed red pepper, and salt to the remaining lime juice and whisk together.",
      "secondary_message": "2 tbsp toasted sesame oil\n2 tbsp rice vinegar\n⅛ tsp crushed red pepper\n¼ tsp salt"
    },
    {
      "primary_message": "Cut out and discard the tough core of the cabbage; thinly slice the cabbage crosswise and transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and discard the ends of the cucumber; halve the cucumber lengthwise, then thinly slice crosswise on an angle. Add to the cabbage.",
      "secondary_message": null
    },
    {
      "primary_message": "Pour the dressing over the salad; toss until well combined.",
      "secondary_message": null
    },
    {
      "primary_message": "Measure out the peanuts into a small bowl.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "primary_message": "Slice the steak against the grain.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange the salad on a plate, place the steak slices on the side, and sprinkle with the peanuts. Enjoy!",
      "secondary_message": null
    }
  ],
