  "instructions": [
    {
      "id": 173500,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "½ (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 173501,
      "primary_message": "Wash the spinach (skip if it came pre-washed) and roughly chop.",
      "secondary_message": "½ (5 oz) pkg baby spinach"
    },
    {
      "id": 173502,
      "primary_message": "Preheat a large nonstick skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 173503,
      "primary_message": "Crack the eggs into a medium bowl and season with salt and pepper; whisk together.",
      "secondary_message": "3 eggs\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 173504,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 173505,
      "primary_message": "Add spinach to the skillet and season with salt and pepper; cook, tossing frequently, until the spinach has wilted, 1-2 minutes.",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 173506,
      "primary_message": "Add beans to the skillet and stir to combine; add the egg mixture. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan; cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 173507,
      "primary_message": "Grate cheese.",
      "secondary_message": "⅛ (8 oz) block cheddar cheese"
    },
    {
      "id": 173508,
      "primary_message": "To assemble the quesadillas, lay the tortillas on a flat surface and divide cheese and egg mixture between them, arranging it on one half of the tortilla; fold in half.",
      "secondary_message": "2 large flour tortillas"
    },
    {
      "id": 173509,
      "primary_message": "Wipe skillet clean and return to heat, drizzle with oil, and lay the assembled quesadillas in the pan. Cook until golden on both sides, 5-6 minutes, turning halfway through.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 173510,
      "primary_message": "To serve, cut quesadillas into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
