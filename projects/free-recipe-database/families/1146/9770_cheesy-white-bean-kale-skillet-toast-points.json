  "instructions": [
    {
      "id": 156036,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 156037,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 156038,
      "primary_message": "Wash and dry kale. Fold leaves in half lengthwise, slice off stems, and finely chop leaves. ",
      "secondary_message": "½ bunch kale"
    },
    {
      "id": 156039,
      "primary_message": "Peel and thinly slice garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 156040,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 156041,
      "primary_message": "Grate cheese and set aside.",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 156042,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add kale, garlic, and tomato paste; cook, stirring constantly, until kale softens, 2-3 minutes. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tbsp tomato paste"
    },
    {
      "id": 156043,
      "primary_message": "Add beans, hot water (from the tap), and spices to the skillet; stir to combine. Bring to a boil, then sprinkle with cheese and place in the oven; broil until cheese has melted and is browned in spots, 3-4 minutes. Remove from the oven.",
      "secondary_message": "½ cup water\n½ tsp salt\n¼ tsp black pepper\n¼ tsp Italian seasoning\n¼ tsp onion powder"
    },
    {
      "id": 156044,
      "primary_message": "Meanwhile, cut bread slices on the diagonal and place on a baking sheet pan in a single layer; drizzle with oil on both sides. ",
      "secondary_message": "2 slices whole grain bread\n1 tsp extra virgin olive oil"
    },
    {
      "id": 156045,
      "primary_message": "Place bread in the oven and broil, flipping halfway through, until nicely toasted, 2-3 minutes. Remove from the oven. ",
      "secondary_message": null
    },
    {
      "id": 156046,
      "primary_message": "Divide white bean mixture between plates or bowls. Serve with toast for dipping. Enjoy!",
      "secondary_message": null
    }
  ],
