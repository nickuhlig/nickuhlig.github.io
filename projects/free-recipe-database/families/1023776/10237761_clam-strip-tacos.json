  "instructions": [
    {
      "primary_message": "Cook clams and French fries according to package directions.",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat the oven to 425 degrees F. Invert a 12 cup muffin pan and lightly coat with nonstick cooking spray. Place 4 tortillas in between muffin cups to create \"V” shaped tacos. Add cheese, French fries and clams to each taco.",
      "secondary_message": null
    },
    {
      "primary_message": "Heat for 2-3 minutes in the oven until the cheese is melted. Repeat with remaining tortillas and ingredients. Top with tartar sauce and cabbage. Serve.",
      "secondary_message": null
    }
