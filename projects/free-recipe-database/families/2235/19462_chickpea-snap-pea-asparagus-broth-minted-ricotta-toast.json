  "instructions": [
    {
      "id": 319704,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (8 oz) pkg sugar snap peas\n3 small bunches asparagus\n1 ½ lemons\n1 small pkg fresh mint"
    },
    {
      "id": 319705,
      "primary_message": "Peel, halve, and small dice onions; place in a large bowl. ",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 319706,
      "primary_message": "Halve snap peas crosswise. Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces. Add both to the bowl with the onion and set aside. ",
      "secondary_message": null
    },
    {
      "id": 319707,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 319708,
      "primary_message": "While the pot heats up, drain and rinse chickpeas.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 319709,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add chickpeas and cook, stirring occasionally, until golden, 5-6 minutes. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 319710,
      "primary_message": "When the chickpeas are done, add veggies to the pot and cook, stirring occasionally, until starting to soften, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 319711,
      "primary_message": "When the veggies are soft, add broth and spices to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, about 5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "96 fl oz (12 cups) chicken or vegetable broth\n2 ½ tsp thyme, dried\n2 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 319712,
      "primary_message": "Meanwhile, cut lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 319713,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl along with ricotta, salt, and pepper; stir to combine.",
      "secondary_message": "1 ½ (15 oz) pkg ricotta cheese\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 319714,
      "primary_message": "Toast bread if desired; spread with half of the minted ricotta (reserve remaining minted ricotta for the soup).",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 319715,
      "primary_message": "When the soup is done, add the remaining minted ricotta, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 319716,
      "primary_message": "Divide soup between bowls; serve with lemon wedges and toast on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
