  "instructions": [
    {
      "id": 319795,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (227 g) pkg sugar snap peas\n1 small bunch asparagus\n½ lemon\n½ small pkg fresh mint"
    },
    {
      "id": 319796,
      "primary_message": "Peel, halve, and small dice onion; place in a medium bowl. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 319797,
      "primary_message": "Halve snap peas crosswise. Snap (or cut) off woody ends of the asparagus; cut spears into 1-inch pieces. Add both to the bowl with the onion and set aside. ",
      "secondary_message": null
    },
    {
      "id": 319798,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 319799,
      "primary_message": "While the pan heats up, small dice bacon. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 319800,
      "primary_message": "Once the pan is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 319801,
      "primary_message": "When the bacon is done, add veggies to the pan and cook, stirring occasionally, until starting to soften, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 319802,
      "primary_message": "Add broth and spices to the pan; stir to combine the soup and bring to a boil. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, about 5 minutes. (Reserve bowl for later use.)",
      "secondary_message": "946 ml chicken or vegetable broth\n¾ tsp thyme, dried\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 319803,
      "primary_message": "Meanwhile, using a clean cutting board, cut lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 319804,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl along with ricotta, salt, and pepper; stir to combine.",
      "secondary_message": "½ (425 g) pkg ricotta cheese\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 319805,
      "primary_message": "Toast bread if desired; spread with half of the minted ricotta (reserve remaining minted ricotta for the soup).",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 319806,
      "primary_message": "When the soup is done, add the remaining minted ricotta, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 319807,
      "primary_message": "Divide soup between bowls; serve with lemon wedges and toast on the side. Enjoy! ",
      "secondary_message": null
    }
  ],
