  "instructions": [
    {
      "id": 355491,
      "primary_message": "If using wooden skewers, place 12-18 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 355492,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n1 ½ small pineapples\n1 ½ limes\n3 (1 inch) pieces ginger root\n1 head butter (Boston) lettuce"
    },
    {
      "id": 355493,
      "primary_message": "Trim zucchini and cut crosswise into 1-inch rounds. Peel, halve, and cut onions lengthwise into 1-inch wide wedges; place both in a large bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 355494,
      "primary_message": "Cut off skin from each pineapple, halve, and remove the core. Cut a portion of the pineapple into 12 thin slices to place on top of the burgers; set aside for serving. Large dice remaining pineapples and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 355495,
      "primary_message": "Zest limes into the bowl with the veggies and pineapple (set limes aside for later); drizzle with oil, season with salt, and toss to combine.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 355496,
      "primary_message": "Thread veggies and pineapple onto skewers and place on a plate; alternatively, you can cook the veggies and pineapple directly on the grill pan. (Reserve the bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 355497,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355498,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, place skewers on the grill and cook, turning occasionally, until the veggies are charred and tender, 4-5 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 355499,
      "primary_message": "Meanwhile, peel and mince garlic and ginger; add both to the reserved bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 355500,
      "primary_message": "Add pork, coconut aminos, salt, and pepper to the bowl with the garlic and ginger; use your hands to thoroughly combine. Form into 6 equal-sized patties and place on a plate.",
      "secondary_message": "2 ¼ lb lean ground pork\n1 tbsp coconut aminos\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 355501,
      "primary_message": "When the skewers are done, coat the grill with oil. Working in batches if necessary, place burger patties on the grill and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 355502,
      "primary_message": "While the burgers are cooking, cut reserved limes into wedges.",
      "secondary_message": null
    },
    {
      "id": 355503,
      "primary_message": "Separate the lettuce into leaves and layer one leaf on top of another to create 6 stacks.",
      "secondary_message": null
    },
    {
      "id": 355504,
      "primary_message": "To serve, divide lettuce stacks between plates; top with burgers, mayo, and two slices of pineapple. Place skewers on the side, squeeze with lime, and enjoy!",
      "secondary_message": "3 tbsp mayonnaise"
    }
  ],
