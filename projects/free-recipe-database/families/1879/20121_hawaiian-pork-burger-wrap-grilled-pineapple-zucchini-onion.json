  "instructions": [
    {
      "id": 355477,
      "primary_message": "If using wooden skewers, place 8-12 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 355478,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 small pineapple\n1 lime\n2 (1 inch) pieces ginger root\n1 head butter (Boston) lettuce"
    },
    {
      "id": 355479,
      "primary_message": "Trim zucchini and cut crosswise into 1-inch rounds. Peel, halve, and cut onion lengthwise into 1-inch wide wedges; place both in a medium bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 355480,
      "primary_message": "Cut off skin from pineapple, halve, and remove the core. Cut a portion of the pineapple into 8 thin slices to place on top of the burgers; set aside for serving. Large dice remaining pineapple and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 355481,
      "primary_message": "Zest lime into the bowl with the veggies and pineapple (set lime aside for later); drizzle with oil, season with salt, and toss to combine.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 355482,
      "primary_message": "Thread veggies and pineapple onto skewers and place on a plate; alternatively, you can cook the veggies and pineapple directly on the grill pan. (Reserve the bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 355483,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355484,
      "primary_message": "Once the grill pan is hot, working in batches if necessary, place skewers on the grill and cook, turning occasionally, until the veggies are charred and tender, 4-5 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 355485,
      "primary_message": "Meanwhile, peel and mince garlic and ginger; add both to the reserved bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 355486,
      "primary_message": "Add pork, coconut aminos, salt, and pepper to the bowl with the garlic and ginger; use your hands to thoroughly combine. Form into 4 equal-sized patties and place on a plate.",
      "secondary_message": "1 ½ lb lean ground pork\n2 tsp coconut aminos\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 355487,
      "primary_message": "When the skewers are done, coat the grill with oil. Place burger patties on the grill and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 355488,
      "primary_message": "While the burgers are cooking, cut reserved lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 355489,
      "primary_message": "Separate the lettuce into leaves and layer one leaf on top of another to create 4 stacks.",
      "secondary_message": null
    },
    {
      "id": 355490,
      "primary_message": "To serve, divide lettuce stacks between plates; top with burgers, mayo, and two slices of pineapple. Place skewers on the side, squeeze with lime, and enjoy!",
      "secondary_message": "2 tbsp mayonnaise"
    }
  ],
