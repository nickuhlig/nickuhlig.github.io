  "instructions": [
    {
      "id": 355376,
      "primary_message": "If using wooden skewers, place 4-6 skewers in a shallow dish of water to soak until you are ready to use them.",
      "secondary_message": null
    },
    {
      "id": 355377,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n½ small pineapple\n½ lime\n1 (1 inch) piece ginger root"
    },
    {
      "id": 355378,
      "primary_message": "Trim zucchini and cut crosswise into 1-inch rounds. Peel, halve, and cut onion lengthwise into 1-inch wide wedges; place both in a medium bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 355379,
      "primary_message": "Cut off skin from pineapple, halve, and remove the core. Cut a portion of the pineapple into 4 thin slices to place on top of the burgers; set aside for serving. Large dice remaining pineapple and add to the bowl with the veggies.",
      "secondary_message": null
    },
    {
      "id": 355380,
      "primary_message": "Zest lime into the bowl with the veggies and pineapple (set lime aside for later); drizzle with oil, season with salt, and toss to combine.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 355381,
      "primary_message": "Thread veggies and pineapple onto skewers and place on a plate; alternatively, you can cook the veggies and pineapple directly on the grill pan. (Reserve the bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 355382,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 355383,
      "primary_message": "Once the grill pan is hot, add skewers and cook, turning occasionally, until the veggies are charred and tender, 4-5 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 355384,
      "primary_message": "Meanwhile, peel and mince garlic and ginger; place both in the reserved bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 355385,
      "primary_message": "Add pork, bread crumbs, soy sauce, salt, and pepper to the bowl with the garlic and ginger; use your hands to thoroughly combine. Form into 2 equal-sized patties and place on a plate.",
      "secondary_message": "¾ lb lean ground pork\n2 tbsp panko bread crumbs\n1 tsp soy sauce\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 355386,
      "primary_message": "When the skewers are done, coat the grill with oil. Place burger patties on the grill and cook, undisturbed, for 5 minutes; flip patties, and grill an additional 3-4 minutes, until cooked through. Once done, transfer to a clean plate.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 355387,
      "primary_message": "While the burgers are cooking, cut reserved lime into wedges.",
      "secondary_message": null
    },
    {
      "id": 355388,
      "primary_message": "Toast buns on the grill (if desired).",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 355389,
      "primary_message": "Spread mayo over the bottom half of each bun; top with a pork burger and two slices of pineapple. Close with the top half of each bun.",
      "secondary_message": "1 tbsp mayonnaise"
    },
    {
      "id": 355390,
      "primary_message": "To serve, divide burgers and skewers between plates. Squeeze lime over the skewers and enjoy!",
      "secondary_message": null
    }
  ],
