  "instructions": [
    {
      "id": 1,
      "primary_message": "In an electric spice grinder or high-power blender, combine coconut, lime leaves, sugar, chili powder, lemongrass, powdered ginger, garlic powder, and lime zest and blend until a fine powder forms.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While chips are still hot and fresh from the oil, and working in batches if necessary, set in a large paper-towel-lined bowl and sprinkle coconut mixture all over. Season with salt and pepper. Using clean hands, toss to coat chips evenly, then transfer to a serving bowl. Cooled chips can be stored in a zipper-lock bag or airtight container for up to 2 days.",
      "secondary_message": null
    }
  ],
