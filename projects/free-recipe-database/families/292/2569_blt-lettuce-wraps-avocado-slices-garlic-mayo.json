  "instructions": [
    {
      "id": 24924,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 24925,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ pint grape tomatoes\r\n1 avocado\r\n1 head butter (Boston) lettuce"
    },
    {
      "id": 24926,
      "primary_message": "Place 4-6 slices of bacon in the skillet and cook until crispy, 3-4 minutes per side. Transfer to a plate and repeat with the remaining bacon.",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 24927,
      "primary_message": "Halve and thinly slice the tomatoes; transfer to a small bowl. Halve and pit the avocado; slice crosswise while still in the skin then scoop out with a spoon into a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 24928,
      "primary_message": "Peel and mince the garlic. In another small bowl, mix together the minced garlic, mayo, salt, and pepper.",
      "secondary_message": "1 clove garlic\r\n2 tbsp mayonnaise\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 24929,
      "primary_message": "Chop or crumble the bacon into smaller pieces.",
      "secondary_message": ""
    },
    {
      "id": 24930,
      "primary_message": "To serve, grab a couple lettuce leaves, spread some mayo overtop, then add tomatoes, avocado, and bacon. Enjoy!",
      "secondary_message": ""
    }
  ],
