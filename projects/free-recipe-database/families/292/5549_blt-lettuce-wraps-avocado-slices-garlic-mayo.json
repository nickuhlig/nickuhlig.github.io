  "instructions": [
    {
      "id": 66468,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 66467,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkg grape tomatoes\n3 avocados\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 66466,
      "primary_message": "Place 4-6 slices of bacon in the skillet and cook until crispy, 3-4 minutes per side. Transfer to a plate and repeat with the remaining bacon.",
      "secondary_message": "24 slices bacon"
    },
    {
      "id": 66465,
      "primary_message": "Halve and thinly slice the tomatoes; transfer to a medium bowl. Halve and pit the avocados; slice crosswise while still in the skin then scoop out with a spoon into a medium bowl.",
      "secondary_message": ""
    },
    {
      "id": 66464,
      "primary_message": "Peel and mince the garlic. In another small bowl, mix together the minced garlic, mayo, salt, and pepper.",
      "secondary_message": "3 cloves garlic\n6 tbsp avocado oil mayonnaise\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 66463,
      "primary_message": "Chop or crumble the bacon into smaller pieces.",
      "secondary_message": ""
    },
    {
      "id": 66462,
      "primary_message": "To serve, grab a couple lettuce leaves, spread some mayo overtop, then add tomatoes, avocado, and bacon. Enjoy!",
      "secondary_message": ""
    }
  ],
