  "instructions": [
    {
      "id": 505623,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 505624,
      "primary_message": "Split muffins and arrange on a baking sheet pan. Place in the oven and broil, flipping halfway through, until golden brown and toasted, about 2 minutes; remove from oven. (Keep oven on for later use.)",
      "secondary_message": "2 English muffins"
    },
    {
      "id": 505625,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 stick celery\n½ lime\n1 Gala apple\n2 plums\n½ (170 g) pkg blueberries"
    },
    {
      "id": 505626,
      "primary_message": "Trim and small dice celery. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 505627,
      "primary_message": "Peel and mince shallot. Add to the bowl with the celery.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 505628,
      "primary_message": "Drain tuna and flake with a fork. Add to the bowl along with mayo, Dijon, salt, and pepper. Stir to combine the tuna salad and set aside.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water\n3 tbsp mayonnaise\n2 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 505629,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 505630,
      "primary_message": "Arrange muffin halves cut-side up, then top with tuna salad and cheese. Return baking sheet to the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 505631,
      "primary_message": "Meanwhile, juice lime into a clean medium bowl; add yogurt, poppy seeds, and sugar. Whisk to combine the dressing.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tsp poppy seeds\n1 tsp brown sugar"
    },
    {
      "id": 505632,
      "primary_message": "Quarter, core, and medium dice apple; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 505633,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Medium dice and add to the bowl along with the blueberries. Stir to combine the fruit salad.",
      "secondary_message": null
    },
    {
      "id": 505634,
      "primary_message": "To serve, divide tuna melts and fruit salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
