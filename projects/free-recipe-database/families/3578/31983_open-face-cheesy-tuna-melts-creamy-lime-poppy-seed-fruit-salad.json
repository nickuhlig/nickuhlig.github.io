  "instructions": [
    {
      "id": 505611,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 505612,
      "primary_message": "Split muffins and arrange on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until golden brown and toasted, about 2 minutes; remove from oven. (Keep oven on for later use.)",
      "secondary_message": "6 English muffins"
    },
    {
      "id": 505613,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 sticks celery\n1 ½ limes\n3 Gala apples\n6 plums\n1 ½ (6 oz) pkgs blueberries"
    },
    {
      "id": 505614,
      "primary_message": "Trim and small dice celery. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 505615,
      "primary_message": "Peel and mince shallot. Add to the bowl with the celery.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 505616,
      "primary_message": "Drain tuna and flake with a fork. Add to the bowl along with mayo, Dijon, salt, and pepper. Stir to combine the tuna salad and set aside.",
      "secondary_message": "6 (6 oz) cans chunk light tuna in water\n½ cup mayonnaise\n2 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 505617,
      "primary_message": "Thinly slice cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 505618,
      "primary_message": "Arrange muffin halves cut-side up, then top with tuna salad and cheese. Return baking sheet to the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 505619,
      "primary_message": "Meanwhile, juice limes into a clean medium bowl; add yogurt, poppy seeds, and sugar. Whisk to combine the dressing.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 tbsp poppy seeds\n1 tbsp brown sugar"
    },
    {
      "id": 505620,
      "primary_message": "Quarter, core, and medium dice apples; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 505621,
      "primary_message": "Halve plums lengthwise (around the pit); twist halves to separate, then remove and discard pits. Medium dice and add to the bowl along with the blueberries. Stir to combine the fruit salad.",
      "secondary_message": null
    },
    {
      "id": 505622,
      "primary_message": "To serve, divide tuna melts and fruit salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
