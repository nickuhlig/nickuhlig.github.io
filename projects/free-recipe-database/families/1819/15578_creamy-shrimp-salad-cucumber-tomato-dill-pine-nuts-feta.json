  "instructions": [
    {
      "id": 256438,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n½ small bunch fresh dill\n½ English cucumber\n½ pint grape tomatoes\n1 head butter (Boston) lettuce"
    },
    {
      "id": 256439,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Set aside.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 256440,
      "primary_message": "Zest and juice half the lemon into a medium saucepan (zest and juice remaining lemon into a medium bowl and set aside).",
      "secondary_message": null
    },
    {
      "id": 256441,
      "primary_message": "Add water, vinegar, and salt to the pan with the lemon zest and juice. Cover the pan and bring the liquid to a boil over high heat.",
      "secondary_message": "3 cup water\n½ cup rice vinegar\n1 tbsp salt"
    },
    {
      "id": 256442,
      "primary_message": "Once the liquid in the saucepan is boiling, uncover, add shrimp, and stir for a few seconds. Remove from heat, and let sit until cooked through, about 3 minutes. Using a slotted spoon, transfer shrimp to another medium bowl and place in the refrigerator to cool, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 256443,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon zest and juice.",
      "secondary_message": null
    },
    {
      "id": 256444,
      "primary_message": "Add cream, salt, and pepper to the bowl and whisk to combine the dressing.",
      "secondary_message": "4 fl oz (½ cup) heavy whipping cream\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 256445,
      "primary_message": "Trim and halve cucumber lengthwise, then thinly slice into half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 256446,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256447,
      "primary_message": "Remove shrimp from the refrigerator and add to the bowl with the dressing and veggies; stir to combine the shrimp salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 256448,
      "primary_message": "Chop or tear lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 256449,
      "primary_message": "To serve, divide lettuce between plates or bowls and drizzle with oil. Top with shrimp salad, pine nuts, and feta. Enjoy!",
      "secondary_message": "1 tbsp extra virgin olive oil\n⅛ cup pine nuts\n½ (4 oz) pkg crumbled feta cheese"
    }
  ],
