  "instructions": [
    {
      "id": 256498,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 small bunch fresh dill\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 256499,
      "primary_message": "If using frozen shrimp, place them in a colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Set aside.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 256500,
      "primary_message": "Zest and juice half the lemons into a large pot (zest and juice remaining lemons into a large bowl and set aside).",
      "secondary_message": null
    },
    {
      "id": 256501,
      "primary_message": "Add water, vinegar, and salt to the pot with the lemon zest and juice. Cover the pot and bring the liquid to a boil over high heat.",
      "secondary_message": "9 cup water\n1 ½ cup rice vinegar\n3 tbsp salt"
    },
    {
      "id": 256502,
      "primary_message": "Once the liquid in the pot is boiling, uncover, add shrimp, and stir for a few seconds. Remove from heat, and let sit until cooked through, about 4 minutes. Using a slotted spoon, transfer shrimp to another large bowl and place in the refrigerator to cool, 12-14 minutes.",
      "secondary_message": null
    },
    {
      "id": 256503,
      "primary_message": "Meanwhile, using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon zest and juice.",
      "secondary_message": null
    },
    {
      "id": 256504,
      "primary_message": "Add cream, salt, and pepper to the bowl and whisk to combine the dressing.",
      "secondary_message": "355 ml heavy whipping cream\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 256505,
      "primary_message": "Trim and halve cucumbers lengthwise, then thinly slice into half-moons. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 256506,
      "primary_message": "Halve tomatoes and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 256507,
      "primary_message": "Remove shrimp from the refrigerator and add to the bowl with the dressing and veggies; stir to combine the shrimp salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 256508,
      "primary_message": "Chop or tear lettuce into bite-sized pieces.",
      "secondary_message": null
    },
    {
      "id": 256509,
      "primary_message": "To serve, divide lettuce between plates or bowls and drizzle with oil. Top with shrimp salad, pine nuts, and feta. Enjoy!",
      "secondary_message": "3 tbsp extra virgin olive oil\n⅓ cup pine nuts\n1 ½ (113 g) pkg crumbled feta cheese"
    }
  ],
