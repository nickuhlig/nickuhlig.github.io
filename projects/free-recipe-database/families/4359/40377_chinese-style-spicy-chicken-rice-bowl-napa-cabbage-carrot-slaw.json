  "instructions": [
    {
      "id": 625281,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n237 ml chicken or vegetable broth"
    },
    {
      "id": 625282,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ medium head napa cabbage\n2 medium carrots\n½ small bunch green onions (scallions)"
    },
    {
      "id": 625283,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 625284,
      "primary_message": "While the rice is cooking, place vinegar, sugar, and salt in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp rice vinegar\n1 tsp brown sugar\n½ tsp salt"
    },
    {
      "id": 625285,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 625286,
      "primary_message": "Peel, trim, and using a julienne (or regular) peeler, peel carrots into thin noodle-like sticks. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 625287,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl, toss to combine the slaw, and set aside. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 625288,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 625289,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and large dice. Season with salt and pepper.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 625290,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden brown and cooked through, 6-7 minutes.",
      "secondary_message": "1 tsp neutral vegetable oil"
    },
    {
      "id": 625291,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and vinegar in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "¼ cup mayonnaise\n1 tbsp chili-garlic sauce\n1 tsp rice vinegar"
    },
    {
      "id": 625292,
      "primary_message": "When the chicken is done, add sauce to the skillet and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 625293,
      "primary_message": "To serve, divide rice, chicken, and slaw between bowls, then top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
