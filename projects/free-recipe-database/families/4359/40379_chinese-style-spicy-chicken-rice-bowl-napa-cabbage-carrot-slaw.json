  "instructions": [
    {
      "id": 625307,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 625308,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads napa cabbage\n6 medium carrots\n1 small bunch green onions (scallions)"
    },
    {
      "id": 625309,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 625310,
      "primary_message": "While the rice is cooking, place vinegar, sugar, and salt in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup rice vinegar\n1 tbsp brown sugar\n1 ½ tsp salt"
    },
    {
      "id": 625311,
      "primary_message": "Trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 625312,
      "primary_message": "Peel, trim, and using a julienne (or regular) peeler, peel carrots into thin noodle-like sticks. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 625313,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl, toss to combine the slaw, and set aside. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 625314,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 625315,
      "primary_message": "While the skillet heats up, pat the chicken dry with paper towels and large dice. Season with salt and pepper.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 625316,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook, stirring occasionally, until golden brown and cooked through, 7-8 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 625317,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and vinegar in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "¾ cup mayonnaise\n3 tbsp chili-garlic sauce\n1 tbsp rice vinegar"
    },
    {
      "id": 625318,
      "primary_message": "When the chicken is done, add sauce to the skillet and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 625319,
      "primary_message": "To serve, divide rice, chicken, and slaw between bowls, then top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
