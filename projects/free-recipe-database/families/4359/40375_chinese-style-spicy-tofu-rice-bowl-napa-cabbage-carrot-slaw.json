  "instructions": [
    {
      "id": 625253,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 625254,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n16 fl oz (2 cups) chicken or vegetable broth"
    },
    {
      "id": 625255,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 medium head napa cabbage\n4 medium carrots\n1 small bunch green onions (scallions)"
    },
    {
      "id": 625256,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 625257,
      "primary_message": "While the rice is cooking, place vinegar, sugar, and salt in a medium bowl. Whisk to combine the dressing.",
      "secondary_message": "¼ cup rice vinegar\n2 tsp brown sugar\n1 tsp salt"
    },
    {
      "id": 625258,
      "primary_message": "Trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 625259,
      "primary_message": "Peel, trim, and using a julienne (or regular) peeler, peel carrots into thin noodle-like sticks. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 625260,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add half to the bowl, toss to combine the slaw, and set aside. (Reserve remaining green onions for serving.)",
      "secondary_message": null
    },
    {
      "id": 625261,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 625262,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in another medium bowl, then sprinkle with cornstarch, salt, and pepper. Gently toss to coat.",
      "secondary_message": "2 tbsp cornstarch\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 625263,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning occasionally, until browned and crispy, 5-7 minutes.",
      "secondary_message": "4 tsp neutral vegetable oil"
    },
    {
      "id": 625264,
      "primary_message": "Meanwhile, place mayo, chili-garlic sauce, and vinegar in a small bowl. Whisk to combine the sauce.",
      "secondary_message": "½ cup mayonnaise\n2 tbsp chili-garlic sauce\n2 tsp rice vinegar"
    },
    {
      "id": 625265,
      "primary_message": "When the tofu is done, add sauce to the skillet and stir to combine. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 625266,
      "primary_message": "To serve, divide rice, tofu, and slaw between bowls, then top with reserved green onions. Enjoy!",
      "secondary_message": null
    }
  ],
