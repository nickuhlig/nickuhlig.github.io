  "instructions": [
    {
      "id": 242580,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 242581,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lb cremini mushrooms\n1 jalapeño pepper\n1 orange bell pepper\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 242582,
      "primary_message": "Thinly slice mushrooms and transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 242583,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242584,
      "primary_message": "While the skillet heats up, slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 242585,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage and cook, stirring occasionally, until starting to brown, about 4 minutes (or cook sausages according to package instructions). Use a slotted spoon to transfer the sausage to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 242586,
      "primary_message": "Meanwhile, peel and mince garlic; peel and medium dice onion. Add both to the bowl with the mushrooms.",
      "secondary_message": "1 clove garlic\n½ medium yellow onion"
    },
    {
      "id": 242587,
      "primary_message": "Return skillet (with cooking juices) to medium-high heat; add veggies and Italian seasoning. Cook, stirring occasionally, until the mushrooms have softened, about 6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tsp Italian seasoning"
    },
    {
      "id": 242588,
      "primary_message": "While the mushrooms are cooking, quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Finely dice and place in the reserved bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 242589,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 242590,
      "primary_message": "Add jalapeño, bell pepper, browned sausage, salt, and pepper to the skillet; cook, stirring occasionally, until the bell pepper starts to soften, about 4 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 242591,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 242592,
      "primary_message": "To serve, divide quinoa, sausage, and veggies between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
