  "instructions": [
    {
      "id": 242567,
      "primary_message": "In a medium saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "1 ½ cups quinoa\n24 fl oz (3 cups) chicken or vegetable broth"
    },
    {
      "id": 242568,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 ½ lb cremini mushrooms\n3 jalapeño peppers\n3 orange bell peppers\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 242569,
      "primary_message": "Thinly slice mushrooms and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 242570,
      "primary_message": "Slice the sausages crosswise into ½-inch thick rounds.",
      "secondary_message": "6 pork sausages"
    },
    {
      "id": 242571,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 242572,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add sausage and cook, stirring occasionally, until starting to brown, about 5 minutes. Use a slotted spoon to transfer the sausage to a plate (the sausage will not be cooked all the way through).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 242573,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince garlic; peel and medium dice onions. Add both to the bowl with the mushrooms.",
      "secondary_message": "3 cloves garlic\n1 ½ medium yellow onions"
    },
    {
      "id": 242574,
      "primary_message": "Return pot (with cooking juices) to medium-high heat; add veggies and Italian seasoning. Cook, stirring occasionally, until the mushrooms have softened, about 8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp Italian seasoning"
    },
    {
      "id": 242575,
      "primary_message": "While the mushrooms are cooking, quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Finely dice and place in the reserved bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 242576,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl with the jalapeño.",
      "secondary_message": null
    },
    {
      "id": 242577,
      "primary_message": "Add jalapeño, bell pepper, browned sausage, salt, and pepper to the pot; cook, stirring occasionally, until the bell pepper starts to soften and sausage is cooked through, 5-6 minutes.",
      "secondary_message": "1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 242578,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 242579,
      "primary_message": "To serve, divide quinoa, sausage, and veggies between bowls. Enjoy!",
      "secondary_message": null
    }
  ],
