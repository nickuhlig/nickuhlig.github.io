  "instructions": [
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Grease loaf pan with 1 tablespoon butter. In a medium bowl, whisk together flour, baking soda, salt, and poppy seeds.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl using an electric mixer on medium speed or in a stand mixer fitted with a whisk attachment, beat together remaining cup of butter and sugar until light and fluffy, about 4 minutes. Beat in eggs one at a time. Beat in vanilla and 1/3 cup key lime juice until combined. Add flour mixture to bowl and beat until just incorporated. Pour batter into prepared loaf pan, smooth top, and bake until a cake tester comes out clean, about 50 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Whisk together confectioners sugar, remaining 2 tablespoons key lime juice, and key lime zest until smooth. Pour glaze over bread while warm.",
      "secondary_message": null
    }
  ],
