  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the Persian cucumbers. Trim and thinly slice the scallions crosswise.",
      "secondary_message": "6 Persian cucumbers\n5 scallions"
    },
    {
      "id": 1,
      "primary_message": "In a large colander, combine cucumbers, salt, and 1 teaspoon sugar and toss to combine. Let sit until cucumbers release their liquid, about 20 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While cucumbers are draining, bring a large pot of salted water to a boil. Cook noodles until tender, following timing on package's instructions. Drain in a colander and rinse with cold running water until chilled.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, in a large bowl, whisk tahini, vinegar or lime juice, chili crisp, soy sauce, and remaining 2 teaspoons sugar until smooth. Gradually add water while whisking constantly.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add scallions, cilantro, drained cucumbers, and noodles to tahini mixture. Mix gently to coat cucumbers and noodles.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Transfer noodles to serving bowls. Top with chili crisp, cilantro, and peanuts or sesame seeds, if using. Serve.",
      "secondary_message": null
    }
  ],
