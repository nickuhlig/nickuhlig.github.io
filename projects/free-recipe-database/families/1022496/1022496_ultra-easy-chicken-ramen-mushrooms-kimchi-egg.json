  "instructions": [
    {
      "primary_message": "Preheat a large pot over medium-high heat. Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms, salt, and pepper. Cook, stirring occasionally, until soft and golden, 3-4 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil\n1 (8 oz) pkg sliced white mushrooms\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Meanwhile, halve eggs lengthwise and set aside.",
      "secondary_message": null
    },
    {
      "primary_message": "When the mushrooms are done, add hot water (from the tap) to the pot. Bring to a boil over high heat. ",
      "secondary_message": null
    },
    {
      "primary_message": "Once the water has come to a boil, add chicken and noodles (reserving spice packets) to the pot. Cook, stirring occasionally, until chicken is warmed through and noodles are soft, 3-4 minutes. Remove soup from heat, add flavor packets, and stir until combined.",
      "secondary_message": "8 oz cooked chicken (shredded)\n2 (3 oz) pkg instant ramen noodle soup, chicken flavor"
    },
    {
      "primary_message": "To serve, divide soup, eggs, and kimchi between bowls. Enjoy!",
      "secondary_message": "1 cup kimchi"
    }
  ],
