  "instructions": [
    {
      "primary_message": "Preheat oven to 425°F. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer frozen meatballs to a large plate and spread out in an even layer. Set aside to thaw slightly.",
      "secondary_message": "1 (20 oz) bag frozen homestyle meatballs, fully-cooked"
    },
    {
      "primary_message": "Transfer frozen veggies to the baking sheet and spread out in an even layer. Once the oven is heated, place veggies in the oven and bake until partially cooked through, about 10 minutes.",
      "secondary_message": "2 (14 oz) bag frozen roasting vegetables (potatoes, peppers, onions)"
    },
    {
      "primary_message": "Remove baking sheet from the oven. Add meatballs, toss to combine with the veggies, and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "primary_message": "Return baking sheet to the oven and continue baking until veggies are lightly charred and meatballs are heated through, 10-12 minutes more.",
      "secondary_message": null
    },
    {
      "primary_message": "About 5 minutes before the veggies and meatballs are done, arrange naan on another large baking sheet and add to the oven. Bake until just warmed through, 3-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, place arugula in a medium bowl. Wash, dry, and juice lemon over top, drizzle with oil, and season with salt. Toss to dress the arugula.",
      "secondary_message": "½ (5 oz) pkg baby arugula\n½ lemon\n1 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "primary_message": "To serve, divide warm naan between plates; top with roasted veggies, meatballs, and arugula. Drizzle with tzatziki and enjoy!",
      "secondary_message": "½ cup tzatziki dressing"
    }
  ],
