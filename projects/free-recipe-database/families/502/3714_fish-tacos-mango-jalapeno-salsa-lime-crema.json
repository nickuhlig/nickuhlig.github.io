  "instructions": [
    {
      "id": 40613,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 mangoes\n1 jalapeño pepper\n1 lime\n½ small bunch cilantro"
    },
    {
      "id": 40614,
      "primary_message": "Peel the mangoes, then slice off the flesh from the pit, starting with the flatter sides; discard the pit and small dice the flesh (cut into 6-mm cubes). Transfer to a medium bowl (that will hold the salsa).",
      "secondary_message": null
    },
    {
      "id": 40615,
      "primary_message": "Quarter the jalapeño pepper lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the pepper and add to the salsa bowl.",
      "secondary_message": null
    },
    {
      "id": 40616,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and add to the salsa bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 40617,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 40618,
      "primary_message": "While the skillet heats up, pat the sole fillets dry with paper towels and place on a plate. Season with chili powder, cumin, salt, and pepper on both sides.",
      "secondary_message": "0.34 kg sole fillets\n½ tsp chili powder\n½ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 40619,
      "primary_message": "Once the skillet is hot, add the fish fillets and cook until opaque throughout, 2 to 3 minutes per side. Once done, transfer to a plate. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 40620,
      "primary_message": "While the fish cooks, using a knife, shave the cilantro leaves off the stems at a downward angle, working away from your body; discard the stems and finely chop the leaves. Add to the salsa.",
      "secondary_message": null
    },
    {
      "id": 40621,
      "primary_message": "Juice the lime; add ½ of the juice to the salsa and the other ½ to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 40622,
      "primary_message": "Season the salsa with salt and pepper; toss to combine.",
      "secondary_message": "¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 40623,
      "primary_message": "Add yogurt to the bowl of lime juice and stir to combine.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 40624,
      "primary_message": "Place the tortillas on a small plate and cover with a damp paper towel; microwave until heated through, 15 to 30 seconds.",
      "secondary_message": "8 small corn tortillas"
    },
    {
      "id": 40625,
      "primary_message": "Flake the fish with a fork.",
      "secondary_message": null
    },
    {
      "id": 40626,
      "primary_message": "To serve, divide the fish among the tortillas, top with the salsa, and drizzle with the crema. Enjoy!",
      "secondary_message": null
    }
  ],
