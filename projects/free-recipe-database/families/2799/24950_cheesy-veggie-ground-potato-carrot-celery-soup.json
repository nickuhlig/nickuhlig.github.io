  "instructions": [
    {
      "id": 418602,
      "primary_message": "Wash, dry, and medium dice potatoes. Place in a medium bowl.",
      "secondary_message": "4 medium yellow potatoes"
    },
    {
      "id": 418603,
      "primary_message": "Wash, dry, trim, and small dice celery. Add to the bowl with the potatoes and set aside.",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 418604,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 418605,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground, salt, and pepper; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n16 oz veggie ground, plant based\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 418606,
      "primary_message": "Meanwhile, peel, halve, and small dice onion. Add to the bowl with the potato and celery along with the carrots.",
      "secondary_message": "1 medium yellow onion\n1 (10 oz) bag shredded carrots"
    },
    {
      "id": 418607,
      "primary_message": "When the veggie ground is done, add vegetables to the pot; cook, stirring occasionally, until softened, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 418608,
      "primary_message": "Add broth to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, 12-15 minutes.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth"
    },
    {
      "id": 418609,
      "primary_message": "Once the veggies are soft, add milk and cheese. Continue to cook, stirring constantly, until the cheese is melted and combined, 1-2 minutes more. Remove from heat.",
      "secondary_message": "8 fl oz (1 cup) whole milk\n1 cup shredded cheese, Mexican blend"
    },
    {
      "id": 418610,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
