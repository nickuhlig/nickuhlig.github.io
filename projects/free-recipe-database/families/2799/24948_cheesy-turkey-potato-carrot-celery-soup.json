  "instructions": [
    {
      "id": 418584,
      "primary_message": "Wash, dry, and medium dice potatoes. Place in a large bowl. ",
      "secondary_message": "6 medium yellow potatoes"
    },
    {
      "id": 418585,
      "primary_message": "Wash, dry, trim, and small dice celery. Add to the bowl with the potatoes and set aside.",
      "secondary_message": "6 sticks celery"
    },
    {
      "id": 418586,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 418587,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add turkey, salt, and pepper; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 ¼ lb ground turkey\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 418588,
      "primary_message": "Meanwhile, peel, halve, and small dice onions. Add to the bowl with the potato and celery along with the carrots.",
      "secondary_message": "1 ½ medium yellow onions\n1 ½ (10 oz) bags shredded carrots"
    },
    {
      "id": 418589,
      "primary_message": "When the turkey is done, add veggies to the pot; cook, stirring occasionally, until softened, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 418590,
      "primary_message": "Add broth to the pot; stir to combine the soup, then bring to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until veggies are tender, 12-15 minutes.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth"
    },
    {
      "id": 418591,
      "primary_message": "Once the veggies are soft, add milk and cheese. Continue to cook, stirring constantly, until the cheese is melted and combined, 2-3 minutes more. Remove from heat. ",
      "secondary_message": "12 fl oz (1 ½ cups) whole milk\n1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 418592,
      "primary_message": "To serve, divide soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
