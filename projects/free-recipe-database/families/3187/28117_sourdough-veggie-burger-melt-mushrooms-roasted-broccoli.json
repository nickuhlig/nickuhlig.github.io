  "instructions": [
    {
      "id": 465851,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 465852,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "½ crown broccoli\n1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 465853,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 465854,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465855,
      "primary_message": "While the skillet heats up, wash, dry, and thinly slice mushrooms.",
      "secondary_message": "½ lb cremini mushrooms"
    },
    {
      "id": 465856,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, salt, and pepper; cook, stirring occasionally, until soft, 4-5 minutes. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 465857,
      "primary_message": "Meanwhile, place veggie ground, bread crumbs, egg, Italian seasoning, and salt in a medium bowl; mix with your hands until well combined. Form the mixture into 2 equal-sized patties, place on another plate, and set aside.",
      "secondary_message": "8 oz veggie ground, plant based\n¼ cup panko bread crumbs\n1 egg\n½ tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 465858,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465859,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add burger patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Add burgers to the plate with the mushrooms.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 465860,
      "primary_message": "Meanwhile, thinly slice cheese. ",
      "secondary_message": "¼ (8 oz) block mozzarella cheese"
    },
    {
      "id": 465861,
      "primary_message": "When the broccoli is done, change the oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 465862,
      "primary_message": "Arrange bread slices on another baking sheet. Spread with mayo, then top with burger patties, mushrooms, and cheese slices. Place baking sheet in the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": "2 slices sourdough bread\n2 tsp mayonnaise"
    },
    {
      "id": 465863,
      "primary_message": "To serve, divide veggie burger melts and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
