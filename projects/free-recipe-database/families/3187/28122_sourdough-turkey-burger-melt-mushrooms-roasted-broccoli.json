  "instructions": [
    {
      "id": 465916,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 465917,
      "primary_message": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to coat and spread out in an even layer.",
      "secondary_message": "1 ½ crowns broccoli\n1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 465918,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until broccoli is tender, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 465919,
      "primary_message": "While the broccoli is roasting, Wash, dry, and thinly slice mushrooms.",
      "secondary_message": "0.68 kg cremini mushrooms"
    },
    {
      "id": 465920,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465921,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, salt, and pepper; cook, stirring occasionally, until soft, 5-6 minutes. Transfer to a plate. (Reserve skillet for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 465922,
      "primary_message": "Meanwhile, place turkey, bread crumbs, eggs, Italian seasoning, and salt in a large bowl; mix with your hands until well combined. Form the turkey mixture into 6 equal-sized patties, place on another plate, and set aside.",
      "secondary_message": "1.02 kg ground turkey\n¾ cup panko bread crumbs\n3 eggs\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 465923,
      "primary_message": "Wipe the skillet clean with paper towels, then return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 465924,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook, undisturbed, until golden underneath, about 5 minutes; flip patties and cook an additional 5-6 minutes, until cooked through. Add burgers to the plate with the mushrooms.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 465925,
      "primary_message": "Meanwhile, thinly slice cheese. ",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 465926,
      "primary_message": "When the broccoli is done, change the oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 465927,
      "primary_message": "Arrange bread slices on a large baking sheet. Spread with mayo, then top with burger patties, mushrooms, and cheese slices. Place baking sheet in the oven and broil until cheese is melted and bubbly, 2-3 minutes. Remove from oven.",
      "secondary_message": "6 slices sourdough bread\n2 tbsp mayonnaise"
    },
    {
      "id": 465928,
      "primary_message": "To serve, divide turkey burger melts and broccoli between plates. Enjoy!",
      "secondary_message": null
    }
  ],
