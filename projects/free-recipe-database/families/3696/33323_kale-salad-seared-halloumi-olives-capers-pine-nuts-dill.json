  "instructions": [
    {
      "id": 526549,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 526550,
      "primary_message": "Once the skillet is hot, add pine nuts and cook, stirring often, until golden and fragrant, about 3 minutes. Transfer to a small bowl and set aside to cool. (Reserve skillet for later use.)",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 526551,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 small bunch fresh dill\n2 bunches kale"
    },
    {
      "id": 526552,
      "primary_message": "Zest and juice lemons into a large bowl.",
      "secondary_message": null
    },
    {
      "id": 526553,
      "primary_message": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lemon juice along with oil, salt, and crushed red pepper. Whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n½ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 526554,
      "primary_message": "Fold kale leaves in half lengthwise, then slice off the stems; cut leaves crosswise into thin (shred-like) pieces. Add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 526555,
      "primary_message": "Pat halloumi dry with paper towels, then cut crosswise into ½-inch thick slices.",
      "secondary_message": "2 (9 oz) pkgs halloumi cheese"
    },
    {
      "id": 526556,
      "primary_message": "Return skillet to medium heat, add oil, and swirl to coat the bottom. Add the halloumi and pan-fry until golden brown, 1-2 minutes per side. Remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 526557,
      "primary_message": "Meanwhile, halve olives lengthwise. Add the bowl with the kale, along with capers, and toss to combine the salad.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 tbsp capers"
    },
    {
      "id": 526558,
      "primary_message": "To serve, divide salad between plates or bowls. Top with halloumi, drizzle with honey, and enjoy!",
      "secondary_message": "2 tsp honey"
    }
  ],
