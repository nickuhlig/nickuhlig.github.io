  "instructions": [
    {
      "id": 184274,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 red bell peppers\n1 small pkg fresh basil\n1 small bunch Italian (flat-leaf) parsley\n2 (142 g) pkg baby arugula"
    },
    {
      "id": 184275,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 184276,
      "primary_message": "Peel and mince garlic and shallots. Place both in a large salad bowl.",
      "secondary_message": "2 cloves garlic\n2 shallots"
    },
    {
      "id": 184277,
      "primary_message": "Juice lemon into the bowl with the garlic and shallots. Add oil, vinegar, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n3 tbsp balsamic vinegar\n1 tsp pure maple syrup\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 184278,
      "primary_message": "Seed and slice bell peppers into thin strips; transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 184279,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184280,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184281,
      "primary_message": "Grate cheese and add to the bowl.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 184282,
      "primary_message": "Add arugula and beans to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 184283,
      "primary_message": "To serve, divide salad between plates or bowls and sprinkle with pumpkin seeds. Enjoy!",
      "secondary_message": "¼ cup pumpkin seeds"
    }
  ],
