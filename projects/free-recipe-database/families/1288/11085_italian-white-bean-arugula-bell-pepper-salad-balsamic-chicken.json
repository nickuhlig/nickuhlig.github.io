  "instructions": [
    {
      "id": 184250,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 red bell peppers\n1 small pkg fresh basil\n1 small bunch Italian (flat-leaf) parsley\n3 (142 g) pkg baby arugula"
    },
    {
      "id": 184251,
      "primary_message": "Peel and mince garlic and onion. Place both in a large salad bowl.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 184252,
      "primary_message": "Juice lemons into the bowl. Add oil, vinegar, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n⅓ cup balsamic vinegar\n1 ½ tsp pure maple syrup\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 184253,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 184254,
      "primary_message": "Place chicken thighs in a large bowl; pour ⅓ of the dressing over the chicken and stir to coat. Set the salad bowl with remaining dressing aside.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless"
    },
    {
      "id": 184255,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken to the skillet in a single layer and drizzle with leftover marinade. Cook until nicely browned and cooked through, 4-5 minutes per side. Transfer to a plate and set aside to cool.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 184256,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 ½ (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 184257,
      "primary_message": "Seed and slice bell peppers into thin strips; transfer to the salad bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 184258,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184259,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184260,
      "primary_message": "Grate cheese and add to the bowl.",
      "secondary_message": "1 (227 g) block mozzarella cheese"
    },
    {
      "id": 184261,
      "primary_message": "Add arugula and beans to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 184262,
      "primary_message": "Slice chicken into thin strips.",
      "secondary_message": null
    },
    {
      "id": 184263,
      "primary_message": "To serve, divide salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
