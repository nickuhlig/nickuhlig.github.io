  "instructions": [
    {
      "id": 184150,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 red bell pepper\n½ small pkg fresh basil\n½ small bunch Italian (flat-leaf) parsley\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 184151,
      "primary_message": "Peel and mince garlic and shallot. Place both in a large salad bowl.",
      "secondary_message": "1 clove garlic\n1 shallot"
    },
    {
      "id": 184152,
      "primary_message": "Juice lemon into the bowl. Add oil, vinegar, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp balsamic vinegar\n½ tsp pure maple syrup\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 184153,
      "primary_message": "Preheat a nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 184154,
      "primary_message": "Place chicken thighs in a medium bowl; pour ⅓ of the dressing over the chicken and stir to coat. Set the salad bowl with remaining dressing aside.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 184155,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken to the skillet in a single layer and drizzle with leftover marinade. Cook until nicely browned and cooked through, 4-5 minutes per side. Transfer to a plate and set aside to cool.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 184156,
      "primary_message": "Meanwhile, drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "½ (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 184157,
      "primary_message": "Seed and slice bell pepper into thin strips; transfer to the salad bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 184158,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184159,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184160,
      "primary_message": "Grate cheese and add to the bowl.",
      "secondary_message": "⅓ (8 oz) block mozzarella cheese"
    },
    {
      "id": 184161,
      "primary_message": "Add arugula and beans to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 184162,
      "primary_message": "Slice chicken into thin strips.",
      "secondary_message": null
    },
    {
      "id": 184163,
      "primary_message": "To serve, divide salad between plates or bowls and top with chicken. Enjoy!",
      "secondary_message": null
    }
  ],
