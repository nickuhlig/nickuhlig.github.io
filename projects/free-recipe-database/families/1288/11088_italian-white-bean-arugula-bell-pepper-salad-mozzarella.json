  "instructions": [
    {
      "id": 184284,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 red bell peppers\n1 small pkg fresh basil\n1 small bunch Italian (flat-leaf) parsley\n3 (142 g) pkg baby arugula"
    },
    {
      "id": 184285,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 184286,
      "primary_message": "Peel and mince garlic and onion. Place both in a large salad bowl.",
      "secondary_message": "3 cloves garlic\n½ medium red onion"
    },
    {
      "id": 184287,
      "primary_message": "Juice lemons into the bowl with the garlic and onion. Add oil, vinegar, maple syrup, salt, and pepper; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n¼ cup balsamic vinegar\n1 ½ tsp pure maple syrup\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 184288,
      "primary_message": "Seed and slice bell peppers into thin strips; transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 184289,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184290,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and mince the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 184291,
      "primary_message": "Grate cheese and add to the bowl.",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 184292,
      "primary_message": "Add arugula and beans to the bowl and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 184293,
      "primary_message": "To serve, divide salad between plates or bowls and sprinkle with pumpkin seeds. Enjoy!",
      "secondary_message": "½ cup pumpkin seeds"
    }
  ],
