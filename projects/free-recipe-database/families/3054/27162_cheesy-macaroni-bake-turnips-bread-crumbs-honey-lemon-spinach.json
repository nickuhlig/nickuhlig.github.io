  "instructions": [
    {
      "id": 437547,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 437548,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 medium turnips\n1 ½ lemons\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 437549,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 437550,
      "primary_message": "While the water is heating, peel, trim, and medium dice turnips.",
      "secondary_message": null
    },
    {
      "id": 437551,
      "primary_message": "Once the water in the pot is boiling, uncover, then add salt, turnip, and pasta; stir for a few seconds. Cook until turnip is just tender and pasta reaches desired firmness, 8-10 minutes.",
      "secondary_message": "¾ tsp salt\n15 oz macaroni (elbow) pasta"
    },
    {
      "id": 437552,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. Coarsely grate cheddar. Place both in another large pot. ",
      "secondary_message": "1 (8 oz) block cream cheese\n¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 437553,
      "primary_message": "Add milk, Dijon, and spices to the pot with the cheese. Set over medium-high heat and bring to a simmer, stirring often. Once simmering, reduce heat to medium and cook, stirring frequently, until sauce is combined and thickened, 5-6 minutes. Remove from heat. ",
      "secondary_message": "12 fl oz (1 ½ cups) whole milk\n2 tbsp Dijon mustard\n1 ½ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper\n¼ tsp nutmeg, ground"
    },
    {
      "id": 437554,
      "primary_message": "When the pasta and turnip are done, drain in a colander, and transfer to the pot with the sauce. Stir to combine, then transfer to a large baking dish and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 437555,
      "primary_message": "Sprinkle bread crumbs over the cheesy macaroni. Place baking dish in the oven and bake until bread crumbs are golden, 8-10 minutes. Remove from oven. ",
      "secondary_message": "¾ cup panko bread crumbs"
    },
    {
      "id": 437556,
      "primary_message": "Meanwhile, juice lemons into a large bowl. Add oil, honey, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp honey\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 437557,
      "primary_message": "Add spinach to the bowl with the dressing, then toss to coat.",
      "secondary_message": null
    },
    {
      "id": 437558,
      "primary_message": "To serve, divide cheesy macaroni and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
