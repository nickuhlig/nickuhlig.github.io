  "instructions": [
    {
      "id": 437595,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 437596,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 medium turnip\n½ lemon\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 437597,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 437598,
      "primary_message": "While the water is heating, peel, trim, and medium dice turnip.",
      "secondary_message": null
    },
    {
      "id": 437599,
      "primary_message": "Once the water in the saucepan is boiling, uncover, then add salt, turnip, and pasta; stir for a few seconds. Cook until turnip is just tender and pasta reaches desired firmness, 8-10 minutes.",
      "secondary_message": "¼ tsp salt\n142 g macaroni (elbow) pasta"
    },
    {
      "id": 437600,
      "primary_message": "Meanwhile, cut cream cheese into small pieces. Coarsely grate cheddar. Place both in an ovenproof skillet. ",
      "secondary_message": "⅓ (227 g) block cream cheese\n¼ (227 g) block cheddar cheese"
    },
    {
      "id": 437601,
      "primary_message": "Add milk, Dijon, and spices to the skillet with the cheese. Set over medium-high heat and bring to a simmer, stirring often. Once simmering, reduce heat to medium and cook, stirring frequently, until sauce is combined and thickened, 4-5 minutes. Remove from heat. ",
      "secondary_message": "118 ml (½ cup) whole milk\n2 tsp Dijon mustard\n½ tsp garlic powder\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp nutmeg, ground"
    },
    {
      "id": 437602,
      "primary_message": "When the pasta and turnip are done, drain in a colander, and transfer to the skillet with the sauce. Stir to combine and spread out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 437603,
      "primary_message": "Sprinkle bread crumbs over the cheesy macaroni. Place skillet in the oven and bake until bread crumbs are golden, 6-8 minutes. Remove from oven. ",
      "secondary_message": "¼ cup panko bread crumbs"
    },
    {
      "id": 437604,
      "primary_message": "Meanwhile, juice lemon into a medium bowl. Add oil, honey, salt, and pepper; whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp honey\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 437605,
      "primary_message": "Add spinach to the bowl with the dressing, then toss to coat.",
      "secondary_message": null
    },
    {
      "id": 437606,
      "primary_message": "To serve, divide cheesy macaroni and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
