  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the walnuts.",
      "secondary_message": "4 tbsp walnuts"
    },
    {
      "id": 1,
      "primary_message": "Grease an 8- by 10-cm loaf pan with oil and lightly dust with flour, knocking out any excess. Adjust oven rack to middle position and preheat oven to 175°C (350°F). In a small bowl, whisk together flour, cocoa powder, espresso powder, baking powder, and salt; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, whisk together eggs and sugar until smooth. Add grapeseed oil, yogurt, and vanilla extract and whisk until combined. Add dry ingredients to bowl and whisk until just combined. Stir in 1/2 cup walnuts.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pour batter into prepared pan and smooth top. Sprinkle remaining walnuts over top of cake. Bake until top is dry and a cake tester inserted into the middle of the cake comes out clean, about 50 minutes. Let cool 15 minutes then turn out onto a wire rack to finish cooling.",
      "secondary_message": null
    }
  ],
