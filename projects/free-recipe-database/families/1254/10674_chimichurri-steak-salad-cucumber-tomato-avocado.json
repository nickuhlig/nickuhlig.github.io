  "instructions": [
    {
      "id": 172003,
      "primary_message": "Wash and dry the fresh produce (skip the mixed greens if they came pre-washed). ",
      "secondary_message": "1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ small bunches cilantro\n1 ½ lemons\n1 ½ pints grape tomatoes\n1 English cucumber\n1 ½ avocados\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 172004,
      "primary_message": "Preheat a skillet, outdoor grill, or grill pan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 172005,
      "primary_message": "Pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb ribeye steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 172006,
      "primary_message": "Coat grill or bottom of skillet with oil. Working in batches if necessary, place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side for medium. Transfer to a clean plate and loosely cover with foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 172007,
      "primary_message": "Meanwhile, shave parsley and cilantro leaves off the stems; discard the stems and mince the leaves. Transfer the minced leaves to a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 172008,
      "primary_message": "Peel and mince garlic and add to the bowl with the herbs.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 172009,
      "primary_message": "Juice lemon into the bowl with the garlic and herbs. Add oil and spices and whisk to combine the chimichurri.",
      "secondary_message": "⅓ cup extra virgin olive oil\n1 tbsp oregano\n¾ tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 172010,
      "primary_message": "Halve the grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 172011,
      "primary_message": "Trim ends, halve lengthwise, and thinly slice cucumbers into half rounds.",
      "secondary_message": null
    },
    {
      "id": 172012,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 172013,
      "primary_message": "To serve, divide mixed greens and veggies between plates. Serve with sliced steak and chimichurri sauce. Enjoy! ",
      "secondary_message": null
    }
  ],
