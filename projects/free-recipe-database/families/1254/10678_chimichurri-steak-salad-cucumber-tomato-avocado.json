  "instructions": [
    {
      "id": 172050,
      "primary_message": "Wash and dry the fresh produce (skip the mixed greens if they came pre-washed). ",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n½ small bunch cilantro\n½ lemon\n½ small pkg grape tomatoes\n½ English cucumber\n½ avocado\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 172051,
      "primary_message": "Preheat a skillet, outdoor grill, or grill pan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 172052,
      "primary_message": "Pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg ribeye steak\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 172053,
      "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side for medium. Transfer to a clean plate and loosely cover with foil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 172054,
      "primary_message": "Meanwhile, shave parsley and cilantro leaves off the stems; discard the stems and mince the leaves. Transfer the minced leaves to a small bowl. ",
      "secondary_message": null
    },
    {
      "id": 172055,
      "primary_message": "Peel and mince garlic and add to the bowl with the herbs.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 172056,
      "primary_message": "Juice lemon into the bowl with the garlic and herbs. Add oil and spices and whisk to combine the chimichurri.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp oregano\n¼ tsp salt\n⅛ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 172057,
      "primary_message": "Halve the grape tomatoes.",
      "secondary_message": null
    },
    {
      "id": 172058,
      "primary_message": "Trim ends, halve lengthwise, and thinly slice cucumbers into half rounds.",
      "secondary_message": null
    },
    {
      "id": 172059,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out.",
      "secondary_message": null
    },
    {
      "id": 172060,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 172061,
      "primary_message": "To serve, divide mixed greens and veggies between plates. Serve with sliced steak and chimichurri sauce. Enjoy! ",
      "secondary_message": null
    }
  ],
