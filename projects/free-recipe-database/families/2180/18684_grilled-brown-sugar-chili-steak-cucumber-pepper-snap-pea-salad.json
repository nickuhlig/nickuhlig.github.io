  "instructions": [
    {
      "id": 306025,
      "primary_message": "Peel and mince garlic; place in a baking dish along with soy sauce, vinegar, sugar, and chili-garlic sauce. Whisk to combine the marinade.",
      "secondary_message": "2 cloves garlic\n2 tbsp soy sauce\n2 tbsp rice vinegar\n2 tbsp brown sugar\n4 tsp chili-garlic sauce"
    },
    {
      "id": 306026,
      "primary_message": "Pat steak dry with paper towels and add to the baking dish with the marinade; turn to coat and set aside.",
      "secondary_message": "1 ½ lb ribeye steak"
    },
    {
      "id": 306027,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 English cucumber\n2 red bell peppers\n2 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 306028,
      "primary_message": "Peel and mince additional garlic; place in a large bowl along with oil, soy sauce, vinegar, and chili-garlic sauce. Whisk to combine the dressing.",
      "secondary_message": "2 cloves garlic\n4 tsp toasted sesame oil\n2 tsp soy sauce\n2 tsp rice vinegar\n2 tsp chili-garlic sauce"
    },
    {
      "id": 306029,
      "primary_message": "Peel, halve, and slice shallots into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 306030,
      "primary_message": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 306031,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 306032,
      "primary_message": "Cut snap peas crosswise into ½-inch pieces and add to the bowl; stir to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 306033,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306034,
      "primary_message": "Once the grill pan is hot, coat with oil; add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 306035,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 306036,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
