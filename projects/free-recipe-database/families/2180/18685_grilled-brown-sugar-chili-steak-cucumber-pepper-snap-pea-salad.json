  "instructions": [
    {
      "id": 306037,
      "primary_message": "Peel and mince garlic; place in a large baking dish along with soy sauce, vinegar, sugar, and chili-garlic sauce. Whisk to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp soy sauce\n3 tbsp rice vinegar\n3 tbsp brown sugar\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 306038,
      "primary_message": "Pat steak dry with paper towels and add to the baking dish with the marinade; turn to coat and set aside.",
      "secondary_message": "2 ¼ lb ribeye steak"
    },
    {
      "id": 306039,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 red bell peppers\n3 (8 oz) pkg sugar snap peas"
    },
    {
      "id": 306040,
      "primary_message": "Peel and mince additional garlic; place in a large bowl along with oil, soy sauce, vinegar, and chili-garlic sauce. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 tbsp toasted sesame oil\n1 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 306041,
      "primary_message": "Peel, halve, and slice onion into thin half-moons; add to the bowl with the dressing.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 306042,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 306043,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 306044,
      "primary_message": "Cut snap peas crosswise into ½-inch pieces and add to the bowl; stir to combine the salad and set aside.",
      "secondary_message": null
    },
    {
      "id": 306045,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 306046,
      "primary_message": "Once the grill pan is hot, coat with oil; working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer steak to a plate, loosely cover with aluminum foil, and set aside to rest, 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 306047,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 306048,
      "primary_message": "To serve, divide steak and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
