  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the ginger. Chop the red onion. Chop the red bell pepper. Drain the Pineapple chunks.",
      "secondary_message": "1 (1 ½ inch) knob ginger root\n1 medium red onion\n1 red bell pepper\nPineapple chunks, from 20 ounce can"
    },
    {
      "id": 1,
      "primary_message": "In small bowl, whisk brown sugar, cornstarch, rice vinegar, soy sauce, and tomato paste until combined. Whisk in 1/3 cup pineapple juice; set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat remaining 1/3 cup pineapple juice in 12-inch nonstick skillet over medium heat until simmering. Add chicken and gently cook until chicken is opaque and just about cooked through, 1 to 2 minutes. Remove chicken and set aside on plate. Discard any leftover liquid in pan and wipe clean with a paper towel.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add oil skillet and return to medium heat until shimmering. Add ginger, onion, pepper, pineapple, and cook, stirring frequently, until onion and pepper are just beginning to soften, 2 to 3 minutes. Add snow peas and cook until just beginning to soften but still crisp, 1 to 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Stir in cashews, chicken, and sauce. Cook, stirring, until sauce boils and thickens, chicken is cooked through, and entire mixture is coated, about 2 minutes more. Serve immediately over white rice.",
      "secondary_message": null
    }
  ],
