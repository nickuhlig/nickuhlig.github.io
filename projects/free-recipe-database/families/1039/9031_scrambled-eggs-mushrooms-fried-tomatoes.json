  "instructions": [
    {
      "id": 140449,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb cremini mushrooms\n6 tomatoes"
    },
    {
      "id": 140450,
      "primary_message": "Slice mushrooms. Cut tomatoes in half.",
      "secondary_message": null
    },
    {
      "id": 140451,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 140452,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 140453,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 140454,
      "primary_message": "Add mushrooms, garlic, and thyme to the skillet. Cook, stirring occasionally, until mushrooms are tender, 3-4 minutes.",
      "secondary_message": "3 pinch thyme"
    },
    {
      "id": 140455,
      "primary_message": "Meanwhile, crack eggs into a large bowl and season with salt and pepper; whisk to combine.",
      "secondary_message": "15 eggs\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 140456,
      "primary_message": "When mushrooms are done remove to a plate and cover with aluminum foil. Add tomatoes, cut-side down, to the skillet and cook, undisturbed, until tomatoes are browned, about 3 minutes. Transfer tomatoes to the plate with the mushrooms and cover. ",
      "secondary_message": null
    },
    {
      "id": 140457,
      "primary_message": "Return the skillet to the stove over medium heat; once hot, add oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 140458,
      "primary_message": "Pour the egg mixture into the skillet. Scramble the eggs using a combination of stirring and flipping, making sure to bring in all the mixture from the edges of the pan. Cook until the eggs are no longer runny.",
      "secondary_message": null
    },
    {
      "id": 140459,
      "primary_message": "To serve, divide the scrambled eggs, mushrooms, and tomatoes between plates. Enjoy!",
      "secondary_message": null
    }
  ],
