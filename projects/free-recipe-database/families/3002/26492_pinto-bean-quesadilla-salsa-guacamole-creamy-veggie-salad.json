  "instructions": [
    {
      "id": 429847,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans pinto beans"
    },
    {
      "id": 429848,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 429849,
      "primary_message": "While the skillet heats up, lay tortillas on a flat surface and divide beans and cheese between them, arranging on one half of each tortilla. Season with chili powder, then fold in half to close.",
      "secondary_message": "4 large flour tortillas\n1 ⅓ cups shredded cheese, Mexican blend\n1 tsp chili powder"
    },
    {
      "id": 429850,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 429851,
      "primary_message": "Meanwhile, wash, dry, trim, and halve cucumber lengthwise, then cut crosswise into thin half-moons. Place in a medium bowl along with carrots, dressing, additional chili powder, and salt. Stir to combine the salad.",
      "secondary_message": "1 English cucumber\n1 (283 g) bag shredded carrots\n¼ cup ranch dressing\n½ tsp chili powder\n¼ tsp salt"
    },
    {
      "id": 429852,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salsa, guacamole, and salad on the side. Enjoy!",
      "secondary_message": "⅔ cup salsa\n⅔ cup guacamole"
    }
  ],
