  "instructions": [
    {
      "id": 429853,
      "primary_message": "Drain and rinse beans in a colander; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans pinto beans"
    },
    {
      "id": 429854,
      "primary_message": "Lay tortillas on a flat surface and divide beans and cheese between them, arranging on one half of each tortilla. Season with chili powder, then fold in half to close.",
      "secondary_message": "6 large flour tortillas\n2 cups shredded cheese, Mexican blend\n1 ½ tsp chili powder"
    },
    {
      "id": 429855,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 429856,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 429857,
      "primary_message": "Meanwhile, wash, dry, trim, and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Place in a medium bowl along with carrots, dressing, additional chili powder, and salt. Stir to combine the salad.",
      "secondary_message": "1 ½ English cucumbers\n1 ½ (283 g) bags shredded carrots\n⅓ cup ranch dressing\n¾ tsp chili powder\n½ tsp salt"
    },
    {
      "id": 429858,
      "primary_message": "Cut each quesadilla into wedges and divide between plates; serve with salsa, guacamole, and salad on the side. Enjoy!",
      "secondary_message": "1 cup salsa\n1 cup guacamole"
    }
  ],
