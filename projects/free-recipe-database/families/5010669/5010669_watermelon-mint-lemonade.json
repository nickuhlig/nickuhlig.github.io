  "instructions": [
    {
      "id": 1,
      "primary_message": "Place watermelon, lemon juice, sugar, and salt in a blender and blend on high speed until smooth, about 1 minute. Strain through a fine mesh strainer into 1-quart liquid measuring cup. Add cold water to equal 1 quart.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place mint in the botton of a pitcher and muddle lightly with a wooden spoon. Add watermelon mixture and stir to combine. Add ice. Serve immediately in ice-filled glasses garnished with mint sprigs.",
      "secondary_message": null
    }
  ],
