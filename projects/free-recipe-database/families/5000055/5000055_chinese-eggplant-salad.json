  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim and cut the Chinese eggplant into 2-inch lengths. Mince the garlic. Slice the scallion green thinly on a bias.",
      "secondary_message": "2 small Chinese eggplant\n3 medium cloves garlic\n1 medium scallion green"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, combine the white vinegar with 2 cups cold water. Add eggplant and let soak for 10 minutes. Drain well.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Set up a steamer and bring to full-steam over high heat. Add eggplant, cover, and cook until tender throughout but not mushy, about 10 minutes. Alternatively, place drained eggplant in a microwave-safe bowl, cover, and cook until tender throughout but not mushy, about 7 minutes at high power. Let cool to room temperature, then, using your hands, tear cooked eggplant into thick batons.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, whisk together soy sauce, seasoning oil, chili oil, black vinegar, and sugar until sugar is dissolved.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "In a bowl, combine eggplants, garlic, and scallion greens. Add dressing 1 tablespoon at a time while gently tossing until eggplant is sufficiently dressed, about 4 tablespoons. Serve.",
      "secondary_message": null
    }
  ],
