  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the sweet potato into 1/4- to 1/2-inch dice. Mince the garlic cloves. Pick the sage leaves from the stems and mince them. Thinly slice the radish. Pick the cilantro leaves from the stems and chop them. Cut the lime into wedges.",
      "secondary_message": "⅓ lb sweet potato\n2 medium garlic cloves\n2 tbsp fresh sage leaves\n1 large radish\nFresh cilantro leaves\n1 lime"
    },
    {
      "id": 1,
      "primary_message": "Heat 2 tablespoons oil in a large non-stick or cast iron skillet over medium-high heat until shimmering. Add sweet potato, season with salt and pepper, and cook, stirring and tossing frequently, until softened and lightly browned on all sides, about 8 minutes. Add garlic and sage and cook, stirring constantly, until fragrant, about 30 seconds. Transfer mixture to a bowl, cover, and keep warm.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Wipe out skillet and add remaining tablespoon oil. Heat over medium-high heat until shimmering and swirl to coat. Add eggs, season with salt and pepper and fry until whites are just set but yolks are still runny, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Meanwhile, place tortillas on a warm serving dish and divide sweet potato mixture evenly between them. Top each with a fried egg. Drizzle with crema and hot sauce, garnish with radishes and cilantro, and serve immediately with lime wedges.",
      "secondary_message": null
    }
  ],
