  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Fully cool the sous vide lobster. Finely dice the celery. Mince the chives. Juice the lemon.",
      "secondary_message": "1 recipe sous vide lobster\n1 rib celery\n1 tbsp fresh chives\n1 lemon, to taste"
    },
    {
      "id": 1,
      "primary_message": "Heat butter in a large skillet or on a griddle over medium heat until foaming subsides. Add hot dog buns, with exposed crumbs down, and griddle until golden brown. Flip and griddle second side. Transfer to a serving platter.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Discard any herbs from sous vide lobster bag. Remove lobster meat from bag and chop into large bite-size pieces. Transfer to a large bowl. Add mayonnaise to taste, celery, and chives or tarragon. Add lemon juice to taste and toss to combine. Adjust seasoning with salt and pepper if needed. (Sous vide lobster is typically well seasoned even without additional salt.) Divide mixture evenly between hot dog buns and serve.",
      "secondary_message": null
    }
  ],
