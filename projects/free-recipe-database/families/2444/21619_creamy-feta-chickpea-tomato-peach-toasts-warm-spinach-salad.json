  "instructions": [
    {
      "id": 363966,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 363967,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 peach\n1 small pkg grape tomatoes\n½ small pkg fresh basil\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 363968,
      "primary_message": "Peel and mince garlic. Place in a medium bowl along with oil and spices; stir to combine the marinade.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 363969,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the marinade. ",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 363970,
      "primary_message": "Quarter peach lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 363971,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl and stir to combine the chickpea mixture. ",
      "secondary_message": null
    },
    {
      "id": 363972,
      "primary_message": "Transfer the chickpea mixture to a baking sheet pan, then spread out in an even layer. Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tomatoes are soft and chickpeas are golden, 12-15 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 363973,
      "primary_message": "Meanwhile, place feta, water, and oil in a small bowl. Mash with a fork until semi-smooth and combined; set aside.",
      "secondary_message": "1 (113 g) pkg crumbled feta cheese\n2 tbsp water\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 363974,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in the reserved bowl, along with the spinach, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 363975,
      "primary_message": "Split rolls in half and arrange, cut-side facing up, on another baking sheet. Add rolls to the oven and toast until golden, about 4 minutes. Remove from oven.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 363976,
      "primary_message": "When the chickpeas are done, remove from oven and let cool slightly, 3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 363977,
      "primary_message": "Transfer ⅔ of the chickpea mixture to the bowl with the basil and spinach. Add vinegar and toss to combine the salad. (Reserve remaining chickpea mixture for the next step.)",
      "secondary_message": "2 tbsp balsamic vinegar"
    },
    {
      "id": 363978,
      "primary_message": "Spread toasts with the creamy feta, then top with remaining chickpea mixture. ",
      "secondary_message": null
    },
    {
      "id": 363979,
      "primary_message": "To serve, divide salad and toasts between plates; drizzle toasts with additional vinegar. Enjoy!",
      "secondary_message": "2 tsp balsamic vinegar"
    }
  ],
