  "instructions": [
    {
      "id": 363908,
      "primary_message": "Preheat oven to 450°F. Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 363909,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 peaches\n3 pints grape tomatoes\n1 small pkg fresh basil\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 363910,
      "primary_message": "Peel and mince garlic. Place in a large bowl along with oil and spices; stir to combine the marinade.",
      "secondary_message": "3 cloves garlic\n3 tbsp extra virgin olive oil\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 363911,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl with the marinade. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 363912,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 363913,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl and stir to combine the chickpea mixture. ",
      "secondary_message": null
    },
    {
      "id": 363914,
      "primary_message": "Divide the chickpea mixture between two large baking sheet pans, then spread out in an even layer. ",
      "secondary_message": null
    },
    {
      "id": 363915,
      "primary_message": "Place baking sheets on lower racks of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until tomatoes are soft and chickpeas are golden, 15-18 minutes. (Reserve bowl for later use.)",
      "secondary_message": null
    },
    {
      "id": 363916,
      "primary_message": "Meanwhile, place feta, water, and oil in a medium bowl. Mash with a fork until semi-smooth and combined; set aside.",
      "secondary_message": "3 (4 oz) pkgs crumbled feta cheese\n⅓ cup water\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 363917,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Place in the reserved bowl, along with the spinach, and set aside. ",
      "secondary_message": null
    },
    {
      "id": 363918,
      "primary_message": "Split rolls in half and arrange, cut-side facing up, on another large baking sheet. Place rolls on upper rack of the oven and toast until golden, 4-5 minutes. Remove from oven.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 363919,
      "primary_message": "When the chickpeas are done, remove from oven and let cool slightly, 3 minutes. ",
      "secondary_message": null
    },
    {
      "id": 363920,
      "primary_message": "Transfer ⅔ of the chickpea mixture to the bowl with the basil and spinach. Add vinegar and toss to combine the salad. (Reserve remaining chickpea mixture for the next step.)",
      "secondary_message": "⅓ cup balsamic vinegar"
    },
    {
      "id": 363921,
      "primary_message": "Spread toasts with the creamy feta, then top with remaining chickpea mixture. ",
      "secondary_message": null
    },
    {
      "id": 363922,
      "primary_message": "To serve, divide salad and toasts between plates; drizzle toasts with additional vinegar. Enjoy!",
      "secondary_message": "2 tbsp balsamic vinegar"
    }
  ],
