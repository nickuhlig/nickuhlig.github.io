  "instructions": [
    {
      "id": 30869,
      "primary_message": "In a small saucepan, combine the quinoa, salt, and water; bring to a boil over high heat.",
      "secondary_message": "½ cup quinoa\n¼ tsp salt\n1 cup water"
    },
    {
      "id": 30839,
      "primary_message": "While the liquid comes to a boil, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "½ lb sweet potatoes\n1 (1 inch) piece ginger root\n½ small bunch Italian (flat-leaf) parsley\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 30870,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the quinoa for 15 minutes. Once done, remove the quinoa from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 30843,
      "primary_message": "Peel and medium dice the potatoes (cut into ½-inch cubes); transfer to a bowl.",
      "secondary_message": null
    },
    {
      "id": 30844,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 30846,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into ¼-inch pieces).",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 30845,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 30847,
      "primary_message": "Add the onion to the skillet; cook, stirring frequently, until it is softened, 3 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 30840,
      "primary_message": "While the onion cooks, trim off and discard the root ends of the garlic; peel and mince or press the garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 30841,
      "primary_message": "Peel and grate or mince the ginger.",
      "secondary_message": null
    },
    {
      "id": 30848,
      "primary_message": "Add the garlic, ginger, and curry powder to the onion; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 tbsp curry powder"
    },
    {
      "id": 30849,
      "primary_message": "Add the sweet potatoes, tomato sauce, broth, and salt to the skillet; stir to combine and reduce the heat to medium-low. Cook, stirring occasionally, for 10 minutes before adding the remaining ingredients.",
      "secondary_message": "1 (8 oz) can tomato sauce\n4 fl oz (½ cup) chicken or vegetable broth\n½ tsp salt"
    },
    {
      "id": 30842,
      "primary_message": "While the curry cooks, using a knife, shave the parsley leaves off the stems at a downward angle, working away from your body; discard the stems and roughly chop the leaves.",
      "secondary_message": null
    },
    {
      "id": 30872,
      "primary_message": "Drain and rinse the beans.",
      "secondary_message": "1 (15 oz) can cannellini (white kidney) beans"
    },
    {
      "id": 30850,
      "primary_message": "Add the beans, spinach, ¾ of the parsley (save the rest for garnishing), and yogurt to the curry; stir to combine and continue cooking until the potatoes are tender, another 5 to 7 minutes.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 30871,
      "primary_message": "Uncover the quinoa and fluff with a fork.",
      "secondary_message": null
    },
    {
      "id": 30868,
      "primary_message": "To serve, place the quinoa on a plate or in a bowl, top with the curry, and garnish with the remaining parsley leaves. Enjoy!",
      "secondary_message": null
    }
  ],
