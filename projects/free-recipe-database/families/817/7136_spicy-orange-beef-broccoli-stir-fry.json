  "instructions": [
    {
      "id": 115338,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 115339,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 oranges\n3 crowns broccoli\n1 ½ small bunches green onions (scallions)"
    },
    {
      "id": 115340,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 115341,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger. Set both aside in a small bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 115342,
      "primary_message": "Use a grater to zest the oranges and transfer to the bowl with the garlic and ginger. Juice the orange into a separate medium bowl.",
      "secondary_message": null
    },
    {
      "id": 115343,
      "primary_message": "Heat the oil in a small saucepan over medium-low heat. Once the oil is hot, add the garlic, ginger, orange zest, and chili-garlic sauce. Sauté until ingredients soften, 2-3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 115344,
      "primary_message": "Add orange juice, brown sugar, rice vinegar, and soy sauce to the saucepan. Bring to a boil, then lower the heat and simmer, uncovered and stirring occasionally, until sauce thickens and reduces by half, about 15 minutes.",
      "secondary_message": "3 tbsp brown sugar\n¾ cup rice vinegar\n¾ cup soy sauce"
    },
    {
      "id": 115345,
      "primary_message": "Slice the steak against the grain into ½-inch strips.",
      "secondary_message": "1.02 kg striploin (New York strip) steak"
    },
    {
      "id": 115346,
      "primary_message": "Heat a large nonstick skillet over medium-high heat. Once the skillet is hot, add oil and swirl to coat the bottom.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 115347,
      "primary_message": "Add the beef to the skillet and cook, without stirring, for 1 minute. Then turn the beef pieces over and cook, stirring occasionally, 3-4 minutes for medium-rare. Transfer beef to a plate and set aside. Cook in batches if necessary.",
      "secondary_message": null
    },
    {
      "id": 115348,
      "primary_message": "Meanwhile, separate broccoli into bite-sized florets. Return the skillet to medium heat and add the broccoli. Stir-fry until tender-crisp, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 115349,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into ¼-inch pieces at an angle.",
      "secondary_message": null
    },
    {
      "id": 115350,
      "primary_message": "Add the beef back into the skillet with the broccoli. Add green onions and orange sauce to the skillet and stir well.",
      "secondary_message": null
    },
    {
      "id": 115351,
      "primary_message": "To serve, divide the rice into bowls and top with the beef and veggie mixture. Enjoy!",
      "secondary_message": null
    }
  ],
