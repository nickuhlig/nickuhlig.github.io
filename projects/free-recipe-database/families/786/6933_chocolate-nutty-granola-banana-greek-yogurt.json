  "instructions": [
    {
      "id": 105438,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 105439,
      "primary_message": "Add oats to a medium mixing bowl.",
      "secondary_message": "½ cup oats, quick cooking"
    },
    {
      "id": 105440,
      "primary_message": "Roughly chop nuts and add to the bowl.",
      "secondary_message": "¼ cup almonds\n¼ cup walnuts"
    },
    {
      "id": 105441,
      "primary_message": "Melt coconut oil in a small saucepan. Add maple syrup, salt, cocoa powder, and cinnamon; whisk to combine.",
      "secondary_message": "2 tbsp virgin coconut oil\n2 tsp pure maple syrup\n¼ tsp salt\n2 tsp cocoa powder\n1 tsp cinnamon"
    },
    {
      "id": 105442,
      "primary_message": "Pour oil mixture over oats and nuts and stir to coat.",
      "secondary_message": null
    },
    {
      "id": 105443,
      "primary_message": "Spread out on a baking sheet lined with parchment paper and bake for 6-8 minutes, stirring halfway through cooking. Watch carefully as the nuts can burn easily.",
      "secondary_message": null
    },
    {
      "id": 105444,
      "primary_message": "Peel the banana and slice.",
      "secondary_message": "1 banana"
    },
    {
      "id": 105445,
      "primary_message": "Spoon yogurt into bowls and top with granola and banana. Enjoy!",
      "secondary_message": "1 cup plain Greek yogurt"
    }
  ],
