  "instructions": [
    {
      "primary_message": "Using a stand mixer, beat the Land O Lakes® Butter with Olive Oil and Sea Salt and vanilla until creamed. Add sugar and mix until combined.\n",
      "secondary_message": null
    },
    {
      "primary_message": "On low, add flour gradually until fully incorporated, scraping down the sides of the bowl one or two times during the mixing.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Shape dough into a log-shaped cylinder about 1 ½-inches thick. Wrap with plastic wrap and refrigerate until firm, about 1 hour, up to overnight.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat the oven to 350 degrees. Unwrap and slice dough crosswise into ⅓-inch thick slices.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Place slices on a parchment paper-lined baking sheet, about 2 inches apart. Poke a few holes with a toothpick into the top of the cookies.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Bake for 10 minutes. Remove from the oven and let cool slightly before transferring to a cooling rack.\n",
      "secondary_message": null
    }
  ],
