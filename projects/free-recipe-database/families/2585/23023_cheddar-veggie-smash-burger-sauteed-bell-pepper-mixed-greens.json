  "instructions": [
    {
      "id": 380059,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n1 green bell pepper\n1 stick celery\n½ small pkg grape tomatoes\n½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 380060,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Peel and mince shallot and garlic. Divide the parsley, shallot, and garlic between two medium bowls. Set one bowl aside for the salad.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 380061,
      "primary_message": "Add veggie ground, Dijon, and spices to the remaining bowl. Use your hands to combine the veggie ground mixture. Form into 2 equal-sized \"meatballs\" and place on a plate. Set aside.",
      "secondary_message": "227 g veggie ground, plant based\n2 tsp Dijon mustard\n½ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 380062,
      "primary_message": "Preheat a skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 380063,
      "primary_message": "While the skillet heats up, trim, seed, and slice bell pepper lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 380064,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and salt; sauté until charred and tender, 2-3 minutes. Transfer peppers to a plate and loosely cover with aluminum foil. (Reserve skillet for the next step.)",
      "secondary_message": "1 tsp extra virgin olive oil\n1 pinch salt"
    },
    {
      "id": 380065,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add meatballs to the skillet, spacing them out; press down with the bottom of a spatula to form ½-inch thick patties. Cook, undisturbed, until golden on one side, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 380066,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 380067,
      "primary_message": "When the burgers are done on one side, flip and top with cheese. Continue to cook until cheese melts and burgers are cooked through, 3-4 minutes more. Add burgers to the plate with the bell pepper and re-cover with foil.",
      "secondary_message": null
    },
    {
      "id": 380068,
      "primary_message": "While the burgers are cooking, add additional oil, vinegar, mayo, Dijon, salt, and pepper to the bowl with the remaining parsley, shallot, and garlic. Whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp white wine vinegar\n1 tsp mayonnaise\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 380069,
      "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 380070,
      "primary_message": "Halve tomatoes. Add to the bowl, along with the mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 380071,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "2 whole grain buns or rolls"
    },
    {
      "id": 380072,
      "primary_message": "Spread additional mayo over the bottom half of each bun; top with a cheesy veggie ground patty and sautéed bell peppers. Close with the top half of each bun.",
      "secondary_message": "1 tbsp mayonnaise"
    },
    {
      "id": 380073,
      "primary_message": "To serve, divide smash burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
