  "instructions": [
    {
      "id": 379861,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n2 green bell peppers\n2 sticks celery\n1 pint grape tomatoes\n1 (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 379862,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Peel and mince shallots and garlic. Divide the parsley, shallot, and garlic between two medium bowls. Set one bowl aside for the salad.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 379863,
      "primary_message": "Add chicken, Dijon, and spices to the remaining bowl. Use your hands to combine the chicken mixture. Form into 4 equal-sized \"meatballs\" and place on a plate. Set aside.",
      "secondary_message": "1 lb ground chicken\n4 tsp Dijon mustard\n1 tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 379864,
      "primary_message": "Preheat a large skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 379865,
      "primary_message": "While the skillet heats up, trim, seed, and slice bell peppers lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 379866,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and salt; sauté until charred and tender, 2-3 minutes. Transfer peppers to a plate and loosely cover with aluminum foil. (Reserve skillet for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 379867,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add meatballs to the skillet, spacing them out; press down with the bottom of a spatula to form ½-inch thick patties. Cook, undisturbed, until golden on one side, about 3 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 379868,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 379869,
      "primary_message": "When the burgers are done on one side, flip and top with cheese. Continue to cook until cheese melts and burgers are cooked through, 3-4 minutes more. Add burgers to the plate with the bell pepper and re-cover with foil.",
      "secondary_message": null
    },
    {
      "id": 379870,
      "primary_message": "While the burgers are cooking, add additional oil, mayo, vinegar, Dijon, salt, and pepper to the bowl with the remaining parsley, shallot, and garlic. Whisk to combine the dressing.",
      "secondary_message": "4 tsp extra virgin olive oil\n4 tsp mayonnaise\n4 tsp white wine vinegar\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 379871,
      "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 379872,
      "primary_message": "Halve tomatoes. Add to the bowl, along with the mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 379873,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 379874,
      "primary_message": "Spread additional mayo over the bottom half of each bun; top with a cheesy chicken patty and sautéed bell peppers. Close with the top half of each bun.",
      "secondary_message": "2 tbsp mayonnaise"
    },
    {
      "id": 379875,
      "primary_message": "To serve, divide smash burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
