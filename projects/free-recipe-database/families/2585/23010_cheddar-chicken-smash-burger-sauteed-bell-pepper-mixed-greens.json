  "instructions": [
    {
      "id": 379876,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n3 green bell peppers\n3 sticks celery\n1 ½ pints grape tomatoes\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 379877,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Peel, halve, and mince onion; peel and mince garlic. Divide the parsley, onion, and garlic between two large bowls. Set one bowl aside for the salad.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 379878,
      "primary_message": "Add chicken, Dijon, and spices to the remaining bowl. Use your hands to combine the chicken mixture. Form into 6 equal-sized \"meatballs\" and place on a plate. Set aside.",
      "secondary_message": "1 ½ lb ground chicken\n2 tbsp Dijon mustard\n1 ½ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 379879,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips.",
      "secondary_message": null
    },
    {
      "id": 379880,
      "primary_message": "Preheat a large skillet over high heat.",
      "secondary_message": null
    },
    {
      "id": 379881,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bell pepper and salt; sauté until charred and tender, 3-4 minutes. Transfer peppers to a large plate and loosely cover with aluminum foil. (Reserve skillet for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 379882,
      "primary_message": "Return skillet to medium-high heat, add more oil, and swirl to coat the bottom. Working in batches if necessary, add meatballs to the skillet, spacing them out; press down with the bottom of a spatula to form ½-inch thick patties. Cook, undisturbed, until golden on one side, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 379883,
      "primary_message": "Meanwhile, thinly slice cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 379884,
      "primary_message": "When the burgers are done on one side, flip and top with cheese. Continue to cook until cheese melts and burgers are cooked through, 3-4 minutes more. Add burgers to the plate with the bell pepper and re-cover with foil.",
      "secondary_message": null
    },
    {
      "id": 379885,
      "primary_message": "While the burgers are cooking, add additional oil, mayo, vinegar, Dijon, salt, and pepper to the bowl with the remaining parsley, onion, and garlic. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp mayonnaise\n2 tbsp white wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 379886,
      "primary_message": "Trim and slice celery crosswise into thin pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 379887,
      "primary_message": "Halve tomatoes. Add to the bowl, along with the mixed greens, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 379888,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 379889,
      "primary_message": "Spread additional mayo over the bottom half of each bun; top with a cheesy chicken patty and sautéed bell peppers. Close with the top half of each bun.",
      "secondary_message": "3 tbsp mayonnaise"
    },
    {
      "id": 379890,
      "primary_message": "To serve, divide smash burgers and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
