  "instructions": [
    {
      "id": 415073,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the English muffins.)",
      "secondary_message": null
    },
    {
      "id": 415074,
      "primary_message": "Split muffins and arrange on a baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "4 English muffins"
    },
    {
      "id": 415075,
      "primary_message": "Meanwhile, wash and dry blueberries.",
      "secondary_message": "2 (6 oz) pkgs blueberries"
    },
    {
      "id": 415076,
      "primary_message": "Divide cream cheese between muffin halves and spread out in an even layer.",
      "secondary_message": "⅔ (8 oz) block cream cheese"
    },
    {
      "id": 415077,
      "primary_message": "To serve, divide muffin halves between plates, top with blueberries, and drizzle with honey. Enjoy!",
      "secondary_message": "4 tsp honey"
    }
  ],
