  "instructions": [
    {
      "id": 361192,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 361193,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 yellow bell pepper\n½ lime"
    },
    {
      "id": 361194,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 361195,
      "primary_message": "Peel, halve, and slice onion lengthwise into thin pieces; add to the baking sheet with the bell pepper.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 361196,
      "primary_message": "Drizzle veggies with oil, toss to combine, and spread out in an even layer. Place baking sheet in the oven (it doesn't have to be fully heated) and bake until veggies have softened slightly, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 361197,
      "primary_message": "Meanwhile, if using frozen shrimp, place them in the colander and run under cold water to thaw them slightly and remove any ice crystals. (If using fresh shrimp, skip this step.) Place the shrimp on a clean towel or paper towels and pat dry.",
      "secondary_message": "¾ lb raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 361198,
      "primary_message": "Remove baking sheet from the oven. Arrange shrimp over the veggies, then sprinkle with Cajun seasoning and salt; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp Cajun seasoning\n½ tsp salt"
    },
    {
      "id": 361199,
      "primary_message": "Return baking sheet to the oven and continue to bake until veggies are tender and shrimp are cooked through, 5-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 361200,
      "primary_message": "Meanwhile, cut lime into wedges. ",
      "secondary_message": null
    },
    {
      "id": 361201,
      "primary_message": "Place ranch dressing and additional Cajun seasoning in a small bowl; stir to combine the spicy ranch. ",
      "secondary_message": "¼ cup ranch dressing\n½ tsp Cajun seasoning"
    },
    {
      "id": 361202,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small flour tortillas"
    },
    {
      "id": 361203,
      "primary_message": "Divide tortillas between plates and fill with shrimp and veggies; drizzle with spicy ranch and serve with a squeeze of lime. Enjoy!",
      "secondary_message": null
    }
  ],
