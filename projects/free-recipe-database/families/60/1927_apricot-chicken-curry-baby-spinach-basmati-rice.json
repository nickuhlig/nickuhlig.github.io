  "instructions": [
    {
      "id": 17782,
      "primary_message": "Rinse rice in a strainer until water runs clear and transfer to a small saucepan. Add broth and bring to a boil. Reduce heat to a simmer, stir, and cover. Cook until liquid is absorbed, 15-18 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n1 cup basmati rice"
    },
    {
      "id": 17783,
      "primary_message": "Peel and small dice onion. Peel and mince garlic and ginger. Medium dice apricots. Transfer everything to a plate.",
      "secondary_message": "1 medium yellow onion\r\n2 cloves garlic\r\n2 (1 inch) pieces ginger\r\n16 dried apricots"
    },
    {
      "id": 17784,
      "primary_message": "Heat a sauté pan over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 17785,
      "primary_message": "Trim excess fat and slice chicken into strips. Season with salt and pepper.",
      "secondary_message": "2 lb chicken thighs, boneless skinless\r\n½ tsp salt\r\n½ tsp black pepper"
    },
    {
      "id": 17786,
      "primary_message": "Coat bottom of pan with oil. Add chicken and, stirring occasionally, cook until no longer pink, 3-4 minutes. Transfer to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 17787,
      "primary_message": "Once chicken has been transferred, add more oil and onion to pan. Stirring frequently, cook until onion has softened, 3-4 minutes.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 17788,
      "primary_message": "Wash and dry spinach and cilantro. Shave cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": "1 (5 oz) pkg baby spinach\r\n1 small bunch cilantro"
    },
    {
      "id": 17789,
      "primary_message": "Add apricots, garlic, ginger, paprika, coriander, and curry powder to pan. Stir with onions until fragrant, 1-2 minutes.",
      "secondary_message": "1 tsp paprika\r\n1 tsp coriander\r\n½ tsp curry powder"
    },
    {
      "id": 17790,
      "primary_message": "Return chicken to pan. Add coconut milk, spinach, and ½ of the cilantro (save the rest for garnishing). Stir until well combined. Reduce heat to medium-low and cook until curry thickens, 5-10 minutes.",
      "secondary_message": "1 (13.5 oz) can coconut milk"
    },
    {
      "id": 17791,
      "primary_message": "Uncover rice and fluff with a fork.",
      "secondary_message": ""
    },
    {
      "id": 17792,
      "primary_message": "To serve, place the rice in a bowl, top with curry, and garnish with remaining cilantro. Enjoy!",
      "secondary_message": ""
    }
  ],
