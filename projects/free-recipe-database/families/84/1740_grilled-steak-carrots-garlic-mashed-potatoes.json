  "instructions": [
    {
      "id": 15744,
      "primary_message": "Wash, peel, and large dice potatoes. Transfer to a small saucepan, cover with water, and bring to a boil. Reduce heat to medium and cook until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to saucepan.",
      "secondary_message": "2 medium yellow potatoes"
    },
    {
      "id": 15745,
      "primary_message": "Wash carrots. Halve crosswise then halve or quarter lengthwise. Transfer to a medium bowl. Drizzle with olive oil and season with parsley flakes, salt, and pepper.",
      "secondary_message": "4 medium carrots\r\n1 tsp extra virgin olive oil\r\n¼ tsp parsley flakes\r\n⅛ tsp salt\r\n1 pinch black pepper"
    },
    {
      "id": 15746,
      "primary_message": "Heat a grill pan, outdoor grill, or skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 15748,
      "primary_message": "Peel and mince garlic. Wash and chop chives.",
      "secondary_message": "3 cloves garlic\r\n½ small pkg chives"
    },
    {
      "id": 15749,
      "primary_message": "Season steak generously with salt and pepper.",
      "secondary_message": "¾ lb ribeye steak\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 15750,
      "primary_message": "Coat grill or bottom of skillet with oil. Place steak on grill/skillet and cook until desired doneness, 2-5 minutes per side. Transfer to a plate and loosely cover with foil.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 15752,
      "primary_message": "Once steak has been transferred, place carrots on grill/skillet. Cook until tender-crisp, 4-5 minutes per side.",
      "secondary_message": ""
    },
    {
      "id": 15753,
      "primary_message": "Add broth, oil, garlic, chives, salt, and pepper to potatoes. Mash until smooth.",
      "secondary_message": "½ tbsp virgin coconut oil\n4 fl oz (½ cup) chicken or vegetable broth\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 15754,
      "primary_message": "To serve, arrange steak, carrots, and mashed potatoes on a plate. Enjoy!",
      "secondary_message": ""
    }
  ],
