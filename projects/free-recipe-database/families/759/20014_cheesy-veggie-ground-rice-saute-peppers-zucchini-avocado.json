  "instructions": [
    {
      "id": 333819,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 333820,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 333821,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ yellow bell peppers\n3 medium zucchini squash\n3 jalapeño peppers\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 333822,
      "primary_message": "Small dice bell peppers and zucchini; place both in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 333823,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Mince and add to the bowl with the pepper and zucchini. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 333824,
      "primary_message": "Preheat a large pot over medium heat; once hot, add oil and swirl to coat the bottom. Add veggie ground and spices to the pot and cook, breaking it apart with a spoon, until crumbly and cooked through, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 333825,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 ½ medium yellow onions\n3 cloves garlic"
    },
    {
      "id": 333826,
      "primary_message": "Once the veggie ground is done, transfer to a medium bowl, leaving any cooking juices in the pot. Return the pot to medium heat, add more oil, and swirl to coat the bottom. ",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 333827,
      "primary_message": "Add veggies to the pot and cook, stirring occasionally, until tender, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 333828,
      "primary_message": "Add tomatoes, salt, and pepper to the pot; stir to combine and bring to a simmer. Reduce heat and continue to cook until slightly thickened, 4-5 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 333829,
      "primary_message": "Meanwhile, coarsely grate cheddar.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 333830,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 333831,
      "primary_message": "Add cooked rice, veggie ground, cheddar, and half of the cilantro to the pot; stir to combine and remove from heat. (Reserve remaining cilantro for garnish.)",
      "secondary_message": null
    },
    {
      "id": 333832,
      "primary_message": "Halve and pit avocados; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 333833,
      "primary_message": "To serve, divide sauté between bowls and top with avocado, yogurt, and reserved cilantro. Enjoy! ",
      "secondary_message": "⅓ cup plain Greek yogurt"
    }
  ],
