  "instructions": [
    {
      "id": 333759,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "⅔ cup basmati rice\n1 ⅓ cup water"
    },
    {
      "id": 333760,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n1 medium zucchini squash\n2 jalapeño peppers\n1 small bunch cilantro\n1 avocado"
    },
    {
      "id": 333761,
      "primary_message": "Once the water for the rice comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 333762,
      "primary_message": "Small dice the bell pepper and zucchini; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 333763,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl with the bell pepper and zucchini. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing).",
      "secondary_message": null
    },
    {
      "id": 333764,
      "primary_message": "Place a large pot over medium heat, add the ground beef; cook, breaking apart with a spoon, until browned and crumbly, 7-10 minutes.",
      "secondary_message": "1 ½ lb lean ground beef"
    },
    {
      "id": 333765,
      "primary_message": "While the meat cooks, peel and small dice the onion and peel and mince (or press) the garlic; add to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 333766,
      "primary_message": "Once the meat is done, transfer to a bowl, leaving juices in the pot. Return the pot to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 333767,
      "primary_message": "Add the veggies in the bowl to the pot. Cook, stirring occasionally, until the veggies are tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 333768,
      "primary_message": "Add the tomatoes with their juices, salt, and pepper to the pot. Stir to combine and let simmer on low, 3-4 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 333769,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 333770,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 333771,
      "primary_message": "Fold the cooked rice, cooked beef, and grated cheese into the pot. ",
      "secondary_message": null
    },
    {
      "id": 333772,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 333773,
      "primary_message": "Divide into bowls and top each bowl with sliced avocado, yogurt, and chopped cilantro. Enjoy! ",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
