  "instructions": [
    {
      "id": 333804,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "⅔ cup basmati rice\n1 ⅓ cup water"
    },
    {
      "id": 333805,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 333806,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 yellow bell pepper\n2 medium zucchini squash\n2 jalapeño peppers\n1 small bunch cilantro\n1 avocado"
    },
    {
      "id": 333807,
      "primary_message": "Small dice bell pepper and zucchini; place both in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 333808,
      "primary_message": "Quarter the jalapeño peppers lengthwise; seed and remove ribs of the jalapeños with a spoon. Mince and add to the bowl with the pepper and zucchini. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 333809,
      "primary_message": "Preheat a large skillet over medium heat; once hot, add oil and swirl to coat the bottom. Add veggie ground and spices to the skillet and cook, breaking it apart with a spoon, until crumbly and cooked through, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n16 oz veggie ground, plant based\n2 tsp chili powder\n1 tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 333810,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Add both to the bowl with the other veggies.",
      "secondary_message": "1 medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 333811,
      "primary_message": "Once the veggie ground is done, transfer to a small bowl, leaving any cooking juices in the skillet. Return the skillet to medium heat, add more oil, and swirl to coat the bottom. ",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 333812,
      "primary_message": "Add veggies to the skillet and cook, stirring occasionally, until tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 333813,
      "primary_message": "Add tomatoes, salt, and pepper to the skillet; stir to combine and bring to a simmer. Reduce heat and continue to cook until slightly thickened, 3-4 minutes.",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 333814,
      "primary_message": "Meanwhile, coarsely grate cheddar.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "id": 333815,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 333816,
      "primary_message": "Add cooked rice, veggie ground, cheddar, and half of the cilantro to the skillet; stir to combine and remove from heat. (Reserve remaining cilantro for garnish.)",
      "secondary_message": null
    },
    {
      "id": 333817,
      "primary_message": "Halve and pit avocado; cut crosswise while still in the skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 333818,
      "primary_message": "To serve, divide skillet between bowls and top with avocado, yogurt, and reserved cilantro. Enjoy! ",
      "secondary_message": "¼ cup plain Greek yogurt"
    }
  ],
