  "instructions": [
    {
      "id": 333834,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "⅓ cup basmati rice\n⅔ cup water"
    },
    {
      "id": 333835,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ yellow bell pepper\n½ medium zucchini squash\n1 jalapeño pepper\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 333836,
      "primary_message": "Once the water for the rice comes to a boil, stir the mixture, cover the saucepan, and reduce the heat to low. Cook the rice until the liquid is fully absorbed, 15-18 minutes. Once done, remove the rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 333837,
      "primary_message": "Small dice the bell pepper and zucchini; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 333838,
      "primary_message": "Quarter the jalapeño pepper lengthwise; seed and remove ribs of the jalapeño with a spoon. Finely dice and add to the bowl with the bell pepper and zucchini. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 333839,
      "primary_message": "Place a skillet over medium heat, add the ground beef; cook, breaking apart with a spoon, until browned and crumbly, 5-7 minutes.",
      "secondary_message": "⅓ kg lean ground beef"
    },
    {
      "id": 333840,
      "primary_message": "While the meat cooks, peel and small dice the onion and peel and mince (or press) the garlic; add to the bowl with the other veggies.",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 333841,
      "primary_message": "Once the meat is done, transfer to a bowl, leaving juices in the skillet. Return the skillet to medium heat. ",
      "secondary_message": null
    },
    {
      "id": 333842,
      "primary_message": "Add the veggies in the bowl to the skillet. Cook, stirring occasionally, until the veggies are tender, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 333843,
      "primary_message": "Add the tomatoes with their juices, salt, and pepper to the skillet. Stir to combine and let simmer on low, 3-4 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 333844,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 333845,
      "primary_message": "Shave the cilantro leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 333846,
      "primary_message": "Fold the cooked rice, cooked beef, and grated cheese into the skillet. ",
      "secondary_message": null
    },
    {
      "id": 333847,
      "primary_message": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out with a spoon. ",
      "secondary_message": null
    },
    {
      "id": 333848,
      "primary_message": "Divide into bowls and top each bowl with sliced avocado, yogurt, and chopped cilantro. Enjoy! ",
      "secondary_message": "⅛ cup plain Greek yogurt"
    }
  ],
