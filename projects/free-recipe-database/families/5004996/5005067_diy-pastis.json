  "instructions": [
    {
      "id": 1,
      "primary_message": "With a mortar and pestle, roughly break up anise pods, licorice root, fennel, coriander, and anise seeds. Add them to a sealable glass jar along with vodka. Seal and shake, then let steep for 5 days at room temperature away from direct sunlight, shaking occasionally.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Boil sugar and water together until integrated into a light syrup, about 7 minutes. While the syrup is cooling, strain the spices out of the vodka mixture through a cheesecloth lining a fine-mesh strainer. Strain twice if necessary to remove all sediment.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Once syrup is cool, add it to the strained vodka infusion and shake. Let rest for 4 days or more before use. Store at room temperature for up to 4 months.",
      "secondary_message": null
    }
  ],
