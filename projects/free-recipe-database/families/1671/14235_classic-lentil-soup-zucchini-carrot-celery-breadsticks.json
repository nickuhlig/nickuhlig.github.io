  "instructions": [
    {
      "id": 236319,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 236320,
      "primary_message": "Meanwhile, peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 236321,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 236322,
      "primary_message": "While the onion is cooking, wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n3 sticks celery\n3 medium zucchini squash"
    },
    {
      "id": 236323,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and transfer to the pot with the onion. ",
      "secondary_message": "2 cups green lentils, dried"
    },
    {
      "id": 236324,
      "primary_message": "Add broth, diced tomatoes, and spices to the pot; stir to combine, cover, and bring soup to a boil over medium-high heat.",
      "secondary_message": "2839 ml chicken or vegetable broth\n3 (398 ml) cans diced tomatoes\n1 tbsp Italian seasoning\n2 tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 236325,
      "primary_message": "While the soup is heating, peel, trim, and slice carrots crosswise into ¼-inch pieces. Trim and slice celery crosswise into ¼-inch pieces. Add both to the soup.",
      "secondary_message": null
    },
    {
      "id": 236326,
      "primary_message": "Trim and medium dice zucchini; add to the soup.",
      "secondary_message": null
    },
    {
      "id": 236327,
      "primary_message": "Peel and mince garlic; add half the garlic to the soup (reserving the rest for the bread sticks) and stir to combine. Once the soup comes to a boil, reduce heat to a simmer, cover, and cook until veggies and lentils are tender, 20-25 minutes.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 236328,
      "primary_message": "Meanwhile, preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 236329,
      "primary_message": "Place reserved garlic in a small bowl along with oil and spices; stir to combine the garlic oil.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp rosemary, dried\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 236330,
      "primary_message": "Drizzle garlic oil over the flatbreads; cut into 1½-inch wide strips and transfer to a large baking sheet pan. Place in the oven (it doesn't have to be fully heated) and bake until crispy, 8-10 minutes. Remove from the oven.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 236331,
      "primary_message": "When the soup is done, add vinegar and stir to combine.",
      "secondary_message": "1 ½ tsp red wine vinegar"
    },
    {
      "id": 236332,
      "primary_message": "Divide soup between bowls and serve with breadsticks on the side. Enjoy!",
      "secondary_message": null
    }
  ],
