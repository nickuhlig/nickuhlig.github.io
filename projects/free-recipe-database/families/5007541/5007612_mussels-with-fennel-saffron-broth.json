  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in a large saucepan over high heat until shimmering. Add salami and cook, stirring, for 30 seconds. Add fennel, onion, and garlic. Reduce heat to medium, season with salt and pepper, and cook, stirring, until vegetables are softened but not browned, about 5 minutes. Add saffron and pepper flakes and cook until fragrant, about 30 seconds. Add pastis, orange zest, and tomatoes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Increase heat to high and bring to a boil. Add mussels, stir, cover, and cook, shaking pan constantly and peeking every 30 seconds to stir. As soon as all the mussels are open, transfer mussels to a bowl using tongs. Place pan lid over bowl to keep mussels warm.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove from heat and whisk in parsley, butter, and lemon juice. Return mussels to pot, stir to combine, then transfer to a warm serving bowl. Serve immediately with broiled bread.",
      "secondary_message": null
    }
  ],
