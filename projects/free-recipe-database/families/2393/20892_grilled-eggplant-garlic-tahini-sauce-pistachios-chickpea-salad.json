  "instructions": [
    {
      "id": 349889,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "3 eggplants\n3 lemons\n1 ½ English cucumbers\n1 ½ small pkgs grape tomatoes\n1 small pkg fresh basil"
    },
    {
      "id": 349890,
      "primary_message": "Trim and slice eggplants lengthwise into ½-inch thick planks; place on a large plate. Drizzle with oil, then season with salt and pepper.",
      "secondary_message": "¼ cup extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 349891,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349892,
      "primary_message": "Once the pan is hot, working in batches if necessary, add eggplant and grill, flipping once, until lightly charred and tender, 6-8 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 349893,
      "primary_message": "Meanwhile, drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 349894,
      "primary_message": "Juice half of the lemons into a small bowl. (Reserve remaining lemons for later use.)",
      "secondary_message": null
    },
    {
      "id": 349895,
      "primary_message": "Add mayo, tahini, water, sugar, and spices to the bowl with the lemon juice. Whisk to combine the tahini sauce and set aside.",
      "secondary_message": "⅓ cup vegan mayonnaise\n⅓ cup tahini\n1 ½ tbsp water\n1 ½ tsp brown sugar\n1 ½ tsp garlic powder\n¾ tsp salt\n¾ tsp cumin, ground"
    },
    {
      "id": 349896,
      "primary_message": "Juice remaining lemons into a large bowl. Add oil, additional tahini, and spices; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n2 tbsp tahini\n¾ tsp salt\n½ tsp black pepper\n3 pinch cinnamon, ground"
    },
    {
      "id": 349897,
      "primary_message": "Trim and small dice cucumbers; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 349898,
      "primary_message": "Halve tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349899,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, along with chickpeas, and stir to combine the salad; set aside. ",
      "secondary_message": null
    },
    {
      "id": 349900,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 349901,
      "primary_message": "To serve, divide grilled eggplant and salad between plates. Spoon tahini sauce over eggplant and sprinkle with pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
