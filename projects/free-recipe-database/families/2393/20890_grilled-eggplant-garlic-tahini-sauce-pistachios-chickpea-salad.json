  "instructions": [
    {
      "id": 349863,
      "primary_message": "Wash and dry the fresh produce. ",
      "secondary_message": "1 eggplant\n1 lemon\n½ English cucumber\n½ small pkg grape tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 349864,
      "primary_message": "Preheat a grill pan, outdoor grill, or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 349865,
      "primary_message": "While the pan heats up, trim and slice eggplant lengthwise into ½-inch thick planks; place on a plate. Drizzle with oil, then season with salt and pepper.",
      "secondary_message": "4 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 349866,
      "primary_message": "Once the pan is hot, add eggplant and grill, flipping once, until lightly charred and tender, 6-8 minutes. Return to the plate and loosely cover with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 349867,
      "primary_message": "Meanwhile, drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 349868,
      "primary_message": "Juice half of the lemon into a small bowl. (Reserve remaining lemon for later use.)",
      "secondary_message": null
    },
    {
      "id": 349869,
      "primary_message": "Add mayo, tahini, water, sugar, and spices to the bowl with the lemon juice. Whisk to combine the tahini sauce and set aside.",
      "secondary_message": "2 tbsp vegan mayonnaise\n2 tbsp tahini\n1 ½ tsp water\n½ tsp brown sugar\n½ tsp garlic powder\n¼ tsp salt\n¼ tsp cumin, ground"
    },
    {
      "id": 349870,
      "primary_message": "Juice remaining lemon into a medium bowl. Add oil, additional tahini, and spices; whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tsp tahini\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch cinnamon, ground"
    },
    {
      "id": 349871,
      "primary_message": "Trim and small dice cucumber; add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 349872,
      "primary_message": "Halve tomatoes and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 349873,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons. Add to the bowl, along with chickpeas, and stir to combine the salad; set aside. ",
      "secondary_message": null
    },
    {
      "id": 349874,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "⅛ cup pistachios, unsalted"
    },
    {
      "id": 349875,
      "primary_message": "To serve, divide grilled eggplant and salad between plates. Spoon tahini sauce over eggplant and sprinkle with pistachios. Enjoy!",
      "secondary_message": null
    }
  ],
