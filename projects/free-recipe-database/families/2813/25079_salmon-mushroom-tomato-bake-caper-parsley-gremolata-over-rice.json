  "instructions": [
    {
      "id": 402831,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 402832,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n2 cup water"
    },
    {
      "id": 402833,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 lemon"
    },
    {
      "id": 402834,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402835,
      "primary_message": "While the rice is cooking, pat salmon dry with paper towels. Transfer to one half of a large baking sheet pan, drizzle with oil, and season the top side with salt.",
      "secondary_message": "0.68 kg salmon fillet\n4 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 402836,
      "primary_message": "Add tomatoes and mushrooms to the other half of the baking sheet. Drizzle veggies with additional oil, then season with Italian seasoning and salt; stir to coat and spread out in an even layer.",
      "secondary_message": "2 (227g ) pkg sliced white mushrooms\n4 tsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 402837,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring veggies halfway through, until veggies are tender and salmon is cooked through, 12-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402838,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 402839,
      "primary_message": "Juice lemon into the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 402840,
      "primary_message": "Peel and mince shallot. Add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 402841,
      "primary_message": "Mince capers. Add to the bowl along with oil, garlic powder, and salt. Stir to combine the gremolata.",
      "secondary_message": "2 tbsp capers\n¼ cup extra virgin olive oil\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 402842,
      "primary_message": "To serve, divide rice, salmon, and veggies between plates; top salmon with gremolata. Enjoy!",
      "secondary_message": null
    }
  ],
