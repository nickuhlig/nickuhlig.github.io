  "instructions": [
    {
      "id": 402881,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 402882,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 402883,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 402884,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ small pkgs grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 402885,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402886,
      "primary_message": "While the rice is cooking, large dice tofu. Return half to the baking sheet and transfer the other half to another large baking sheet.",
      "secondary_message": null
    },
    {
      "id": 402887,
      "primary_message": "Add tomatoes and mushrooms to the baking sheets with the tofu. Drizzle with oil, then season with Italian seasoning and salt; gently stir to coat and spread out in an even layer.",
      "secondary_message": "3 (227g ) pkg sliced white mushrooms\n3 tbsp extra virgin olive oil\n1 tbsp Italian seasoning\n1 ½ tsp salt"
    },
    {
      "id": 402888,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies are tender and tofu is golden, about 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 402889,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 402890,
      "primary_message": "Juice lemons into the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 402891,
      "primary_message": "Peel and mince shallots. Add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 402892,
      "primary_message": "Mince capers. Add to the bowl along with additional oil, garlic powder, and salt. Stir to combine the gremolata.",
      "secondary_message": "3 tbsp capers\n⅓ cup extra virgin olive oil\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 402893,
      "primary_message": "To serve, divide rice, tofu, and veggies between plates; top tofu with gremolata. Enjoy!",
      "secondary_message": null
    }
  ],
