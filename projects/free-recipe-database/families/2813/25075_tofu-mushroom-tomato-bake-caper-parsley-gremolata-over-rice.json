  "instructions": [
    {
      "id": 402780,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 402781,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 402782,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water"
    },
    {
      "id": 402783,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ pint grape tomatoes\n½ small bunch Italian (flat-leaf) parsley\n½ lemon"
    },
    {
      "id": 402784,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402785,
      "primary_message": "While the rice is cooking, large dice tofu and return to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 402786,
      "primary_message": "Add tomatoes and mushrooms to the baking sheet with the tofu. Drizzle with oil, then season with Italian seasoning and salt; gently stir to coat and spread out in an even layer.",
      "secondary_message": "1 (8 oz) pkg sliced white mushrooms\n1 tbsp extra virgin olive oil\n1 tsp Italian seasoning\n½ tsp salt"
    },
    {
      "id": 402787,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until veggies are tender and tofu is golden, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 402788,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 402789,
      "primary_message": "Juice lemon into the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 402790,
      "primary_message": "Peel and mince shallot. Add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 402791,
      "primary_message": "Mince capers. Add to the bowl along with additional oil, garlic powder, and salt. Stir to combine the gremolata.",
      "secondary_message": "1 tbsp capers\n2 tbsp extra virgin olive oil\n¼ tsp garlic powder\n⅛ tsp salt"
    },
    {
      "id": 402792,
      "primary_message": "To serve, divide rice, tofu, and veggies between plates; top tofu with gremolata. Enjoy!",
      "secondary_message": null
    }
  ],
