  "instructions": [
    {
      "id": 402768,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 402769,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water"
    },
    {
      "id": 402770,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n1 small bunch Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 402771,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 402772,
      "primary_message": "While the rice is cooking, pat salmon dry with paper towels. Transfer to a large baking sheet pan, drizzle with oil, and season the top side with salt.",
      "secondary_message": "2 ¼ lb salmon fillet\n2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 402773,
      "primary_message": "Transfer tomatoes and mushrooms to another large baking sheet. Drizzle with additional oil, then season with Italian seasoning and salt; stir to coat and spread out in an even layer.",
      "secondary_message": "3 (8 oz) pkg sliced white mushrooms\n2 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n¾ tsp salt"
    },
    {
      "id": 402774,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring veggies halfway through, until veggies are tender and salmon is cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 402775,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 402776,
      "primary_message": "Juice lemons into the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 402777,
      "primary_message": "Peel and mince shallots. Add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 402778,
      "primary_message": "Mince capers. Add to the bowl along with oil, garlic powder, and salt. Stir to combine the gremolata.",
      "secondary_message": "3 tbsp capers\n⅓ cup extra virgin olive oil\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 402779,
      "primary_message": "To serve, divide rice, salmon, and veggies between plates; top salmon with gremolata. Enjoy!",
      "secondary_message": null
    }
  ],
