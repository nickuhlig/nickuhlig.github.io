  "instructions": [
    {
      "id": 370743,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 370744,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "2 medium beets\n0.23 kg sweet potato\n1 lemon\n½ small bunch Italian (flat-leaf) parsley\n½ (142 g) pkg baby arugula"
    },
    {
      "id": 370745,
      "primary_message": "Drain and rinse chickpeas. Transfer to a baking sheet pan and pat dry with paper towels. ",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 370746,
      "primary_message": "Peel, trim, and medium dice beets. Add to the baking sheet with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 370747,
      "primary_message": "Peel and medium dice sweet potato. Add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 370748,
      "primary_message": "Drizzle chickpeas and veggies with oil, then season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tsp cumin, ground\n1 tsp coriander, ground\n½ tsp salt\n¼ tsp cayenne pepper"
    },
    {
      "id": 370749,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are crisp and veggies are fork-tender, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 370750,
      "primary_message": "Meanwhile, zest and juice half of the lemon into a small bowl (set remaining lemon aside for the next step). Add yogurt, tahini, and salt; whisk to combine the tahini yogurt. Set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n3 tbsp tahini\n¼ tsp salt"
    },
    {
      "id": 370751,
      "primary_message": "Juice remaining lemon into a medium bowl. Add oil, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 370752,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. ",
      "secondary_message": null
    },
    {
      "id": 370753,
      "primary_message": "When the chickpeas and veggies are done, remove from the oven. Add half of the parsley to the baking sheet and toss to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 370754,
      "primary_message": "Add arugula to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 370755,
      "primary_message": "To serve, spoon the tahini yogurt over the bottom of each plate. Top with the dressed arugula, chickpea-veggie mixture, and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
