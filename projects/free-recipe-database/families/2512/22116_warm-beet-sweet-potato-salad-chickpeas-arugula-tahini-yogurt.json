  "instructions": [
    {
      "id": 370730,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 370731,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "6 medium beets\n1 ½ lb sweet potatoes\n3 lemons\n1 small bunch Italian (flat-leaf) parsley\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 370732,
      "primary_message": "Drain and rinse chickpeas. Divide between two large baking sheet pans and pat dry with paper towels. ",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 370733,
      "primary_message": "Peel, trim, and medium dice beets. Add to the baking sheets with the chickpeas.",
      "secondary_message": null
    },
    {
      "id": 370734,
      "primary_message": "Peel and medium dice sweet potatoes. Add to the baking sheets.",
      "secondary_message": null
    },
    {
      "id": 370735,
      "primary_message": "Drizzle chickpeas and veggies with oil, then season with spices. Toss to coat and spread out in an even layer.",
      "secondary_message": "⅓ cup extra virgin olive oil\n2 tbsp cumin, ground\n1 tbsp coriander, ground\n1 ½ tsp salt\n¾ tsp cayenne pepper"
    },
    {
      "id": 370736,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until chickpeas are crisp and veggies are fork-tender, about 30 minutes.",
      "secondary_message": null
    },
    {
      "id": 370737,
      "primary_message": "Meanwhile, zest and juice half of the lemons into a medium bowl (set remaining lemons aside for the next step). Add yogurt, tahini, and salt; whisk to combine the tahini yogurt. Set aside.",
      "secondary_message": "2 ¼ cups plain Greek yogurt\n½ cup tahini\n¾ tsp salt"
    },
    {
      "id": 370738,
      "primary_message": "Juice remaining lemons into a large bowl. Add oil, salt, and pepper; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 370739,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. ",
      "secondary_message": null
    },
    {
      "id": 370740,
      "primary_message": "When the chickpeas and veggies are done, remove from the oven. Add half of the parsley to the baking sheets and toss to combine. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 370741,
      "primary_message": "Add arugula to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 370742,
      "primary_message": "To serve, spoon the tahini yogurt over the bottom of each plate. Top with the dressed arugula, chickpea-veggie mixture, and reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
