  "instructions": [
    {
      "id": 528749,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 528750,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 528751,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 528752,
      "primary_message": "Peel and mince garlic. Add to the bowl with the basil along with cottage cheese and spices. Set aside.",
      "secondary_message": "2 cloves garlic\n2 cups cottage cheese\n1 tsp Italian seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 528753,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "2 (142 g) pkgs baby spinach"
    },
    {
      "id": 528754,
      "primary_message": "Once the water in the pot is boiling, uncover, then add salt and spinach. Stir until wilted, 30-60 seconds, then drain in a colander and rinse with cold water to cool.",
      "secondary_message": "1 tsp salt"
    },
    {
      "id": 528755,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can, then transfer to a cutting board. Roughly chop spinach and add to the bowl with the cottage cheese mixture. Stir to combine the spinach dip and set aside.",
      "secondary_message": null
    },
    {
      "id": 528756,
      "primary_message": "Peel and mince shallot. Place on a plate.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 528757,
      "primary_message": "Drain and thinly slice sun-dried tomatoes and artichoke hearts. Add both to the plate with the shallot.",
      "secondary_message": "12 sun-dried tomatoes, oil-packed\n2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 528758,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "⅔ (227 g) block mozzarella cheese"
    },
    {
      "id": 528759,
      "primary_message": "Arrange flatbreads on a large baking sheet pan. Spread with spinach dip, then top with cheese, sun-dried tomatoes, artichoke hearts, and shallots.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 528760,
      "primary_message": "Place baking sheet in the oven and bake until flatbreads are lightly crispy and cheese is melted, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 528761,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
