  "instructions": [
    {
      "id": 528723,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 528724,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 528725,
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": "1 small pkg fresh basil"
    },
    {
      "id": 528726,
      "primary_message": "Peel and mince garlic. Add to the bowl with the basil along with cottage cheese and spices. Set aside.",
      "secondary_message": "3 cloves garlic\n3 cups cottage cheese\n1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 528727,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 528728,
      "primary_message": "Once the water in the pot is boiling, uncover, then add salt and spinach. Stir until wilted, about 1 minute, then drain in a colander and rinse with cold water to cool.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 528729,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can, then transfer to a cutting board. Roughly chop spinach and add to the bowl with the cottage cheese mixture. Stir to combine the spinach dip and set aside.",
      "secondary_message": null
    },
    {
      "id": 528730,
      "primary_message": "Peel and mince shallots. Place on a plate.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 528731,
      "primary_message": "Drain and thinly slice sun-dried tomatoes and artichoke hearts. Add both to the plate with the shallot.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 528732,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (8 oz) block mozzarella cheese"
    },
    {
      "id": 528733,
      "primary_message": "Divide flatbreads between two large baking sheet pans. Spread with spinach dip, then top with cheese, sun-dried tomatoes, artichoke hearts, and shallots.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 528734,
      "primary_message": "Place baking sheets in the oven and bake until flatbreads are lightly crispy and cheese is melted, about 8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 528735,
      "primary_message": "To serve, cut flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
