  "instructions": [
    {
      "primary_message": "Wash, dry, quarter, and core apples. Slice each quarter into 4 wedges (this should yield 16 wedges per apple).",
      "secondary_message": null
    },
    {
      "primary_message": "Spread one side of each apple wedge with peanut butter (about 3/4 teaspoon per wedge). Set half aside.",
      "secondary_message": "¾ cup natural peanut butter"
    },
    {
      "primary_message": "Line marshmallows up in a row along the peel edge of the remaining apple wedges; press them gently into the peanut butter.",
      "secondary_message": "1 ½ cups mini marshmallows"
    },
    {
      "primary_message": "Top marshmallows with a second wedge of apple, making sure the peel sides align; press gently to secure the top \"lip,\" creating a \"smile.\"",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, arrange apple smiles on a platter. Enjoy!",
      "secondary_message": null
    }
  ],
