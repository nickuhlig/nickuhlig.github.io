  "instructions": [
    {
      "id": 1,
      "primary_message": "Place the sugar and water in a tall glass or julep cup and muddle until sugar is dissolved.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add mint leaves to the sugar syrup and gently press to release the flavorful oil (don't get too aggressive: smashing up the mint releases bitterness in the leaves)",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add the spirits and stir to combine. Fill glass with crushed ice and stir with bar spoon until the glass begins to frost, adding more crushed ice if needed. Garnish with a fresh sprig of mint; serve with a straw.",
      "secondary_message": null
    }
  ],
