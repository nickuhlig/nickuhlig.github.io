  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Cut the stewing beef into 1/2 inch cubes.",
      "secondary_message": "113 g stewing beef"
    },
    {
      "id": 1,
      "primary_message": "Bring a medium-sized pot of water to boil. Add the whole block of konnyaku or the package of shirataki and parboil for 10 minutes. Drain and discard the water.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Cut the konnyaku lengthwise into two rectangular blocks, then cut each block into pieces 1.5-cm thick. Score each piece in a cross-hatch pattern to allow the flavors of the simmering liquid to penetrate more deeply. Set aside. If using shirataki, set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Place a heavy pan, such as a cast iron skillet, over high heat. Add cooking oil or fat to the pan. Add the cubed beef to the pan and lightly brown on two sides; then remove with a slotted spoon. Using the remaining fat in the pan, lightly saute the parboiled and drained konnyaku or shirataki so that the surface is blistered and slightly browned. Remove and set aside.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place the beef and the konnyaku or shirataki along with all the marinade ingredients into a medium saucepan. Bring the pot to a boil; then lower the heat to a simmer and cook for 1 to 1 1/2 hours, until the beef and konnyaku are tender. For a vegetarian option, substitute daikon and lotus root for the beef and add the vegetables during the latter half of simmering.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Add the miso paste to the simmering liquid and stir to dissolve. Simmer for a few minutes, correcting for taste. Depending on how salty your soy sauce and miso paste are, you may need to add a teaspoon or more of sugar. Serve hot.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Note: The squares of konnyaku may be browned in a hot cast iron pan, or set under the broiler for a few minutes to recrisp the surface.",
      "secondary_message": null
    }
  ],
