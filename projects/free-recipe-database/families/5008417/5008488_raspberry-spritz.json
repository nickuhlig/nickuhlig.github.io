  "instructions": [
    {
      "id": 1,
      "primary_message": "For the raspberry mint syrup: In a medium saucepan, combine raspberries, sugar, and water over medium-high heat. Mash raspberries with a wooden spoon to break up. Bring to a boil and then remove from heat. Add mint leaves and stir to combine. Cover and let stand for 30 minutes. Using a fine-mesh strainer, strain into an airtight container. Syrup keeps up to 1 month in the refrigerator.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Cocktail: Fill a rocks glass or goblet with ice. Add sparkling wine, club soda, Cocchi Americano, and Raspberry-Mint Syrup. Gently stir to combine. Garnish with raspberries and a sprig of mint.",
      "secondary_message": null
    }
  ],
