  "instructions": [
    {
      "primary_message": "Fill a large pot halfway with water, season water with salt, cover and bring to a boil. Add pasta and stir for a few seconds. Cook, uncovered, until desired firmness, 8-10 minutes.",
      "secondary_message": "salt"
    },
    {
      "primary_message": "While pasta is cooking, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Chop the bacon into 1-inch pieces; add to the skillet and cook until crispy, 4-5 minutes. Once done, transfer to a plate lined with paper towels. Reserve 1 tbsp of bacon fat.",
      "secondary_message": "4 slices bacon"
    },
    {
      "primary_message": "Meanwhile, crack the eggs into a medium bowl; add 1 ½ tbsp cream and whisk to combine.",
      "secondary_message": "2 eggs"
    },
    {
      "primary_message": "Finely grate Parmesan and transfer to the bowl with egg mixture. Season with salt and pepper; whisk to combine.",
      "secondary_message": "43 g Parmesan cheese\nsalt\n¼ tsp black pepper"
    },
    {
      "primary_message": "When pasta is done, drain in a colander, reserving ½ cup of cooking liquid. ",
      "secondary_message": null
    },
    {
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "primary_message": "Add the reserved bacon fat to empty pasta pot. Return pot to heat, reduce heat to low. Add garlic, stirring until fragrant, about 1-2 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Return pasta and bacon to pot. Remove pot from heat, add the egg mixture to pasta, stirring frequently. Stir just until the egg mixture begins to thicken, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "If the sauce seems dry, add some of the reserved pasta water 1 tbsp at a time, until rich and creamy. ",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Reserve a small amount for garnish and add the rest to the pot with the pasta.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "primary_message": "To serve, divide pasta between bowls and garnish with remaining parsley. Enjoy!",
      "secondary_message": null
    }
  ],
