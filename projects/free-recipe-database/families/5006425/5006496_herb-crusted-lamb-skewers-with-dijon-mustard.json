  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Marinade: Whisk together oil, lemon juice, garlic, salt, and pepper in a small bowl. Place lambs cubes in a large resealable plastic bag. Pour in marinade and seal bag, removing as much air as possible. Place in refrigerator and marinate for at least 1 and up to 5 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Herb Mixture: Mix together thyme, sage, and rosemary in a small bowl. Set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Remove lamb from marinade and thread onto skewers.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange coals on one side of the charcoal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Grill skewers over direct heat until lamb is well seared on all sides, about 3 minutes per side.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Move skewers to cool side of grill and brush with mustard. Sprinkle all over with herb mixture. Cover grill and continue to cook until center of lamb registers 54°C on an instant-read thermometer. Transfer skewers to platter and let rest for 5 minutes. Serve immediately.",
      "secondary_message": null
    }
  ],
