  "instructions": [
    {
      "id": 386094,
      "primary_message": "Place mayo, miso paste, vinegar, sugar, garlic powder, and pepper in a medium bowl. Stir to combine the dressing and set aside.",
      "secondary_message": "¼ cup mayonnaise\n2 tbsp miso paste, white\n1 tsp rice vinegar\n½ tsp brown sugar\n½ tsp garlic powder\n¼ tsp black pepper"
    },
    {
      "id": 386095,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n1 English cucumber\n1 small pkg chives"
    },
    {
      "id": 386096,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386097,
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "2 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 386098,
      "primary_message": "Trim and slice cucumber crosswise into ½-inch thick rounds. Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 386099,
      "primary_message": "To serve, divide cucumber slices between plates. Top each slice with a spoonful of tuna salad, then sprinkle with chives and sesame seeds. Enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
