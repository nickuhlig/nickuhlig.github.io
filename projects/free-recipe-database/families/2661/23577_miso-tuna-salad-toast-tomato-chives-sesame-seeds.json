  "instructions": [
    {
      "id": 386007,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 386008,
      "primary_message": "Place mayo, miso paste, vinegar, sugar, garlic powder, and pepper in a medium bowl. Stir to combine the dressing and set aside.",
      "secondary_message": "⅓ cup mayonnaise\n3 tbsp miso paste, white\n1 ½ tsp rice vinegar\n¾ tsp brown sugar\n¾ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 386009,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 sticks celery\n1 ½ pints grape tomatoes\n1 small pkg chives"
    },
    {
      "id": 386010,
      "primary_message": "Trim and small dice celery. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 386011,
      "primary_message": "Drain tuna, add to the bowl, and flake with a fork. Stir to combine the tuna salad and set aside.",
      "secondary_message": "3 (6 oz) cans chunk light tuna in water"
    },
    {
      "id": 386012,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 386013,
      "primary_message": "Meanwhile, halve tomatoes lengthwise. Chop chives into small pieces.",
      "secondary_message": null
    },
    {
      "id": 386014,
      "primary_message": "Divide tuna salad between toast slices and spread out in an even layer. Top with tomatoes, chives, and sesame seeds.",
      "secondary_message": "1 ½ tsp sesame seeds"
    },
    {
      "id": 386015,
      "primary_message": "To serve, divide tuna salad toast between plates and enjoy!",
      "secondary_message": null
    }
  ],
