  "instructions": [
    {
      "id": 329347,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 329348,
      "primary_message": "In a medium saucepan, bring broth and spices to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n1 ½ tsp coriander, ground\n¾ tsp salt\n¾ tsp black pepper\n1 ½ cups whole wheat couscous"
    },
    {
      "id": 329349,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 oranges\n3 yellow bell peppers\n1 small bunch green onions (scallions)\n1 small pkg fresh basil\n3 avocados"
    },
    {
      "id": 329350,
      "primary_message": "Zest oranges into a large bowl, then add oil, vinegar, and spices; whisk to combine the dressing. (Reserve oranges for the next step.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n¾ tsp salt\n½ tsp black pepper\n3 pinch cayenne pepper"
    },
    {
      "id": 329351,
      "primary_message": "Cut off skin and white pith from the oranges; slice between the membranes to release segments. Cut each segment crosswise into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 329352,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 329353,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 329354,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329355,
      "primary_message": "While the skillet heats up, cut the tofu planks in half, then cut each half into two triangles; place on a plate and sprinkle cornstarch and spices over both sides.",
      "secondary_message": "3 tbsp cornstarch\n1 tbsp cumin, ground\n1 ½ tsp turmeric, ground\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 329356,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and cook, flipping once, until golden brown and crispy, 8-10 minutes. Remove from heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 329357,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl with the orange and bell pepper.",
      "secondary_message": null
    },
    {
      "id": 329358,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and small dice the flesh. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 329359,
      "primary_message": "To serve, divide couscous, tofu, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
