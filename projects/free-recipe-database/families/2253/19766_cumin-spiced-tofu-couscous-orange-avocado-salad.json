  "instructions": [
    {
      "id": 329396,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 329397,
      "primary_message": "In a small saucepan, bring broth and spices to a boil. Remove from heat, add couscous, and stir. Cover and let stand for 10 minutes; fluff with a fork right before serving.",
      "secondary_message": "237 ml chicken or vegetable broth\n½ tsp coriander, ground\n¼ tsp salt\n¼ tsp black pepper\n½ cup whole wheat couscous"
    },
    {
      "id": 329398,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 orange\n1 yellow bell pepper\n½ small bunch green onions (scallions)\n½ small pkg fresh basil\n1 avocado"
    },
    {
      "id": 329399,
      "primary_message": "Zest orange into a medium bowl, then add oil, vinegar, and spices; whisk to combine the dressing. (Reserve orange for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp white wine vinegar\n¼ tsp salt\n⅛ tsp black pepper\n1 pinch cayenne pepper"
    },
    {
      "id": 329400,
      "primary_message": "Cut off skin and white pith from the orange; slice between the membranes to release segments. Cut each segment crosswise into bite-sized pieces and add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 329401,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 329402,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 329403,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 329404,
      "primary_message": "While the skillet heats up, cut the tofu planks in half, then cut each half into two triangles; place on a plate and sprinkle cornstarch and spices over both sides.",
      "secondary_message": "1 tbsp cornstarch\n1 tsp cumin, ground\n½ tsp turmeric, ground\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 329405,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, flipping once, until golden brown and crispy, 8-10 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 329406,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl with the orange and bell pepper.",
      "secondary_message": null
    },
    {
      "id": 329407,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and small dice the flesh. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 329408,
      "primary_message": "To serve, divide couscous, tofu, and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
