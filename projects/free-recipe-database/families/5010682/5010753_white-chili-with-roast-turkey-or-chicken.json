  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat oil in a large Dutch oven or saucepan over medium-high heat until shimmering. Add onions, jalapeño, and poblano peppers and cook, stirring frequently, until pale golden brown, about 12 minutes total. Add chopped Hatch or canned chiles, garlic, cumin, and coriander, and cook, stirring frequently, until fragrant, about 2 minutes. Add stock, beans and their liquid, half of cilantro, and turkey. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Bring to a boil, reduce to a bare simmer, and cook, stirring occasionally, until thickened and flavors have melded, about 30 minutes. Stir in lime juice and remaining cilantro and season to taste with salt and pepper. Serve with grated cheese and lime wedges.",
      "secondary_message": null
    }
  ],
