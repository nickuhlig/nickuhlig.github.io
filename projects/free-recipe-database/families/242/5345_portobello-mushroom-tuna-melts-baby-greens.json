  "instructions": [
    {
      "id": 64248,
      "primary_message": "Preheat broiler and position rack about 15 cm from the top.",
      "secondary_message": ""
    },
    {
      "id": 64247,
      "primary_message": "Wash and dry mushrooms; remove stems. Place mushroom caps on a baking sheet pan and brush with a little olive oil. Place in the oven and broil until almost tender, 6-8 minutes.",
      "secondary_message": "12 caps portobello mushrooms\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 64246,
      "primary_message": "Small dice mushroom stems and transfer to a large bowl.",
      "secondary_message": ""
    },
    {
      "id": 64237,
      "primary_message": "Wash and dry celery and parsley. Small dice and add the celery to bowl with mushrooms. Shave parsley leaves off the stems; discard the stems, mince the leaves, and add to bowl. Peel, mince, and add garlic to bowl.",
      "secondary_message": "6 sticks celery\n1 ½ small bunch Italian (flat-leaf) parsley\n6 cloves garlic"
    },
    {
      "id": 64245,
      "primary_message": "Drain tuna and add to bowl.",
      "secondary_message": "6 (170 g) cans chunk light tuna in water"
    },
    {
      "id": 64244,
      "primary_message": "Drizzle tuna with lemon juice and olive oil and season with salt and pepper; toss to combine.",
      "secondary_message": "juice of 1 ½ lemon\n3 tbsp extra virgin olive oil\n¾ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 64243,
      "primary_message": "Wash and slice tomatoes into rounds.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 64242,
      "primary_message": "Grate 1 ½ cups of mozzarella.",
      "secondary_message": "¾ (227 g) block mozzarella cheese"
    },
    {
      "id": 64241,
      "primary_message": "Remove the mushrooms from the oven. Divide tuna mixture evenly among the mushrooms and stuff inside. Top with tomato slices and sprinkle mozzarella over top.",
      "secondary_message": ""
    },
    {
      "id": 64240,
      "primary_message": "Return to oven and broil until cheese melts and begins to turn golden brown, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 64239,
      "primary_message": "Wash and dry mixed greens.",
      "secondary_message": "1 ½ (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 64238,
      "primary_message": "Arrange a bed of mixed greens on a plate and place mushroom caps on top. Enjoy!",
      "secondary_message": ""
    }
  ],
