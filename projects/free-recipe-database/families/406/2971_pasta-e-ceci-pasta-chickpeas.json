  "instructions": [
    {
      "id": 29134,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n½ small pkg fresh rosemary"
    },
    {
      "id": 29173,
      "primary_message": "Small dice the celery and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 29137,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 29132,
      "primary_message": "Peel and small dice the onion; add to the bowl with the celery.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 29138,
      "primary_message": "Add olive oil to the pan and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 29139,
      "primary_message": "Add the celery and onion to the pan; cook, stirring frequently, until the vegetables have softened, 4 to 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 29133,
      "primary_message": "Peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 29135,
      "primary_message": "Slide the rosemary leaves off the sprigs; discard the sprigs and mince the leaves. Add to the garlic.",
      "secondary_message": null
    },
    {
      "id": 29140,
      "primary_message": "Add the garlic, rosemary, and crushed red pepper to the pan; stir and cook until fragrant, 1 to 2 minutes.",
      "secondary_message": "⅛ tsp crushed red pepper"
    },
    {
      "id": 29141,
      "primary_message": "Add the chickpeas and their liquid to the pan, followed by the tomatoes and broth; stir to combine.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n1 (14.5 oz) can diced tomatoes\n12 fl oz (1 ½ cups) chicken or vegetable broth"
    },
    {
      "id": 29142,
      "primary_message": "Season the sauce with salt and pepper, then break apart some of the tomatoes and chickpeas with a potato masher or fork. Bring the sauce to a simmer.",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 29170,
      "primary_message": "Add the pasta directly to the sauté pan and mix with the sauce. Cook the pasta in the sauce according to package directions, about 8 to 12 minutes.",
      "secondary_message": "6 oz (2 ¼ cups) penne pasta"
    },
    {
      "id": 29172,
      "primary_message": "To serve, scoop the pasta into a bowl. Enjoy!",
      "secondary_message": null
    }
  ],
