  "instructions": [
    {
      "id": 192836,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces; transfer to the saucepan. Add approx, 1-inch of water in the pan, cover and bring to a boil over high heat; steam until fork-tender, 8-10 minutes.",
      "secondary_message": "½ medium head cauliflower"
    },
    {
      "id": 192837,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192838,
      "primary_message": "Chop the bacon into 1-inch pieces. Add to the skillet and cook until crispy, 3-5 minutes.",
      "secondary_message": "6 slices bacon"
    },
    {
      "id": 192839,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 192840,
      "primary_message": "Coarsely grate the cheddar and set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "id": 192841,
      "primary_message": "When the cauliflower is cooked, drain water and set aside, uncovered, to allow moisture to evaporate for 1-2 minutes. When most of the moisture has evaporated, mash cauliflower until it resembles the consistency of mashed potatoes.",
      "secondary_message": null
    },
    {
      "id": 192842,
      "primary_message": "Add the butter, yogurt, salt, and pepper and stir to combine.",
      "secondary_message": "2 tsp butter, unsalted\n⅛ cup plain Greek yogurt\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 192843,
      "primary_message": "Add the cauliflower mixture to an ovenproof baking dish or individual ramekins, top with cheese and put under the broiler until cheese melts and is bubbly about 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 192844,
      "primary_message": "Wash and trim green onions; cut crosswise into ¼-inch pieces at an angle. ",
      "secondary_message": "½ small bunch green onions (scallions)"
    },
    {
      "id": 192845,
      "primary_message": "Carefully remove the cauliflower from oven and top with crispy bacon and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
