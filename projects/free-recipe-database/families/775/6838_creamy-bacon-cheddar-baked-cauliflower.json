  "instructions": [
    {
      "id": 192816,
      "primary_message": "Wash cauliflower and cut off the leaves. Separate into small florets and cut the thick stems into smaller pieces; transfer to the pot. Add approx, 1-inch of water in the pot, cover and bring to a boil over high heat; steam until fork-tender, 8-10 minutes.",
      "secondary_message": "2 medium heads cauliflower"
    },
    {
      "id": 192817,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 192818,
      "primary_message": "Chop the bacon into 1-inch pieces. Add to the skillet and cook until crispy, stirring occasionally 3-5 minutes.",
      "secondary_message": "6 slices bacon"
    },
    {
      "id": 192819,
      "primary_message": "Preheat oven to broil and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 192820,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "1 (227 g) block cheddar cheese"
    },
    {
      "id": 192821,
      "primary_message": "When the cauliflower is cooked, drain water and set aside, uncovered, to allow moisture to evaporate for 1-2 minutes. When most of the moisture has evaporated, mash cauliflower until it resembles the consistency of mashed potatoes.",
      "secondary_message": null
    },
    {
      "id": 192822,
      "primary_message": "Add the butter, yogurt, salt, and pepper; stir to combine.",
      "secondary_message": "¼ cup butter, unsalted\n½ cup plain Greek yogurt\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 192823,
      "primary_message": "Add the cauliflower mixture to an ovenproof baking dish or individual ramekins, top with cheese and place under the broiler until cheese is melted, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 192824,
      "primary_message": "Wash and trim green onions; cut crosswise into ¼-inch pieces at an angle. ",
      "secondary_message": "1 small bunch green onions (scallions)"
    },
    {
      "id": 192825,
      "primary_message": "Carefully remove the cauliflower from oven and top with crispy bacon and green onions. Enjoy!",
      "secondary_message": null
    }
  ],
