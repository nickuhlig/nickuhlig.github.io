  "instructions": [
    {
      "primary_message": "Preheat oven to 350°F. Coat a large (9 x 13-inch) baking dish with cooking spray. \n\n",
      "secondary_message": "1 spritz nonstick cooking spray"
    },
    {
      "primary_message": "Place cake mix, pineapple (with the juice), and vanilla in a medium bowl, then stir until just combined (be careful not to over-mix). Pour batter into the baking dish and spread out in an even layer. \n\n",
      "secondary_message": "1 (454 g) box angel food cake mix\n1 (567 g) can crushed pineapple\n1 tsp vanilla extract"
    },
    {
      "primary_message": "Place cake in the preheated oven and bake until golden and a toothpick inserted in the center comes out clean, about 30 minutes. Remove from oven and let cool completely, about 1 hour.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, using a fine mesh strainer, lightly dust the cake with powdered sugar. Cut into pieces, share, and enjoy!\n\n",
      "secondary_message": "1 tbsp powdered sugar"
    }
  ],
