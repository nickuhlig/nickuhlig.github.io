  "instructions": [
    {
      "id": 502515,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n1 stick celery\n1 medium carrot"
    },
    {
      "id": 502516,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Place in a medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 502517,
      "primary_message": "Trim and small dice celery. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 502518,
      "primary_message": "Peel, trim, and small dice carrot. Add to the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 502519,
      "primary_message": "Preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 502520,
      "primary_message": "While the pan heats up, peel, halve, and small dice onion. Add to the bowl with the celery and carrot.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 502521,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add celery, carrot, onion, and spices; cook, stirring occasionally, until starting to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp neutral vegetable oil\n¼ tsp thyme, dried\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 502522,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces. Season with spices.",
      "secondary_message": "0.45 kg chicken thighs, boneless skinless\n¼ tsp garlic powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 502523,
      "primary_message": "When the veggies have started to soften, add chicken to the pan. Cook, stirring occasionally, until chicken is almost cooked through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 502524,
      "primary_message": "Add zucchini noodles, broth, and hot sauce to the pan. Stir to combine the soup and bring to a simmer over high heat. Once simmering, reduce heat to medium-low and continue to cook until chicken is cooked through and veggies are tender, 4-5 minutes more. Remove from heat.",
      "secondary_message": "710 ml chicken or vegetable broth\n¼ cup hot sauce"
    },
    {
      "id": 502525,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 502526,
      "primary_message": "To serve, divide soup between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
