  "instructions": [
    {
      "id": 502503,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium zucchini squash\n3 sticks celery\n3 medium carrots"
    },
    {
      "id": 502504,
      "primary_message": "Trim zucchini and use a julienne (or regular) peeler to make noodles. Place in a large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 502505,
      "primary_message": "Trim and small dice celery. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 502506,
      "primary_message": "Peel, trim, and small dice carrots. Add to the bowl with the celery.",
      "secondary_message": null
    },
    {
      "id": 502507,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 502508,
      "primary_message": "While the pot heats up, peel, halve, and small dice onions. Add to the bowl with the celery and carrot.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 502509,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add celery, carrot, onion, and spices; cook, stirring occasionally, until starting to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp neutral vegetable oil\n¾ tsp thyme, dried\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 502510,
      "primary_message": "Meanwhile, pat chicken dry with paper towels and cut into bite-sized pieces. Season with spices.",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp garlic powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 502511,
      "primary_message": "When the veggies have started to soften, add chicken to the pot. Cook, stirring occasionally, until chicken is almost cooked through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 502512,
      "primary_message": "Add zucchini noodles, broth, and hot sauce to the pot. Stir to combine the soup and bring to a simmer over high heat. Once simmering, reduce heat to medium-low and continue to cook until chicken is cooked through and veggies are tender, 4-5 minutes more. Remove from heat.",
      "secondary_message": "72 fl oz (9 cups) chicken or vegetable broth\n¾ cup hot sauce"
    },
    {
      "id": 502513,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "4 ½ oz Parmesan cheese"
    },
    {
      "id": 502514,
      "primary_message": "To serve, divide soup between bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
