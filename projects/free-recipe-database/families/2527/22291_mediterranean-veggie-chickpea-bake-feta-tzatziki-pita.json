  "instructions": [
    {
      "id": 373113,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 373114,
      "primary_message": "Drain and rinse chickpeas. Transfer to a baking sheet pan.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 373115,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Add to the baking sheet with the chickpeas.",
      "secondary_message": "2 green bell peppers"
    },
    {
      "id": 373116,
      "primary_message": "Wash and dry tomatoes. Add to the baking sheet.",
      "secondary_message": "1 small pkg grape tomatoes"
    },
    {
      "id": 373117,
      "primary_message": "Peel, halve, and thinly slice onion lengthwise. Add to the baking sheet, drizzle with vinaigrette, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "1 medium red onion\n3 tbsp balsamic vinaigrette\n¾ tsp oregano, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 373118,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are tender and tomatoes start to burst, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 373119,
      "primary_message": "Meanwhile, arrange pitas on another baking sheet. Add to the oven and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven, cut into wedges, and set aside.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 373120,
      "primary_message": "When the chickpeas and veggies are done, remove from oven. Sprinkle with feta and toss to combine.",
      "secondary_message": "½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 373121,
      "primary_message": "Divide chickpea and veggie bake between plates or bowls. Serve with pita wedges and tzatziki on the side. Enjoy!",
      "secondary_message": "½ cup tzatziki sauce"
    }
  ],
