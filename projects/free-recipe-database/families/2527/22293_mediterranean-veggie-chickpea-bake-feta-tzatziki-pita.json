  "instructions": [
    {
      "id": 373131,
      "primary_message": "Preheat oven to 230°C (450°F). Arrange racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 373132,
      "primary_message": "Drain and rinse chickpeas. Divide between two large baking sheet pans.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 373133,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into ½-inch thick strips. Add to the baking sheets with the chickpeas.",
      "secondary_message": "6 green bell peppers"
    },
    {
      "id": 373134,
      "primary_message": "Wash and dry tomatoes. Add to the baking sheets.",
      "secondary_message": "3 small pkgs grape tomatoes"
    },
    {
      "id": 373135,
      "primary_message": "Peel, halve, and thinly slice onions lengthwise. Add to the baking sheets, drizzle with vinaigrette, and season with spices. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 medium red onions\n½ cup balsamic vinaigrette\n2 tsp oregano, dried\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 373136,
      "primary_message": "Place baking sheets on lower racks of the oven (it doesn't have to be fully heated) and roast, tossing once, until veggies are tender and tomatoes start to burst, about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 373137,
      "primary_message": "Meanwhile, arrange pitas on another large baking sheet. Place on upper rack of the oven and bake, flipping halfway through, until slightly crispy, about 5 minutes. Remove from oven, cut into wedges, and set aside.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 373138,
      "primary_message": "When the chickpeas and veggies are done, remove from oven. Sprinkle with feta and toss to combine.",
      "secondary_message": "1 ½ (113 g) pkg crumbled feta cheese"
    },
    {
      "id": 373139,
      "primary_message": "Divide chickpea and veggie bake between plates or bowls. Serve with pita wedges and tzatziki on the side. Enjoy!",
      "secondary_message": "1 ½ cups tzatziki sauce"
    }
  ],
