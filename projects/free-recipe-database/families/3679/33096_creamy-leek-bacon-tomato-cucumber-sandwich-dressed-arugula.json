  "instructions": [
    {
      "id": 523489,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 523490,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 leeks\n3 tomatoes\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 523491,
      "primary_message": "Once the skillet is hot, working in batches if necessary, add bacon and cook, turning occasionally, until crispy, 4-5 minutes. Remove to a paper towel-lined plate. (Reserve skillet with drippings for later use.)",
      "secondary_message": "18 slices bacon"
    },
    {
      "id": 523492,
      "primary_message": "Meanwhile, trim off root end and dark green tops of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 523493,
      "primary_message": "When the bacon is done, return the skillet (with drippings) to medium-high heat. Add leeks and pepper; cook, stirring occasionally, until tender, 5-6 minutes. Remove from heat and set aside to cool slightly, 2-3 minutes.",
      "secondary_message": "¾ tsp black pepper"
    },
    {
      "id": 523494,
      "primary_message": "While the leeks are cooking, slice tomatoes crosswise into thin rounds. Place on a plate.",
      "secondary_message": null
    },
    {
      "id": 523495,
      "primary_message": "Trim and halve cucumbers lengthwise, then cut crosswise into thin half-moons. Add to the plate with the tomato and set aside.",
      "secondary_message": null
    },
    {
      "id": 523496,
      "primary_message": "Finely grate Parmesan. Place in a medium bowl along with yogurt, vinegar, honey, and Dijon, then stir to combine the yogurt dressing.",
      "secondary_message": "3 oz Parmesan cheese\n⅓ cup plain Greek yogurt\n2 tbsp red wine vinegar\n1 tbsp honey\n1 ½ tsp Dijon mustard"
    },
    {
      "id": 523497,
      "primary_message": "Once the leeks have cooled, add to the bowl with the yogurt dressing. Stir to combine the leek spread and set aside.",
      "secondary_message": null
    },
    {
      "id": 523498,
      "primary_message": "Place oil, vinegar, salt, and pepper in a large bowl. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 523499,
      "primary_message": "Add arugula to the bowl with the dressing and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 523500,
      "primary_message": "Toast bread if desired.",
      "secondary_message": "12 slices whole grain bread"
    },
    {
      "id": 523501,
      "primary_message": "Place bread on a flat surface. Divide leek spread between half of the slices and spread out in an even layer. Top spread with tomato, cucumber, bacon, and a small handful of the arugula, then close sandwiches with remaining slices of bread. Cut in half. (Reserve remaining arugula for serving.)",
      "secondary_message": null
    },
    {
      "id": 523502,
      "primary_message": "To serve, divide sandwiches and reserved arugula between plates. Enjoy!",
      "secondary_message": null
    }
  ],
