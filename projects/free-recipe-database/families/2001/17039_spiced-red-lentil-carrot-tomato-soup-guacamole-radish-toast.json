  "instructions": [
    {
      "id": 277233,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium carrot\n1 stick celery\n1 avocado\n½ lemon\n½ bunch radish"
    },
    {
      "id": 277234,
      "primary_message": "Peel, halve, and small dice onion; peel and mince garlic. Place both in a small bowl. ",
      "secondary_message": "½ medium yellow onion\n1 clove garlic"
    },
    {
      "id": 277235,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 277236,
      "primary_message": "While the pan heats up, peel, trim, and small dice carrot; trim and small dice celery. Add both to the bowl with the onion and garlic. ",
      "secondary_message": null
    },
    {
      "id": 277237,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and cook, stirring occasionally, until starting to soften, 3-4 minutes. (Reserve bowl for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 277238,
      "primary_message": "Using a strainer or colander, rinse lentils under cold water; drain and set aside. ",
      "secondary_message": "⅔ cup red lentils, dried"
    },
    {
      "id": 277239,
      "primary_message": "When the veggies have softened, add lentils, broth, tomatoes, and spices to the pan; stir to combine, cover, and bring to a boil over medium-high heat. Once boiling, reduce heat to a simmer, cover, and cook, stirring occasionally, until lentils are tender, 15-20 minutes.",
      "secondary_message": "710 ml chicken or vegetable broth\n1 (398 ml) can diced tomatoes\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n1 ½ tsp paprika\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 277240,
      "primary_message": "Meanwhile, halve and pit avocado. Scoop out the flesh and place in the reserved bowl; mash with a fork.",
      "secondary_message": null
    },
    {
      "id": 277241,
      "primary_message": "Peel and mince additional garlic; add to the bowl with the avocado.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 277242,
      "primary_message": "Juice half of the lemon into the bowl; add salt, stir to combine the guacamole, and set aside. (Reserve remaining lemon for the soup.)",
      "secondary_message": "⅛ tsp salt"
    },
    {
      "id": 277243,
      "primary_message": "Preheat oven to broil on high and position rack under the broiler. Arrange bread slices on a baking sheet pan and place in the oven; broil until toasted, flipping halfway, 1-2 minutes. Remove from oven. ",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 277244,
      "primary_message": "Trim and small dice radishes.",
      "secondary_message": null
    },
    {
      "id": 277245,
      "primary_message": "Once the lentils are tender, juice remaining lemon into the pan and stir to combine the soup. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 277246,
      "primary_message": "Divide guacamole between toast slices and top with radish; season with salt and pepper.",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 277247,
      "primary_message": "Divide soup between bowls and serve with guacamole-radish toast on the side. Enjoy!",
      "secondary_message": null
    }
  ],
