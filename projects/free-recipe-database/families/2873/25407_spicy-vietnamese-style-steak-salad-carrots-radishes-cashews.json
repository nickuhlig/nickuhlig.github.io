  "instructions": [
    {
      "id": 483687,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n6 medium carrots\n1 ½ bunches radish\n3 heads butter (Boston) lettuce\n1 small bunch cilantro\n1 small pkg fresh mint"
    },
    {
      "id": 483688,
      "primary_message": "Juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 483689,
      "primary_message": "Peel and mince shallots and garlic. Add both to the bowl with the lime juice along with fish sauce, soy sauce, sugar, and crushed red pepper. Whisk to combine the dressing and set aside.",
      "secondary_message": "2 shallots\n3 cloves garlic\n3 tbsp fish sauce\n3 tbsp soy sauce\n2 tbsp brown sugar\n1 ½ tsp crushed red pepper"
    },
    {
      "id": 483690,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 483691,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 483692,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and set aside to rest, about 5 minutes.",
      "secondary_message": "1 tbsp toasted sesame oil"
    },
    {
      "id": 483693,
      "primary_message": "Meanwhile, peel and trim carrots; run the peeler along each carrot to make long, noodle-like strips. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 483694,
      "primary_message": "Trim and thinly slice radishes. Add to the bowl with the carrot.",
      "secondary_message": null
    },
    {
      "id": 483695,
      "primary_message": "Chop or tear lettuce leaves into bite-sized pieces; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 483696,
      "primary_message": "Pick cilantro and mint leaves off the stems; discard stems and roughly chop the leaves. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 483697,
      "primary_message": "Roughly chop cashews. Add to the bowl, gently toss to combine the salad, and set aside.",
      "secondary_message": "¾ cup cashews, roasted unsalted"
    },
    {
      "id": 483698,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 483699,
      "primary_message": "Divide salad and steak between plates or bowls. Drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
