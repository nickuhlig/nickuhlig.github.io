  "instructions": [
    {
      "id": 474391,
      "primary_message": "Preheat oven to 450°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 474392,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n8 fl oz (1 cup) chicken or vegetable broth"
    },
    {
      "id": 474393,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 small bunch asparagus\n1 orange bell pepper\n½ lemon"
    },
    {
      "id": 474394,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 474395,
      "primary_message": "While the rice is cooking, snap (or cut) off woody ends of the asparagus; cut spears in half crosswise. Transfer to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 474396,
      "primary_message": "Trim, seed, and large dice bell pepper. Add to the baking sheet with the asparagus. Drizzle veggies with oil, season with salt and pepper, then spread out on one half of the baking sheet.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 474397,
      "primary_message": "Pat cod dry with paper towels and cut into portions (if necessary). Season with spices on both sides. Transfer to the other half of the baking sheet.",
      "secondary_message": "¾ lb cod fillet\n1 tsp Cajun seasoning\n½ tsp garlic powder\n¼ tsp salt"
    },
    {
      "id": 474398,
      "primary_message": "Small dice bacon, then sprinkle over the cod. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 474399,
      "primary_message": "Place baking sheet in the oven and bake, stirring veggies halfway through, until cod is cooked through, bacon is crisp, and veggies are tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 474400,
      "primary_message": "Remove baking sheet from the oven, then juice lemon over the cod and veggies.",
      "secondary_message": null
    },
    {
      "id": 474401,
      "primary_message": "To serve, divide cod, veggies, and rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
