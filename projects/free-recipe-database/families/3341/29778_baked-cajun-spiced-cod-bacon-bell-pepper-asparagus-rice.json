  "instructions": [
    {
      "id": 474447,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 474448,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n710 ml chicken or vegetable broth"
    },
    {
      "id": 474449,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 small bunches asparagus\n3 orange bell peppers\n1 ½ lemons"
    },
    {
      "id": 474450,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 474451,
      "primary_message": "While the rice is cooking, snap (or cut) off woody ends of the asparagus; cut spears in half crosswise. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 474452,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the baking sheet with the asparagus. Drizzle with oil, season with salt and pepper, then spread out in an even layer. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 474453,
      "primary_message": "Coat another baking sheet with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 474454,
      "primary_message": "Pat cod dry with paper towels and cut into portions (if necessary). Season with spices on both sides, then transfer to the oiled baking sheet.",
      "secondary_message": "1.02 kg cod fillet\n1 tbsp Cajun seasoning\n1 ½ tsp garlic powder\n¾ tsp salt"
    },
    {
      "id": 474455,
      "primary_message": "Small dice bacon, then sprinkle over the cod. ",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 474456,
      "primary_message": "Place baking sheets in the oven and bake, stirring veggies halfway through, until cod is cooked through, bacon is crisp, and veggies are tender, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 474457,
      "primary_message": "Remove baking sheets from the oven, then juice lemons over the cod and veggies.",
      "secondary_message": null
    },
    {
      "id": 474458,
      "primary_message": "To serve, divide cod, veggies, and rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
