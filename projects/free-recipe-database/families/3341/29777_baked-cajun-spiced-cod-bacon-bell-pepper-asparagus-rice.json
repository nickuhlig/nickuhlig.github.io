  "instructions": [
    {
      "id": 474436,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 474437,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add broth and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup basmati rice\n473 ml chicken or vegetable broth"
    },
    {
      "id": 474438,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 small bunches asparagus\n2 orange bell peppers\n1 lemon"
    },
    {
      "id": 474439,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 474440,
      "primary_message": "While the rice is cooking, snap (or cut) off woody ends of the asparagus; cut spears in half crosswise. Transfer to the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 474441,
      "primary_message": "Trim, seed, and large dice bell peppers. Add to the baking sheet with the asparagus. Drizzle veggies with oil, season with salt and pepper, then spread out on one half of the baking sheet.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 474442,
      "primary_message": "Pat cod dry with paper towels and cut into portions (if necessary). Season with spices on both sides. Transfer to the other half of the baking sheet.",
      "secondary_message": "0.68 kg cod fillet\n2 tsp Cajun seasoning\n1 tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 474443,
      "primary_message": "Small dice bacon, then sprinkle over the cod. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "id": 474444,
      "primary_message": "Place baking sheet in the oven and bake, stirring veggies halfway through, until cod is cooked through, bacon is crisp, and veggies are tender, 12-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 474445,
      "primary_message": "Remove baking sheet from the oven, then juice lemon over the cod and veggies.",
      "secondary_message": null
    },
    {
      "id": 474446,
      "primary_message": "To serve, divide cod, veggies, and rice between plates. Enjoy!",
      "secondary_message": null
    }
  ],
