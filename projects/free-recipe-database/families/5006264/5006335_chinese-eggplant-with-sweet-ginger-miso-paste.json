  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Halve the Chinese eggplants lengthwise.",
      "secondary_message": "6 Chinese eggplants"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, whisk together sugar, sake, mirin, and rice vinegar until sugar is dissolved. Add shiro miso and ginger and whisk until well combined. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In another small bowl, combine vegetable and sesame oils. Score the flesh side of eggplants in a cross-cross pattern every 1/2 an inch or so. Brush each piece of eggplant all over with the oil mixture.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and spread the coals evenly over entire surface of coal grate. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Grill eggplants, flesh side down, over high heat until golden brown, 3 to 5 minutes. Flip and continue to grill until very tender, 3 to 5 minutes more.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Place the eggplants, flesh side up, on a platter. Spread each half with about 1 tablespoon of the ginger-miso paste. Sprinkle lightly with toasted sesame seed and serve immediately.",
      "secondary_message": null
    }
  ],
