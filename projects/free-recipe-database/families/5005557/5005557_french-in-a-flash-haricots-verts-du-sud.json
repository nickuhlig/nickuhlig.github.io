  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Chop the shallots. Grate the garlic. Puree the cherry tomatoes in a blender until almost smooth.",
      "secondary_message": "4 small shallots\n3 cloves garlic\n¾ lb cherry tomatoes"
    },
    {
      "id": 1,
      "primary_message": "Heat the oil in a wide high-sided sauté pan over medium-high heat until it shimmers. Add the shallots, and sauté for 3 1/2 minutes, stirring often.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add the garlic, and 15 second later, add the tomato paste. Cook for 15 seconds, then add the haricots verts. Toss with the tomato paste mixture, and add the wine. Cook for 1 minute, then add the cherry tomatoes, and season with salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Reduce the heat to medium-low, and simmer, covered, for 30 minutes. Remove the lid, and simmer another 5 minutes. Serve hot or at room temperature.",
      "secondary_message": null
    }
  ],
