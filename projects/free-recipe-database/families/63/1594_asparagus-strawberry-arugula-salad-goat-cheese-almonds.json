  "instructions": [
    {
      "id": 14302,
      "primary_message": "Wash asparagus, snap off woody ends, and cut diagonally into 5 cm pieces.",
      "secondary_message": "2 small bunches asparagus"
    },
    {
      "id": 14303,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 14304,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lemon juice, olive oil, vinegar, honey, salt, and pepper. Set aside.",
      "secondary_message": "2 cloves garlic\r\njuice of 1 lemon\r\n6 tbsp extra virgin olive oil\r\n1 tbsp balsamic vinegar\r\n4 tsp honey\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 14305,
      "primary_message": "Coat bottom of skillet with oil. Add asparagus and, stirring occasionally, cook until tender and bright green, 5-6 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 14306,
      "primary_message": "Wash and dry arugula. Wash, trim stem ends, and thinly slice strawberries.",
      "secondary_message": "1 (142 g) pkg baby arugula\r\n1 (454 g) pkg strawberries"
    },
    {
      "id": 14307,
      "primary_message": "In a large bowl, combine and toss arugula, strawberries, and asparagus.",
      "secondary_message": ""
    },
    {
      "id": 14308,
      "primary_message": "To serve, arrange salad on a plate, crumble goat cheese over top, sprinkle with almonds, and drizzle with dressing. Enjoy!",
      "secondary_message": "1 (113 g) log goat cheese\r\n½ cup almonds"
    }
  ],
