  "instructions": [
    {
      "primary_message": "Wash, dry, quarter, and core Asian pear; medium dice. Transfer to a large pitcher.",
      "secondary_message": "1 Asian pear"
    },
    {
      "primary_message": "Slice dried pears into thin strips. Add to the pitcher along with honey. Using a long stirring spoon, gently stir the fruit until coated in honey. ",
      "secondary_message": "½ cup dried pears\n2 tbsp honey"
    },
    {
      "primary_message": "Slowly pour alcohol-removed wine into the pitcher (so it doesn't splash), then gently stir to combine. ",
      "secondary_message": "1 (750 ml) bottle alcohol-removed dry white wine"
    },
    {
      "primary_message": "Wash and dry thyme. Remove 4 sprigs to use for garnish (refrigerate until ready to serve). Add remaining thyme sprigs to the pitcher; use the stirring spoon to push the thyme into the sangria while keeping the leaves attached to the stems.",
      "secondary_message": "½ small pkg fresh thyme"
    },
    {
      "primary_message": "Cover the pitcher with a lid or piece of plastic wrap and refrigerate for a minimum of 2 hours (or up to overnight for best results).",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to serve, remove thyme sprigs from the sangria and discard. ",
      "secondary_message": null
    },
    {
      "primary_message": "Add ginger beer to the pitcher and stir to combine the sangria, making sure to scrape up any honey that has settled to the bottom.",
      "secondary_message": "1 (8 fl oz) bottle ginger beer"
    },
    {
      "primary_message": "Fill wine glasses or glasses of choice with ice (if desired) and slowly pour sangria over top, allowing fruit to fall into the glasses. Garnish with reserved fresh thyme and enjoy!",
      "secondary_message": null
    }
  ],
