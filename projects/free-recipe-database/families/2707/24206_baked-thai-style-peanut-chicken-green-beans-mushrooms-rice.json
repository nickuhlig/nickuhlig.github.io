  "instructions": [
    {
      "id": 392892,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 392893,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water\n¼ tsp salt"
    },
    {
      "id": 392894,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 392895,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 lime\n2 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 lb green beans\n1 lb cremini mushrooms"
    },
    {
      "id": 392896,
      "primary_message": "Zest and juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 392897,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the lime.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 392898,
      "primary_message": "Add peanut butter, water, soy sauce, maple syrup, chili-garlic sauce, and oil to the bowl. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "¼ cup natural peanut butter\n4 tsp water\n4 tsp soy sauce\n4 tsp pure maple syrup\n2 tsp chili-garlic sauce\n1 tsp toasted sesame oil"
    },
    {
      "id": 392899,
      "primary_message": "Trim and cut green onions crosswise into 1-inch pieces. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 392900,
      "primary_message": "Trim and cut green beans into 1-inch pieces. Add to the baking sheet with the onions.",
      "secondary_message": null
    },
    {
      "id": 392901,
      "primary_message": "Quarter mushrooms and add to the baking sheet. Drizzle veggies with additional oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "4 tsp toasted sesame oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 392902,
      "primary_message": "Pat chicken dry with paper towels and place in a medium bowl; season with salt and pepper, then add half of the peanut sauce. Stir to coat, then add the chicken to the baking sheet, nestling it into the veggies. (Set remaining peanut sauce aside for serving.)",
      "secondary_message": "2 lb chicken thighs, boneless skinless\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 392903,
      "primary_message": "Place baking sheet in the oven and roast, stirring veggies halfway through, until veggies are tender and chicken is cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 392904,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates. Spoon reserved sauce over the chicken and enjoy!",
      "secondary_message": null
    }
  ],
