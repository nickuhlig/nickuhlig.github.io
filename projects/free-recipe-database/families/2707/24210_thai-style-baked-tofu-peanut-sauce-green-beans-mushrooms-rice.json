  "instructions": [
    {
      "id": 392948,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 392949,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 392950,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 392951,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 392952,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 ½ lb green beans\n1 ½ lb cremini mushrooms"
    },
    {
      "id": 392953,
      "primary_message": "Zest and juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 392954,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the lime.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 392955,
      "primary_message": "Add peanut butter, water, soy sauce, maple syrup, chili-garlic sauce, and oil to the bowl. Whisk to combine the peanut sauce.",
      "secondary_message": "⅓ cup natural peanut butter\n2 tbsp water\n2 tbsp soy sauce\n2 tbsp pure maple syrup\n1 tbsp chili-garlic sauce\n1 ½ tsp toasted sesame oil"
    },
    {
      "id": 392956,
      "primary_message": "Cut tofu planks in half, then cut each half into 2 triangles. Place in a large bowl, season with salt and pepper, then add half of the peanut sauce (reserve remaining sauce for serving). Stir tofu to coat, then set aside to marinate. (Reserve baking sheet for the next step.)",
      "secondary_message": "¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 392957,
      "primary_message": "Trim and cut green onions crosswise into 1-inch pieces. Place half of the onions on the reserved baking sheet and the other half on a second large baking sheet.",
      "secondary_message": null
    },
    {
      "id": 392958,
      "primary_message": "Trim and cut green beans into 1-inch pieces. Add to the baking sheets with the onions.",
      "secondary_message": null
    },
    {
      "id": 392959,
      "primary_message": "Quarter mushrooms and add to the baking sheets. Drizzle veggies with additional oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 392960,
      "primary_message": "Divide tofu between the baking sheets, nestling it into the veggies.",
      "secondary_message": null
    },
    {
      "id": 392961,
      "primary_message": "Place baking sheets in the oven and roast, stirring veggies halfway through, until veggies are tender and tofu is golden, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 392962,
      "primary_message": "To serve, divide rice, tofu, and veggies between plates. Drizzle remaining sauce over the tofu and enjoy!",
      "secondary_message": null
    }
  ],
