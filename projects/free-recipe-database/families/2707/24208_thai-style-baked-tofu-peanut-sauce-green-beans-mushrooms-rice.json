  "instructions": [
    {
      "id": 392918,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 392919,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 392920,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water\n⅛ tsp salt"
    },
    {
      "id": 392921,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 392922,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ lime\n1 (1 inch) piece ginger root\n½ small bunch green onions (scallions)\n½ lb green beans\n½ lb cremini mushrooms"
    },
    {
      "id": 392923,
      "primary_message": "Zest and juice lime into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 392924,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the lime.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 392925,
      "primary_message": "Add peanut butter, water, soy sauce, maple syrup, chili-garlic sauce, and oil to the bowl. Whisk to combine the peanut sauce.",
      "secondary_message": "2 tbsp natural peanut butter\n2 tsp water\n2 tsp soy sauce\n2 tsp pure maple syrup\n1 tsp chili-garlic sauce\n½ tsp toasted sesame oil"
    },
    {
      "id": 392926,
      "primary_message": "Cut tofu planks in half, then cut each half into 2 triangles. Place in a medium bowl, season with salt and pepper, then add half of the peanut sauce (reserve remaining sauce for serving). Stir tofu to coat, then set aside to marinate. (Reserve baking sheet for the next step.)",
      "secondary_message": "¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 392927,
      "primary_message": "Trim and cut green onions crosswise into 1-inch pieces. Transfer to the reserved baking sheet.",
      "secondary_message": null
    },
    {
      "id": 392928,
      "primary_message": "Trim and cut green beans into 1-inch pieces. Add to the baking sheet with the onions.",
      "secondary_message": null
    },
    {
      "id": 392929,
      "primary_message": "Quarter mushrooms and add to the baking sheet. Drizzle veggies with additional oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tsp toasted sesame oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 392930,
      "primary_message": "Transfer tofu to the baking sheet, nestling it into the veggies.",
      "secondary_message": null
    },
    {
      "id": 392931,
      "primary_message": "Place baking sheet in the oven and roast, stirring veggies halfway through, until veggies are tender and tofu is golden, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 392932,
      "primary_message": "To serve, divide rice, tofu, and veggies between plates. Drizzle remaining sauce over the tofu and enjoy!",
      "secondary_message": null
    }
  ],
