  "instructions": [
    {
      "id": 392905,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 392906,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and salt, then bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water\n½ tsp salt"
    },
    {
      "id": 392907,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 392908,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n3 (1 inch) pieces ginger root\n1 small bunch green onions (scallions)\n1 ½ lb green beans\n1 ½ lb cremini mushrooms"
    },
    {
      "id": 392909,
      "primary_message": "Zest and juice limes into a small bowl.",
      "secondary_message": null
    },
    {
      "id": 392910,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the lime.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 392911,
      "primary_message": "Add peanut butter, water, soy sauce, maple syrup, chili-garlic sauce, and oil to the bowl. Whisk to combine the peanut sauce and set aside.",
      "secondary_message": "⅓ cup natural peanut butter\n2 tbsp water\n2 tbsp soy sauce\n2 tbsp pure maple syrup\n1 tbsp chili-garlic sauce\n1 ½ tsp toasted sesame oil"
    },
    {
      "id": 392912,
      "primary_message": "Trim and cut green onions crosswise into 1-inch pieces. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 392913,
      "primary_message": "Trim and cut green beans into 1-inch pieces. Add to the baking sheets with the onions.",
      "secondary_message": null
    },
    {
      "id": 392914,
      "primary_message": "Quarter mushrooms and add to the baking sheets. Drizzle veggies with additional oil, then season with salt and pepper; toss to coat and spread out in an even layer.",
      "secondary_message": "2 tbsp toasted sesame oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 392915,
      "primary_message": "Pat chicken dry with paper towels and place in a large bowl; season with salt and pepper, then add half of the peanut sauce. Stir to coat, then add the chicken to the baking sheets, nestling it into the veggies. (Set remaining peanut sauce aside for serving.)",
      "secondary_message": "3 lb chicken thighs, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 392916,
      "primary_message": "Place baking sheets in the oven and roast, stirring veggies halfway through, until veggies are tender and chicken is cooked through, about 20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 392917,
      "primary_message": "To serve, divide rice, chicken, and veggies between plates. Spoon reserved sauce over the chicken and enjoy!",
      "secondary_message": null
    }
  ],
