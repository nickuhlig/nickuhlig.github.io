  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Finely dice the white onion. Mince the garlic. Grate the extra-sharp cheddar cheese on large holes of a box grater. Shred the iceberg lettuce. Halve and slice the tomato.",
      "secondary_message": "1 medium white onion\n2 medium cloves garlic\n226 g extra-sharp cheddar cheese\n2 cups iceberg lettuce\n1 large tomato"
    },
    {
      "id": 1,
      "primary_message": "In a large nonstick skillet over medium-high, heat oil until shimmering. Add onion and garlic and cook, stirring constantly to avoid browning, until tender and fragrant, about 3 minutes. Add ground beef and cook, using a wooden spoon to break up meat into small pieces, until the beef starts to brown, about 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Add chile powder, salt, ground cumin, black pepper, smoked paprika, dried oregano, ketchup, and 1 cup water. Cook, using a wooden spoon to scrape and stir bottom of the skillet. Bring to a boil over high heat and cook until liquid slightly thickens, about 3 minutes. Remove from heat, season to taste, and cover to keep warm; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "For the Cheese Sauce: In a medium saucepan, toss grated cheddar with cornstarch to evenly coat. Add 1 1/4 cups evaporated milk, salt, black pepper, and smoked paprika. Cook on low heat, whisking constantly, until melted and smooth, about 5 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide cooked rice equally among 4 plates. Top each with taco meat, followed by the cheese sauce, lettuce, and sliced tomato. Garnish with salsa and crushed tortilla chips.",
      "secondary_message": null
    }
  ],
