  "instructions": [
    {
      "id": 219137,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219138,
      "primary_message": "While the skillet heats up, peel and thinly slice onion into half rings.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 219139,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 219140,
      "primary_message": "Meanwhile, wash and dry spinach (skip if it came pre-washed). Peel and mince garlic.",
      "secondary_message": "2 (5 oz) pkgs baby spinach\n4 cloves garlic"
    },
    {
      "id": 219141,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add garlic and spices, stir to combine, and remove from heat. Transfer spinach mixture to a medium bowl and set aside.",
      "secondary_message": "1 tsp Italian seasoning\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 219142,
      "primary_message": "Place eggs, salt, and pepper in a large bowl; whisk to combine and set aside.",
      "secondary_message": "12 eggs\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 219143,
      "primary_message": "Wipe skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219144,
      "primary_message": "While the skillet heats up, use the tip of a knife to slice down the length of each sausage. Peel off the casings and discard.",
      "secondary_message": "4 pork sausages"
    },
    {
      "id": 219145,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add sausage meat and cook, breaking apart with a spoon, until browned and cooked through, about 5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 219146,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 219147,
      "primary_message": "Drain and thinly slice artichokes; add artichokes and spinach mixture (leaving any juices in the bowl) to the skillet with the sausage; stir to combine. ",
      "secondary_message": "2 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 219148,
      "primary_message": "Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, about 7 minutes.",
      "secondary_message": null
    },
    {
      "id": 219149,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 219150,
      "primary_message": "Sprinkle Parmesan over the frittata. Place skillet in the oven and broil until the top is set, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 219151,
      "primary_message": "To serve, cut frittata into wedges, place on plates, and enjoy!",
      "secondary_message": null
    }
  ],
