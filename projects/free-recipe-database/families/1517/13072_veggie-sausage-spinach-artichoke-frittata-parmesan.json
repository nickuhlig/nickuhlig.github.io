  "instructions": [
    {
      "id": 219257,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219258,
      "primary_message": "While the skillet heats up, peel and thinly slice onion into half rings.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 219259,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add onion and cook, stirring occasionally, until soft, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 219260,
      "primary_message": "Meanwhile, wash and dry spinach (skip if it came pre-washed). Peel and mince garlic.",
      "secondary_message": "1 (142 g) pkg baby spinach\n2 cloves garlic"
    },
    {
      "id": 219261,
      "primary_message": "Add spinach to the skillet in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add garlic and spices, stir to combine, and remove from heat. Transfer spinach mixture to a medium bowl and set aside.",
      "secondary_message": "½ tsp Italian seasoning\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 219262,
      "primary_message": "Place eggs, salt, and pepper in another medium bowl; whisk to combine and set aside.",
      "secondary_message": "6 eggs\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 219263,
      "primary_message": "Wipe skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219264,
      "primary_message": "While the skillet heats up, small dice sausages.",
      "secondary_message": "2 pre-cooked vegan sausage"
    },
    {
      "id": 219265,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add sausage to the skillet and cook, stirring occasionally, until golden brown and crispy, 3-4 minutes (or cook sausages according to package instructions).",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 219266,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 219267,
      "primary_message": "Drain and thinly slice artichokes; add artichokes and spinach mixture (leaving any juices in the bowl) to the skillet with the sausage; stir to combine. ",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 219268,
      "primary_message": "Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 219269,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "57 g Parmesan cheese"
    },
    {
      "id": 219270,
      "primary_message": "Sprinkle Parmesan over the frittata. Place skillet in the oven and broil until the top is set, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 219271,
      "primary_message": "To serve, cut frittata into wedges, place on plates, and enjoy!",
      "secondary_message": null
    }
  ],
