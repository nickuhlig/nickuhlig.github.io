  "instructions": [
    {
      "id": 219287,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219288,
      "primary_message": "While the pot heats up, peel and thinly slice onions into half rings.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 219289,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onions and cook, stirring occasionally, until soft, 5-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 219290,
      "primary_message": "Meanwhile, wash and dry spinach (skip if it came pre-washed). Peel and mince garlic.",
      "secondary_message": "3 (142 g) pkg baby spinach\n6 cloves garlic"
    },
    {
      "id": 219291,
      "primary_message": "Add spinach to the pot in handfuls, waiting for the spinach to wilt slightly before adding the next handful. Add garlic and spices, stir to combine, and remove from heat; set aside.",
      "secondary_message": "1 ½ tsp Italian seasoning\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 219292,
      "primary_message": "Place eggs, salt, and pepper in a large bowl; whisk to combine and set aside.",
      "secondary_message": "18 eggs\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 219293,
      "primary_message": "Small dice sausages.",
      "secondary_message": "6 pre-cooked vegan sausage"
    },
    {
      "id": 219294,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 219295,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add sausage to the skillet and cook, stirring occasionally, until golden brown and crispy, 4-5 minutes (or cook sausages according to package instructions).",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 219296,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 219297,
      "primary_message": "Drain and thinly slice artichokes; add artichokes and spinach mixture (leaving any juices in the pot) to the skillet with the sausage; stir to combine. ",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 219298,
      "primary_message": "Reduce heat to medium-low and pour in the egg mixture. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but the top is still runny, about 7-9 minutes.",
      "secondary_message": null
    },
    {
      "id": 219299,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "170 g Parmesan cheese"
    },
    {
      "id": 219300,
      "primary_message": "Sprinkle Parmesan over the frittata. Place skillet in the oven and broil until the top is set, about 3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 219301,
      "primary_message": "To serve, cut frittata into wedges, place on plates, and enjoy!",
      "secondary_message": null
    }
  ],
