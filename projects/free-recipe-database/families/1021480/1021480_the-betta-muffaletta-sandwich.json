  "instructions": [
    {
      "primary_message": "Preheat your oven broiler (if serving the sandwich warm). Place roll halves, cut side up, on a baking sheet.",
      "secondary_message": null
    },
    {
      "primary_message": "Spread a tablespoon (or slightly heaping) tablespoon of the olive spread over the top of each roll half. Top with Salami slices then turkey slices. Then top that with the mozzarella and provolone cheese slices.",
      "secondary_message": null
    },
    {
      "primary_message": "Broil about 6-inches from the heat until cheese bubbling (watch carefully), about 3 minutes.",
      "secondary_message": null
    },
    {
      "primary_message": "Serve the open-faced sandwiches with your favorite Italian dressing for dipping your sandwich in or drizzling over the top or put two halves together to make 3 whole sandwiches.",
      "secondary_message": null
    }
  ],
