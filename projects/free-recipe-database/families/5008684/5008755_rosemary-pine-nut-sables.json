  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature. Bring the egg yolks to room temperature.",
      "secondary_message": "16 tbsp unsalted butter\n2 large egg yolks"
    },
    {
      "id": 1,
      "primary_message": "In a large bowl, cream together butter and and sugar with a handheld electric mixer, about 2 minutes. Beat in egg yolks and salt. Add flour and beat just until combined. Add rosemary and pine nuts and stir until evenly distributed. Roll dough into a 4-cm wide log, cover with plastic wrap, and chill for two hours in the refrigerator.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Preheat oven to 175°C (350°F). Line a baking sheet with parchment paper. Use a sharp knife to slice log into 1-cm thick pieces. Bake cookies until golden, turning sheet once during baking, about 18 minutes. Transfer to a wire rack and let cool.",
      "secondary_message": null
    }
  ],
