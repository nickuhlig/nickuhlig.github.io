  "instructions": [
    {
      "id": 25600,
      "primary_message": "Preheat the oven to 500°F, position rack in the centre, and place a baking sheet inside to warm up.",
      "secondary_message": ""
    },
    {
      "id": 25601,
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger.",
      "secondary_message": "2 cloves garlic\r\n1 (1 inch) piece ginger root"
    },
    {
      "id": 25602,
      "primary_message": "In a medium bowl, whisk together water and arrowroot. Add the minced garlic and ginger, honey, rice vinegar, and soy sauce; whisk again.",
      "secondary_message": "2 tbsp cold water\r\n½ tsp arrowroot starch/powder\r\n1 tbsp honey\r\n1 tbsp rice vinegar\r\n2 tbsp soy sauce"
    },
    {
      "id": 25603,
      "primary_message": "Add the chicken to the sauce and toss to coat.",
      "secondary_message": "1 ¼ lb chicken drumsticks\r\n"
    },
    {
      "id": 25604,
      "primary_message": "Remove baking sheet from the oven and line with foil. Add the chicken, reserving the sauce in the bowl.",
      "secondary_message": ""
    },
    {
      "id": 25605,
      "primary_message": "Place in the oven and bake until chicken is golden brown and cooked through, 20-25 minutes. Spoon teriyaki sauce over the chicken a couple times during cooking until there is no more sauce left.",
      "secondary_message": ""
    },
    {
      "id": 25606,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 25607,
      "primary_message": "Wash the snap peas.",
      "secondary_message": "2 (8 oz) pkg sugar snap peas\r\n"
    },
    {
      "id": 25608,
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the peas and season with salt and pepper. Cook, tossing occasionally, until bright green and tender-crisp, 4-5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\r\n¼ tsp salt\r\n¼ tsp black pepper"
    },
    {
      "id": 25609,
      "primary_message": "Serve chicken drumsticks with sugar snap peas on the side. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "1 tsp sesame seeds\r\n"
    }
  ],
