  "instructions": [
    {
      "primary_message": "Preheat the oven to 500°F, position rack in the centre, and place a baking sheet inside to warm up.",
      "secondary_message": null
    },
    {
      "primary_message": "Peel and mince the garlic. Peel and mince or grate the ginger.",
      "secondary_message": "2 cloves garlic\n1 (1 inch) piece ginger root"
    },
    {
      "primary_message": "In a medium bowl, whisk together water and cornstarch. Add the minced garlic and ginger, honey, rice vinegar, and soy sauce; whisk again.",
      "secondary_message": "½ tsp cornstarch\n1 tbsp honey\n1 tbsp rice vinegar"
    },
    {
      "primary_message": "Add the chicken to the sauce and toss to coat.",
      "secondary_message": "1 ¼ lb chicken drumsticks"
    },
    {
      "primary_message": "Remove baking sheet from the oven and line with foil. Add the chicken, reserving the sauce in the bowl.",
      "secondary_message": null
    },
    {
      "primary_message": "Place in the oven and bake until chicken is golden brown and cooked through, 25-30 minutes. Spoon teriyaki sauce over the chicken a couple times during cooking until there is no more sauce left.",
      "secondary_message": null
    },
    {
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "Wash the snap peas.",
      "secondary_message": "2 (8 oz) pkg sugar snap peas"
    },
    {
      "primary_message": "Add oil to the skillet and swirl to coat bottom. Add the peas and season with salt and pepper. Cook, tossing occasionally, until bright green and tender-crisp, 4-5 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "Serve chicken drumsticks with sugar snap peas on the side. Sprinkle with sesame seeds and enjoy!",
      "secondary_message": "1 tsp sesame seeds"
    }
  ],
