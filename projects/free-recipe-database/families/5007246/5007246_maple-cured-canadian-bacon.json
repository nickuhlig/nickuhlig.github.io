  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Smash the garlic. Trim the boneless pork loin of excess fat.",
      "secondary_message": "3 medium cloves garlic\n1 boneless pork loin"
    },
    {
      "id": 1,
      "primary_message": "To make the cure, combine 1 quart of water, kosher salt, maple syrup, brown sugar, pink salt, bay leaves, garlic, and peppercorns in a medium saucepan. Bring to a boil over high heat, stirring to dissolve salt and sugar. Boil for 1 minute, then remove from heat. Transfer to a large container and stir in remaining 3 quarts of water. Place in refrigerator until completely chilled. Fully submerge pork loin in cure and let sit in refrigerator for 3 to 5 days.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Remove pork from cure and place in large container. Add enough fresh water to fully submerge loin. Let sit for 30 minutes, then remove pork from water and pat dry with paper towels.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fire up the smoker or grill to 225°F, adding chunks of smoking wood when at temperature. When wood is ignited and producing smoke, place pork in and cook until an instant-read thermometer registers 140°F when inserted into thickest part of the pork loin, about 2 to 3 hours.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Let pork cool for 30 minutes. Slice and pan fry before serving.",
      "secondary_message": null
    }
  ],
