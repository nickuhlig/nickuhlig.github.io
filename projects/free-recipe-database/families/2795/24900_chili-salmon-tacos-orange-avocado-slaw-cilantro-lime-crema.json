  "instructions": [
    {
      "id": 400846,
      "primary_message": "Preheat oven to 450°F. Line a large baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 400847,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n1 ½ jalapeño peppers\n6 oranges\n1 small bunch cilantro\n1 ½ avocados"
    },
    {
      "id": 400848,
      "primary_message": "Juice half of the limes into a small bowl. Add yogurt and salt; stir to combine the crema and set aside. (Reserve remaining limes for later use.)",
      "secondary_message": "¾ cup plain Greek yogurt\n½ tsp salt"
    },
    {
      "id": 400849,
      "primary_message": "Place oil and spices in large bowl, then stir to combine the spice oil.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 ½ tbsp chili powder\n2 tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 400850,
      "primary_message": "Pat salmon dry with paper towels. Cut into 1-inch thick fingers and add to the bowl with the spice oil. Stir to coat, then transfer to the baking sheet.",
      "secondary_message": "2 ¼ lb salmon fillet"
    },
    {
      "id": 400851,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400852,
      "primary_message": "Meanwhile, peel, halve, and mince onion. Place in a clean large bowl.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 400853,
      "primary_message": "Juice reserved limes into the bowl with the onion, then add oil and salt. Stir to combine the dressing.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp salt"
    },
    {
      "id": 400854,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 400855,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400856,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400857,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with the broccoli slaw, and gently stir to combine.",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw"
    },
    {
      "id": 400858,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 400859,
      "primary_message": "Divide tortillas between plates, then fill with salmon and a small portion of slaw; drizzle with lime crema. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
