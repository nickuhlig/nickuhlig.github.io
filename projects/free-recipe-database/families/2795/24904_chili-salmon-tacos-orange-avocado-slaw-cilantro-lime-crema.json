  "instructions": [
    {
      "id": 400896,
      "primary_message": "Preheat oven to 230°C (450°F). Line a baking sheet pan with aluminum foil.",
      "secondary_message": null
    },
    {
      "id": 400897,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n½ jalapeño pepper\n2 oranges\n½ small bunch cilantro\n½ avocado"
    },
    {
      "id": 400898,
      "primary_message": "Juice half of the lime into a small bowl. Add yogurt and salt; stir to combine the crema and set aside. (Reserve remaining lime for later use.)",
      "secondary_message": "¼ cup plain Greek yogurt\n⅛ tsp salt"
    },
    {
      "id": 400899,
      "primary_message": "Place oil and spices in medium bowl, then stir to combine the spice oil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil\n1 ½ tsp chili powder\n¾ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 400900,
      "primary_message": "Pat salmon dry with paper towels. Cut into 1-inch thick fingers and add to the bowl with the spice oil. Stir to coat, then transfer to the baking sheet.",
      "secondary_message": "⅓ kg salmon fillet"
    },
    {
      "id": 400901,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until salmon is cooked through, about 8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 400902,
      "primary_message": "Meanwhile, peel and mince shallot. Place in a clean medium bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 400903,
      "primary_message": "Juice reserved lime into the bowl with the shallot, then add oil and salt. Stir to combine the dressing.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp salt"
    },
    {
      "id": 400904,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon. Mince and add to the bowl with the dressing. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 400905,
      "primary_message": "Peel oranges, separate into segments, and roughly chop the flesh. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400906,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 400907,
      "primary_message": "Halve and pit avocado; using a spoon, scoop out the flesh and medium dice. Add to the bowl, along with the broccoli slaw, and gently stir to combine.",
      "secondary_message": "½ (340 g) pkg broccoli slaw"
    },
    {
      "id": 400908,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 400909,
      "primary_message": "Divide tortillas between plates, then fill with salmon and a small portion of slaw; drizzle with lime crema. Serve with remaining slaw on the side and enjoy!",
      "secondary_message": null
    }
  ],
