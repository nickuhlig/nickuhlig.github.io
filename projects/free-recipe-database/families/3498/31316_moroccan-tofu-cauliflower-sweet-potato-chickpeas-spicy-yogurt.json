  "instructions": [
    {
      "id": 495033,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 495034,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "2 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 495035,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg sweet potato\n1 medium head cauliflower\n1 lemon\n1 small bunch cilantro"
    },
    {
      "id": 495036,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 495037,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 495038,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl along with oil and spices, then stir to combine. Transfer to a large baking sheet and spread out in an even layer.",
      "secondary_message": "2 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 tsp cumin, ground\n1 tsp coriander, ground\n1 tsp salt\n½ tsp cinnamon, ground\n¼ tsp cayenne pepper\n¼ tsp black pepper"
    },
    {
      "id": 495039,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 495040,
      "primary_message": "Meanwhile, zest and juice lemon into a baking dish.",
      "secondary_message": null
    },
    {
      "id": 495041,
      "primary_message": "Peel and mince garlic. Add to the baking dish with the lemon, along with oil, and whisk to combine.",
      "secondary_message": "4 cloves garlic\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 495042,
      "primary_message": "Cut tofu in half horizontally to create planks. Add tofu to the baking dish and turn to coat with the lemon oil. Season with salt and pepper on both sides.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 495043,
      "primary_message": "Add baking dish to the oven and roast until tofu is golden brown and warmed through, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 495044,
      "primary_message": "Meanwhile, place yogurt and chili-garlic sauce in a small bowl. Stir to combine the spicy yogurt and set aside.",
      "secondary_message": "½ cup plain Greek yogurt\n2 tsp chili-garlic sauce"
    },
    {
      "id": 495045,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 495046,
      "primary_message": "When the veggies and chickpeas are done, remove from the oven. Add cilantro the baking sheet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 495047,
      "primary_message": "To serve, divide roasted veggies, chickpeas, and tofu between plates or bowls. Top tofu with spicy yogurt and enjoy!",
      "secondary_message": null
    }
  ],
