  "instructions": [
    {
      "id": 494961,
      "primary_message": "Preheat oven to 425°F. Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 494962,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkgs extra firm tofu"
    },
    {
      "id": 494963,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb sweet potatoes\n1 ½ medium heads cauliflower\n1 ½ lemons\n1 small bunch cilantro"
    },
    {
      "id": 494964,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 494965,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 494966,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl along with oil and spices, then toss to combine. Divide between two large baking sheets and spread out in an even layer.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)\n3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp cinnamon, ground\n½ tsp cayenne pepper\n½ tsp black pepper"
    },
    {
      "id": 494967,
      "primary_message": "Place baking sheets on the lower racks of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 494968,
      "primary_message": "Meanwhile, zest and juice lemons into a large baking dish.",
      "secondary_message": null
    },
    {
      "id": 494969,
      "primary_message": "Peel and mince garlic. Add to the baking dish with the lemon, along with oil, and whisk to combine.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 494970,
      "primary_message": "Cut tofu in half horizontally to create planks. Add tofu to the baking dish and turn to coat with the lemon oil. Season with salt and pepper on both sides.",
      "secondary_message": "¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 494971,
      "primary_message": "Place baking dish on the top rack of the oven and roast until tofu is golden brown and warmed through, 10-15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 494972,
      "primary_message": "Meanwhile, place yogurt and chili-garlic sauce in a small bowl. Stir to combine the spicy yogurt and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 494973,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 494974,
      "primary_message": "When the veggies and chickpeas are done, remove from the oven. Add cilantro the baking sheets and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 494975,
      "primary_message": "To serve, divide roasted veggies, chickpeas, and tofu between plates or bowls. Top tofu with spicy yogurt and enjoy!",
      "secondary_message": null
    }
  ],
