  "instructions": [
    {
      "id": 494889,
      "primary_message": "Preheat oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 494890,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb sweet potato\n½ medium head cauliflower\n½ lemon\n½ small bunch cilantro"
    },
    {
      "id": 494891,
      "primary_message": "Peel and medium dice sweet potato. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 494892,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 494893,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl along with oil and spices, then stir to combine. Transfer to a baking sheet pan and spread out in an even layer.",
      "secondary_message": "1 (15 oz) can garbanzo beans (chickpeas)\n1 tbsp extra virgin olive oil\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp salt\n¼ tsp cinnamon, ground\n⅛ tsp black pepper\n⅛ tsp cayenne pepper"
    },
    {
      "id": 494894,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 15-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 494895,
      "primary_message": "Meanwhile, zest and juice lemon into a baking dish.",
      "secondary_message": null
    },
    {
      "id": 494896,
      "primary_message": "Peel and mince garlic. Add to the baking dish with the lemon, along with oil, and whisk to combine.",
      "secondary_message": "2 cloves garlic\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 494897,
      "primary_message": "Cut cod into portions and place in the baking dish. Turn to coat with the lemon oil, then season with salt and pepper on both sides.",
      "secondary_message": "¾ lb cod fillet\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 494898,
      "primary_message": "Add baking dish to the oven and roast until cod is cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 494899,
      "primary_message": "Meanwhile, place yogurt and chili-garlic sauce in a small bowl. Stir to combine the spicy yogurt and set aside.",
      "secondary_message": "¼ cup plain Greek yogurt\n1 tsp chili-garlic sauce"
    },
    {
      "id": 494900,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 494901,
      "primary_message": "When the veggies and chickpeas are done, remove from the oven. Add cilantro to the baking sheet and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 494902,
      "primary_message": "To serve, divide roasted veggies, chickpeas, and cod between plates or bowls. Top cod with spicy yogurt and enjoy!",
      "secondary_message": null
    }
  ],
