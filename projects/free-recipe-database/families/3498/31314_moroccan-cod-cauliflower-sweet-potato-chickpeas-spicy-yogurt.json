  "instructions": [
    {
      "id": 495004,
      "primary_message": "Preheat oven to 220°C (425°F). Place oven racks in the upper, middle, and lower positions.",
      "secondary_message": null
    },
    {
      "id": 495005,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg sweet potatoes\n1 ½ medium heads cauliflower\n1 ½ lemons\n1 small bunch cilantro"
    },
    {
      "id": 495006,
      "primary_message": "Peel and medium dice sweet potatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 495007,
      "primary_message": "Separate cauliflower into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the sweet potato.",
      "secondary_message": null
    },
    {
      "id": 495008,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl along with oil and spices, then stir to combine. Divide between two large baking sheet pans and spread out in an even layer.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n3 tbsp extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n1 ½ tsp salt\n¾ tsp cinnamon, ground\n½ tsp black pepper\n½ tsp cayenne pepper"
    },
    {
      "id": 495009,
      "primary_message": "Place baking sheets on the lower racks of the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 495010,
      "primary_message": "Meanwhile, zest and juice lemons into a large baking dish.",
      "secondary_message": null
    },
    {
      "id": 495011,
      "primary_message": "Peel and mince garlic. Add to the baking dish with the lemon, along with oil, and whisk to combine.",
      "secondary_message": "6 cloves garlic\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 495012,
      "primary_message": "Cut cod into portions and place in the baking dish. Turn to coat with the lemon oil, then season with salt and pepper on both sides.",
      "secondary_message": "1.02 kg cod fillet\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 495013,
      "primary_message": "Place baking dish on the top rack of the oven and roast until cod is cooked through, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 495014,
      "primary_message": "Meanwhile, place yogurt and chili-garlic sauce in a small bowl. Stir to combine the spicy yogurt and set aside.",
      "secondary_message": "¾ cup plain Greek yogurt\n1 tbsp chili-garlic sauce"
    },
    {
      "id": 495015,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 495016,
      "primary_message": "When the veggies and chickpeas are done, remove from the oven. Add cilantro to the baking sheets and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 495017,
      "primary_message": "To serve, divide roasted veggies, chickpeas, and cod between plates or bowls. Top cod with spicy yogurt and enjoy!",
      "secondary_message": null
    }
  ],
