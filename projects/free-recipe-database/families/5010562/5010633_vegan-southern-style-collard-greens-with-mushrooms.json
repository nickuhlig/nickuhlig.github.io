  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Trim the stems of the cremini mushrooms, then slice the caps. Rehydrate the hearty vegetable stock dried mushrooms reserved. Slice the yellow onion into 2-inch lengths.",
      "secondary_message": "0.45 kg cremini mushrooms\n1900 ml hearty vegetable stock\n1 medium yellow onion"
    },
    {
      "id": 1,
      "primary_message": "In a large, heavy-bottomed pot or Dutch oven, heat 3 tablespoons oil over medium-high heat until shimmering. Add cremini mushrooms and reserved rehydrated mushrooms (from stock) and cook, stirring, until lightly browned, about 8 minutes. Add onion and cook, scraping up any browned bits, until softened, about 3 minutes; lower heat if necessary to prevent scorching.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stir in smoked paprika followed by stock. Bring to a simmer, then add collard greens, pushing down to submerge. Return to a simmer and cook, uncovered, until greens are very tender, about 30 minutes. Season with salt and pepper and add remaining 1/4 cup olive oil.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add vinegar to taste, if desired, then serve. (You can add vinegar to the pot, or let individual diners season their greens with it at the table.)",
      "secondary_message": null
    }
  ],
