  "instructions": [
    {
      "id": 253087,
      "primary_message": "Preheat the oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 253088,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ lemon\n½ English cucumber\n½ (142 g) pkg baby spinach"
    },
    {
      "id": 253089,
      "primary_message": "Cut leaves off the cauliflower, separate into small florets, and cut the thick stems into smaller pieces; transfer to a baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 253090,
      "primary_message": "Drizzle cauliflower with oil and season with curry powder; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp curry powder"
    },
    {
      "id": 253091,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast until the cauliflower starts to soften, about 12 minutes.",
      "secondary_message": null
    },
    {
      "id": 253092,
      "primary_message": "Meanwhile, juice lemon into a medium bowl; add mayo, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253093,
      "primary_message": "Trim and halve cucumber lengthwise; thinly slice crosswise into half-moons. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 253094,
      "primary_message": "Pat the salmon dry with paper towels and place on a plate; coat both sides with oil and season with salt and pepper on the top side. ",
      "secondary_message": "⅓ kg salmon fillet\n2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 253095,
      "primary_message": "Remove baking sheet from the oven, stir the cauliflower, and push to one side. Place salmon on the other side of the baking sheet and return to the oven. Bake until salmon is cooked through and cauliflower is tender, 10-15 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 253096,
      "primary_message": "While the salmon is cooking, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 253097,
      "primary_message": "Once the skillet is hot, add sesame seeds and toast, stirring often, until golden, 2-3 minutes; remove from heat.",
      "secondary_message": "1 tbsp sesame seeds"
    },
    {
      "id": 253098,
      "primary_message": "Once done, add the roasted cauliflower and spinach to the bowl with the dressing and cucumber. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 253099,
      "primary_message": "To serve, divide salad between plates or bowls; top with salmon and sesame seeds. Enjoy!",
      "secondary_message": null
    }
  ],
