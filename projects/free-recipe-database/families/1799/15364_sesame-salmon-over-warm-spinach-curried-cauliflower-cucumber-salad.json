  "instructions": [
    {
      "id": 253074,
      "primary_message": "Preheat the oven to 425°F.",
      "secondary_message": null
    },
    {
      "id": 253075,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 ½ lemons\n1 ½ English cucumbers\n1 ½ (5 oz) pkgs baby spinach"
    },
    {
      "id": 253076,
      "primary_message": "Cut leaves off each cauliflower head, separate into small florets, and cut the thick stems into smaller pieces; transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 253077,
      "primary_message": "Drizzle cauliflower with oil and season with curry powder; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 tbsp curry powder"
    },
    {
      "id": 253078,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until the cauliflower is fork-tender and golden, 25-30 minutes.",
      "secondary_message": null
    },
    {
      "id": 253079,
      "primary_message": "Meanwhile, juice lemons into a large bowl; add mayo, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253080,
      "primary_message": "Trim and halve cucumbers lengthwise; thinly slice crosswise into half-moons. Add to the bowl with the dressing and set aside.",
      "secondary_message": null
    },
    {
      "id": 253081,
      "primary_message": "Pat the salmon dry with paper towels and place on another baking sheet pan; coat both sides with oil and season with salt and pepper on the top side. ",
      "secondary_message": "2 ¼ lb salmon fillet\n2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 253082,
      "primary_message": "Add baking sheet to the oven and bake until fish is flakey and cooked through, about 15 minutes. Remove from the oven.",
      "secondary_message": null
    },
    {
      "id": 253083,
      "primary_message": "While the salmon is cooking, preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 253084,
      "primary_message": "Once the skillet is hot, add sesame seeds and toast, stirring often, until golden, about 3 minutes; remove from heat.",
      "secondary_message": "3 tbsp sesame seeds"
    },
    {
      "id": 253085,
      "primary_message": "Once done, add the roasted cauliflower and spinach to the bowl with the dressing and cucumber. Toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 253086,
      "primary_message": "To serve, divide salad between plates or bowls; top with salmon and sesame seeds. Enjoy!",
      "secondary_message": null
    }
  ],
