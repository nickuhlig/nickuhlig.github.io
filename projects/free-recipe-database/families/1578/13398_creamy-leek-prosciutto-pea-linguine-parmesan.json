  "instructions": [
    {
      "id": 223858,
      "primary_message": "Fill a large pot halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 2 cups of pasta cooking water before draining.)",
      "secondary_message": "1 tbsp salt\n425 g linguine pasta"
    },
    {
      "id": 223859,
      "primary_message": "Meanwhile, trim off the root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch half-moons.",
      "secondary_message": "6 leeks"
    },
    {
      "id": 223860,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 223861,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 223862,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add leeks and garlic; cook, stirring occasionally, until leeks are soft, 10-12 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 223863,
      "primary_message": "Meanwhile, cut the cream cheese into small pieces and set aside.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 223864,
      "primary_message": "Roughly chop prosciutto into bite-sized pieces. Once the leeks have softened, add prosciutto to the pot, and cook, stirring often, until slightly crispy, 3-4 minutes.",
      "secondary_message": "12 slices prosciutto"
    },
    {
      "id": 223865,
      "primary_message": "Add cream cheese, peas, and 1 cup of the pasta cooking water to the pot. Reduce heat to low, and continue to cook, stirring often, until cream cheese is melted, 4-5 minutes.",
      "secondary_message": "1 ½ cups frozen peas"
    },
    {
      "id": 223866,
      "primary_message": "Finely grate Parmesan and add to the pot (reserving a small handful for garnish); stir to combine.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 223867,
      "primary_message": "Add drained pasta to the pot and toss to combine; add additional pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency.",
      "secondary_message": null
    },
    {
      "id": 223868,
      "primary_message": "To serve, divide pasta between bowls and garnish with remaining Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
