  "instructions": [
    {
      "id": 223836,
      "primary_message": "Fill a medium saucepan halfway with water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve 1 cup of pasta cooking water before draining.)",
      "secondary_message": "1 tsp salt\n142 g linguine pasta"
    },
    {
      "id": 223837,
      "primary_message": "Meanwhile, trim off the root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ½-inch half-moons.",
      "secondary_message": "2 leeks"
    },
    {
      "id": 223838,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 223839,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 223840,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add leeks and garlic; cook, stirring occasionally, until leeks are soft, 8-10 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 223841,
      "primary_message": "Meanwhile, cut the cream cheese into small pieces and set aside.",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "id": 223842,
      "primary_message": "Roughly chop prosciutto into bite-sized pieces. Once the leeks have softened, add prosciutto to the skillet, and cook, stirring often, until slightly crispy, 1-2 minutes.",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 223843,
      "primary_message": "Add cream cheese, peas, and a ½-cup of the pasta cooking water to the skillet. Reduce heat to low, and continue to cook, stirring often, until cream cheese is melted, 3-4 minutes.",
      "secondary_message": "½ cup frozen peas"
    },
    {
      "id": 223844,
      "primary_message": "Finely grate Parmesan and add to the skillet (reserving a small handful for garnish); stir to combine.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 223845,
      "primary_message": "Add drained pasta to the skillet and toss to combine; add additional pasta water, 1 tablespoon at a time, if necessary, to reach a saucy consistency.",
      "secondary_message": null
    },
    {
      "id": 223846,
      "primary_message": "To serve, divide pasta between bowls and garnish with remaining Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
