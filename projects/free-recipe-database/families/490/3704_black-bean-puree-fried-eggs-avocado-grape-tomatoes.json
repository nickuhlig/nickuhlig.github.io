  "instructions": [
    {
      "id": 40353,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small pkg grape tomatoes\n2 avocados\n2 jalapeño peppers"
    },
    {
      "id": 40354,
      "primary_message": "Preheat a small saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 40355,
      "primary_message": "While the saucepan heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces).",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 40356,
      "primary_message": "Once the saucepan is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 40357,
      "primary_message": "Add the onion to the saucepan; cook, stirring frequently, until softened, 3 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 40358,
      "primary_message": "Quarter the jalapeño peppers lengthwise; remove and discard the stem, seeds, and membranes. Finely dice the peppers and add to the onion.",
      "secondary_message": null
    },
    {
      "id": 40359,
      "primary_message": "Drain and rinse the beans.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 40360,
      "primary_message": "Add chili powder, cumin, salt, and pepper to the saucepan; stir until fragrant, 15 to 30 seconds.",
      "secondary_message": "1 tsp chili powder\n1 tsp cumin\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 40361,
      "primary_message": "Add the beans and broth to the saucepan; bring to a boil, then mash the beans with a hand blender or potato masher. Remove from the heat and cover to keep warm.",
      "secondary_message": "236 ml (1 cup) chicken or vegetable broth"
    },
    {
      "id": 40362,
      "primary_message": "Add olive oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 40363,
      "primary_message": "While the skillet heats up, halve the grape tomatoes and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 40364,
      "primary_message": "Gently crack half of the eggs into the skillet. Cook until the tops of the whites are set but the yolks are still runny, 2 to 3 minutes. Once done, separate the eggs and transfer to a plate. Repeat with the remaining eggs.",
      "secondary_message": "8 eggs"
    },
    {
      "id": 40365,
      "primary_message": "While the eggs cook, halve the avocados lengthwise and twist the halves to separate, then remove the pit with a knife or spoon; scoop out and medium dice the flesh. Add to the bowl with the tomatoes.",
      "secondary_message": ""
    },
    {
      "id": 40366,
      "primary_message": "To serve, divide the bean purée, eggs, and tomato-avocado mixture among plates; season with salt and pepper if desired. Enjoy!",
      "secondary_message": ""
    }
  ],
