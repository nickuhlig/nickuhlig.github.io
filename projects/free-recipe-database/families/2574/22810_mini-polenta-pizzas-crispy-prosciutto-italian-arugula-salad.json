  "instructions": [
    {
      "id": 423054,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 423055,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Transfer to the baking sheet, arranging the slices in a single layer.",
      "secondary_message": "1 (510 g) tube polenta, pre-cooked"
    },
    {
      "id": 423056,
      "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the toppings.",
      "secondary_message": null
    },
    {
      "id": 423057,
      "primary_message": "Place tomato sauce, Italian seasoning, and crushed red pepper in a medium bowl; stir to combine and set aside.",
      "secondary_message": "1 (213 ml) can tomato sauce\n½ tsp Italian seasoning\n⅛ tsp crushed red pepper"
    },
    {
      "id": 423058,
      "primary_message": "Roughly chop or tear prosciutto into bite-sized pieces.",
      "secondary_message": "6 slices prosciutto"
    },
    {
      "id": 423059,
      "primary_message": "Remove baking sheet from the oven. Spoon sauce over the polenta slices, then top with cheese and prosciutto.",
      "secondary_message": "½ cup shredded cheese, Italian blend"
    },
    {
      "id": 423060,
      "primary_message": "Return baking sheet to the oven and bake until polenta pizzas are warmed through and cheese is melted, 5-6 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423061,
      "primary_message": "Meanwhile, drain and roughly chop artichokes. Place in a clean medium bowl.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated"
    },
    {
      "id": 423062,
      "primary_message": "Roughly chop roasted red peppers and olives. Add both to the bowl with the artichokes.",
      "secondary_message": "½ (340 g) jar roasted red bell peppers\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 423063,
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Add to the bowl, along with the dressing, and toss to combine the salad.",
      "secondary_message": "½ (142 g) pkg baby arugula\n3 tbsp Italian salad dressing"
    },
    {
      "id": 423064,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
