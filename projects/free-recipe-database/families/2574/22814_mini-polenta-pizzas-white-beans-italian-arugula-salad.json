  "instructions": [
    {
      "id": 423098,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 423099,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Transfer to the baking sheet, arranging the slices in a single layer.",
      "secondary_message": "2 (510 g) tubes polenta, pre-cooked"
    },
    {
      "id": 423100,
      "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the toppings.",
      "secondary_message": null
    },
    {
      "id": 423101,
      "primary_message": "Drain and rinse beans; place in a medium bowl.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 423102,
      "primary_message": "Add tomato sauce, Italian seasoning, and crushed red pepper to the bowl with the beans.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n1 tsp Italian seasoning\n¼ tsp crushed red pepper"
    },
    {
      "id": 423103,
      "primary_message": "Remove baking sheet from the oven. Spoon beans and sauce over the polenta slices, then top with cheese.",
      "secondary_message": "1 cup shredded cheese, Italian blend"
    },
    {
      "id": 423104,
      "primary_message": "Return baking sheet to the oven and bake until polenta pizzas are warmed through and cheese is melted, 6-8 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423105,
      "primary_message": "Meanwhile, drain and roughly chop artichokes. Place in a clean medium bowl.",
      "secondary_message": "2 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 423106,
      "primary_message": "Roughly chop roasted red peppers and olives. Add both to the bowl with the artichokes. ",
      "secondary_message": "1 (340 g) jar roasted red bell peppers\n¼ cup Kalamata olives, pitted"
    },
    {
      "id": 423107,
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Add to the bowl, along with the dressing, and toss to combine the salad.",
      "secondary_message": "1 (142 g) pkg baby arugula\n⅓ cup Italian salad dressing"
    },
    {
      "id": 423108,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
