  "instructions": [
    {
      "id": 423043,
      "primary_message": "Preheat oven to 450°F. Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 423044,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Divide between the baking sheets, arranging the slices in a single layer.",
      "secondary_message": "3 (18 oz) tubes polenta, pre-cooked"
    },
    {
      "id": 423045,
      "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the toppings.",
      "secondary_message": null
    },
    {
      "id": 423046,
      "primary_message": "Drain and rinse beans; place in a large bowl.",
      "secondary_message": "3 (15 oz) cans cannellini (white kidney) beans"
    },
    {
      "id": 423047,
      "primary_message": "Add tomato sauce, Italian seasoning, and crushed red pepper to the bowl with the beans.",
      "secondary_message": "3 (8 oz) cans tomato sauce\n1 ½ tsp Italian seasoning\n½ tsp crushed red pepper"
    },
    {
      "id": 423048,
      "primary_message": "Remove baking sheets from the oven. Spoon beans and sauce over the polenta slices, then top with cheese.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 423049,
      "primary_message": "Return baking sheet to the oven and bake until polenta pizzas are warmed through and cheese is melted, 8-10 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423050,
      "primary_message": "Meanwhile, drain and roughly chop artichokes. Place in a clean large bowl.",
      "secondary_message": "3 (6 oz) jars artichoke hearts, marinated"
    },
    {
      "id": 423051,
      "primary_message": "Roughly chop roasted red peppers and olives. Add both to the bowl with the artichokes. ",
      "secondary_message": "1 ½ (12 oz) jars roasted red bell peppers\n⅓ cup Kalamata olives, pitted"
    },
    {
      "id": 423052,
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Add to the bowl, along with the dressing, and toss to combine the salad.",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula\n½ cup Italian salad dressing"
    },
    {
      "id": 423053,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
