  "instructions": [
    {
      "id": 423076,
      "primary_message": "Preheat oven to 230°C (450°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 423077,
      "primary_message": "Slice polenta crosswise into ½-inch thick rounds. Divide between the baking sheets, arranging the slices in a single layer.",
      "secondary_message": "3 (510 g) tubes polenta, pre-cooked"
    },
    {
      "id": 423078,
      "primary_message": "Place polenta in the oven (it doesn't have to be fully heated) while you prepare the toppings.",
      "secondary_message": null
    },
    {
      "id": 423079,
      "primary_message": "Place tomato sauce, Italian seasoning, and crushed red pepper in a medium bowl; stir to combine and set aside.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n1 ½ tsp Italian seasoning\n½ tsp crushed red pepper"
    },
    {
      "id": 423080,
      "primary_message": "Roughly chop or tear prosciutto into bite-sized pieces.",
      "secondary_message": "18 slices prosciutto"
    },
    {
      "id": 423081,
      "primary_message": "Remove baking sheets from the oven. Spoon sauce over the polenta slices, then top with cheese and prosciutto.",
      "secondary_message": "1 ½ cups shredded cheese, Italian blend"
    },
    {
      "id": 423082,
      "primary_message": "Return baking sheets to the oven and bake until polenta pizzas are warmed through and cheese is melted, 6-7 minutes more. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 423083,
      "primary_message": "Meanwhile, drain and roughly chop artichokes. Place in a large bowl.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated"
    },
    {
      "id": 423084,
      "primary_message": "Roughly chop roasted red peppers and olives. Add both to the bowl with the artichokes. ",
      "secondary_message": "1 ½ (340 g) jars roasted red bell peppers\n¾ cup Kalamata olives, pitted"
    },
    {
      "id": 423085,
      "primary_message": "Wash and dry arugula (skip if it came pre-washed). Add to the bowl, along with the dressing, and toss to combine the salad.",
      "secondary_message": "1 ½ (142 g) pkgs baby arugula\n½ cup Italian salad dressing"
    },
    {
      "id": 423086,
      "primary_message": "To serve, divide pizzas and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
