  "instructions": [
    {
      "primary_message": "Preheat oven to 375°F. Line a large baking sheet pan with parchment paper. Coat the paper with a thin layer oil and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "primary_message": "Place spinach in a colander and rinse under hot, running water (from the tap) to defrost; set aside to drain further.",
      "secondary_message": "1 (16oz) bag frozen chopped spinach"
    },
    {
      "primary_message": "Place butter in a small saucepan and set over medium-low heat to melt. Once melted, transfer to a medium bowl.",
      "secondary_message": "⅓ cup butter, unsalted"
    },
    {
      "primary_message": "Add eggs and spices to the bowl with the melted butter. Whisk to combine. ",
      "secondary_message": "1 tsp onion powder\n¾ tsp salt\n½ tsp garlic powder\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can. \n",
      "secondary_message": null
    },
    {
      "primary_message": "Add spinach, bread crumbs, and cheese to the bowl, then stir to combine. Using a generous tablespoon measure, shape the spinach mixture into 1-inch balls and arrange on the baking sheet, spacing them about 2 inches apart.",
      "secondary_message": "1 cup panko bread crumbs\n1 cup Parmesan cheese, shredded"
    },
    {
      "primary_message": "Place baking sheet in the oven and bake until spinach bites are golden and cooked through, 15-18 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "primary_message": "Transfer spinach bites to a platter and serve warm or at room temperature. Enjoy!",
      "secondary_message": null
    }
  ],
