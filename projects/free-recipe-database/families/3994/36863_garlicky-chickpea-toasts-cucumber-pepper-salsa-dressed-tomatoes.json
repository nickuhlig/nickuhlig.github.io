  "instructions": [
    {
      "id": 578387,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 lemons\n1 yellow bell pepper\n1 English cucumber\n1 small bunch Italian (flat-leaf) parsley\n2 pints grape tomatoes"
    },
    {
      "id": 578388,
      "primary_message": "Juice lemons; divide between a medium and small bowl. Set aside the small bowl for later use.",
      "secondary_message": null
    },
    {
      "id": 578389,
      "primary_message": "Peel and mince garlic. Add to the medium bowl with the lemon juice.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 578390,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl, along with oil and spices. Using a fork or potato masher, roughly mash the chickpeas until semi-smooth. Set aside.",
      "secondary_message": "2 (15 oz) cans garbanzo beans (chickpeas)\n4 tsp extra virgin olive oil\n1 tsp salt\n½ tsp black pepper\n½ tsp smoked paprika\n½ tsp crushed red pepper"
    },
    {
      "id": 578391,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 578392,
      "primary_message": "Meanwhile, peel and mince shallot. Add to the reserved small bowl with the lemon juice.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 578393,
      "primary_message": "Trim, seed, and small dice bell pepper. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 578394,
      "primary_message": "Trim and small dice cucumber. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578395,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil, salt, and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 578396,
      "primary_message": "Place honey, vinegar, and spices in another medium bowl, then whisk to combine the dressing.",
      "secondary_message": "2 tsp honey\n1 tsp white wine vinegar\n½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 578397,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 578398,
      "primary_message": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "8 slices sourdough bread"
    },
    {
      "id": 578399,
      "primary_message": "Spread toasted bread with smashed chickpeas, then top with salsa.",
      "secondary_message": null
    },
    {
      "id": 578400,
      "primary_message": "To serve, divide toasts and tomato salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
