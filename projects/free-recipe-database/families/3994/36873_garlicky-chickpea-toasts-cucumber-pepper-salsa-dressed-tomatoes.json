  "instructions": [
    {
      "id": 578527,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 lemons\n1 ½ yellow bell peppers\n1 ½ English cucumbers\n1 small bunch Italian (flat-leaf) parsley\n3 small pkgs grape tomatoes"
    },
    {
      "id": 578528,
      "primary_message": "Juice lemons; divide between a large and medium bowl. Set aside the medium bowl for later use.",
      "secondary_message": null
    },
    {
      "id": 578529,
      "primary_message": "Peel and mince garlic. Add to the large bowl with the lemon juice.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 578530,
      "primary_message": "Drain and rinse chickpeas. Add to the bowl, along with oil and spices. Using a fork or potato masher, roughly mash the chickpeas until semi-smooth. Set aside.",
      "secondary_message": "3 (398 ml) cans garbanzo beans (chickpeas)\n2 tbsp extra virgin olive oil\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp smoked paprika\n¾ tsp crushed red pepper"
    },
    {
      "id": 578531,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven. (Skip this step if you are using a toaster for the bread.)",
      "secondary_message": null
    },
    {
      "id": 578532,
      "primary_message": "Meanwhile, peel and mince shallots. Add to the reserved medium bowl with the lemon juice.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 578533,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 578534,
      "primary_message": "Trim and small dice cucumbers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 578535,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl along with oil, salt, and pepper, then stir to combine the salsa. Set aside.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 578536,
      "primary_message": "Place maple syrup, vinegar, and spices in another medium bowl, then whisk to combine the dressing.",
      "secondary_message": "1 tbsp pure maple syrup\n1 ½ tsp white wine vinegar\n¾ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 578537,
      "primary_message": "Halve grape tomatoes. Add to the bowl with the dressing, stir to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 578538,
      "primary_message": "Divide bread between two large baking sheet pans. Working in batches, place in the oven and broil, flipping halfway through, until toasted, about 2 minutes; remove from oven. (Alternatively, you can use a toaster.)",
      "secondary_message": "12 slices sourdough bread"
    },
    {
      "id": 578539,
      "primary_message": "Spread toasted bread with smashed chickpeas, then top with salsa.",
      "secondary_message": null
    },
    {
      "id": 578540,
      "primary_message": "To serve, divide toasts and tomato salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
