  "instructions": [
    {
      "id": 42779,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 bunch kale"
    },
    {
      "id": 42780,
      "primary_message": "Preheat the oven to the broil setting and position the rack in the upper third of the oven.",
      "secondary_message": ""
    },
    {
      "id": 42781,
      "primary_message": "Fold each kale leaf lengthwise, slice away and discard the stems, and chop the leaves crosswise into 1-inch strips. Transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 42782,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the kale.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 42783,
      "primary_message": "Preheat an ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 42784,
      "primary_message": "While the skillet heats up, quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Medium dice the peppers.",
      "secondary_message": null
    },
    {
      "id": 42785,
      "primary_message": "Once the skillet is hot, add olive oil and swirl to coat the bottom.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 42786,
      "primary_message": "Add the bell peppers to the skillet and season with salt and pepper; cook, stirring frequently, until softened, 4 to 5 minutes.",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42787,
      "primary_message": "While the bell pepper cooks, in a medium bowl, combine and whisk together the eggs, water, salt, and pepper.",
      "secondary_message": "12 eggs\n4 tbsp water\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 42788,
      "primary_message": "Add the kale and garlic to the skillet; cook, tossing frequently, until wilted, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 42789,
      "primary_message": "Pour the egg mixture into the skillet. While tilting the skillet with one hand, lift up the edges of the frittata with a spatula and let the eggs run underneath during the first few minutes of cooking. Cook until most of the frittata is set, but the top is still runny, 4 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 42790,
      "primary_message": "Crumble the goat cheese overtop of the frittata.",
      "secondary_message": "1 (4 oz) log goat cheese"
    },
    {
      "id": 42791,
      "primary_message": "Transfer the skillet to the oven and broil until the top is set and lightly browned, 2 to 3 minutes.",
      "secondary_message": null
    },
    {
      "id": 42792,
      "primary_message": "To serve, separate the frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
