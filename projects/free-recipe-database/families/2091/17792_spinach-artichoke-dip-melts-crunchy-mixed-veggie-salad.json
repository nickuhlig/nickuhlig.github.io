  "instructions": [
    {
      "id": 287933,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 crown broccoli\n½ bunch radish\n½ orange bell pepper\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 287934,
      "primary_message": "Peel and mince garlic; place in a medium bowl along with oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 clove garlic\n2 tsp extra virgin olive oil\n2 tsp red wine vinegar\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 287935,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 287936,
      "primary_message": "Trim and thinly slice radishes; trim, seed, and small dice bell pepper. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 287937,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 287938,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 287939,
      "primary_message": "Once the water in the pan is boiling, uncover; add salt and spinach. Stir until wilted, 30-60 seconds, then drain in a colander and rinse with cold water to cool.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 287940,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can, then transfer to a cutting board. Roughly chop spinach and place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 287941,
      "primary_message": "Drain and roughly chop artichokes; add to the bowl with the spinach along with mayo and spices.",
      "secondary_message": "1 (170 ml) jar artichoke hearts, marinated\n2 tbsp mayonnaise\n½ tsp Italian seasoning\n¼ tsp crushed red pepper\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 287942,
      "primary_message": "Small dice cream cheese and add to the bowl with the spinach mixture; stir to combine the \"dip\" and set aside.",
      "secondary_message": "½ (227 g) block cream cheese"
    },
    {
      "id": 287943,
      "primary_message": "Arrange bread slices on a baking sheet pan and drizzle with oil. Place in the oven and broil until toasted, about 1 minute; remove from oven.",
      "secondary_message": "4 slices whole grain bread\n1 tsp extra virgin olive oil"
    },
    {
      "id": 287944,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 287945,
      "primary_message": "Divide \"dip\" between toast slices and top with Parmesan. Return to the oven and broil until cheese is melted and golden, about 2 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 287946,
      "primary_message": "To serve, divide melts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
