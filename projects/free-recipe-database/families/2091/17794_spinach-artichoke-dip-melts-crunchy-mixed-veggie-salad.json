  "instructions": [
    {
      "id": 287961,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 crowns broccoli\n1 ½ bunches radish\n1 ½ orange bell peppers\n3 (142 g) pkg baby spinach"
    },
    {
      "id": 287962,
      "primary_message": "Peel and mince garlic; place in a large bowl along with oil, vinegar, Dijon, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "3 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp red wine vinegar\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 287963,
      "primary_message": "Separate broccoli into bite-sized florets and cut stems into smaller pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 287964,
      "primary_message": "Trim and thinly slice radishes; trim, seed, and small dice bell peppers. Add both to the bowl and stir to combine the salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 287965,
      "primary_message": "Fill a large pot about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 287966,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack under the broiler.",
      "secondary_message": null
    },
    {
      "id": 287967,
      "primary_message": "Once the water in the pot is boiling, uncover; add salt and spinach. Stir until wilted, about 1 minute, then drain in a colander and rinse with cold water to cool.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 287968,
      "primary_message": "Using your hands, squeeze as much water from the spinach as you can, then transfer to a cutting board. Roughly chop spinach and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 287969,
      "primary_message": "Drain and roughly chop artichokes; add to the bowl with the spinach along with mayo and spices.",
      "secondary_message": "3 (170 ml) jars artichoke hearts, marinated\n⅓ cup mayonnaise\n1 ½ tsp Italian seasoning\n¾ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 287970,
      "primary_message": "Small dice cream cheese and add to the bowl with the spinach mixture; stir to combine the \"dip\" and set aside.",
      "secondary_message": "1 ½ (227 g) blocks cream cheese"
    },
    {
      "id": 287971,
      "primary_message": "Divide bread slices between two baking sheet pans and drizzle with oil. Working in batches, place in the oven and broil until toasted, about 1 minute; remove from oven.",
      "secondary_message": "12 slices whole grain bread\n1 tbsp extra virgin olive oil"
    },
    {
      "id": 287972,
      "primary_message": "Meanwhile, finely grate Parmesan.",
      "secondary_message": "85 g Parmesan cheese"
    },
    {
      "id": 287973,
      "primary_message": "Divide \"dip\" between toast slices and top with Parmesan. Working in batches, return to the oven and broil until cheese is melted and golden, about 2 minutes; remove from oven.",
      "secondary_message": null
    },
    {
      "id": 287974,
      "primary_message": "To serve, divide melts and salad between plates. Enjoy!",
      "secondary_message": null
    }
  ],
