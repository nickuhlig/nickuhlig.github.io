  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mash the anchovy filet to a paste. Cut the boneless skinless turkey thighs into 1-inch cubes.",
      "secondary_message": "1 anchovy filet\n1 lb boneless skinless turkey thighs"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 400°F and set rack to upper-middle position. Rub eggplant with olive oil until coated. Season with salt and pepper. Wrap with aluminum foil and set on rimmed baking sheet. Roast until completely tender, turning once, about 30 minutes. Allow to cool slightly, remove from foil, and scrape flesh away from skin. Chop flesh until fine purée is formed. There should be about 4-6 ounces of purée.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine soy sauce, anchovies, and marmite in small bowl with back of fork until homogenous and marmite is completely dissolved and anchovies are smooth. Toss meat with anchovies/soy/marmite mixture until thoroughly coated (if using pre-ground turkey, mix together by hand until homogeneous). Place feed shaft, blade, and 1/4-inch die of meat grinder in freezer until well-chilled. Meanwhile, place meat chunks on rimmed baking sheet, leaving space between each piece and place in freezer for 10 minutes until meat is firm, but not frozen.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Pass meat through grinder. Combine with eggplant purée. Form into 4 patties. At this point, follow your favorite burger recipe to cook the patties, making sure to cook them to at least 150°F.",
      "secondary_message": null
    }
  ],
