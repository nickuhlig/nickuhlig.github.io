  "instructions": [
    {
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "primary_message": "While the skillet heats up, medium dice bacon. ",
      "secondary_message": "8 slices bacon"
    },
    {
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, remove crispy bacon to a paper towel-lined plate; set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": null
    },
    {
      "primary_message": "Meanwhile, wash and dry bell peppers. Using a clean cutting board, trim, seed, and medium dice the peppers. Place in a large bowl.",
      "secondary_message": "2 red bell peppers\n2 green bell peppers"
    },
    {
      "primary_message": "Peel, halve, and medium dice onion. Peel and mince garlic. Add both to the bowl with the bell pepper. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "primary_message": "Place corn in the colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl.",
      "secondary_message": "1 cup frozen corn"
    },
    {
      "primary_message": "Return skillet (with drippings) to medium heat. Add veggies, salt, and pepper; cook, stirring occasionally, until veggies are golden and tender, 6-8 minutes. (Reserve bowl for later use.)",
      "secondary_message": "salt\nblack pepper"
    },
    {
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "primary_message": "Coarsely grate cheese. Set aside.",
      "secondary_message": "½ (227 g) block cheddar cheese"
    },
    {
      "primary_message": "Place eggs and spices in the reserved bowl, then whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp paprika\nsalt\nblack pepper"
    },
    {
      "primary_message": "When the veggies are done, reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes. ",
      "secondary_message": null
    },
    {
      "primary_message": "Sprinkle cheese and bacon over the frittata. Place skillet in the oven and broil until the top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "primary_message": "To serve, cut frittata into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
