  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust rack to middle position and preheat oven to 205°C (400°F). Wrap each roll in aluminum foil and set on a baking sheet. Transfer to the oven to warm while preparing the rest of the meal.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Heat the oil in a large cast-iron skillet over high heat until barely smoking. Add green and red bell peppers and onions. Cook, stirring often, until they start to blacken in spots and soften, 5 to 8 minutes. Season with a pinch of a salt. Reduce heat to medium low, and let the pan cool down for 1 minute.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "While the pan is cooling, crack the eggs into a bowl and whisk until combined. Stir in the cheese and a pinch of salt and pepper.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Add garlic to skillet and cook until fragrant, about 30 seconds. Pour in the eggs and let cook for 10 seconds before stirring. Continue stirring every ten seconds until eggs have set but are still relatively soft. Turn off the heat.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Carefully remove rolls from the oven. Slice each roll horizontally along one side, leaving the other long side still attached. Use your hands to remove some excess bread in the middle if necessary. Scoop some of the egg and pepper mixture in each roll.Top with condiments as desired and serve.",
      "secondary_message": null
    }
  ],
