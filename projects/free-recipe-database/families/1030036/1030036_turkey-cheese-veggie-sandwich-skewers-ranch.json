  "instructions": [
    {
      "primary_message": "This recipe contains steps that can be done by smaller hands! You know your child (and their cooking abilities) best, so get them involved where you feel comfortable. Have fun!",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n½ head butter (Boston) lettuce\n½ pint grape tomatoes"
    },
    {
      "primary_message": "Trim and halve cucumber lengthwise, then cut each half crosswise into 6 half-moons (you should have 12 pieces of cucumber total). Place cucumber on a large plate.",
      "secondary_message": null
    },
    {
      "primary_message": "Tear lettuce into bite-sized pieces (you should have enough for 12 small stacks). Add to the plate with the cucumber along with 12 grape tomatoes.",
      "secondary_message": null
    },
    {
      "primary_message": "Cut cheese into 12 cubes. Add to the plate.",
      "secondary_message": "½ (8 oz) block cheddar cheese"
    },
    {
      "primary_message": "Cut bread into 1-inch thick slices, then cut each slice into large cubes (you should have 24 pieces).",
      "secondary_message": "⅓ (16 oz) loaf French bread"
    },
    {
      "primary_message": "Stack turkey slices one on top of another, then cut in half. Fold each piece into thirds and add to the plate.",
      "secondary_message": "6 oz oven roasted turkey breast, sliced"
    },
    {
      "primary_message": "To assemble the sandwich skewers, thread ingredients onto skewers in desired order. (We recommend starting and ending with a bread square, but feel free to get creative!)",
      "secondary_message": null
    },
    {
      "primary_message": "Arrange skewers on plates, serve with ranch dressing for dipping, and enjoy!",
      "secondary_message": "¼ cup ranch dressing"
    }
  ],
