  "instructions": [
    {
      "id": 626400,
      "primary_message": "Wash, dry, and cut off skin and white pith from the grapefruits; slice between membranes to release segments. Place segments in a small bowl, along with spices, and stir to combine. Set aside.",
      "secondary_message": "2 grapefruits\n1 pinch salt\n1 pinch cinnamon, ground\n1 pinch cloves, ground"
    },
    {
      "id": 626401,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 626402,
      "primary_message": "Once the skillet is hot, add coconut and pistachios; cook, stirring often, until lightly toasted and fragrant, 2-3 minutes. Transfer to another small bowl.",
      "secondary_message": "¼ cup shredded unsweetened coconut\n¼ cup pistachios, unsalted"
    },
    {
      "id": 626403,
      "primary_message": "To serve, divide yogurt and spiced grapefruit between bowls. Top with toasted coconut and pistachios, then drizzle with maple syrup. Enjoy!",
      "secondary_message": "1 ½ cups plain Greek yogurt\n2 tbsp pure maple syrup"
    }
  ],
