  "instructions": [
    {
      "id": 173751,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 173752,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "1 (398 ml) can black beans"
    },
    {
      "id": 173753,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 yellow bell pepper\n1 small bunch asparagus\n½ avocado\n1 lime\n½ small pkg fresh basil"
    },
    {
      "id": 173754,
      "primary_message": "Cut peppers into large pieces and toss in a medium bowl with oil, oregano, salt, and pepper. Spread in a single layer on a parchment-lined baking sheet and roast in the oven, until beginning to soften, about 10 minutes. Save bowl for use in the next step.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp oregano\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 173755,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Place in the medium bowl with additional oil and oregano; toss to coat and set aside.",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp oregano"
    },
    {
      "id": 173756,
      "primary_message": "Halve and pit the avocado. Slice into chunks while still in the skin, then scoop out into a blender. Juice lime into the blender.",
      "secondary_message": null
    },
    {
      "id": 173757,
      "primary_message": "Peel and mince garlic; add to the blender along with oil, salt, and pepper; purée until smooth, 30-60 seconds. Add water to thin out the dressing if necessary.",
      "secondary_message": "1 clove garlic\n1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper\n1 tbsp water"
    },
    {
      "id": 173758,
      "primary_message": "Remove peppers from the oven and toss. Lay the asparagus on top of the peppers and return to the oven; roast until vegetables are tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 173759,
      "primary_message": "Peel and thinly slice the shallot into rings.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 173760,
      "primary_message": "Cut mozzarella into bite sized pieces.",
      "secondary_message": "½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 173761,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 173762,
      "primary_message": "To serve, divide roasted peppers and asparagus between plates and top with beans, shallots, cheese, and basil; drizzle with dressing and enjoy!",
      "secondary_message": null
    }
  ],
