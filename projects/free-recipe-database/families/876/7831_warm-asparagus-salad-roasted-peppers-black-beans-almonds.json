  "instructions": [
    {
      "id": 173798,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 173799,
      "primary_message": "Drain and rinse the beans in a colander; set aside to drain further.",
      "secondary_message": "2 (398 ml) cans black beans"
    },
    {
      "id": 173800,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n2 yellow bell peppers\n2 small bunches asparagus\n1 avocado\n2 limes\n1 small pkg fresh basil"
    },
    {
      "id": 173801,
      "primary_message": "Cut peppers into large pieces and toss in a large bowl with oil, oregano, salt, and pepper. Spread in a single layer on a parchment-lined baking sheet and roast in the oven, until beginning to soften, 10 minutes. Save bowl for use in the next step.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp oregano\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 173802,
      "primary_message": "Snap or cut off the woody ends of the asparagus. Place in the large bowl with additional oil and oregano.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp oregano"
    },
    {
      "id": 173803,
      "primary_message": "Halve and pit the avocado. Slice into chunks while still in the skin, then scoop out into a blender. Juice lime into the blender.",
      "secondary_message": null
    },
    {
      "id": 173804,
      "primary_message": "Peel and mince garlic; add to the blender along with oil and purée until smooth, 30-60 seconds. Add water to thin out the dressing if necessary.",
      "secondary_message": "2 cloves garlic\n2 tbsp extra virgin olive oil\n2 tbsp water"
    },
    {
      "id": 173805,
      "primary_message": "Add asparagus to the oven with peppers and roast until tender, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 173806,
      "primary_message": "Peel and thinly slice the shallots into rings.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 173807,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 173808,
      "primary_message": "To serve, divide roasted peppers and asparagus between plates and top with beans, shallots, basil, and almonds; drizzle with dressing and enjoy!",
      "secondary_message": "1 cup almonds, sliced"
    }
  ],
