  "instructions": [
    {
      "id": 222640,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 222641,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onions; transfer to a large baking sheet pan.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 222642,
      "primary_message": "Wash, dry, seed, and medium dice bell peppers; add to the baking sheet.",
      "secondary_message": "3 yellow bell peppers"
    },
    {
      "id": 222643,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to combine and spread out in an even layer. Place veggies in the oven and bake until tender, about 15 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 222644,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 222645,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 222646,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and small dice.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless"
    },
    {
      "id": 222647,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and chicken to the skillet and sauté until golden brown and cooked through, 10-12 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 222648,
      "primary_message": "While the chicken is cooking, place tomato sauce, ketchup, Dijon, sugar, vinegar, Worcestershire, and spices in a medium bowl. Whisk to combine.",
      "secondary_message": "1 ½ (213 ml) cans tomato sauce\n3 tbsp ketchup\n3 tbsp Dijon mustard\n2 tbsp brown sugar\n2 tbsp apple cider vinegar\n2 tbsp Worcestershire sauce\n1 ½ tsp salt\n1 ½ tsp onion powder\n¾ tsp chili powder"
    },
    {
      "id": 222649,
      "primary_message": "Pour sauce into the skillet with the chicken. (Reserve bowl for later use). Stir and bring to a simmer over high heat. Reduce heat to medium-low and cook, stirring occasionally, until thickened, 6-7 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 222650,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "1 ½ (227 g) blocks mozzarella cheese"
    },
    {
      "id": 222651,
      "primary_message": "Wash, dry, and, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "1 small bunch cilantro"
    },
    {
      "id": 222652,
      "primary_message": "When the veggies are done, carefully transfer them to the bowl used for the sauce and set aside.",
      "secondary_message": null
    },
    {
      "id": 222653,
      "primary_message": "Divide pitas between two baking sheets. Return to the oven and toast for 5-7 minutes. Remove from oven.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 222654,
      "primary_message": "Top toasted pitas with saucy chicken, cheese, and veggies. Return pitas to the oven and bake until the cheese melts, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 222655,
      "primary_message": "To serve, divide pitas between plates, top with cilantro, and enjoy!",
      "secondary_message": null
    }
  ],
