  "instructions": [
    {
      "id": 222608,
      "primary_message": "Preheat oven to 220°C (425°F).",
      "secondary_message": null
    },
    {
      "id": 222609,
      "primary_message": "Meanwhile, peel, halve, and thinly slice onion; transfer to a baking sheet pan.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 222610,
      "primary_message": "Wash, dry, seed, and medium dice bell pepper; add to the baking sheet.",
      "secondary_message": "1 yellow bell pepper"
    },
    {
      "id": 222611,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper; toss to combine and spread out in an even layer. Place veggies in the oven and bake until tender, 12-15 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 222612,
      "primary_message": "Meanwhile, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 222613,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 222614,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels and small dice.",
      "secondary_message": "⅓ kg chicken breasts, boneless skinless"
    },
    {
      "id": 222615,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add garlic and chicken to the skillet and sauté until golden brown and cooked through, 6-8 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 222616,
      "primary_message": "While the chicken is cooking, place tomato sauce, ketchup, Dijon, sugar, vinegar, Worcestershire, and spices in a small bowl. Whisk to combine.",
      "secondary_message": "½ (213 ml) can tomato sauce\n1 tbsp ketchup\n1 tbsp Dijon mustard\n2 tsp brown sugar\n2 tsp apple cider vinegar\n2 tsp Worcestershire sauce\n½ tsp salt\n½ tsp onion powder\n¼ tsp chili powder"
    },
    {
      "id": 222617,
      "primary_message": "Pour sauce into the skillet with the chicken. (Reserve bowl for later use). Stir and bring to a simmer over high heat. Reduce heat to medium-low and cook, stirring occasionally, until thickened, 4-5 minutes. Remove from heat and set aside.",
      "secondary_message": null
    },
    {
      "id": 222618,
      "primary_message": "Meanwhile, coarsely grate cheese. ",
      "secondary_message": "½ (227 g) block mozzarella cheese"
    },
    {
      "id": 222619,
      "primary_message": "Wash, dry, and, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 222620,
      "primary_message": "When the veggies are done, carefully transfer them to the bowl used for the sauce and set aside.",
      "secondary_message": null
    },
    {
      "id": 222621,
      "primary_message": "Place pitas on the baking sheet. Return to oven and toast for 5 minutes.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 222622,
      "primary_message": "Top toasted pitas with saucy chicken, cheese, and veggies. Return pitas to the oven and bake until the cheese melts, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 222623,
      "primary_message": "To serve, divide pitas between plates, top with cilantro, and enjoy!",
      "secondary_message": null
    }
  ],
