  "instructions": [
    {
      "id": 1,
      "primary_message": "Heat 2 tablespoons oil in a medium saucepan over medium-high heat until shimmering. Add onions, celery, garlic, and rosemary. Cook, stirring frequently, until onions and garlic are softened but not browned, about 4 minutes. Add broth, bay leaves and beans. Bring to a boil, reduce to a bare simmer and cook for 10 minutes. Add spinach and continue cooking until completely wilted, about 5 minutes longer. Season to taste with salt and pepper. Stir in lemon juice. Serve immediately, drizzling remaining olive oil over bowls.",
      "secondary_message": null
    }
