  "instructions": [
    {
      "id": 524193,
      "primary_message": "Peel, quarter, and thinly slice onion. Place in a medium bowl and set aside.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 524194,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 524195,
      "primary_message": "While the pan heats up, small dice bacon. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 524196,
      "primary_message": "Once the pan is hot, add bacon and cook, stirring occasionally, until the bacon is starting to brown, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 524197,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n4 medium carrots\n1 medium zucchini squash\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 524198,
      "primary_message": "When the bacon is starting to brown, add half of the onion to the pan. Continue to cook, stirring frequently, until bacon and onions are crispy and golden, 2-3 minutes more. (Reserve bowl with remaining onion for later use.)",
      "secondary_message": null
    },
    {
      "id": 524199,
      "primary_message": "Using a slotted spoon, remove crispy bacon and onions to a paper towel-lined plate; set aside. (Reserve pan with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 524200,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic. Add both to the bowl with the remaining onion.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 524201,
      "primary_message": "Peel, trim, and large dice carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 524202,
      "primary_message": "Trim and large dice zucchini. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 524203,
      "primary_message": "Return pan (with drippings) to medium-high heat, add butter, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies begin to soften, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n1 tsp turmeric, ground\n½ tsp cumin, ground\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 524204,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place half of the leaves in a small bowl along with additional butter and salt. Mash with the back of a spoon to combine the parsley butter. (Reserve remaining parsley for serving.) ",
      "secondary_message": "1 tbsp butter, unsalted\n⅛ tsp salt"
    },
    {
      "id": 524205,
      "primary_message": "When the veggies are done, add broth to the pan; stir to combine the soup and bring to a boil. Once boiling, reduce heat to medium-low, cover, and simmer until veggies are tender, 6-8 minutes. ",
      "secondary_message": "710 ml chicken or vegetable broth"
    },
    {
      "id": 524206,
      "primary_message": "When the soup is done, using a hand blender, purée until smooth. (If using a regular blender, work in batches as needed, then return soup to the pan.)",
      "secondary_message": null
    },
    {
      "id": 524207,
      "primary_message": "Spread pita with parsley butter and cut into wedges.",
      "secondary_message": "2 whole grain pitas"
    },
    {
      "id": 524208,
      "primary_message": "Divide soup between bowls, then top with crispy bacon, onions, and reserved parsley. Serve with pita on the side and enjoy!",
      "secondary_message": null
    }
  ],
