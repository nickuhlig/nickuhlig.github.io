  "instructions": [
    {
      "id": 524225,
      "primary_message": "Peel, quarter, and thinly slice onions. Place in a large bowl and set aside.",
      "secondary_message": "3 medium yellow onions"
    },
    {
      "id": 524226,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 524227,
      "primary_message": "While the pot heats up, small dice bacon. ",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 524228,
      "primary_message": "Once the pot is hot, add bacon and cook, stirring occasionally, until the bacon is starting to brown, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 524229,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n12 medium carrots\n3 medium zucchini squash\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 524230,
      "primary_message": "When the bacon is starting to brown, add half of the onion to the pot. Continue to cook, stirring frequently, until bacon and onions are crispy and golden, 3-4 minutes more. (Reserve bowl with remaining onion for later use.)",
      "secondary_message": null
    },
    {
      "id": 524231,
      "primary_message": "Using a slotted spoon, remove crispy bacon and onions to a paper towel-lined plate; set aside. (Reserve pot with drippings for later use.)",
      "secondary_message": null
    },
    {
      "id": 524232,
      "primary_message": "Using a clean cutting board, peel and mince ginger and garlic. Add both to the bowl with the remaining onion.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 524233,
      "primary_message": "Peel, trim, and large dice carrots. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 524234,
      "primary_message": "Trim and large dice zucchini. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 524235,
      "primary_message": "Return pot (with drippings) to medium-high heat, add butter, and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until veggies begin to soften, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n1 tbsp turmeric, ground\n1 ½ tsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 524236,
      "primary_message": "Meanwhile, shave parsley leaves off the stems; discard stems and mince the leaves. Place half of the leaves in a small bowl along with additional butter and salt. Mash with the back of a spoon to combine the parsley butter. (Reserve remaining parsley for serving.) ",
      "secondary_message": "3 tbsp butter, unsalted\n¼ tsp salt"
    },
    {
      "id": 524237,
      "primary_message": "When the veggies are done, add broth to the pot; stir to combine the soup and bring to a boil. Once boiling, reduce heat to medium-low, cover, and simmer until veggies are tender, 8-10 minutes. ",
      "secondary_message": "2129 ml chicken or vegetable broth"
    },
    {
      "id": 524238,
      "primary_message": "When the soup is done, using a hand blender, purée until smooth. (If using a regular blender, work in batches as needed, then return soup to the pot.)",
      "secondary_message": null
    },
    {
      "id": 524239,
      "primary_message": "Spread pita with parsley butter and cut into wedges.",
      "secondary_message": "6 whole grain pitas"
    },
    {
      "id": 524240,
      "primary_message": "Divide soup between bowls, then top with crispy bacon, onions, and reserved parsley. Serve with pita on the side and enjoy!",
      "secondary_message": null
    }
  ],
