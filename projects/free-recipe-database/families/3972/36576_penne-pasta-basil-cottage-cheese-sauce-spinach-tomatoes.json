  "instructions": [
    {
      "id": 574159,
      "primary_message": "Fill a large pot halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat.",
      "secondary_message": "1 ½ tsp salt"
    },
    {
      "id": 574160,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 pints grape tomatoes\n1 ½ (5 oz) pkgs baby spinach\n1 ½ lemons\n1 small pkg fresh basil"
    },
    {
      "id": 574161,
      "primary_message": "Once the water is boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve ¾-cup pasta water before draining and reserve pot for later use.)",
      "secondary_message": "15 oz penne pasta"
    },
    {
      "id": 574162,
      "primary_message": "While the pasta is cooking, halve grape tomatoes. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 574163,
      "primary_message": "Roughly chop spinach. Add to the bowl with the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 574164,
      "primary_message": "Juice lemons into a blender.",
      "secondary_message": null
    },
    {
      "id": 574165,
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 574166,
      "primary_message": "Finely grate Parmesan. Add to the blender (reserving a small handful for serving).",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 574167,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 574168,
      "primary_message": "When the pasta is done, add reserved pasta cooking water, cottage cheese, pine nuts, oil, and spices to the blender. Blend until sauce is smooth and creamy.",
      "secondary_message": "2 ¼ cups cottage cheese\n¾ cup pine nuts\n1 tbsp extra virgin olive oil\n1 ½ tsp Italian seasoning\n1 ½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 574169,
      "primary_message": "Return pot to medium heat. Add drained pasta, tomatoes, spinach, and sauce to the pot, then stir to combine. Cook, stirring frequently, until pasta is heated through and spinach is wilted, 2-3 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 574170,
      "primary_message": "To serve, divide pasta between plates or bowls. Top with reserved Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
