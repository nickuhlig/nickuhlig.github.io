  "instructions": [
    {
      "id": 574207,
      "primary_message": "Fill a medium saucepan halfway with hot water (from the tap). Add salt, cover, and bring to a boil over high heat.",
      "secondary_message": "½ tsp salt"
    },
    {
      "id": 574208,
      "primary_message": "Meanwhile, wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 small pkg grape tomatoes\n½ (142 g) pkg baby spinach\n½ lemon\n½ small pkg fresh basil"
    },
    {
      "id": 574209,
      "primary_message": "Once the water is boiling, uncover, add pasta, and stir for a few seconds; cook until desired firmness, 8-10 minutes. Drain pasta and set aside. (Reserve a ¼-cup pasta water before draining and reserve saucepan for later use.)",
      "secondary_message": "142 g penne pasta"
    },
    {
      "id": 574210,
      "primary_message": "While the pasta is cooking, halve grape tomatoes. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 574211,
      "primary_message": "Roughly chop spinach. Add to the bowl with the tomatoes and set aside.",
      "secondary_message": null
    },
    {
      "id": 574212,
      "primary_message": "Juice lemon into a blender.",
      "secondary_message": null
    },
    {
      "id": 574213,
      "primary_message": "Pick basil leaves off the stems; discard stems and add leaves to the blender.",
      "secondary_message": null
    },
    {
      "id": 574214,
      "primary_message": "Finely grate Parmesan. Add to the blender (reserving a small handful for serving).",
      "secondary_message": "28 g Parmesan cheese"
    },
    {
      "id": 574215,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 574216,
      "primary_message": "When the pasta is done, add reserved pasta cooking water, cottage cheese, pine nuts, oil, and spices to the blender. Blend until sauce is smooth and creamy.",
      "secondary_message": "¾ cup cottage cheese\n¼ cup pine nuts\n1 tsp extra virgin olive oil\n½ tsp Italian seasoning\n½ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 574217,
      "primary_message": "Return saucepan to medium heat. Add drained pasta, tomatoes, spinach, and sauce to the pan, then stir to combine. Cook, stirring frequently, until pasta is heated through and spinach is wilted, 1-2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 574218,
      "primary_message": "To serve, divide pasta between plates or bowls. Top with reserved Parmesan and enjoy!",
      "secondary_message": null
    }
  ],
