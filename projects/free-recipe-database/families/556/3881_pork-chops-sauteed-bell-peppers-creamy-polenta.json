  "instructions": [
    {
      "id": 43062,
      "primary_message": "Add hot water (from the tap) to a small saucepan; cover and bring to a boil over high heat.",
      "secondary_message": "2 ½ cups water"
    },
    {
      "id": 43063,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 yellow bell pepper"
    },
    {
      "id": 43064,
      "primary_message": "Quarter the bell peppers lengthwise; remove and discard the stem, seeds, and membranes. Cut the quarters lengthwise into 6-mm-thick strips and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 43065,
      "primary_message": "Once the water is boiling, slowly add the polenta in a thin steady stream while whisking constantly until all the polenta is incorporated into the liquid. Turn the heat down to low and continue whisking until the polenta has thickened. Cover the polenta and cook for 20 to 25 minutes, stirring every 10 minutes or so.",
      "secondary_message": "½ cup polenta (cornmeal)"
    },
    {
      "id": 43066,
      "primary_message": "Trim off and discard the ends of the onion and remove the outer layer; thinly slice crosswise into half-rounds.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 43067,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43068,
      "primary_message": "While the skillet heats up, pat the pork chops dry with paper towels and place on a plate; season generously with salt and pepper on both sides.",
      "secondary_message": "2 pork chops, bone-in\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43069,
      "primary_message": "Once the skillet is hot, add coconut oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 43070,
      "primary_message": "Place the pork chops in the skillet and sear until they develop a nice crust, 2 to 3 minutes per side. Then, reduce the heat to medium and cook the chops, flipping occasionally, until they are cooked through (test using a thermometer or cut into a chop with a knife), another 3 to 5 minutes. Once done, transfer the pork to a plate.",
      "secondary_message": null
    },
    {
      "id": 43071,
      "primary_message": "Once the pork chops have been transferred, add more coconut oil and the onion to the skillet. Cook, stirring frequently, until the onion is softened, 2 to 3 minutes.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 43072,
      "primary_message": "Add the bell peppers to the skillet; cook, stirring occasionally, until just tender, 3 to 4 minutes. Remove from the heat.",
      "secondary_message": null
    },
    {
      "id": 43073,
      "primary_message": "Add olive oil to the polenta and season with salt and pepper; stir to combine.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 43074,
      "primary_message": "To serve, divide the polenta, bell peppers, and pork chops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
