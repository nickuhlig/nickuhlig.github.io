  "instructions": [
    {
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Place in a 6-quart slow cooker insert along with chicken, mushrooms, alfredo sauce, sun-dried tomatoes, salt, and pepper. Stir to combine the chicken alfredo filling, then cover and cook until warmed through and flavors have blended, LOW for 4 hours or HIGH for about 2 hours.",
      "secondary_message": "1 medium yellow onion\n454 g cooked chicken (shredded)\n1 (227 g) pkg sliced white mushrooms\n1 (454 g) jar Alfredo sauce\n⅓ cup sun-dried tomatoes, oil-packed\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "primary_message": "When the chicken alfredo filling is done, wash, dry, trim, and seed bell pepper; slice lengthwise into thin strips. Add to the slow cooker insert, along with Parmesan, and stir to combine. Set slow cooker to HIGH and continue to cook until bell pepper is fork-tender, about 20 minutes.",
      "secondary_message": "1 red bell pepper\n1 cup Parmesan cheese, shredded"
    },
    {
      "primary_message": "Meanwhile, wash, dry, and pick basil leaves off the stems; roll up crosswise and thinly slice into ribbons. Toast buns if desired.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "primary_message": "To serve, fill buns with chicken alfredo filling, sprinkle with basil, and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
