  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Bring the unsalted butter to room temperature.",
      "secondary_message": "1 cup unsalted butter"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, whisk together flour, baking powder, and salt.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a large bowl, beat together butter and sugar until light and fluffy, about 3 minutes. Beat in egg and vanilla.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Add cream cheese to bowl and beat until incorporated. Add flour mixture in two additions, beating until just combined. Stir in sprinkles.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Divide dough into two pieces and cover with plastic wrap. Let chill in refrigerator for at least one hour.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Preheat oven to 175°C (350°F). Line two baking sheets with parchment paper.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Lightly flour a work surface. Roll out one ball of dough to 0.5 cm thickness. Cut out shapes using cookie cutter and transfer to prepared baking sheet. Repeat with the rest of the dough.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Bake cookies until lightly golden, about 15 minutes.",
      "secondary_message": null
    }
  ],
