  "instructions": [
    {
      "id": 194315,
      "primary_message": "Preheat the oven to 220°C (425°F) and place the rack in the center position. Line a sheet pan with parchment paper (optional).",
      "secondary_message": null
    },
    {
      "id": 194316,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "4 medium carrots\n½ small bunch Italian (flat-leaf) parsley\n1 lime"
    },
    {
      "id": 194317,
      "primary_message": "Peel carrots, cut in half lengthwise, and add to the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 194318,
      "primary_message": "Drizzle oil and honey over carrots and sprinkle with spices. Place carrots in the oven and cook, until tender, 15-20 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil\n2 tsp honey\n½ tsp salt\n¼ tsp black pepper\n¼ tsp chili powder"
    },
    {
      "id": 194319,
      "primary_message": "In a small saucepan, combine quinoa and broth; bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes.",
      "secondary_message": "½ cup quinoa\n237 ml chicken or vegetable broth"
    },
    {
      "id": 194320,
      "primary_message": "Meanwhile, shave the parsley leaves off the stems; discard the stems and mince the leaves. Add to a medium bowl (reserving some for garnish). ",
      "secondary_message": null
    },
    {
      "id": 194321,
      "primary_message": "Peel and mince garlic. Zest the lime and add both to the bowl with the parsley. Add salt, pepper, and oil; stir to combine. ",
      "secondary_message": "1 clove garlic\n½ tsp salt\n¼ tsp black pepper\n2 tsp extra virgin olive oil"
    },
    {
      "id": 194322,
      "primary_message": "Drain and rinse chickpeas. Add to the lime zest mixture​, along with the corn, and toss to coat. Add to the baking sheet for the last 5 minutes of cooking.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)\n1 cup frozen corn"
    },
    {
      "id": 194323,
      "primary_message": "Juice the lime into a small bowl. Add yogurt, cumin, and salt; whisk to combine.",
      "secondary_message": "½ cup plain Greek yogurt\n1 tsp cumin\n½ tsp salt"
    },
    {
      "id": 194324,
      "primary_message": "To serve, divide quinoa between bowls, add roasted carrots, chickpeas, and corn. Drizzle with cumin yogurt and top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
