  "instructions": [
    {
      "id": 354389,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ small bunch cilantro\n1 lime\n½ pint grape tomatoes\n½ avocado"
    },
    {
      "id": 354390,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 354391,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "2 tsp butter, unsalted\n8 oz veggie ground, plant based\n1 tsp cumin, ground\n1 tsp chili powder\n½ tsp oregano, dried\n¼ tsp salt"
    },
    {
      "id": 354392,
      "primary_message": "Meanwhile, peel and mince garlic. Once the veggie ground is done, add the garlic and stir to combine. Transfer to a medium bowl and loosely cover with aluminum foil. (Reserve skillet for later use.)",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 354393,
      "primary_message": "Peel, halve, and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 354394,
      "primary_message": "Return skillet to medium-high heat, add more butter and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 354395,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 354396,
      "primary_message": "Add cauliflower and spices to the skillet with the onion. Continue to cook, stirring often, until cauliflower is lightly golden and cooked through, 5-7 minutes more. ",
      "secondary_message": "½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 354397,
      "primary_message": "While the cauliflower is cooking, coarsely grate the cheese.",
      "secondary_message": "¼ (8 oz) block cheddar cheese"
    },
    {
      "id": 354398,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 354399,
      "primary_message": "Cut half of the lime into wedges, reserving the rest for the cauliflower rice.",
      "secondary_message": null
    },
    {
      "id": 354400,
      "primary_message": "When the cauliflower rice is done, juice remaining lime into the skillet. Add cilantro and veggie ground; gently stir to combine and continue to cook until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 354401,
      "primary_message": "Meanwhile, halve tomatoes. Halve and pit avocado; slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 354402,
      "primary_message": "To serve, divide cauliflower rice mixture between plates or bowls and top with grated cheese, tomatoes, and avocado. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
