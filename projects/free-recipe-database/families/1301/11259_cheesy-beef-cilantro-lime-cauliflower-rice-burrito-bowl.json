  "instructions": [
    {
      "id": 354459,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch cilantro\n3 limes\n1 ½ small pkgs grape tomatoes\n1 ½ avocados"
    },
    {
      "id": 354460,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 354461,
      "primary_message": "Once the pot is hot, add ground beef and spices. Cook, breaking apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "1.02 kg lean ground beef\n1 tbsp cumin, ground\n1 tbsp chili powder\n1 ½ tsp oregano, dried\n¾ tsp salt"
    },
    {
      "id": 354462,
      "primary_message": "Meanwhile, peel and mince garlic. Once the beef is done cooking, add the garlic and stir to combine. Transfer to a medium bowl and loosely cover with foil.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 354463,
      "primary_message": "Peel and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 354464,
      "primary_message": "Return the pot to medium-high heat, add butter and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 5-6 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 354465,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 354466,
      "primary_message": "Add cauliflower and spices to the pot with the onion. Continue to cook, stirring often, until cauliflower is lightly golden and cooked through, 7-9 minutes more. ",
      "secondary_message": "1 ½ tsp chili powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 354467,
      "primary_message": "Grate the cheese.",
      "secondary_message": "¾ (227 g) block cheddar cheese"
    },
    {
      "id": 354468,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 354469,
      "primary_message": "Cut half the limes into wedges, reserving the rest for the cauliflower rice.",
      "secondary_message": null
    },
    {
      "id": 354470,
      "primary_message": "When the cauliflower rice is done, juice remaining limes into the pot. Add cilantro and beef; gently stir to combine and continue to cook until heated through, 2-3 minutes more.",
      "secondary_message": null
    },
    {
      "id": 354471,
      "primary_message": "Meanwhile, halve tomatoes. Halve and pit avocados; slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 354472,
      "primary_message": "To serve, divide cauliflower rice mixture between bowls or plates and top with grated cheese, tomatoes, and avocado. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
