  "instructions": [
    {
      "id": 354473,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ medium head cauliflower\n½ small bunch cilantro\n1 lime"
    },
    {
      "id": 354474,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 354475,
      "primary_message": "Once the skillet is hot, add ground beef and spices. Cook, breaking apart with a spoon, until browned and crumbly, 3-4 minutes.",
      "secondary_message": "⅓ kg lean ground beef\n¾ tsp cumin, ground\n¾ tsp chili powder\n½ tsp oregano, dried\n¼ tsp salt"
    },
    {
      "id": 354476,
      "primary_message": "Meanwhile, peel and mince garlic. Once the beef is done cooking, add the garlic and stir to combine. Transfer to a medium bowl and loosely cover with foil.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 354477,
      "primary_message": "Peel and small dice onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 354478,
      "primary_message": "Return skillet to medium-high heat, add butter and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 3-4 minutes.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 354479,
      "primary_message": "Meanwhile, cut the cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 354480,
      "primary_message": "Add cauliflower and spices to the skillet with the onion. Continue to cook, stirring often, until cauliflower is lightly golden and cooked through, 5-7 minutes more. ",
      "secondary_message": "½ tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 354481,
      "primary_message": "Grate the cheese.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 354482,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 354483,
      "primary_message": "Cut half the lime into wedges, reserving the rest for the cauliflower rice.",
      "secondary_message": null
    },
    {
      "id": 354484,
      "primary_message": "When the cauliflower rice is done, juice remaining lime into the skillet. Add cilantro and beef; gently stir to combine and continue to cook until heated through, 1-2 minutes more.",
      "secondary_message": null
    },
    {
      "id": 354485,
      "primary_message": "To serve, divide cauliflower rice mixture between bowls or plates and top with grated cheese. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
