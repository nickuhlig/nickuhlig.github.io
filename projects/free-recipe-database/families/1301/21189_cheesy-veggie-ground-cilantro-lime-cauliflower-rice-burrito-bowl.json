  "instructions": [
    {
      "id": 354417,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ medium heads cauliflower\n1 small bunch cilantro\n3 limes\n1 ½ pints grape tomatoes\n1 ½ avocados"
    },
    {
      "id": 354418,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 354419,
      "primary_message": "Once the pot is hot, add butter and swirl to coat the bottom. Add veggie ground and spices; cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tbsp butter, unsalted\n24 oz veggie ground, plant based\n1 tbsp cumin, ground\n1 tbsp chili powder\n1 ½ tsp oregano, dried\n¾ tsp salt"
    },
    {
      "id": 354420,
      "primary_message": "Meanwhile, peel and mince garlic. Once the veggie ground is done, add the garlic and stir to combine. Transfer to a medium bowl and loosely cover with aluminum foil. (Reserve pot for later use.)",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 354421,
      "primary_message": "Peel, halve, and small dice onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 354422,
      "primary_message": "Return pot to medium-high heat, add more butter and swirl to coat the bottom. Add onion and cook, stirring often, until it begins to soften, 4-5 minutes.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 354423,
      "primary_message": "Meanwhile, cut each cauliflower head into quarters, then trim off and discard the leaves and thick stem. Using a box grater or food processor, coarsely grate the cauliflower.",
      "secondary_message": null
    },
    {
      "id": 354424,
      "primary_message": "Add cauliflower and spices to the pot with the onion. Continue to cook, stirring often, until cauliflower is lightly golden and cooked through, 7-8 minutes more. ",
      "secondary_message": "1 ½ tsp chili powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 354425,
      "primary_message": "While the cauliflower is cooking, coarsely grate the cheese.",
      "secondary_message": "¾ (8 oz) block cheddar cheese"
    },
    {
      "id": 354426,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 354427,
      "primary_message": "Cut half of the limes into wedges, reserving the rest for the cauliflower rice.",
      "secondary_message": null
    },
    {
      "id": 354428,
      "primary_message": "When the cauliflower rice is done, juice remaining limes into the pot. Add cilantro and veggie ground; gently stir to combine and continue to cook until heated through, about 2 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 354429,
      "primary_message": "Meanwhile, halve tomatoes. Halve and pit avocados; slice thinly while still in skin, then scoop out with a spoon.",
      "secondary_message": null
    },
    {
      "id": 354430,
      "primary_message": "To serve, divide cauliflower rice mixture between plates or bowls and top with grated cheese, tomatoes, and avocado. Garnish with lime wedges and enjoy!",
      "secondary_message": null
    }
  ],
