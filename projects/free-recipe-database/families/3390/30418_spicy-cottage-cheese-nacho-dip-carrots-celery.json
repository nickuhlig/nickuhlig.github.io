    },
    {
      "id": 484102,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 484103,
      "primary_message": "Add cottage cheese, shredded cheese, salsa, and chili powder to the blender. Blend on high for several minutes until smooth, scraping down the sides of the blender as needed. Add water, 1 tablespoon at a time, if needed, to reach desired consistency. Set aside.",
      "secondary_message": "¾ cup cottage cheese\n⅓ cup shredded cheese, Mexican blend\n½ cup salsa\n¾ tsp chili powder"
    },
    {
      "id": 484104,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks.",
      "secondary_message": null
    },
    {
