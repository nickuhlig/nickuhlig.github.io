  "instructions": [
    {
      "id": 484149,
      "primary_message": "This recipe will make about 5 cups of dip. Work in batches to best fit your blender or food processor.",
      "secondary_message": null
    },
    {
      "id": 484150,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ limes\n9 medium carrots\n9 sticks celery"
    },
    {
      "id": 484151,
      "primary_message": "Juice limes into a blender.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 484152,
      "primary_message": "Peel garlic and add to the blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 484153,
      "primary_message": "Add cottage cheese, shredded cheese, salsa, and chili powder to the blender. Blend on high for several minutes until smooth, scraping down the sides of the blender as needed. Add water, 1-2 tablespoons at a time, if needed, to reach desired consistency. Set aside.",
      "secondary_message": "2 ¼ cups cottage cheese\n1 cup shredded cheese, Mexican blend\n1 ½ cup salsa\n2 tsp chili powder"
    },
    {
      "id": 484154,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks.",
      "secondary_message": null
    },
    {
      "id": 484155,
      "primary_message": "Trim and halve celery lengthwise, then cut crosswise into 3-inch long sticks.",
      "secondary_message": null
    },
    {
      "id": 484156,
      "primary_message": "Divide dip between bowls and serve with veggie sticks on the side. Enjoy!",
      "secondary_message": null
    }
  ],
