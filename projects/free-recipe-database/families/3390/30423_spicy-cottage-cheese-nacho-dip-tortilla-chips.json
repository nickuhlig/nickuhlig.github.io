  "instructions": [
    {
      "id": 484130,
      "primary_message": "This recipe will make about 5 cups of dip. Work in batches to best fit your blender or food processor.",
      "secondary_message": null
    },
    {
      "id": 484131,
      "primary_message": "Peel garlic and place in a blender.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 484132,
      "primary_message": "Wash, dry, and juice limes into the blender.",
      "secondary_message": "1 ½ limes"
    },
    {
      "id": 484133,
      "primary_message": "Add cottage cheese, shredded cheese, salsa, and chili powder to the blender. Blend on high for several minutes until smooth, scraping down the sides of the blender as needed. Add water, 1-2 tablespoons at a time, if needed, to reach desired consistency.",
      "secondary_message": "2 ¼ cups cottage cheese\n1 cup shredded cheese, Mexican blend\n1 ½ cup salsa\n2 tsp chili powder"
    },
    {
      "id": 484134,
      "primary_message": "Divide dip between bowls and serve with tortilla chips on the side. Enjoy!",
      "secondary_message": "170 g tortilla chips"
    }
  ],
