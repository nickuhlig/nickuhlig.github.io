  "instructions": [
    {
      "primary_message": "Transfer pork to a microwave safe bowl and separate the meat with two forks. Cover the bowl with a damp paper towel and place in the microwave. Heat on high until warmed through, about 3 minutes.",
      "secondary_message": "½ (14 oz) pkg shredded pork, pre-cooked"
    },
    {
      "primary_message": "Meanwhile, wash and dry lime. Juice half into a medium bowl, add guacamole, salt, and pepper, then stir to combine. Add shredded cabbage and stir once more to combine the slaw. Cut remaining lime into wedges and set aside for serving.",
      "secondary_message": "1 lime\n⅓ cup guacamole\n⅛ tsp salt\n⅛ tsp black pepper\n½ (14 oz) bag shredded cabbage (coleslaw mix)"
    },
    {
      "primary_message": "Warm tortillas in a skillet or microwave (optional).",
      "secondary_message": null
    },
    {
      "primary_message": "Divide tortillas between plates, then fill with slaw and shredded pork. Serve with lime wedges on the side. Enjoy!",
      "secondary_message": null
    }
  ],
