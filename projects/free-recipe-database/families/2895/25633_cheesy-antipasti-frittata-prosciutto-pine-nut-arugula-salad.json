  "instructions": [
    {
      "id": 421143,
      "primary_message": "Preheat an ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 421144,
      "primary_message": "Once the skillet is hot, add the prosciutto and cook until crispy, about 1 minute per side. Remove to a plate and set aside. (Reserve skillet for the frittata.)",
      "secondary_message": "4 slices prosciutto"
    },
    {
      "id": 421145,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 421146,
      "primary_message": "Roughly chop olives. Place in a medium bowl. ",
      "secondary_message": "¼ cup Kalamata olives, pitted"
    },
    {
      "id": 421147,
      "primary_message": "Drain and roughly chop roasted peppers and artichoke hearts. Add both to the bowl with the olives along with eggs, Italian seasoning, and salt. Whisk to combine.",
      "secondary_message": "½ (340 g) jar roasted red bell peppers\n1 (170 ml) jar artichoke hearts, marinated\n6 eggs\n½ tsp Italian seasoning\n⅛ tsp salt"
    },
    {
      "id": 421148,
      "primary_message": "Return the skillet to medium heat, add oil, and swirl to coat the bottom. Pour the egg mixture into the skillet. As eggs set around the edge, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 421149,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": "⅔ cup shredded cheese, Italian blend"
    },
    {
      "id": 421150,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Place in a clean medium bowl along with pine nuts and dressing. Toss to combine the salad.",
      "secondary_message": "½ (142 g) pkg baby arugula\n¼ cup pine nuts\n2 tbsp Italian salad dressing"
    },
    {
      "id": 421151,
      "primary_message": "Cut frittata into wedges and divide between plates; crumble crispy prosciutto over top. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
