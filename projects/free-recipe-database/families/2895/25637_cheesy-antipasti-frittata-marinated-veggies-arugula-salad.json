  "instructions": [
    {
      "id": 421178,
      "primary_message": "Roughly chop olives. Place in a large bowl. ",
      "secondary_message": "½ cup Kalamata olives, pitted"
    },
    {
      "id": 421179,
      "primary_message": "Drain and roughly chop roasted peppers and artichoke hearts. Add both to the bowl with the olives along with eggs, Italian seasoning, and salt. Whisk to combine.",
      "secondary_message": "1 (340 g) jar roasted red bell peppers\n2 (170 ml) jars artichoke hearts, marinated\n12 eggs\n1 tsp Italian seasoning\n¼ tsp salt"
    },
    {
      "id": 421180,
      "primary_message": "Preheat a large ovenproof skillet over medium-high heat. ",
      "secondary_message": null
    },
    {
      "id": 421181,
      "primary_message": "While the skillet heats up, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 421182,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Pour the egg mixture into the skillet. As eggs set around the edge, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 421183,
      "primary_message": "Sprinkle cheese over the frittata. Place skillet in the oven and broil until top is set and cheese is melted, 3-4 minutes. Remove from oven.",
      "secondary_message": "1 ⅓ cups shredded cheese, Italian blend"
    },
    {
      "id": 421184,
      "primary_message": "While the frittata is cooking, wash and dry arugula (skip this step if it came pre-washed). Place in a medium bowl along with pine nuts and dressing. Toss to combine the salad.",
      "secondary_message": "1 (142 g) pkg baby arugula\n½ cup pine nuts\n¼ cup Italian salad dressing"
    },
    {
      "id": 421185,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
