  "instructions": [
    {
      "id": 1,
      "primary_message": "Pour milk into freezer safe container and freeze until half frozen, about 1 1/2 hours.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "While milk is freezing, place chocolate and water in microwave safe bowl and heat on high power until chocolate is melted, about 30 seconds. Whisk in cocoa until smooth; set aside.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Halve and pit avocado. Scoop avocado flesh into blender. Add chocolate mixture, sugar, vanilla, and frozen milk. Blend until smooth, 15 to 30 seconds. Serve.",
      "secondary_message": null
    }
  ],
