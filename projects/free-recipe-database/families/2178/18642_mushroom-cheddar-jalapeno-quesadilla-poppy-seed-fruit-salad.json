  "instructions": [
    {
      "id": 305398,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n4 caps portobello mushrooms\n2 jalapeño peppers\n1 small bunch green onions (scallions)\n2 Gala apples\n4 kiwifruit\n1 (6 oz) pkg blueberries"
    },
    {
      "id": 305399,
      "primary_message": "Juice lime into a medium bowl; add yogurt, poppy seeds, and sugar. Whisk to combine the dressing and set aside. ",
      "secondary_message": "½ cup plain Greek yogurt\n2 tsp poppy seeds\n2 tsp brown sugar"
    },
    {
      "id": 305400,
      "primary_message": "Remove stems from mushrooms and carefully scrape out the gills; halve and slice crosswise into ¼-inch thick pieces.",
      "secondary_message": null
    },
    {
      "id": 305401,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 305402,
      "primary_message": "While the skillet heats up, peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 305403,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add mushrooms, garlic, and spices. Cook, stirring occasionally, until soft, 4-5 minutes; remove from heat.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 305404,
      "primary_message": "Meanwhile, halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Slice crosswise into thin half-moons. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 305405,
      "primary_message": "Trim green onions and cut crosswise into ¼-inch pieces.",
      "secondary_message": null
    },
    {
      "id": 305406,
      "primary_message": "Coarsely grate cheese.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 305407,
      "primary_message": "To assemble the quesadillas, lay tortillas on a flat surface and divide mushrooms, jalapeño, green onion, and cheese between them, arranging on one half of each tortilla; fold in half to close. (Reserve skillet for the next step.)",
      "secondary_message": "4 large flour tortillas"
    },
    {
      "id": 305408,
      "primary_message": "Wipe the skillet clean with paper towels and return to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 305409,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, place assembled quesadillas in the skillet and cook, flipping halfway through, until golden on both sides, 5-6 minutes. Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 305410,
      "primary_message": "Meanwhile, using a clean cutting board, quarter, core, and medium dice apples; add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 305411,
      "primary_message": "Trim, peel, and medium dice kiwis; add to the bowl, along with the blueberries, and stir to combine the fruit salad.",
      "secondary_message": null
    },
    {
      "id": 305412,
      "primary_message": "Cut each quesadilla into wedges and divide between plates. Serve with fruit salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
