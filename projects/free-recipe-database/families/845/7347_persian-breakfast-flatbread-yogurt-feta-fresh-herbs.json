  "instructions": [
    {
      "id": 104122,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 tomatoes\n1 ½ English cucumbers\n¾ small pkg fresh mint\n¾ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 104123,
      "primary_message": "Thinly slice the tomatoes; transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 104124,
      "primary_message": "Peel cucumbers, then trim off and discard the ends. Medium dice the cucumbers and add to the plate with the tomatoes.",
      "secondary_message": null
    },
    {
      "id": 104125,
      "primary_message": "Shave parsley leaves off the stems; discard the stems and roughly chop the leaves. Transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 104126,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 104127,
      "primary_message": "Pick mint leaves off the stems; discard the stems and roughly chop the leaves. Add to the bowl with the parsley.",
      "secondary_message": null
    },
    {
      "id": 104128,
      "primary_message": "Working in batches if necessary, add the flatbreads to the hot grill pan and cook, turning halfway through, until lightly toasted, about 5 minutes per flatbread.",
      "secondary_message": "3 flatbreads or naan"
    },
    {
      "id": 104129,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "1 ½ cloves garlic"
    },
    {
      "id": 104130,
      "primary_message": "Add garlic and yogurt to a medium bowl and stir to combine. Spoon garlicky yogurt over the warm flatbreads.",
      "secondary_message": "3 cups plain Greek yogurt"
    },
    {
      "id": 104131,
      "primary_message": "Top the flatbread with tomato, cucumber, feta, herbs, and a drizzle of oil and season with salt and pepper.",
      "secondary_message": "1 ½ (4 oz) pkgs crumbled feta cheese\n3 tbsp extra virgin olive oil\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 104132,
      "primary_message": "Slice the flatbreads into wedges and divide between plates. Enjoy!",
      "secondary_message": null
    }
  ],
