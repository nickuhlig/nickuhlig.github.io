  "instructions": [
    {
      "id": 625992,
      "primary_message": "Preheat oven to 425°F. Coat a baking sheet pan with a thin layer of oil.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 625993,
      "primary_message": "Place beef, bread crumbs, egg, and spices in a medium bowl. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the mixture into meatballs and transfer to the baking sheet.",
      "secondary_message": "¾ lb lean ground beef\n¼ cup panko bread crumbs\n1 egg\n1 tsp chili powder\n½ tsp cumin, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 625994,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 625995,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 625996,
      "primary_message": "Trim, seed, and medium dice bell pepper. Place in a small bowl.",
      "secondary_message": null
    },
    {
      "id": 625997,
      "primary_message": "Quarter jalapeño pepper lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 625998,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 625999,
      "primary_message": "While the pan heats up, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 626000,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies, cilantro, and spices; cook, stirring occasionally, until veggies are softened, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp chili powder\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 626001,
      "primary_message": "Add tomatoes and tomato sauce to the pan, then stir to combine. Continue to cook, stirring occasionally, until the sauce thickens slightly, 5-6 minutes more. Remove from heat.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n1 (8 oz) can tomato sauce"
    },
    {
      "id": 626002,
      "primary_message": "When the meatballs are done, add to the pan with the sauce and stir once more to combine.",
      "secondary_message": null
    },
    {
      "id": 626003,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "4 small corn tortillas"
    },
    {
      "id": 626004,
      "primary_message": "Divide meatballs between plates or bowls. Top with reserved cilantro and serve with tortillas on the side. Enjoy!",
      "secondary_message": null
    }
  ],
