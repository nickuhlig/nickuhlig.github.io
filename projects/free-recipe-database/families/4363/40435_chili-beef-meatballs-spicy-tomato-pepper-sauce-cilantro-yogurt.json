  "instructions": [
    {
      "id": 626193,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a large baking sheet pan with a thin layer of oil.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 626194,
      "primary_message": "Place beef, bread crumbs, eggs, and spices in a medium bowl. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the mixture into meatballs and transfer to the baking sheet.",
      "secondary_message": "0.68 kg lean ground beef\n½ cup panko bread crumbs\n2 eggs\n2 tsp chili powder\n1 tsp cumin, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 626195,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 626196,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 626197,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 626198,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 626199,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 626200,
      "primary_message": "While the pot heats up, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 626201,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, cilantro, and spices; cook, stirring occasionally, until veggies are softened, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp chili powder\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 626202,
      "primary_message": "Add tomatoes and tomato sauce to the pot, then stir to combine. Continue to cook, stirring occasionally, until the sauce thickens slightly, 5-6 minutes more. Remove from heat.",
      "secondary_message": "2 (398 ml) cans diced tomatoes\n2 (213 ml) cans tomato sauce"
    },
    {
      "id": 626203,
      "primary_message": "When the meatballs are done, add to the pot with the sauce and stir once more to combine.",
      "secondary_message": null
    },
    {
      "id": 626204,
      "primary_message": "To serve, divide meatballs between plates or bowls. Top with yogurt and reserved cilantro. Enjoy!",
      "secondary_message": "1 cup plain Greek yogurt"
    }
  ],
