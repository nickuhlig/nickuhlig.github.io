  "instructions": [
    {
      "id": 626168,
      "primary_message": "Preheat oven to 220°C (425°F). Coat two baking sheet pans with a thin layer of oil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 626169,
      "primary_message": "Place beef, bread crumbs, eggs, and spices in a large bowl. Using your hands, mix well to combine. Using a rounded tablespoon measure, form the mixture into meatballs and divide between the baking sheets.",
      "secondary_message": "1.02 kg lean ground beef\n¾ cup panko bread crumbs\n3 eggs\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 626170,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 626171,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 626172,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 626173,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Small dice and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 626174,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 626175,
      "primary_message": "While the pot heats up, shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 626176,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, cilantro, and spices; cook, stirring occasionally, until veggies are softened, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp chili powder\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 626177,
      "primary_message": "Add tomatoes and tomato sauce to the pot, then stir to combine. Continue to cook, stirring occasionally, until the sauce thickens slightly, 6-8 minutes more. Remove from heat.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n3 (213 ml) cans tomato sauce"
    },
    {
      "id": 626178,
      "primary_message": "When the meatballs are done, add to the pot with the sauce and stir once more to combine.",
      "secondary_message": null
    },
    {
      "id": 626179,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 626180,
      "primary_message": "Divide meatballs between plates or bowls. Top with reserved cilantro and serve with tortillas on the side. Enjoy!",
      "secondary_message": null
    }
  ],
