  "instructions": [
    {
      "id": 1,
      "primary_message": "Adjust oven rack to middle position and preheat oven to 190°C (375°F). Spray standard muffin tin (see notes) with nonstick pan spray. Sift flour, cocoa, baking powder, baking soda, and salt into a medium bowl; set aside. In a large bowl, whisk sugar with eggs until light, about 30 seconds. Whisk in oil, milk, vanilla, and espresso until combined.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Whisk dry mixture into wet mixture until just combined. Stir in 1 cup chips.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Evenly divide batter between muffin cups and sprinkle with remaining chips. Bake until set, 17 to 19 minutes. Let muffins cool in pan 15 minutes, then remove muffins from tin and place on wire rack to cool.",
      "secondary_message": null
    }
  ],
