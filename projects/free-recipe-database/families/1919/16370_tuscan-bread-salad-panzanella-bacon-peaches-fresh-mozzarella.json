  "instructions": [
    {
      "id": 267757,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n½ English cucumber\n1 small pkg grape tomatoes\n2 peaches\n½ small pkg fresh basil"
    },
    {
      "id": 267758,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267759,
      "primary_message": "While the skillet heats up, small dice bacon. ",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 267760,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 4-5 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": null
    },
    {
      "id": 267761,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a medium bowl; whisk to combine the dressing and set aside. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp white wine vinegar\n½ tsp Dijon mustard\n½ tsp honey\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 267762,
      "primary_message": "Using a clean cutting board, cut or tear bread into bite-sized pieces. ",
      "secondary_message": "2 slices whole grain bread"
    },
    {
      "id": 267763,
      "primary_message": "Return skillet (with bacon drippings) to low heat. Add bread and cook, stirring occasionally, until golden brown and crisp, 4-5 minutes. Remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 267764,
      "primary_message": "While the croutons are cooking, peel, halve, and slice shallot into thin half-moons. Add to the bowl with the dressing and stir to combine. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 267765,
      "primary_message": "Trim, seed, and small dice bell pepper; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267766,
      "primary_message": "Trim and medium dice cucumber; halve tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 267767,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice each quarter and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267768,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267769,
      "primary_message": "Medium dice mozzarella and add to the bowl along with the croutons; toss to combine the salad. ",
      "secondary_message": "½ (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 267770,
      "primary_message": "To serve, divide salad between plates or bowls. Top with bacon and enjoy!",
      "secondary_message": null
    }
  ],
