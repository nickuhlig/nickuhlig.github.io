  "instructions": [
    {
      "id": 267629,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ English cucumbers\n3 pints grape tomatoes\n6 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 267630,
      "primary_message": "Small dice bacon. ",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 267631,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 267632,
      "primary_message": "Once the skillet is hot, add bacon and cook, stirring occasionally, until crispy, 5-6 minutes. Using a slotted spoon, transfer bacon to a paper towel-lined plate, leaving the drippings in the skillet.",
      "secondary_message": null
    },
    {
      "id": 267633,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl; whisk to combine the dressing and set aside. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 267634,
      "primary_message": "Using a clean cutting board, cut or tear bread into bite-sized pieces. ",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 267635,
      "primary_message": "Return skillet (with bacon drippings) to low heat. Add bread and cook, stirring occasionally, until golden brown and crisp, 5-6 minutes. Remove from the heat. ",
      "secondary_message": null
    },
    {
      "id": 267636,
      "primary_message": "While the croutons are cooking, peel, halve, and slice onion into thin half-moons. Add to the bowl with the dressing and stir to combine. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 267637,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267638,
      "primary_message": "Trim and medium dice cucumbers; halve tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 267639,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice each quarter and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267640,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267641,
      "primary_message": "Medium dice mozzarella and add to the bowl along with the croutons; toss to combine the salad. ",
      "secondary_message": "1 ½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 267642,
      "primary_message": "To serve, divide salad between plates or bowls. Top with bacon and enjoy!",
      "secondary_message": null
    }
  ],
