  "instructions": [
    {
      "id": 267823,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n1 ½ English cucumbers\n3 small pkgs grape tomatoes\n6 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 267824,
      "primary_message": "Cut or tear bread into bite-sized pieces. ",
      "secondary_message": "6 slices whole grain bread"
    },
    {
      "id": 267825,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 267826,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread to the skillet and cook, stirring occasionally, until golden brown and crisp, 5-6 minutes. Remove from the heat. ",
      "secondary_message": "¼ cup extra virgin olive oil"
    },
    {
      "id": 267827,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp white wine vinegar\n1 ½ tsp Dijon mustard\n1 ½ tsp honey\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 267828,
      "primary_message": "Peel, halve, and slice onion into thin half-moons. Add to the bowl with the dressing and stir to combine. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 267829,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267830,
      "primary_message": "Trim and medium dice cucumbers; halve tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 267831,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice each quarter and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267832,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267833,
      "primary_message": "Medium dice mozzarella and add to the bowl along with the croutons; toss to combine the salad. ",
      "secondary_message": "3 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 267834,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
