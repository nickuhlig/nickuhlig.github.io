  "instructions": [
    {
      "id": 267811,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 red bell peppers\n1 English cucumber\n2 small pkgs grape tomatoes\n4 peaches\n1 small pkg fresh basil"
    },
    {
      "id": 267812,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 267813,
      "primary_message": "While the skillet heats up, cut or tear bread into bite-sized pieces. ",
      "secondary_message": "4 slices whole grain bread"
    },
    {
      "id": 267814,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add bread to the skillet and cook, stirring occasionally, until golden brown and crisp, 4-5 minutes. Remove from the heat. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 267815,
      "primary_message": "Meanwhile, place oil, vinegar, Dijon, honey, salt, and pepper in a large bowl; whisk to combine the dressing. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp white wine vinegar\n1 tsp Dijon mustard\n1 tsp honey\n1 tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 267816,
      "primary_message": "Peel, halve, and slice shallots into thin half-moons. Add to the bowl with the dressing and stir to combine. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 267817,
      "primary_message": "Trim, seed, and small dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267818,
      "primary_message": "Trim and medium dice cucumber; halve tomatoes. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 267819,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice each quarter and add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267820,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 267821,
      "primary_message": "Medium dice mozzarella and add to the bowl along with the croutons; toss to combine the salad. ",
      "secondary_message": "2 (227 g) pkg fresh mozzarella cheese"
    },
    {
      "id": 267822,
      "primary_message": "To serve, divide salad between plates or bowls and enjoy!",
      "secondary_message": null
    }
  ],
