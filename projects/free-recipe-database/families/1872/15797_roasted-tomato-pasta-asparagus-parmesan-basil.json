  "instructions": [
    {
      "id": 259312,
      "primary_message": "Preheat oven to 400°F.",
      "secondary_message": null
    },
    {
      "id": 259313,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 pint grape tomatoes\n½ small bunch asparagus\n½ small pkg fresh basil"
    },
    {
      "id": 259314,
      "primary_message": "Place tomatoes in a baking dish and arrange in a single layer. Cut butter into small pieces and dot over the tomatoes. Drizzle with vinegar and season with salt and pepper.",
      "secondary_message": "3 tbsp butter, unsalted\n½ tsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 259315,
      "primary_message": "Place baking dish in the oven and roast, tossing halfway through, until tomatoes begin to burst, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 259316,
      "primary_message": "Meanwhile, fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 6 minutes.",
      "secondary_message": "1 tsp salt\n5 oz linguine pasta"
    },
    {
      "id": 259317,
      "primary_message": "While the pasta is cooking, snap or cut off the woody ends of the asparagus. Cut into 1-inch pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 259318,
      "primary_message": "Finely grate Parmesan and set aside. ",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 259319,
      "primary_message": "Add asparagus to the pan with the pasta and continue to cook until pasta reaches desired firmness and asparagus is tender, about 3 minutes. Drain pasta and asparagus in a colander, reserving ½-cup of pasta cooking water. (Reserve saucepan for later use.)",
      "secondary_message": null
    },
    {
      "id": 259320,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 259321,
      "primary_message": "Return the saucepan to low heat. Add roasted tomatoes, drained pasta, and asparagus; cook, stirring occasionally, until tomatoes coat the pasta, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 259322,
      "primary_message": "Add Parmesan to the pan and stir until melted. ",
      "secondary_message": null
    },
    {
      "id": 259323,
      "primary_message": "Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency.",
      "secondary_message": null
    },
    {
      "id": 259324,
      "primary_message": "To serve, divide pasta between bowls and enjoy!",
      "secondary_message": null
    }
  ],
