  "instructions": [
    {
      "id": 259442,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 259443,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small pkgs grape tomatoes\n1 small bunch asparagus\n1 small pkg fresh basil"
    },
    {
      "id": 259444,
      "primary_message": "Place tomatoes in a large baking dish and arrange in a single layer. Cut butter into small pieces and dot over the tomatoes. Drizzle with vinegar and season with salt and pepper.",
      "secondary_message": "¼ cup butter, unsalted\n1 tsp balsamic vinegar\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 259445,
      "primary_message": "Place baking dish in the oven and roast, tossing halfway through, until tomatoes begin to burst, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 259446,
      "primary_message": "Meanwhile, fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until almost done, about 6 minutes.",
      "secondary_message": "2 tsp salt\n283 g linguine pasta"
    },
    {
      "id": 259447,
      "primary_message": "While the pasta is cooking, snap or cut off the woody ends of the asparagus. Cut into 1-inch pieces and set aside.",
      "secondary_message": null
    },
    {
      "id": 259448,
      "primary_message": "Finely grate Parmesan and set aside. ",
      "secondary_message": "113 g Parmesan cheese"
    },
    {
      "id": 259449,
      "primary_message": "Add asparagus to the pot with the pasta and continue to cook until pasta reaches desired firmness and asparagus is tender, about 3 minutes. Drain pasta and asparagus in a colander, reserving 1 cup of pasta cooking water. (Reserve pot for later use.)",
      "secondary_message": null
    },
    {
      "id": 259450,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 259451,
      "primary_message": "Return the pot to low heat. Add roasted tomatoes, drained pasta, and asparagus; cook, stirring occasionally, until tomatoes coat the pasta, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 259452,
      "primary_message": "Add Parmesan to the pot and stir until melted. ",
      "secondary_message": null
    },
    {
      "id": 259453,
      "primary_message": "Add reserved pasta water, a few tablespoons at a time, if necessary, to reach a saucy consistency.",
      "secondary_message": null
    },
    {
      "id": 259454,
      "primary_message": "To serve, divide pasta between bowls, top with pine nuts, and enjoy!",
      "secondary_message": "¼ cup pine nuts"
    }
  ],
