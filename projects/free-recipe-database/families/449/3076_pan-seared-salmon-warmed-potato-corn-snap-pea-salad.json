  "instructions": [
    {
      "id": 30710,
      "primary_message": "Preheat the oven to 450°F. Place the rack in the center position.",
      "secondary_message": null
    },
    {
      "id": 30711,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium yellow potatoes\n½ (8 oz) pkg sugar snap peas\n½ small bunch green onions (scallions)"
    },
    {
      "id": 30712,
      "primary_message": "Medium dice the potatoes (cut into ¾-inch cubes) and transfer to a baking sheet.",
      "secondary_message": null
    },
    {
      "id": 30713,
      "primary_message": "Add the corn to the potatoes.",
      "secondary_message": "½ cup frozen corn"
    },
    {
      "id": 30714,
      "primary_message": "Drizzle the potatoes and corn with olive oil and season with salt and pepper; toss to coat, then arrange in a single layer.",
      "secondary_message": "½ tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 30715,
      "primary_message": "Place the sheet in the oven and roast until the potatoes are tender when pierced with a fork, 18 to 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 30716,
      "primary_message": "Trim off and discard the root end of the garlic; peel and mince or press the garlic. Transfer to a medium bowl (that is big enough to hold the potato salad).",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 30717,
      "primary_message": "Add mayonnaise, paprika, salt, and pepper to the bowl with the garlic and mix together.",
      "secondary_message": "3 tbsp mayonnaise\n¼ tsp paprika\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 30718,
      "primary_message": "Cut the sugar snap peas crosswise (at an angle) into ¼-inch pieces and transfer to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 30720,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 30721,
      "primary_message": "While the skillet heats up, pat dry the salmon with paper towels and place on a plate. Season with salt and pepper on both sides.",
      "secondary_message": "¾ lb salmon fillet\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 30722,
      "primary_message": "Once the skillet is warm, add olive oil and swirl to coat the bottom.",
      "secondary_message": "½ tbsp extra virgin olive oil"
    },
    {
      "id": 30723,
      "primary_message": "Place the salmon, skin-side down, in the skillet; cook until it is cooked through and flaky, 3 to 5 minutes per side (depending on thickness). Once done, transfer the salmon to a plate.",
      "secondary_message": null
    },
    {
      "id": 30719,
      "primary_message": "While the salmon cooks, trim off and discard the ends of the green onions; cut the onions crosswise (at an angle) into ¼-inch pieces and transfer to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 30724,
      "primary_message": "Once the potatoes are tender, remove them from the oven and transfer to the salad bowl. Mix the ingredients together.",
      "secondary_message": null
    },
    {
      "id": 30725,
      "primary_message": "To serve, spoon the salad onto a plate and place the salmon on top. Enjoy!",
      "secondary_message": null
    }
  ],
