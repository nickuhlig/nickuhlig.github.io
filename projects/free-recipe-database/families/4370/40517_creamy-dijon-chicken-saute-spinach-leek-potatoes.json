  "instructions": [
    {
      "id": 626853,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg new potatoes\n6 leeks\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 626854,
      "primary_message": "Quarter new potatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 626855,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the bowl with the potatoes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 626856,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 626857,
      "primary_message": "While the pot heats up, pat chicken dry with paper towels, then season both sides with spices.",
      "secondary_message": "1.36 kg chicken thighs, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp thyme, dried"
    },
    {
      "id": 626858,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and cook until golden, about 2 minutes per side (the chicken will not be cooked all the way through). Transfer chicken to a plate. (Reserve pot with cooking juices for later use.)",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 626859,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the bowl with the potato and leek.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 626860,
      "primary_message": "Return pot (with cooking juices) to medium heat, add more oil, and swirl to coat the bottom. Add potato, leek, garlic, and spices; cook, stirring occasionally, until leeks are tender, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 626861,
      "primary_message": "Add broth to the pot and stir to combine. Bring to a simmer, cover, and cook until the potatoes are just tender, 10-12 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 626862,
      "primary_message": "Uncover pot, then add spinach in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 626863,
      "primary_message": "Return chicken (with any accumulated juices) to the pot, along with cream and Dijon. Stir to combine and bring to a simmer. Continue to cook until sauce thickens slightly and chicken is cooked through, 6--7 minutes more. Remove from heat.",
      "secondary_message": "355 ml heavy whipping cream\n3 tbsp Dijon mustard"
    },
    {
      "id": 626864,
      "primary_message": "To serve, divide creamy chicken sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
