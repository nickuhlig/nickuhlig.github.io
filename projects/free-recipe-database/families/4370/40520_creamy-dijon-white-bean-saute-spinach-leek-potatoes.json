  "instructions": [
    {
      "id": 626887,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.68 kg new potatoes\n6 leeks\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 626888,
      "primary_message": "Quarter new potatoes and place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 626889,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 626890,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 626891,
      "primary_message": "While the pot heats, peel and mince garlic. Add to the bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 626892,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add potato, leek, and spices; cook, stirring occasionally, until leeks are tender, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp thyme, dried\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 626893,
      "primary_message": "Add broth to the pot and stir to combine. Bring to a simmer, cover, and cook until the potatoes are just tender, 10-12 minutes.",
      "secondary_message": "237 ml chicken or vegetable broth"
    },
    {
      "id": 626894,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 626895,
      "primary_message": "Uncover pot, then add spinach in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 626896,
      "primary_message": "Add beans to the pot, along with cream and Dijon. Stir to combine and bring to a simmer. Continue to cook until sauce thickens slightly and beans are warmed through, 6-7 minutes more. Remove from heat.",
      "secondary_message": "355 ml heavy whipping cream\n3 tbsp Dijon mustard"
    },
    {
      "id": 626897,
      "primary_message": "To serve, divide creamy bean sauté between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
