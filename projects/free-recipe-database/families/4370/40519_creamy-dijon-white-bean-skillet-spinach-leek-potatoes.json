  "instructions": [
    {
      "id": 626876,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.45 kg new potatoes\n4 leeks\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 626877,
      "primary_message": "Quarter new potatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 626878,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the bowl with the potatoes.",
      "secondary_message": null
    },
    {
      "id": 626879,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 626880,
      "primary_message": "While the skillet heats, peel and mince garlic. Add to the bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 626881,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add potato, leek, and spices; cook, stirring occasionally, until leeks are tender, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 626882,
      "primary_message": "Add broth to the skillet and stir to combine. Bring to a simmer, cover, and cook until the potatoes are just tender, 10-12 minutes.",
      "secondary_message": "177 ml chicken or vegetable broth"
    },
    {
      "id": 626883,
      "primary_message": "Meanwhile, drain and rinse beans. Set aside to drain further.",
      "secondary_message": "2 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 626884,
      "primary_message": "Uncover skillet, then add spinach in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 626885,
      "primary_message": "Add beans to the skillet, along with cream and Dijon. Stir to combine and bring to a simmer. Continue to cook until sauce thickens slightly and beans are warmed through, 5 minutes more. Remove from heat.",
      "secondary_message": "237 ml heavy whipping cream\n2 tbsp Dijon mustard"
    },
    {
      "id": 626886,
      "primary_message": "To serve, divide creamy bean skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
