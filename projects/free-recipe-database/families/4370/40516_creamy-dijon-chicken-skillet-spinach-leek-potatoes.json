  "instructions": [
    {
      "id": 626841,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "0.45 kg new potatoes\n4 leeks\n1 (142 g) pkg baby spinach"
    },
    {
      "id": 626842,
      "primary_message": "Quarter new potatoes and place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 626843,
      "primary_message": "Trim off root end and dark green top of the leeks, leaving only the white and pale green parts. Cut leeks in half lengthwise and rinse under running water, separating the layers to remove any dirt and grit. Slice crosswise into ¼-inch thick pieces and add to the bowl with the potatoes. Set aside.",
      "secondary_message": null
    },
    {
      "id": 626844,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 626845,
      "primary_message": "While the skillet heats up, pat chicken dry with paper towels, then season both sides with spices.",
      "secondary_message": "0.91 kg chicken thighs, boneless skinless\n1 tsp salt\n½ tsp black pepper\n½ tsp thyme, dried"
    },
    {
      "id": 626846,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chicken and cook until golden, about 2 minutes per side (the chicken will not be cooked all the way through). Transfer chicken to a plate. (Reserve skillet with cooking juices for later use.)",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 626847,
      "primary_message": "Meanwhile, peel and mince garlic. Add to the bowl with the potato and leek.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 626848,
      "primary_message": "Return skillet (with cooking juices) to medium heat, add more oil, and swirl to coat the bottom. Add potato, leek, garlic, and spices; cook, stirring occasionally, until leeks are tender, 3-4 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n½ tsp thyme, dried\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 626849,
      "primary_message": "Add broth to the skillet and stir to combine. Bring to a simmer, cover, and cook until the potatoes are just tender, 10-12 minutes.",
      "secondary_message": "177 ml chicken or vegetable broth"
    },
    {
      "id": 626850,
      "primary_message": "Uncover skillet, then add spinach in handfuls, waiting for it to wilt slightly before adding the next handful. Stir to combine.",
      "secondary_message": null
    },
    {
      "id": 626851,
      "primary_message": "Return chicken (with any accumulated juices) to the skillet, along with cream and Dijon. Stir to combine and bring to a simmer. Continue to cook until sauce thickens slightly and chicken is cooked through, 5 minutes more. Remove from heat.",
      "secondary_message": "237 ml heavy whipping cream\n2 tbsp Dijon mustard"
    },
    {
      "id": 626852,
      "primary_message": "To serve, divide creamy chicken skillet between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
