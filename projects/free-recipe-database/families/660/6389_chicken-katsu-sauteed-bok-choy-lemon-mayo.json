  "instructions": [
    {
      "id": 78032,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "24 baby bok choy\n3 (2 ½ cm) pieces ginger root\n1 ½ lemon"
    },
    {
      "id": 78031,
      "primary_message": "Trim the bok choy ends and cut in half lengthwise. Transfer to a bowl.",
      "secondary_message": ""
    },
    {
      "id": 78030,
      "primary_message": "Peel and grate or mince the ginger. Transfer to a small bowl.",
      "secondary_message": ""
    },
    {
      "id": 78029,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add to the bowl with the ginger.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 78028,
      "primary_message": "Crack the eggs into a medium bowl and beat with a whisk or fork.",
      "secondary_message": "3 eggs"
    },
    {
      "id": 78027,
      "primary_message": "Place the flour and bread crumbs on two separate plates.",
      "secondary_message": "6 tbsp all-purpose flour\n2 ¼ cups panko bread crumbs"
    },
    {
      "id": 78026,
      "primary_message": "Pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season the cutlets with salt and pepper on both sides.",
      "secondary_message": "1.02 kg chicken breasts, boneless skinless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 78025,
      "primary_message": "Add coconut oil to a nonstick skillet and preheat over medium heat.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 78024,
      "primary_message": "One piece at a time, thoroughly coat the seasoned chicken cutlets in the flour (shaking off any excess), then in the beaten egg (letting the excess drip off), then in the bread crumbs (pressing to adhere). Transfer to a plate.",
      "secondary_message": ""
    },
    {
      "id": 78023,
      "primary_message": "Place the breaded chicken cutlets in the skillet; cook until they are golden brown and cooked through, 3 to 5 minutes per side. Once done, transfer to a plate and wipe the skillet. Cook in batches if necessary.",
      "secondary_message": ""
    },
    {
      "id": 78022,
      "primary_message": "Add the mayonnaise to a small bowl.",
      "secondary_message": "6 tbsp mayonnaise"
    },
    {
      "id": 78021,
      "primary_message": "Juice the lemons and add about ½ to the mayo to start; whisk together. Add more lemon juice if needed.",
      "secondary_message": ""
    },
    {
      "id": 78020,
      "primary_message": "Once the chicken has been transferred, add more coconut oil to the skillet.",
      "secondary_message": "1 ½ tbsp virgin coconut oil"
    },
    {
      "id": 78019,
      "primary_message": "Add the ginger and garlic to the skillet; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": ""
    },
    {
      "id": 78018,
      "primary_message": "Add the bok choy to the skillet; cook, tossing frequently, until the bok choy is wilted and tender, 3 to 5 minutes.",
      "secondary_message": ""
    },
    {
      "id": 78017,
      "primary_message": "To the bok choy, add soy sauce and sesame oil. Toss to coat, then remove from the heat.",
      "secondary_message": "3 tbsp soy sauce\n¾ tsp toasted sesame oil"
    },
    {
      "id": 78016,
      "primary_message": "To serve, divide the chicken cutlets and bok choy between plates; drizzle the chicken with the lemon mayo. Enjoy!",
      "secondary_message": ""
    }
  ],
