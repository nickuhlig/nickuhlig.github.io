  "instructions": [
    {
      "id": 464138,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ small pineapple\n1 English cucumber\n½ small pkg fresh mint"
    },
    {
      "id": 464139,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Divide between two medium bowls, then set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 464140,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the green onions along with beef, bread crumbs, egg, fish sauce, chili-garlic sauce, and spices. Use your hands to combine the beef mixture. Using a ¼-cup measure, form the mixture into ½-inch thick patties and place on a plate.",
      "secondary_message": "1 clove garlic\n⅓ kg lean ground beef\n¼ cup panko bread crumbs\n1 egg\n1 tbsp fish sauce\n2 tsp chili-garlic sauce\n½ tsp turmeric, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464141,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464142,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook, flipping once, until golden and cooked through, 3-4 minutes per side. Remove to a clean plate.",
      "secondary_message": "2 tsp neutral vegetable oil"
    },
    {
      "id": 464143,
      "primary_message": "Meanwhile, add fish sauce, vinegar, salt, and pepper to the remaining bowl with the green onions. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp fish sauce\n1 tbsp rice vinegar\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 464144,
      "primary_message": "Cut off skin from pineapple; quarter, core, and cut the flesh into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464145,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 464146,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464147,
      "primary_message": "To serve, divide patties and salad between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
