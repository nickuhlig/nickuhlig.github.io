  "instructions": [
    {
      "id": 464118,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 small pineapple\n2 English cucumbers\n1 small pkg fresh mint"
    },
    {
      "id": 464119,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Divide between two medium bowls, then set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 464120,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the green onions along with beef, bread crumbs, eggs, fish sauce, chili-garlic sauce, and spices. Use your hands to combine the beef mixture. Using a ¼-cup measure, form the mixture into ½-inch thick patties and place on a plate.",
      "secondary_message": "2 cloves garlic\n0.68 kg lean ground beef\n½ cup panko bread crumbs\n2 eggs\n2 tbsp fish sauce\n4 tsp chili-garlic sauce\n1 tsp turmeric, ground\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464121,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464122,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook, flipping once, until golden and cooked through, 3-4 minutes per side. Remove to a clean plate.",
      "secondary_message": "4 tsp neutral vegetable oil"
    },
    {
      "id": 464123,
      "primary_message": "Meanwhile, add fish sauce, vinegar, salt, and pepper to the remaining bowl with the green onions. Whisk to combine the dressing.",
      "secondary_message": "3 tbsp fish sauce\n2 tbsp rice vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464124,
      "primary_message": "Cut off skin from pineapple; quarter, core, and cut the flesh into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464125,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 464126,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464127,
      "primary_message": "To serve, divide patties and salad between plates or bowls. Top salad with peanuts and enjoy!",
      "secondary_message": "½ cup peanuts, roasted unsalted"
    }
  ],
