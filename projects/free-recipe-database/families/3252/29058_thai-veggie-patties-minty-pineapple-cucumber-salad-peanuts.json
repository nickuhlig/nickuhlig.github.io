  "instructions": [
    {
      "id": 464008,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ small pineapples\n3 English cucumbers\n1 small pkg fresh mint"
    },
    {
      "id": 464009,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Divide between two large bowls, then set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 464010,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the green onions along with veggie ground, bread crumbs, soy sauce, chili-garlic sauce, and spices. Use your hands to combine the veggie ground mixture. Using a scant ¼-cup measure, form the mixture into ½-inch thick patties and place on a plate.",
      "secondary_message": "3 cloves garlic\n24 oz veggie ground, plant based\n¾ cup panko bread crumbs\n3 tbsp soy sauce\n2 tbsp chili-garlic sauce\n1 ½ tsp turmeric, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 464011,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464012,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add patties and cook, flipping once, until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "3 tbsp neutral vegetable oil"
    },
    {
      "id": 464013,
      "primary_message": "Meanwhile, add soy sauce, vinegar, salt, and pepper to the remaining bowl with the green onions. Whisk to combine the dressing.",
      "secondary_message": "¼ cup soy sauce\n3 tbsp rice vinegar\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 464014,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and cut the flesh into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 464015,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 464016,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 464017,
      "primary_message": "To serve, divide patties and salad between plates or bowls. Top salad with peanuts and enjoy!",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    }
  ],
