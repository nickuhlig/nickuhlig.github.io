  "instructions": [
    {
      "id": 463948,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch green onions (scallions)\n1 ½ small pineapples\n3 English cucumbers\n1 small pkg fresh mint"
    },
    {
      "id": 463949,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Divide between two large bowls, then set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 463950,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the green onions along with beef, bread crumbs, eggs, fish sauce, chili-garlic sauce, and spices. Use your hands to combine the beef mixture. Using a ¼-cup measure, form the mixture into ½-inch thick patties and place on a plate.",
      "secondary_message": "3 cloves garlic\n2 ¼ lb lean ground beef\n¾ cup panko bread crumbs\n3 eggs\n3 tbsp fish sauce\n2 tbsp chili-garlic sauce\n1 ½ tsp turmeric, ground\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 463951,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 463952,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add patties and cook, flipping once, until golden and cooked through, 3-4 minutes per side. Remove to a clean plate.",
      "secondary_message": "2 tbsp neutral vegetable oil"
    },
    {
      "id": 463953,
      "primary_message": "Meanwhile, add fish sauce, vinegar, salt, and pepper to the remaining bowl with the green onions. Whisk to combine the dressing.",
      "secondary_message": "¼ cup fish sauce\n3 tbsp rice vinegar\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 463954,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and cut the flesh into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 463955,
      "primary_message": "Trim and quarter cucumbers lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 463956,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 463957,
      "primary_message": "To serve, divide patties and salad between plates or bowls. Top salad with peanuts and enjoy!",
      "secondary_message": "¾ cup peanuts, roasted unsalted"
    }
  ],
