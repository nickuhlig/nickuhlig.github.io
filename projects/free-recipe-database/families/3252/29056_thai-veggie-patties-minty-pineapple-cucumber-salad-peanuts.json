  "instructions": [
    {
      "id": 463988,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n½ small pineapple\n1 English cucumber\n½ small pkg fresh mint"
    },
    {
      "id": 463989,
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Divide between two medium bowls, then set one bowl aside for the salad.",
      "secondary_message": null
    },
    {
      "id": 463990,
      "primary_message": "Peel and mince garlic. Add to the remaining bowl with the green onions along with veggie ground, bread crumbs, soy sauce, chili-garlic sauce, and spices. Use your hands to combine the veggie ground mixture. Using a scant ¼-cup measure, form the mixture into ½-inch thick patties and place on a plate.",
      "secondary_message": "1 clove garlic\n8 oz veggie ground, plant based\n¼ cup panko bread crumbs\n1 tbsp soy sauce\n2 tsp chili-garlic sauce\n½ tsp turmeric, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 463991,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 463992,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add patties and cook, flipping once, until golden and cooked through, 3-4 minutes per side. Transfer to a clean plate.",
      "secondary_message": "1 tbsp neutral vegetable oil"
    },
    {
      "id": 463993,
      "primary_message": "Meanwhile, add soy sauce, vinegar, salt, and pepper to the remaining bowl with the green onions. Whisk to combine the dressing.",
      "secondary_message": "1 ½ tbsp soy sauce\n1 tbsp rice vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 463994,
      "primary_message": "Cut off skin from pineapple; quarter, core, and cut the flesh into bite-sized pieces. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 463995,
      "primary_message": "Trim and quarter cucumber lengthwise, then cut crosswise into bite-sized pieces. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 463996,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 463997,
      "primary_message": "To serve, divide patties and salad between plates or bowls. Top salad with peanuts and enjoy!",
      "secondary_message": "¼ cup peanuts, roasted unsalted"
    }
  ],
