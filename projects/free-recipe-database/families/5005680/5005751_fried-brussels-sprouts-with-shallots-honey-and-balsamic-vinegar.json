  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the shallots.",
      "secondary_message": "3 medium shallots"
    },
    {
      "id": 1,
      "primary_message": "Combine honey, balsamic vinegar, and parsley in a small bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Line a rimmed baking sheet with a triple layer of paper towels. In a 36-cm wok or 6-quart Dutch oven, heat oil to 205°C (400°F). Add half of Brussels sprouts and half of shallots. Oil temperature will drop to around 165°C. Adjust heat to maintain this temperature. Cook, stirring and agitating with a metal spider (a small metal strainer that has a long handle) until Brussels sprouts are deep golden brown, about 4 minutes. Transfer to paper towel-lined baking sheet. Reheat oil to 205°C (400°F) and repeat with remaining sprouts and shallots.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Transfer sprouts and shallots to a large bowl and add dressing. Toss to combine, season to taste with salt and pepper, and serve.",
      "secondary_message": null
    }
  ],
