  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash and dry 2 quart-size canning jars. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Clean and trim kohlrabi bulbs. Using a mandoline slicer or a food processor, slice kohlrabi into thin matchsticks.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Divide the shreds evenly between the two canning jars.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Combine vinegar, water, honey, pickling salt, ginger, garlic, black peppercorns, and red chile flakes in a medium saucepan and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Once brine is boiling vigorously, remove it from the heat and carefully pour the brine over the kohlrabi.",
      "secondary_message": null
    },
    {
      "id": 6,
      "primary_message": "Place lids on the jars and let them sit until cool.",
      "secondary_message": null
    },
    {
      "id": 7,
      "primary_message": "Once jars are cool to the touch, refrigerate the pickles and eat with salads, sandwiches, or meat dishes.",
      "secondary_message": null
    }
  ],
