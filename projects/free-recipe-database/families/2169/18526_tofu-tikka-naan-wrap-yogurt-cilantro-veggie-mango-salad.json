  "instructions": [
    {
      "id": 303490,
      "primary_message": "Cut tofu into ½-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a large baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 303491,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 (1 inch) pieces ginger root\n3 lemons\n1 ½ mangoes\n1 ½ English cucumbers\n1 ½ pints grape tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 303492,
      "primary_message": "Peel and mince ginger and garlic; place both in a large bowl. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 303493,
      "primary_message": "Juice half of the lemons into the bowl with the ginger and garlic (set remaining lemons aside for later use). Add yogurt, spices, and sugar; whisk to combine the marinade. ",
      "secondary_message": "⅓ cup plain Greek yogurt\n1 tbsp chili powder\n1 ½ tsp cumin, ground\n1 ½ tsp coriander, ground\n1 ½ tsp curry powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp turmeric, ground\n3 pinch cayenne pepper\n¾ tsp brown sugar"
    },
    {
      "id": 303494,
      "primary_message": "Add tofu to the bowl with the marinade, gently turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 303495,
      "primary_message": "Preheat oven to broil on high and position rack about 6 inches from the top. Line a large baking sheet with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 303496,
      "primary_message": "Juice remaining lemons into a medium bowl; add oil, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 303497,
      "primary_message": "Peel mangoes and slice flesh away from the pits, starting with the flat sides; medium dice and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 303498,
      "primary_message": "Trim and small dice cucumbers; halve tomatoes lengthwise. Add both to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 303499,
      "primary_message": "Transfer tofu to the baking sheet and arrange in a single layer. Place baking sheet in the oven and broil, flipping halfway through, until tofu is golden brown and warmed through, about 10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 303500,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing and veggies, then stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 303501,
      "primary_message": "Just before serving, divide naan between two additional baking sheets. Working in batches, place in the oven and broil, flipping once, until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "6 flatbreads or naan"
    },
    {
      "id": 303502,
      "primary_message": "Spread yogurt over each naan and top with a small portion of salad and tofu. (Reserve remaining salad for serving.)",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 303503,
      "primary_message": "To make wraps easier to eat, place each naan on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise eat as is and get a little messy! Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
