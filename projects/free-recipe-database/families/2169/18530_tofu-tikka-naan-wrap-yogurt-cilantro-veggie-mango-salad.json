  "instructions": [
    {
      "id": 303543,
      "primary_message": "Cut tofu into ½-inch thick planks along the short side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 303544,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 (2 ½ cm) piece ginger root\n1 lemon\n½ mango\n½ English cucumber\n½ small pkg grape tomatoes\n½ small bunch cilantro"
    },
    {
      "id": 303545,
      "primary_message": "Peel and mince ginger and garlic; place both in a medium bowl. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 303546,
      "primary_message": "Juice half of the lemon into the bowl with the ginger and garlic (set remaining lemon aside for later use). Add yogurt, spices, and sugar; whisk to combine the marinade. ",
      "secondary_message": "⅛ cup plain Greek yogurt\n1 tsp chili powder\n½ tsp cumin, ground\n½ tsp coriander, ground\n½ tsp curry powder\n½ tsp salt\n¼ tsp black pepper\n¼ tsp turmeric, ground\n1 pinch cayenne pepper\n¼ tsp brown sugar"
    },
    {
      "id": 303547,
      "primary_message": "Add tofu to the bowl with the marinade, gently turn to coat, and set aside.",
      "secondary_message": null
    },
    {
      "id": 303548,
      "primary_message": "Preheat oven to broil on high and position rack about 6 inches from the top. Line a baking sheet with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 303549,
      "primary_message": "Juice remaining lemon into another medium bowl; add oil, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "1 tsp extra virgin olive oil\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 303550,
      "primary_message": "Peel mango and slice flesh away from the pit, starting with the flat sides; medium dice and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 303551,
      "primary_message": "Trim and small dice cucumber; halve tomatoes lengthwise. Add both to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 303552,
      "primary_message": "Transfer tofu to the baking sheet and arrange in a single layer. Place baking sheet in the oven and broil, flipping halfway through, until tofu is golden brown and warmed through, 8-10 minutes. Remove from oven. ",
      "secondary_message": null
    },
    {
      "id": 303553,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing and veggies, then stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 303554,
      "primary_message": "Just before serving, arrange naan on another baking sheet. Place in the oven and broil, flipping once, until toasted, 1-2 minutes; remove from oven.",
      "secondary_message": "2 flatbreads or naan"
    },
    {
      "id": 303555,
      "primary_message": "Spread yogurt over each naan and top with a small portion of salad and tofu. (Reserve remaining salad for serving.)",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 303556,
      "primary_message": "To make wraps easier to eat, place each naan on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise eat as is and get a little messy! Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
