  "instructions": [
    {
      "id": 303436,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 lemons\n1 mango\n1 English cucumber\n1 pint grape tomatoes\n1 small bunch cilantro"
    },
    {
      "id": 303437,
      "primary_message": "Peel and mince ginger and garlic; place both in a medium bowl. ",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 303438,
      "primary_message": "Juice one lemon into the bowl with the ginger and garlic (set remaining lemon aside for later use). Add yogurt, spices, and sugar; whisk to combine the marinade. ",
      "secondary_message": "¼ cup plain Greek yogurt\n2 tsp chili powder\n1 tsp cumin, ground\n1 tsp coriander, ground\n1 tsp curry powder\n1 tsp salt\n½ tsp black pepper\n½ tsp turmeric, ground\n⅛ tsp cayenne pepper\n½ tsp brown sugar"
    },
    {
      "id": 303439,
      "primary_message": "Cut fish into 1-inch pieces; add to the bowl with the marinade, gently stir to coat, and set aside.",
      "secondary_message": "1 ½ lb cod fillet"
    },
    {
      "id": 303440,
      "primary_message": "Preheat oven to broil on high and position rack about 6 inches from the top. Line a baking sheet pan with aluminum foil to make cleanup easier (optional).",
      "secondary_message": null
    },
    {
      "id": 303441,
      "primary_message": "Juice remaining lemon into another medium bowl; add oil, salt, and pepper. Whisk to combine the dressing. ",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 303442,
      "primary_message": "Using a clean cutting board, peel mango and slice flesh away from the pit, starting with the flat sides; small dice and add to the bowl with the dressing. ",
      "secondary_message": null
    },
    {
      "id": 303443,
      "primary_message": "Trim and small dice cucumber; halve tomatoes lengthwise. Add both to the bowl and set aside. ",
      "secondary_message": null
    },
    {
      "id": 303444,
      "primary_message": "Transfer fish to the baking sheet and arrange in a single layer. Place baking sheet in the oven and broil, turning the fish pieces halfway through, until golden and flesh flakes with a fork, 6-8 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 303445,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing and veggies, then stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 303446,
      "primary_message": "Just before serving, arrange naan on a large baking sheet. Place in the oven and broil, flipping once, until toasted 1-2 minutes; remove from oven.",
      "secondary_message": "4 flatbreads or naan"
    },
    {
      "id": 303447,
      "primary_message": "Spread yogurt over each naan and top with a small portion of salad and the fish. (Reserve remaining salad for serving.)",
      "secondary_message": "½ cup plain Greek yogurt"
    },
    {
      "id": 303448,
      "primary_message": "To make wraps easier to eat, place each naan on a square of parchment paper. Use the paper to tightly roll and secure each wrap. Otherwise, eat as is and get a little messy! Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
