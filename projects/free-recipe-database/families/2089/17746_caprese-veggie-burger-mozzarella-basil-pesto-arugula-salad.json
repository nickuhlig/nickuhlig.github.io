  "instructions": [
    {
      "id": 287371,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 287372,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 veggie burger patties, plant-based"
    },
    {
      "id": 287373,
      "primary_message": "While the patties are cooking, slice mozzarella into rounds.",
      "secondary_message": "1 ½ (8 oz) pkg fresh mozzarella cheese"
    },
    {
      "id": 287374,
      "primary_message": "Wash, dry, and slice tomatoes into rounds.",
      "secondary_message": "3 tomatoes"
    },
    {
      "id": 287375,
      "primary_message": "Wash and dry the arugula. (Skip this step if it came pre-washed.)",
      "secondary_message": "1 ½ (5 oz) pkgs baby arugula"
    },
    {
      "id": 287376,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 287377,
      "primary_message": "Place the bottom half of each bun on a flat surface, then top with burger patties, mozzarella, tomato, and pesto. Close with the top half of each bun.",
      "secondary_message": "¼ cup basil pesto"
    },
    {
      "id": 287378,
      "primary_message": "To serve, divide caprese burgers and arugula between plates. Drizzle dressing over the arugula, sprinkle with pine nuts, and enjoy!",
      "secondary_message": "¼ cup italian salad dressing\n⅓ cup pine nuts"
    }
  ],
