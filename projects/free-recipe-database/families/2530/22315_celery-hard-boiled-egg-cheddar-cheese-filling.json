  "instructions": [
    {
      "id": 373254,
      "primary_message": "Place mayo and spices in a small bowl. Stir to combine the dressing.",
      "secondary_message": "2 tbsp avocado oil mayonnaise\n⅛ tsp garlic powder\n⅛ tsp onion powder\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 373255,
      "primary_message": "Using a box grater, coarsely grate eggs. Add to the bowl with the dressing.",
      "secondary_message": "3 hard-cooked eggs, peeled"
    },
    {
      "id": 373256,
      "primary_message": "Coarsely grate cheese. Add to the bowl, stir to combine the filling, and set aside.",
      "secondary_message": "⅛ (8 oz) block cheddar cheese"
    },
    {
      "id": 373257,
      "primary_message": "Wash, dry, and trim celery, then cut crosswise into 4-inch long sticks.",
      "secondary_message": "4 sticks celery"
    },
    {
      "id": 373258,
      "primary_message": "Stuff celery sticks with the filling.",
      "secondary_message": null
    },
    {
      "id": 373259,
      "primary_message": "To serve, divide stuffed celery sticks between plates. Sprinkle with paprika and enjoy!",
      "secondary_message": "⅛ tsp paprika"
    }
  ],
