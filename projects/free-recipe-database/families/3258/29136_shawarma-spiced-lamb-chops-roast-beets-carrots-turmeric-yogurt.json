  "instructions": [
    {
      "id": 464984,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 464985,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "9 medium carrots\n9 medium beets\n3 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 464986,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Divide between two large baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 464987,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice into ½-inch thick wedges. Add to the baking sheets with the carrots, drizzle with oil, and season with salt. Toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n1 ½ tsp salt"
    },
    {
      "id": 464988,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden brown and tender, about 25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 464989,
      "primary_message": "Meanwhile, place vinegar, honey, and salt in a medium bowl; stir to combine the pickling liquid.",
      "secondary_message": "½ cup red wine vinegar\n1 tbsp honey\n1 ½ tsp salt"
    },
    {
      "id": 464990,
      "primary_message": "Peel, halve, and slice onions crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to coat, and set aside.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 464991,
      "primary_message": "Place spices in a small bowl. Stir to combine the spice rub.",
      "secondary_message": "1 tbsp cumin, ground\n1 ½ tsp smoked paprika\n1 ½ tsp coriander, ground\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n½ tsp cinnamon, ground\n½ tsp cayenne pepper"
    },
    {
      "id": 464992,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464993,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with the spice rub on both sides. (Reserve bowl for later use.)",
      "secondary_message": "12 lamb loin chops"
    },
    {
      "id": 464994,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add chops and pan-fry until golden brown and cooked through, about 3 minutes per side. Remove to a clean plate and set aside to rest.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 464995,
      "primary_message": "Meanwhile, juice half of the lemons into the reserved bowl. (Cut remaining lemons into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 464996,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with yogurt, honey, and spices. Whisk to combine the turmeric yogurt and set aside. ",
      "secondary_message": "3 cloves garlic\n1 ½ cups plain Greek yogurt\n1 ½ tsp honey\n1 ½ tsp turmeric, ground\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464997,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add half to the baking sheets with the veggies, then stir to combine. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 464998,
      "primary_message": "Divide lamb chops and turmeric yogurt between plates; top yogurt with veggies, pickled onions, and reserved mint. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
