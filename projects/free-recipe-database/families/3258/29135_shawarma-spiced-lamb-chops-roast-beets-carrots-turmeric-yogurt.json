  "instructions": [
    {
      "id": 464969,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 464970,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "6 medium carrots\n6 medium beets\n2 lemons\n1 small pkg fresh mint"
    },
    {
      "id": 464971,
      "primary_message": "Peel, trim, and quarter carrots lengthwise, then cut crosswise into 3-inch long sticks. Transfer to a large baking sheet pan.",
      "secondary_message": null
    },
    {
      "id": 464972,
      "primary_message": "Peel and trim beets; halve lengthwise, then slice into ½-inch thick wedges. Add to the baking sheet with the carrots, drizzle with oil, and season with salt. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tsp salt"
    },
    {
      "id": 464973,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are golden brown and tender, 20-25 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 464974,
      "primary_message": "Meanwhile, place vinegar, honey, and salt in a small bowl; stir to combine the pickling liquid.",
      "secondary_message": "⅓ cup red wine vinegar\n2 tsp honey\n1 tsp salt"
    },
    {
      "id": 464975,
      "primary_message": "Peel, halve, and slice onion crosswise into thin half-moons. Add to the bowl with the pickling liquid, stir to coat, and set aside.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 464976,
      "primary_message": "Place spices in another small bowl. Stir to combine the spice rub.",
      "secondary_message": "2 tsp cumin, ground\n1 tsp smoked paprika\n1 tsp coriander, ground\n1 tsp turmeric, ground\n1 tsp salt\n¼ tsp cinnamon, ground\n¼ tsp cayenne pepper"
    },
    {
      "id": 464977,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 464978,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with the spice rub on both sides. (Reserve bowl for later use.)",
      "secondary_message": "8 lamb loin chops"
    },
    {
      "id": 464979,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add chops and pan-fry until golden brown and cooked through, about 3 minutes per side. Remove to a clean plate and set aside to rest.",
      "secondary_message": "4 tsp extra virgin olive oil"
    },
    {
      "id": 464980,
      "primary_message": "Meanwhile, juice one lemon into the reserved bowl. (Cut remaining lemon into wedges and set aside for serving.)",
      "secondary_message": null
    },
    {
      "id": 464981,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice along with yogurt, honey, and spices. Whisk to combine the turmeric yogurt and set aside. ",
      "secondary_message": "2 cloves garlic\n1 cup plain Greek yogurt\n1 tsp honey\n1 tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 464982,
      "primary_message": "Pick mint leaves off the stems; discard stems and roughly chop the leaves. Add half to the baking sheet with the veggies, then stir to combine. (Reserve remaining mint for serving.)",
      "secondary_message": null
    },
    {
      "id": 464983,
      "primary_message": "Divide lamb chops and turmeric yogurt between plates; top yogurt with veggies, pickled onions, and reserved mint. Serve with lemon wedges for squeezing and enjoy!",
      "secondary_message": null
    }
  ],
