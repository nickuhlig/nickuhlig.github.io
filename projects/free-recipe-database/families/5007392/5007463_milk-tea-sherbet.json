  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Keep the half and half cold until you use it.",
      "secondary_message": "2 cups half and half"
    },
    {
      "id": 1,
      "primary_message": "Combine corn syrup and water in a heavy saucepan and bring to a boil. Stir in tea leaves, cover, and steep until syrup is dark, flavorful, and slightly bitter, about 10 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Slowly pour tea syrup through a very fine mesh strainer (such as a tea strainer) into an airtight container. Stir in sugar to dissolve, then half and half and salt to taste. Milk tea should taste strong, and both sweeter and saltier than you would drink on its own. Chill in refrigerator until very cold, 1 to 2 hours.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Churn in ice cream maker according to manufacturer's instructions, then transfer to airtight container and chill in freezer until firm, at least 4 hours.",
      "secondary_message": null
    }
  ],
