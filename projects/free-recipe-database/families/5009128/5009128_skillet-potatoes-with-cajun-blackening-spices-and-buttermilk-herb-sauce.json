  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Mince the garlic. Pick the dill fronds from the stems and chop them. Chop the chives. Chop the tender stems of the packed parsley leaves.",
      "secondary_message": "1 medium clove garlic\n1 bunch dill\n1 bunch chives\n⅓ cup packed parsley leaves"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, stir together sour cream, buttermilk, vinegar, garlic, and two-thirds each of the dill, chives, and parsley. Season with salt and pepper. Cover and refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Boil the potatoes in salted water until fork-tender. Drain and pat dry.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "In a small bowl, mix the smoked paprika, cumin, garlic powder, onion powder, oregano, brown sugar, cayenne pepper, and 1/2 teaspoon salt.",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Heat butter and canola oil in a medium heavy-bottomed skillet over medium-high heat until foaming. Add potatoes to the skillet and cook, stirring, occasionally, until the skins are lightly browned and crisp, about 4 minutes. Sprinkle potatoes with the spice mixture and continue to cook, stirring, until the spices begin to blacken, about 2 minutes. Remove from heat. Season with salt, if necessary.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Garnish with the remaining chopped herbs and serve warm with the buttermilk-herb sauce.",
      "secondary_message": null
    }
  ],
