  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Grate the provolone cheese. Pick the basil leaves from the stems and finely chop them. Stem and seed the hot cherry peppers. Thinly slice the prosciutto.",
      "secondary_message": "½ cup provolone cheese\n¼ cup fresh basil\n20 hot cherry peppers\n0.23 kg prosciutto"
    },
    {
      "id": 1,
      "primary_message": "In a medium bowl, mix together ricotta, provolone, and basil.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Stuff each pepper with cheese mixture. Wrap each stuffed pepper with one slice of prosciutto.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Light one chimney full of charcoal. When all the charcoal is lit and covered with gray ash, pour out and arrange the coals on one side of the charcoal grate. Place wood chunk directly on coals. Set cooking grate in place, cover grill and allow to preheat for 5 minutes. Clean and oil the grilling grate. Place stuffed peppers on cool side of grill, cover, and cook until prosciutto has browned and pepper has softened slightly, 20-30 minutes. Transfer peppers to serving tray, let cool for 5 minutes, then serve.",
      "secondary_message": null
    }
  ],
