  "instructions": [
    {
      "id": 237676,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 237677,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ small bunches cilantro\n1 ½ lemons\n6 medium carrots\n6 medium zucchini squash"
    },
    {
      "id": 237678,
      "primary_message": "Peel and mince garlic; transfer to a medium bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 237679,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the garlic.",
      "secondary_message": null
    },
    {
      "id": 237680,
      "primary_message": "Juice lemons into the bowl. Add oil and spices; stir to combine the chermoula and set aside.",
      "secondary_message": "¼ cup extra virgin olive oil\n1 ½ tsp cumin, ground\n1 ½ tsp paprika\n½ tsp cayenne pepper\n½ tsp salt"
    },
    {
      "id": 237681,
      "primary_message": "Peel, trim, and thinly slice carrots into ¼-inch thick rounds. Divide between two baking sheet pans.",
      "secondary_message": null
    },
    {
      "id": 237682,
      "primary_message": "Trim and halve zucchini lengthwise; cut crosswise into ½-inch thick half-moons and add to the baking sheets with the carrots.",
      "secondary_message": null
    },
    {
      "id": 237683,
      "primary_message": "Drizzle veggies with oil and season with salt and pepper. Toss to combine and spread out in a single layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 237684,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until veggies are fork-tender, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 237685,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237686,
      "primary_message": "While the skillet heats up, pat the lamb chops dry with paper towels and place on a plate; season with salt and pepper on both sides.",
      "secondary_message": "12 lamb loin chops\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 237687,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add lamb chops and cook, flipping once, until cooked through, 5-6 minutes. Remove to a plate, cover loosely with aluminum foil, and rest 5 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 237688,
      "primary_message": "To serve, divide lamb chops and roasted veggies between plates; drizzle with chermoula and enjoy!",
      "secondary_message": null
    }
  ],
