  "instructions": [
    {
      "id": 459922,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459923,
      "primary_message": "While the skillet heats up, peel and mince shallot. ",
      "secondary_message": "1 shallot"
    },
    {
      "id": 459924,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n8 oz veggie ground, plant based\n1 tsp Italian seasoning\n½ tsp garlic powder\n¼ tsp crushed red pepper\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 459925,
      "primary_message": "Add broth, tomato sauce, and orzo to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "8 fl oz (1 cup) chicken or vegetable broth\n1 (8 oz) can tomato sauce\n5 oz orzo pasta"
    },
    {
      "id": 459926,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl and set aside.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 459927,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "1 (5 oz) pkg baby spinach"
    },
    {
      "id": 459928,
      "primary_message": "When the orzo is done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 459929,
      "primary_message": "Add nutritional yeast and half of the parsley to the skillet, then stir to combine. Remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": "⅛ cup nutritional yeast flakes"
    },
    {
      "id": 459930,
      "primary_message": "To serve, divide orzo between plates or bowls; top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
