  "instructions": [
    {
      "id": 459872,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459873,
      "primary_message": "While the skillet heats up, peel and mince shallots. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 459874,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add shallot, turkey, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp extra virgin olive oil\n1 ½ lb ground turkey\n2 tsp Italian seasoning\n1 tsp garlic powder\n1 tsp salt\n½ tsp black pepper\n½ tsp crushed red pepper"
    },
    {
      "id": 459875,
      "primary_message": "Add broth, tomato sauce, and orzo to the skillet; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "16 fl oz (2 cups) chicken or vegetable broth\n2 (8 oz) cans tomato sauce\n10 oz orzo pasta"
    },
    {
      "id": 459876,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a small bowl. ",
      "secondary_message": "2 oz Parmesan cheese"
    },
    {
      "id": 459877,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the Parmesan, stir to combine, and set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 459878,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "2 (5 oz) pkgs baby spinach"
    },
    {
      "id": 459879,
      "primary_message": "When the orzo is done, add spinach to the skillet in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 459880,
      "primary_message": "Add half of the Parmesan-parsley mixture to the skillet and stir to combine. Remove from heat. (Reserve remaining Parmesan mixture for serving.)",
      "secondary_message": null
    },
    {
      "id": 459881,
      "primary_message": "To serve, divide orzo between plates or bowls; top with reserved Parmesan mixture. Enjoy!",
      "secondary_message": null
    }
  ],
