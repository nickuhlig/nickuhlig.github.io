  "instructions": [
    {
      "id": 459882,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459883,
      "primary_message": "While the pot heats up, peel, halve, and mince onion. ",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 459884,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, turkey, and spices; cook, breaking the meat apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 ¼ lb ground turkey\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp crushed red pepper"
    },
    {
      "id": 459885,
      "primary_message": "Add broth, tomato sauce, and orzo to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 (8 oz) cans tomato sauce\n15 oz orzo pasta"
    },
    {
      "id": 459886,
      "primary_message": "Meanwhile, finely grate Parmesan. Place in a small bowl. ",
      "secondary_message": "3 oz Parmesan cheese"
    },
    {
      "id": 459887,
      "primary_message": "Wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl with the Parmesan, stir to combine, and set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 459888,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 459889,
      "primary_message": "When the orzo is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 459890,
      "primary_message": "Add half of the Parmesan-parsley mixture to the pot and stir to combine. Remove from heat. (Reserve remaining Parmesan mixture for serving.)",
      "secondary_message": null
    },
    {
      "id": 459891,
      "primary_message": "To serve, divide orzo between plates or bowls; top with reserved Parmesan mixture. Enjoy!",
      "secondary_message": null
    }
  ],
