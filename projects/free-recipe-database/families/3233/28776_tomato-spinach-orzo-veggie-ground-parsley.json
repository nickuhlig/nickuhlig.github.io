  "instructions": [
    {
      "id": 459940,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 459941,
      "primary_message": "While the pot heats up, peel, halve, and mince onion.",
      "secondary_message": "½ medium red onion"
    },
    {
      "id": 459942,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add onion, veggie ground, and spices; cook, breaking the veggie ground apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n24 oz veggie ground, plant based\n1 tbsp Italian seasoning\n1 ½ tsp garlic powder\n¾ tsp crushed red pepper\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 459943,
      "primary_message": "Add broth, tomato sauce, and orzo to the pot; stir to combine and bring to a simmer. Once simmering, reduce heat to medium-low, cover, and cook, stirring occasionally, until liquid is mostly absorbed and orzo is desired firmness, 10-15 minutes.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n3 (8 oz) cans tomato sauce\n15 oz orzo pasta"
    },
    {
      "id": 459944,
      "primary_message": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves. Place in a small bowl and set aside.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 459945,
      "primary_message": "Wash and dry spinach (skip this step if it came pre-washed).",
      "secondary_message": "3 (5 oz) pkgs baby spinach"
    },
    {
      "id": 459946,
      "primary_message": "When the orzo is done, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": null
    },
    {
      "id": 459947,
      "primary_message": "Add nutritional yeast and half of the parsley to the pot, then stir to combine. Remove from heat. (Reserve remaining parsley for serving.)",
      "secondary_message": "⅓ cup nutritional yeast flakes"
    },
    {
      "id": 459948,
      "primary_message": "To serve, divide orzo between plates or bowls; top with reserved parsley. Enjoy!",
      "secondary_message": null
    }
  ],
