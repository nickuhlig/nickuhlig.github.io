  "instructions": [
    {
      "primary_message": "Preheat oven to 400°F.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "Wash and dry the grape tomatoes. Place in a large bowl.\n\n",
      "secondary_message": "2 pint grape tomatoes"
    },
    {
      "primary_message": "Add gnocchi and meatballs to the bowl with the tomatoes, along with oil, salt, and pepper, then stir to combine.\n\n",
      "secondary_message": "2 (454 g) pkg potato gnocchi\n1 (567 g) bag frozen homestyle meatballs, fully-cooked\n3 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "primary_message": "Divide gnocchi-meatball mixture between two large baking sheet pans and spread out in an even layer. Place baking sheets in the oven (it doesn't have to be fully heated) and bake, stirring halfway through, until gnocchi and meatballs are warmed through, about 25 minutes.\n\n",
      "secondary_message": null
    },
    {
      "primary_message": "When the gnocchi and meatballs are done, remove from the oven and transfer to a clean large bowl. Add pesto and mozzarella, then stir to combine.\n\n",
      "secondary_message": "½ cup basil pesto\n1 (227 g) pkg fresh mozzarella balls (ciliegine or \"cherry size\")"
    },
    {
      "primary_message": "To serve, divide gnocchi-meatball bake between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
