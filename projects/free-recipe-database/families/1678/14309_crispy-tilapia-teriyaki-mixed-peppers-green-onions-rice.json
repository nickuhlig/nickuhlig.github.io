  "instructions": [
    {
      "id": 237797,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 237798,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 237799,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 red bell peppers\n3 green bell peppers\n3 small bunches green onions (scallions)\n3 (1 inch) pieces ginger root"
    },
    {
      "id": 237800,
      "primary_message": "Trim, seed, and thinly slice bell peppers; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 237801,
      "primary_message": "Trim green onions and cut into 3-inch pieces; add to the bowl with the peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 237802,
      "primary_message": "Pat the tilapia dry with paper towels and place on a large plate; sprinkle with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb tilapia fillet\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 237803,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237804,
      "primary_message": "While the pot heats up, sprinkle cornstarch over both sides of each fillet and press gently to adhere.",
      "secondary_message": "⅓ cup cornstarch"
    },
    {
      "id": 237805,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tilapia and cook, flipping once, until crispy and easily flakes with a fork, about 6 minutes. Remove to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 237806,
      "primary_message": "Meanwhile, peel and mince garlic and ginger; transfer to a medium bowl.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 237807,
      "primary_message": "Add broth, soy sauce, additional cornstarch, vinegar, honey, and crushed red pepper to the bowl with the garlic and ginger; whisk to combine the sauce and set aside.",
      "secondary_message": "12 fl oz (1 ½ cups) chicken or vegetable broth\n⅓ cup soy sauce\n2 tbsp cornstarch\n1 tbsp rice vinegar\n1 tbsp honey\n3 pinch crushed red pepper"
    },
    {
      "id": 237808,
      "primary_message": "Return pot to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237809,
      "primary_message": "Once the pot is hot, add more oil and swirl to coat the bottom. Add peppers and green onions to the pot; stir-fry until veggies are fork-tender, 6-7 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 237810,
      "primary_message": "Add sauce to the pot and continue to cook, stirring often, until sauce thickens, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 237811,
      "primary_message": "To serve, divide rice, tilapia, veggies, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
