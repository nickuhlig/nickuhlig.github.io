  "instructions": [
    {
      "id": 237857,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 237858,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 237859,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 red bell pepper\n1 green bell pepper\n1 small bunch green onions (scallions)\n1 (2 ½ cm) piece ginger root"
    },
    {
      "id": 237860,
      "primary_message": "Trim, seed, and thinly slice bell peppers; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 237861,
      "primary_message": "Trim green onions and cut into 3-inch pieces; add to the bowl with the peppers and set aside.",
      "secondary_message": null
    },
    {
      "id": 237862,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237863,
      "primary_message": "While the skillet heats up, pat the tilapia dry with paper towels and place on a plate; sprinkle with salt and pepper on both sides.",
      "secondary_message": "⅓ kg tilapia fillet\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 237864,
      "primary_message": "Sprinkle cornstarch over both sides of each fillet and press gently to adhere.",
      "secondary_message": "2 tbsp cornstarch"
    },
    {
      "id": 237865,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tilapia and cook, flipping once, until crispy and easily flakes with a fork, about 6 minutes. Remove to a clean plate and loosely cover with aluminum foil.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 237866,
      "primary_message": "Meanwhile, peel and mince garlic and ginger; transfer to a small bowl.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 237867,
      "primary_message": "Add broth, soy sauce, additional cornstarch, vinegar, honey, and crushed red pepper to the bowl with the garlic and ginger; whisk to combine the sauce and set aside.",
      "secondary_message": "118 ml (½ cup) chicken or vegetable broth\n2 tbsp soy sauce\n2 tsp cornstarch\n1 tsp rice vinegar\n1 tsp honey\n1 pinch crushed red pepper"
    },
    {
      "id": 237868,
      "primary_message": "Return skillet to medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 237869,
      "primary_message": "Once the skillet is hot, add more oil and swirl to coat the bottom. Add peppers and green onions to the skillet; stir-fry until veggies are fork-tender, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 237870,
      "primary_message": "Add sauce to the skillet and continue to cook, stirring often, until sauce thickens, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 237871,
      "primary_message": "To serve, divide rice, tilapia, veggies, and sauce between plates. Enjoy!",
      "secondary_message": null
    }
  ],
