  "instructions": [
    {
      "id": 620755,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 620756,
      "primary_message": "Stack the tortillas, then cut in quarters and divide between two large baking sheet pans. Drizzle with oil and spread out in an even layer.",
      "secondary_message": "18 small corn tortillas\n3 tbsp extra virgin olive oil"
    },
    {
      "id": 620757,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and bake, flipping chips halfway through, until golden and crispy, 10-12 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 620758,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "3 green bell peppers\n3 red bell peppers\n3 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 620759,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 620760,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 620761,
      "primary_message": "Peel, halve, and medium dice onions; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 620762,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620763,
      "primary_message": "While the pot heats up, drain and rinse beans.",
      "secondary_message": "3 (15 oz) cans black beans"
    },
    {
      "id": 620764,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies, beans, and spices; cook, stirring occasionally, until veggies are tender, 6-8 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "1 tbsp extra virgin olive oil\n2 tbsp chili powder\n1 tbsp cumin, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 620765,
      "primary_message": "Meanwhile, coarsely grate cheese. Place in the reserved bowl.",
      "secondary_message": "1 (8 oz) block cheddar cheese"
    },
    {
      "id": 620766,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl with the cheese and set aside. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 620767,
      "primary_message": "When the veggies are done, add cheese, cilantro, and tomato sauce to the pot, then stir to combine the bean sauté. Continue to cook, stirring occasionally, until cheese is melted, 3-4 minutes more. Remove from heat.",
      "secondary_message": "3 (8 oz) cans tomato sauce"
    },
    {
      "id": 620768,
      "primary_message": "To serve, divide tortilla chips and cheesy beans between plates. Sprinkle beans with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
