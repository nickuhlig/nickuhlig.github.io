  "instructions": [
    {
      "id": 620741,
      "primary_message": "Preheat oven to 375°F.",
      "secondary_message": null
    },
    {
      "id": 620742,
      "primary_message": "Stack the tortillas, then cut in quarters and transfer to a large baking sheet pan. Drizzle with oil and spread out in an even layer.",
      "secondary_message": "12 small corn tortillas\n2 tbsp extra virgin olive oil"
    },
    {
      "id": 620743,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake, flipping chips halfway through, until golden and crispy, 8-10 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 620744,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "2 green bell peppers\n2 red bell peppers\n2 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 620745,
      "primary_message": "Trim, seed, and medium dice bell peppers. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 620746,
      "primary_message": "Quarter jalapeño peppers lengthwise; seed and remove ribs with a spoon to reduce spice level. Mince and add to the bowl with the bell pepper. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 620747,
      "primary_message": "Peel, halve, and medium dice onion; peel and mince garlic. Add both to the bowl.",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 620748,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620749,
      "primary_message": "While the skillet heats up, drain and rinse beans.",
      "secondary_message": "2 (15 oz) cans black beans"
    },
    {
      "id": 620750,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies, beans, and spices; cook, stirring occasionally, until veggies are tender, 5-6 minutes. (Reserve bowl for the next step.)",
      "secondary_message": "2 tsp extra virgin olive oil\n4 tsp chili powder\n2 tsp cumin, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 620751,
      "primary_message": "Meanwhile, coarsely grate cheese. Place in the reserved bowl.",
      "secondary_message": "⅔ (8 oz) block cheddar cheese"
    },
    {
      "id": 620752,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and roughly chop the leaves. Add half to the bowl with the cheese and set aside. (Reserve remaining cilantro for serving.)",
      "secondary_message": null
    },
    {
      "id": 620753,
      "primary_message": "When the veggies are done, add cheese, cilantro, and tomato sauce to the skillet, then stir to combine the bean sauté. Continue to cook, stirring occasionally, until cheese is melted, 2-3 minutes more. Remove from heat.",
      "secondary_message": "2 (8 oz) cans tomato sauce"
    },
    {
      "id": 620754,
      "primary_message": "To serve, divide tortilla chips and cheesy beans between plates. Sprinkle beans with reserved cilantro and enjoy!",
      "secondary_message": null
    }
  ],
