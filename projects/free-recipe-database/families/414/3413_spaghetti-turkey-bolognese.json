  "instructions": [
    {
      "id": 35775,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": null
    },
    {
      "id": 35776,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 stick celery\n½ small pkg fresh basil"
    },
    {
      "id": 35777,
      "primary_message": "Trim and discard the ends of the celery; small dice the celery and transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 35778,
      "primary_message": "Peel and small dice the onion; add to the celery.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 35779,
      "primary_message": "Preheat a sauté pan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 35780,
      "primary_message": "Peel and mince the garlic; transfer to a small bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 35781,
      "primary_message": "Add olive oil to the pan and swirl to coat the bottom.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 35782,
      "primary_message": "Add the celery and onion to the pan; cook, stirring occasionally, until they begin to soften, 2 to 4 minutes.",
      "secondary_message": null
    },
    {
      "id": 35783,
      "primary_message": "While the vegetables cook, pick the basil leaves off the stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 35784,
      "primary_message": "Add the garlic to the pan; cook until fragrant, 15 to 30 seconds.",
      "secondary_message": ""
    },
    {
      "id": 35785,
      "primary_message": "Once the water is boiling, season with salt and add the pasta. Cook the pasta until desired firmness, 8 to 10 minutes. Once done, drain in a colander.",
      "secondary_message": "1 tbsp salt\n142 g spaghetti pasta"
    },
    {
      "id": 35786,
      "primary_message": "Add the ground turkey to the pan; cook, breaking apart with a spoon, until browned and crumbly, 2 to 4 minutes.",
      "secondary_message": "0.34 kg ground turkey"
    },
    {
      "id": 35787,
      "primary_message": "Add the diced tomatoes and tomato sauce to the pan; season with salt, pepper, and crushed red pepper. Increase the heat to medium-high and let the sauce simmer until thickened, 4 to 6 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n1 (213 ml) can tomato sauce\n½ tsp salt\n¼ tsp black pepper\n⅛ tsp crushed red pepper"
    },
    {
      "id": 35788,
      "primary_message": "Stir the basil and spaghetti into the sauce.",
      "secondary_message": ""
    },
    {
      "id": 35789,
      "primary_message": "To serve, place the pasta into a bowl. Enjoy!",
      "secondary_message": null
    }
  ],
