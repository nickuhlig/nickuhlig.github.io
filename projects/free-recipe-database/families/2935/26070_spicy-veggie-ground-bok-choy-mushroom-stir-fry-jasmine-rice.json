  "instructions": [
    {
      "id": 415009,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 415010,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 415011,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415012,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 5-6 minutes.",
      "secondary_message": "2 tbsp toasted sesame oil\n24 oz veggie ground, plant based"
    },
    {
      "id": 415013,
      "primary_message": "While the veggie ground is cooking, wash and dry green onions and bok choy. Trim and cut the onions and bok choy crosswise into 1-inch pieces.",
      "secondary_message": "2 small bunches green onions (scallions)\n9 baby bok choy"
    },
    {
      "id": 415014,
      "primary_message": "Add green onions, bok choy, and mushrooms to the pot; stir-fry until veggies are fork-tender, about 5 minutes.",
      "secondary_message": "3 (8 oz) pkgs sliced white mushrooms"
    },
    {
      "id": 415015,
      "primary_message": "Add stir-fry and chili-garlic sauces to the pot. Stir to combine and continue to cook until heated through, about 2 minutes. Remove from heat and cover to keep warm.",
      "secondary_message": "¾ cup stir-fry sauce\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 415016,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
