  "instructions": [
    {
      "id": 414966,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup jasmine rice\n1 cup water"
    },
    {
      "id": 414967,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 414968,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 414969,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a cutting board; slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 414970,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and stir-fry until almost cooked through, about 3 minutes. Transfer steak to a plate and set aside. (Reserve skillet with drippings for later use.)",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 414971,
      "primary_message": "Meanwhile, wash and dry green onions and bok choy. Using a clean cutting board, trim and cut the onions and bok choy crosswise into 1-inch pieces.",
      "secondary_message": "½ small bunch green onions (scallions)\n3 baby bok choy"
    },
    {
      "id": 414972,
      "primary_message": "Return the skillet (with drippings) to medium-high heat. Add green onions, bok choy, and mushrooms; stir-fry until veggies are fork-tender, about 4 minutes. Remove from heat.",
      "secondary_message": "1 (8 oz) pkg sliced white mushrooms"
    },
    {
      "id": 414973,
      "primary_message": "When the rice is almost done, return steak strips (and any accumulated juices) to the skillet. Add stir-fry and chili-garlic sauces, then set over medium-high heat. Cook, stirring occasionally until combined and warmed through, 1-2 minutes. Remove from heat.",
      "secondary_message": "¼ cup stir-fry sauce\n2 tsp chili-garlic sauce"
    },
    {
      "id": 414974,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
