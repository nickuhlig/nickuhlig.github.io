  "instructions": [
    {
      "id": 415052,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 cup jasmine rice\n2 cup water"
    },
    {
      "id": 415053,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 415054,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 415055,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggie ground and cook, breaking it apart with a spoon, until browned and crumbly, 4-5 minutes.",
      "secondary_message": "4 tsp toasted sesame oil\n454 g veggie ground, plant based"
    },
    {
      "id": 415056,
      "primary_message": "While the veggie ground is cooking, wash and dry green onions and bok choy. Trim and cut the onions and bok choy crosswise into 1-inch pieces.",
      "secondary_message": "1 small bunch green onions (scallions)\n6 baby bok choy"
    },
    {
      "id": 415057,
      "primary_message": "Add green onions, bok choy, and mushrooms to the skillet; stir-fry until veggies are fork-tender, about 4 minutes.",
      "secondary_message": "2 (227g ) pkgs sliced white mushrooms"
    },
    {
      "id": 415058,
      "primary_message": "Add stir-fry and chili-garlic sauces to the skillet. Stir to combine and continue to cook until heated through, 1-2 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "½ cup stir-fry sauce\n4 tsp chili-garlic sauce"
    },
    {
      "id": 415059,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
