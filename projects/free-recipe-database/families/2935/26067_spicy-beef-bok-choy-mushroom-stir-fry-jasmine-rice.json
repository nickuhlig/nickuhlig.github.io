  "instructions": [
    {
      "id": 414984,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water and bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups jasmine rice\n3 cup water"
    },
    {
      "id": 414985,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 414986,
      "primary_message": "Meanwhile, preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 414987,
      "primary_message": "While the pot heats up, pat the steak dry with paper towels and place on a cutting board; slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 414988,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add steak and stir-fry until almost cooked through, about 4 minutes. Transfer steak to a plate and set aside. (Reserve pot with drippings for later use.)",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 414989,
      "primary_message": "Meanwhile, wash and dry green onions and bok choy. Using a clean cutting board, trim and cut the onions and bok choy crosswise into 1-inch pieces.",
      "secondary_message": "2 small bunches green onions (scallions)\n9 baby bok choy"
    },
    {
      "id": 414990,
      "primary_message": "Return the pot (with drippings) to medium-high heat. Add green onions, bok choy, and mushrooms; stir-fry until veggies are fork-tender, about 5 minutes. Remove from heat.",
      "secondary_message": "3 (8 oz) pkgs sliced white mushrooms"
    },
    {
      "id": 414991,
      "primary_message": "When the rice is almost done, return steak strips (and any accumulated juices) to the pot. Add stir-fry and chili-garlic sauces, then set over medium-high heat. Cook, stirring occasionally until combined and warmed through, about 2 minutes. Remove from heat.",
      "secondary_message": "¾ cup stir-fry sauce\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 414992,
      "primary_message": "To serve, divide rice and stir-fry between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
