  "instructions": [
    {
      "id": 614457,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 ½ lemons\n3 fennel bulbs\n1 ½ (142 g) pkgs baby arugula"
    },
    {
      "id": 614458,
      "primary_message": "Juice lemons into a large bowl. Add oil, maple syrup, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp pure maple syrup\n1 tbsp Dijon mustard\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 614459,
      "primary_message": "Place ketchup, water, soy sauce, and spices in a small bowl. Stir to combine the spicy ketchup and set aside.",
      "secondary_message": "⅓ cup ketchup\n3 tbsp water\n1 tbsp soy sauce\n¾ tsp crushed red pepper\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 614460,
      "primary_message": "Peel and mince shallots. Place in another large bowl, along with veggie ground and spices, then mix with your hands until well combined.",
      "secondary_message": "2 shallots\n680 g veggie ground, plant based\n¾ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 614461,
      "primary_message": "Arrange tortillas on a flat surface, then divide the veggie ground mixture between them (about 2 tablespoons per tortilla). Using a knife (or your hands), spread the veggie ground mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "18 small corn tortillas"
    },
    {
      "id": 614462,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 614463,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, veggie ground-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the veggie ground is cooked through, about 3 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 614464,
      "primary_message": "Flip tacos, veggie ground-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos.",
      "secondary_message": null
    },
    {
      "id": 614465,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 614466,
      "primary_message": "Divide tacos and salad between plates. Serve with spicy ketchup on the side and enjoy!",
      "secondary_message": null
    }
  ],
