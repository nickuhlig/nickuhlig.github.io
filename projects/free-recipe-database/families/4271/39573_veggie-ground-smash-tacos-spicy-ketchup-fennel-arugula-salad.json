  "instructions": [
    {
      "id": 614347,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "½ lemon\n1 fennel bulb\n½ (5 oz) pkg baby arugula"
    },
    {
      "id": 614348,
      "primary_message": "Juice lemon into a medium bowl. Add oil, maple syrup, Dijon, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 tsp pure maple syrup\n1 tsp Dijon mustard\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 614349,
      "primary_message": "Place ketchup, water, soy sauce, and spices in a small bowl. Stir to combine the spicy ketchup and set aside.",
      "secondary_message": "2 tbsp ketchup\n1 tbsp water\n1 tsp soy sauce\n¼ tsp crushed red pepper\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 614350,
      "primary_message": "Peel and mince shallot. Place in another medium bowl, along with veggie ground and spices, then mix with your hands until well combined.",
      "secondary_message": "½ shallot\n8 oz veggie ground, plant based\n¼ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 614351,
      "primary_message": "Arrange tortillas on a flat surface, then divide the veggie ground mixture between them (about 2 tablespoons per tortilla). Using a knife (or your hands), spread the veggie ground mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "6 small corn tortillas"
    },
    {
      "id": 614352,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 614353,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, veggie ground-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the veggie ground is cooked through, about 3 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 614354,
      "primary_message": "Flip tacos, veggie ground-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos.",
      "secondary_message": null
    },
    {
      "id": 614355,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulb. Halve fennel bulb lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 614356,
      "primary_message": "Divide tacos and salad between plates. Serve with spicy ketchup on the side and enjoy!",
      "secondary_message": null
    }
  ],
