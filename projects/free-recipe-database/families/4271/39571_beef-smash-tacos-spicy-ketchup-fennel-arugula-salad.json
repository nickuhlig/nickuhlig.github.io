  "instructions": [
    {
      "id": 614327,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 lemon\n2 fennel bulbs\n1 (5 oz) pkg baby arugula"
    },
    {
      "id": 614328,
      "primary_message": "Juice lemon into a medium bowl. Add oil, honey, Dijon, salt, and pepper, then whisk to combine the dressing. Set aside.",
      "secondary_message": "4 tsp extra virgin olive oil\n2 tsp honey\n2 tsp Dijon mustard\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 614329,
      "primary_message": "Place ketchup, water, Worcestershire, and spices in a small bowl. Stir to combine the spicy ketchup and set aside.",
      "secondary_message": "¼ cup ketchup\n2 tbsp water\n2 tsp Worcestershire sauce\n½ tsp crushed red pepper\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 614330,
      "primary_message": "Peel and mince shallot. Place in another medium bowl, along with beef and spices, then mix with your hands until well combined.",
      "secondary_message": "1 shallot\n1 ½ lb lean ground beef\n1 tsp salt\n½ tsp black pepper\n½ tsp garlic powder"
    },
    {
      "id": 614331,
      "primary_message": "Arrange tortillas on a flat surface, then divide the beef mixture between them (about 3 tablespoons per tortilla). Using a knife (or your hands), spread the beef mixture over the surface of each tortilla in an even layer.",
      "secondary_message": "12 small corn tortillas"
    },
    {
      "id": 614332,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 614333,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tacos, meat-side down. Cook, pressing down once with the bottom of a spatula halfway through cooking, until the beef is cooked through, about 3 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 614334,
      "primary_message": "Flip tacos, beef-side up, and continue to cook until tortillas are golden underneath, 1 minute more. Transfer to a plate and carefully fold in half to form tacos.",
      "secondary_message": null
    },
    {
      "id": 614335,
      "primary_message": "Meanwhile, trim off root end and stalks of the fennel, leaving only the white bulbs. Halve fennel bulbs lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the dressing, along with arugula, and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 614336,
      "primary_message": "Divide tacos and salad between plates. Serve with spicy ketchup on the side and enjoy!",
      "secondary_message": null
    }
  ],
