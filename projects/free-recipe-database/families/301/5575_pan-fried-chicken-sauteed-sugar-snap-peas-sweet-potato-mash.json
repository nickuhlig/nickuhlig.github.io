  "instructions": [
    {
      "id": 66718,
      "primary_message": "Fill a medium saucepan about halfway with water, cover, and bring to a boil.",
      "secondary_message": ""
    },
    {
      "id": 66717,
      "primary_message": "Wash, peel, and medium dice the sweet potatoes; add to the saucepan. Once the water is boiling, cook until the potatoes are very tender when pierced with a fork, 10-15 minutes. Drain and return to saucepan.",
      "secondary_message": "1.02 kg sweet potatoes"
    },
    {
      "id": 66716,
      "primary_message": "Wash the snap peas and lemons. Cut the lemons into wedges. Peel and mince the garlic.",
      "secondary_message": "3 (227 g) pkg sugar snap peas\n1 ½ lemon\n9 cloves garlic"
    },
    {
      "id": 66715,
      "primary_message": "Heat a skillet over medium heat.",
      "secondary_message": ""
    },
    {
      "id": 66714,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Season both sides with salt and pepper.",
      "secondary_message": "0.681 kg chicken breasts, boneless skinless\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 66713,
      "primary_message": "Melt butter in the skillet. Add the minced garlic and cook until fragrant, 15-30 seconds. Add the chicken and cook until golden brown and cooked through, 3-4 minutes per side. Transfer to a plate.",
      "secondary_message": "3 tbsp butter, unsalted"
    },
    {
      "id": 66712,
      "primary_message": "Add more butter to the skillet, followed by the sugar snap peas. Cook, stirring occasionally, until bright green and tender-crisp, 2-3 minutes. Season with salt and pepper and remove from heat.",
      "secondary_message": "3 tbsp butter, unsalted\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 66711,
      "primary_message": "Add the remaining butter to the potatoes and season with salt and pepper. Mash with a potato masher (or a fork) until smooth.",
      "secondary_message": "3 tbsp butter, unsalted\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 66710,
      "primary_message": "Slice the chicken crosswise on an angle.",
      "secondary_message": ""
    },
    {
      "id": 66709,
      "primary_message": "To serve, place the mashed potatoes, sautéed peas, and chicken on a plate. Garnish with the lemon wedges and enjoy!",
      "secondary_message": ""
    }
  ],
