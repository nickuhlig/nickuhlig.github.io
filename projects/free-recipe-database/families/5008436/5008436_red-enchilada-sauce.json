  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Peel the garlic.",
      "secondary_message": "2 medium cloves garlic"
    },
    {
      "id": 1,
      "primary_message": "Preheat oven to 350°F. Place guajillo chiles on a baking sheet and heat in oven until puffed up and aromatic, about 3-5 minutes. Remove from oven and allow to cool. Stem and seed chiles; tear into pieces.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Place chiles, garlic, tomatoes, cumin, and black pepper in jar of a blender. Purée until as smooth as possible.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Heat oil in a large saucepan over medium-high heat until shimmering. Set a fine-mesh strainer over pan and pour in sauce. Press sauce through strainer into saucepan. Cook sauce, stirring constantly, until thickened to consistency of tomato paste, 5 to 7 minutes. Pour in chicken broth, bring to a boil, then reduce heat and simmer for 10 minutes, stirring occasionally. Taste sauce and season with salt and sugar to taste.",
      "secondary_message": null
    }
  ],
