  "instructions": [
    {
      "id": 374306,
      "primary_message": "Wash and dry raspberries. Place in a medium bowl along with the cinnamon. Using a fork or potato masher, gently crush the raspberries until they reach a chunky, jam-like consistency. Set aside.",
      "secondary_message": "3 (6 oz) pkgs raspberries\n½ tsp cinnamon, ground"
    },
    {
      "id": 374307,
      "primary_message": "Roughly chop pistachios.",
      "secondary_message": "¾ cup pistachios, unsalted"
    },
    {
      "id": 374308,
      "primary_message": "To serve, divide yogurt between bowls. Top with crushed raspberries, then swirl with the yogurt using a spoon. Sprinkle with pistachios and enjoy!",
      "secondary_message": "4 ½ cups plain Greek yogurt"
    }
  ],
