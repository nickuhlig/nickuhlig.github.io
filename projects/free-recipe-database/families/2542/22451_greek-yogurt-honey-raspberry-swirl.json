    },
    {
      "id": 374323,
      "primary_message": "To serve, divide yogurt between bowls. Top with crushed raspberries, then swirl with the yogurt using a spoon. Enjoy!",
      "secondary_message": "3 cups plain Greek yogurt"
    }
