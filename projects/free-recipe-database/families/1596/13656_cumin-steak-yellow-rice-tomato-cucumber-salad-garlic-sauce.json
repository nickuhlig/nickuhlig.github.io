  "instructions": [
    {
      "id": 227326,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water, turmeric, and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n1 ½ tsp turmeric, ground\n¾ tsp salt"
    },
    {
      "id": 227327,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 227328,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "1 ½ English cucumbers\n3 tomatoes\n1 ½ lemons"
    },
    {
      "id": 227329,
      "primary_message": "Trim and medium dice cucumbers; transfer to a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 227330,
      "primary_message": "Medium dice tomatoes and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 227331,
      "primary_message": "Peel and small dice onion; add to the bowl.",
      "secondary_message": "1 medium red onion"
    },
    {
      "id": 227332,
      "primary_message": "Juice lemons into the bowl, drizzle with oil, and season with spices. Stir to combine the salad and set aside. ",
      "secondary_message": "1 tbsp extra virgin olive oil\n¾ tsp oregano, dried\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 227333,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227334,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp cumin, ground\n½ tsp coriander, ground"
    },
    {
      "id": 227335,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 227336,
      "primary_message": "Meanwhile, place mayo, vinegar, and spices in a small bowl. Whisk to combine the garlic sauce. ",
      "secondary_message": "⅓ cup mayonnaise\n1 tbsp apple cider vinegar\n¾ tsp garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 227337,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 227338,
      "primary_message": "Divide rice, salad, and steak between plates. Serve with garlic sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
