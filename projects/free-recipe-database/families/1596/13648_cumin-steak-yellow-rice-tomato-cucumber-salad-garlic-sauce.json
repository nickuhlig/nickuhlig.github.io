  "instructions": [
    {
      "id": 227228,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water, turmeric, and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n½ tsp turmeric, ground\n¼ tsp salt"
    },
    {
      "id": 227229,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 227230,
      "primary_message": "Meanwhile, wash and dry the fresh produce.",
      "secondary_message": "½ English cucumber\n1 tomato\n½ lemon"
    },
    {
      "id": 227231,
      "primary_message": "Trim and medium dice cucumber; transfer to a small bowl.",
      "secondary_message": null
    },
    {
      "id": 227232,
      "primary_message": "Medium dice tomato and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 227233,
      "primary_message": "Peel and small dice shallot; add to the bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 227234,
      "primary_message": "Juice lemon into the bowl, drizzle with oil, and season with spices. Stir to combine the salad and set aside. ",
      "secondary_message": "1 tsp extra virgin olive oil\n¼ tsp oregano, dried\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 227235,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227236,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n¼ tsp cumin, ground\n⅛ tsp coriander, ground"
    },
    {
      "id": 227237,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 227238,
      "primary_message": "Meanwhile, place mayo, vinegar, and spices in another small bowl. Whisk to combine the garlic sauce. ",
      "secondary_message": "2 tbsp mayonnaise\n1 tsp apple cider vinegar\n¼ tsp garlic powder\n1 pinch salt\n1 pinch black pepper"
    },
    {
      "id": 227239,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 227240,
      "primary_message": "Divide rice, salad, and steak between plates. Serve with garlic sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
