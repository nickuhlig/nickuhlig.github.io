  "instructions": [
    {
      "id": 227361,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 English cucumbers\n6 tomatoes\n3 lemons"
    },
    {
      "id": 227362,
      "primary_message": "Trim and medium dice cucumbers; transfer to a large bowl.",
      "secondary_message": null
    },
    {
      "id": 227363,
      "primary_message": "Medium dice tomatoes and add to the bowl with the cucumber.",
      "secondary_message": null
    },
    {
      "id": 227364,
      "primary_message": "Peel and small dice onions; add to the bowl.",
      "secondary_message": "1 ½ medium red onions"
    },
    {
      "id": 227365,
      "primary_message": "Juice lemons into the bowl, drizzle with oil, and season with spices. Stir to combine the salad and set aside. ",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tsp oregano, dried\n1 ½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 227366,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 227367,
      "primary_message": "While the skillet heats up, pat the steak dry with paper towels and place on a plate; season with spices on both sides.",
      "secondary_message": "1.02 kg striploin (New York strip) steak\n¾ tsp salt\n¾ tsp cumin, ground\n½ tsp coriander, ground"
    },
    {
      "id": 227368,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add steak and cook until desired doneness, 2-5 minutes per side. Transfer to a clean plate and let rest, about 5 minutes.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 227369,
      "primary_message": "Meanwhile, place mayo, vinegar, and spices in a small bowl. Whisk to combine the garlic sauce. ",
      "secondary_message": "⅓ cup avocado oil mayonnaise\n1 tbsp apple cider vinegar\n¾ tsp garlic powder\n3 pinch salt\n3 pinch black pepper"
    },
    {
      "id": 227370,
      "primary_message": "Thinly slice steak against the grain.",
      "secondary_message": null
    },
    {
      "id": 227371,
      "primary_message": "Divide salad and steak between plates. Serve with garlic sauce on the side and enjoy!",
      "secondary_message": null
    }
  ],
