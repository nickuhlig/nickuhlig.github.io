  "instructions": [
    {
      "id": 620527,
      "primary_message": "Preheat oven to 450°F. Coat two large baking dishes with a thin layer of oil.",
      "secondary_message": "1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 620528,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small bunch Italian (flat-leaf) parsley\n3 medium zucchini squash\n1 ½ medium heads napa cabbage"
    },
    {
      "id": 620529,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place half in a large bowl. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 620530,
      "primary_message": "Trim and coarsely grate zucchini. Add to the bowl with the parsley along with beef, Worcestershire, and spices; mix with your hands until well combined. Using a generous tablespoon measure, form the beef mixture into rounded meatballs. Divide between the baking dishes.",
      "secondary_message": "2 ¼ lb lean ground beef\n1 tbsp Worcestershire sauce\n1 ½ tsp salt\n¾ tsp black pepper\n¾ tsp garlic powder"
    },
    {
      "id": 620531,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, 15-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 620532,
      "primary_message": "Meanwhile, trim off and discard root end of each cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a clean large bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 620533,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620534,
      "primary_message": "While the pot heats up, medium dice bacon.",
      "secondary_message": "12 slices bacon"
    },
    {
      "id": 620535,
      "primary_message": "When the pot is hot, add bacon and cook, stirring occasionally, until browned and crispy, 5-6 minutes.",
      "secondary_message": null
    },
    {
      "id": 620536,
      "primary_message": "When the bacon is done, add cabbage and spices to the pot, then stir to combine. Continue to cook, stirring occasionally, until cabbage is tender, about 8 minutes. Remove from heat.",
      "secondary_message": "1 ½ tsp smoked paprika\n¾ tsp onion powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 620537,
      "primary_message": "To serve, divide meatballs and bacon-fried cabbage between plates or bowls. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
