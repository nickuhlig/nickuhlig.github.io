  "instructions": [
    {
      "id": 620571,
      "primary_message": "Preheat oven to 230°C (450°F). Coat a baking dish with a thin layer of oil.",
      "secondary_message": "½ tsp extra virgin olive oil"
    },
    {
      "id": 620572,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch Italian (flat-leaf) parsley\n1 medium zucchini squash\n½ medium head napa cabbage"
    },
    {
      "id": 620573,
      "primary_message": "Shave parsley leaves off the stems; discard stems and mince the leaves. Place half in a medium bowl. (Reserve remaining parsley for serving.)",
      "secondary_message": null
    },
    {
      "id": 620574,
      "primary_message": "Trim and coarsely grate zucchini. Add to the bowl with the parsley along with beef, Worcestershire, and spices; mix with your hands until well combined. Using a generous tablespoon measure, form the beef mixture into rounded meatballs. Transfer to the baking dish.",
      "secondary_message": "⅓ kg lean ground beef\n1 tsp Worcestershire sauce\n½ tsp salt\n¼ tsp black pepper\n¼ tsp garlic powder"
    },
    {
      "id": 620575,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake until golden and cooked through, about 15 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 620576,
      "primary_message": "Meanwhile, trim off and discard root end of cabbage; halve lengthwise, then slice crosswise into thin (shred-like) strips. Place in a clean medium bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 620577,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 620578,
      "primary_message": "While the skillet heats up, medium dice bacon.",
      "secondary_message": "4 slices bacon"
    },
    {
      "id": 620579,
      "primary_message": "When the skillet is hot, add bacon and cook, stirring occasionally, until browned and crispy, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 620580,
      "primary_message": "When the bacon is done, add cabbage and spices to the skillet, then stir to combine. Continue to cook, stirring occasionally, until cabbage is tender, 6-8 minutes more. Remove from heat.",
      "secondary_message": "½ tsp smoked paprika\n¼ tsp onion powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 620581,
      "primary_message": "To serve, divide meatballs and bacon-fried cabbage between plates or bowls. Sprinkle with reserved parsley and enjoy!",
      "secondary_message": null
    }
  ],
