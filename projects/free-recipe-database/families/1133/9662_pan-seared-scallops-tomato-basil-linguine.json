  "instructions": [
    {
      "id": 153966,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n142 g linguine pasta"
    },
    {
      "id": 153967,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 153968,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; rub with oil and season with salt and pepper on both sides.",
      "secondary_message": "⅓ kg sea scallops\n2 tsp extra virgin olive oil\n¼ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 153969,
      "primary_message": "Once the skillet is hot, carefully add the scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil"
    },
    {
      "id": 153970,
      "primary_message": "Meanwhile, peel and small dice the onion.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 153971,
      "primary_message": "Return skillet to medium heat, add oil and swirl to coat the bottom. Add onions and cook, stirring occasionally, until softened, about 4 minutes.",
      "secondary_message": "1 tsp extra virgin olive oil"
    },
    {
      "id": 153972,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 153973,
      "primary_message": "Add tomatoes, garlic, and crushed red pepper to the skillet with the onions; stir to combine. Bring to a boil over high heat then reduce heat and simmer, stirring occasionally, for 5 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n⅛ tsp crushed red pepper"
    },
    {
      "id": 153974,
      "primary_message": "Meanwhile, wash basil, pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "½ small pkg fresh basil"
    },
    {
      "id": 153975,
      "primary_message": "Add scallops, capers, and basil to the sauce; simmer 1 minute more.",
      "secondary_message": "1 tbsp capers"
    },
    {
      "id": 153976,
      "primary_message": "Drain pasta, add to the skillet, and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 153977,
      "primary_message": "To serve, divide pasta, sauce, and scallops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
