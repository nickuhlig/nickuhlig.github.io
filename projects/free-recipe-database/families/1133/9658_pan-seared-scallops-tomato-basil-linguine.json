  "instructions": [
    {
      "id": 153918,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n15 oz linguine pasta"
    },
    {
      "id": 153919,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 153920,
      "primary_message": "While the skillet heats up, pat the scallops dry with paper towels and place on a plate; rub with oil and season with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb sea scallops\n2 tbsp extra virgin olive oil\n¾ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 153921,
      "primary_message": "Once the skillet is hot, carefully add the scallops in a single layer; cook until they develop a nice sear and are opaque throughout, 1½-2 minutes per side. Once done, transfer to a plate. Work in batches if necessary.",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 153922,
      "primary_message": "Meanwhile, peel and small dice the onions.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 153923,
      "primary_message": "Return skillet to medium heat, add oil and swirl to coat the bottom. Add onions and cook, stirring occasionally, until softened, about 4 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 153924,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 153925,
      "primary_message": "Add tomatoes, garlic, and crushed red pepper to the skillet with the onions; stir to combine. Bring to a boil over high heat then reduce heat and simmer, stirring occasionally, for 5 minutes.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n¼ tsp crushed red pepper"
    },
    {
      "id": 153926,
      "primary_message": "Meanwhile, wash basil, pick leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": "1 ½ small pkgs fresh basil"
    },
    {
      "id": 153927,
      "primary_message": "Add scallops, capers, and basil to the sauce; simmer 2-3 minutes more.",
      "secondary_message": "3 tbsp capers"
    },
    {
      "id": 153928,
      "primary_message": "Drain pasta and return to the pot. Add sauce and toss to coat.",
      "secondary_message": null
    },
    {
      "id": 153929,
      "primary_message": "To serve, divide pasta, sauce, and scallops between plates. Enjoy!",
      "secondary_message": null
    }
  ],
