  "instructions": [
    {
      "id": 7553,
      "primary_message": "Preheat oven to 230°C (450°F). Using a paper towel, lightly coat a small baking dish with oil.",
      "secondary_message": "about ½ tsp extra virgin olive oil"
    },
    {
      "id": 13037,
      "primary_message": "Grate ¼ cup of Parmesan. In a small bowl, mix together Parmesan, bread crumbs, salt, pepper, and paprika.",
      "secondary_message": "28 g Parmesan cheese\r\n½ cup panko bread crumbs\r\n¼ tsp salt\r\n⅛ tsp black pepper\r\n⅛ tsp paprika"
    },
    {
      "id": 13038,
      "primary_message": "In a different small bowl, mix together Dijon, honey, and oil.",
      "secondary_message": "2 tbsp Dijon mustard\r\n1 ½ tbsp honey\r\n½ tbsp extra virgin olive oil"
    },
    {
      "id": 13039,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Cut each fillet into strips.",
      "secondary_message": "0.454 kg boneless skinless chicken breasts"
    },
    {
      "id": 13040,
      "primary_message": "One by one, dip chicken strips in mustard mixture, then coat in bread crumb mixture, and place in baking dish.",
      "secondary_message": ""
    },
    {
      "id": 13041,
      "primary_message": "Place in the oven and bake, turning over halfway through, until tenders are golden brown, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 13042,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare sauce by mixing together ½ of the garlic (save the rest for the slaw), Dijon, and honey. Set aside.",
      "secondary_message": "2 cloves garlic\r\n2 tbsp Dijon mustard\r\n2 tbsp honey"
    },
    {
      "id": 13043,
      "primary_message": "In a large bowl, prepare dressing by whisking together remaining garlic, lemon juice, oil, salt, and pepper.",
      "secondary_message": "½ lemon\r\n1 ½ tbsp extra virgin olive oil\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 13044,
      "primary_message": "Add broccoli slaw to bowl with dressing. Wash, peel, and medium dice orange. Add to bowl and toss salad.",
      "secondary_message": "½ (340 g) pkg broccoli slaw\r\n1 orange"
    },
    {
      "id": 7563,
      "primary_message": "To serve, place chicken tenders and broccoli slaw on a plate and have honey mustard sauce on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
