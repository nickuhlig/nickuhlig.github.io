  "instructions": [
    {
      "id": 60889,
      "primary_message": "Preheat oven to 450°F. Using a paper towel, lightly coat a large baking dish with oil.",
      "secondary_message": "about 1 ½ tsp extra virgin olive oil"
    },
    {
      "id": 60898,
      "primary_message": "Grate 3/4 cup of Parmesan. In a medium bowl, mix together Parmesan, bread crumbs, salt, pepper, and paprika.",
      "secondary_message": "3 oz Parmesan cheese\n1 ½ cup panko bread crumbs\n¾ tsp salt\n⅜ tsp black pepper\n⅜ tsp paprika"
    },
    {
      "id": 60897,
      "primary_message": "In a medium bowl, mix together Dijon, honey, and oil.",
      "secondary_message": "6 tbsp Dijon mustard\n4 ½ tbsp honey\n1 ½ tbsp extra virgin olive oil"
    },
    {
      "id": 60896,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Cut each fillet into strips.",
      "secondary_message": "3 lb boneless skinless chicken breasts"
    },
    {
      "id": 60895,
      "primary_message": "One by one, dip chicken strips in mustard mixture, then coat in bread crumb mixture, and place in baking dish.",
      "secondary_message": ""
    },
    {
      "id": 60894,
      "primary_message": "Place in the oven and bake, turning over halfway through, until tenders are golden brown, 15-20 minutes.",
      "secondary_message": ""
    },
    {
      "id": 60893,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare sauce by mixing together ½ of the garlic (save the rest for the slaw), Dijon, and honey. Set aside.",
      "secondary_message": "6 cloves garlic\n6 tbsp Dijon mustard\n6 tbsp honey"
    },
    {
      "id": 60892,
      "primary_message": "In a large bowl, prepare dressing by whisking together remaining garlic, lemon juice, oil, salt, and pepper.",
      "secondary_message": "1 ½ lemon\n4 ½ tbsp extra virgin olive oil\n⅜ tsp salt\n⅜ tsp black pepper"
    },
    {
      "id": 60891,
      "primary_message": "Add broccoli slaw to bowl with dressing. Wash, peel, and medium dice oranges. Add to bowl and toss salad.",
      "secondary_message": "1 ½ (12 oz) pkg broccoli slaw\n3 oranges"
    },
    {
      "id": 60890,
      "primary_message": "To serve, place chicken tenders and broccoli slaw on a plate and have honey mustard sauce on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
