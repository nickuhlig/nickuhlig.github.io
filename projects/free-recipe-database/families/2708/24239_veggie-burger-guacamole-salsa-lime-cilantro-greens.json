  "instructions": [
    {
      "id": 418760,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 418761,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n1 lime\n1 (142 g) pkg spring mix (mixed greens)"
    },
    {
      "id": 418762,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add burger patties and cook, flipping once, until golden brown and cooked through, 8-10 minutes (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "2 tsp extra virgin olive oil\n4 veggie burger patties, plant-based"
    },
    {
      "id": 418763,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 418764,
      "primary_message": "Juice lime into the bowl with the cilantro. Add mayo, dressing, and chili powder; whisk to combine the dressing and set aside.",
      "secondary_message": "2 tbsp vegan mayonnaise\n2 tbsp Italian salad dressing\n¼ tsp chili powder"
    },
    {
      "id": 418765,
      "primary_message": "Toast buns if desired.",
      "secondary_message": "4 whole grain buns or rolls"
    },
    {
      "id": 418766,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 418767,
      "primary_message": "Place bottom half of each bun on a plate, then layer with a burger patty, guacamole, and salsa; close with the top half of each bun. Serve with salad on the side. Enjoy!",
      "secondary_message": "1 cup guacamole\n½ cup salsa"
    }
  ],
