  "instructions": [
    {
      "id": 418743,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 418744,
      "primary_message": "While the skillet heats up, wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 small bunch cilantro\n1 ½ limes\n1 ½ (142 g) pkgs spring mix (mixed greens)"
    },
    {
      "id": 418745,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add burger patties and cook until golden brown on one side, 4-5 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil\n6 veggie burger patties, plant-based"
    },
    {
      "id": 418746,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 418747,
      "primary_message": "Juice limes into the bowl with the cilantro. Add mayo, dressing, and chili powder; whisk to combine the dressing and set aside.",
      "secondary_message": "3 tbsp mayonnaise\n3 tbsp Italian salad dressing\n½ tsp chili powder"
    },
    {
      "id": 418748,
      "primary_message": "Flip the burger patties, top with cheese, and continue to cook until cheese is melted and patties are golden brown and cooked through, 4-5 minutes more (or cook patties according to package instructions). Remove to a plate.",
      "secondary_message": "1 ½ cups shredded cheese, Mexican blend"
    },
    {
      "id": 418749,
      "primary_message": "Meanwhile, toast buns if desired.",
      "secondary_message": "6 whole grain buns or rolls"
    },
    {
      "id": 418750,
      "primary_message": "Add mixed greens to the bowl with the dressing and toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 418751,
      "primary_message": "Place bottom half of each bun on a plate, then layer with a cheesy burger patty, guacamole, and salsa; close with the top half of each bun. Serve with salad on the side. Enjoy!",
      "secondary_message": "1 ½ cups guacamole\n¾ cup salsa"
    }
  ],
