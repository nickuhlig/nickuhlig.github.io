  "instructions": [
    {
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch green onions (scallions)\n1 pint grape tomatoes\n½ English cucumber\n1 head butter (Boston) lettuce"
    },
    {
      "primary_message": "Divide dressing between 2 (quart-size) jars.",
      "secondary_message": "⅓ cup ranch dressing"
    },
    {
      "primary_message": "Trim and cut green onions crosswise into thin pieces. Add to the jars with the dressing.",
      "secondary_message": null
    },
    {
      "primary_message": "Halve tomatoes lengthwise and add to the jars.",
      "secondary_message": null
    },
    {
      "primary_message": "Trim and medium dice cucumber. Add to the jars.",
      "secondary_message": null
    },
    {
      "primary_message": "Add cranberries and cheese to the jars.",
      "secondary_message": "½ cup dried cranberries\n⅔ cup shredded cheese, Italian blend"
    },
    {
      "primary_message": "Stack turkey slices one on top of another, then medium dice. Add to the jars.",
      "secondary_message": "8 oz oven roasted turkey breast, sliced"
    },
    {
      "primary_message": "Chop (or tear) lettuce into bite-sized pieces. Add to the jars, packing lightly if necessary.",
      "secondary_message": null
    },
    {
      "primary_message": "Screw lids onto jars and store in the fridge until needed. (Best if used within 2-3 days.)",
      "secondary_message": null
    },
    {
      "primary_message": "When ready to eat, empty jar into a bowl (making sure to scrape out all of the dressing!) and toss to combine the salad. Enjoy!",
      "secondary_message": null
    }
  ],
