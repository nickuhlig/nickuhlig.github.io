  "instructions": [
    {
      "id": 152618,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152619,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add corn to the skillet and cook until corn softens and begins to brown, 2-3 minutes. Remove from the heat and set aside. ",
      "secondary_message": "¾ cup frozen corn\n1 tsp butter, unsalted"
    },
    {
      "id": 152620,
      "primary_message": "Add blackberries and maple syrup to a small saucepan. Heat on medium-low, stirring frequently, until berries begin to bubble and release their juices, 3-4 minutes. Transfer to a serving bowl and cover with aluminum foil; set aside. Reserve saucepan for later.",
      "secondary_message": "1 (6 oz) pkg blackberries\n1 tbsp pure maple syrup"
    },
    {
      "id": 152621,
      "primary_message": "Meanwhile, combine flour, sugar, baking powder, cinnamon, and salt in a medium bowl. ",
      "secondary_message": "¾ cup all-purpose flour\n1 tbsp brown sugar\n¾ tsp baking powder\n¼ tsp cinnamon\n¼ tsp salt"
    },
    {
      "id": 152622,
      "primary_message": "Melt butter in the reserved saucepan.",
      "secondary_message": "1 tbsp butter, unsalted"
    },
    {
      "id": 152623,
      "primary_message": "Create a well in the center of the flour mixture. Add the milk, egg, and melted butter, then whisk to make a smooth batter. Add corn and stir to combine.",
      "secondary_message": "6 fl oz (¾ cup) whole milk\n1 egg"
    },
    {
      "id": 152624,
      "primary_message": "Return skillet to medium-high heat. Add butter and swirl to coat bottom. ",
      "secondary_message": "2 tsp butter, unsalted"
    },
    {
      "id": 152625,
      "primary_message": "Working in batches if necessary, use a ¼-cup measure to pour the batter into the skillet. Cook for 2-3 minutes on each side, until golden and cooked through.",
      "secondary_message": null
    },
    {
      "id": 152626,
      "primary_message": "Divide pancakes between plates and top warm blackberry sauce. Enjoy! ",
      "secondary_message": null
    }
  ],
