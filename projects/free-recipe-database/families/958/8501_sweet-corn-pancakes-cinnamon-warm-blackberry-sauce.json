  "instructions": [
    {
      "id": 152654,
      "primary_message": "Preheat a large nonstick skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 152655,
      "primary_message": "Once the skillet is hot, add butter and swirl to coat the bottom. Add corn to the skillet and cook until corn softens and begins to brown, 3-4 minutes. Remove from the heat and set aside. ",
      "secondary_message": "1 ½ cups frozen corn\n2 tsp butter, unsalted"
    },
    {
      "id": 152656,
      "primary_message": "Add blackberries and maple syrup to a medium saucepan. Heat on medium-low, stirring frequently, until berries begin to bubble and release their juices, 3-4 minutes. Transfer to a serving bowl and cover with aluminum foil; set aside. Reserve saucepan for later.",
      "secondary_message": "2 (170 g) pkg blackberries\n2 tbsp pure maple syrup"
    },
    {
      "id": 152657,
      "primary_message": "Meanwhile, combine flour, sugar, baking powder, cinnamon, and salt in a large bowl. ",
      "secondary_message": "1 ½ cup all-purpose flour\n2 tbsp brown sugar\n1 ½ tsp baking powder\n½ tsp cinnamon\n½ tsp salt"
    },
    {
      "id": 152658,
      "primary_message": "Melt butter in the reserved saucepan.",
      "secondary_message": "2 tbsp butter, unsalted"
    },
    {
      "id": 152659,
      "primary_message": "Create a well in the center of the flour mixture. Add the milk, egg, and melted butter, then whisk to make a smooth batter. Add corn and stir to combine.",
      "secondary_message": "355 ml whole milk\n2 eggs"
    },
    {
      "id": 152660,
      "primary_message": "Return skillet to medium-high heat. Add butter and swirl to coat bottom. ",
      "secondary_message": "4 tsp butter, unsalted"
    },
    {
      "id": 152661,
      "primary_message": "Working in batches if necessary, use a ¼-cup measure to pour the batter into the skillet. Cook for 2-3 minutes on each side, until golden and cooked through.",
      "secondary_message": null
    },
    {
      "id": 152662,
      "primary_message": "Divide pancakes between plates and top warm blackberry sauce. Enjoy! ",
      "secondary_message": null
    }
  ],
