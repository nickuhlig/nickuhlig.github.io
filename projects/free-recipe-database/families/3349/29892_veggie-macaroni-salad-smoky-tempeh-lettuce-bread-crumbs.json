  "instructions": [
    {
      "id": 475897,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 ½ tsp salt\n340 g macaroni (elbow) pasta"
    },
    {
      "id": 475898,
      "primary_message": "Small dice tempeh.",
      "secondary_message": "3 (227g ) pkgs tempeh"
    },
    {
      "id": 475899,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 475900,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches, add tempeh, soy sauce, smoked paprika, and salt; cook, stirring occasionally, until golden, 4-5 minutes. Remove tempeh to a plate. (Reserve skillet for later use.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp soy sauce\n¾ tsp smoked paprika\n¾ tsp salt"
    },
    {
      "id": 475901,
      "primary_message": "Meanwhile, place yogurt, mayo, vinegar, Dijon, honey, and spices in a large bowl. Whisk to combine the dressing and set aside.",
      "secondary_message": "1 cup plain Greek yogurt\n¼ cup mayonnaise\n1 ½ tbsp red wine vinegar\n1 ½ tbsp Dijon mustard\n1 ½ tsp honey\n¾ tsp garlic powder\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 475902,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium carrots\n3 sticks celery\n3 tomatoes\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 475903,
      "primary_message": "Peel, trim, and small dice carrots. Trim and small dice celery. Add both to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 475904,
      "primary_message": "Small dice tomatoes. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 475905,
      "primary_message": "Return the skillet to medium heat. Add more oil and swirl to coat the bottom; add bread crumbs and toast, stirring often, until golden brown, about 4 minutes. Transfer toasted bread crumbs to a small bowl, then add garlic powder and salt; stir to combine and set aside.",
      "secondary_message": "1 ½ tbsp extra virgin olive oil\n1 cup panko bread crumbs\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 475906,
      "primary_message": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl with the dressing and veggies. Stir to combine the macaroni salad.",
      "secondary_message": null
    },
    {
      "id": 475907,
      "primary_message": "Separate lettuce into leaves and arrange on plates. Top with macaroni salad, bread crumbs, and tempeh. Enjoy!",
      "secondary_message": null
    }
  ],
