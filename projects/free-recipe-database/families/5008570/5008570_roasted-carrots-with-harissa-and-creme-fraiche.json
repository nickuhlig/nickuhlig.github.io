  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Pick the cilantro leaves from the stems and finely chop them.",
      "secondary_message": "2 tbsp fresh cilantro leaves"
    },
    {
      "id": 1,
      "primary_message": "Adjust oven rack to center position and preheat oven to 375°F. Place carrots in a large pot, cover with water, and season heavily with salt. Heat over high heat until boiling. Reduce to a simmer and cook until barely tender, about 5 minutes. Drain and allow to dry for 5 minutes. Set aside. Season crème fraîche with salt to taste and refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Combine harissa, cumin, black pepper, and olive oil in a large bowl. Season to taste with salt. Transfer half of mixture to small bowl and set aside. Add carrots to remaining mixture and toss to coat. Transfer to foil-lined rimmed baking sheet and spread out in an even layer. Roast until caramelized, about 40 minutes, turning once or twice during roasting. Transfer carrots to a large bowl and toss with cilantro.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spread crème fraîche on serving platter. Top with carrots and drizzle with remaining harissa mixture. Serve immediately.",
      "secondary_message": null
    }
  ],
