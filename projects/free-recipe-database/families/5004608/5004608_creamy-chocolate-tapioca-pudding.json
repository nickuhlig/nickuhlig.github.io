  "instructions": [
    {
      "id": 1,
      "primary_message": "Bring milk, tapioca, sugar, and salt to simmer in large heavy bottomed saucepan over medium heat, gently stirring constantly. Reduce heat to low and continue to simmer, stirring, until mixture thickens and pearls become soft and translucent, about 12 to 15 minutes. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In small bowl slowly whisk about 1/2 cup hot tapioca mixture into egg yolks. Return yolk mixture to pot and stir to combine.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Stir in vanilla and chocolate until chocolate is completely melted. Transfer to bowl, cover, and chill until set, about 3 hours. Stir gently before serving to soften pudding. Serve with whipped cream on the side.",
      "secondary_message": null
    }
  ],
