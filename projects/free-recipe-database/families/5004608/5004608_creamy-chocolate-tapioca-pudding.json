  "ingredients": [
    {
      "ingredient_id": 118,
      "name": "whole milk",
      "quantity": "5 cups"
    },
    {
      "ingredient_id": 1941,
      "name": "pearl tapioca, small",
      "quantity": "7 tbsp"
    },
    {
      "ingredient_id": 346,
      "name": "granulated sugar",
      "quantity": "2 tsp"
    },
    {
