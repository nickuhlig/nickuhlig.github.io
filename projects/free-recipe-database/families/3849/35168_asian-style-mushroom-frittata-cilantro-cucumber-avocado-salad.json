  "instructions": [
    {
      "id": 554186,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "0.68 kg cremini mushrooms\n2 (2 ½ cm) pieces ginger root\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 lime\n1 English cucumber\n2 avocados"
    },
    {
      "id": 554187,
      "primary_message": "Thinly slice mushrooms. Place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 554188,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 554189,
      "primary_message": "While the skillet heats up, peel and mince ginger and garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "4 cloves garlic"
    },
    {
      "id": 554190,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, ginger, garlic, salt, and pepper; cook, stirring occasionally, until mushrooms are tender, 6-7 minutes. (Reserve bowl for later use.)",
      "secondary_message": "2 tbsp neutral vegetable oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 554191,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 554192,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl along with eggs and chili-garlic sauce. Whisk to combine and set aside.",
      "secondary_message": "12 eggs\n4 tsp chili-garlic sauce"
    },
    {
      "id": 554193,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 554194,
      "primary_message": "When the mushrooms are tender, add green onions (reserving a small handful for serving), coconut aminos, and fish sauce to the skillet. Continue to cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "2 tbsp coconut aminos\n4 tsp fish sauce"
    },
    {
      "id": 554195,
      "primary_message": "Reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 3-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 554196,
      "primary_message": "Place skillet in the oven and broil until top is set, 3-4 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 554197,
      "primary_message": "Meanwhile, juice lime into a clean medium bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "4 tsp neutral vegetable oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 554198,
      "primary_message": "Trim and slice cucumber crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 554199,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 554200,
      "primary_message": "Cut frittata into wedges and divide between plates. Sprinkle with reserved green onions and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
