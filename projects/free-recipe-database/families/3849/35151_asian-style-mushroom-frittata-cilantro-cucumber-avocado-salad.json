  "instructions": [
    {
      "id": 553931,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb cremini mushrooms\n3 (1 inch) pieces ginger root\n1 small bunch cilantro\n1 small bunch green onions (scallions)\n1 ½ limes\n1 ½ English cucumbers\n3 avocados"
    },
    {
      "id": 553932,
      "primary_message": "Thinly slice mushrooms. Place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 553933,
      "primary_message": "Peel and mince ginger and garlic. Add both to the bowl with the mushrooms.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 553934,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 553935,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add mushrooms, ginger, garlic, salt, and pepper; cook, stirring occasionally, until mushrooms are tender, 7-8 minutes. (Reserve bowl for later use.)",
      "secondary_message": "3 tbsp neutral vegetable oil\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 553936,
      "primary_message": "Meanwhile, preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 553937,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Place in the reserved bowl along with eggs and chili-garlic sauce. Whisk to combine and set aside.",
      "secondary_message": "18 eggs\n2 tbsp chili-garlic sauce"
    },
    {
      "id": 553938,
      "primary_message": "Trim and cut green onions crosswise into thin pieces.",
      "secondary_message": null
    },
    {
      "id": 553939,
      "primary_message": "When the mushrooms are tender, add green onions (reserving a small handful for serving), soy sauce, fish sauce, and sugar to the skillet. Continue to cook, stirring occasionally, until fragrant, about 1 minute.",
      "secondary_message": "3 tbsp soy sauce\n2 tbsp fish sauce\n1 tbsp brown sugar"
    },
    {
      "id": 553940,
      "primary_message": "Reduce heat to medium-low; pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, 5-7 minutes.",
      "secondary_message": null
    },
    {
      "id": 553941,
      "primary_message": "Place skillet in the oven and broil until top is set, 4-5 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 553942,
      "primary_message": "Meanwhile, juice limes into a clean large bowl. Add oil, salt, and pepper, then whisk to combine the dressing.",
      "secondary_message": "2 tbsp neutral vegetable oil\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 553943,
      "primary_message": "Trim and slice cucumbers crosswise into thin rounds. Add to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 553944,
      "primary_message": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl and stir to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 553945,
      "primary_message": "Cut frittata into wedges and divide between plates. Sprinkle with reserved green onions and serve with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
