  "instructions": [
    {
      "id": 363414,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "1 ½ small pineapples\n1 small bunch cilantro\n1 ½ (5 oz) pkgs spring mix (mixed greens)"
    },
    {
      "id": 363415,
      "primary_message": "Cut off skin from each pineapple; quarter, core, and small dice the flesh. Place half in a medium saucepan. (Place the remaining pineapple in a large bowl and set aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 363416,
      "primary_message": "Small dice apricots and add to the pan with the pineapple.",
      "secondary_message": "12 dried apricots"
    },
    {
      "id": 363417,
      "primary_message": "Add water, vinegar, sugar, and spices to the pan. Stir to combine the chutney and bring to a simmer over medium-high heat. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, 8-10 minutes. Remove from heat.",
      "secondary_message": "⅓ cup water\n⅓ cup apple cider vinegar\n1 tbsp brown sugar\n1 ½ tsp curry powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363418,
      "primary_message": "Meanwhile, pat the chicken dry with paper towels and place on a cutting board. Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin cutlets. Season cutlets with salt and pepper on both sides.",
      "secondary_message": "2 ¼ lb chicken breasts, boneless skinless\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 363419,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 363420,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add chicken and pan-fry until cooked through, 3-4 minutes per side. Transfer to a plate. ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 363421,
      "primary_message": "While the chicken is cooking, add oil, vinegar, maple syrup, salt, and pepper to the bowl with the pineapple. Stir to combine the salad dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n2 tbsp apple cider vinegar\n1 tbsp pure maple syrup\n½ tsp salt\n3 pinch black pepper"
    },
    {
      "id": 363422,
      "primary_message": "Using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 363423,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": null
    },
    {
      "id": 363424,
      "primary_message": "Thinly slice chicken into strips.",
      "secondary_message": null
    },
    {
      "id": 363425,
      "primary_message": "Place tortillas on a flat surface; spread each with a layer of mayo and chutney. Top with chicken and a small portion of salad. Roll tightly to close. (Reserve remaining salad for serving.)",
      "secondary_message": "6 large flour tortillas\n3 tbsp mayonnaise"
    },
    {
      "id": 363426,
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
