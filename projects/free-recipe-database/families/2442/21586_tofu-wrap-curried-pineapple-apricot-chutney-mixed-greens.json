  "instructions": [
    {
      "id": 363427,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (12 oz) pkg extra firm tofu"
    },
    {
      "id": 363428,
      "primary_message": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)",
      "secondary_message": "½ small pineapple\n½ small bunch cilantro\n½ (5 oz) pkg spring mix (mixed greens)"
    },
    {
      "id": 363429,
      "primary_message": "Cut off skin from pineapple; quarter, core, and small dice the flesh. Place half in a small saucepan. (Place the remaining pineapple in a medium bowl and set aside for later use.)",
      "secondary_message": null
    },
    {
      "id": 363430,
      "primary_message": "Small dice apricots and add to the pan with the pineapple.",
      "secondary_message": "4 dried apricots"
    },
    {
      "id": 363431,
      "primary_message": "Add water, vinegar, sugar, and spices to the pan. Stir to combine the chutney and bring to a simmer over medium-high heat. Once simmering, reduce heat to low and cook, stirring occasionally, until thickened, about 8 minutes. Remove from heat.",
      "secondary_message": "2 tbsp water\n2 tbsp apple cider vinegar\n1 tsp brown sugar\n½ tsp curry powder\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 363432,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 363433,
      "primary_message": "While the skillet heats up, medium dice tofu and place in another medium bowl. Sprinkle with cornstarch, salt, and pepper; toss to coat.",
      "secondary_message": "1 tbsp cornstarch\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 363434,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and cook, turning every few minutes, until golden brown and crispy, about 10 minutes. Remove from heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 363435,
      "primary_message": "While the tofu is cooking, add oil, vinegar, maple syrup, salt, and pepper to the bowl with the pineapple. Stir to combine the salad dressing.",
      "secondary_message": "2 tsp extra virgin olive oil\n2 tsp apple cider vinegar\n1 tsp pure maple syrup\n⅛ tsp salt\n1 pinch black pepper"
    },
    {
      "id": 363436,
      "primary_message": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the dressing, along with the mixed greens, and toss to combine the salad. Set aside.",
      "secondary_message": null
    },
    {
      "id": 363437,
      "primary_message": "Warm tortillas in a skillet, oven, or microwave (optional).",
      "secondary_message": null
    },
    {
      "id": 363438,
      "primary_message": "Place tortillas on a flat surface; spread each with a layer of mayo and chutney. Top with tofu and a small portion of salad. Roll tightly to close. (Reserve remaining salad for serving.)",
      "secondary_message": "2 large flour tortillas\n1 tbsp mayonnaise"
    },
    {
      "id": 363439,
      "primary_message": "Cut wraps in half and divide between plates. Serve with remaining salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
