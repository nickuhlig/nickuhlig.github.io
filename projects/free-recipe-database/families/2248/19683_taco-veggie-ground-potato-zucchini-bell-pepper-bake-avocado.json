  "instructions": [
    {
      "id": 327511,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 327512,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 medium zucchini squash\n2 yellow bell peppers\n0.68 kg new potatoes\n1 avocado"
    },
    {
      "id": 327513,
      "primary_message": "Peel, halve, and medium dice onion; transfer to a large baking sheet pan.",
      "secondary_message": "1 medium yellow onion"
    },
    {
      "id": 327514,
      "primary_message": "Trim and medium dice zucchini; trim, seed, and medium dice bell peppers. Add both to the baking sheet with the onion.",
      "secondary_message": null
    },
    {
      "id": 327515,
      "primary_message": "Quarter potatoes and add to the baking sheet. Drizzle veggies with oil and sprinkle with taco seasoning; toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 tbsp taco seasoning"
    },
    {
      "id": 327516,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are tender 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 327517,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 327518,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n454 g veggie ground, plant based\n3 tbsp taco seasoning\n½ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 327519,
      "primary_message": "Add water to the skillet with the veggie ground; continue to cook, stirring occasionally, until sauce has thickened and veggie ground is cooked through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "½ cup water"
    },
    {
      "id": 327520,
      "primary_message": "Just before serving, halve and pit avocado; scoop out with a spoon and small dice the flesh.",
      "secondary_message": null
    },
    {
      "id": 327521,
      "primary_message": "To serve, divide roasted veggies between plates or bowls; top with veggie ground and avocado. Enjoy!",
      "secondary_message": null
    }
  ],
