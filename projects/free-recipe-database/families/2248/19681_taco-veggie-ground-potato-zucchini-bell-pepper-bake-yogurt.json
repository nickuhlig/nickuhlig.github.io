  "instructions": [
    {
      "id": 327490,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 327491,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 medium zucchini squash\n3 yellow bell peppers\n1.02 kg new potatoes"
    },
    {
      "id": 327492,
      "primary_message": "Peel, halve, and medium dice onions; divide between two baking sheet pans.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 327493,
      "primary_message": "Trim and medium dice zucchini; trim, seed, and medium dice bell peppers. Add both to the baking sheets with the onion.",
      "secondary_message": null
    },
    {
      "id": 327494,
      "primary_message": "Quarter potatoes and add to the baking sheets. Drizzle veggies with oil and sprinkle with taco seasoning; toss to combine and spread out in an even layer.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¼ cup taco seasoning"
    },
    {
      "id": 327495,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are tender about 25 minutes.",
      "secondary_message": null
    },
    {
      "id": 327496,
      "primary_message": "Meanwhile, preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 327497,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add veggie ground and spices. Cook, breaking it apart with a spoon, until almost cooked through, about 4 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n680 g veggie ground, plant based\n¼ cup taco seasoning\n¾ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 327498,
      "primary_message": "Add water to the skillet with the veggie ground; continue to cook, stirring occasionally, until sauce has thickened and veggie ground is cooked through, 3-4 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "¾ cup water"
    },
    {
      "id": 327499,
      "primary_message": "To serve, divide roasted veggies between plates or bowls; top with veggie ground and a dollop of yogurt. Enjoy!",
      "secondary_message": "1 ½ cups plain Greek yogurt"
    }
  ],
