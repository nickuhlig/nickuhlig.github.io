  "instructions": [
    {
      "id": 327440,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 327441,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 medium zucchini squash\n1 yellow bell pepper\n⅓ kg new potatoes"
    },
    {
      "id": 327442,
      "primary_message": "Peel, halve, and medium dice onion; transfer to a baking sheet pan.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 327443,
      "primary_message": "Trim and medium dice zucchini; trim, seed, and medium dice bell pepper. Add both to the baking sheet with the onion.",
      "secondary_message": null
    },
    {
      "id": 327444,
      "primary_message": "Quarter potatoes and add to the baking sheet. Drizzle veggies with oil and sprinkle with taco seasoning; toss to combine and spread out in an even layer.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 ½ tbsp taco seasoning"
    },
    {
      "id": 327445,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, tossing halfway through, until veggies are tender 20-25 minutes.",
      "secondary_message": null
    },
    {
      "id": 327446,
      "primary_message": "Meanwhile, preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 327447,
      "primary_message": "Once the skillet is hot, add beef and spices; cook, breaking the meat apart with a spoon, until almost cooked through, about 3 minutes.",
      "secondary_message": "⅓ kg lean ground beef\n1 ½ tbsp taco seasoning\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 327448,
      "primary_message": "Add water to the skillet with the beef; continue to cook, stirring occasionally, until sauce has thickened and beef is cooked through, 2-3 minutes more. Remove from heat and cover to keep warm.",
      "secondary_message": "¼ cup water"
    },
    {
      "id": 327449,
      "primary_message": "To serve, divide roasted veggies between plates or bowls; top with beef and a dollop yogurt. Enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
