  "instructions": [
    {
      "id": 100380,
      "primary_message": "Preheat oven to 450°F.",
      "secondary_message": null
    },
    {
      "id": 100381,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 eggplants\n3 English cucumbers\n6 tomatoes\n1 ½ small bunches Italian (flat-leaf) parsley\n1 ½ lemons"
    },
    {
      "id": 100382,
      "primary_message": "Large dice the eggplant. Transfer to two parchment lined sheet pans. Drizzle with oil and season with salt, pepper, and oregano; toss to coat. Bake for 20 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil\n¾ tsp salt\n½ tsp black pepper\n1 ½ tsp oregano"
    },
    {
      "id": 100383,
      "primary_message": "Use a grater to coarsely grate the cucumber. Transfer to a large bowl. Add the salt, stir, and let sit for 5 minutes.",
      "secondary_message": "¾ tsp salt"
    },
    {
      "id": 100384,
      "primary_message": "Peel and mince garlic.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 100385,
      "primary_message": "Peel and thinly slice onion into half rings. Add to a medium bowl along with the vinegar and salt. Toss to combine and set aside.",
      "secondary_message": "1 ½ medium red onions\n3 tbsp red wine vinegar\n⅜ tsp salt"
    },
    {
      "id": 100386,
      "primary_message": "Halve and thinly slice the tomato.",
      "secondary_message": null
    },
    {
      "id": 100387,
      "primary_message": "Shave leaves off the parsley stems; discard the stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 100388,
      "primary_message": "Gather the grated cucumber in the middle of a clean dish towel and gently squeeze out the water. Add the cucumber back to the medium bowl. Stir in the minced garlic, yogurt, salt, and dill. Juice the lemon and add to the mixture. Set aside.",
      "secondary_message": "1 ½ cups plain Greek yogurt\n1 ½ tsp salt\n⅜ tsp dill"
    },
    {
      "id": 100389,
      "primary_message": "To assemble, slice the pita bread into halves and open the pocket. Stuff with roasted eggplant, sliced tomato, onion, parsley, and cucumber sauce. Enjoy!",
      "secondary_message": "12 whole grain pitas"
    }
  ],
