  "instructions": [
    {
      "primary_message": "Heat a cast iron skillet or grill pan on your grill over direct heat and melt the Tillamook® unsalted extra creamy butter. \n",
      "secondary_message": null
    },
    {
      "primary_message": "In the meantime, mix your pesto and mayonnaise until the two sauces have completely combined. \n",
      "secondary_message": null
    },
    {
      "primary_message": "In a small bowl, lightly toss the basil and arugula with the vinegar, lemon juice, and flaky salt, being mindful not to crush or bruise the greens, and set aside.  \n",
      "secondary_message": null
    },
    {
      "primary_message": "Once the butter has melted, make two identical sandwiches by spreading the pesto mayo over one side of each of the slices of bread.  \n",
      "secondary_message": null
    },
    {
      "primary_message": "From there, starting with the bottom slice of bread with the pesto mayo facing up, stack a layer of tomatoes, Tillamook® Farmstyle whole milk mozzarella cheese, and greens.  \n",
      "secondary_message": null
    },
    {
      "primary_message": "Top with another slice of bread with pesto mayo facing down so the ingredients adhere to each other before cooking.  \n",
      "secondary_message": null
    },
    {
      "primary_message": "Repeat with the second sandwich.  \n",
      "secondary_message": null
    },
    {
      "primary_message": "Carefully place the sandwiches in the cast-iron pan and grill on either side for 3 minutes or until the cheese is completely melted. \n",
      "secondary_message": null
    },
    {
      "primary_message": "Remove from heat and allow to cool for 5 minutes.  \n",
      "secondary_message": null
    },
    {
      "primary_message": "Cut in half diagonally and serve. \n",
      "secondary_message": null
    }
  ],
