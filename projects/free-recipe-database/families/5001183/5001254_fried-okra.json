  "instructions": [
    {
      "id": 1,
      "primary_message": "For the Comeback Sauce: In a food processor, blend mayonnaise, onion, chili sauce, canola oil, ketchup, hot sauce, Worcestershire sauce, Dijon mustard, lemon juice, smoked paprika, freshly ground black pepper, salt, garlic powder, and onion powder until smooth, about 30 seconds. Transfer to a small bowl, cover, and refrigerate until ready to use.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "For the Fried Okra: In a large bowl, whisk buttermilk and hot sauce to combine. Add okra and toss to evenly coat.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fill a large Dutch oven with 4 cm of oil and heat oil over medium-high to 350ºF (175ºC).",
      "secondary_message": null
    },
    {
      "id": 4,
      "primary_message": "Meanwhile, in a shallow bowl, whisk cornmeal, flour, cornstarch, and Creole seasoning to combine. Working in batches, dredge okra in flour mixture, tossing and pressing gently to adhere. Shake off excess flour and transfer okra to a rimmed baking sheet, arranging them in a single layer.",
      "secondary_message": null
    },
    {
      "id": 5,
      "primary_message": "Line a separate 13- by 46-cm rimmed baking sheet with 2 layers of paper towels; set aside. Carefully add 1/3 of dredged okra to oil, and fry, using a spider skimmer or slotted spoon to gently stir to prevent sticking, until golden brown, about 3 minutes. Transfer okra to prepared baking sheet and sprinkle evenly with salt. Let oil return to 175°C (350°F) (175ºC), and repeat with remaining okra in two more batches. Serve with comeback sauce.",
      "secondary_message": null
    }
  ],
