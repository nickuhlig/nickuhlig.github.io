  "instructions": [
    {
      "id": 304595,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 limes\n6 baby bok choy\n2 red bell peppers\n0.45 kg cremini mushrooms\n1 small bunch cilantro"
    },
    {
      "id": 304596,
      "primary_message": "Peel, halve, and mince shallots; peel and mince garlic. Place both in a small bowl.",
      "secondary_message": "2 shallots\n2 cloves garlic"
    },
    {
      "id": 304597,
      "primary_message": "Juice limes into the bowl with the shallot and garlic; add coconut aminos and almond butter. Whisk to combine the sauce and set aside.",
      "secondary_message": "2 tbsp coconut aminos\n2 tbsp natural almond butter"
    },
    {
      "id": 304598,
      "primary_message": "Trim bok choy and cut crosswise into 1-inch strips; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 304599,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 304600,
      "primary_message": "Trim and thinly slice mushrooms; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 304601,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304602,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels, then slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "0.68 kg striploin (New York strip) steak\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 304603,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak strips and stir-fry until just cooked through, 3-4 minutes. Using tongs, transfer the steak to a plate and loosely cover with aluminum foil. (Reserve skillet with cooking juices for the next step.)",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 304604,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies to the skillet and stir-fry until fork-tender, 3-4 minutes.",
      "secondary_message": "4 tsp virgin coconut oil"
    },
    {
      "id": 304605,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 304606,
      "primary_message": "When the veggies are done, add sauce, steak (and any accumulated juices), and cilantro to the skillet; stir to combine. Continue to cook, stirring occasionally, until sauce thickens and steak is warmed through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 304607,
      "primary_message": "To serve, divide stir-fry and sauce between plates or bowls; top with almonds and enjoy!",
      "secondary_message": "¼ cup almonds, sliced"
    }
  ],
