  "instructions": [
    {
      "id": 304417,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lime\n3 baby bok choy\n1 red bell pepper\n½ lb cremini mushrooms\n½ small bunch cilantro"
    },
    {
      "id": 304418,
      "primary_message": "Peel, halve, and mince shallot; peel and mince garlic. Place both in a small bowl.",
      "secondary_message": "1 shallot\n1 clove garlic"
    },
    {
      "id": 304419,
      "primary_message": "Juice lime into the bowl with the shallot and garlic; add soy sauce, peanut butter, chili-garlic sauce, and brown sugar. Whisk to combine the sauce and set aside.",
      "secondary_message": "1 tbsp soy sauce\n1 tbsp natural peanut butter\n2 tsp chili-garlic sauce\n1 tsp brown sugar"
    },
    {
      "id": 304420,
      "primary_message": "Trim bok choy and cut crosswise into 1-inch strips; place in a medium bowl.",
      "secondary_message": null
    },
    {
      "id": 304421,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips; add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 304422,
      "primary_message": "Trim and thinly slice mushrooms; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 304423,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304424,
      "primary_message": "While the skillet heats up, pat steak dry with paper towels, then slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "¾ lb striploin (New York strip) steak\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 304425,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add steak strips and stir-fry until just cooked through, 3-4 minutes. Using tongs, transfer the steak to a plate and loosely cover with aluminum foil. (Reserve skillet with cooking juices for the next step.)",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 304426,
      "primary_message": "Return the skillet to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies to the skillet and stir-fry until fork-tender, 3-4 minutes.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 304427,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 304428,
      "primary_message": "Roughly chop peanuts.",
      "secondary_message": "⅛ cup peanuts, roasted unsalted"
    },
    {
      "id": 304429,
      "primary_message": "When the veggies are done, add sauce, steak (and any accumulated juices), and cilantro to the skillet; stir to combine. Continue to cook, stirring occasionally, until sauce thickens and steak is warmed through, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 304430,
      "primary_message": "To serve, divide stir-fry and sauce between plates or bowls; top with peanuts and enjoy!",
      "secondary_message": null
    }
  ],
