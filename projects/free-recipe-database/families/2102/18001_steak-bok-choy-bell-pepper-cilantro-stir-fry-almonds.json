  "instructions": [
    {
      "id": 304485,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 limes\n9 baby bok choy\n3 red bell peppers\n1 ½ lb cremini mushrooms\n1 small bunch cilantro"
    },
    {
      "id": 304486,
      "primary_message": "Peel, halve, and mince onion; peel and mince garlic. Place both in a small bowl.",
      "secondary_message": "½ medium red onion\n3 cloves garlic"
    },
    {
      "id": 304487,
      "primary_message": "Juice limes into the bowl with the onion and garlic; add coconut aminos and almond butter. Whisk to combine the sauce and set aside.",
      "secondary_message": "3 tbsp coconut aminos\n3 tbsp natural almond butter"
    },
    {
      "id": 304488,
      "primary_message": "Trim bok choy and cut crosswise into 1-inch strips; place in a large bowl.",
      "secondary_message": null
    },
    {
      "id": 304489,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; add to the bowl with the bok choy.",
      "secondary_message": null
    },
    {
      "id": 304490,
      "primary_message": "Trim and thinly slice mushrooms; add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 304491,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 304492,
      "primary_message": "While the pot heats up, pat steak dry with paper towels, then slice crosswise into thin strips. Season with salt and pepper.",
      "secondary_message": "2 ¼ lb striploin (New York strip) steak\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 304493,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add steak strips and stir-fry until just cooked through, 4-5 minutes. Using tongs, transfer the steak to a plate and loosely cover with aluminum foil. (Reserve pot with cooking juices for the next step.)",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 304494,
      "primary_message": "Return the pot to medium-high heat, add more oil, and swirl to coat the bottom. Add veggies to the pot and stir-fry until fork-tender, 4-5 minutes.",
      "secondary_message": "2 tbsp virgin coconut oil"
    },
    {
      "id": 304495,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves. ",
      "secondary_message": null
    },
    {
      "id": 304496,
      "primary_message": "When the veggies are done, add sauce, steak (and any accumulated juices), and cilantro to the pot; stir to combine. Continue to cook, stirring occasionally, until sauce thickens and steak is warmed through, 2-3 minutes.",
      "secondary_message": null
    },
    {
      "id": 304497,
      "primary_message": "To serve, divide stir-fry and sauce between plates or bowls; top with almonds and enjoy!",
      "secondary_message": "⅓ cup almonds, sliced"
    }
  ],
