  "instructions": [
    {
      "id": 27728,
      "primary_message": "Wash and dry the cilantro. Shave the leaves off the stems; discard the stems and mince the leaves. Transfer one half to a medium bowl and the other half to a large bowl.",
      "secondary_message": "½ small bunch cilantro"
    },
    {
      "id": 27729,
      "primary_message": "Grate zest from half of the lime. Add the lime zest and juice, olive oil, salt, and pepper to the medium bowl with the cilantro; mix together.",
      "secondary_message": "½ lime\n1 tbsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 27730,
      "primary_message": "Holding a knife parallel to the cutting board, cut the chicken in half horizontally to form thin fillets. Place in the marinade and turn to coat. Set aside for a few minutes.",
      "secondary_message": "0.34 kg chicken breasts, boneless skinless"
    },
    {
      "id": 27731,
      "primary_message": "Preheat a grill pan or skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 27732,
      "primary_message": "Wash the mango and bell pepper.",
      "secondary_message": "1 mango\n1 red bell pepper"
    },
    {
      "id": 27733,
      "primary_message": "Coat the grill/skillet with oil. Add the chicken and cook until browned and cooked through, 2-3 minutes per side. Transfer to a plate.",
      "secondary_message": "½ tbsp virgin coconut oil"
    },
    {
      "id": 27734,
      "primary_message": "Peel and julienne (or cut into thin sticks) the mango; add to the large bowl with the cilantro. Seed and julienne (or cut into thin sticks) the bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 27735,
      "primary_message": "Peel and mince or press the garlic. In a small bowl, prepare the dressing by whisking together the minced garlic, lime juice, soy sauce, rice vinegar, honey, water, and crushed red pepper.",
      "secondary_message": "1 clove garlic\n½ lime\n1 tbsp soy sauce\n1 tbsp rice vinegar\n1 tbsp honey\n1 tbsp water\n⅛ tsp crushed red pepper"
    },
    {
      "id": 27736,
      "primary_message": "Pour the dressing over top the salad and toss to combine.",
      "secondary_message": null
    },
    {
      "id": 27737,
      "primary_message": "Serve the grilled chicken with salad on the side. Enjoy!",
      "secondary_message": null
    }
  ],
