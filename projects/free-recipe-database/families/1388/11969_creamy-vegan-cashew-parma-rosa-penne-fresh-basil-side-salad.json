  "instructions": [
    {
      "id": 202169,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "2 tsp salt\n283 g penne pasta"
    },
    {
      "id": 202170,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 small pkg grape tomatoes\n1 English cucumber\n1 small pkg fresh basil\n2 heads butter (Boston) lettuce"
    },
    {
      "id": 202171,
      "primary_message": "Place cashews in a small bowl. Using a measuring cup, carefully remove 2 cups of boiling water from the pot and pour over the cashews; let sit for 15 minutes.",
      "secondary_message": "⅔ cup cashews, roasted unsalted"
    },
    {
      "id": 202172,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "¼ cup extra virgin olive oil\n2 tbsp red wine vinegar\n2 tsp brown sugar\n½ tsp salt\n¼ tsp garlic powder\n¼ tsp Italian seasoning\n¼ tsp black pepper"
    },
    {
      "id": 202173,
      "primary_message": "Halve tomatoes and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 202174,
      "primary_message": "Trim and halve cucumber, then thinly slice crosswise. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 202175,
      "primary_message": "Drain cashews and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 202176,
      "primary_message": "Add tomato sauce, broth, nutritional yeast, flour, and spices to the blender and purée until smooth.",
      "secondary_message": "2 (213 ml) cans tomato sauce\n237 ml chicken or vegetable broth\n¼ cup nutritional yeast flakes\n4 tsp all-purpose flour\n1 tsp salt\n1 tsp Italian seasoning\n½ tsp onion powder\n½ tsp garlic powder\n¼ tsp black pepper"
    },
    {
      "id": 202177,
      "primary_message": "Drain pasta, return to the pot, and set over medium heat. Add the sauce from the blender and stir to combine; cook, stirring occasionally, until warmed through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 202178,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 202179,
      "primary_message": "Chop or tear lettuce into bite-sized pieces and transfer to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 202180,
      "primary_message": "Divide pasta between plates and top with basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
