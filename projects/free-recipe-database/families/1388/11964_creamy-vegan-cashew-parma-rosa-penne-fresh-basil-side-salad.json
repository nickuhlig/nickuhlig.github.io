  "instructions": [
    {
      "id": 202109,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tbsp salt\n15 oz penne pasta"
    },
    {
      "id": 202110,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ pints grape tomatoes\n1 ½ English cucumbers\n1 small pkg fresh basil\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 202111,
      "primary_message": "Place cashews in a medium bowl. Using a measuring cup, carefully remove 2 cups of boiling water from the pot and pour over the cashews; let sit for 15 minutes.",
      "secondary_message": "1 cup cashews, roasted unsalted"
    },
    {
      "id": 202112,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, and spices in a large bowl; whisk to combine the dressing.",
      "secondary_message": "⅓ cup extra virgin olive oil\n3 tbsp red wine vinegar\n1 tbsp brown sugar\n¾ tsp salt\n½ tsp garlic powder\n½ tsp Italian seasoning\n½ tsp black pepper"
    },
    {
      "id": 202113,
      "primary_message": "Halve tomatoes and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 202114,
      "primary_message": "Trim and halve cucumbers, then thinly slice crosswise. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 202115,
      "primary_message": "Drain cashews and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 202116,
      "primary_message": "Add tomato sauce, broth, nutritional yeast, flour, and spices to the blender and purée until smooth. (If necessary, work in batches to fit your blender.)",
      "secondary_message": "3 (8 oz) cans tomato sauce\n12 fl oz (1 ½ cups) chicken or vegetable broth\n½ cup nutritional yeast flakes\n2 tbsp all-purpose flour\n1 ½ tsp salt\n1 ½ tsp Italian seasoning\n¾ tsp onion powder\n¾ tsp garlic powder\n½ tsp black pepper"
    },
    {
      "id": 202117,
      "primary_message": "Drain pasta, return to the pot, and set over medium heat. Add the sauce from the blender and stir to combine; cook, stirring occasionally, until warmed through, 4-5 minutes.",
      "secondary_message": null
    },
    {
      "id": 202118,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 202119,
      "primary_message": "Chop or tear lettuce into bite-sized pieces and transfer to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 202120,
      "primary_message": "Divide pasta between plates and top with basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
