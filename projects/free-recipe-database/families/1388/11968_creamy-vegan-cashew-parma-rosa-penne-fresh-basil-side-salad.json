  "instructions": [
    {
      "id": 202157,
      "primary_message": "Fill a medium saucepan halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes.",
      "secondary_message": "1 tsp salt\n142 g penne pasta"
    },
    {
      "id": 202158,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small pkg grape tomatoes\n½ English cucumber\n½ small pkg fresh basil\n1 head butter (Boston) lettuce"
    },
    {
      "id": 202159,
      "primary_message": "Place cashews in a small bowl. Using a measuring cup, carefully remove 1 cup of boiling water from the pot and pour over the cashews; let sit for 15 minutes.",
      "secondary_message": "⅓ cup cashews, roasted unsalted"
    },
    {
      "id": 202160,
      "primary_message": "Meanwhile, place oil, vinegar, sugar, and spices in a medium bowl; whisk to combine the dressing.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n1 tsp brown sugar\n¼ tsp salt\n⅛ tsp garlic powder\n⅛ tsp Italian seasoning\n⅛ tsp black pepper"
    },
    {
      "id": 202161,
      "primary_message": "Halve tomatoes and transfer to the bowl with the dressing.",
      "secondary_message": null
    },
    {
      "id": 202162,
      "primary_message": "Trim and halve cucumber, then thinly slice crosswise. Add to the bowl and set aside.",
      "secondary_message": null
    },
    {
      "id": 202163,
      "primary_message": "Drain cashews and place in a blender.",
      "secondary_message": null
    },
    {
      "id": 202164,
      "primary_message": "Add tomato sauce, broth, nutritional yeast, flour, and spices to the blender and purée until smooth.",
      "secondary_message": "1 (213 ml) can tomato sauce\n118 ml (½ cup) chicken or vegetable broth\n⅛ cup nutritional yeast flakes\n2 tsp all-purpose flour\n½ tsp salt\n½ tsp Italian seasoning\n¼ tsp onion powder\n¼ tsp garlic powder\n⅛ tsp black pepper"
    },
    {
      "id": 202165,
      "primary_message": "Drain pasta, return to the saucepan, and set over medium heat. Add the sauce from the blender and stir to combine; cook, stirring occasionally, until warmed through, 3-4 minutes.",
      "secondary_message": null
    },
    {
      "id": 202166,
      "primary_message": "Meanwhile, pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons.",
      "secondary_message": null
    },
    {
      "id": 202167,
      "primary_message": "Chop or tear lettuce into bite-sized pieces and transfer to the bowl with the dressing; toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 202168,
      "primary_message": "Divide pasta between plates and top with basil. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
