  "instructions": [
    {
      "id": 1,
      "primary_message": "To Make the Jalapeño Purée: Place jalapeños in an oven-safe dish lined with tinfoil and broil, turning at 5-minute intervals, until all sides are blackened and charred, 10 to 15 minutes. Let cool, then add to the jar of a blender. Blend until smooth.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "To Prepare the Glasses: On a small plate, combine salt and chili powder. Run a lime wedge around the rim of 6 tall beer or Collins glasses and coat edges with salt/chili mixture. Add a bacon swizzle stick to each glass. Fill glasses with ice.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "To Make the Cocktail: In a large pitcher, combine tomato juice, mezcal, lime juice, and jalapeño purée. Stir to combine and pour into individual glasses.",
      "secondary_message": null
    }
  ],
