  "instructions": [
    {
      "id": 298093,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add milk, sugar, cocoa powder, vanilla, and salt; set over medium heat and bring to a simmer, stirring frequently. ",
      "secondary_message": "½ cup jasmine rice\n237 ml whole milk\n3 tbsp brown sugar\n2 tbsp cocoa powder\n1 tsp vanilla extract\n1 pinch salt"
    },
    {
      "id": 298094,
      "primary_message": "Once the liquid comes to a simmer, cover the saucepan, and reduce heat to low. Cook rice, undisturbed, until liquid is fully absorbed, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 298095,
      "primary_message": "Meanwhile, wash and dry raspberries; place in another small saucepan.",
      "secondary_message": "1 (170 g) pkg raspberries"
    },
    {
      "id": 298096,
      "primary_message": "Wash, dry, zest, and juice lemon into the saucepan with the raspberries; add sugar and water. Stir to combine and cook over medium-low heat, stirring occasionally, until raspberries are soft and juicy, 3-4 minutes. ",
      "secondary_message": "½ lemon\n4 tsp brown sugar\n2 tbsp water"
    },
    {
      "id": 298097,
      "primary_message": "Once the raspberries are soft, crush with a fork or potato masher; continue to cook, stirring occasionally, until compote thickens, 3-4 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 298098,
      "primary_message": "Once the rice is done, remove from heat. Add cream, gently stir to combine, and let it stand, still covered, for 5 minutes.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream"
    },
    {
      "id": 298099,
      "primary_message": "Meanwhile, roughly chop pistachios. ",
      "secondary_message": "⅛ cup pistachios, unsalted"
    },
    {
      "id": 298100,
      "primary_message": "To serve, divide rice pudding between bowls; top with raspberry compote and pistachios. Enjoy! ",
      "secondary_message": null
    }
  ],
