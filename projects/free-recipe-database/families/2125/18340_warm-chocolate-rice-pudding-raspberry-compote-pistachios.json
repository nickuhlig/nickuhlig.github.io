  "instructions": [
    {
      "id": 298061,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add milk, sugar, cocoa powder, vanilla, and salt; set over medium heat and bring to a simmer, stirring frequently. ",
      "secondary_message": "1 ½ cups jasmine rice\n24 fl oz (3 cups) whole milk\n½ cup brown sugar\n⅓ cup cocoa powder\n1 tbsp vanilla extract\n3 pinch salt"
    },
    {
      "id": 298062,
      "primary_message": "Once the liquid comes to a simmer, cover the saucepan, and reduce heat to low. Cook rice, undisturbed, until liquid is fully absorbed, 15-18 minutes.",
      "secondary_message": null
    },
    {
      "id": 298063,
      "primary_message": "Meanwhile, wash and dry raspberries; place in another medium saucepan.",
      "secondary_message": "3 (6 oz) pkgs raspberries"
    },
    {
      "id": 298064,
      "primary_message": "Wash, dry, zest, and juice lemons into the saucepan with the raspberries; add sugar and water. Stir to combine and cook over medium-low heat, stirring occasionally, until raspberries are soft and juicy, 4-5 minutes. ",
      "secondary_message": "1 ½ lemons\n¼ cup brown sugar\n3 fl oz (⅜ cup) water"
    },
    {
      "id": 298065,
      "primary_message": "Once the raspberries are soft, crush with a fork or potato masher; continue to cook, stirring occasionally, until compote thickens, 4-5 minutes more. Remove from heat and cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 298066,
      "primary_message": "Once the rice is done, remove from heat. Add cream, gently stir to combine, and let it stand, still covered, for 5 minutes.",
      "secondary_message": "12 fl oz (1 ½ cups) heavy whipping cream"
    },
    {
      "id": 298067,
      "primary_message": "Meanwhile, roughly chop pistachios. ",
      "secondary_message": "⅓ cup pistachios, unsalted"
    },
    {
      "id": 298068,
      "primary_message": "To serve, divide rice pudding between bowls; top with raspberry compote and pistachios. Enjoy! ",
      "secondary_message": null
    }
  ],
