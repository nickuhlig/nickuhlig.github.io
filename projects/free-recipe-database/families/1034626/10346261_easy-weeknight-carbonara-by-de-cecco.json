  "instructions": [
    {
      "primary_message": "Fill a large pot with water and bring to a boil. Once boiling, add 2 tbsp of kosher salt. Let the water return to a boil and add De Cecco® spaghetti, stirring to combine. Cook according to package directions.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Preheat a large sauté pan over medium heat. Add bacon and cook until slightly crispy. Remove from heat leaving bacon in the pan.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Drain pasta, reserving 1/2-cup of the pasta water.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Add a 1/4-cup of pasta water slowly to eggs to temper. Stir in parmesan cheese.\n",
      "secondary_message": null
    },
    {
      "primary_message": "Return the bacon to medium heat. Add pasta and egg mixture, stirring until creamy. Add extra pasta water, 1 tbsp at a time if needed, to coat all the pasta. Season with remaining salt, ground pepper and red pepper flakes. Serve\n",
      "secondary_message": null
    }
  ],
