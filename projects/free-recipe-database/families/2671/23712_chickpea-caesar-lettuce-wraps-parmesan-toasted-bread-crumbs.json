  "instructions": [
    {
      "id": 424481,
      "primary_message": "Drain and rinse chickpeas; set aside to drain further.",
      "secondary_message": "3 (15 oz) cans garbanzo beans (chickpeas)"
    },
    {
      "id": 424482,
      "primary_message": "Place mayo, dressing, and spices in a large bowl. Stir to combine.",
      "secondary_message": "¾ cup mayonnaise\n⅓ cup Caesar dressing\n¾ tsp garlic powder\n¾ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 424483,
      "primary_message": "Add chickpeas to the bowl with the dressing. Mash with a fork or potato masher until combined and chickpeas are crushed, but still have some texture.",
      "secondary_message": null
    },
    {
      "id": 424484,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "3 sticks celery\n3 green bell peppers\n3 heads butter (Boston) lettuce"
    },
    {
      "id": 424485,
      "primary_message": "Trim and small dice celery. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 424486,
      "primary_message": "Trim, seed, and small dice bell peppers. Add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 424487,
      "primary_message": "Add Parmesan to the bowl and stir to combine the chickpea salad; set aside.",
      "secondary_message": "⅓ cup Parmesan cheese, shredded"
    },
    {
      "id": 424488,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 424489,
      "primary_message": "Once the skillet is hot, add bread crumbs and toast, stirring frequently, until golden brown, 3-4 minutes. Transfer toasted bread crumbs to a small bowl, then add additional garlic powder and salt; stir to combine.",
      "secondary_message": "¾ cup panko bread crumbs\n¾ tsp garlic powder\n½ tsp salt"
    },
    {
      "id": 424490,
      "primary_message": "Separate the lettuce into leaves. Pile leaves, in stacks of two per wrap, onto plates; fill with chickpea salad, then top with bread crumbs and additional Parmesan. Enjoy!",
      "secondary_message": "⅓ cup Parmesan cheese, shredded"
    }
  ],
