  "instructions": [
    {
      "id": 347912,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 small bunches cilantro\n1 small pkg fresh mint\n3 limes\n3 bunches kale\n3 red chili peppers\n3 yellow bell peppers\n1 ½ avocados"
    },
    {
      "id": 347913,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Divide herbs between two large bowls.",
      "secondary_message": null
    },
    {
      "id": 347914,
      "primary_message": "Add beef and spices to one of the bowls with the herbs (set the other bowl aside for the dressing); use your hands to combine the beef mixture. Using a scant tablespoon, form the mixture into mini meatballs and place on a large plate.",
      "secondary_message": "1.02 kg lean ground beef\n1 ½ tsp coriander, ground\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 347915,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347916,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; working in batches if necessary, add meatballs and cook, turning occasionally, until cooked through, about 5 minutes. Remove from heat.",
      "secondary_message": "2 tbsp toasted sesame oil"
    },
    {
      "id": 347917,
      "primary_message": "Meanwhile, peel and mince garlic; add to the second bowl with the herbs.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 347918,
      "primary_message": "Juice limes into the bowl, then add oil, fish sauce, sugar, soy sauce, and pepper; whisk to combine the dressing.",
      "secondary_message": "3 tbsp toasted sesame oil\n2 tbsp fish sauce\n2 tbsp brown sugar\n1 tbsp soy sauce\n¾ tsp black pepper"
    },
    {
      "id": 347919,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, about 2 minutes.",
      "secondary_message": null
    },
    {
      "id": 347920,
      "primary_message": "Halve chili peppers lengthwise; seed and remove ribs with a spoon. Thinly slice and add to the bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 347921,
      "primary_message": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 347922,
      "primary_message": "Peel, halve, and slice shallots into thin half-moons; add to the bowl.",
      "secondary_message": "2 shallots"
    },
    {
      "id": 347923,
      "primary_message": "Halve and pit avocados; scoop out with a spoon and medium dice the flesh. Add to the bowl and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 347924,
      "primary_message": "To serve, divide salad between plates or bowls; top with meatballs and enjoy!",
      "secondary_message": null
    }
  ],
