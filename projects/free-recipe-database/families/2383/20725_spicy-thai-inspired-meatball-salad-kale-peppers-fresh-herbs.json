  "instructions": [
    {
      "id": 347730,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ small bunch cilantro\n½ small pkg fresh mint\n1 lime\n1 bunch kale\n1 red chili pepper\n1 yellow bell pepper\n½ avocado"
    },
    {
      "id": 347731,
      "primary_message": "Shave cilantro leaves off the stems; pick mint leaves off the stems. Discard stems and mince the leaves. Divide herbs between two medium bowls.",
      "secondary_message": null
    },
    {
      "id": 347732,
      "primary_message": "Add beef and spices to one of the bowls with the herbs (set the other bowl aside for the dressing); use your hands to combine the beef mixture. Using a scant tablespoon, form the mixture into mini meatballs and place on a plate.",
      "secondary_message": "¾ lb lean ground beef\n½ tsp coriander, ground\n½ tsp turmeric, ground\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 347733,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 347734,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom; add meatballs and cook, turning occasionally, until cooked through, about 5 minutes. Remove from heat.",
      "secondary_message": "2 tsp toasted sesame oil"
    },
    {
      "id": 347735,
      "primary_message": "Meanwhile, peel and mince garlic; add to the second bowl with the herbs.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 347736,
      "primary_message": "Juice lime into the bowl, then add oil, fish sauce, sugar, soy sauce, and pepper; whisk to combine the dressing.",
      "secondary_message": "1 tbsp toasted sesame oil\n2 tsp fish sauce\n2 tsp brown sugar\n1 tsp soy sauce\n¼ tsp black pepper"
    },
    {
      "id": 347737,
      "primary_message": "Fold kale leaves in half lengthwise and slice off the stems; chop or tear leaves into bite-sized pieces and add to the bowl with the dressing. Using your hands, massage kale with the dressing until wilted, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 347738,
      "primary_message": "Halve chili pepper lengthwise; seed and remove ribs with a spoon. Thinly slice and add to the bowl. (Be careful with chilis; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 347739,
      "primary_message": "Trim, seed, and halve bell pepper crosswise, then slice into thin strips; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 347740,
      "primary_message": "Peel, halve, and slice shallot into thin half-moons; add to the bowl.",
      "secondary_message": "½ shallot"
    },
    {
      "id": 347741,
      "primary_message": "Halve and pit avocado; scoop out with a spoon and medium dice the flesh. Add to the bowl and gently toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 347742,
      "primary_message": "To serve, divide salad between plates or bowls; top with meatballs and enjoy!",
      "secondary_message": null
    }
  ],
