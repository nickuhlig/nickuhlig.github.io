  "instructions": [
    {
      "id": 318017,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n3 (1 inch) pieces ginger root\n3 orange bell peppers\n3 medium zucchini squash\n3 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 318018,
      "primary_message": "Halve potatoes, place in a large pot, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until potatoes are fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 318019,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; place both in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 318020,
      "primary_message": "Peel, halve, and medium dice onions; add to the bowl with the ginger and garlic.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 318021,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 318022,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 318023,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 318024,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 318025,
      "primary_message": "While the pot heats up, pat the chicken thighs dry with paper towels. Cut into bite-sized pieces.",
      "secondary_message": "3 lb chicken thighs, boneless skinless"
    },
    {
      "id": 318026,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and chicken; cook, stirring occasionally, until chicken is golden brown and almost cooked through, 8-10 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 318027,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 318028,
      "primary_message": "When the chicken is done, add half of the cilantro (reserving the rest for garnish), tomatoes, pine nuts, and spices to the pot; stir to combine. Continue to cook, stirring occasionally, until sauce thickens, 4-5 minutes more.",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n⅓ cup pine nuts\n1 ½ tsp coriander, ground\n1 ½ tsp turmeric, ground\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 318029,
      "primary_message": "When the potatoes are done, drain and add to the pot with the chicken; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 318030,
      "primary_message": "To serve, divide the chicken sauté between plates or bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
