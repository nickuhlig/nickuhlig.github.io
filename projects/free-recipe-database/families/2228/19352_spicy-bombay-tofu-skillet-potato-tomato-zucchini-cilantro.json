  "instructions": [
    {
      "id": 318118,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "1 (340 g) pkg extra firm tofu"
    },
    {
      "id": 318119,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "⅓ kg new potatoes\n1 (2 ½ cm) piece ginger root\n1 orange bell pepper\n1 medium zucchini squash\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 318120,
      "primary_message": "Halve potatoes, place in a medium saucepan, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until potatoes are fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 318121,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 318122,
      "primary_message": "Peel, halve, and medium dice onion; add to the bowl with the ginger and garlic.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 318123,
      "primary_message": "Trim, seed, and medium dice bell pepper; trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 318124,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 318125,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 318126,
      "primary_message": "While the skillet heats up, medium dice tofu. Place in another medium bowl, sprinkle with cornstarch, and gently toss to coat.",
      "secondary_message": "2 tsp cornstarch"
    },
    {
      "id": 318127,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add tofu and pan-fry, turning every few minutes, until browned and crispy, 5-7 minutes. Transfer tofu to a plate and return skillet to medium heat.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 318128,
      "primary_message": "Add more oil to the skillet and swirl to coat the bottom; add veggies and cook, stirring occasionally, until softened, 6-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 318129,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 318130,
      "primary_message": "When the veggies are done, add half of the cilantro (reserving the rest for garnish), tomatoes, pine nuts, and spices to the skillet; stir to combine. Cook, stirring occasionally, until sauce thickens, 3-4 minutes.",
      "secondary_message": "1 (398 ml) can diced tomatoes\n⅛ cup pine nuts\n½ tsp coriander, ground\n½ tsp turmeric, ground\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 318131,
      "primary_message": "When the potatoes are done, drain and add to the skillet along with the tofu; stir to combine and continue to cook until heated through, 3-4 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 318132,
      "primary_message": "To serve, divide the tofu skillet between plates or bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
