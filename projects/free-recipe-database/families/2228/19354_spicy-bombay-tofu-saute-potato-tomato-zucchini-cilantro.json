  "instructions": [
    {
      "id": 318148,
      "primary_message": "Cut tofu in half along the long side. Sandwich tofu between clean towels or paper towels and place on a baking sheet pan. Place a cutting board with something heavy on top and set aside to press out excess water.",
      "secondary_message": "3 (340 g) pkgs extra firm tofu"
    },
    {
      "id": 318149,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1.02 kg new potatoes\n3 (2 ½ cm) pieces ginger root\n3 orange bell peppers\n3 medium zucchini squash\n3 jalapeño peppers\n1 small bunch cilantro"
    },
    {
      "id": 318150,
      "primary_message": "Halve potatoes, place in a large pot, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until potatoes are fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 318151,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; place both in a large bowl.",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 318152,
      "primary_message": "Peel, halve, and medium dice onions; add to the bowl with the ginger and garlic.",
      "secondary_message": "1 ½ medium yellow onions"
    },
    {
      "id": 318153,
      "primary_message": "Trim, seed, and medium dice bell peppers; trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons. Add both to the bowl.",
      "secondary_message": null
    },
    {
      "id": 318154,
      "primary_message": "Halve jalapeño peppers lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 318155,
      "primary_message": "Medium dice tofu; place in another large bowl, sprinkle with cornstarch, and gently toss to coat.",
      "secondary_message": "2 tbsp cornstarch"
    },
    {
      "id": 318156,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 318157,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Working in batches if necessary, add tofu and pan-fry, turning every few minutes, until browned and crispy, 5-7 minutes. Transfer tofu to a plate and return pot to medium heat.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 318158,
      "primary_message": "Add more oil to the pot and swirl to coat the bottom; add veggies and cook, stirring occasionally, until softened, 8-10 minutes.",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 318159,
      "primary_message": "Meanwhile, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 318160,
      "primary_message": "When the veggies are done, add half of the cilantro (reserving the rest for garnish), tomatoes, pine nuts, and spices to the pot; stir to combine. Cook, stirring occasionally, until sauce thickens, 4-5 minutes.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n⅓ cup pine nuts\n1 ½ tsp coriander, ground\n1 ½ tsp turmeric, ground\n¾ tsp cumin, ground\n¾ tsp salt\n½ tsp crushed red pepper"
    },
    {
      "id": 318161,
      "primary_message": "When the potatoes are done, drain and add to the pot with the veggies along with the tofu; stir to combine and continue to cook until heated through, 4-5 minutes more. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 318162,
      "primary_message": "To serve, divide the tofu sauté between plates or bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
