  "instructions": [
    {
      "id": 317989,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "¾ lb new potatoes\n1 (1 inch) piece ginger root\n1 orange bell pepper\n1 medium zucchini squash\n1 jalapeño pepper\n½ small bunch cilantro"
    },
    {
      "id": 317990,
      "primary_message": "Halve potatoes, place in a medium saucepan, and cover with hot water (from the tap). Bring to a boil, reduce heat to low, and simmer until potatoes are fork-tender, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 317991,
      "primary_message": "Meanwhile, peel and mince ginger and garlic; place both in a medium bowl.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 317992,
      "primary_message": "Peel, halve, and medium dice onion; add to the bowl with the ginger and garlic. ",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 317993,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 317994,
      "primary_message": "Trim and halve zucchini lengthwise, then cut crosswise into ¼-inch thick half-moons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 317995,
      "primary_message": "Halve jalapeño pepper lengthwise; seed and remove ribs with a spoon. Small dice and add to the bowl. (Be careful with jalapeños; do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": null
    },
    {
      "id": 317996,
      "primary_message": "Preheat a large skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 317997,
      "primary_message": "While the skillet heats up, pat the chicken thighs dry with paper towels. Cut into bite-sized pieces.",
      "secondary_message": "1 lb chicken thighs, boneless skinless"
    },
    {
      "id": 317998,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and chicken; cook, stirring occasionally, until chicken is golden brown and almost cooked through, 6-7 minutes.",
      "secondary_message": "1 tbsp extra virgin olive oil"
    },
    {
      "id": 317999,
      "primary_message": "Meanwhile, using a clean cutting board, shave cilantro leaves off the stems; discard stems and mince the leaves.",
      "secondary_message": null
    },
    {
      "id": 318000,
      "primary_message": "When the chicken is done, add half of the cilantro (reserving the rest for garnish), tomatoes, pine nuts, and spices to the skillet; stir to combine. Continue to cook, stirring occasionally, until sauce thickens, 3-4 minutes more.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n⅛ cup pine nuts\n½ tsp coriander, ground\n½ tsp turmeric, ground\n¼ tsp cumin, ground\n¼ tsp salt\n⅛ tsp crushed red pepper"
    },
    {
      "id": 318001,
      "primary_message": "When the potatoes are done, drain and add to the skillet; stir to combine and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 318002,
      "primary_message": "To serve, divide the chicken skillet between plates or bowls and top with reserved cilantro. Enjoy!",
      "secondary_message": null
    }
  ],
