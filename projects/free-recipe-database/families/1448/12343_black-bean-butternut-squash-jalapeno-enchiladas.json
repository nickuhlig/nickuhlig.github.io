  "instructions": [
    {
      "id": 207544,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 207545,
      "primary_message": "Wash, dry, and peel the butternut squash; halve and remove seeds with a spoon. Small dice squash and place in a medium bowl; set aside.",
      "secondary_message": "½ small butternut squash"
    },
    {
      "id": 207546,
      "primary_message": "Peel and small dice onion; peel and mince garlic. Add both to the bowl with the squash.",
      "secondary_message": "½ medium yellow onion\n2 cloves garlic"
    },
    {
      "id": 207547,
      "primary_message": "Wash, dry, and quarter jalapeño lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": "1 jalapeño pepper"
    },
    {
      "id": 207548,
      "primary_message": "Preheat a large skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 207549,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add veggies and spices to the skillet; cook, stirring occasionally, until squash is fork-tender, about 6 minutes.",
      "secondary_message": "2 tsp extra virgin olive oil\n1 ½ tsp chili powder\n½ tsp salt\n¼ tsp garlic powder\n¼ tsp onion powder\n¼ tsp cayenne pepper\n¼ tsp cumin"
    },
    {
      "id": 207550,
      "primary_message": "Meanwhile, measure oil into a small saucepan and place over medium-high heat. Once the oil is hot, whisk in the flour; continuing to whisk, cook the flour until lightly golden, about 1 minute.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tbsp all-purpose flour"
    },
    {
      "id": 207551,
      "primary_message": "Slowly whisk in tomato sauce, broth, and spices. Bring to a boil, then reduce heat and simmer until thickened, 4-5 minutes. Remove enchilada sauce from heat and set aside.",
      "secondary_message": "1 (213 ml) can tomato sauce\n177 ml chicken or vegetable broth\n1 tbsp chili powder\n½ tsp garlic powder\n½ tsp onion powder\n½ tsp cumin\n½ tsp salt\n¼ tsp oregano"
    },
    {
      "id": 207552,
      "primary_message": "Meanwhile, drain and rinse beans. Grate mozzarella.",
      "secondary_message": "½ (398 ml) can black beans\n½ (227 g) block mozzarella cheese"
    },
    {
      "id": 207553,
      "primary_message": "Add beans, half the cheese (reserving the rest for later), and yogurt to the skillet with the veggies. Stir to combine and remove from heat.",
      "secondary_message": "¼ cup plain Greek yogurt"
    },
    {
      "id": 207554,
      "primary_message": "Spread a thin layer of the enchilada sauce over the bottom of a small baking dish; set remaining sauce aside.",
      "secondary_message": null
    },
    {
      "id": 207555,
      "primary_message": "Place tortillas on a flat surface and divide vegetable mixture evenly between them; roll up and place, seam-side down, in the baking dish. Top with remaining sauce and cheese.",
      "secondary_message": "4 small flour tortillas"
    },
    {
      "id": 207556,
      "primary_message": "Place enchiladas in the oven and bake until the cheese is melted, 5-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 207557,
      "primary_message": "To serve, divide enchiladas between plates and enjoy!",
      "secondary_message": null
    }
  ],
