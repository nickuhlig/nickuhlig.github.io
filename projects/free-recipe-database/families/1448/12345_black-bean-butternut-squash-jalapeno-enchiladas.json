  "instructions": [
    {
      "id": 207572,
      "primary_message": "Preheat oven to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 207573,
      "primary_message": "Wash, dry, and peel each butternut squash; halve and remove seeds with a spoon. Small dice squash and place in a large bowl; set aside.",
      "secondary_message": "1 ½ small butternut squash"
    },
    {
      "id": 207574,
      "primary_message": "Peel and small dice onions; peel and mince garlic. Add both to the bowl with the squash.",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 207575,
      "primary_message": "Wash, dry, and quarter jalapeños lengthwise; seed and remove ribs with a spoon. Finely dice and add to the bowl. (Be careful, with jalapeños, do not touch your eyes and ensure you wash your hands after handling or wear gloves while preparing.)",
      "secondary_message": "3 jalapeño peppers"
    },
    {
      "id": 207576,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 207577,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices to the pot; cook, stirring occasionally, until squash is fork-tender, 8-10 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n1 ½ tbsp chili powder\n1 ½ tsp salt\n¾ tsp garlic powder\n¾ tsp onion powder\n¾ tsp cayenne pepper\n¾ tsp cumin"
    },
    {
      "id": 207578,
      "primary_message": "Meanwhile, measure oil into a medium saucepan and place over medium-high heat. Once the oil is hot, whisk in the flour; continuing to whisk, cook the flour until lightly golden, about 1 minute.",
      "secondary_message": "3 tbsp extra virgin olive oil\n3 tbsp all-purpose flour"
    },
    {
      "id": 207579,
      "primary_message": "Slowly whisk in tomato sauce, broth, and spices. Bring to a boil, then reduce heat and simmer until thickened, 5-6 minutes. Remove enchilada sauce from heat and set aside.",
      "secondary_message": "3 (213 ml) cans tomato sauce\n532 ml chicken or vegetable broth\n3 tbsp chili powder\n1 ½ tsp garlic powder\n1 ½ tsp onion powder\n1 ½ tsp cumin\n1 ½ tsp salt\n¾ tsp oregano"
    },
    {
      "id": 207580,
      "primary_message": "Meanwhile, drain and rinse beans. Grate mozzarella.",
      "secondary_message": "2 (398 ml) cans black beans\n1 (227 g) block mozzarella cheese"
    },
    {
      "id": 207581,
      "primary_message": "Add beans, half the cheese (reserving the rest for later), and yogurt to the pot with the veggies. Stir to combine and remove from heat.",
      "secondary_message": "¾ cup plain Greek yogurt"
    },
    {
      "id": 207582,
      "primary_message": "Spread a thin layer of the enchilada sauce over the bottom of a large baking dish; set remaining sauce aside.",
      "secondary_message": null
    },
    {
      "id": 207583,
      "primary_message": "Place tortillas on a flat surface and divide vegetable mixture evenly between them; roll up and place, seam-side down, in the baking dish. Top with remaining sauce and cheese.",
      "secondary_message": "12 small flour tortillas"
    },
    {
      "id": 207584,
      "primary_message": "Place enchiladas in the oven and bake until the cheese is melted, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 207585,
      "primary_message": "To serve, divide enchiladas between plates and enjoy!",
      "secondary_message": null
    }
  ],
