  "instructions": [
    {
      "id": 230526,
      "primary_message": "Place milk and dates in a large pot and bring to a boil over medium-high heat. (Watch the milk carefully, so it does not boil over.) Remove from heat and allow to cool slightly, about 5 minutes.",
      "secondary_message": "48 fl oz (6 cups) whole milk\n1 cup medjool dates, pitted"
    },
    {
      "id": 230527,
      "primary_message": "Working in batches to best fit your blender, transfer cooled date-milk to the blender. Add cocoa powder, almond butter, cinnamon, and salt; blend on high until very smooth, about 2 minutes.",
      "secondary_message": "¼ cup cocoa powder\n¼ cup natural almond butter\n¼ tsp cinnamon, ground\n⅛ tsp salt"
    },
    {
      "id": 230528,
      "primary_message": "Return hot chocolate mixture to the pot and reheat over medium-high heat to preferred temperature.",
      "secondary_message": null
    },
    {
      "id": 230529,
      "primary_message": "To serve, divide hot chocolate between mugs and enjoy!",
      "secondary_message": null
    }
