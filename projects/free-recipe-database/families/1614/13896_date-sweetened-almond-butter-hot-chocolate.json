  "instructions": [
    {
      "id": 230566,
      "primary_message": "Place milk and dates in a large pot and bring to a boil over medium-high heat. (Watch the milk carefully, so it does not boil over.) Remove from heat and allow to cool slightly, about 8 minutes.",
      "secondary_message": "2129 ml whole milk\n1 ½ cups medjool dates, pitted"
    },
    {
      "id": 230567,
      "primary_message": "Working in batches to best fit your blender, transfer cooled date-milk to the blender. Add cocoa powder, almond butter, cinnamon, and salt; blend on high until very smooth, about 2 minutes.",
      "secondary_message": "⅓ cup cocoa powder\n⅓ cup natural almond butter\n½ tsp cinnamon, ground\n3 pinch salt"
    },
    {
      "id": 230568,
      "primary_message": "Return hot chocolate mixture to the pot and reheat over medium-high heat to preferred temperature.",
      "secondary_message": null
    },
    {
      "id": 230569,
      "primary_message": "To serve, divide hot chocolate between mugs and enjoy!",
      "secondary_message": null
    }
