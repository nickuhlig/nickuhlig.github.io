  "instructions": [
    {
      "id": 361903,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 361904,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ (454 g) pkg strawberries\n1 peach\n½ small pkg fresh basil\n0.23 kg red grapes"
    },
    {
      "id": 361905,
      "primary_message": "Juice lemon into another medium bowl. Add sugar and stir to combine.",
      "secondary_message": "2 tsp granulated sugar"
    },
    {
      "id": 361906,
      "primary_message": "Trim and halve strawberries; add to the bowl with the lemon and sugar.",
      "secondary_message": null
    },
    {
      "id": 361907,
      "primary_message": "Quarter peach lengthwise (around the pit); twist quarters to separate, then remove and discard pit. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361908,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361909,
      "primary_message": "Add grapes to the bowl and stir to combine the fruit salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 361910,
      "primary_message": "Remove bowl from the freezer. Pour cold cream, sugar, and vanilla into the bowl.",
      "secondary_message": "118 ml (½ cup) heavy whipping cream\n1 tsp granulated sugar\n¼ tsp vanilla extract"
    },
    {
      "id": 361911,
      "primary_message": "Use a whisk to beat the cream vigorously, until medium-soft peaks form, about 2 minutes. (For medium-soft peaks, when you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 361912,
      "primary_message": "To serve, divide fruit salad between bowls and top with whipped cream. Enjoy!",
      "secondary_message": null
    }
  ],
