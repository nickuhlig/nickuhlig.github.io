  "instructions": [
    {
      "id": 361862,
      "primary_message": "Place a medium bowl (preferably metal) in the freezer to chill. (If space is limited, place in the refrigerator.)",
      "secondary_message": null
    },
    {
      "id": 361863,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 lemon\n1 (16 oz) pkg strawberries\n2 peaches\n½ small pkg fresh basil\n1 lb red grapes"
    },
    {
      "id": 361864,
      "primary_message": "Juice lemon into another medium bowl. Add sugar and stir to combine.",
      "secondary_message": "4 tsp granulated sugar"
    },
    {
      "id": 361865,
      "primary_message": "Trim and halve strawberries; add to the bowl with the lemon and sugar.",
      "secondary_message": null
    },
    {
      "id": 361866,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361867,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361868,
      "primary_message": "Add grapes to the bowl and stir to combine the fruit salad; set aside.",
      "secondary_message": null
    },
    {
      "id": 361869,
      "primary_message": "Remove bowl from the freezer. Pour cold cream, sugar, and vanilla into the bowl.",
      "secondary_message": "8 fl oz (1 cup) heavy whipping cream\n2 tsp granulated sugar\n½ tsp vanilla extract"
    },
    {
      "id": 361870,
      "primary_message": "Use a whisk (or hand blender) to beat the cream vigorously, until medium-soft peaks form, about 3 minutes if whisking. (When you pull the whisk out of the bowl, the cream should hold its shape, with a peak that curls over slightly.)",
      "secondary_message": null
    },
    {
      "id": 361871,
      "primary_message": "To serve, divide fruit salad between bowls and top with whipped cream. Enjoy!",
      "secondary_message": null
    }
  ],
