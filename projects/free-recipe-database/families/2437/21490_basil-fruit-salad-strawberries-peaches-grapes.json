  "instructions": [
    {
      "id": 361882,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "½ lemon\n½ (16 oz) pkg strawberries\n2 peaches\n½ small pkg fresh basil\n½ lb red grapes"
    },
    {
      "id": 361883,
      "primary_message": "Juice lemon into a medium bowl. Add sugar and stir to combine.",
      "secondary_message": "1 tbsp granulated sugar"
    },
    {
      "id": 361884,
      "primary_message": "Trim and halve strawberries; add to the bowl with the lemon and sugar.",
      "secondary_message": null
    },
    {
      "id": 361885,
      "primary_message": "Quarter peaches lengthwise (around the pit); twist quarters to separate, then remove and discard the pits. Medium dice the flesh and add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361886,
      "primary_message": "Pick basil leaves off the stems, roll up crosswise, and thinly slice into ribbons; add to the bowl.",
      "secondary_message": null
    },
    {
      "id": 361887,
      "primary_message": "Add grapes to the bowl and stir to combine the fruit salad.",
      "secondary_message": null
    },
    {
      "id": 361888,
      "primary_message": "To serve, divide fruit salad between bowls and enjoy!",
      "secondary_message": null
    }
  ],
