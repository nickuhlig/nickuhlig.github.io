  "instructions": [
    {
      "id": 61188,
      "primary_message": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. Drain, reserving ½ cup pasta water, and return to pot.",
      "secondary_message": "about 21 cups water\n3 tbsp salt\n18 oz (6 ¾ cups) penne pasta"
    },
    {
      "id": 61187,
      "primary_message": "Heat a skillet over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 61186,
      "primary_message": "In a small bowl, mix together basil, oregano, salt, and pepper.",
      "secondary_message": "⅜ tsp basil\n⅜ tsp oregano\n3 pinches salt\n3 pinches black pepper"
    },
    {
      "id": 61185,
      "primary_message": "Slice chicken in half horizontally to form thin fillets. Sprinkle with spices.",
      "secondary_message": "1 ½ lb chicken breasts, boneless skinless"
    },
    {
      "id": 61184,
      "primary_message": "Coat bottom of skillet with oil. Add chicken and cook until cooked through, 2-3 minutes per side.",
      "secondary_message": "about 3 tbsp virgin coconut oil"
    },
    {
      "id": 61183,
      "primary_message": "Wash and dry spinach.",
      "secondary_message": "1 ½ (5 oz) pkg baby spinach"
    },
    {
      "id": 61179,
      "primary_message": "Thinly slice sun-dried tomatoes. Measure out olives.",
      "secondary_message": "18 sun-dried tomatoes, oil-packed\n¾ cup Kalamata olives, pitted"
    },
    {
      "id": 61182,
      "primary_message": "One pasta has been drained, add tomatoes, olives, spinach, and reserved pasta water to pot. Toss until spinach is wilted.",
      "secondary_message": ""
    },
    {
      "id": 61181,
      "primary_message": "Slice chicken into strips.",
      "secondary_message": ""
    },
    {
      "id": 61180,
      "primary_message": "To serve, place pasta in a bowl, add chicken slices, and crumble goat cheese over top. Enjoy!",
      "secondary_message": "1 ½ (4 oz) log goat cheese"
    }
  ],
