  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Thinly slice the red onion. Slice the celery thinly on the bias. Core and thinly slice the fennel. Pick the parsley leaves from the stems and roughly chop them. Drain the brined capers. Drain and quarter the pitted briny black olives lengthwise. Juice the lemon.",
      "secondary_message": "½ medium red onion\n1 stalk celery\n¼ medium bulb fennel\n1 handful flat-leaf parsley leaves\n2 tbsp brined capers\n¼ cup pitted briny black olives\n1 lemon"
    },
    {
      "id": 1,
      "primary_message": "In a small bowl, combine onion and vinegar (vinegar should just cover onion; add more if it does not) and let stand 15 minutes.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Meanwhile, in a medium bowl, combine tuna with celery, fennel, parsley, capers, olives, olive oil, lemon juice, and fish sauce or anchovy. Drain onion well, then add to bowl. Mix gently until thoroughly combined; season with salt and pepper. Dress with more olive oil if desired.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Spoon tuna salad onto 4 slices of toast, top with arugula, then close sandwiches and serve.",
      "secondary_message": null
    }
  ],
