  "instructions": [
    {
      "id": 383269,
      "primary_message": "Preheat oven to 260°C (500°F).",
      "secondary_message": null
    },
    {
      "id": 383270,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 red bell peppers\n3 orange bell peppers\n3 lemons\n1 ½ (142 g) pkg baby arugula\n1 small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 383271,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Divide between two large baking sheet pans, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 383272,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until peppers are charred in spots, 15-20 minutes. ",
      "secondary_message": null
    },
    {
      "id": 383273,
      "primary_message": "Meanwhile, halve olives lengthwise. Place in a small bowl along with capers and vinegar; stir to combine and set aside until the peppers are ready.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n3 tbsp capers\n1 tbsp red wine vinegar"
    },
    {
      "id": 383274,
      "primary_message": "When the peppers are charred, remove from oven. Reduce temperature to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 383275,
      "primary_message": "Spoon olive mixture over the peppers and stir to combine; spread back out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 383276,
      "primary_message": "Pat the cod dry with paper towels and arrange on top of the peppers. Drizzle with additional oil, then season with salt and pepper.",
      "secondary_message": "1.02 kg cod fillet\n2 tbsp extra virgin olive oil\n¾ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 383277,
      "primary_message": "Return baking sheets to the oven and bake until fish flakes easily with a fork, 10-12 minutes.",
      "secondary_message": null
    },
    {
      "id": 383278,
      "primary_message": "Meanwhile, juice half of the lemons into a large bowl. Cut remaining lemons into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 383279,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon juice along with additional oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n3 tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 383280,
      "primary_message": "Add arugula and pine nuts to the bowl with the dressing, then toss to combine. Set aside.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 383281,
      "primary_message": "Using a peeler, shave the Parmesan into curls. Set aside.",
      "secondary_message": "128 g Parmesan cheese"
    },
    {
      "id": 383282,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. When the fish is done, remove from oven and top with parsley.",
      "secondary_message": null
    },
    {
      "id": 383283,
      "primary_message": "Divide peppers, fish, and salad between plates. Top the salad with Parmesan and serve with lemon wedges for squeezing over the fish. Enjoy!",
      "secondary_message": null
    }
  ],
