  "instructions": [
    {
      "id": 383312,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 383313,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "3 red bell peppers\n3 orange bell peppers\n3 lemons\n3 (142 g) pkg baby arugula"
    },
    {
      "id": 383314,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Divide between two large baking sheet pans, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tbsp extra virgin olive oil\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 383315,
      "primary_message": "Place baking sheets in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until peppers are tender and charred in spots, about 20 minutes.",
      "secondary_message": null
    },
    {
      "id": 383316,
      "primary_message": "Meanwhile, juice the lemons into a large bowl. ",
      "secondary_message": null
    },
    {
      "id": 383317,
      "primary_message": "Peel and mince shallots. Add to the bowl with the lemon juice along with oil, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "2 shallots\n⅓ cup extra virgin olive oil\n2 tbsp red wine vinegar\n¾ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 383318,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 383319,
      "primary_message": "Halve olives lengthwise. Add to the bowl, along with the capers, and set aside.",
      "secondary_message": "¾ cup Kalamata olives, pitted\n3 tbsp capers"
    },
    {
      "id": 383320,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 383321,
      "primary_message": "Once the skillet is hot, add pine nuts. Cook, stirring constantly, until golden brown, about 5 minutes. Add to the bowl.",
      "secondary_message": "¾ cup pine nuts"
    },
    {
      "id": 383322,
      "primary_message": "When the peppers are done, remove from the oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 383323,
      "primary_message": "Using a peeler, shave the Parmesan into curls. ",
      "secondary_message": "128 g Parmesan cheese"
    },
    {
      "id": 383324,
      "primary_message": "Add cooled peppers and arugula to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 383325,
      "primary_message": "To serve, divide salad between plates or bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
