  "instructions": [
    {
      "id": 383284,
      "primary_message": "Preheat oven to 230°C (450°F).",
      "secondary_message": null
    },
    {
      "id": 383285,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 red bell pepper\n1 orange bell pepper\n1 lemon\n1 (142 g) pkg baby arugula"
    },
    {
      "id": 383286,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 383287,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until peppers are tender and charred in spots, 18-20 minutes.",
      "secondary_message": null
    },
    {
      "id": 383288,
      "primary_message": "Meanwhile, juice the lemon into a medium bowl. ",
      "secondary_message": null
    },
    {
      "id": 383289,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon juice along with oil, vinegar, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "1 shallot\n2 tbsp extra virgin olive oil\n2 tsp red wine vinegar\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 383290,
      "primary_message": "Drain and rinse beans. Add to the bowl with the dressing.",
      "secondary_message": "1 (398 ml) can cannellini (white kidney) beans"
    },
    {
      "id": 383291,
      "primary_message": "Halve olives lengthwise. Add to the bowl, along with the capers, and set aside.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 tbsp capers"
    },
    {
      "id": 383292,
      "primary_message": "Preheat a skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 383293,
      "primary_message": "Once the skillet is hot, add pine nuts. Cook, stirring constantly, until golden brown, 3-5 minutes. Add to the bowl.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 383294,
      "primary_message": "When the peppers are done, remove from the oven and set aside to cool, 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 383295,
      "primary_message": "Using a peeler, shave the Parmesan into curls. ",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 383296,
      "primary_message": "Add cooled peppers and arugula to the bowl, then toss to combine the salad.",
      "secondary_message": null
    },
    {
      "id": 383297,
      "primary_message": "To serve, divide salad between plates or bowls and top with Parmesan. Enjoy!",
      "secondary_message": null
    }
  ],
