  "instructions": [
    {
      "id": 383239,
      "primary_message": "Preheat oven to 260°C (500°F).",
      "secondary_message": null
    },
    {
      "id": 383240,
      "primary_message": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)",
      "secondary_message": "1 red bell pepper\n1 orange bell pepper\n1 lemon\n½ (142 g) pkg baby arugula\n½ small bunch Italian (flat-leaf) parsley"
    },
    {
      "id": 383241,
      "primary_message": "Trim, seed, and slice bell peppers lengthwise into thin strips. Transfer to a baking sheet pan, drizzle with oil, then season with salt and pepper. Toss to combine and spread out in an even layer.",
      "secondary_message": "2 tsp extra virgin olive oil\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 383242,
      "primary_message": "Place baking sheet in the oven (it doesn't have to be fully heated) and roast, stirring halfway through, until peppers are charred in spots, 10-15 minutes.",
      "secondary_message": null
    },
    {
      "id": 383243,
      "primary_message": "Meanwhile, halve olives lengthwise. Place in a small bowl along with capers and vinegar; stir to combine and set aside until the peppers are ready.",
      "secondary_message": "¼ cup Kalamata olives, pitted\n1 tbsp capers\n1 tsp red wine vinegar"
    },
    {
      "id": 383244,
      "primary_message": "When the peppers are charred, remove from oven. Reduce temperature to 205°C (400°F).",
      "secondary_message": null
    },
    {
      "id": 383245,
      "primary_message": "Spoon olive mixture over the peppers and stir to combine; spread back out in an even layer.",
      "secondary_message": null
    },
    {
      "id": 383246,
      "primary_message": "Pat the cod dry with paper towels and arrange on top of the peppers. Drizzle with additional oil, then season with salt and pepper.",
      "secondary_message": "⅓ kg cod fillet\n2 tsp extra virgin olive oil\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 383247,
      "primary_message": "Return baking sheet to the oven and bake until fish flakes easily with a fork, 8-10 minutes.",
      "secondary_message": null
    },
    {
      "id": 383248,
      "primary_message": "Meanwhile, juice half of the lemon into a medium bowl. Cut remaining lemon into wedges and set aside for serving.",
      "secondary_message": null
    },
    {
      "id": 383249,
      "primary_message": "Peel and mince shallot. Add to the bowl with the lemon juice along with additional oil, salt, and pepper. Whisk to combine the dressing.",
      "secondary_message": "½ shallot\n1 tbsp extra virgin olive oil\n⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 383250,
      "primary_message": "Add arugula and pine nuts to the bowl with the dressing, then toss to combine. Set aside.",
      "secondary_message": "¼ cup pine nuts"
    },
    {
      "id": 383251,
      "primary_message": "Using a peeler, shave the Parmesan into curls. Set aside.",
      "secondary_message": "43 g Parmesan cheese"
    },
    {
      "id": 383252,
      "primary_message": "Shave parsley leaves off the stems; discard stems and roughly chop the leaves. When the fish is done, remove from oven and top with parsley.",
      "secondary_message": null
    },
    {
      "id": 383253,
      "primary_message": "Divide peppers, fish, and salad between plates. Top the salad with Parmesan and serve with lemon wedges for squeezing over the fish. Enjoy!",
      "secondary_message": null
    }
  ],
