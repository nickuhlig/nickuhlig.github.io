  "instructions": [
    {
      "id": 451374,
      "primary_message": "Fill a large pot halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes. (Reserve a ¼-cup of cooking water before draining.) Return pasta and reserved cooking water to the pot.",
      "secondary_message": "½ tsp salt\n142 g fettuccine pasta"
    },
    {
      "id": 451375,
      "primary_message": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Set aside.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 451376,
      "primary_message": "Wash, dry, and juice lemon into a small bowl.",
      "secondary_message": "½ lemon"
    },
    {
      "id": 451377,
      "primary_message": "Peel and mince garlic. Add to the bowl with the lemon juice.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 451378,
      "primary_message": "Roughly chop olives and sun-dried tomatoes. Add both to the bowl.",
      "secondary_message": "½ cup Kalamata olives, pitted\n6 sun-dried tomatoes, oil-packed"
    },
    {
      "id": 451379,
      "primary_message": "Finely grate Parmesan. Add to the bowl along with pine nuts, oil, and spices; stir to combine the pasta seasoning.",
      "secondary_message": "43 g Parmesan cheese\n¼ cup pine nuts\n1 tbsp extra virgin olive oil\n¼ tsp crushed red pepper\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 451380,
      "primary_message": "When the pasta is done, add pasta seasoning to the pot. Set over medium heat and cook, stirring often, until warmed through and sauce coats pasta, 1-2 minutes.",
      "secondary_message": null
    },
    {
      "id": 451381,
      "primary_message": "Add arugula to the pot in handfuls, waiting for it to wilt slightly before adding the next handful. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 451382,
      "primary_message": "To serve, divide pasta between plates or bowls. Enjoy!",
      "secondary_message": null
    }
  ],
