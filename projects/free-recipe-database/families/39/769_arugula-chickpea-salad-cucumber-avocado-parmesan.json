  "instructions": [
    {
      "id": 7166,
      "primary_message": "Preheat oven to 260°C (500°F).",
      "secondary_message": ""
    },
    {
      "id": 7167,
      "primary_message": "Drain and rinse chickpeas. Place on paper towels and pat dry. Transfer to a sheet pan.",
      "secondary_message": "1 (398 ml) can garbanzo beans (chickpeas)"
    },
    {
      "id": 7168,
      "primary_message": "Drizzle chickpeas with oil and season with cumin, salt, and pepper. Toss to coat.",
      "secondary_message": "1 tbsp extra virgin olive oil\r\n½ tsp cumin\r\n½ tsp salt\r\n⅛ tsp black pepper\r\n1 pinch cayenne pepper"
    },
    {
      "id": 7169,
      "primary_message": "Place in the oven and roast until crispy, 15-20 minutes. Stir halfway through cooking time.",
      "secondary_message": ""
    },
    {
      "id": 7170,
      "primary_message": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lemon juice, oil, Dijon, salt, and pepper. Set aside.",
      "secondary_message": "1 clove garlic\r\n½ lemon\r\n3 tbsp extra virgin olive oil\r\n¼ tsp Dijon mustard\r\n⅛ tsp salt\r\n⅛ tsp black pepper"
    },
    {
      "id": 7171,
      "primary_message": "Wash and dry arugula.",
      "secondary_message": "½ (142 g) pkg baby arugula"
    },
    {
      "id": 7172,
      "primary_message": "Wash and medium dice cucumber. Halve and pit avocado; scoop out and medium dice the flesh.",
      "secondary_message": "½ English cucumber\r\n1 avocado"
    },
    {
      "id": 7173,
      "primary_message": "Shred ⅛ cup of Parmesan.",
      "secondary_message": "14 g Parmesan cheese"
    },
    {
      "id": 7174,
      "primary_message": "To serve, arrange a bed of arugula on a plate and top with chickpeas, cucumber, and avocado. Drizzle with dressing and sprinkle with Parmesan. Enjoy!",
      "secondary_message": ""
    }
  ],
