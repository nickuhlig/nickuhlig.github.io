  "instructions": [
    {
      "id": 1,
      "primary_message": "Wash and dry the perilla leaves. To make the marinade, mix everything together in a small bowl, adding more stock as needed so that the paste has a smooth consistency.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a container with a lid, lay a perilla leaf flat on the bottom and add a small spoonful of the marinade, about 1/4 teaspoon, spreading it evenly on the leaf. Layer another perilla leaf on top and repeat until the leaves and marinade are used up.",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Store in the refrigerator for at least 2 hours, or up to 2 weeks. Eat with rice and other side dishes.",
      "secondary_message": null
    }
  ],
