  "instructions": [
    {
      "id": 0,
      "kind": "prep",
      "primary_message": "Dice the Hass avocados. Seed and dice the vine-ripe tomatoes. Thinly slice the scallions on an angle. Seed and finely dice the jalapeño. Pick the cilantro leaves from the stems and roughly chop them. Juice the lime. Juice the lemon.",
      "secondary_message": "1 ½ Hass avocados\n6 small vine-ripe tomatoes\n2 scallions\n½ to 1 jalapeño\n3 tbsp cilantro\n1 lime\n½ lemon"
    },
    {
      "id": 1,
      "primary_message": "Preheat an indoor or outdoor grill to the highest heat. Season all sides of the tuna with the spices and salt. Drizzle with 1 teaspoon of olive oil, and rub the oil and spices all over the tuna. Sear on the grill 1 minute on each side. Set aside to rest.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "Dice or slice all the vegetables and herbs for the salsa and put them in a bowl. Add the lime juice, 1 tablespoon of olive oil, and season well with salt. Dice the seared tuna the same size as the avocado and tomatoes, and add. Taste the salsa; it should be well salted and a bit acidic. Add the juice of up to 1/2 lemon to achieve the desired acidity. Serve with a ton of tortilla chips.",
      "secondary_message": null
    }
  ],
