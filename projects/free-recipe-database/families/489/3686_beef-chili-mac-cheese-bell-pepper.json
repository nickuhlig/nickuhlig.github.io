  "instructions": [
    {
      "id": 39995,
      "primary_message": "Fill a medium saucepan about halfway with hot water (from the tap); cover with a lid and bring to a boil over high heat.",
      "secondary_message": null
    },
    {
      "id": 39996,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 green bell pepper\n½ small bunch green onions (scallions)"
    },
    {
      "id": 39997,
      "primary_message": "Preheat a skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 39998,
      "primary_message": "While the skillet heats up, trim off and discard the ends of the onion and remove the outer layer; small dice the onion (cut into 6-mm pieces) and transfer to a small bowl.",
      "secondary_message": "½ medium yellow onion"
    },
    {
      "id": 39999,
      "primary_message": "Add the ground beef to the skillet and cook, breaking apart with a spoon, until browned and crumbly, 3 to 4 minutes. Once done, transfer the beef to a bowl, leaving some of the juices in the skillet.",
      "secondary_message": "0.34 kg lean ground beef"
    },
    {
      "id": 40000,
      "primary_message": "Once the beef has been transferred, add the onion to the skillet; cook, stirring occasionally, while you prep the bell pepper.",
      "secondary_message": ""
    },
    {
      "id": 40001,
      "primary_message": "Quarter the bell pepper lengthwise; remove and discard the stem, seeds, and membranes. Small dice the pepper and add to the onion.",
      "secondary_message": null
    },
    {
      "id": 40002,
      "primary_message": "When the water in the saucepan comes to a boil, uncover the pan and season the water with salt, then add the pasta and stir for a few seconds. Cook the pasta, uncovered, for 11 to 12 minutes (or according to package directions). Once done, drain the pasta in a colander.",
      "secondary_message": "1 tbsp salt\n142 g (about 1 ⅛ cups) macaroni pasta"
    },
    {
      "id": 40003,
      "primary_message": "Trim off and discard the root ends of the garlic; peel and mince or press the garlic. Add the garlic to the skillet. Cook the vegetables, stirring frequently, until softened, 2 to 3 more minutes.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 40004,
      "primary_message": "Return the beef to the skillet and season with chili powder, cumin, salt, and pepper.",
      "secondary_message": "1 tbsp chili powder\n½ tsp cumin\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 40005,
      "primary_message": "Add the diced tomatoes to the skillet and bring the mixture to a simmer; cook until the pasta is ready.",
      "secondary_message": "1 (398 ml) can diced tomatoes"
    },
    {
      "id": 40006,
      "primary_message": "Trim off and discard the ends of the green onions; cut the onions crosswise into 6-mm pieces at an angle. Add about ¾ of the onions to the sauce and save the rest for garnishing.",
      "secondary_message": null
    },
    {
      "id": 40007,
      "primary_message": "Coarsely grate the cheddar.",
      "secondary_message": "¼ (227 g) block cheddar cheese"
    },
    {
      "id": 40008,
      "primary_message": "Add the drained pasta and cheese to the sauce; stir until the cheese is melted.",
      "secondary_message": null
    },
    {
      "id": 40009,
      "primary_message": "To serve, divide the chili mac between bowls and top with the remaining green onions. Enjoy!",
      "secondary_message": null
    }
  ],
