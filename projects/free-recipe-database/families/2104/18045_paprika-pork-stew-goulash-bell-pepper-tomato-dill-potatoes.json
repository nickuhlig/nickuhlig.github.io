  "instructions": [
    {
      "id": 293066,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "1 ½ lb new potatoes\n4 medium carrots\n1 yellow bell pepper\n1 small bunch fresh dill"
    },
    {
      "id": 293067,
      "primary_message": "Place potatoes in a large pot, cover with hot water (from the tap), and bring to a boil. Once boiling, reduce heat to medium and simmer until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to the pot; cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 293068,
      "primary_message": "Meanwhile, peel, halve, and small dice onion; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 medium yellow onion\n4 cloves garlic"
    },
    {
      "id": 293069,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 293070,
      "primary_message": "Trim, seed, and medium dice bell pepper; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 293071,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 293072,
      "primary_message": "While the pot heats up, pat the pork chops dry with paper towels, then cut into 2-inch cubes; season with salt and pepper. ",
      "secondary_message": "4 pork chops, boneless\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 293073,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add pork and cook, stirring occasionally, until golden brown, 3-4 minutes (the pork will not be cooked all the way through). ",
      "secondary_message": "2 tbsp extra virgin olive oil"
    },
    {
      "id": 293074,
      "primary_message": "Add veggies to the pot with the pork and continue to cook, stirring occasionally, until veggies soften, 3-4 minutes. ",
      "secondary_message": null
    },
    {
      "id": 293075,
      "primary_message": "Add tomatoes and spices to the pot; stir to combine and bring the stew to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until veggies are tender and pork is cooked through, 8-10 minutes. ",
      "secondary_message": "2 (14.5 oz) cans diced tomatoes\n2 tbsp paprika\n1 tsp thyme, dried\n1 tsp salt\n¼ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 293076,
      "primary_message": "Meanwhile, using a clean cutting board, shave dill leaves off the stems; discard stems and mince the leaves. Add half to the pot with the potatoes along with oil and salt; lightly crush with a fork or potato masher and cover to keep warm. (Reserve remaining dill for the stew.)",
      "secondary_message": "4 tsp extra virgin olive oil\n⅛ tsp salt"
    },
    {
      "id": 293077,
      "primary_message": "When the stew is done, add reserved dill to the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 293078,
      "primary_message": "To serve, divide potatoes and pork stew between plates or bowls; top with yogurt and enjoy!",
      "secondary_message": "½ cup plain Greek yogurt"
    }
  ],
