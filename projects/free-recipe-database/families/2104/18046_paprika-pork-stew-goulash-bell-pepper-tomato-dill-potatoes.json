  "instructions": [
    {
      "id": 293079,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 ¼ lb new potatoes\n6 medium carrots\n1 ½ yellow bell peppers\n1 small bunch fresh dill"
    },
    {
      "id": 293080,
      "primary_message": "Place potatoes in a large pot, cover with hot water (from the tap), and bring to a boil. Once boiling, reduce heat to medium and simmer until potatoes can be easily pierced with a fork, 10-12 minutes. Drain and return to the pot; cover to keep warm. ",
      "secondary_message": null
    },
    {
      "id": 293081,
      "primary_message": "Meanwhile, peel, halve, and small dice onions; peel and mince garlic. Place both in a medium bowl. ",
      "secondary_message": "1 ½ medium yellow onions\n6 cloves garlic"
    },
    {
      "id": 293082,
      "primary_message": "Peel, trim, and small dice carrots; add to the bowl with the onion and garlic.",
      "secondary_message": null
    },
    {
      "id": 293083,
      "primary_message": "Trim, seed, and medium dice bell peppers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 293084,
      "primary_message": "Pat the pork chops dry with paper towels, then cut into 2-inch cubes; season with salt and pepper. ",
      "secondary_message": "6 pork chops, boneless\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 293085,
      "primary_message": "Preheat another large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 293086,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom; add pork and cook, stirring occasionally, until golden brown, 4-5 minutes (the pork will not be cooked all the way through). ",
      "secondary_message": "3 tbsp extra virgin olive oil"
    },
    {
      "id": 293087,
      "primary_message": "Add veggies to the pot with the pork and continue to cook, stirring occasionally, until veggies soften, 4-5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 293088,
      "primary_message": "Add tomatoes and spices to the pot; stir to combine and bring the stew to a boil. Once boiling, reduce heat to medium-low and simmer, stirring occasionally, until veggies are tender and pork is cooked through, about 10 minutes. ",
      "secondary_message": "3 (14.5 oz) cans diced tomatoes\n3 tbsp paprika\n1 ½ tsp thyme, dried\n1 ½ tsp salt\n½ tsp black pepper\n¼ tsp crushed red pepper"
    },
    {
      "id": 293089,
      "primary_message": "Meanwhile, using a clean cutting board, shave dill leaves off the stems; discard stems and mince the leaves. Add half to the pot with the potatoes along with oil and salt; lightly crush with a fork or potato masher and cover to keep warm. (Reserve remaining dill for the stew.)",
      "secondary_message": "2 tbsp extra virgin olive oil\n3 pinch salt"
    },
    {
      "id": 293090,
      "primary_message": "When the stew is done, add reserved dill to the pot, stir to combine, and remove from heat.",
      "secondary_message": null
    },
    {
      "id": 293091,
      "primary_message": "To serve, divide potatoes and pork stew between plates or bowls; top with yogurt and enjoy!",
      "secondary_message": "¾ cup plain Greek yogurt"
    }
  ],
