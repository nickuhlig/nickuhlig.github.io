  "instructions": [
    {
      "id": 528986,
      "primary_message": "Preheat oven to 425°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "2 tsp virgin coconut oil"
    },
    {
      "id": 528987,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "2 (1 inch) pieces ginger root\n2 red bell peppers\n1 lb white mushrooms\n1 (5 oz) pkg baby spinach"
    },
    {
      "id": 528988,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with turkey, bread crumbs, eggs, and spices. Using your hands, mix well to combine.",
      "secondary_message": "1 ½ lb ground turkey\n½ cup panko bread crumbs\n2 eggs\n1 tsp turmeric, ground\n1 tsp salt\n½ tsp black pepper"
    },
    {
      "id": 528989,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs. Arrange on the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 528990,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake, turning halfway, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 528991,
      "primary_message": "Meanwhile, trim, seed, and roughly chop bell peppers. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 528992,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 528993,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 528994,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl with the other veggies.",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 528995,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until tender, 4-5 minutes.",
      "secondary_message": "2 tsp virgin coconut oil\n2 tbsp garam masala\n2 tsp curry powder\n1 tsp onion powder\n½ tsp salt"
    },
    {
      "id": 528996,
      "primary_message": "Add broth and coconut milk to the pot, stir to combine, and bring to a simmer. Once simmering, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": "48 fl oz (6 cups) chicken or vegetable broth\n1 (13.5 fl oz) can coconut milk"
    },
    {
      "id": 528997,
      "primary_message": "Add baked meatballs to the pot and stir to combine the soup. Continue to cook until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 528998,
      "primary_message": "To serve, divide the soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
