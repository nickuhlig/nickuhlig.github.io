  "instructions": [
    {
      "id": 529155,
      "primary_message": "Preheat oven to 220°C (425°F). Coat a large baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tbsp virgin coconut oil"
    },
    {
      "id": 529156,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n3 red bell peppers\n0.68 kg white mushrooms\n1 ½ (142 g) pkgs baby spinach"
    },
    {
      "id": 529157,
      "primary_message": "Peel and mince ginger. Place in a large bowl along with turkey, bread crumbs, eggs, and spices. Using your hands, mix well to combine.",
      "secondary_message": "1.02 kg ground turkey\n¾ cup panko bread crumbs\n3 eggs\n1 ½ tsp turmeric, ground\n1 ½ tsp salt\n¾ tsp black pepper"
    },
    {
      "id": 529158,
      "primary_message": "Using a tablespoon measure, form the turkey mixture into rounded meatballs. Arrange on the baking sheet. ",
      "secondary_message": null
    },
    {
      "id": 529159,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake, turning halfway, until golden and cooked through, 18-20 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 529160,
      "primary_message": "Meanwhile, trim, seed, and roughly chop bell peppers. Place in a clean large bowl.",
      "secondary_message": null
    },
    {
      "id": 529161,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the bell peppers.",
      "secondary_message": null
    },
    {
      "id": 529162,
      "primary_message": "Preheat a large pot over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 529163,
      "primary_message": "While the pot heats up, peel and mince garlic. Add to the bowl with the other veggies.",
      "secondary_message": "3 cloves garlic"
    },
    {
      "id": 529164,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until tender, 5-6 minutes.",
      "secondary_message": "1 tbsp virgin coconut oil\n3 tbsp garam masala\n1 tbsp curry powder\n1 ½ tsp onion powder\n¾ tsp salt"
    },
    {
      "id": 529165,
      "primary_message": "Add broth and coconut milk to the pot, stir to combine, and bring to a simmer. Once simmering, add spinach to the pot in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": "2129 ml chicken or vegetable broth\n1 ½ (398 ml) cans coconut milk"
    },
    {
      "id": 529166,
      "primary_message": "Add baked meatballs to the pot and stir to combine the soup. Continue to cook until heated through, 2-3 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 529167,
      "primary_message": "To serve, divide the soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
