  "instructions": [
    {
      "id": 529012,
      "primary_message": "Preheat oven to 425°F. Coat a baking sheet pan with a thin layer of oil and set aside.",
      "secondary_message": "1 tsp virgin coconut oil"
    },
    {
      "id": 529013,
      "primary_message": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)",
      "secondary_message": "1 (1 inch) piece ginger root\n1 red bell pepper\n½ lb white mushrooms\n½ (5 oz) pkg baby spinach"
    },
    {
      "id": 529014,
      "primary_message": "Peel and mince ginger. Place in a medium bowl along with veggie ground, bread crumbs, egg, and spices. Using your hands, mix well to combine.",
      "secondary_message": "8 oz veggie ground, plant based\n¼ cup panko bread crumbs\n1 egg\n½ tsp turmeric, ground\n¼ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 529015,
      "primary_message": "Using a tablespoon measure, form the veggie ground mixture into rounded \"meatballs.\" Arrange on the baking sheet.",
      "secondary_message": null
    },
    {
      "id": 529016,
      "primary_message": "Place meatballs in the oven (it doesn't have to be fully heated) and bake, turning halfway, until golden and cooked through, 15-18 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 529017,
      "primary_message": "Meanwhile, trim, seed, and roughly chop bell pepper. Place in a clean medium bowl.",
      "secondary_message": null
    },
    {
      "id": 529018,
      "primary_message": "Thinly slice mushrooms. Add to the bowl with the bell pepper.",
      "secondary_message": null
    },
    {
      "id": 529019,
      "primary_message": "Preheat a medium saucepan over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 529020,
      "primary_message": "While the pan heats up, peel and mince garlic. Add to the bowl with the other veggies.",
      "secondary_message": "1 clove garlic"
    },
    {
      "id": 529021,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add veggies and spices; cook, stirring occasionally, until tender, 4-5 minutes.",
      "secondary_message": "1 tsp virgin coconut oil\n1 tbsp garam masala\n1 tsp curry powder\n½ tsp onion powder\n¼ tsp salt"
    },
    {
      "id": 529022,
      "primary_message": "Add broth and coconut milk to the pan, stir to combine, and bring to a simmer. Once simmering, add spinach to the pan in handfuls, waiting for it to wilt slightly before adding the next handful.",
      "secondary_message": "24 fl oz (3 cups) chicken or vegetable broth\n½ (13.5 fl oz) can coconut milk"
    },
    {
      "id": 529023,
      "primary_message": "Add baked meatballs to the pan and stir to combine the soup. Continue to cook until heated through, 1-2 minutes more. Remove from heat.",
      "secondary_message": null
    },
    {
      "id": 529024,
      "primary_message": "To serve, divide the soup between bowls and enjoy!",
      "secondary_message": null
    }
  ],
