  "instructions": [
    {
      "id": 60368,
      "primary_message": "If using frozen shrimp, place in a medium bowl and cover with cold water to thaw. Set aside.",
      "secondary_message": "1.02 kg raw peeled shrimp, fresh or frozen"
    },
    {
      "id": 60367,
      "primary_message": "Peel and mince garlic. Wash and medium dice tomatoes.",
      "secondary_message": "9 cloves garlic\n9 tomatoes"
    },
    {
      "id": 60366,
      "primary_message": "Heat a sauté pan over medium-high heat.",
      "secondary_message": ""
    },
    {
      "id": 60365,
      "primary_message": "Drain shrimp and rinse under cold water until there are no more ice chunks; place on paper towels and pat dry.",
      "secondary_message": ""
    },
    {
      "id": 60357,
      "primary_message": "Coat bottom of pan with oil. Add ½ of the garlic (save the rest for later), shrimp, and paprika. Cook until shrimp are opaque, 1-2 minutes per side. Transfer to a plate.",
      "secondary_message": "about 3 tbsp virgin coconut oil\n¾ tsp paprika"
    },
    {
      "id": 60364,
      "primary_message": "Return pan to stove and reduce heat to medium. Add more oil, remaining garlic, and pepper. Cook until fragrant, 15-30 seconds.",
      "secondary_message": "about 1 ½ tbsp virgin coconut oil\n1 ½ tsp crushed red pepper"
    },
    {
      "id": 60363,
      "primary_message": "Add tomatoes. Cook until liquid is reduced, 2-3 minutes.",
      "secondary_message": ""
    },
    {
      "id": 60362,
      "primary_message": "Drain and rinse beans.",
      "secondary_message": "3 (398 ml) cans cannellini (white kidney) beans"
    },
    {
      "id": 60361,
      "primary_message": "Add beans and broth to pan. Cook until stew thickens, about 10 minutes.",
      "secondary_message": "354 ml (1 ½ cup) chicken or vegetable broth"
    },
    {
      "id": 60360,
      "primary_message": "Toast bread.",
      "secondary_message": "3 whole grain buns or rolls"
    },
    {
      "id": 60359,
      "primary_message": "Stir in shrimp and cook until heated through.",
      "secondary_message": ""
    },
    {
      "id": 60358,
      "primary_message": "To serve, add stew to a bowl and have with crusty bread on the side. Enjoy!",
      "secondary_message": ""
    }
  ],
