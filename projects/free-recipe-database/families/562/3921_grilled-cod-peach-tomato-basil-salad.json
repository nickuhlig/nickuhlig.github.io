  "instructions": [
    {
      "id": 43614,
      "primary_message": "Wash and dry the fresh produce.",
      "secondary_message": "2 peaches\n2 tomatoes\n½ small pkg fresh basil"
    },
    {
      "id": 43615,
      "primary_message": "Halve the tomatoes lengthwise and cut out and discard the stem ends; cut the halves into thin wedges. Transfer to a large salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43616,
      "primary_message": "Quarter the peaches lengthwise (around the pit) and twist the quarters to separate, then remove and discard the pits; cut each quarter lengthwise into thin wedges. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43617,
      "primary_message": "Trim off and discard the ends of the shallot; peel and halve the shallot lengthwise, then thinly slice crosswise. Add to the salad bowl.",
      "secondary_message": "1 shallot"
    },
    {
      "id": 43618,
      "primary_message": "Preheat a grill pan or regular skillet over medium-high heat.",
      "secondary_message": null
    },
    {
      "id": 43619,
      "primary_message": "While the grill pan / skillet heats up, pat the cod fillets dry with paper towels and place on a plate; rub with olive oil and season with salt and pepper on both sides.",
      "secondary_message": "0.34 kg cod fillet\n½ tbsp extra virgin olive oil\n½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 43620,
      "primary_message": "Place the cod in the grill pan / skillet; cook until it is cooked through and flakes easily, 2 to 3 minutes per side. Once done, transfer to a plate.",
      "secondary_message": null
    },
    {
      "id": 43621,
      "primary_message": "Pick the basil leaves off the stems; discard the stems and slice the leaves into a chiffonade by stacking them and rolling tightly into a cigar, then slicing crosswise into thin ribbons. Add to the salad bowl.",
      "secondary_message": null
    },
    {
      "id": 43622,
      "primary_message": "Drizzle the salad with olive oil and balsamic vinegar, then season with salt and pepper; gently toss until well combined.",
      "secondary_message": "1 tbsp extra virgin olive oil\n1 tsp balsamic vinegar\n¼ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 43623,
      "primary_message": "To serve, divide the fish and salad between plates. Enjoy!",
      "secondary_message": ""
    }
  ],
