  "instructions": [
    {
      "id": 382888,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a small saucepan. Add water, turmeric, and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "½ cup basmati rice\n1 cup water\n½ tsp turmeric, ground\n¼ tsp salt"
    },
    {
      "id": 382889,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "1 (1 inch) piece ginger root\n½ lemon\n½ small pkg fresh mint\n½ English cucumber\n1 pint grape tomatoes"
    },
    {
      "id": 382890,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 382891,
      "primary_message": "While the rice is cooking, preheat a medium saucepan over medium heat.",
      "secondary_message": null
    },
    {
      "id": 382892,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. ",
      "secondary_message": "2 cloves garlic"
    },
    {
      "id": 382893,
      "primary_message": "Once the pan is hot, add oil and swirl to coat the bottom. Add ginger, garlic, and spices; cook, stirring often, until fragrant, about 1 minute.",
      "secondary_message": "4 tsp virgin coconut oil\n1 ½ tsp garam masala\n1 ½ tsp cumin, ground\n½ tsp salt\n1 pinch cayenne pepper"
    },
    {
      "id": 382894,
      "primary_message": "Add tomatoes, cream, and sugar to the pan. Stir to combine the tikka masala sauce and bring to a simmer. Once simmering, continue to cook, stirring occasionally, until slightly thickened, 4-5 minutes more.",
      "secondary_message": "1 (14.5 oz) can diced tomatoes\n4 fl oz (½ cup) heavy whipping cream\n1 tsp brown sugar"
    },
    {
      "id": 382895,
      "primary_message": "While the sauce is cooking, pat cod dry with paper towels and cut into 2-inch pieces. ",
      "secondary_message": "¾ lb cod fillet"
    },
    {
      "id": 382896,
      "primary_message": "When the sauce is done, use a hand blender to purée until smooth. Alternatively, use a potato masher to crush the veggies (the sauce will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 382897,
      "primary_message": "Return the sauce to medium-low heat. Add the cod and cook, stirring occasionally, until opaque and flesh flakes with a fork, 6-8 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 382898,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallot. Place in a medium bowl. ",
      "secondary_message": "½ shallot"
    },
    {
      "id": 382899,
      "primary_message": "Juice lemon into the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 382900,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 382901,
      "primary_message": "Trim and small dice cucumber; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 382902,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl along with salt and pepper, then stir to combine the salad. ",
      "secondary_message": "⅛ tsp salt\n⅛ tsp black pepper"
    },
    {
      "id": 382903,
      "primary_message": "Divide rice between plates and top with cod tikka masala. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
