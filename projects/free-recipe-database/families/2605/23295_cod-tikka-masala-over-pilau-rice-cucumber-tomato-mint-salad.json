  "instructions": [
    {
      "id": 382968,
      "primary_message": "Using a strainer or colander, rinse the rice under cold, running water, then drain and transfer to a medium saucepan. Add water, turmeric, and salt; bring the mixture to a boil over high heat.",
      "secondary_message": "1 ½ cups basmati rice\n3 cup water\n1 ½ tsp turmeric, ground\n¾ tsp salt"
    },
    {
      "id": 382969,
      "primary_message": "Meanwhile, wash and dry the fresh produce. ",
      "secondary_message": "3 (2 ½ cm) pieces ginger root\n1 ½ lemons\n1 small pkg fresh mint\n1 ½ English cucumbers\n3 small pkgs grape tomatoes"
    },
    {
      "id": 382970,
      "primary_message": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook rice until liquid is fully absorbed, 15-18 minutes. Once done, remove rice from the heat and let it stand, still covered, for 5 minutes.",
      "secondary_message": null
    },
    {
      "id": 382971,
      "primary_message": "Meanwhile, peel and mince ginger and garlic. ",
      "secondary_message": "6 cloves garlic"
    },
    {
      "id": 382972,
      "primary_message": "Preheat a large pot over medium heat.",
      "secondary_message": null
    },
    {
      "id": 382973,
      "primary_message": "Once the pot is hot, add oil and swirl to coat the bottom. Add ginger, garlic, and spices; cook, stirring often, until fragrant, 1-2 minutes.",
      "secondary_message": "¼ cup virgin coconut oil\n1 ½ tbsp garam masala\n1 ½ tbsp cumin, ground\n1 ½ tsp salt\n3 pinch cayenne pepper"
    },
    {
      "id": 382974,
      "primary_message": "Add tomatoes, cream, and sugar to the pot. Stir to combine the tikka masala sauce and bring to a simmer. Once simmering, continue to cook, stirring occasionally, until slightly thickened, about 5 minutes.",
      "secondary_message": "3 (398 ml) cans diced tomatoes\n355 ml heavy whipping cream\n1 tbsp brown sugar"
    },
    {
      "id": 382975,
      "primary_message": "While the sauce is cooking, pat cod dry with paper towels and cut into 2-inch pieces. ",
      "secondary_message": "1.02 kg cod fillet"
    },
    {
      "id": 382976,
      "primary_message": "When the sauce is done, use a hand blender to purée until smooth. Alternatively, use a potato masher to crush the veggies (the sauce will be chunkier).",
      "secondary_message": null
    },
    {
      "id": 382977,
      "primary_message": "Return the sauce to medium-low heat. Add the cod and cook, stirring occasionally, until opaque and flesh flakes with a fork, about 8 minutes. Remove from heat. ",
      "secondary_message": null
    },
    {
      "id": 382978,
      "primary_message": "Meanwhile, using a clean cutting board, peel and mince shallots. Place in a medium bowl. ",
      "secondary_message": "2 shallots"
    },
    {
      "id": 382979,
      "primary_message": "Juice lemons into the bowl with the shallot. ",
      "secondary_message": null
    },
    {
      "id": 382980,
      "primary_message": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 382981,
      "primary_message": "Trim and small dice cucumbers; add to the bowl. ",
      "secondary_message": null
    },
    {
      "id": 382982,
      "primary_message": "Halve tomatoes lengthwise. Add to the bowl along with salt and pepper, then stir to combine the salad. ",
      "secondary_message": "½ tsp salt\n¼ tsp black pepper"
    },
    {
      "id": 382983,
      "primary_message": "Divide rice between plates and top with cod tikka masala. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
