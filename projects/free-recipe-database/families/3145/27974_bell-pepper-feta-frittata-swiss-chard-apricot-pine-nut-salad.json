  "instructions": [
    {
      "id": 448535,
      "primary_message": "Wash, dry, trim, and seed bell peppers; slice lengthwise into thin strips.",
      "secondary_message": "4 red bell peppers"
    },
    {
      "id": 448536,
      "primary_message": "Preheat a large ovenproof skillet over medium heat.",
      "secondary_message": null
    },
    {
      "id": 448537,
      "primary_message": "Once the skillet is hot, add oil and swirl to coat the bottom. Add peppers and salt; cook, stirring occasionally, until tender and starting to brown, about 10 minutes.",
      "secondary_message": "2 tbsp extra virgin olive oil\n½ tsp salt"
    },
    {
      "id": 448538,
      "primary_message": "Meanwhile, crack eggs into a medium bowl, then add salt and pepper. Whisk to combine.",
      "secondary_message": "12 eggs\n½ tsp salt\n½ tsp black pepper"
    },
    {
      "id": 448539,
      "primary_message": "Add feta to the bowl with the egg. Stir to combine and set aside.",
      "secondary_message": "1 (4 oz) pkg crumbled feta cheese"
    },
    {
      "id": 448540,
      "primary_message": "Preheat oven to broil on high and position rack in the upper third of the oven.",
      "secondary_message": null
    },
    {
      "id": 448541,
      "primary_message": "Mince anchovy fillets. Place in another medium bowl along with oil, vinegar, salt, and crushed red pepper; whisk to combine the dressing.",
      "secondary_message": "2 anchovy fillets, packed in oil\n2 tbsp extra virgin olive oil\n1 tbsp red wine vinegar\n¼ tsp salt\n¼ tsp crushed red pepper"
    },
    {
      "id": 448542,
      "primary_message": "Wash and dry chard; fold leaves in half lengthwise and slice off the stems. Cut leaves crosswise into thin (shred-like) strips and thinly slice the stems, keeping them separate. Add leaves to the bowl with the dressing and set aside. Reserve stems for the next step.",
      "secondary_message": "1 bunch Swiss chard"
    },
    {
      "id": 448543,
      "primary_message": "When the peppers are tender, add chard stems and smoked paprika to the skillet. Cook, stirring occasionally, until fragrant, about 30 seconds. ",
      "secondary_message": "2 tsp smoked paprika"
    },
    {
      "id": 448544,
      "primary_message": "Add vinegar and continue to cook, stirring occasionally, until absorbed, about 30 seconds.",
      "secondary_message": "2 tsp red wine vinegar"
    },
    {
      "id": 448545,
      "primary_message": "Pour the egg mixture into the skillet. As eggs set around the edge of the skillet, gently lift cooked portions with a spatula to allow uncooked egg to flow underneath. Cook until bottom and sides are firm but top is still runny, about 5 minutes. ",
      "secondary_message": null
    },
    {
      "id": 448546,
      "primary_message": "Place skillet in the oven and broil until top of the frittata is just set, 2-3 minutes. Remove from oven.",
      "secondary_message": null
    },
    {
      "id": 448547,
      "primary_message": "Meanwhile, thinly slice apricots. Add to the bowl with the Swiss chard, along with pine nuts, and toss to combine the salad.",
      "secondary_message": "8 dried apricots\n½ cup pine nuts"
    },
    {
      "id": 448548,
      "primary_message": "Cut frittata into wedges and divide between plates. Serve with salad on the side and enjoy!",
      "secondary_message": null
    }
  ],
