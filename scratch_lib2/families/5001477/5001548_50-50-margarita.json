  "instructions": [
    {
      "id": 1,
      "primary_message": "Fill a small, shallow dish with a thin layer of Tajín or salt or a half-and-half combination of each. Run lime wedge around the outer rim of a rocks glass and dip rim in Tajín/salt. Set aside.",
      "secondary_message": null
    },
    {
      "id": 2,
      "primary_message": "In a cocktail shaker, combine mezcal, sherry, Cointreau, and lime juice. Fill with ice and shake until thoroughly chilled, about 15 seconds (the bottom of a metal shaker should frost over).",
      "secondary_message": null
    },
    {
      "id": 3,
      "primary_message": "Fill prepared glass with fresh ice, strain margarita into glass, and serve.",
      "secondary_message": null
    }
